--[[
	Tactical Compass Hold

	Hold key (injected under Tactical Compass → Key binding) pulses the
	stock toggle path: tc_hud.toggle(tc_mcm.keybind) on press and again
	on release. Unbound by default. Ignored if it matches the toggle key.
]]

local CONFIG = _G.dogma_tweaks_tactical_compass_hold_conf

local holding = false

local function refresh_hold_dik()
	CONFIG.loaded.hold_dik = dogma.mcm.key(CONFIG.HOLD_MOD, CONFIG.HOLD_KEY)
end

local function reset_hold()
	holding = false
end

local function flip()
	local hud = rawget(_G, "tc_hud")
	local mcm = rawget(_G, "tc_mcm")
	if not (hud and type(hud.toggle) == "function" and mcm) then
		return
	end
	hud.toggle(mcm.keybind)
end

local function actor_on_update()
	if not rawget(_G, "tc_hud") then
		return
	end

	local dik = CONFIG.loaded.hold_dik
	local mcm = rawget(_G, "tc_mcm")
	if not dik or (mcm and dik == mcm.keybind) then
		if holding then
			flip()
			holding = false
		end
		return
	end

	local down = dogma.input.is_key_down(dik)
	if down == holding then
		return
	end
	holding = down
	flip()
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	refresh_hold_dik()
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("on_option_change", refresh_hold_dik)
	RegisterScriptCallback("on_game_load", reset_hold)
	RegisterScriptCallback("main_menu_on_init", reset_hold)
	RegisterScriptCallback("actor_on_net_destroy", reset_hold)
end
