	<string id="ui_mcm_menu_dogma_hud_stalker_id">
		<text>Stalker ID</text>
	</string>
	<string id="ui_mcm_dogma_stalker_id_page_description">
		<text>Centered name, rank, and faction icon when looking at stalkers. Zombified stalkers show name and rank with "Zombified" instead of a faction patch. Suppresses Crooks Faction Identification.</text>
	</string>

	<string id="ui_mcm_dogma_stalker_id_dead_id">
