--[[
	Ammo Wheel

	Drops worn ammo sections (_bad / _verybad) from the wheel so hotkeys stay
	1, 2, 3 for good loads. Does not replace item_weapon.
]]

local CONFIG = _G.dogma_tweaks_ammo_wheel_conf
local TAG = CONFIG.MOD_ID:gsub("/", "_")

local function is_worn_ammo(section)
	if not section then
		return false
	end
	-- Suffix match (same idea as tooltips); avoids accidental mid-name hits.
	if section:sub(-8) == "_verybad" then
		return true
	end
	if section:sub(-4) == "_bad" then
		return true
	end
	return false
end

local function skip_worn(self)
	if not self or self.grenade_mode or not self.ammo_list then
		return
	end

	for i = 1, self.ammo_max do
		if is_worn_ammo(self.ammo_list[i]) then
			self.avail[i] = false
			self.box[i]:Show(false)
		end
	end

	-- Renumber hotkeys for slots still shown after worn ammo was dropped.
	local cnt = 0
	empty_table(self.key)
	for i = 1, self.ammo_max do
		if self.ammo_list[i] and self.box[i]:IsShown() then
			cnt = cnt + 1
			self.key[cnt] = i
			if self.avail[i] and i <= 9 then
				self.box_num[i]:SetText(tostring(cnt))
			else
				self.box_num[i]:SetText("")
			end
		end
	end
end

local function resolve_class(name)
	local cls = _G[name]
	if cls ~= nil then
		return cls
	end
	return nil
end

local function patch_class(name)
	local cls = resolve_class(name)
	if not cls then
		return false
	end
	if cls._dogma_ammo_wheel then
		return true
	end

	local orig = cls.Reset
	if orig == nil then
		return false
	end

	cls.Reset = function(self, obj)
		orig(self, obj)
		skip_worn(self)
	end
	cls._dogma_ammo_wheel = true
	printf("[%s] patched %s.Reset", TAG, name)
	return true
end

local function wrap_start(fn)
	return function(...)
		local results = { fn(...) }
		local iw = _G.item_weapon
		if iw and iw.GUI then
			skip_worn(iw.GUI)
		end
		return unpack(results)
	end
end

local function patch_start_hooks()
	-- After QAW (and anyone else) wraps start_ammo_wheel, post-process the
	-- vanilla GUI so worn slots are dropped even if class.Reset wrap missed.
	local iw = rawget(_G, "item_weapon") or _G.item_weapon
	if iw and type(iw.start_ammo_wheel) == "function" and not iw._dogma_ammo_wheel_start then
		iw.start_ammo_wheel = wrap_start(iw.start_ammo_wheel)
		iw._dogma_ammo_wheel_start = true
		printf("[%s] wrapped item_weapon.start_ammo_wheel", TAG)
	end

	-- QAW saves the pre-wrap vanilla starter as _start_ammo_wheel and calls it
	-- when override_ammo_wheel is off — patch that path too.
	local qaw = rawget(_G, "haru_quick_action_wheel_mcm")
	if qaw and type(qaw._start_ammo_wheel) == "function" and not qaw._dogma_ammo_wheel_start then
		qaw._start_ammo_wheel = wrap_start(qaw._start_ammo_wheel)
		qaw._dogma_ammo_wheel_start = true
		printf("[%s] wrapped haru _start_ammo_wheel", TAG)
	end
end

local function patch()
	local ok_ammo = patch_class("UIWheelAmmo")
	-- Mags Redux / Anomaly Magazines use a parallel wheel class when enabled.
	patch_class("UIWheelAmmoWuut")
	patch_start_hooks()

	if not ok_ammo then
		printf("[%s] UIWheelAmmo not ready yet", TAG)
	end
end

function on_game_start()
	patch()
	RegisterScriptCallback("actor_on_first_update", patch)
end
