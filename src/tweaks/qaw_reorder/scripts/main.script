--[[
	Quick Action Wheel Reorder

	Hold reorder key on a manual-tab wedge, move to another, release to move it.
	Items between the two slots shift.
	MCM key lives under QAW → Controls (injected by mcm.script).
]]

local CONFIG = _G.dogma_tweaks_qaw_reorder_conf

local drag_from = nil
local drag_tab = nil
local reorder_was_held = false

local function log(msg)
	if dogma.log.logging() then
		dogma.log.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function hide_drag_selection(gui)
	if drag_from and gui and gui.options then
		local opt = gui.options[drag_from]
		if opt and opt.selected_bg then
			opt.selected_bg:Show(false)
		end
	end
end

local function clear_drag(gui)
	hide_drag_selection(gui)
	drag_from = nil
	drag_tab = nil
end

local function read_reorder_key()
	if ui_mcm and ui_mcm.get and not (ui_mcm.is_gathering and ui_mcm.is_gathering()) then
		local ok, value = pcall(ui_mcm.get, CONFIG.QAW_REORDER_KEY_PATH)
		if ok and value ~= nil then
			return tonumber(value) or 0
		end
	end
	return CONFIG.loaded.reorder_key or 0
end

local function on_option_change()
	CONFIG.loaded.reorder_key = read_reorder_key()
	log(string.format("opts: reorder_key=%s", tostring(CONFIG.loaded.reorder_key)))
end

local function current_tab(qaw)
	local tm = qaw.TAB_MANAGER
	if not tm then
		return nil
	end
	return tm.temp_tab or tm.current_tab
end

local function wrap_gui(gui, qaw)
	if not gui or gui._dogma_qaw_reorder then
		return
	end

	local orig_update = gui.UpdateCallback
	local orig_keyboard = gui.OnKeyboardCallback
	local orig_close = gui.Close

	function gui:UpdateCallback()
		if orig_update then
			orig_update(self)
		end

		local reorder_key = CONFIG.loaded.reorder_key
		local held = reorder_key > 0 and dogma.input.is_key_down(reorder_key)

		local tm = qaw.TAB_MANAGER
		local tab = current_tab(qaw)
		local manual = tab and tm and tm.tabs[tab] and not tm.dynamic_tabs[tab]

		if not manual or reorder_key <= 0 then
			clear_drag(self)
			reorder_was_held = held
			return
		end

		if drag_tab and tab ~= drag_tab then
			clear_drag(self)
		end

		local idx = self.hovered_idx
		local has_hover = idx and idx > 0 and self.options and self.options[idx]

		if held and not drag_from and has_hover then
			drag_from = idx
			drag_tab = tab
		end

		if drag_from and self.options[drag_from] and self.options[drag_from].selected_bg then
			self.options[drag_from].selected_bg:Show(true)
		end

		if drag_from and reorder_was_held and not held then
			local to = self.hovered_idx
			local items = tm.tabs[drag_tab]
			if items and to and to > 0 and to ~= drag_from and items[drag_from] and items[to] then
				local from = drag_from
				local item = table.remove(items, from)
				table.insert(items, to, item)
				log(string.format("move %s -> %s tab=%s", tostring(from), tostring(to), tostring(drag_tab)))
				clear_drag(self)
				self:UpdateItems()
			else
				clear_drag(self)
			end
		elseif not held then
			clear_drag(self)
		end

		reorder_was_held = held
	end

	function gui:OnKeyboardCallback(dik, keyboard_action)
		if drag_from and keyboard_action == ui_events.WINDOW_KEY_PRESSED then
			if dik == DIK_keys.MOUSE_1 or dik == DIK_keys.MOUSE_2 then
				return true
			end
		end
		if orig_keyboard then
			return orig_keyboard(self, dik, keyboard_action)
		end
		return false
	end

	function gui:Close()
		clear_drag(self)
		reorder_was_held = false
		if orig_close then
			return orig_close(self)
		end
	end

	gui._dogma_qaw_reorder = true
	log("wrap_gui")
end

local function patch()
	if not dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return
	end

	local qaw = rawget(_G, "haru_quick_action_wheel_mcm")
	if not qaw then
		return
	end

	if not qaw._dogma_qaw_reorder_create_gui and type(qaw.create_GUI) == "function" then
		local orig_create = qaw.create_GUI
		qaw.create_GUI = function(...)
			orig_create(...)
			wrap_gui(qaw.GUI, qaw)
		end
		qaw._dogma_qaw_reorder_create_gui = true
		log("wrap create_GUI")
	end

	if qaw.GUI then
		wrap_gui(qaw.GUI, qaw)
	end
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_first_update", patch)
	patch()
	log("on_game_start")
end
