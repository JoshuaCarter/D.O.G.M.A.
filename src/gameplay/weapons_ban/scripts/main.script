--[[
	Weapons Ban

	Trade: buy-block + strip banned combat gear from supply traders
	(knives stay). Field stalkers untouched.
	Stashes get 0–3 weighted adds (sight/kit/sil/ammo/parts).
	Corpses: strip loose ammo, then rank-ticketed 0–4 full mags per kept
	gun (+ partial mag variance). New game: extra ammo for owned weapons
	= mag_size × N mags (default 10). Replaces RNG Attach + Parts In Stashes.
]]

local CONFIG = _G.dogma_gameplay_weapons_ban_conf
local MOD_ID = CONFIG.MOD_ID
local Tiers

local original_set_random_stash
local original_try_spawn_ammo
local original_trade_update
local original_check_trade_mode
local original_is_tradable
local hooked_stash = false
local hooked_ammo = false
local hooked_trade_ui = false
local hooked_trade_update = false

-- Persist so we never double-grant within the new-game window before
-- start_equippment_handled is given (~4s).
local EXTRA_AMMO_SAVE_KEY = "dogma_wb_extra_start_ammo"
local ini_loadouts

local function log(msg)
	if Tiers and Tiers.log then
		Tiers.log(msg)
	elseif dogma.dbg.logging() then
		dogma.dbg.log(MOD_ID, tostring(msg))
	end
end

local function on_option_change()
	local L = CONFIG.loaded
	local D = CONFIG.DEFAULTS
	L.extra_start_ammo_mags = dogma.mcm.int(MOD_ID, "extra_start_ammo_mags", D.extra_start_ammo_mags)
	for _, cat in ipairs(CONFIG.CATS) do
		for _, n in ipairs({ 2, 3, 4, 5 }) do
			local key = cat .. "_tier_cost_" .. n
			L[key] = dogma.mcm.int(MOD_ID, key, D[key])
		end
	end
	if Tiers and Tiers.rebuild then
		Tiers.rebuild()
	end
end

--------------------------------------------------------------------------------
-- New-game extra ammo (same types as stock UINewGame owned-weapon grant)
--------------------------------------------------------------------------------
local function is_start_weapon_sec(sec)
	if not sec then
		return false
	end
	if not ini_sys:r_string_ex(sec, "ammo_class") then
		return false
	end
	-- Stock UINewGame weapon test
	local slot = ini_sys:r_float_ex(sec, "slot")
	local ani_slot = ini_sys:r_float_ex(sec, "animation_slot")
	if not slot then
		return false
	end
	return ((slot == 0) and (ani_slot == 1)) or (slot == 1) or (slot == 2)
end

local function ammo_sec_for_weapon(wpn_sec)
	local ammo_class = ini_sys:r_string_ex(wpn_sec, "ammo_class")
	if not ammo_class then
		return nil
	end
	local ammo_tbl = str_explode(ammo_class, ",")
	if not (ammo_tbl and ammo_tbl[1]) then
		return nil
	end
	local sec_ammo = ammo_tbl[1]
	if not ini_loadouts then
		ini_loadouts = ini_file("items\\settings\\new_game_loadouts.ltx")
	end
	if ini_loadouts then
		local ammo_type = ini_loadouts:r_string_ex("ammo_type_per_wpn", wpn_sec)
		if ammo_type and ini_sys:section_exist(ammo_type) then
			sec_ammo = ammo_type
		end
	end
	return sec_ammo
end

local function mag_cap_for_weapon(wpn_sec)
	local mag = ini_sys:r_float_ex(wpn_sec, "ammo_mag_size") or 0
	if mag > 0 then
		return math.floor(mag)
	end
	return 30
end

local function give_extra_start_ammo()
	if not dogma.sys.ready(MOD_ID, db, on_option_change) then
		return
	end
	local mags = math.floor((CONFIG.loaded.extra_start_ammo_mags or 0) + 0.5)
	if mags <= 0 then
		return
	end
	-- New game only: stock sets this after the delayed equipment pass.
	if has_alife_info and has_alife_info("start_equippment_handled") then
		return
	end
	if not (db and db.actor and db.actor.iterate_inventory) then
		return
	end

	local ok, m_data = pcall(function()
		return alife_storage_manager.get_state()
	end)
	if not (ok and m_data) then
		return
	end
	if m_data[EXTRA_AMMO_SAVE_KEY] then
		return
	end
	m_data[EXTRA_AMMO_SAVE_KEY] = true

	local ammo_to_spawn = {}
	db.actor:iterate_inventory(function(_temp, itm)
		if not itm then
			return
		end
		local wpn_sec = itm:section()
		if not is_start_weapon_sec(wpn_sec) then
			return
		end
		local sec_ammo = ammo_sec_for_weapon(wpn_sec)
		if not sec_ammo then
			return
		end
		local add = mag_cap_for_weapon(wpn_sec) * mags
		if add <= 0 then
			return
		end
		ammo_to_spawn[sec_ammo] = (ammo_to_spawn[sec_ammo] or 0) + add
	end)

	for sec, cnt in pairs(ammo_to_spawn) do
		alife_create_item(sec, db.actor, { ammo = cnt })
		log(string.format("new game +%s x%s (%s mags × mag size)", sec, cnt, mags))
		dogma.console.say(string.format("weapons ban: extra start ammo %s x%d", sec, cnt), "blue")
	end
end

--------------------------------------------------------------------------------
-- Cheese paid stash (copied from RNG Attach; NMN cannot rely on RNG when disabled)
--------------------------------------------------------------------------------
local function is_cheese_paid_stash(_hint)
	local sfind = string.find
	local act_pos = db.actor and db.actor:position()
	if not act_pos then
		return false
	end

	for i = 2, 12 do
		local info = debug.getinfo(i, "S")
		if not info then
			break
		end
		if info.short_src then
			if sfind(info.short_src, "task", 1, true) then
				return false
			end
			if sfind(info.short_src, "pda", 1, true) then
				return false
			end
		end
	end

	for i = 1, 65534 do
		local obj = level.object_by_id(i)
		if obj then
			local dist = obj:position():distance_to(act_pos)
			if dist < 20 then
				local obj_name = obj:name()
				if obj_name then
					if sfind(obj_name, "esc_m_trader", 1, true)
						or sfind(obj_name, "mar_smart_terrain_base_stalker_leader_marsh", 1, true)
						or sfind(obj_name, "mar_base_owl_stalker_trader", 1, true)
					then
						return true
					end
				end
			end
		end
	end
	return false
end

--------------------------------------------------------------------------------
-- Trade ban / vendor strip
-- trade_manager.update runs on every stalker use (xr_motivator) — never strip
-- field stalkers. Supply traders lose all banned combat stock (not knives).
--------------------------------------------------------------------------------
local function is_magazine(sec)
	if not sec then
		return false
	end
	local kind = ini_sys:r_string_ex(sec, "kind")
	return kind == "w_ammo"
end

local function is_banned_combat_gear(obj, sec)
	if not sec then
		return false
	end
	-- Knives stay tradable
	if obj and IsMelee and IsMelee(obj) then
		return false
	end

	if Tiers.is_weapon_part(sec) then
		return true
	end
	if Tiers.is_ammo_box(sec) then
		return true
	end
	if is_magazine(sec) then
		return true
	end
	if IsItem then
		if IsItem("scope", sec) or IsItem("sil", sec) or IsItem("gl", sec) then
			return true
		end
	end
	if Tiers.is_name_kit(sec) then
		return true
	end
	local visual = ini_sys:r_string_ex(sec, "visual") or ""
	if string.find(visual, "wpn_tac_kit", 1, true) then
		return true
	end
	if obj and IsGrenade and IsGrenade(obj) then
		return true
	end
	-- Guns (non-melee already allowed above)
	if obj and IsWeapon and IsWeapon(obj) then
		return true
	end
	return false
end

-- Restocking vendors (buy_supplies). trade_generic / companions have none.
local function is_supply_trader(npc)
	if not npc then
		return false
	end
	if clsid then
		local c = npc:clsid()
		if c == clsid.script_trader or c == clsid.trader then
			return true
		end
	end
	local cfg = trade_manager.get_trade_profile(npc:id(), "cfg_ltx")
	if not cfg or cfg == "items\\trade\\trade_generic.ltx" then
		return false
	end
	local config = trade_manager.get_trade_cfg(cfg)
	if not config then
		return false
	end
	local supplies = config:r_string_ex("trader", "buy_supplies")
	return supplies ~= nil and supplies ~= ""
end

-- utils_ui caches utils_item.get_item_trade_status in a local at load, so
-- patching the table never reaches Check_TradeMode / IsTradable. Hook those.
local function patched_check_trade_mode(self, obj, sec)
	local profile = self.container and self.container.trade_profile
	if profile and obj and is_banned_combat_gear(obj, sec or obj:section()) then
		self.flags.value = nil
		self.flags.value_str = nil
		self.flags.note = nil
		self.flags.no_trade = nil
		self.flags.note_str = nil
		-- mode 2 = trader stock: hide cell
		if profile.mode == 2 then
			return true
		end
		-- mode 1 = player selling: show as no-trade
		if profile.mode == 1 then
			self.flags.note = 1
			self.flags.no_trade = true
			self.flags.note_str = game.translate_string("st_no_trade_tip_1")
			return false
		end
	end
	return original_check_trade_mode(self, obj, sec)
end

local function patched_is_tradable(self, obj)
	if obj and is_banned_combat_gear(obj, obj:section()) then
		return false
	end
	return original_is_tradable(self, obj)
end

-- Only release ids that still have a server object. Trade strip runs
-- immediately plus delayed retries; client inventory can still list items
-- whose se was already released (alife_release | no server object!), and a
-- recycled id must not be released again.
local function release_inventory_ids(ids)
	for i = 1, #ids do
		local id = ids[i]
		if id and alife_object(id) then
			alife_release_id(id)
		end
	end
end

local function strip_banned_from_trader(npc)
	if not (npc and npc.iterate_inventory) then
		return
	end
	local to_release = {}
	npc:iterate_inventory(function(_temp, item)
		if item and is_banned_combat_gear(item, item:section()) then
			local id = item:id()
			if id and alife_object(id) then
				to_release[#to_release + 1] = id
			end
		end
	end)
	release_inventory_ids(to_release)
end

local function delayed_strip(npc_id)
	local npc = level.object_by_id(npc_id)
	if npc and npc:alive() and is_supply_trader(npc) then
		strip_banned_from_trader(npc)
	end
	return true
end

local function patched_trade_update(npc, force_refresh)
	original_trade_update(npc, force_refresh)
	if not dogma.sys.ready(MOD_ID, db, on_option_change) then
		return
	end
	if not npc then
		return
	end
	if npc.alive and not npc:alive() then
		return
	end
	if not is_supply_trader(npc) then
		return
	end
	strip_banned_from_trader(npc)
	local npc_id = npc:id()
	if CreateTimeEvent then
		CreateTimeEvent("dogma_wb_strip", "s1_" .. npc_id, 0.1, delayed_strip, npc_id)
		CreateTimeEvent("dogma_wb_strip", "s2_" .. npc_id, 0.5, delayed_strip, npc_id)
		CreateTimeEvent("dogma_wb_strip", "s3_" .. npc_id, 1.1, delayed_strip, npc_id)
	end
end

--------------------------------------------------------------------------------
-- Stash inject
-- set_random_stash only queues section names in treasure_manager.caches; items
-- spawn on first open (try_spawn_treasure). Early alife_create_item shows only
-- our extras until the UI refreshes — append to the cache instead.
--------------------------------------------------------------------------------
local function append_stash_sections(id, sections)
	if not (treasure_manager and treasure_manager.caches) or #sections == 0 then
		return
	end
	local caches = treasure_manager.caches
	local cur = caches[id]
	if cur == true then
		return
	end
	local add = table.concat(sections, ",")
	if type(cur) == "string" and cur ~= "" then
		caches[id] = cur .. "," .. add
	else
		caches[id] = add
	end
end

local function roll_stash_loot(id)
	if not alife_object(id) then
		return
	end
	Tiers.ensure()
	local target = Tiers.base_tier_for_stash(id)
	local sections = {}
	local n = math.random(0, 3)
	for _ = 1, n do
		local cat = Tiers.pick_category()
		local rt = Tiers.pick_tier(target)
		local sec = Tiers.pick_section(cat, rt)
		if sec then
			sections[#sections + 1] = sec
			log(string.format("stash +%s t%s %s", cat, rt, sec))
		end
	end
	append_stash_sections(id, sections)
end

local function patched_set_random_stash(no_spot, hint, bonus_items, id, dbg)
	local result = original_set_random_stash(no_spot, hint, bonus_items, id, dbg)

	if dbg then
		return result
	end
	if not dogma.sys.ready(MOD_ID, db, on_option_change) then
		return result
	end
	if not id then
		return result
	end
	if is_cheese_paid_stash(hint) then
		return result
	end

	roll_stash_loot(id)
	return result
end

--------------------------------------------------------------------------------
-- Corpse ammo replace
--------------------------------------------------------------------------------
-- Rank → ticket weights for full-mag counts 0..4. Low ranks skew empty/light;
-- high ranks skew heavier, but every rank can still roll any bucket.
local CORPSE_MAG_TICKETS = {
	novice = { [0] = 50, [1] = 35, [2] = 10, [3] = 4, [4] = 1 },
	trainee = { [0] = 43, [1] = 34, [2] = 12, [3] = 7, [4] = 4 },
	experienced = { [0] = 36, [1] = 32, [2] = 14, [3] = 10, [4] = 8 },
	professional = { [0] = 29, [1] = 31, [2] = 16, [3] = 13, [4] = 11 },
	veteran = { [0] = 21, [1] = 29, [2] = 19, [3] = 16, [4] = 15 },
	expert = { [0] = 14, [1] = 28, [2] = 21, [3] = 19, [4] = 18 },
	master = { [0] = 7, [1] = 26, [2] = 23, [3] = 22, [4] = 22 },
	legend = { [0] = 0, [1] = 25, [2] = 25, [3] = 25, [4] = 25 },
}
local CORPSE_MAG_TICKETS_FALLBACK = CORPSE_MAG_TICKETS.experienced

local function strip_loose_ammo(npc)
	local to_release = {}
	npc:iterate_inventory(function(_temp, item)
		if not item then
			return
		end
		local sec = item:section()
		local id = item:id()
		if not (id and alife_object(id)) then
			return
		end
		if Tiers.is_ammo_box(sec) then
			to_release[#to_release + 1] = id
		elseif IsAmmo and IsAmmo(item) and not (IsItem and IsItem("grenade_ammo", sec)) then
			to_release[#to_release + 1] = id
		end
	end)
	release_inventory_ids(to_release)
end

local function npc_rank_name(npc)
	if not (npc and ranks and ranks.get_obj_rank_name) then
		return nil
	end
	local ok, name = pcall(ranks.get_obj_rank_name, npc)
	if ok and name and name ~= "" then
		return name
	end
	return nil
end

local function pick_corpse_mags(rank_name)
	local tickets = (rank_name and CORPSE_MAG_TICKETS[rank_name]) or CORPSE_MAG_TICKETS_FALLBACK
	local total = 0
	for m = 0, 4 do
		total = total + (tickets[m] or 0)
	end
	if total <= 0 then
		return 0
	end
	local r = math.random(1, total)
	local acc = 0
	for m = 0, 4 do
		acc = acc + (tickets[m] or 0)
		if r <= acc then
			return m
		end
	end
	return 0
end

local function inject_corpse_ammo(npc)
	local mrandom = math.random
	local rank = npc_rank_name(npc)
	npc:iterate_inventory(function(_temp, itm)
		if not itm then
			return
		end
		if not (IsWeapon and IsWeapon(nil, itm:clsid())) then
			return
		end
		if npc.marked_dropped and npc:marked_dropped(itm) then
			return
		end
		if IsMelee and IsMelee(itm) then
			return
		end
		local ammo_class = parse_list(ini_sys, itm:section(), "ammo_class")
		if not (ammo_class and #ammo_class > 0) then
			return
		end
		local sec = ammo_class[mrandom(1, #ammo_class)]
		if not (sec and ini_sys:section_exist(sec)) then
			return
		end
		local mags = pick_corpse_mags(rank)
		local cap = mag_cap_for_weapon(itm:section())
		-- Always roll a partial (0..cap-1). Mag ticket 0 still yields up to
		-- almost one mag; empty only if both the ticket and partial are 0.
		local partial = (cap > 0) and mrandom(0, cap - 1) or 0
		local rounds = cap * mags + partial
		if rounds <= 0 then
			return
		end
		alife_create_item(sec, npc, { ammo = rounds })
		log(string.format(
			"corpse ammo %s x%s (%s mags +%s, rank=%s)",
			sec,
			rounds,
			mags,
			partial,
			rank or "?"
		))
	end)
end

local function patched_try_spawn_ammo(npc)
	original_try_spawn_ammo(npc)
	if not dogma.sys.ready(MOD_ID, db, on_option_change) then
		return
	end
	if not npc then
		return
	end
	strip_loose_ammo(npc)
	inject_corpse_ammo(npc)
	if item_weapon and item_weapon.ammo_aggregation_full and CreateTimeEvent then
		CreateTimeEvent(npc:id(), "dogma_wb_ammo_agg", 0, item_weapon.ammo_aggregation_full, npc:id())
	end
end

--------------------------------------------------------------------------------
-- Hooks
--------------------------------------------------------------------------------
local function try_hook_stash()
	if hooked_stash then
		return
	end
	if not (treasure_manager and treasure_manager.set_random_stash) then
		return
	end
	original_set_random_stash = treasure_manager.set_random_stash
	treasure_manager.set_random_stash = patched_set_random_stash
	hooked_stash = true
	log("hooked treasure_manager.set_random_stash")
end

local function try_hook_ammo()
	if hooked_ammo then
		return
	end
	if not (death_manager and death_manager.try_spawn_ammo) then
		return
	end
	original_try_spawn_ammo = death_manager.try_spawn_ammo
	death_manager.try_spawn_ammo = patched_try_spawn_ammo
	hooked_ammo = true
	log("hooked death_manager.try_spawn_ammo")
end

local function try_hook_trade_ui()
	if hooked_trade_ui then
		return
	end
	local cell = utils_ui and utils_ui.UICellItem
	local cont = utils_ui and utils_ui.UICellContainer
	if not (cell and cell.Check_TradeMode and cont and cont.IsTradable) then
		return
	end
	original_check_trade_mode = cell.Check_TradeMode
	original_is_tradable = cont.IsTradable
	cell.Check_TradeMode = patched_check_trade_mode
	cont.IsTradable = patched_is_tradable
	hooked_trade_ui = true
	log("hooked utils_ui trade Check_TradeMode + IsTradable")
end

local function try_hook_trade_update()
	if hooked_trade_update then
		return
	end
	if not (trade_manager and trade_manager.update) then
		return
	end
	original_trade_update = trade_manager.update
	trade_manager.update = patched_trade_update
	hooked_trade_update = true
	log("hooked trade_manager.update")
end

local function try_hooks()
	try_hook_stash()
	try_hook_ammo()
	try_hook_trade_ui()
	try_hook_trade_update()
end

local function actor_on_first_update()
	try_hooks()
	give_extra_start_ammo()
end

function on_game_start()
	Tiers = _G.dogma_gameplay_weapons_ban_tiers
	dogma.load(MOD_ID)
	
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	on_option_change()
	try_hooks()
	log("weapons_ban ready")
end
