		id = "dorn_free_zoom",
		text = "ui_mcm_menu_dorn_free_zoom",
		gr = {
			{
				id = "free_zoom",
				sh = true,
				text = "ui_mcm_dorn_free_zoom_free_zoom_section",
				gr = MCM.with_header({
					{
						id = "zoom_description",
						type = "desc",
						text = "ui_mcm_dorn_free_zoom_zoom_description",
					},
					{
						id = "enabled",
						type = "check",
						val = 1,
						def = true,
