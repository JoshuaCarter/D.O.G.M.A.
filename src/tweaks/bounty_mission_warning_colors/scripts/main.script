--[[
	Rep Warning - PDA taskboard title color by bounty target relation:
	  red    = same faction or friend
	  orange = neutral
	Enemies get no warning.

	Needs PDA Taskboard (update_task_entry). Reads axr_task_manager.bounties_by_id
	after on_job_descr / setup_bounty_task has run.
]]

local function bounty_target_id(task_id)
	local id = axr_task_manager and axr_task_manager.bounties_by_id and axr_task_manager.bounties_by_id[task_id]
	if id then
		return id
	end
	if not (db.actor and load_var) then
		return nil
	end
	local tbl = load_var(db.actor, task_id)
	return type(tbl) == "table" and tbl.target_id or nil
end

-- actor_army / army → army (disguise-aware true faction when available)
local function faction_key(comm)
	if type(comm) ~= "string" or comm == "" or comm == "none" then
		return nil
	end
	if string.sub(comm, 1, 6) == "actor_" then
		return string.sub(comm, 7)
	end
	return comm
end

local function actor_faction()
	if rawget(_G, "get_actor_true_community") then
		return get_actor_true_community()
	end
	return db.actor and faction_key(character_community(db.actor)) or nil
end

local function squad_rel(se)
	local gid = se and se.group_id
	if gid and gid ~= xconst.INVALID_ENTITY_ID and game_relations and game_relations.get_squad_goodwill_to_actor_by_id then
		return game_relations.get_squad_goodwill_to_actor_by_id(gid)
	end
	return nil
end

-- returns color name or nil
local function warn_color(target_id)
	local se = xobject.se(target_id)
	if not se then
		return nil
	end

	local tcomm = faction_key(xcreature.community(se))
	local acomm = actor_faction()

	-- Same faction always red (army vs army is only ~neutral in the matrix).
	if tcomm and acomm and tcomm == acomm then
		return "red"
	end

	if tcomm and acomm and game_relations then
		if game_relations.is_factions_friends and game_relations.is_factions_friends(acomm, tcomm) then
			return "red"
		end
		if game_relations.is_factions_enemies and game_relations.is_factions_enemies(acomm, tcomm) then
			return nil
		end
		-- Not friend, not enemy → neutral
		return "orange"
	end

	local rel = squad_rel(se)
	if rel == "friend" then
		return "red"
	end
	if rel == "neutral" then
		return "orange"
	end

	return nil
end

local function paint_title(pda_tab, i, task_details)
	if not (task_details and task_details.task_id) then
		return
	end
	local tid = bounty_target_id(task_details.task_id)
	local color_name = tid and warn_color(tid)
	if not color_name then
		return
	end

	local row = pda_tab and pda_tab.rows and pda_tab.rows[i]
	if not (row and row.task_details_field) then
		return
	end

	local tint = utils_xml.get_color(color_name)
	local white = utils_xml.get_color("white")
	-- Serious QoL: global get_more_task_details(i, task_id). iTheon: (i) only.
	local get_more = rawget(_G, "get_more_task_details")
		or (ui_pda_taskboard_tab and ui_pda_taskboard_tab.get_more_task_details)
	if get_more then
		local more = get_more(i, task_details.task_id) or {}
		if more.faulty then
			return
		end
		local title = more.task_title or ""
		local body = string.gsub(more.task_details or "", "\\n ", "\\n")
		row.task_details_field:SetText(tint .. title .. "\\n" .. white .. body)
		return
	end

	local text = row.task_details_field:GetText()
	if text and text ~= "" and string.find(text, tint, 1, true) ~= 1 then
		row.task_details_field:SetText(tint .. text)
	end
end

local function patch_taskboard()
	if not (ui_pda_taskboard_tab and ui_pda_taskboard_tab.update_task_entry) then
		return
	end
	if ui_pda_taskboard_tab.__dogma_rep_warning then
		return
	end

	local orig = ui_pda_taskboard_tab.update_task_entry
	ui_pda_taskboard_tab.update_task_entry = function(pda_tab, i, task_details)
		orig(pda_tab, i, task_details)
		paint_title(pda_tab, i, task_details)
	end
	ui_pda_taskboard_tab.__dogma_rep_warning = true
end

function on_game_start()
	-- After PDA Taskboard / Tasks QoL (same zzzz_ band; name sorts after ui_pda_*).
	patch_taskboard()
	RegisterScriptCallback("on_game_load", patch_taskboard)
end
