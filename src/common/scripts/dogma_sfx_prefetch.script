-- DOGMA SFX Prefetch — cache loose mod sounds on first actor update when a list exists.
-- List is generated into MO2 overwrite: gamedata/configs/dogma_sfx_prefetch.ltx
-- Rebuild with DOGMA SFX Prefetch / Optimize after changing sound mods.
-- Always-on in common: no-op if dogma_sfx_prefetch.ltx is missing or empty.
-- Proof it ran: xray log line [dogma_sfx_prefetch] prefetched N sounds

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end

function actor_on_first_update()
	local ini = ini_file("dogma_sfx_prefetch.ltx")
	if not ini or not ini:section_exist("dogma_sfx_list") then
		return
	end
	local lines = ini:line_count("dogma_sfx_list")
	if not lines or lines < 1 then
		return
	end
	local n = 0
	for i = 0, lines - 1 do
		local _, _, value = ini:r_line("dogma_sfx_list", i, "", "")
		if value and value ~= "" then
			level.prefetch_sound(value)
			n = n + 1
		end
	end
	if n > 0 then
		printf("[dogma_sfx_prefetch] prefetched %s sounds", tostring(n))
	end
end
