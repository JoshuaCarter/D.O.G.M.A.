--[[
	BHS HUD On Damage

	Universal late-load hook on zzz_player_injuries: on limb damage, force the
	classic Body Health System screen HUD visible for MCM seconds, overriding
	hide/keybind for that window. Best-effort 0.5s fade via custom-static alpha.

	Shipped under scripts/override/ with a long z-prefix so this file loads after
	other BHS wrappers (build keeps the exact basename).
]]

local CONFIG = _G.dogma_hud_bhs_on_damage_conf
local DOGMA

local FADE_MS = 500
local FLAG = "__dogma_bhs_on_damage"

local flash_until = 0
local flash_started = 0
local flashing = false
local saved_show = nil
local saved_healthstatus = nil

-- Upvalue owners (may be nested under other wraps).
local uv_show_fn, uv_show_idx = nil, nil
local uv_hs_fn, uv_hs_idx = nil, nil

local wrapped_update = nil
local wrapped_rd = nil

local RATIO_SUFFIXES = { "", "_43", "_1610", "_16" }

local STATIC_STEMS = {
	"body_health_system",
	"body_health_system_text",
	"cop_debug",
	"bhs_garbage",
	"bhs_health_bar",
	"bhs_health_bar_bg",
	"bhs_stamina_bar",
	"bhs_stamina_bar_bg",
	"bhs_health_head_bar",
	"bhs_health_head_bar_bg",
	"bhs_health_head_bar_green",
	"bhs_health_torso_bar",
	"bhs_health_torso_bar_bg",
	"bhs_health_torso_bar_green",
	"bhs_health_rightarm_bar",
	"bhs_health_rightarm_bar_bg",
	"bhs_health_rightarm_bar_green",
	"bhs_health_leftarm_bar",
	"bhs_health_leftarm_bar_bg",
	"bhs_health_leftarm_bar_green",
	"bhs_health_rightleg_bar",
	"bhs_health_rightleg_bar_bg",
	"bhs_health_rightleg_bar_green",
	"bhs_health_leftleg_bar",
	"bhs_health_leftleg_bar_bg",
	"bhs_health_leftleg_bar_green",
}

local STATIC_NAMES = {}
do
	for i = 1, #STATIC_STEMS do
		local stem = STATIC_STEMS[i]
		for j = 1, #RATIO_SUFFIXES do
			STATIC_NAMES[#STATIC_NAMES + 1] = stem .. RATIO_SUFFIXES[j]
		end
	end
end

local function find_upvalue(fn, name)
	if type(fn) ~= "function" or not (debug and debug.getupvalue) then
		return nil, nil
	end
	local i = 1
	while true do
		local n, v = debug.getupvalue(fn, i)
		if not n then
			return nil, nil
		end
		if n == name then
			return i, v
		end
		i = i + 1
	end
end

local function find_upvalue_deep(fn, name, depth, seen)
	depth = depth or 0
	seen = seen or {}
	if type(fn) ~= "function" or depth > 8 or seen[fn] then
		return nil, nil, nil
	end
	seen[fn] = true
	local idx, val = find_upvalue(fn, name)
	if idx then
		return fn, idx, val
	end
	if not (debug and debug.getupvalue) then
		return nil, nil, nil
	end
	local i = 1
	while true do
		local n, v = debug.getupvalue(fn, i)
		if not n then
			break
		end
		if type(v) == "function" then
			local owner, oidx, oval = find_upvalue_deep(v, name, depth + 1, seen)
			if owner then
				return owner, oidx, oval
			end
		end
		i = i + 1
	end
	return nil, nil, nil
end

local function resolve_upvalues(bhs)
	local probe = bhs.actor_on_update
	if type(probe) ~= "function" then
		return false
	end
	local show_fn, show_idx = find_upvalue_deep(probe, "show_hud_type")
	local hs_fn, hs_idx = find_upvalue_deep(probe, "healthstatus")
	if not (show_fn and show_idx and hs_fn and hs_idx) then
		return false
	end
	uv_show_fn, uv_show_idx = show_fn, show_idx
	uv_hs_fn, uv_hs_idx = hs_fn, hs_idx
	return true
end

local function get_show()
	if not (uv_show_fn and uv_show_idx and debug and debug.getupvalue) then
		return nil
	end
	local _, v = debug.getupvalue(uv_show_fn, uv_show_idx)
	return v
end

local function get_healthstatus()
	if not (uv_hs_fn and uv_hs_idx and debug and debug.getupvalue) then
		return nil
	end
	local _, v = debug.getupvalue(uv_hs_fn, uv_hs_idx)
	return v
end

local function set_show(v)
	if uv_show_fn and uv_show_idx and debug and debug.setupvalue then
		debug.setupvalue(uv_show_fn, uv_show_idx, v)
	end
end

local function set_healthstatus(v)
	if uv_hs_fn and uv_hs_idx and debug and debug.setupvalue then
		debug.setupvalue(uv_hs_fn, uv_hs_idx, v)
	end
end

local function refresh_sec()
	local sec = CONFIG and CONFIG.DEFAULTS and CONFIG.DEFAULTS.sec or 3
	if DOGMA and DOGMA.mcm then
		sec = DOGMA.mcm.number(CONFIG.MOD_ID, "sec", sec)
	end
	sec = tonumber(sec) or 0
	if sec < 0 then
		sec = 0
	elseif sec > 20 then
		sec = 20
	end
	if CONFIG and CONFIG.loaded then
		CONFIG.loaded.sec = sec
	end
	return sec
end

local function flash_alpha(now)
	local total = flash_until - flash_started
	if total <= 0 then
		return 255
	end
	local fade_in = FADE_MS
	local fade_out = FADE_MS
	if total < (FADE_MS * 2) then
		fade_in = math.floor(total / 2)
		fade_out = total - fade_in
	end
	local elapsed = now - flash_started
	local remaining = flash_until - now
	if fade_in > 0 and elapsed < fade_in then
		return math.floor(255 * elapsed / fade_in)
	end
	if fade_out > 0 and remaining < fade_out then
		if remaining <= 0 then
			return 0
		end
		return math.floor(255 * remaining / fade_out)
	end
	return 255
end

local function tint_wnd(wnd, alpha)
	if not wnd then
		return
	end
	local argb = GetARGB and GetARGB(alpha, 255, 255, 255)
	if not argb then
		return
	end
	if wnd.SetTextureColor then
		pcall(function()
			wnd:SetTextureColor(argb)
		end)
	end
	if wnd.SetColor then
		pcall(function()
			wnd:SetColor(argb)
		end)
	end
	if wnd.TextControl then
		local ok, tc = pcall(function()
			return wnd:TextControl()
		end)
		if ok and tc and tc.SetTextColor then
			pcall(function()
				tc:SetTextColor(argb)
			end)
		end
	end
end

local function apply_fade_alpha(alpha)
	local hud = get_hud and get_hud()
	if not hud or not hud.GetCustomStatic then
		return
	end
	for i = 1, #STATIC_NAMES do
		local cs = hud:GetCustomStatic(STATIC_NAMES[i])
		if cs then
			local ok, wnd = pcall(function()
				return cs:wnd()
			end)
			if ok then
				tint_wnd(wnd, alpha)
			end
		end
	end
end

local function end_flash()
	if not flashing then
		return
	end
	if saved_show ~= nil then
		set_show(saved_show)
	end
	if saved_healthstatus ~= nil then
		set_healthstatus(saved_healthstatus)
	end
	flashing = false
	flash_until = 0
	flash_started = 0
	saved_show = nil
	saved_healthstatus = nil
	-- Leave alpha at whatever BHS redraws next; force full opacity once if still up.
	apply_fade_alpha(255)
end

local function begin_or_refresh_flash()
	local sec = refresh_sec()
	if sec <= 0 then
		return
	end
	if not (uv_show_fn and uv_hs_fn) then
		return
	end
	local now = time_global()
	local cur_show = get_show()
	local cur_hs = get_healthstatus()
	if not flashing then
		if cur_show == 2 and cur_hs then
			-- Already permanently visible; limb blink handles feedback.
			return
		end
		saved_show = cur_show
		saved_healthstatus = cur_hs
		flash_started = now
		flashing = true
	end
	flash_until = now + math.floor(sec * 1000)
end

local function on_update_wrap(inner)
	return function(...)
		local now = time_global()
		if flashing then
			if now >= flash_until then
				end_flash()
			else
				set_show(2)
				set_healthstatus(true)
			end
		end
		local ret = inner(...)
		if flashing and now < flash_until then
			apply_fade_alpha(flash_alpha(now))
		end
		return ret
	end
end

local function on_rd_wrap(inner)
	return function(...)
		local ret = inner(...)
		begin_or_refresh_flash()
		return ret
	end
end

local function apply()
	local bhs = rawget(_G, "zzz_player_injuries")
	if not (bhs and type(bhs.actor_on_update) == "function" and type(bhs.recieved_damage) == "function") then
		return false
	end
	if not (debug and debug.getupvalue and debug.setupvalue) then
		return false
	end
	if not resolve_upvalues(bhs) then
		return false
	end

	-- Already outermost wraps: keep them (upvalues refreshed above).
	if bhs.actor_on_update == wrapped_update and bhs.recieved_damage == wrapped_rd then
		bhs[FLAG] = true
		return true
	end

	-- Wrap whatever is currently outermost so we run after other BHS patches.
	wrapped_update = on_update_wrap(bhs.actor_on_update)
	wrapped_rd = on_rd_wrap(bhs.recieved_damage)
	bhs.actor_on_update = wrapped_update
	bhs.recieved_damage = wrapped_rd
	bhs[FLAG] = true
	return true
end

local function on_option_change()
	refresh_sec()
end

function on_game_start()
	if dogma_common and dogma_common.load and CONFIG then
		DOGMA = dogma_common.load(CONFIG.MOD_ID)
	else
		DOGMA = _G.DOGMA
	end
	refresh_sec()
	apply()
	RegisterScriptCallback("actor_on_first_update", apply)
	RegisterScriptCallback("on_option_change", on_option_change)
end
