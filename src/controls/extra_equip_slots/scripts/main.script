--[[
	Extra Equip Slots (POC)

	Registers engine slot 15 as an active pistol holster and exposes three MCM
	keys that use stock move_to_slot / activate_slot / move_to_ruck:

	1) Holster - scan for a pistol (favorites first) and put it in slot 15
	2) Draw    - raise / lower slot 15
	3) Unequip - move slot 15 back to the bag

	Goal: prove a real extra slot works before inventing UI / loadout polish.
]]

local CONFIG = _G.dogma_controls_extra_equip_slots_conf
local DOGMA

local PISTOL_SLOT = CONFIG.PISTOL_SLOT or 15
local SLOT_SCAN_MAX = 18
local PLACE_EVENT = "pistol_place"
local PLACE_TICK = 0.05
local PLACE_MAX_TICKS = 100

local place_busy = false

local function log(msg)
	if DOGMA and DOGMA.dbg and DOGMA.dbg.logging() then
		DOGMA.dbg.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function can_use_keys()
	local actor = db.actor
	if not (actor and actor:alive()) then
		return false
	end
	if actor_menu and actor_menu.inventory_opened and actor_menu.inventory_opened() then
		return false
	end
	return true
end

local function is_fav(sec)
	local sp = zzz_rax_sortingplus_mcm
	return sp and sp.is_favorite and sp.is_favorite(sec) or false
end

-- Pistol / small gun: LTX slot 1 (engine slot 2). Axes are melee.
local function is_sidearm(obj)
	if not obj or IsMelee(obj) or not IsWeapon(obj) then
		return false
	end
	local sec = obj:section()
	if not (sec and ini_sys) then
		return false
	end
	local s = ini_sys:r_float_ex(sec, "slot")
	return s ~= nil and tonumber(s) == 1
end

local function cancel_place()
	place_busy = false
	RemoveTimeEvent(CONFIG.MOD_ID, PLACE_EVENT)
end

local function find_pistol()
	local actor = db.actor
	if not actor then
		return nil
	end

	local in_slot = actor:item_in_slot(PISTOL_SLOT)
	if in_slot and is_sidearm(in_slot) then
		return in_slot
	end

	local fav, other
	local function consider(_, it)
		if fav or not it then
			return
		end
		if not is_sidearm(it) then
			return
		end
		-- Prefer loose bag / other slots over whatever is already elsewhere.
		local sec = it:section()
		if is_fav(sec) then
			fav = it
		elseif not other then
			other = it
		end
	end

	for s = 1, SLOT_SCAN_MAX do
		if s ~= PISTOL_SLOT then
			consider(nil, actor:item_in_slot(s))
		end
	end

	if actor.iterate_ruck then
		actor:iterate_ruck(consider)
	else
		actor:iterate_inventory(consider, nil)
	end

	return fav or other
end

local function place_pistol(obj)
	local actor = db.actor
	if not (actor and obj) then
		cancel_place()
		return
	end

	local already = actor:item_in_slot(PISTOL_SLOT)
	if already and already:id() == obj:id() then
		log("pistol already in slot " .. tostring(PISTOL_SLOT))
		cancel_place()
		return
	end

	-- Clear occupant first (async NET - wait before placing).
	if already then
		actor:move_to_ruck(already)
	end

	local obj_id = obj:id()
	local ticks = 0
	place_busy = true
	RemoveTimeEvent(CONFIG.MOD_ID, PLACE_EVENT)
	CreateTimeEvent(CONFIG.MOD_ID, PLACE_EVENT, PLACE_TICK, function()
		ticks = ticks + 1
		local act = db.actor
		if not (act and act:alive() and place_busy) then
			cancel_place()
			return true
		end
		if ticks > PLACE_MAX_TICKS then
			log("place timed out")
			cancel_place()
			return true
		end
		if act:item_in_slot(PISTOL_SLOT) then
			return false
		end
		local pistol = level.object_by_id(obj_id)
		if not pistol then
			cancel_place()
			return true
		end
		act:move_to_slot(pistol, PISTOL_SLOT)
		log("move_to_slot -> " .. tostring(PISTOL_SLOT))
		cancel_place()
		return true
	end)
end

local function holster_pistol()
	local pistol = find_pistol()
	if not pistol then
		log("no pistol found")
		return
	end
	place_pistol(pistol)
end

local function draw_toggle()
	local actor = db.actor
	if not actor then
		return
	end
	if not actor:item_in_slot(PISTOL_SLOT) then
		log("slot " .. tostring(PISTOL_SLOT) .. " empty")
		return
	end
	if actor:active_slot() == PISTOL_SLOT then
		actor:activate_slot(0)
		log("lower slot " .. tostring(PISTOL_SLOT))
	else
		actor:activate_slot(PISTOL_SLOT)
		log("raise slot " .. tostring(PISTOL_SLOT))
	end
end

local function unequip_pistol()
	local actor = db.actor
	if not actor then
		return
	end
	local item = actor:item_in_slot(PISTOL_SLOT)
	if not item then
		log("slot " .. tostring(PISTOL_SLOT) .. " empty")
		return
	end
	if actor:active_slot() == PISTOL_SLOT then
		actor:activate_slot(0)
	end
	actor:move_to_ruck(item)
	log("unequip slot " .. tostring(PISTOL_SLOT))
end

local function on_option_change()
	CONFIG.loaded.enabled = true
	CONFIG.loaded.key_holster = DOGMA.mcm.key(CONFIG.MOD_ID, "key_holster")
	CONFIG.loaded.key_draw = DOGMA.mcm.key(CONFIG.MOD_ID, "key_draw")
	CONFIG.loaded.key_unequip = DOGMA.mcm.key(CONFIG.MOD_ID, "key_unequip")
end

local function on_key_press(dik)
	if not DOGMA.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return
	end
	if not CONFIG.loaded.enabled then
		return
	end
	if not can_use_keys() then
		return
	end
	if place_busy then
		return
	end

	if CONFIG.loaded.key_holster and dik == CONFIG.loaded.key_holster then
		holster_pistol()
		return
	end
	if CONFIG.loaded.key_draw and dik == CONFIG.loaded.key_draw then
		draw_toggle()
		return
	end
	if CONFIG.loaded.key_unequip and dik == CONFIG.loaded.key_unequip then
		unequip_pistol()
		return
	end
end

function on_game_start()
	DOGMA = dogma_common.load(CONFIG.MOD_ID)
	on_option_change()
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("on_key_press", on_key_press)
end
