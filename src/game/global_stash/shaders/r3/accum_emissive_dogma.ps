#include "common.h"
#include "sload.h"

static const float TEXEL = 1.0 / 512.0;

float teal_mask(float3 c)
{
    float r = c.r;
    float g = c.g;
    float b = c.b;
    if (g <= r || b <= r)
        return 0;
    float scale = max(0, g + b - 2.0 * r) * ((g - r) / g) * ((b - r) / b) * ((r + g + b) / 3.0);
    scale = saturate(scale);
    return (scale > 0.01) ? scale : 0;
}

float4 main(p_flat I) : SV_Target
{
    float2 uv = I.tcdh.xy;
    float pulse = 0.05 + 0.35 * pow(0.5 + 0.5 * sin(timers.x * 0.62831853 - (uv.x + 0.35 * uv.y) * 6.2831853), 3.0);
    float3 c0 = tbase(uv);

    float avg = 0;
    [unroll]
    for (int y = -1; y <= 1; y++)
    {
        [unroll]
        for (int x = -1; x <= 1; x++)
            avg += teal_mask(tbase(uv + float2(x, y) * TEXEL));
    }
    avg /= 9.0;
    clip(avg - 1e-4);

    float4 color = float4(SRGBToLinear(c0), 1);
    color.w *= avg * pulse;
    return color;
}
