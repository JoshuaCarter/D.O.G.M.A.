stand_run_turn_ls_0     =     1,      0.15,      1.00,      0.25,      1.00,      0.01,      1.00,      0.90,      1.00    ; run 1.00
stand_run_turn_rs_0     =     1,      0.15,      1.00,      0.25,      1.00,      0.01,      1.00,      0.90,      1.00    ; run 1.00
stand_run_turn_90_ls_0  =     1,      0.15,      0.30,      0.25,      0.30,      0.01,      0.30,      0.90,      0.30    ; rotate 0.30
