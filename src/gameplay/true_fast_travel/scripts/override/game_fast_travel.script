--[[
	DOGMA override: Fair Fast Travel / vanilla game_fast_travel.script.
	Blanks FFT travel; PDA menu hooks forward into True Fast Travel when present
	(engine/UI may call this module directly in addition to script callbacks).
]]

script_version = "dogma"
release_date = 0
trip_in_progress = false
enabled = 0
psyblocked = false
locations_found = 0
basecfg = { ft = { state = 0, enabled = false }, bp = { enabled = false }, gt = { enabled = false } }
tsmarts = {}

function update_settings()
end

function map_spot_menu_add_property(property_ui, id, level_name, hint)
	if _G.tft_map_spot_menu_add_property then
		_G.tft_map_spot_menu_add_property(property_ui, id, level_name, hint)
	end
end

function map_spot_menu_property_clicked(property_ui, id, level_name, prop)
	if _G.tft_map_spot_menu_property_clicked then
		_G.tft_map_spot_menu_property_clicked(property_ui, id, level_name, prop)
	end
end

function get_travel_type()
	return nil
end

function on_game_start()
end
