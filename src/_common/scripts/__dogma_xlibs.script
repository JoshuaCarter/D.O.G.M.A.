--[[
	dogma_xlibs - single DOGMA entry point to standalone xlibs (Damian Sirbu).

	xlibs is a separate MO2 mod (common requires it). First field access binds;
	call sites use one line:

		dogma.xlibs.xconst.INVALID_LEVEL_VERTEX_ID
		dogma.xlibs.xlevel.get_level_id(se)

	Bind must use a normal _G index (not rawget): Anomaly lazy-loads
	scripts/<name>.script on first global reference. rawget freezes nils.
]]

local MIN_VERSION = "1.8.4"

-- Dependency-first so sibling upvalues resolve while each file loads.
local MODULES = {
	"xlibs",
	"xconst",
	"xobject",
	"xdata",
	"xlevel",
	"xtime",
	"xmath",
	"xtable",
	"xlog",
	"xcreature",
	"xsquad",
	"xsmart",
	"xstash",
	"xinventory",
	"xactor",
	"xcombat",
}

local warned = false

local function warn_once(msg)
	if warned then
		return
	end
	warned = true
	if printf then
		printf("! [DOGMA] %s", msg)
	end
end

local function bind(self)
	if rawget(self, "_ready") then
		return
	end

	-- Normal _G index (not rawget): Anomaly lazy-loads scripts/<name>.script.
	local missing = false
	for i = 1, #MODULES do
		local name = MODULES[i]
		local mod = _G[name]
		rawset(self, name, mod)
		if mod == nil then
			missing = true
		end
	end

	local xl = rawget(self, "xlibs")
	if xl and xl.is_compatible and not xl.is_compatible(MIN_VERSION) then
		local ver = (xl.get_version and xl.get_version()) or "?"
		warn_once(string.format("xlibs %s found; DOGMA wants >= %s", tostring(ver), MIN_VERSION))
	elseif missing then
		warn_once("xlibs modules missing - enable the xlibs MO2 mod (common requires it)")
		-- Do not freeze _ready: retry on later access if scripts appear.
		return
	end

	rawset(self, "_ready", true)
end

--- Optional explicit bind; usually unnecessary (field access binds).
function get()
	local self = rawget(_G, "__dogma_xlibs")
	bind(self)
	return self
end

function min_version()
	return MIN_VERSION
end

-- Lazy bind: __dogma_xlibs.xconst → bind once, then return module.
setmetatable(getfenv(1), {
	__index = function(t, k)
		bind(t)
		return rawget(t, k)
	end,
})
