--[[
	DOGMA MCM — getters, tree attach, shared Debug page, banner helper.

	Loaded via dogma_common; use DOGMA.mcm from on_game_start().
	Also registered as *mcm.script (API + defaults). Debug page itself is
	registered only by the local-build feature mcm/debug (manifest =1).

	Tree shape (MCM max 3 levels under the list root):
	  dogma / <category> / <feature page> / options
	Categories are merged across feature scripts via attach().
]]

local BANNER_LINK = "dogma_mcm_banner"
local BANNER_CAPTION = "Dorn's Own G.A.M.M.A. Modification Anthology"
local BANNER_CAPTION_CLR = nil

-- Capture stdlib up-front — Anomaly mods sometimes clobber globals like `string`.
local str_format = string.format
local str_sub = string.sub

-- Shared Debug page path (dogma → debug). Features read keys from here.
DEBUG_MOD = "dogma/debug"

local function mods_list_slide_hook(_anchor, handlers)
	if not BANNER_CAPTION_CLR then
		BANNER_CAPTION_CLR = GetARGB(255, 96, 160, 255)
	end
	handlers.txt:SetText(BANNER_CAPTION)
	handlers.txt:SetTextColor(BANNER_CAPTION_CLR)
end

local function path(mod_id, key)
	return tostring(mod_id) .. "/" .. tostring(key)
end

-- CONFIG.MOD_ID "dogma/<cat>/<feat>" → _G.dogma_<cat>_<feat>_conf.DEFAULTS[key]
local function conf_default(mod_id, key)
	local feature = tostring(mod_id):match("^dogma/(.+)$")
	if not feature then
		return nil
	end
	local conf = _G["dogma_" .. feature:gsub("/", "_") .. "_conf"]
	local defaults = conf and conf.DEFAULTS
	return defaults and defaults[key]
end

local function get(mod_id, key, default)
	if default == nil then
		default = conf_default(mod_id, key)
	end
	-- Illegal during *mcm.script load / on_mcm_load gather — fall back to def.
	if ui_mcm and ui_mcm.is_gathering and ui_mcm.is_gathering() then
		return default
	end
	if ui_mcm then
		local ok, value = pcall(ui_mcm.get, path(mod_id, key))
		if ok and value ~= nil then
			return value
		end
		if not ok then
			return default
		end
	end
	return default
end

function bool(mod_id, key, default)
	local value = get(mod_id, key, default)
	return value == true or value == 1
end

function number(mod_id, key, default)
	local value = get(mod_id, key, default)
	if type(value) == "number" then
		return value
	end
	local n = tonumber(value)
	if n ~= nil then
		return n
	end
	return 0
end

function string(mod_id, key, default)
	local value = get(mod_id, key, default)
	if value == nil then
		return nil
	end
	return tostring(value)
end

function key(mod_id, key, default)
	local value = tonumber(get(mod_id, key, default))
	if value == nil or value == -1 then
		return nil
	end
	return value
end

function range(mod_id, min_key, max_key, min_default, max_default, min_floor)
	local min_val = number(mod_id, min_key, min_default)
	local max_val = number(mod_id, max_key, max_default)
	local floor_val = min_floor or 1

	if max_val > 0 and min_val >= max_val then
		min_val = math.max(floor_val, max_val - 1)
	end

	local result = {
		min = min_val,
		max = max_val,
	}

	function result:normalize(value)
		if self.max <= 0 or self.max <= self.min then
			return 0
		end
		if value < self.min then
			return 0
		end
		if value >= self.max then
			return 1
		end
		return (value - self.min) / (self.max - self.min)
	end

	return result
end

--------------------------------------------------------------------------------
-- Engine keybind mirror (Options→Controls ↔ MCM key_bind)
--
-- MCM loads *mcm.script at the main menu; this module lives here so feature
-- MCM pages can use it without waiting for on_game_start / dogma_common.load.
--
-- Foolproof apply path:
--   1) Engine dik_to_keyname(dik, false) for the console token (k6 / mouse1)
--   2) Fallback DIK_keys name map if the export is missing
--   3) unbind on MCM ESC (-1); bind + cfg_save otherwise
--   4) Re-read and retry once if the primary bind did not stick
--------------------------------------------------------------------------------

local DIK_TOKEN_FALLBACK_NAMES = {
	"DIK_0", "DIK_1", "DIK_2", "DIK_3", "DIK_4", "DIK_5", "DIK_6", "DIK_7", "DIK_8", "DIK_9",
	"DIK_A", "DIK_ADD", "DIK_APOSTROPHE", "DIK_APPS", "DIK_AT", "DIK_AX", "DIK_B", "DIK_BACK",
	"DIK_BACKSLASH", "DIK_C", "DIK_CAPITAL", "DIK_CIRCUMFLEX", "DIK_COLON", "DIK_COMMA",
	"DIK_CONVERT", "DIK_D", "DIK_DECIMAL", "DIK_DELETE", "DIK_DIVIDE", "DIK_DOWN", "DIK_E",
	"DIK_END", "DIK_EQUALS", "DIK_ESCAPE", "DIK_F", "DIK_F1", "DIK_F10", "DIK_F11", "DIK_F12",
	"DIK_F13", "DIK_F14", "DIK_F15", "DIK_F2", "DIK_F3", "DIK_F4", "DIK_F5", "DIK_F6", "DIK_F7",
	"DIK_F8", "DIK_F9", "DIK_G", "DIK_GRAVE", "DIK_H", "DIK_HOME", "DIK_I", "DIK_INSERT",
	"DIK_J", "DIK_K", "DIK_KANA", "DIK_KANJI", "DIK_L", "DIK_LBRACKET", "DIK_LCONTROL",
	"DIK_LEFT", "DIK_LMENU", "DIK_LSHIFT", "DIK_LWIN", "DIK_M", "DIK_MINUS", "DIK_MULTIPLY",
	"DIK_N", "DIK_NEXT", "DIK_NOCONVERT", "DIK_NUMLOCK", "DIK_NUMPAD0", "DIK_NUMPAD1",
	"DIK_NUMPAD2", "DIK_NUMPAD3", "DIK_NUMPAD4", "DIK_NUMPAD5", "DIK_NUMPAD6", "DIK_NUMPAD7",
	"DIK_NUMPAD8", "DIK_NUMPAD9", "DIK_NUMPADCOMMA", "DIK_NUMPADENTER", "DIK_NUMPADEQUALS",
	"DIK_O", "DIK_P", "DIK_PAUSE", "DIK_PERIOD", "DIK_PRIOR", "DIK_Q", "DIK_R", "DIK_RBRACKET",
	"DIK_RCONTROL", "DIK_RETURN", "DIK_RIGHT", "DIK_RMENU", "DIK_RSHIFT", "DIK_RWIN", "DIK_S",
	"DIK_SCROLL", "DIK_SEMICOLON", "DIK_SLASH", "DIK_SPACE", "DIK_STOP", "DIK_SUBTRACT",
	"DIK_SYSRQ", "DIK_T", "DIK_TAB", "DIK_U", "DIK_UNDERLINE", "DIK_UNLABELED", "DIK_UP",
	"DIK_V", "DIK_W", "DIK_X", "DIK_Y", "DIK_YEN", "DIK_Z",
	"MOUSE_1", "MOUSE_2", "MOUSE_3", "MOUSE_4", "MOUSE_5", "MOUSE_6", "MOUSE_7", "MOUSE_8",
}

local dik_token_fallback = nil

local function build_dik_token_fallback()
	local map = {}
	if not DIK_keys then
		return map
	end
	for i = 1, #DIK_TOKEN_FALLBACK_NAMES do
		local name = DIK_TOKEN_FALLBACK_NAMES[i]
		local code = DIK_keys[name]
		if type(code) == "number" then
			if str_sub(name, 1, 4) == "DIK_" then
				map[code] = "k" .. str_sub(name, 5)
			elseif str_sub(name, 1, 6) == "MOUSE_" then
				map[code] = "mouse" .. str_sub(name, 7)
			end
		end
	end
	return map
end

local function console_token_for_dik(dik)
	dik = tonumber(dik)
	if not dik then
		return nil
	end
	-- Engine keyboard table is the source of truth for bind/unbind tokens.
	if dik_to_keyname then
		local ok, name = pcall(dik_to_keyname, dik, false)
		if (not ok or type(name) ~= "string" or name == "") then
			ok, name = pcall(dik_to_keyname, dik, 0)
		end
		if ok and type(name) == "string" and name ~= "" then
			return name
		end
	end
	if not dik_token_fallback then
		dik_token_fallback = build_dik_token_fallback()
	end
	return dik_token_fallback[dik]
end

local function engine_dik_for_bind(bind)
	if bind == nil or not bind_to_dik then
		return -1
	end
	-- Prefer primary (0), then any (-1 / single-arg), then secondary (1).
	local attempts = {
		function() return bind_to_dik(bind, 0) end,
		function() return bind_to_dik(bind) end,
		function() return bind_to_dik(bind, 1) end,
	}
	for i = 1, #attempts do
		local ok, dik = pcall(attempts[i])
		if ok and type(dik) == "number" and dik ~= 0 then
			return dik
		end
	end
	return -1
end

local function console_bind(action, token)
	exec_console_cmd(str_format("bind %s %s", action, token))
end

local function console_unbind(action)
	exec_console_cmd("unbind " .. action)
end

local function console_cfg_save()
	exec_console_cmd("cfg_save")
end

local KeyMirror = {}
KeyMirror.__index = KeyMirror

function KeyMirror.new(action, bind_fn)
	local self = setmetatable({
		action = tostring(action or ""),
		bind_fn = bind_fn,
	}, KeyMirror)
	return self
end

function KeyMirror:dik()
	if self.action == "" or type(self.bind_fn) ~= "function" then
		return -1
	end
	local ok, bind = pcall(self.bind_fn)
	if not ok then
		return -1
	end
	return engine_dik_for_bind(bind)
end

function KeyMirror:apply(dik)
	if self.action == "" then
		return false
	end
	dik = tonumber(dik)
	if not dik then
		return false
	end

	-- MCM key_bind uses -1 for ESC unbind.
	if dik < 0 then
		console_unbind(self.action)
		console_cfg_save()
		return self:dik() < 0
	end

	local token = console_token_for_dik(dik)
	if not token then
		printf("![dogma_mcm.key_mirror] no token for dik=%s action=%s", tostring(dik), self.action)
		return false
	end

	console_bind(self.action, token)
	console_cfg_save()

	local now = self:dik()
	if now ~= dik then
		-- Primary may have been empty while secondary held the old key, or the
		-- first bind raced cfg_save; force primary again.
		console_bind(self.action, token)
		console_cfg_save()
		now = self:dik()
	end

	if now ~= dik then
		printf("![dogma_mcm.key_mirror] bind failed action=%s token=%s want=%s got=%s",
			self.action, token, tostring(dik), tostring(now))
		return false
	end
	return true
end

function KeyMirror:option(id, hint)
	local mirror = self
	return {
		id = id,
		type = "key_bind",
		val = 2,
		def = -1,
		curr = {
			function()
				return mirror:dik()
			end,
		},
		functor = {
			function(dik)
				mirror:apply(dik)
			end,
		},
		hint = hint,
	}
end

-- action: console name ("wpn_6", "crouch", …)
-- bind_fn: returns key_bindings.* id (or nil)
function key_mirror(action, bind_fn)
	return KeyMirror.new(action, bind_fn)
end

function with_header(items)
	local gr = {
		{
			id = "banner",
			type = "slide",
			link = BANNER_LINK,
			size = { 512, 50 },
			spacing = 20,
			ui_hook_functor = { mods_list_slide_hook },
		},
	}
	for i = 1, #items do
		gr[#gr + 1] = items[i]
	end
	return gr
end

-- Keep Debug as the last entry under DOGMA (categories above it).
local function pin_debug_last(dogma)
	local gr = dogma and dogma.gr
	if not gr then
		return
	end
	local idx
	for i = 1, #gr do
		if gr[i].id == "debug" then
			idx = i
			break
		end
	end
	if not idx or idx == #gr then
		return
	end
	local dbg = table.remove(gr, idx)
	gr[#gr+1] = dbg
end

-- Merge a feature page under dogma/<category>. MCM does not deep-merge duplicate
-- category ids from separate *mcm.script returns — call this instead of returning
-- a category wrapper.
function attach(options, cat_id, cat_text, page)
	if not options then
		return
	end
	local dogma
	for i = 1, #options do
		if options[i].id == "dogma" then
			dogma = options[i]
			break
		end
	end
	if not dogma then
		dogma = { id = "dogma", text = "ui_mcm_menu_dogma", gr = {} }
		options[#options+1] = dogma
	end
	local cat
	for i = 1, #(dogma.gr or {}) do
		if dogma.gr[i].id == cat_id then
			cat = dogma.gr[i]
			break
		end
	end
	if not cat then
		cat = { id = cat_id, text = cat_text, gr = {} }
		dogma.gr[#dogma.gr+1] = cat
	end
	cat.gr[#cat.gr+1] = page
	pin_debug_last(dogma)
end

-- Shared Debug defaults (also used when MCM has not written a value yet).
_G.dogma_debug_conf = {
	MOD_ID = DEBUG_MOD,
	DEFAULTS = {
		["debug_log"] = true,
		["debug_overlay"] = false,
		-- Feature-owned debug controls live here; features read via DEBUG_MOD.
		["grain_add_radiation_key"] = -1,
		["grain_clear_radiation_key"] = -1,
		["ft_path_preview"] = false,
		["ft_sneaking_level_up"] = -1,
		["ft_sneaking_level_down"] = -1,
		["ft_coarse_nav_rebuild_on_load"] = false,
		["ft_coarse_nav_build"] = -1,
		["ft_show_coarse_mesh"] = false,
		["fps_long_frame_threshold_ms"] = 0,
	},
}

-- Option control types that store a value (skip desc/line/slide/button/…).
local VALUE_TYPES = {
	check = true,
	list = true,
	track = true,
	key_bind = true,
	input = true,
	radio_h = true,
	radio_v = true,
	preset = true,
}

local function resolve_def(gui, path, opt, v)
	local value = gui:GetDefaultValue(path, opt, v)
	if value ~= nil and v.type == "track" and v.min ~= nil and v.max ~= nil then
		value = clamp(value, v.min, v.max)
	end
	return value
end

local function cache_page_defaults(gui, path, page)
	local gr = page and page.gr
	if not gr then
		return
	end
	for i = 1, #gr do
		local v = gr[i]
		if VALUE_TYPES[v.type] and v.def ~= nil then
			local value = resolve_def(gui, path, v.id, v)
			if value ~= nil then
				gui:CacheValue(path, v.id, value, v)
			end
		end
	end
end

-- Recurse dogma tree: leaf pages (sh) get CacheValue; categories walk children.
local function walk_defaults(gui, node, path)
	if not node then
		return
	end
	if node.sh then
		cache_page_defaults(gui, path, node)
		return
	end
	local gr = node.gr
	if not gr then
		return
	end
	for i = 1, #gr do
		local child = gr[i]
		walk_defaults(gui, child, path .. "/" .. child.id)
	end
end

local function find_dogma_root()
	local options = ui_mcm and ui_mcm.options
	if not options then
		return nil
	end
	for i = 1, #options do
		if options[i].id == "dogma" then
			return options[i]
		end
	end
	return nil
end

-- Rebuild the open page on the next Update tick so scroll_opt:Clear does not
-- destroy the clicked button while its click handler is still on the stack.
local function defer_page_refresh(gui)
	if not gui or gui._dogma_pending_refresh then
		return
	end
	gui._dogma_pending_refresh = true
	local orig_update = gui.Update
	gui.Update = function(self)
		self.Update = orig_update
		self._dogma_pending_refresh = nil
		if orig_update then
			orig_update(self)
		end
		if self.last_path and self.last_curr_tree and self.scroll_opt then
			self:Reset_opt(self.last_curr_tree, self.last_path)
		end
	end
end

-- Pending-only: mirrors MCM Default / CacheValue — Accept applies, Reset discards.
-- functor_ui passes the open UI_MCM as the trailing arg.
function reset_all_dogma_pending(gui)
	local dogma = find_dogma_root()
	if not (gui and dogma) then
		return
	end
	walk_defaults(gui, dogma, "dogma")
	SendScriptCallback("mcm_option_restore_default")
	if gui.owner and gui.owner.SetMsg then
		gui.owner:SetMsg(game.translate_string("ui_mcm_dogma_debug_reset_all_dogma_msg"), 5)
	end
	defer_page_refresh(gui)
	printf("[dogma_mcm] queued all D.O.G.M.A. options to defs (pending)")
end

-- Shared Debug page under DOGMA (sibling of categories). Called from local-only
-- mcm/debug — release FOMOD builds omit that feature, so the page never appears.
function register_debug_page(options)
	local CONFIG = _G.dogma_debug_conf
	local page = {
		id = "debug",
		sh = true,
		text = "ui_mcm_menu_dogma_debug",
		gr = with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_debug_page_description",
			},
			{
				id = "reset_all_dogma",
				type = "button",
				hint = "dogma_debug_reset_all_dogma",
				functor_ui = { reset_all_dogma_pending },
			},
			{ id = "line_reset", type = "line" },
			{
				id = "debug_log",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["debug_log"],
				hint = "dogma_debug_debug_log",
			},
			{
				id = "debug_overlay",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["debug_overlay"],
				hint = "dogma_debug_debug_overlay",
			},
			{ id = "line_grain", type = "line" },
			{
				id = "hdr_grain",
				type = "desc",
				text = "ui_mcm_dogma_debug_hdr_grain",
			},
			{
				id = "grain_add_radiation_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["grain_add_radiation_key"],
				hint = "dogma_debug_grain_add_radiation_key",
			},
			{
				id = "grain_clear_radiation_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["grain_clear_radiation_key"],
				hint = "dogma_debug_grain_clear_radiation_key",
			},
			{ id = "line_ft", type = "line" },
			{
				id = "hdr_fast_travel",
				type = "desc",
				text = "ui_mcm_dogma_debug_hdr_fast_travel",
			},
			{
				id = "ft_path_preview",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["ft_path_preview"],
				hint = "dogma_debug_ft_path_preview",
			},
			{
				id = "ft_sneaking_level_up",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["ft_sneaking_level_up"],
				hint = "dogma_debug_ft_sneaking_level_up",
			},
			{
				id = "ft_sneaking_level_down",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["ft_sneaking_level_down"],
				hint = "dogma_debug_ft_sneaking_level_down",
			},
			{
				id = "ft_coarse_nav_rebuild_on_load",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["ft_coarse_nav_rebuild_on_load"],
				hint = "dogma_debug_ft_coarse_nav_rebuild_on_load",
			},
			{
				id = "ft_coarse_nav_build",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["ft_coarse_nav_build"],
				hint = "dogma_debug_ft_coarse_nav_build",
			},
			{
				id = "ft_show_coarse_mesh",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["ft_show_coarse_mesh"],
				hint = "dogma_debug_ft_show_coarse_mesh",
			},
			{ id = "line_fps", type = "line" },
			{
				id = "hdr_fps",
				type = "desc",
				text = "ui_mcm_dogma_debug_hdr_fps",
			},
			{
				id = "fps_long_frame_threshold_desc",
				type = "desc",
				text = "ui_mcm_dogma_debug_fps_long_frame_threshold_desc",
			},
			{
				id = "fps_long_frame_threshold_ms",
				type = "track",
				val = 2,
				min = 0,
				max = 1000,
				step = 5,
				def = CONFIG.DEFAULTS["fps_long_frame_threshold_ms"],
				hint = "dogma_debug_fps_long_frame_threshold_ms",
			},
		}),
	}
	-- Insert under dogma, then pin last (features that attach later re-pin).
	if options then
		local dogma
		for i = 1, #options do
			if options[i].id == "dogma" then
				dogma = options[i]
				break
			end
		end
		if not dogma then
			dogma = { id = "dogma", text = "ui_mcm_menu_dogma", gr = {} }
			options[#options+1] = dogma
		end
		local replaced
		for i = 1, #(dogma.gr or {}) do
			if dogma.gr[i].id == "debug" then
				dogma.gr[i] = page
				replaced = true
				break
			end
		end
		if not replaced then
			dogma.gr[#dogma.gr+1] = page
		end
		pin_debug_last(dogma)
		return
	end
	return page, "dogma"
end

-- *mcm.script entry: defaults live above; Debug page is local-only (mcm/debug).
function on_mcm_load(_options)
end
