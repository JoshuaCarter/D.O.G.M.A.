<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_game">
		<text>Game</text>
	</string>
	<string id="ui_mcm_menu_dogma_game_ammo_selector">
		<text>Ammo Selector</text>
	</string>
	<string id="ui_mcm_dogma_game_ammo_selector_page_description">
		<text>Toggle uses Settings -&gt; Controls -&gt; Ammo Selector. Hold uses the key below.</text>
	</string>
	<string id="ui_mcm_dogma_game_ammo_selector_enabled">
		<text>Enabled</text>
	</string>
	<string id="ui_mcm_dogma_game_ammo_selector_enabled_desc">
		<text>Off uses the stock ammo wheel.</text>
	</string>
	<string id="ui_mcm_dogma_game_ammo_selector_mode">
		<text>Key mode</text>
	</string>
	<string id="ui_mcm_dogma_game_ammo_selector_mode_desc">
		<text>Toggle opens on release. Hold opens on press and closes on release. Number keys still pick ammo.</text>
	</string>
	<string id="dogma_game_ammo_selector_mode_lst_toggle">
		<text>Toggle</text>
	</string>
	<string id="dogma_game_ammo_selector_mode_lst_hold">
		<text>Hold</text>
	</string>
	<string id="ui_mcm_dogma_game_ammo_selector_hold_delay_ms">
		<text>Hold delay (ms)</text>
	</string>
	<string id="ui_mcm_dogma_game_ammo_selector_hold_delay_ms_desc">
		<text>Hold mode only. Wait this long before opening. Release earlier to cancel. 0 = instant.</text>
	</string>
	<string id="ui_mcm_dogma_game_ammo_selector_select_on_release">
		<text>Select hovered on release</text>
	</string>
	<string id="ui_mcm_dogma_game_ammo_selector_select_on_release_desc">
		<text>Hold mode only. Release over a slot to pick it.</text>
	</string>
	<string id="ui_mcm_dogma_game_ammo_selector_ammo_key">
		<text>Hold key</text>
	</string>
	<string id="ui_mcm_dogma_game_ammo_selector_ammo_key_desc">
		<text>Hold mode only. Can match Settings -&gt; Controls -&gt; Ammo Selector.</text>
	</string>
</string_table>
