--[[
	Stock turn-in graphs have one NPC reply after "I finished", gated by
	actor_has_finished_ordered_task / actor_sim_has_finished_ordered_task.
	If that check fails (stale talk topic, hunt finished while already in
	trade), PhraseDialog.cpp fatals on an empty phrase list.

	After stock builds the graph, add the inverse-gated sibling so exactly
	one NPC line is legal. No complete action on the fallback.
]]

local CONFIG = _G.dogma_fixes_fix_task_done_msg_crash_conf

local FALLBACK_ID = 90
local EXIT_ID = 91

local function add_fallback(text_fn, not_finished_fn)
	local dm = dialog_manager
	if not (dm and dm.add_script_dialog and dm.add_dialog) then
		return
	end
	dm.add_script_dialog(0, FALLBACK_ID, text_fn, not_finished_fn)
	dm.add_dialog(FALLBACK_ID, EXIT_ID, "dm_universal_actor_exit_thanks")
end

local function wrap(name, text_fn, not_finished_fn)
	local dm = dialog_manager
	local orig = dm and dm[name]
	if type(orig) ~= "function" then
		return false
	end
	local flag = "__dogma_fix_task_done_msg_crash_" .. name
	if dm[flag] then
		return true
	end
	dm[flag] = true
	dm[name] = function(dialog)
		orig(dialog)
		add_fallback(text_fn, not_finished_fn)
	end
	return true
end

local function hook()
	wrap(
		"dm_init_dynamic_task_completed_dialog",
		"dialogs.text_task_finish",
		"dialogs.actor_has_not_finished_ordered_task"
	)
	wrap(
		"dm_init_sim_dynamic_task_completed_dialog",
		"dialogs.text_sim_task_finish",
		"dialogs.actor_sim_has_not_finished_ordered_task"
	)
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	hook()
	RegisterScriptCallback("on_game_load", hook)
end
