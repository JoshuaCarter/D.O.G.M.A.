-- input/disassemble conf - shared loaded options for disassemble / tools / attachments / PDA stash.

local defaults = {
	["attachments_enabled"] = true,
	["pda_parts_tip"] = false,
	["disa_safe_equipped"] = true,
	["key_disa"] = -1,
	["key_disa_mode"] = 2,
	["key_disa_modifier"] = 0,
	["pda_grants_stash_coords"] = true,
	["tools_enabled"] = true,
}

_G.dogma_input_disassemble_conf = {
	MOD_ID = "dogma/input/disassemble",
	DEFAULTS = defaults,
	loaded = {
		attachments_enabled = defaults["attachments_enabled"],
		attach_enabled = defaults["attachments_enabled"],
		pda_parts_tip = defaults["pda_parts_tip"],
		disa_safe_equipped = defaults["disa_safe_equipped"],
		pda_grants_stash_coords = defaults["pda_grants_stash_coords"],
		tools_enabled = defaults["tools_enabled"],
	},
}

function _G.dogma_input_disassemble_conf:ensure_dogma()
	dogma.load(self.MOD_ID)
	return dogma
end

function on_mcm_load(options)
	local CONFIG = _G.dogma_input_disassemble_conf
	local function kb_bind(id, hint)
		return {
			id = id,
			type = "key_bind",
			val = 2,
			def = CONFIG.DEFAULTS[id],
			hint = hint,
		}
	end

	local function kb_modifier(id)
		local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
		return {
			id = id,
			type = kb_mod,
			val = 2,
			def = CONFIG.DEFAULTS[id],
			hint = "mcm_kb_modifier",
			content = {
				{ 0, "mcm_kb_mod_none" },
				{ 1, "mcm_kb_mod_shift" },
				{ 2, "mcm_kb_mod_ctrl" },
				{ 3, "mcm_kb_mod_alt" },
			},
		}
	end

	local function kb_mode(id)
		local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
		return {
			id = id,
			type = kb_mod,
			val = 2,
			def = CONFIG.DEFAULTS[id],
			hint = "mcm_kb_mode",
			content = {
				{ 0, "mcm_kb_mode_press" },
				{ 2, "mcm_kb_mode_hold" },
			},
		}
	end

	dogma_mcm.attach(options, "input", "ui_mcm_menu_dogma_input", {
		id = "disassemble",
		sh = true,
		text = "ui_mcm_menu_dogma_input_disassemble",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_input_disassemble_page_description",
			},
			kb_bind("key_disa", "dogma_input_disassemble_key_disa"),
			kb_modifier("key_disa_modifier"),
			kb_mode("key_disa_mode"),
			{
				id = "disa_safe_equipped",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["disa_safe_equipped"],
				hint = "dogma_input_disassemble_disa_safe_equipped",
			},
			{
				id = "pda_grants_stash_coords",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["pda_grants_stash_coords"],
				hint = "dogma_input_disassemble_pda_grants_stash_coords",
			},
			{
				id = "tools_enabled",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["tools_enabled"],
				hint = "dogma_input_disassemble_tools_enabled",
			},
			{
				id = "attachments_enabled",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["attachments_enabled"],
				hint = "dogma_input_disassemble_attachments_enabled",
			},
			{
				id = "pda_parts_tip",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["pda_parts_tip"],
				hint = "dogma_input_disassemble_pda_parts_tip",
			},
		}),
	})
end
