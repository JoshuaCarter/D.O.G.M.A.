--[[
	Fetch task QoL. Same two gates as TAS fetch_anomalous_stash.script:
	1. z_fetch_shows_count.extend_news_text: append stash count
	2. Bring the bolt online on PDA taskboard init and Dialog show
	   so iterate_inventory_box can see items.
]]

local MOD_ID = "dogma/game/global_stash"

local news_hooked = false
local board_hooked = false
local orig_extend_news
local orig_board_init
local count_sec
local count_n

local try_section = function(item)
	return item:section()
end

local try_uses = function(item)
	return item:get_remaining_uses()
end

local try_iterate = function(box, fn)
	box:iterate_inventory_box(fn, box)
end

local function log(msg, color)
	dogma.log.log(MOD_ID, tostring(msg), color)
end

local function get_api()
	return _G.dogma_game_global_stash
end

local function find_needed(_npc, item)
	local ok_s, sec = pcall(try_section, item)
	if not (ok_s and sec == count_sec) then
		return
	end
	local ok_u, uses = pcall(try_uses, item)
	if ok_u and uses and uses > 1 then
		count_n = count_n + uses
	else
		count_n = count_n + 1
	end
end

local function count_in_box(box, section)
	count_sec = section
	count_n = 0
	if not box then
		return 0
	end
	local ok = pcall(try_iterate, box, find_needed)
	if not ok then
		log("fetch count iterate fail", "red")
	end
	return count_n
end

local function extend_news(text, section, amount)
	text = orig_extend_news(text, section, amount)
	local api = get_api()
	local box = api and api.box_go and api.box_go()
	if not box then
		return text
	end
	local cnt = count_in_box(box, section)
	local clr_number
	if cnt == 0 then
		clr_number = utils_xml.get_color("d_red")
	elseif amount and cnt >= amount then
		clr_number = utils_xml.get_color("pda_green")
	else
		clr_number = utils_xml.get_color("pda_yellow")
	end
	local clr_txt = utils_xml.get_color("pda_white")
	log(string.format("fetch news sec=%s stash=%s need=%s", tostring(section), tostring(cnt), tostring(amount)))
	return text .. "\\n" .. string.format(
		game.translate_string("st_dogma_global_stash_fetch_count"),
		clr_txt,
		clr_number,
		cnt,
		clr_txt
	)
end

local function bring_online(why)
	local api = get_api()
	if not (api and api.ensure_online and api.box_go) then
		return
	end
	if api.box_go() then
		return
	end
	log("fetch bring " .. tostring(why))
	api.ensure_online()
end

local function on_gui_show(name)
	if name == "Dialog" then
		bring_online("dialog")
	end
end

local function board_init(self)
	orig_board_init(self)
	bring_online("taskboard")
end

local function hook_news()
	if news_hooked then
		return true
	end
	if not (z_fetch_shows_count and z_fetch_shows_count.extend_news_text) then
		return false
	end
	orig_extend_news = z_fetch_shows_count.extend_news_text
	z_fetch_shows_count.extend_news_text = extend_news
	news_hooked = true
	log("fetch news hooked")
	return true
end

local function hook_board()
	if board_hooked then
		return true
	end
	local tab = ui_pda_taskboard_tab and ui_pda_taskboard_tab.pda_taskboard_tab
	if not (tab and tab.InitControls) then
		return false
	end
	orig_board_init = tab.InitControls
	tab.InitControls = board_init
	board_hooked = true
	log("fetch taskboard hooked")
	return true
end

function on_game_start()
	if not hook_news() then
		log("fetch skip: no z_fetch_shows_count")
		return
	end
	RegisterScriptCallback("GUI_on_show", on_gui_show)
	if not hook_board() then
		log("fetch taskboard skip: no ui_pda_taskboard_tab", "yellow")
	end
	log("fetch ready")
end
