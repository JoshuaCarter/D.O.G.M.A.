-- True Fast Travel MVP: start path walk, invuln window, complete/stop.

local tft = _G.tft

local safety_until = 0
local PDA_SLOT = 8
-- Engine often re-equips PDA ~1-2s after holster (see pda_go_away); re-assert past that.
local PDA_HOLSTER_GUARD_MS = 3000

local function slot_has_item(slot)
	if not (db.actor and slot ~= nil) then return false end
	local ok, item = pcall(function() return db.actor:item_in_slot(slot) end)
	return ok and item ~= nil
end

local function pick_weapon_slot(prefer)
	prefer = tonumber(prefer)
	if prefer and prefer ~= PDA_SLOT and prefer ~= 0 and slot_has_item(prefer) then
		return prefer
	end
	for _, s in ipairs({ 1, 2, 3, 4 }) do
		if slot_has_item(s) then return s end
	end
	return 0
end

local function hide_pda_dialog()
	pcall(function()
		if not (ActorMenu and ActorMenu.get_pda_menu) then return end
		local pda = ActorMenu.get_pda_menu()
		if pda and pda.HideDialog then
			-- Always HideDialog; IsShown can lag after custom cam / travel.
			pda:HideDialog()
		end
	end)
end

local function activate_non_pda(prefer)
	if not db.actor then return end
	local target = pick_weapon_slot(prefer)
	pcall(function() db.actor:activate_slot(target) end)
end

-- Hide PDA UI + leave slot 8. Does not unequip the PDA item.
local function holster_pda(prefer)
	if not db.actor then return end
	hide_pda_dialog()
	local cur = nil
	pcall(function() cur = db.actor:active_slot() end)
	if cur == PDA_SLOT then
		activate_non_pda(prefer)
		return
	end
	-- Dialog can linger even when slot already changed.
	prefer = tonumber(prefer)
	if prefer and prefer ~= PDA_SLOT and prefer ~= cur and slot_has_item(prefer) then
		activate_non_pda(prefer)
	end
end

local function start_pda_holster_guard(prefer, ms)
	local want = pick_weapon_slot(prefer or tft.walk_prev_slot or tft.pda_holster_prefer)
	tft.pda_holster_prefer = want
	tft.pda_holster_until = time_global() + (tonumber(ms) or PDA_HOLSTER_GUARD_MS)
	holster_pda(want)
end

local function journey_cam_active()
	return tft.fly_active or tft.fly_phase ~= nil or tft.is_traveling
end

local function tick_pda_holster_guard()
	local until_tg = tft.pda_holster_until
	if not until_tg then return end
	-- Never HideDialog / activate_slot under custom cam + disable_input (native crash risk).
	if journey_cam_active() then return end
	if time_global() > until_tg then
		tft.pda_holster_until = nil
		return
	end
	if not db.actor then return end
	local cur = nil
	pcall(function() cur = db.actor:active_slot() end)
	if cur == PDA_SLOT then
		hide_pda_dialog()
		activate_non_pda(tft.pda_holster_prefer)
	else
		-- Dialog can linger after slot already changed; only then.
		pcall(function()
			if ActorMenu and ActorMenu.get_pda_menu then
				local pda = ActorMenu.get_pda_menu()
				if pda and pda.IsShown and pda:IsShown() and pda.HideDialog then
					pda:HideDialog()
				end
			end
		end)
	end
end

local function close_pda_for_travel()
	-- One-shot before fly cam starts. No tick guard during the trip.
	holster_pda(tft.walk_prev_slot)
	tft.pda_holster_prefer = pick_weapon_slot(tft.walk_prev_slot or tft.pda_holster_prefer)
	tft.pda_holster_until = nil
end

local function set_safety_active(seconds)
	seconds = tonumber(seconds) or 30
	safety_until = time_global() + math.floor(seconds * 1000)
end

local function is_safety_active()
	return time_global() < (safety_until or 0)
end

local function fail_start(msg, style)
	tft.is_traveling = false
	tft.path_chain = nil
	if tft_set_fft_trip_in_progress then tft_set_fft_trip_in_progress(false) end
	if msg then
		local color = (style == "error") and "red" or "yellow"
		dogma.console.say("true fast travel: start failed - " .. tostring(msg), color)
	end
	if msg and tft_msg then tft_msg(msg, style or "warning") end
	return false
end

local function start_travel_sequence(pos, lvid, gvid, is_transition, final_gvid)
	if not (db.actor and db.actor:alive() and pos and gvid) then
		return fail_start(tft_str("tft_msg_no_nav_path"), "warning")
	end
	if tft.is_traveling or tft.fly_active then
		return fail_start()
	end

	local actor_lid = xlevel.get_actor_level_id()
	local dest_lid = xlevel.get_level_id({ m_game_vertex_id = gvid })
	if not (actor_lid and dest_lid) then
		return fail_start(tft_str("tft_msg_no_nav_path"), "warning")
	end

	dogma.perf.start("tft", "start_travel_sequence")
	local result = false
	repeat
		tft.is_transition = is_transition or false
		tft.final_gvid = final_gvid or gvid
		tft.travel_mode = "normal"

		if is_transition then
			local safe_pos, safe_lvid = tft_find_ground_pos(pos, lvid, gvid)
			if not safe_pos then
				result = fail_start(tft_str("tft_msg_no_nav_path"), "warning")
				break
			end
			tft.dest_pos = vector():set(safe_pos.x, safe_pos.y, safe_pos.z)
			tft.dest_raw_pos = vector():set(safe_pos.x, safe_pos.y, safe_pos.z)
			tft.dest_lvid = safe_lvid or lvid
			tft.dest_gvid = gvid
		elseif actor_lid ~= dest_lid then
			result = fail_start(tft_str("tft_msg_cross_zone_denied"), "warning")
			break
		else
			local safe_pos, safe_lvid = tft_find_ground_pos(pos, lvid, gvid)
			if not safe_pos then
				result = fail_start(tft_str("tft_msg_no_nav_path"), "warning")
				break
			end
			tft.dest_pos = vector():set(safe_pos.x, safe_pos.y, safe_pos.z)
			tft.dest_raw_pos = nil
			tft.dest_lvid = safe_lvid or lvid
			tft.dest_gvid = gvid
		end

		if not tft.start_pos then tft.start_pos = vector() end
		local ap = db.actor:position()
		tft.start_pos:set(ap.x, ap.y, ap.z)
		local ok_sl, start_lvid = pcall(function() return db.actor:level_vertex_id() end)
		tft.start_lvid = (ok_sl and start_lvid) or nil

		local dest_key = nil
		if tft.last_menu_target_id and _G.tft_nav_mesh_dest_anchor_key then
			dest_key = _G.tft_nav_mesh_dest_anchor_key(tft.last_menu_target_id)
		end
		tft.dest_anchor_key = dest_key

		if not _G.tft_nav_mesh_build_path then
			result = fail_start(tft_str("tft_msg_no_nav_path"), "warning")
			break
		end

		local chain, is_vertex, path_len, meta
		local cache = tft.menu_path_cache
		if cache
			and cache.id == tft.last_menu_target_id
			and cache.chain
			and #cache.chain >= 2
		then
			chain, is_vertex, path_len, meta = cache.chain, cache.is_vertex, cache.path_len, cache.meta
		else
			local ok, c, iv, plen, m = pcall(
				_G.tft_nav_mesh_build_path,
				tft.start_pos,
				tft.dest_pos,
				dest_key
			)
			if ok then
				chain, is_vertex, path_len, meta = c, iv, plen, m
			else
				tft_log("MVP path build failed: %s", tostring(c))
				dogma.console.say("true fast travel: path build failed - " .. tostring(c), "yellow")
			end
		end
		if not chain or #chain < 2 then
			local lvl = (level and level.name) and level.name() or "?"
			local aimap = (_G.tft_nav_mesh_graph_ready and _G.tft_nav_mesh_graph_ready()) and "ready" or "missing"
			dogma.console.say(string.format(
				"true fast travel: no path at start level=%s aimap=%s",
				tostring(lvl), aimap
			), "yellow")
			result = fail_start(tft_str("tft_msg_no_nav_path"), "warning")
			break
		end

		tft.path_chain = chain
		tft.path_chain_is_vertex = is_vertex
		tft.path_chain_meta = meta
		tft.travel_dist = path_len or 0
		if tft.travel_dist < 1 then
			local d = 0
			for i = 2, #chain do
				d = d + (chain[i - 1]:distance_to(chain[i]) or 0)
			end
			tft.travel_dist = d
		end
		if tft.travel_dist < 40 and not tft.is_transition then
			result = fail_start(tft_str("tft_msg_too_close"), "warning")
			break
		end

		tft.current_dist = 0
		tft.final_pos = vector():set(tft.dest_pos.x, tft.dest_pos.y, tft.dest_pos.z)
		tft.final_lvid = tft.dest_lvid
		tft.target_stamina = 1.0

		if tft_clear_path_preview then tft_clear_path_preview() end
		close_pda_for_travel()

		if not (_G.tft_begin_fly_camera and _G.tft_begin_fly_camera()) then
			result = fail_start(tft_str("tft_msg_no_nav_path"), "warning")
			break
		end

		tft.is_traveling = true
		if tft_set_fft_trip_in_progress then tft_set_fft_trip_in_progress(true) end
		set_safety_active(120)

		tft_log("MVP travel start %.0fm pts=%d", tft.travel_dist, #chain)
		dogma.console.say(string.format(
			"true fast travel: started %.0fm %d pts%s",
			tft.travel_dist, #chain, tft.is_transition and " (transition)" or ""
		), "blue")
		result = true
	until true
	dogma.perf.stop()
	return result
end

local function stop_travel_logic(reason)
	tft_log("MVP travel stop: %s", tostring(reason))
	local r = tostring(reason or "stop")
	local color = (r == "cancel" or r == "manual") and "yellow" or "blue"
	dogma.console.say("true fast travel: stopped - " .. r, color)
	local prefer = tft.walk_prev_slot or tft.pda_holster_prefer
	if _G.tft_cancel_fly_camera then
		_G.tft_cancel_fly_camera()
	end
	tft.is_traveling = false
	tft.path_chain = nil
	if tft_set_fft_trip_in_progress then tft_set_fft_trip_in_progress(false) end
	if tft_clear then tft_clear() end
	set_safety_active(3)
	-- After cancel: engine often re-raises PDA ~1-2s later — keep fighting it.
	start_pda_holster_guard(prefer, PDA_HOLSTER_GUARD_MS)
end

local function complete_travel_sequence(opts)
	opts = opts or {}
	local reason = opts.reason or "arrive"
	tft_log("MVP travel complete: %s", tostring(reason))
	dogma.console.say("true fast travel: complete - " .. tostring(reason), "blue")

	local prefer = tft.walk_prev_slot or tft.pda_holster_prefer
	if db.actor and tft.dest_pos then
		pcall(function() db.actor:set_actor_position(tft.dest_pos) end)
	end

	tft.is_traveling = false
	tft.path_chain = nil
	if tft_set_fft_trip_in_progress then tft_set_fft_trip_in_progress(false) end
	if tft_clear then tft_clear() end
	set_safety_active(5)

	-- Landing teleport also triggers PDA re-equip; guard after position set.
	start_pda_holster_guard(prefer, PDA_HOLSTER_GUARD_MS)

	if reason == "arrive" and tft_msg then
		tft_msg(tft_str("tft_msg_arrived"), "success")
	end
end

local function actor_on_update()
	tick_pda_holster_guard()
	if _G.tft_nav_mesh_on_actor_update then
		pcall(_G.tft_nav_mesh_on_actor_update)
	end
	if _G.tft_fly_on_actor_update then
		pcall(_G.tft_fly_on_actor_update)
	end
end

do
	_G.tft_close_pda_for_travel = close_pda_for_travel
	_G.tft_start_pda_holster_guard = start_pda_holster_guard
	_G.tft_start_travel_sequence = start_travel_sequence
	_G.tft_set_safety_active = set_safety_active
	_G.tft_is_safety_active = is_safety_active
	_G.tft_actor_on_update = actor_on_update
	_G.tft_stop_travel_logic = stop_travel_logic
	_G.tft_complete_travel_sequence = complete_travel_sequence
	_G.tft_force_clean_walk_for_save = function()
		if tft.is_traveling or tft.fly_active then
			stop_travel_logic("save")
		end
	end
	printf("[dogma_game_true_fast_travel] MVP travel loaded")
end
