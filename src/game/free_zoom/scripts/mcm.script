function on_mcm_load(options)
	local CONFIG = _G.dogma_game_free_zoom_conf
	local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"

	dogma_mcm.attach(options, "game", "ui_mcm_menu_dogma_game", {
		id = "free_zoom",
		sh = true,
		text = "ui_mcm_menu_dogma_game_free_zoom",
		gr = dogma_mcm.with_header({
			{
				id = "zoom_description",
				type = "desc",
				text = "ui_mcm_dogma_game_free_zoom_zoom_description",
			},
			{ id = "line_zoom", type = "line" },
			{
				id = "zoom_header",
				type = "title",
				text = "ui_mcm_dogma_game_free_zoom_zoom_header",
			},
			{
				id = "free_zoom/free_zoom",
				type = "track",
				val = 2,
				min = 0,
				max = 40,
				step = 1,
				def = CONFIG.DEFAULTS["free_zoom/free_zoom"],
				hint = "dogma_game_free_zoom_free_zoom",
			},
			{
				id = "free_zoom/move_speed",
				type = "track",
				val = 2,
				min = 0,
				max = 70,
				step = 1,
				def = CONFIG.DEFAULTS["free_zoom/move_speed"],
				hint = "dogma_game_free_zoom_move_speed",
			},
			{
				id = "free_zoom/allow_during_sprint",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["free_zoom/allow_during_sprint"],
				hint = "dogma_game_free_zoom_allow_during_sprint",
			},
			{
				id = "free_zoom/empty_hands_only",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["free_zoom/empty_hands_only"],
				hint = "dogma_game_free_zoom_empty_hands_only",
			},
			{
				id = "free_zoom/dof",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["free_zoom/dof"],
				hint = "dogma_game_free_zoom_dof",
			},
			{
				id = "free_zoom/dof_intensity",
				type = "track",
				val = 2,
				min = 0,
				max = 1,
				step = 0.05,
				def = CONFIG.DEFAULTS["free_zoom/dof_intensity"],
				hint = "dogma_game_free_zoom_dof_intensity",
			},
			{ id = "line_keybind", type = "line" },
			{
				id = "keybind_header",
				type = "title",
				text = "ui_mcm_dogma_game_free_zoom_keybind_header",
			},
			{
				id = "free_zoom/zoom_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["free_zoom/zoom_key"],
				hint = "dogma_game_free_zoom_zoom_key",
			},
			{
				id = "free_zoom/zoom_key_mode",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS["free_zoom/zoom_key_mode"],
				hint = "dogma_game_free_zoom_zoom_key_mode",
				content = {
					{ 0, "toggle" },
					{ 2, "hold" },
				},
			},
			{
				id = "free_zoom/zoom_key_modifier",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS["free_zoom/zoom_key_modifier"],
				hint = "mcm_kb_modifier",
				content = {
					{ 0, "mcm_kb_mod_none" },
					{ 1, "mcm_kb_mod_shift" },
					{ 2, "mcm_kb_mod_ctrl" },
					{ 3, "mcm_kb_mod_alt" },
				},
			},
			{ id = "line_mouse_wheel", type = "line" },
			{
				id = "mouse_wheel_header",
				type = "title",
				text = "ui_mcm_dogma_game_free_zoom_mouse_wheel_header",
			},
			{
				id = "free_zoom/rmb_zoom",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS["free_zoom/rmb_zoom"],
				hint = "dogma_game_free_zoom_rmb_zoom",
				content = {
					{ 0, "no" },
					{ 1, "toggle" },
					{ 2, "hold" },
				},
			},
			{
				id = "free_zoom/mmb_zoom",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS["free_zoom/mmb_zoom"],
				hint = "dogma_game_free_zoom_mmb_zoom",
				content = {
					{ 0, "no" },
					{ 1, "toggle" },
					{ 2, "hold" },
				},
			},
			{
				id = "free_zoom/scroll_wheel_zoom",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["free_zoom/scroll_wheel_zoom"],
				hint = "dogma_game_free_zoom_scroll_wheel_zoom",
			},
			{
				id = "free_zoom/scroll_wheel_reverse",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["free_zoom/scroll_wheel_reverse"],
				hint = "dogma_game_free_zoom_scroll_wheel_reverse",
			},
			{
				id = "free_zoom/scroll_wheel_steps",
				type = "track",
				val = 2,
				min = 1,
				max = 5,
				step = 1,
				def = CONFIG.DEFAULTS["free_zoom/scroll_wheel_steps"],
				hint = "dogma_game_free_zoom_scroll_wheel_steps",
			},
			{
				id = "free_zoom/scroll_wheel_max_gap_ms",
				type = "track",
				val = 2,
				min = 50,
				max = 500,
				step = 25,
				def = CONFIG.DEFAULTS["free_zoom/scroll_wheel_max_gap_ms"],
				hint = "dogma_game_free_zoom_scroll_wheel_max_gap_ms",
			},
		}),
	})
end
