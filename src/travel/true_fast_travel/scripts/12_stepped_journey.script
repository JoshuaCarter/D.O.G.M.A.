-- True Fast Travel: stepped path teleports + DOGMA sync time-sim + settle.

local tft = _G.tft
local tft_config = _G.tft_config

local SETTLE_S = 0.1 -- ~10fps settle after each sim tick
local MIN_STEP_M = 50 -- path nodes at least this far apart

local begin_stepped_journey, cancel_stepped_journey, run_step

local function fade_enabled()
	return tft_config and tft_config.fade_travel == true
end

local function sim_minutes(mins)
	mins = math.max(1, math.floor(mins + 0.5))
	local st = _G.dogma_sim_time
	if st and st.advance_sync then
		st.advance_sync(mins, math.min(mins, 3))
	elseif level and level.change_game_time then
		-- Fallback: instant skip if sim_time failed to load.
		level.change_game_time(0, 0, mins)
		if tft_log then
			tft_log("dogma_sim_time missing; plain change_game_time(%s)", mins)
		end
	end
	return mins
end

local function restore_weapon_after_pda()
	if not db.actor then return end
	local slot = db.actor:active_slot()
	if slot ~= 8 and slot ~= 0 then return end
	for _, s in ipairs({ 2, 1, 3, 0 }) do
		local it = nil
		pcall(function() it = db.actor:item_in_slot(s) end)
		if it then
			db.actor:activate_slot(s)
			return
		end
	end
	pcall(function() db.actor:activate_slot(0) end)
end

local function close_pda_and_draw()
	if tft_close_pda_for_travel then
		tft_close_pda_for_travel()
	end
	restore_weapon_after_pda()
end

-- Sample path_chain nodes ~every MIN_STEP_M (always include start + end).
local function build_waypoints()
	local chain = tft.path_chain
	if not (chain and #chain >= 2) then
		chain = tft.dot_positions
	end
	if not (chain and #chain >= 2) then
		return nil
	end
	local pts = { vector():set(chain[1].x, chain[1].y or 0, chain[1].z) }
	local accum = 0
	for i = 2, #chain do
		local a, b = chain[i - 1], chain[i]
		local d = tft_horizontal_dist and tft_horizontal_dist(a, b) or a:distance_to(b)
		d = d or 0
		accum = accum + d
		if accum >= MIN_STEP_M or i == #chain then
			pts[#pts + 1] = vector():set(b.x, b.y or 0, b.z)
			accum = 0
		end
	end
	if #pts < 2 and tft.dest_pos then
		pts = {
			vector():set(tft.start_pos.x, tft.start_pos.y, tft.start_pos.z),
			vector():set(tft.dest_pos.x, tft.dest_pos.y, tft.dest_pos.z),
		}
	end
	return pts
end

local function segment_lengths(pts)
	local lens, total = {}, 0
	for i = 2, #pts do
		local d = tft_horizontal_dist and tft_horizontal_dist(pts[i - 1], pts[i]) or pts[i - 1]:distance_to(pts[i])
		d = d or 0
		lens[i] = d
		total = total + d
	end
	return lens, total
end

local function teleport_to(pos)
	if not (db.actor and pos) then return end
	local safe, lvid = pos, nil
	if tft_find_ground_pos then
		safe, lvid = tft_find_ground_pos(pos, nil, tft.dest_gvid)
	end
	safe = safe or pos
	local gvid = tft.dest_gvid or db.actor:game_vertex_id()
	if not lvid and level and level.vertex_id then
		local ok, lv = pcall(function() return level.vertex_id(safe) end)
		if ok then lvid = lv end
	end
	db.actor:set_actor_position(safe)
	if tft_teleport_companions then
		tft_teleport_companions(safe, lvid, gvid)
	end
	return safe, lvid, gvid
end

local function check_step_ambush()
	if not db.actor then return false end
	local pos = db.actor:position()
	local agro_r = tft_ambush_radius_m and tft_ambush_radius_m(tft.travel_mode == "sneaky") or 100
	local alerted = tft_alerted_enemy_within and tft_alerted_enemy_within(pos, agro_r)
	if alerted then
		tft.ambush_kind = "agro"
		tft.stats_ambushes = (tft.stats_ambushes or 0) + 1
		tft_log("Stepped ambush: enemy agro within %.0fm", agro_r)
		return true
	end
	if tft_detect_ambush then
		return tft_detect_ambush(pos)
	end
	return false
end

local function finish_arrival()
	tft.stepped_active = false
	tft.current_dist = tft.travel_dist or tft.current_dist
	if tft_complete_travel_sequence then
		tft_complete_travel_sequence()
	end
end

local function finish_ambush()
	tft.stepped_active = false
	tft.ambush_pending = false
	local ratio = 0
	if tft.travel_dist and tft.travel_dist > 0 then
		ratio = math.min((tft.current_dist or 0) / tft.travel_dist, 1.0)
	end
	tft.ambush_stop_ratio = ratio
	if tft_trigger_encounter then
		tft_trigger_encounter()
	end
end

local function finish_emission()
	tft.stepped_active = false
	if tft_trigger_emission_interrupt then
		tft_trigger_emission_interrupt()
	end
end

local function after_settle(step_i)
	if not tft.stepped_active or not tft.is_traveling then return end
	-- No prediction: only react if an emission is active after the sim tick.
	if tft_is_emission_active and tft_is_emission_active() then
		tft_log("Emission active after step %d - interrupting", step_i)
		finish_emission()
		return
	end
	if check_step_ambush() then
		if tft_play_ambush_alert then tft_play_ambush_alert() end
		finish_ambush()
		return
	end
	run_step(step_i + 1)
end

run_step = function(step_i)
	if not tft.stepped_active or not tft.is_traveling then return end
	local pts = tft.step_waypoints
	if not pts or step_i > #pts then
		finish_arrival()
		return
	end

	local pos = pts[step_i]
	local lens = tft.step_seg_lens or {}
	local total_len = tft.step_total_len or 1
	local seg = lens[step_i] or 0
	local total_mins = tft.expected_duration or 1
	local mins = 0
	if total_len > 0 and step_i >= 2 then
		mins = math.max(1, math.floor(total_mins * (seg / total_len) + 0.5))
	end

	if total_len > 0 and step_i >= 2 then
		local traveled = 0
		for i = 2, step_i do
			traveled = traveled + (lens[i] or 0)
		end
		tft.current_dist = traveled
		local ratio = math.min(traveled / (tft.travel_dist or total_len), 1.0)
		local d_count = tft.dot_count or 0
		for i = 1, d_count do
			local threshold = tft.dot_path_ratio and tft.dot_path_ratio[i] or (i / (d_count + 1))
			if ratio >= threshold then
				if tft_ensure_path_dot then tft_ensure_path_dot(i, true) end
				if tft_promote_path_dot then tft_promote_path_dot(i) end
			end
		end
	end

	local function after_tp()
		if mins > 0 then
			local got = sim_minutes(mins)
			tft.step_time_applied_mins = (tft.step_time_applied_mins or 0) + got
			tft_log("Step %d/%d: +%d game min (applied %d / %d)",
				step_i, #pts, got, tft.step_time_applied_mins or 0, total_mins)
		end
		CreateTimeEvent("tft", "step_settle_" .. tostring(step_i), SETTLE_S, function()
			after_settle(step_i)
			return true
		end)
	end

	if step_i == 1 then
		after_tp()
		return
	end

	if fade_enabled() and tft_play_fade_teleport then
		local g = tft.dest_gvid or (db.actor and db.actor:game_vertex_id()) or 0
		local lv, sp = nil, pos
		if tft_find_ground_pos then
			sp, lv = tft_find_ground_pos(pos, nil, tft.dest_gvid)
		end
		tft_play_fade_teleport(sp or pos, lv, g, after_tp)
	else
		teleport_to(pos)
		after_tp()
	end
end

begin_stepped_journey = function()
	local pts = build_waypoints()
	if not pts or #pts < 2 then
		tft_log("Stepped journey: no waypoints, falling back to instant arrival")
		if tft_complete_travel_sequence then
			tft_complete_travel_sequence()
		end
		return false
	end
	local lens, total = segment_lengths(pts)
	tft.step_waypoints = pts
	tft.step_seg_lens = lens
	tft.step_total_len = total
	tft.step_time_applied_mins = 0
	tft.stepped_active = true
	tft.pda_check_from = nil
	tft.journey_start_health = nil
	close_pda_and_draw()
	tft_log("Stepped journey: %d waypoints @%dm, %.0fm, ~%d game min, fade=%s",
		#pts, MIN_STEP_M, total, tft.expected_duration or 0, tostring(fade_enabled()))
	run_step(1)
	return true
end

cancel_stepped_journey = function()
	tft.stepped_active = false
	tft.step_waypoints = nil
end

_G.tft_begin_stepped_journey = begin_stepped_journey
_G.tft_cancel_stepped_journey = cancel_stepped_journey
_G.tft_stepped_journey_active = function()
	return tft.stepped_active == true
end
