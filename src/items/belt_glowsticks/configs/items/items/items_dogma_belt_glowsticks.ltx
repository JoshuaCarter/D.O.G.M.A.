; Belt-slottable twins of r3zy HD Glowsticks (device_glowstick*).
; Same item conceptually; ARTEFACT class so inventory belt accepts them.
; Script converts device_glowstick* <-> af_dogma_glowstick_belt* on drag to/from belt.
; Inherit af_signet (junk arty, no useful stats); all restore fields zeroed.

[af_dogma_glowstick_belt]:af_signet
class									= ARTEFACT
kind									= i_arty
visual									= dynamics\devices\dev_glowstick\dev_glowstick_glow
inv_name								= st_device_glowstick
inv_name_short							= st_device_glowstick
description								= st_dogma_belt_glowstick_descr
icons_texture							= item\item_glowstick_icon
inv_grid_x								= 0
inv_grid_y								= 0
inv_grid_height							= 1
inv_grid_width							= 1
cost									= 1800
inv_weight								= 0.084

m_fHealthRestoreSpeed					= 0
m_fRadiationRestoreSpeed				= 0
m_fSatietyRestoreSpeed					= 0
m_fPowerRestoreSpeed					= 0
m_fBleedingRestoreSpeed					= 0
additional_inventory_weight				= 0

[af_dogma_glowstick_belt_orange]:af_dogma_glowstick_belt
visual									= dynamics\devices\dev_glowstick\dev_glowstick_glow_orange
inv_name								= st_device_glowstick_orange
inv_name_short							= st_device_glowstick_orange
description								= st_dogma_belt_glowstick_orange_descr
inv_grid_y								= 1
cost									= 2000

[af_dogma_glowstick_belt_red]:af_dogma_glowstick_belt
visual									= dynamics\devices\dev_glowstick\dev_glowstick_glow_red
inv_name								= st_device_glowstick_red
inv_name_short							= st_device_glowstick_red
description								= st_dogma_belt_glowstick_red_descr
inv_grid_y								= 2
cost									= 2400

[af_dogma_glowstick_belt_blue]:af_dogma_glowstick_belt
visual									= dynamics\devices\dev_glowstick\dev_glowstick_glow_blue
inv_name								= st_device_glowstick_blue
inv_name_short							= st_device_glowstick_blue
description								= st_dogma_belt_glowstick_blue_descr
inv_grid_y								= 3
cost									= 1600
