	</string>
	<string id="ui_mcm_dogma_game_safety_save_on_eat">
		<text>Save when hunger recovers</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_on_drink">
		<text>Save when thirst recovers</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_on_sleep">
		<text>Save when sleep recovers</text>
	</string>
