--[[
	Global Stash: sprint lock + one shared bolt invbox.

	Place / pickup do nothing to the shared id.
	Open a box: teleport bolt there and open it.
	Change map: if the id exists, bring it online at the actor and cloak once.
]]

local MOD_ID = "dogma/game/global_stash"
local ITEM_SEC = "dogma_global_stash_item"
local PLACEABLE_SEC = "placeable_dogma_global_stash"
local SHARED_SEC = "dogma_game_global_stash"
local PDA_KEY = "dogma_game_global_stash"
local PARK_DIST = 0.005

local xobject = dogma.xlibs.xobject
local api = {}
_G.dogma_game_global_stash = api

local blocked = false
local planted_level = nil

local try_object = function(actor, sec)
	return actor:object(sec)
end

local try_allow_sprint = function(actor, allowed)
	actor:allow_sprint(allowed)
end

local try_pos = function(obj)
	return obj:position()
end

local try_lvid = function(obj)
	return obj:level_vertex_id()
end

local try_gvid = function(obj)
	return obj:game_vertex_id()
end

local try_clsid = function(se)
	return se:clsid()
end

local try_is_invbox = function(clsid)
	return IsInvbox(nil, clsid)
end

local try_alife_create = function(sec, pos, lvid, gvid)
	return alife_create(sec, pos, lvid, gvid)
end

local try_teleport = function(sim, id, gvid, lvid, pos)
	sim:teleport_object(id, gvid, lvid, pos)
end

local try_online = function(sim, id)
	sim:set_switch_online(id, true)
	sim:set_switch_offline(id, false)
end

local try_cloak = function(box)
	box:set_nonscript_usable(false)
	box:set_tip_text("")
end

local try_use = function(box, actor)
	box:use(actor)
end

local try_hide_hud = function()
	hide_hud_inventory()
end

local try_m_state = function()
	return alife_storage_manager.get_state()
end

local try_section = function(obj)
	return obj:section()
end

local try_distance = function(here, dest)
	return here:distance_to(dest)
end

local function log(msg, color)
	dogma.log.log(MOD_ID, tostring(msg), color)
end

local function m_state()
	local ok, state = pcall(try_m_state)
	if ok then
		return state
	end
end

local function set_blocked(want)
	if want == blocked then
		return
	end
	local actor = db.actor
	if not actor then
		if not want then
			blocked = false
		end
		return
	end
	local ok = pcall(try_allow_sprint, actor, not want)
	if not ok then
		log("allow_sprint failed", "red")
		return
	end
	blocked = want
	if want then
		log("sprint blocked (stash in inventory)", "yellow")
	else
		log("sprint restored", "green")
	end
end

local function sync_sprint()
	if not dogma.sys.ready(MOD_ID, db) then
		return
	end
	local ok, obj = pcall(try_object, db.actor, ITEM_SEC)
	set_blocked(ok and obj ~= nil)
end

local function register_pda(m_data, id)
	if not (m_data and id) then
		return
	end
	if not m_data.workshop_stashes then
		m_data.workshop_stashes = {}
	end
	m_data.workshop_stashes[PDA_KEY] = id
end

local function clear_spawn_cache(id)
	if db.offline_objects and db.offline_objects[id] then
		db.offline_objects[id].level_vertex_id = nil
	end
	if db.spawned_vertex_by_id then
		db.spawned_vertex_by_id[id] = nil
	end
end

local function se_is_box(se)
	if not se then
		return false
	end
	local ok, clsid = pcall(try_clsid, se)
	if not ok then
		return false
	end
	local ok_box, is_box = pcall(try_is_invbox, clsid)
	return ok_box and is_box
end

local function dest_of(go)
	local ok_p, pos = pcall(try_pos, go)
	local ok_l, lvid = pcall(try_lvid, go)
	local ok_g, gvid = pcall(try_gvid, go)
	if not (ok_p and pos and ok_l and lvid and ok_g and gvid) then
		return
	end
	return vec_set(pos), lvid, gvid
end

-- Create or teleport the bolt to dest. Pin online. Does not cloak.
local function plant_dest(dest, lvid, gvid)
	local tostr = tostring
	local sim = alife()
	if not (sim and dest and lvid and gvid) then
		log("plant abort: no sim/dest", "red")
		return
	end
	local m_data = m_state()
	if not m_data then
		log("plant abort: no m_data", "red")
		return
	end

	local id = m_data.dogma_game_global_stash
	local se = id and xobject.se(id)
	if not se_is_box(se) then
		local ok, created = pcall(try_alife_create, SHARED_SEC, dest, lvid, gvid)
		if not (ok and created) then
			log("plant abort: alife_create failed", "red")
			return
		end
		id = created.id
		m_data.dogma_game_global_stash = id
		log("created stash " .. tostr(id), "green")
	else
		local box = xobject.go(id)
		local here = se.position
		if box then
			local ok_here, pos = pcall(try_pos, box)
			if ok_here and pos then
				here = pos
			end
		end
		local dist = -1
		if here then
			local ok_d, d = pcall(try_distance, here, dest)
			if ok_d then
				dist = d
			end
		end
		log(string.format("plant existing stash=%s online=%s dist=%.3f", tostr(id), tostr(box ~= nil), dist))
		if not (here and dist <= PARK_DIST) then
			clear_spawn_cache(id)
			local ok_tp = pcall(try_teleport, sim, id, gvid, lvid, dest)
			if not ok_tp then
				log("teleport failed id=" .. tostr(id), "red")
				return
			end
			log("teleported stash " .. tostr(id), "yellow")
		end
	end

	pcall(try_online, sim, id)
	register_pda(m_data, id)
	log("planted stash " .. tostr(id) .. " online")
	return id
end

local function plant_at(go)
	if not go then
		log("plant abort: no go", "red")
		return
	end
	local dest, lvid, gvid = dest_of(go)
	if not dest then
		log("plant abort: no dest", "red")
		return
	end
	return plant_dest(dest, lvid, gvid)
end

local function cloak_id(id)
	local box = id and xobject.go(id)
	if not box then
		return false
	end
	local ok = pcall(try_cloak, box)
	if not ok then
		log("cloak failed id=" .. tostring(id), "red")
		return false
	end
	log("cloaked stash " .. tostring(id))
	return true
end

local function bring_to_map()
	local actor = db.actor
	if not actor then
		log("map: no actor", "red")
		return
	end

	local m_data = m_state()
	local id = m_data and m_data.dogma_game_global_stash
	if se_is_box(xobject.se(id)) then
		local box = xobject.go(id)
		if box then
			register_pda(m_data, id)
			cloak_id(id)
			return
		end
		log("map: bringing stash under actor")
	else
		log("map: no stash, create under actor")
	end

	local dest, lvid, gvid = dest_of(actor)
	if not dest then
		log("map: no actor dest", "red")
		return
	end
	dest.y = dest.y - 1000
	id = plant_dest(dest, lvid, gvid)
	if not id then
		return
	end
	if cloak_id(id) then
		return
	end
	CreateTimeEvent("dogma_game_global_stash", "cloak_" .. tostring(id), 0.1, function()
		return cloak_id(id)
	end)
end

local function try_open(id)
	local box = id and xobject.go(id)
	if not box then
		return false
	end
	pcall(try_hide_hud)
	local ok = pcall(try_use, box, db.actor)
	if not ok then
		log("use failed id=" .. tostring(id), "red")
		return false
	end
	log("opened stash " .. tostring(id), "green")
	return true
end

function api.open_at(anchor)
	if not anchor then
		log("open abort: no anchor", "red")
		return
	end
	local id = plant_at(anchor)
	if not id then
		return
	end
	if try_open(id) then
		return
	end
	log("open: waiting go " .. tostring(id))
	CreateTimeEvent("dogma_game_global_stash", "open_" .. tostring(id), 0.1, function()
		return try_open(id)
	end)
end

local function maybe_bring()
	if not dogma.sys.ready(MOD_ID, db) then
		return
	end
	if not (level and level.name) then
		return
	end
	local name = level.name()
	if name == planted_level then
		return
	end
	planted_level = name
	log("map now " .. tostring(name))
	bring_to_map()
end

-- HF may bind its stash wrapper after spawn. Put ours back. Shared id untouched.
local function rebind_placeable(id)
	local obj = id and xobject.go(id)
	if not obj then
		return
	end
	local ok, sec = pcall(try_section, obj)
	if not (ok and sec == PLACEABLE_SEC) then
		return
	end
	local bind = rawget(_G, "zzzz_dogma_game_global_stash_bind")
	if not (bind and bind.init) then
		log("rebind skip: bind module missing", "red")
		return
	end
	bind.init(obj)
	log("rebound placeable " .. tostring(id))
end

local function on_load()
	blocked = false
	planted_level = nil
	log("load, resync")
	sync_sprint()
end

local function on_destroy()
	blocked = false
	planted_level = nil
	log("reset (net destroy)")
end

function on_game_start()
	dogma.load(MOD_ID)
	RegisterScriptCallback("actor_on_item_take", sync_sprint)
	RegisterScriptCallback("actor_on_item_drop", sync_sprint)
	RegisterScriptCallback("actor_on_item_take_from_box", sync_sprint)
	RegisterScriptCallback("actor_on_item_put_in_box", sync_sprint)
	RegisterScriptCallback("actor_on_item_use", sync_sprint)
	RegisterScriptCallback("actor_on_trade", sync_sprint)
	RegisterScriptCallback("actor_on_first_update", sync_sprint)
	RegisterScriptCallback("actor_on_update", maybe_bring)
	RegisterScriptCallback("on_game_load", on_load)
	RegisterScriptCallback("actor_on_net_destroy", on_destroy)
	RegisterScriptCallback("hf_on_furniture_place", rebind_placeable)
	log("game/global_stash ready")
end
