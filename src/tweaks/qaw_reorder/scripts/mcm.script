-- tweaks/qaw_reorder conf
-- Injects reorder key into HarukaSai / Balance / Overhaul QAW Controls MCM.

_G.dogma_tweaks_qaw_reorder_conf = {
	MOD_ID = "dogma/tweaks/qaw_reorder",
	QAW_REORDER_KEY_PATH = "haru_quick_action_wheel_mcm/controls/reorder_key",
	QAW_PERSIST_SLOTS_PATH = "haru_quick_action_wheel_mcm/controls/persist_slots",
	loaded = {
		reorder_key = 0,
		persist_slots = false,
	},
}

--[[
	Quick Action Wheel Reorder - MCM

	Injects reorder key into haru_quick_action_wheel_mcm -> Controls (base,
	G.A.M.M.A. Balance, and Overhaul share that module id).
]]

local REORDER_KEY_OPT = {
	id = "reorder_key",
	type = "key_bind",
	val = 2,
	def = 0,
	hint = "dogma_qaw_reorder_key",
}

local PERSIST_SLOTS_OPT = {
	id = "persist_slots",
	type = "check",
	val = 1,
	def = false,
	hint = "dogma_qaw_persist_slots",
}

local function find_gr_child(gr, id)
	if not gr then
		return nil
	end
	for i = 1, #gr do
		if gr[i].id == id then
			return gr[i], i
		end
	end
	return nil
end

local function inject_controls(tree)
	if not tree or type(tree.gr) ~= "table" then
		return
	end
	local controls = find_gr_child(tree.gr, "controls")
	if not (controls and type(controls.gr) == "table") then
		return
	end

	if not find_gr_child(controls.gr, "reorder_key") then
		-- After DOGMA hide_hud inject when present; else after hold; else append.
		local _, at_i = find_gr_child(controls.gr, "hide_hud")
		if not at_i then
			_, at_i = find_gr_child(controls.gr, "hold")
		end
		local at = at_i and (at_i + 1) or (#controls.gr + 1)
		table.insert(controls.gr, at, { id = "divider_dogma_reorder", type = "line" })
		table.insert(controls.gr, at + 1, REORDER_KEY_OPT)
	end

	if not find_gr_child(controls.gr, "persist_slots") then
		local _, at_i = find_gr_child(controls.gr, "reorder_key")
		local at = at_i and (at_i + 1) or (#controls.gr + 1)
		table.insert(controls.gr, at, PERSIST_SLOTS_OPT)
	end
end

local function inject_into_options(options)
	if not options then
		return
	end
	for i = 1, #options do
		if options[i].id == "haru_quick_action_wheel_mcm" then
			inject_controls(options[i])
		end
	end
end

local function wrap_qaw_on_mcm_load()
	local qaw = rawget(_G, "haru_quick_action_wheel_mcm")
	if not (qaw and type(qaw.on_mcm_load) == "function") then
		return
	end
	if qaw._dogma_reorder_mcm then
		return
	end
	local orig = qaw.on_mcm_load
	qaw.on_mcm_load = function(...)
		local tree, name = orig(...)
		if tree then
			inject_controls(tree)
		end
		return tree, name
	end
	qaw._dogma_reorder_mcm = true
end

wrap_qaw_on_mcm_load()

function on_mcm_load(options)
	wrap_qaw_on_mcm_load()
	inject_into_options(options)

	dogma_mcm.append(options, "tweaks", "ui_mcm_menu_dogma_tweaks", {
		{
			id = "qaw_reorder_description",
			type = "desc",
			text = "ui_mcm_dogma_tweaks_qaw_reorder_page_description",
		},
	})
end
