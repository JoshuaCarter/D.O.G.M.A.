--[[
	Max visibility cap after Stealth_ get_visible_value (actor only).
	min(ret, vis_threshold × pose cap). Stealth formula untouched.
]]

local CONFIG = _G.dogma_gameplay_pose_visibility_conf
local FLAG = "__dogma_pose_visibility"

local function refresh_settings()
	local d = CONFIG.DEFAULTS
	local L = CONFIG.loaded
	local prev_stand = L.cap_stand
	local prev_crouch = L.cap_crouch
	local prev_prone = L.cap_prone
	L.cap_stand = dogma.mcm.float(CONFIG.MOD_ID, "cap_stand", d.cap_stand)
	L.cap_crouch = dogma.mcm.float(CONFIG.MOD_ID, "cap_crouch", d.cap_crouch)
	L.cap_prone = dogma.mcm.float(CONFIG.MOD_ID, "cap_prone", d.cap_prone)
	if prev_stand ~= nil and (prev_stand ~= L.cap_stand or prev_crouch ~= L.cap_crouch or prev_prone ~= L.cap_prone) then
		dogma.console.say(string.format(
			"pose visibility caps: stand %.2f->%.2f crouch %.2f->%.2f prone %.2f->%.2f",
			prev_stand, L.cap_stand, prev_crouch, L.cap_crouch, prev_prone, L.cap_prone
		), "blue")
	end
end

local function pose_cap()
	local L = CONFIG.loaded
	if IsMoveState("mcCrouch") then
		if IsMoveState("mcAccel") then
			return L.cap_prone
		end
		return L.cap_crouch
	end
	return L.cap_stand
end

local function apply_vmm_hook()
	local vmm = rawget(_G, "visual_memory_manager")
	if not (vmm and type(vmm.get_visible_value) == "function") or vmm[FLAG] then
		return
	end

	local orig = vmm.get_visible_value
	vmm.__dogma_orig_gvv = orig
	vmm.get_visible_value = function(npc, who, ...)
		local ret = orig(npc, who, ...)
		if not (who and db.actor and who:id() == db.actor:id()) then
			return ret
		end
		if not (npc and npc.visibility_threshold) then
			return ret
		end
		local ok, vis_t = pcall(function()
			return npc:visibility_threshold()
		end)
		if not (ok and vis_t and vis_t > 0) then
			return ret
		end
		local cap = vis_t * pose_cap()
		if ret > cap then
			return cap
		end
		return ret
	end
	vmm[FLAG] = true
end

local function reset_vmm_hook()
	local vmm = rawget(_G, "visual_memory_manager")
	if not vmm then
		return
	end
	if type(vmm.__dogma_orig_gvv) == "function" then
		vmm.get_visible_value = vmm.__dogma_orig_gvv
		vmm.__dogma_orig_gvv = nil
	end
	vmm[FLAG] = nil
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	refresh_settings()
	RegisterScriptCallback("actor_on_first_update", apply_vmm_hook)
	RegisterScriptCallback("on_option_change", refresh_settings)
	RegisterScriptCallback("on_game_load", function()
		reset_vmm_hook()
		apply_vmm_hook()
	end)
end
