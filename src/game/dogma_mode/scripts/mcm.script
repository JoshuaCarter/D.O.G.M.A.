-- game/dogma_mode — menu wrap (must be *mcm.script for cold-boot New Game).
-- Randomize → PREP (settings + pistol + kit) or START (flag + LoadMap + OnStartGame).

local MOD_ID = "dogma/game/dogma_mode"
local HARD = 3
local LIVES = 2
local WPNS = { "wpn_colt1911_n", "wpn_sig220_n" }
local KIT = {
	{ sec = "itm_ammokit", n = 1 },
	{ sec = "medkit", n = 1, uses = 2 },
	{ sec = "yadylin", n = 2 },
	{ sec = "helm_resp", n = 1 },
}
local FLAG_SUB = "dogma_start_kit.flag"

local STATE = _G.__dogma_game_dogma_mode or {}
_G.__dogma_game_dogma_mode = STATE

local function flag_path()
	if not (getFS and getFS().update_path) then
		return nil
	end
	local ok, path = pcall(function()
		return getFS():update_path("$app_data_root$", FLAG_SUB)
	end)
	if ok and path and path ~= "" then
		return path
	end
end

local function write_flag()
	local path = flag_path()
	if not path then
		return false
	end
	local f = io.open(path, "w")
	if not f then
		return false
	end
	f:write("1\n")
	f:close()
	return true
end

local function clear_flag()
	local path = flag_path()
	if path then
		pcall(os.remove, path)
	end
end

local function set_check(self, key, on)
	if self[key] and self[key].SetCheck then
		self[key]:SetCheck(on)
	end
	if self.ck_states then
		self.ck_states[key] = on
	end
end

local function is_on(self, key)
	if self[key] and self[key].GetCheck then
		return self[key]:GetCheck() and true or false
	end
	return self.ck_states and self.ck_states[key] and true or false
end

local function pick_hard(self, list, tbl, sel)
	local t = self[tbl]
	local pick = t and (t[HARD] or t[1])
	if not (pick and self[list]) then
		return
	end
	self[list]:SetText(game.translate_string(pick))
	self[sel] = pick
end

local function lives_row(self)
	local t = self.table_hardcore_lives
	if not t then
		return
	end
	for i = 1, #t do
		local row = t[i]
		if type(row) == "table" and row[1] == LIVES then
			return i, row
		end
	end
end

local function has_sec(cont, sec)
	if not (cont and cont.cell and sec) then
		return false
	end
	for _, ci in pairs(cont.cell) do
		if ci and ci.section == sec and (not ci.IsShown or ci:IsShown()) then
			return true
		end
	end
	return false
end

local function is_pistol(sec)
	return sec and ini_sys and ini_sys:r_string_ex(sec, "kind") == "w_pistol"
end

local function cheapest_pistol(cont)
	local best, cost
	if not (cont and cont.cell) then
		return
	end
	for _, ci in pairs(cont.cell) do
		if ci and is_pistol(ci.section) and (not ci.IsShown or ci:IsShown()) then
			local c = (ci.flags and (ci.flags.value or ci.flags.info)) or 0
			if not cost or c < cost then
				best, cost = ci.section, c
			end
		end
	end
	return best
end

local function pick_wpn(self)
	local shop = self.CC and self.CC["loadout"]
	local inv = self.CC and self.CC["inventory"]
	for i = 1, #WPNS do
		local sec = WPNS[i]
		if has_sec(shop, sec) or has_sec(inv, sec) then
			return sec
		end
	end
	return cheapest_pistol(shop) or cheapest_pistol(inv)
end

local function has_wpn(self)
	local wpn = pick_wpn(self)
	return wpn and has_sec(self.CC and self.CC["inventory"], wpn)
end

local function is_ready(self)
	local lives = self.selected_hardcore_lives
	local td, te = self.table_difficulty, self.table_economy
	return is_on(self, "ck_story")
		and not is_on(self, "ck_warfare")
		and not is_on(self, "ck_azazel_mode")
		and is_on(self, "ck_hardcore")
		and not is_on(self, "ck_soulslike_mode")
		and type(lives) == "table" and lives[1] == LIVES
		and td and self.selected_difficulty == (td[HARD] or td[1])
		and te and self.selected_economy == (te[HARD] or te[1])
		and has_wpn(self)
end

local function relabel(self)
	local btn = self.btn_random
	local tc = btn and btn.TextControl and btn:TextControl()
	if tc and tc.SetTextST then
		tc:SetTextST(is_ready(self) and "st_mm_btn_dogma_start" or "st_mm_btn_new_game_rand")
	end
end

local function take(self, sec, n)
	local shop = self.CC and self.CC["loadout"]
	local inv = self.CC and self.CC["inventory"]
	if not (sec and inv) then
		return
	end
	for _ = 1, (n or 1) do
		if shop and shop.TransferItem and has_sec(shop, sec) then
			shop:TransferItem(inv, nil, sec)
		elseif inv.AddItem then
			inv:AddItem(nil, sec)
		end
	end
end

local function prep(self)
	if self.OnCheckResetList then
		self:OnCheckResetList()
	elseif self.LoadLoadout then
		self:LoadLoadout(false)
	end
	take(self, pick_wpn(self), 1)
	for i = 1, #KIT do
		take(self, KIT[i].sec, KIT[i].n)
	end
	set_check(self, "ck_story", true)
	set_check(self, "ck_warfare", false)
	set_check(self, "ck_azazel_mode", false)
	set_check(self, "ck_hardcore", true)
	set_check(self, "ck_soulslike_mode", false)
	if self.LoadHardcoreLives then
		self:LoadHardcoreLives(false)
	end
	local idx, row = lives_row(self)
	local list = self.list_hardcore_lives
	if idx and list then
		if list.SetCurrentIdx then
			list:SetCurrentIdx(idx - 1)
		end
		if list.GetTextOf and list.SetText then
			local text = list:GetTextOf(idx - 1)
			if text and text ~= "" then
				list:SetText(text)
			end
		end
	end
	if row then
		self.selected_hardcore_lives = row
	end
	pick_hard(self, "list_difficulty", "table_difficulty", "selected_difficulty")
	pick_hard(self, "list_economy", "table_economy", "selected_economy")
end

-- LoadMap then OnStartGame need a frame between them (menu has no TimeEvent).
local function apply_level(self)
	local keep = self.selected_map
	if self.LoadMap then
		self:LoadMap(false)
	end
	if not (keep and self.table_map and self.list_map) then
		return
	end
	for i = 1, #self.table_map do
		if self.table_map[i] == keep then
			self.selected_map = keep
			self.list_map:SetText(game.translate_string("ui_st_" .. keep))
			if self.UpdateMap then
				self:UpdateMap()
			end
			return
		end
	end
end

local function on_click(self)
	if STATE.phase then
		return
	end
	if not is_ready(self) then
		prep(self)
		relabel(self)
		return
	end
	write_flag()
	STATE.dlg = self
	STATE.phase = "level"
end

local function wrap_once(cls, key, state_key, make)
	if STATE[state_key] and cls[key] == STATE[state_key] then
		return
	end
	local wrapped = make(cls[key])
	if not wrapped then
		return
	end
	cls[key] = wrapped
	STATE[state_key] = wrapped
end

local function patch_new_game()
	STATE.phase = nil
	STATE.dlg = nil
	local cls = ui_mm_faction_select and ui_mm_faction_select.UINewGame
	if not cls then
		return false
	end
	wrap_once(cls, "Register", "wrap_reg", function(base)
		if not base then
			return
		end
		return function(self, wnd, name, ...)
			if name == "btn_random" then
				self.btn_random = wnd
			end
			return base(self, wnd, name, ...)
		end
	end)
	wrap_once(cls, "OnRandomize", "wrap_rand", function(base)
		if not base then
			return
		end
		return on_click
	end)
	wrap_once(cls, "Update", "wrap_update", function(base)
		return function(self, ...)
			if base then
				base(self, ...)
			end
			if STATE.dlg == self and STATE.phase == "level" then
				apply_level(self)
				STATE.phase = "start"
			elseif STATE.dlg == self and STATE.phase == "start" then
				STATE.phase = nil
				STATE.dlg = nil
				if self.OnStartGame then
					self:OnStartGame()
				end
			elseif not STATE.phase then
				relabel(self)
			end
		end
	end)
	wrap_once(cls, "Main_Controls", "wrap_controls", function(base)
		if not base then
			return
		end
		return function(self, ...)
			local r = base(self, ...)
			wrap_once(cls, "OnRandomize", "wrap_rand", function(b)
				if b then
					return on_click
				end
			end)
			relabel(self)
			return r
		end
	end)
	return true
end

_G.dogma_game_dogma_mode_conf = {
	MOD_ID = MOD_ID,
	DEFAULTS = {},
	loaded = {},
	flag_path = flag_path,
	write_flag = write_flag,
	clear_flag = clear_flag,
	patch_new_game = patch_new_game,
	KIT = KIT,
}

local CONFIG = _G.dogma_game_dogma_mode_conf
CONFIG.patch_new_game()
RegisterScriptCallback("main_menu_on_init", CONFIG.patch_new_game)

function on_mcm_load(options)
	CONFIG.patch_new_game()
	dogma_mcm.attach(options, "game", "ui_mcm_menu_dogma_game", {
		id = "dogma_mode",
		sh = true,
		text = "ui_mcm_menu_dogma_game_dogma_mode",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_game_dogma_mode_page_description",
			},
		}),
	})
end
