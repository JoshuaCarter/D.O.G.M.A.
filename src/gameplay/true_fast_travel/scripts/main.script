-- True Fast Travel MVP: config + single PDA "Travel here" menu item.

local CONFIG = _G.dogma_gameplay_true_fast_travel_conf
_G.tft_config = _G.tft_config or {}
local tft_config = _G.tft_config
local tft = _G.tft

local function load_config()
	local dogma = tft and tft.dogma
	tft_config.debug_overlay = (dogma and dogma.dbg and dogma.dbg.overlay_enabled and dogma.dbg.overlay_enabled()) or false
	tft_config.debug_log = (dogma and dogma.dbg and dogma.dbg.logging and dogma.dbg.logging()) or false
	tft_config.time_factor_travel = 2.0
	tft_config.show_hud_during_travel = true
	tft_config.path_preview = true
	tft_config.visited_radius_m = (CONFIG and CONFIG.DEFAULTS and CONFIG.DEFAULTS.visited_radius_m) or 30
	tft_config.screen_msg_duration = (CONFIG and CONFIG.DEFAULTS and CONFIG.DEFAULTS.screen_msg_duration) or 4

	if dogma and dogma.dbg and dogma.dbg.set_enabled then
		dogma.dbg.set_enabled(CONFIG.MOD_ID, dogma.dbg.overlay_enabled())
	end
end

refresh_active_config = function()
	tft.active_config = {
		screen_msg_duration = tft_config.screen_msg_duration or 4,
		message_duration = tft_config.screen_msg_duration or 4,
	}
	return tft.active_config
end

local function actor_on_before_hit(shit, bone_id)
	if tft_is_safety_active and tft_is_safety_active() then
		shit.power = 0
	end
end

local function on_option_change()
	load_config()
	refresh_active_config()
end

local function menu_item_is_ours(text)
	if not text then return false end
	local travel = tft_str("tft_menu_travel_here")
	return string.find(text, travel, 1, true) ~= nil
end

local function strip_own_menu_items(pui)
	if not (pui and pui.GetSize and pui.RemoveItem) then return end
	local ok, size = pcall(function() return pui:GetSize() end)
	if not ok or not size then return end
	for i = size - 1, 0, -1 do
		local ok_t, text = pcall(function() return pui:GetItem(i) end)
		if ok_t and menu_item_is_ours(text) then
			pcall(function() pui:RemoveItem(i) end)
		end
	end
end

local function add_travel_item(pui, id)
	if tft_is_destination_unlocked and not tft_is_destination_unlocked(id) then
		pui:AddItem(tft_str("tft_menu_not_visited"))
		return false
	end
	pui:AddItem(tft_str("tft_menu_travel_here"))
	return true
end

local function on_map_right_click(property_ui, map_table)
	if tft.right_click_avail then
		tft.menu_open_seq = (tft.menu_open_seq or 0) + 1
		tft.menu_primary_seq = nil
		tft.menu_strip_seq = nil
	end
	if tft_report_map_click then
		tft_report_map_click(map_table, nil)
	end
end

local function on_map_spot_menu_add_property(pui, id, ln, hint)
	local ok, err = xpcall(function()
		if not pui then return end

		if not tft.right_click_avail then
			tft.menu_open_seq = (tft.menu_open_seq or 0) + 1
			tft.menu_primary_seq = nil
			tft.menu_strip_seq = nil
			if tft_report_map_click then
				tft_report_map_click({ object_id = id, level_name = ln, pos = tft.last_map_click_pos }, hint)
			end
		end

		local seq = tft.menu_open_seq or 0
		if tft.menu_primary_seq == seq then
			return
		end
		if tft.menu_strip_seq ~= seq then
			tft.menu_strip_seq = seq
			strip_own_menu_items(pui)
		end

		tft.last_menu_target_id = id
		tft.last_menu_target_ln = ln

		if tft.is_traveling then return end

		local se_obj = alife_object(id)
		local is_lc = tft_is_pda_transition and tft_is_pda_transition(id, se_obj)
		local is_campfire = tft_is_campfire and tft_is_campfire(id, se_obj)
		local is_base = tft_is_base and tft_is_base(id, se_obj)
		local cross_zone = tft_is_cross_zone_destination and tft_is_cross_zone_destination(se_obj, ln)

		if not (is_lc or is_campfire or is_base) then
			if tft_clear_path_preview then tft_clear_path_preview() end
			return
		end
		if (is_campfire or is_base) and cross_zone then
			if tft_clear_path_preview then tft_clear_path_preview() end
			return
		end

		local click_pos = tft.last_map_click_pos
		local target, terr = tft_resolve_travel_target(id, ln, click_pos)
		if not target and not is_lc then
			target = tft_fallback_travel_target and tft_fallback_travel_target(id, se_obj, tft_object_on_actor_level(se_obj, ln))
		end
		if not target then
			if tft_clear_path_preview then tft_clear_path_preview() end
			return
		end

		tft.last_menu_target_id = id
		tft.menu_primary_seq = seq
		if tft_is_destination_unlocked and not tft_is_destination_unlocked(id) then
			if tft_clear_path_preview then tft_clear_path_preview() end
		else
			pcall(function()
				if tft_build_path_preview then
					tft_build_path_preview(id, is_lc)
				end
			end)
		end
		add_travel_item(pui, id)
	end, debug.traceback)
	if not ok then
		tft_log_error("map_spot_menu_add_property error: %s", tostring(err))
	end
end

local function on_map_spot_menu_property_clicked(pui, id, ln, t)
	local ok, err = xpcall(function()
		local result = t or (pui and pui.GetResult and pui:GetResult())
		if not result then return end
		if not menu_item_is_ours(result) then return end

		id = tft.last_menu_target_id or id
		ln = tft.last_menu_target_ln or ln
		local se_click = alife_object(id)
		local is_lc = tft_is_pda_transition and tft_is_pda_transition(id, se_click)

		local target, terr = tft_resolve_travel_target(id, ln, tft.last_map_click_pos)
		if not target and not is_lc then
			target = tft_fallback_travel_target and tft_fallback_travel_target(id, se_click, tft_object_on_actor_level(se_click, ln))
		end
		if not target then
			tft_log_error("menu click: no target id=%s err=%s", tostring(id), tostring(terr))
			return
		end

		if tft_clear_path_preview then tft_clear_path_preview() end
		tft.travel_mode = "normal"
		tft.final_pos = vector():set(target.pos.x, target.pos.y, target.pos.z)
		tft.final_lvid = target.lvid
		tft.last_menu_target_id = id
		tft_start_travel_sequence(target.pos, target.lvid, target.gvid, is_lc, target.gvid)
	end, debug.traceback)
	if not ok then
		tft_log_error("map_spot_menu_property_clicked error: %s", tostring(err))
	end
end

local function on_save_state(m_data)
	if tft_force_clean_walk_for_save then
		pcall(tft_force_clean_walk_for_save)
	end
end

local function actor_on_first_update()
	if tft_build_dynamic_map then pcall(tft_build_dynamic_map) end
	if tft_ensure_destination_map_spots then pcall(tft_ensure_destination_map_spots) end
	if _G.tft_nav_mesh_try_load then pcall(_G.tft_nav_mesh_try_load) end
end

local function on_game_load()
	if tft_load then tft_load() end
	if tft_clear then tft_clear() end
	if _G.tft_cancel_fly_camera then pcall(_G.tft_cancel_fly_camera) end
end

function on_game_start()
	tft.dogma = DOGMA
	load_config()
	refresh_active_config()

	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_before_hit", actor_on_before_hit)
	RegisterScriptCallback("actor_on_update", function()
		if tft_actor_on_update then tft_actor_on_update() end
	end)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("on_game_load", on_game_load)
	RegisterScriptCallback("save_state", on_save_state)
	RegisterScriptCallback("map_spot_menu_add_property", on_map_spot_menu_add_property)
	RegisterScriptCallback("map_spot_menu_property_clicked", on_map_spot_menu_property_clicked)
	if _G.tft_nav_mesh_on_level_change then
		RegisterScriptCallback("on_level_changing", function()
			pcall(_G.tft_nav_mesh_on_level_change)
		end)
	end

	if RegisterScriptCallback then
		pcall(function()
			RegisterScriptCallback("map_right_click", on_map_right_click)
			tft.right_click_avail = true
		end)
	end

	if tft_poll_discoveries then
		RegisterScriptCallback("actor_on_update", function()
			if not tft.is_traveling then
				pcall(tft_poll_discoveries)
			end
		end)
	end

	printf("[dogma_gameplay_true_fast_travel] MVP main started")
end

_G.refresh_active_config = refresh_active_config
