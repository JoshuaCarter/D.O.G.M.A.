-- controls/ammo_selector conf
-- MCM mirror of Settings → Controls "Ammo Selector" (wpn_next / kWPN_NEXT).
-- Optional hold: open while held, close on release (vanilla is release-to-open).

local defaults = {
	-- 0 = toggle (vanilla release-open), 2 = hold (open on down, close on up)
	["mode"] = 2,
	-- Hold only: ms to wait before opening (release before this = no open).
	["hold_delay_ms"] = 200,
	-- Hold only: release while hovering a slot selects it (like a click).
	["select_on_release"] = true,
}

_G.dogma_controls_ammo_selector_conf = {
	MOD_ID = "dogma/controls/ammo_selector",
	DEFAULTS = defaults,
	loaded = {
		mode = defaults["mode"],
		hold_delay_ms = defaults["hold_delay_ms"],
		select_on_release = defaults["select_on_release"],
	},
}
