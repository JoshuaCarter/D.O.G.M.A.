-- tweaks/quick_fire conf (info-only MCM; always on while installed)

_G.dogma_tweaks_quick_fire_conf = {
	MOD_ID = "dogma/tweaks/quick_fire",
}

function on_mcm_load(options)
	dogma_mcm.append(options, "tweaks", "ui_mcm_menu_dogma_tweaks", {
		{
			id = "quick_fire_description",
			type = "desc",
			text = "ui_mcm_dogma_tweaks_quick_fire_page_description",
		},
	})
end
