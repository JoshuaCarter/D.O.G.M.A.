--[[
	No Waypoint PDA Msg

	PAW has no MCM switch for reach/clear tips. Autoclear / remove nils
	task_placeable_waypoint, the engine completes it, and
	news_manager.send_task shows "Mission complete: Placed Waypoint…".

	Drop complete/fail (and reverse) for that task id only.
]]

local CONFIG = _G.dogma_tweaks_no_waypoint_pda_msg_conf
local WP_TASK = "task_placeable_waypoint"
local DROP = {
	complete = true,
	fail = true,
	reversed = true,
}

local function patch()
	if not (news_manager and type(news_manager.send_task) == "function") then
		return false
	end
	if news_manager.__dogma_no_wp_pda then
		return true
	end

	local orig = news_manager.send_task
	news_manager.send_task = function(actor, typ, tsk)
		if DROP[typ] and tsk and tsk.get_id and tsk:get_id() == WP_TASK then
			return false
		end
		return orig(actor, typ, tsk)
	end
	news_manager.__dogma_no_wp_pda = true
	return true
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	patch()
	RegisterScriptCallback("actor_on_first_update", patch)
	RegisterScriptCallback("on_game_load", patch)
end
