	["line_r"] = 255,
	["line_g"] = 255,
	["line_b"] = 255,
	["line_a"] = 100,
}

_G.dogma_gui_stalker_id_conf = {
	MOD_ID = "dogma/gui/stalker_id",
	DEFAULTS = defaults,
	loaded = {
		dead_id = defaults["dead_id"],
		name_id = defaults["name_id"],
		rank_id = defaults["rank_id"],
		name_y = defaults["name_y"],
		rank_y = defaults["rank_y"],
		icon_y = defaults["icon_y"],
		name_a = defaults["name_a"],
		rank_a = defaults["rank_a"],
		icon_a = defaults["icon_a"],
