-- hud/bhs_reactive conf
-- Hide classic BHS / status icons; show reactively on damage, hold, or vital tiers.

local defaults = {
	["hide_bhs"] = true,
	["key_bhs"] = -1,
	["key_bhs_modifier"] = 0,
	["show_on_damage"] = true,
	["sec"] = 30,
	["full_heal_clamp_sec"] = 10,
	["hide_status_icons"] = true,
	["key_icons"] = -1,
	["key_icons_modifier"] = 0,
	["icons_radiation"] = true,
	["icons_bleed"] = true,
	["icons_hunger"] = true,
	["icons_thirst"] = true,
	["icons_sleep"] = true,
	["grey_hide_after_sec"] = 3,
}

_G.dogma_hud_bhs_reactive_conf = {
	MOD_ID = "dogma/hud/bhs_reactive",
	DEFAULTS = defaults,
	loaded = {
		hide_bhs = defaults["hide_bhs"],
		key_bhs = defaults["key_bhs"],
		key_bhs_modifier = defaults["key_bhs_modifier"],
		show_on_damage = defaults["show_on_damage"],
		sec = defaults["sec"],
		full_heal_clamp_sec = defaults["full_heal_clamp_sec"],
		hide_status_icons = defaults["hide_status_icons"],
		key_icons = defaults["key_icons"],
		key_icons_modifier = defaults["key_icons_modifier"],
		icons_radiation = defaults["icons_radiation"],
		icons_bleed = defaults["icons_bleed"],
		icons_hunger = defaults["icons_hunger"],
		icons_thirst = defaults["icons_thirst"],
		icons_sleep = defaults["icons_sleep"],
		grey_hide_after_sec = defaults["grey_hide_after_sec"],
	},
}
