local function format_msg(fmt, ...)
	local arg = { ... }
	if #arg == 0 then return tostring(fmt) end
	local ok, res = pcall(string.format, fmt, ...)
	return ok and res or (tostring(fmt) .. " (format error)")
end

local function log(fmt, ...)
	local cfg = _G.tft_config
	if not (cfg and cfg.debug_log) then return end
	local tft_dogma = _G.tft and _G.tft.dogma
	if tft_dogma and tft_dogma.dbg then
		tft_dogma.dbg.log("dogma/gameplay/true_fast_travel", format_msg(fmt, ...))
	end
end

local function path_road_log(fmt, ...)
	log("[path-road] " .. fmt, ...)
end

local function log_error(fmt, ...)
	local tft_dogma = _G.tft and _G.tft.dogma
	if tft_dogma and tft_dogma.dbg then
		tft_dogma.dbg.log("dogma/gameplay/true_fast_travel", "[ERROR] " .. format_msg(fmt, ...))
	end
end

local function str(id)
	local s = game.translate_string(id)
	if s and s ~= "" and s ~= id then return s end
	return id
end

local function set_fft_trip_in_progress(active)
	_G.game_fast_travel = _G.game_fast_travel or {}
	_G.game_fast_travel.trip_in_progress = active and true or false
end

local function destination_on_other_level(obj)
	if not (obj and db.actor) then return false end
	local gg = game_graph()
	if not gg then return false end
	local ok_a, actor_lid = pcall(function() return gg:vertex(db.actor:game_vertex_id()):level_id() end)
	local ok_d, dest_lid = pcall(function() return gg:vertex(obj.m_game_vertex_id):level_id() end)
	return ok_a and ok_d and actor_lid ~= dest_lid
end

local function object_on_loaded_level(se_obj)
	if not (se_obj and db.actor and game_graph) then return true end
	local gg = game_graph()
	local obj_gvid = se_obj.m_game_vertex_id
	if not (obj_gvid and gg.valid_vertex_id and gg:valid_vertex_id(obj_gvid)) then
		return not destination_on_other_level(se_obj)
	end
	local ok_a, actor_lid = pcall(function() return gg:vertex(db.actor:game_vertex_id()):level_id() end)
	local ok_o, obj_lid = pcall(function() return gg:vertex(obj_gvid):level_id() end)
	return ok_a and ok_o and actor_lid == obj_lid
end

local function is_cross_zone_destination(se_obj, ln)
	local cur_lvl = (level and level.name) and level.name() or nil
	if ln and cur_lvl and ln ~= cur_lvl then return true end
	if se_obj then return destination_on_other_level(se_obj) end
	return false
end

local function is_trader_restrictor(name)
	if not name then return false end
	local low_name = string.lower(name)
	local sfind = string.find
	return sfind(low_name, "trader", 1, true) ~= nil
		or sfind(low_name, "merchant", 1, true) ~= nil
		or sfind(low_name, "barman", 1, true) ~= nil
		or sfind(low_name, "sidorovich", 1, true) ~= nil
		or sfind(low_name, "saharov", 1, true) ~= nil
		or sfind(low_name, "forester", 1, true) ~= nil
end

msg = function(text, style)
	if not (db.actor and db.actor:alive()) then return end
	if not text or text == "" then return end
	local cfg = tft.active_config or {}
	local duration = tonumber(cfg.screen_msg_duration) or 4
	if duration <= 0 then return end
	if actor_menu and actor_menu.set_msg then
		actor_menu.set_msg(1, text, duration)
	end
end

do
	_G.tft_config = _G.tft_config or {}
	_G.tft_log = log
	_G.tft_path_road_log_enabled = function()
		local cfg = _G.tft_config
		return cfg and cfg.debug_log
	end
	_G.tft_path_road_log = path_road_log
	_G.tft_log_error = log_error
	_G.tft_str = str
	_G.tft_destination_on_other_level = destination_on_other_level
	_G.tft_object_on_loaded_level = object_on_loaded_level
	_G.tft_is_cross_zone_destination = is_cross_zone_destination
	_G.tft_is_trader_restrictor = is_trader_restrictor
	_G.tft_msg = msg
	_G.tft_set_fft_trip_in_progress = set_fft_trip_in_progress
	printf("[dogma_gameplay_true_fast_travel] MVP core loaded")
end
