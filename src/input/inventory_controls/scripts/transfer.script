--[[
	Inventory transfer keybind (hold+hover, replaces GAMMA Fast Transfer).
	All stacks: every item in the cell.
	One stack: only the hovered row. Picker: both stay on that row.
]]

local CONFIG = _G.dogma_input_inventory_controls_conf
local MOD_ID = CONFIG.MOD_ID

local ALLOWED_BAGS = {
	actor_bag = true,
	npc_bag = true,
	actor_trade = true,
	actor_trade_bag = true,
	npc_trade = true,
	npc_trade_bag = true,
	picker = true,
}

local BATCH_SIZE = 10
local LSHIFT = DIK_keys.DIK_LSHIFT
local RSHIFT = DIK_keys.DIK_RSHIFT

local key_all = nil
local mod_all = 0
local key_one = nil
local mod_one = 0
local bind_all = nil
local bind_one = nil
local allow = 0
local original_action_move = nil
local original_action_move_all = nil

local function log(msg)
	if dogma.log.logging() then
		dogma.log.log(MOD_ID, tostring(msg))
	end
end

local function is_shift_key(dik)
	return dik == LSHIFT or dik == RSHIFT
end

local function on_option_change()
	key_all = dogma.mcm.key(MOD_ID, "key_transfer")
	mod_all = dogma.mcm.int(MOD_ID, "key_transfer_modifier", 0)
	key_one = dogma.mcm.key(MOD_ID, "key_transfer_one")
	mod_one = dogma.mcm.int(MOD_ID, "key_transfer_one_modifier", 0)
	if bind_all then
		_G.dogma_inv_hover.reset(bind_all)
	end
	if bind_one then
		_G.dogma_inv_hover.reset(bind_one)
	end
	log(string.format(
		"transfer keys all=%s one=%s suppress_shift=%s",
		tostring(key_all),
		tostring(key_one),
		tostring(is_shift_key(key_all) or is_shift_key(key_one))
	))
end

local function inv_mode_ok(gui)
	local mode = gui and gui.mode
	return mode == "inventory" or mode == "loot" or mode == "trade"
end

local function dik_down(dik, modifier)
	if not dik then
		return false
	end
	local down
	if dik == LSHIFT or dik == RSHIFT then
		down = dogma.input.is_shift_down()
	else
		down = dogma.input.is_key_down(dik)
	end
	return down and dogma.input.is_mod_down(modifier)
end

local function key_all_down()
	return dik_down(key_all, mod_all)
end

local function key_one_down()
	return dik_down(key_one, mod_one)
end

-- Stock/GAMMA shift-hover also calls Action_Move. When either of our
-- transfer binds is Shift, swallow those so only hold+hover runs.
local function suppress_inner()
	if allow ~= 0 then
		return false
	end
	if not dogma.input.is_shift_down() then
		return false
	end
	return is_shift_key(key_all) or is_shift_key(key_one)
end

local function tick(gui)
	if gui and suppress_inner() then
		gui.holding_shift = false
	end
end

local function move_one(gui, obj, bag)
	if not (gui and obj and bag and gui.Action_Move) then
		return false
	end
	if gui.Cond_Move and not gui:Cond_Move(obj, bag) then
		return false
	end
	allow = allow + 1
	gui:Action_Move(obj, bag)
	allow = allow - 1
	return true
end

local function move_wrapper(self, obj, bag)
	if suppress_inner() or not original_action_move then
		return
	end
	return original_action_move(self, obj, bag)
end

local function move_all_wrapper(self, obj, bag)
	if suppress_inner() or not original_action_move_all then
		return
	end
	return original_action_move_all(self, obj, bag)
end

local function reapply_move_patch()
	local cls = ui_inventory and ui_inventory.UIInventory
	if not cls then
		return
	end
	if cls.Action_Move and cls.Action_Move ~= move_wrapper then
		original_action_move = cls.Action_Move
		cls.Action_Move = move_wrapper
		log("Action_Move patched")
	end
	if cls.Action_Move_All and cls.Action_Move_All ~= move_all_wrapper then
		original_action_move_all = cls.Action_Move_All
		cls.Action_Move_All = move_all_wrapper
		log("Action_Move_All patched")
	end
end

local function on_gui_on_show(name)
	if name == "UIInventory" then
		reapply_move_patch()
	end
end

local function move_many(gui, items, bag)
	local ids = {}
	for i = 1, #items do
		ids[#ids + 1] = items[i]:id()
	end
	local i = 1
	CreateTimeEvent("dogma_transfer", ids[1], 0, function()
		local g = ui_inventory and ui_inventory.GUI
		if not (g and g.IsShown and g:IsShown()) then
			return true
		end
		for _ = 1, BATCH_SIZE do
			if i > #ids then
				return true
			end
			local item = level.object_by_id(ids[i])
			if item then
				move_one(g, item, bag)
			end
			i = i + 1
		end
		return false
	end)
end

local function fire(whole)
	return function(gui, obj, bag)
		local from = _G.dogma_inv_hover.source_bag(gui, bag)
		if not from then
			return
		end
		-- SFX is vanilla: take = actor_on_item_take, put = put_in_box from
		-- still_refresh / LMode_RefreshInventories. Do not play_item_sound here.
		local items = _G.dogma_inv_hover.stack_items(gui, obj, bag, whole)
		if #items <= 1 then
			move_one(gui, obj, from)
			return
		end
		move_many(gui, items, from)
	end
end

function on_game_start()
	dogma.load(MOD_ID)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_first_update", reapply_move_patch)
	RegisterScriptCallback("GUI_on_show", on_gui_on_show)
	on_option_change()
	reapply_move_patch()
	bind_all = _G.dogma_inv_hover.register({
		key_down = key_all_down,
		mode_ok = inv_mode_ok,
		bags = ALLOWED_BAGS,
		still = true,
		tick = tick,
		fire = fire(true),
	})
	bind_one = _G.dogma_inv_hover.register({
		key_down = key_one_down,
		mode_ok = inv_mode_ok,
		bags = ALLOWED_BAGS,
		still = true,
		tick = tick,
		fire = fire(false),
	})
	log("transfer keys ready")
end
