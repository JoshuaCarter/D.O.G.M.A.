-- items/disassemble conf — shared CONFIG for disassemble / tools / attachments / PDA stash.

local defaults = {
	["attachments_enabled"] = false,
	["disa_safe_equipped"] = true,
	["key_disa"] = -1,
	["key_disa_all"] = -1,
	["key_disa_all_mode"] = 2,
	["key_disa_all_modifier"] = 0,
	["key_disa_mode"] = 0,
	["key_disa_modifier"] = 0,
	["pda_grants_stash_coords"] = true,
	["tools_enabled"] = true,
}

_G.dogma_items_disassemble_conf = {
	MOD_ID = "dogma/items/disassemble",
	defaults = defaults,
	CONFIG = {
		attachments_enabled = defaults["attachments_enabled"],
		attach_enabled = defaults["attachments_enabled"],
		disa_safe_equipped = defaults["disa_safe_equipped"],
		pda_grants_stash_coords = defaults["pda_grants_stash_coords"],
		tools_enabled = defaults["tools_enabled"],
	},
}

function _G.dogma_items_disassemble_conf:ensure_dogma()
	if not self.DOGMA then
		self.DOGMA = dogma_common.load(self.MOD_ID)
	end
	return self.DOGMA
end
