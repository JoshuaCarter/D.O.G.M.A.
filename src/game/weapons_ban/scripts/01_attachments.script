-- Known junk / outfit. Scan will not spawn, strip, or log these.
add_ignore({
	"infiltrator_tactical_kit_off",
	"spectre_tactical_kit_off",
	"cleaning_kit_u",
})

local function fill_buckets(buckets)
	for cat, tiers in pairs(BY_TIER) do
		for t = 1, 5 do
			local src = tiers[t]
			local dst = buckets[cat][t]
			for i = 1, #src do
				local sec = src[i]
				if ini_sys:section_exist(sec) then
					dst[#dst + 1] = sec
				end
			end
		end
	end
end

local function each_cost(fn)
	for cat, ids in pairs(COST) do
		for i = 1, #ids do
			fn(cat, ids[i])
		end
	end
end

_G.dogma_game_weapons_ban_lists = {
	fill_buckets = fill_buckets,
	each_cost = each_cost,
	is_listed = function(sec)
		return sec and STRIP[sec] == true
	end,
	is_ignored = function(sec)
		return sec and IGNORE[sec] == true
	end,
	kind_of = function(sec)
		return sec and KIND[sec]
	end,
}
