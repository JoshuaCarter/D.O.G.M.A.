-- game/death_report conf
-- panel_width: UI-px (1024-wide hud). Default 410 = 40% of screen.
-- panel_top: UI-px from top of screen. Default 270 ≈ previous auto Y.
-- hit_cap: recent hits kept (1-20).

local defaults = {
	["enabled"] = true,
	["panel_width"] = 410,
	["panel_top"] = 270,
	["hit_cap"] = 10,
}

_G.dogma_game_death_report_conf = {
	MOD_ID = "dogma/game/death_report",
	DEFAULTS = defaults,
	loaded = {
		enabled = defaults["enabled"],
		panel_width = defaults["panel_width"],
		panel_top = defaults["panel_top"],
		hit_cap = defaults["hit_cap"],
		debug_log = true,
	},
}
