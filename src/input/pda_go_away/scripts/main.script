--[[
    Don't Re-Equip PDA

    Inventory/loot/trade already auto-lowers the PDA (CPda::Action -> Activate(0)).
    Do not change slot on open: activate_slot(weapon) starts a draw and delays
    the inventory open anim. After close, swap to the last real slot.
]]

local CONFIG = _G.dogma_input_pda_go_away_conf
local xcreature = dogma.xlibs.xcreature
local PDA_SLOT = 8

local MODE_TO_KIND = {
    [1] = "inventory",
    [2] = "trade",
    [4] = "loot",
}


local function log(msg)
    if CONFIG.loaded.debug_log then
        dogma.log.log(CONFIG.MOD_ID, tostring(msg))
    end
end

local function on_option_change()
    local tostr = tostring
    CONFIG.loaded.after_inventory = dogma.mcm.bool(CONFIG.MOD_ID, "after_inventory")
    CONFIG.loaded.after_loot = dogma.mcm.bool(CONFIG.MOD_ID, "after_loot")
    CONFIG.loaded.after_trade = dogma.mcm.bool(CONFIG.MOD_ID, "after_trade")
    CONFIG.loaded.after_teleport = dogma.mcm.bool(CONFIG.MOD_ID, "after_teleport")
    CONFIG.loaded.debug_log = dogma.log.logging()
    log(string.format(
        "config: inventory=%s loot=%s trade=%s teleport=%s debug=%s",
        tostr(CONFIG.loaded.after_inventory), tostr(CONFIG.loaded.after_loot),
        tostr(CONFIG.loaded.after_trade), tostr(CONFIG.loaded.after_teleport),
        tostr(CONFIG.loaded.debug_log)
    ))
end

-- last_non_pda_slot: last real equip (guns, knife, binoc).
-- slot_before_pda: captured on pull-out. Survives engine auto-lower 8 -> 0.
-- pending_restore: this UI session started from PDA; restore only after close.
local last_non_pda_slot = 0
local slot_before_pda = nil
local pending_restore = false
local last_seen_slot = nil

local function slot_has_item(slot)
    return slot and db.actor and db.actor:item_in_slot(slot) ~= nil
end

local function restore_slot_after_pda()
    if slot_before_pda and slot_has_item(slot_before_pda) then
        return slot_before_pda
    end
    if last_non_pda_slot ~= 0 and slot_has_item(last_non_pda_slot) then
        return last_non_pda_slot
    end
    for _, s in ipairs({ 1, 2, 3, 4 }) do
        if slot_has_item(s) then
            return s
        end
    end
    return 0
end

local function kind_enabled(kind)
    return kind and CONFIG.loaded["after_" .. kind]
end

local function activate_restore(target, site)
    if not db.actor or not target or target == 0 then
        return
    end
    log(string.format(
        "restore(%s): active_slot=%s -> activate_slot(%s) (slot_before_pda=%s, last_non_pda_slot=%s)",
        site, tostring(db.actor:active_slot()), target, tostring(slot_before_pda), tostring(last_non_pda_slot)
    ))
    db.actor:activate_slot(target)
    slot_before_pda = nil
end

-- Open: remember only. Engine already started PDA hide. Do not activate_slot.
local function mark_pending_if_pda(kind, site)
    local tostr = tostring
    if not db.actor then
        return
    end
    if not kind_enabled(kind) then
        return
    end
    local slot = db.actor:active_slot()
    if slot ~= PDA_SLOT and last_seen_slot ~= PDA_SLOT and not slot_before_pda then
        log(string.format("mark_pending(%s) from %s: skipped, PDA not involved (slot=%s)", kind, site, tostr(slot)))
        return
    end
    pending_restore = true
    log(string.format(
        "mark_pending(%s) from %s: slot=%s last_seen=%s slot_before_pda=%s",
        kind, site, tostr(slot), tostr(last_seen_slot), tostr(slot_before_pda)
    ))
end

local function restore_after_ui(kind, site)
    if not db.actor then
        return
    end
    if not kind_enabled(kind) then
        return
    end
    if not pending_restore then
        log(string.format("restore_after_ui(%s) from %s: skipped, no pending", kind, site))
        return
    end
    pending_restore = false
    activate_restore(restore_slot_after_pda(), site)
end

local function reset_restore_state()
    pending_restore = false
    slot_before_pda = nil
    last_seen_slot = nil
end

local TELEPORT_DIST_SQR = 12 * 12
local last_actor_pos = nil

local function on_actor_menu_mode_changed(mode, last_mode)
    log(string.format("ActorMenu_on_mode_changed: mode=%s last_mode=%s", tostring(mode), tostring(last_mode)))

    if mode ~= 0 and last_mode == 0 then
        local kind = MODE_TO_KIND[mode]
        if kind then
            mark_pending_if_pda(kind, "mode_changed(open)")
        end
        return
    end

    if mode == 0 then
        local kind = MODE_TO_KIND[last_mode]
        if kind then
            restore_after_ui(kind, "mode_changed(close)")
        end
    end
end

local function on_actor_menu_before_init_mode(mode_str)
    log("ActorMenu_on_before_init_mode: " .. tostring(mode_str))
    if mode_str == "inventory" or mode_str == "loot" or mode_str == "trade" then
        mark_pending_if_pda(mode_str, "before_init_mode")
    end
end

local patched = false
local orig_actor_menu = {}

local function patch_actor_menu()
    if patched or not actor_menu then
        return
    end
    patched = true

    orig_actor_menu.inventory_wnd_closed = actor_menu.inventory_wnd_closed
    orig_actor_menu.dead_body_search_wnd_closed = actor_menu.dead_body_search_wnd_closed
    orig_actor_menu.trade_wnd_closed = actor_menu.trade_wnd_closed

    function actor_menu.inventory_wnd_closed()
        log("actor_menu.inventory_wnd_closed fired")
        if orig_actor_menu.inventory_wnd_closed then
            orig_actor_menu.inventory_wnd_closed()
        end
        restore_after_ui("inventory", "wnd_closed")
    end

    function actor_menu.dead_body_search_wnd_closed()
        log("actor_menu.dead_body_search_wnd_closed fired")
        if orig_actor_menu.dead_body_search_wnd_closed then
            orig_actor_menu.dead_body_search_wnd_closed()
        end
        restore_after_ui("loot", "wnd_closed")
    end

    function actor_menu.trade_wnd_closed()
        log("actor_menu.trade_wnd_closed fired")
        if orig_actor_menu.trade_wnd_closed then
            orig_actor_menu.trade_wnd_closed()
        end
        restore_after_ui("trade", "wnd_closed")
    end
end

-- Always printf (not debug-gated): catches empty character community before
-- PDA ranking/contacts can fatal on CCharacterInfo::GetById(null).
-- Uses SE/xcreature only. Game-object character_community() can itself assert.
local try_scan_stalkers_before_pda = function(se)
    return se:community()
end

local try_scan_stalkers_before_pda_2 = function(IsStalker, npc)
    return IsStalker and IsStalker(npc)
end

local function scan_stalkers_before_pda()
    local tostr = tostring
    if not (db and db.storage and db.actor) then
        return
    end
    dogma.perf.start("pda_go_away", "scan_stalkers")
    local actor_id = db.actor:id()
    local total = 0
    local bad = 0
    for id, st in pairs(db.storage) do
        local npc = st and st.object
        if npc and id ~= actor_id then
            local ok_st, is_st = pcall(try_scan_stalkers_before_pda_2, IsStalker, npc)
            if ok_st and is_st then
                total = total + 1
                local name, sec = "?", "?"
                pcall(function()
                    name = npc:name() or "?"
                    sec = npc:section() or "?"
                end)
                local se = alife_object(id)
                local comm = nil
                if se and xcreature and xcreature.community then
                    local ok_c, c = pcall(xcreature.community, se)
                    if ok_c then
                        comm = c
                    end
                elseif se and se.community then
                    local ok_c, c = pcall(try_scan_stalkers_before_pda, se)
                    if ok_c then
                        comm = c
                    end
                end
                local empty = (type(comm) ~= "string") or (comm == "") or (comm == "none")
                if empty then
                    bad = bad + 1
                    printf(
                        "[dogma_input_pda_go_away] BAD STALKER id=%s name=%s sec=%s community=%s se=%s",
                        tostr(id),
                        tostr(name),
                        tostr(sec),
                        tostr(comm),
                        tostr(se ~= nil)
                    )
                end
            end
        end
    end
    printf(
        "[dogma_input_pda_go_away] pre-PDA stalker scan: total=%s bad_community=%s",
        tostr(total),
        tostr(bad)
    )
    dogma.perf.stop()
end

-- Tick-accurate restore-slot tracking. 8 -> 0 (engine auto-lower) keeps
-- slot_before_pda. 8 -> real slot (player switched) clears it.
local function log_active_slot_transitions()
    local tostr = tostring
    local slot = db.actor:active_slot()
    if slot == last_seen_slot then
        return
    end

    if slot == PDA_SLOT then
        if last_seen_slot and last_seen_slot ~= PDA_SLOT and last_seen_slot ~= 0 and slot_has_item(last_seen_slot) then
            slot_before_pda = last_seen_slot
        elseif last_non_pda_slot ~= 0 and slot_has_item(last_non_pda_slot) then
            slot_before_pda = last_non_pda_slot
        end
        scan_stalkers_before_pda()
    elseif last_seen_slot == PDA_SLOT and slot ~= 0 then
        slot_before_pda = nil
    end

    log(string.format(
        "active_slot changed: %s -> %s (tick=%s, actor_menu.last_mode=%s, slot_before_pda=%s, last_non_pda_slot=%s)",
        tostr(last_seen_slot), tostr(slot), tostr(time_global()),
        tostr(actor_menu and actor_menu.last_mode), tostr(slot_before_pda), tostr(last_non_pda_slot)
    ))
    last_seen_slot = slot

    if slot and slot ~= PDA_SLOT then
        if slot ~= 0 then
            last_non_pda_slot = slot
        else
            local active = db.actor:active_item()
            if active then
                local active_id = active:id()
                for s = 1, 7 do
                    if s ~= PDA_SLOT then
                        local item = db.actor:item_in_slot(s)
                        if item and item:id() == active_id then
                            last_non_pda_slot = s
                            break
                        end
                    end
                end
            end
        end
    end
end

local function on_actor_on_update()
    if not dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change) or not db.actor then
        return
    end

    patch_actor_menu()
    log_active_slot_transitions()

    -- teleport position jump: holster PDA when actor teleports
    if CONFIG.loaded.after_teleport then
        local pos = db.actor:position()
        if last_actor_pos then
            local dx = pos.x - last_actor_pos.x
            local dy = pos.y - last_actor_pos.y
            local dz = pos.z - last_actor_pos.z
            if (dx * dx + dy * dy + dz * dz) >= TELEPORT_DIST_SQR then
                local slot = db.actor:active_slot()
                local target = restore_slot_after_pda()
                local holstered = false

                if slot == PDA_SLOT then
                    log(string.format(
                        "holster_pda_on_teleport(position_jump): active_slot=%s -> activate_slot(%s) (slot_before_pda=%s, last_non_pda_slot=%s)",
                        slot, target, tostring(slot_before_pda), tostring(last_non_pda_slot)
                    ))
                    db.actor:activate_slot(target)
                    holstered = true
                elseif slot == 0 and target ~= 0 and (slot_before_pda or pending_restore or last_seen_slot == PDA_SLOT) then
                    log(string.format(
                        "holster_pda_on_teleport(position_jump): preempt active_slot=0 -> activate_slot(%s) (pending PDA restore)",
                        target
                    ))
                    db.actor:activate_slot(target)
                    holstered = true
                else
                    log(string.format("holster_pda_on_teleport(position_jump): active_slot=%s, nothing to holster", tostring(slot)))
                end

                if holstered then
                    slot_before_pda = nil
                    pending_restore = false
                    last_actor_pos = db.actor:position()
                end
            end
        end
        last_actor_pos = pos
    end
end

function on_game_start()
    dogma.load(CONFIG.MOD_ID)

    -- Not gated by CONFIG.loaded.debug_log: at this point MCM options haven't been
    -- read yet (that happens later via on_option_change), so the gate would
    -- always be closed here regardless of the user's actual setting.
    dogma.log.log(CONFIG.MOD_ID, "on_game_start: mod loaded")

    on_option_change()

    patch_actor_menu()

    RegisterScriptCallback("ActorMenu_on_before_init_mode", on_actor_menu_before_init_mode)
    RegisterScriptCallback("ActorMenu_on_mode_changed", on_actor_menu_mode_changed)
    RegisterScriptCallback("on_option_change", on_option_change)
    RegisterScriptCallback("actor_on_update", on_actor_on_update)
    RegisterScriptCallback("on_game_load", reset_restore_state)
end
