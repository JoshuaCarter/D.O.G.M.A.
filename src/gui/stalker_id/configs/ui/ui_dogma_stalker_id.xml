		<texture>ui_mm_faction_killer_inactive</texture>
	</patch_dead_killer>
	<patch_dead_monolith x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_monolith_inactive</texture>
	</patch_dead_monolith>
	<patch_dead_greh x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_greh_inactive</texture>
	</patch_dead_greh>
	<patch_dead_renegade x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_renegade_inactive</texture>
	</patch_dead_renegade>
	<patch_dead_isg x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_isg_inactive</texture>
	</patch_dead_isg>

	<!-- centered text lines (full width; Y set in script) -->
	<name x="0" y="20" width="1024" height="24" stretch="1">
		<text x="0" y="0" align="c" complex_mode="0" font="letterica18" r="255" g="255" b="255" a="255"></text>
	</name>
	<rank x="0" y="32" width="1024" height="24" stretch="1">
		<text x="0" y="0" align="c" complex_mode="0" font="letterica16" r="200" g="200" b="200" a="255"></text>
	</rank>
	<zombified x="0" y="60" width="1024" height="24" stretch="1">
		<text x="0" y="0" align="c" complex_mode="0" font="letterica16" r="255" g="255" b="255" a="255"></text>
	</zombified>

</stalker_id>
