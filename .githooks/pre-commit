#!/usr/bin/env bash
# pre-commit: snapshot appdata config + ALAO on src/ script changes.
# Install: bash .githooks/install.sh
# Skip appdata: DOGMA_NO_APPDATA_SYNC=1 git commit …
# Skip ALAO:     DOGMA_NO_ALAO=1 git commit …
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
case "$HOOK_DIR" in
	*/.git/hooks) ROOT="$(cd "$HOOK_DIR/../.." && pwd)" ;;
	*) ROOT="$(cd "$HOOK_DIR/.." && pwd)" ;;
esac

# shellcheck source=sync-appdata.sh
source "$HOOK_DIR/sync-appdata.sh"
if sync_appdata "$ROOT"; then
	if ! git -C "$ROOT" diff --cached --quiet -- appdata/; then
		echo "pre-commit: staged appdata/user.ltx + appdata/axr_options.ltx"
	fi
fi

if [[ -n "${DOGMA_NO_ALAO:-}" ]]; then
	exit 0
fi

# Only when committing script changes under src/
if ! git -C "$ROOT" diff --cached --name-only --diff-filter=ACM | grep -qE '^src/.*\.(script|lua)$'; then
	exit 0
fi

py=()
if command -v py >/dev/null 2>&1; then
	py=(py -3)
elif command -v python3 >/dev/null 2>&1; then
	py=(python3)
elif command -v python >/dev/null 2>&1; then
	py=(python)
else
	echo "pre-commit: Python 3 required for ALAO" >&2
	exit 1
fi

echo "pre-commit: ALAO on src/…"
"${py[@]}" "$ROOT/dev/alao_local.py"

# Re-stage tracked scripts ALAO rewrote so the commit includes optimizations.
changed=()
while IFS= read -r -d '' f; do
	changed+=("$f")
done < <(git -C "$ROOT" diff -z --name-only -- 'src/**/*.script' 'src/**/*.lua' 2>/dev/null || true)

if ((${#changed[@]} > 0)); then
	git -C "$ROOT" add -- "${changed[@]}"
	echo "pre-commit: re-staged ${#changed[@]} script(s) after ALAO"
fi

exit 0
