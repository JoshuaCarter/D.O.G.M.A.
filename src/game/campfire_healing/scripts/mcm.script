-- game/campfire_healing conf
-- Lit campfire within range_m (0-5, def 5): convert existing limb temp to perm, heal body and psy.
-- body_pct / psy_pct: % per second (0-1, def 1, step 0.1). 0 = off.
-- limb_sec: seconds for a 20% step (10-100, def 10).
-- pause_in_combat: optional; default off (heal even if something still has you as best_enemy).
-- fx_enable / fx_intensity: orange PPE while body, psy, or limb temp is healing.

_G.dogma_game_campfire_healing_conf = {
	MOD_ID = "dogma/game/campfire_healing",
	DEFAULTS = {
		enabled = true,
		range_m = 5,
		body_pct = 1,
		psy_pct = 1,
		limb_sec = 10,
		pause_in_combat = false,
		fx_enable = true,
		fx_intensity = 0.1,
	},
	PPE = {
		name = "dogma_campfire_heal.ppe",
		id = 2041,
	},
}

function on_mcm_load(options)
	local CONFIG = _G.dogma_game_campfire_healing_conf
	dogma_mcm.attach(options, "game", "ui_mcm_menu_dogma_game", {
		id = "campfire_healing",
		sh = true,
		text = "ui_mcm_menu_dogma_game_campfire_healing",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_game_campfire_healing_page_description",
			},
			{
				id = "enabled",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.enabled,
				hint = "dogma_game_campfire_healing_enabled",
			},
			{
				id = "range_m",
				type = "track",
				val = 2,
				min = 0,
				max = 5,
				step = 0.1,
				def = CONFIG.DEFAULTS.range_m,
				hint = "dogma_game_campfire_healing_range_m",
			},
			{
				id = "pause_in_combat",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.pause_in_combat,
				hint = "dogma_game_campfire_healing_pause_in_combat",
			},
			{
				id = "body_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 1,
				step = 0.1,
				def = CONFIG.DEFAULTS.body_pct,
				hint = "dogma_game_campfire_healing_body_pct",
			},
			{
				id = "psy_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 1,
				step = 0.1,
				def = CONFIG.DEFAULTS.psy_pct,
				hint = "dogma_game_campfire_healing_psy_pct",
			},
			{
				id = "limb_sec",
				type = "track",
				val = 2,
				min = 10,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS.limb_sec,
				hint = "dogma_game_campfire_healing_limb_sec",
			},
			{
				id = "fx_enable",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.fx_enable,
				hint = "dogma_game_campfire_healing_fx_enable",
			},
			{
				id = "fx_intensity",
				type = "track",
				val = 2,
				min = 0,
				max = 0.2,
				step = 0.01,
				def = CONFIG.DEFAULTS.fx_intensity,
				hint = "dogma_game_campfire_healing_fx_intensity",
			},
		}),
	})
end
