--[[
	DOGMA in-game console output (namespace module, no globals).

	Private impl; features use dogma.console (wired by dogma.script).

	say(msg, color) - print to the ~ console via engine log(). Not gated by
	debug MCM; not dogma.dbg.log. Also lands in xray_*.log (same engine buffer).

	Color is a name mapped to X-Ray console marks (single leading char), not
	HUD %c[255,R,G,B] codes. Unknown names → default white.
]]

-- XR_IOConsole Console_mark → approximate color (xray-monolith)
local MARKS = {
	white        = "",
	light_gray   = "*",
	gray         = "*",
	dark_gray    = "*",
	black        = "*",
	light_red    = "!",
	red          = "!",
	dark_red     = "!",
	light_green  = "+",
	green        = "+",
	dark_green   = "^",
	lime         = "-",
	light_blue   = "@",
	blue         = "@",
	dark_blue    = "/",
	light_yellow = "~",
	yellow       = "~",
	dark_yellow  = "&",
	light_cyan   = "#",
	cyan         = "#",
	dark_cyan    = "#",
	light_orange = "=",
	orange       = "=",
	dark_orange  = "=",
	light_purple = "$",
	purple       = "$",
	dark_purple  = "%",
	light_pink   = "$",
	pink         = "$",
	dark_pink    = "%",
	magenta      = "$",
	teal         = "+",
	brown        = "=",
}

function say(msg, color)
	if not log then
		return
	end
	local mark = MARKS[color] or ""
	log(mark .. tostring(msg))
end
