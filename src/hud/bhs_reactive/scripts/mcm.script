function on_mcm_load(options)
	local CONFIG = _G.dogma_hud_bhs_reactive_conf
	local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
	local mod_content = {
		{ 0, "mcm_kb_mod_none" },
		{ 1, "mcm_kb_mod_shift" },
		{ 2, "mcm_kb_mod_ctrl" },
		{ 3, "mcm_kb_mod_alt" },
	}

	dogma_mcm.attach(options, "hud", "ui_mcm_menu_dogma_hud", {
		id = "bhs_reactive",
		sh = true,
		text = "ui_mcm_menu_dogma_hud_bhs_reactive",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_hud_bhs_reactive_page_description",
			},
			{
				id = "hide_bhs",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["hide_bhs"],
				hint = "dogma_hud_bhs_reactive_hide_bhs",
			},
			{
				id = "key_bhs",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["key_bhs"],
				hint = "dogma_hud_bhs_reactive_key_bhs",
			},
			{
				id = "key_bhs_modifier",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS["key_bhs_modifier"],
				hint = "mcm_kb_modifier",
				content = mod_content,
			},
			{
				id = "show_on_damage",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["show_on_damage"],
				hint = "dogma_hud_bhs_reactive_show_on_damage",
			},
			{
				id = "sec",
				type = "track",
				val = 2,
				min = 0,
				max = 60,
				step = 1,
				def = CONFIG.DEFAULTS["sec"],
				hint = "dogma_hud_bhs_reactive_sec",
			},
			{
				id = "full_heal_clamp_sec",
				type = "track",
				val = 2,
				min = 0,
				max = 60,
				step = 1,
				def = CONFIG.DEFAULTS["full_heal_clamp_sec"],
				hint = "dogma_hud_bhs_reactive_full_heal_clamp_sec",
			},
			{ id = "section_icons", type = "line" },
			{
				id = "hide_status_icons",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["hide_status_icons"],
				hint = "dogma_hud_bhs_reactive_hide_status_icons",
			},
			{
				id = "key_icons",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["key_icons"],
				hint = "dogma_hud_bhs_reactive_key_icons",
			},
			{
				id = "key_icons_modifier",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS["key_icons_modifier"],
				hint = "mcm_kb_modifier",
				content = mod_content,
			},
			{
				id = "icons_radiation",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["icons_radiation"],
				hint = "dogma_hud_bhs_reactive_icons_radiation",
			},
			{
				id = "icons_bleed",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["icons_bleed"],
				hint = "dogma_hud_bhs_reactive_icons_bleed",
			},
			{
				id = "icons_hunger",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["icons_hunger"],
				hint = "dogma_hud_bhs_reactive_icons_hunger",
			},
			{
				id = "icons_thirst",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["icons_thirst"],
				hint = "dogma_hud_bhs_reactive_icons_thirst",
			},
			{
				id = "icons_sleep",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["icons_sleep"],
				hint = "dogma_hud_bhs_reactive_icons_sleep",
			},
			{
				id = "grey_hide_after_sec",
				type = "track",
				val = 2,
				min = 0,
				max = 10,
				step = 1,
				def = CONFIG.DEFAULTS["grey_hide_after_sec"],
				hint = "dogma_hud_bhs_reactive_grey_hide_after_sec",
			},
		}),
	})
end
