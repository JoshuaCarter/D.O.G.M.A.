--[[
	Persist Melancholy Weather

	Melancholy already writes category/preset into the save. On spawn, reset()
	may roll a new preset, and load_state applies the saved one with
	set_weather(..., false) which waits for the next hour boundary.

	Named failure: save in rain, load under a different sky until the clock ticks.
	Call path: actor_binder:reset → load_state → apply_loaded_state → reconcile.

	Solid: force-apply the saved preset after load/reset.
	Lerp: force previous preset, smooth to current, restore weight.
]]

local CONFIG = _G.dogma_tweaks_persist_melancholy_weather_conf
local PAGE = CONFIG.MCM_PAGE
local DEFS = CONFIG.DEFAULTS

local HOOK_STATE = _G.__dogma_tweaks_persist_melancholy_weather_hooks or {}
_G.__dogma_tweaks_persist_melancholy_weather_hooks = HOOK_STATE

local function log(fmt, ...)
	local msg = string.format(fmt, ...)
	if dogma and dogma.dbg then
		dogma.dbg.log(CONFIG.MOD_ID, msg)
	else
		printf("[dogma_tweaks_persist_melancholy_weather] %s", msg)
	end
end

local function persist_on()
	return dogma.mcm.bool(PAGE, "persist_melancholy_weather", DEFS.persist_melancholy_weather)
		or dogma.mcm.bool(PAGE, "persist_melancholy_weather_lerp", DEFS.persist_melancholy_weather_lerp)
end

local function lerp_on()
	return dogma.mcm.bool(PAGE, "persist_melancholy_weather_lerp", DEFS.persist_melancholy_weather_lerp)
end

local function current_preset(self)
	return self.weather_file or self.preset or self.natural_preset
end

local function outdoor(self)
	return self.is_outdoor_weather and self:is_outdoor_weather()
end

local function wfx(self)
	if self.wfx_active then
		return self:wfx_active()
	end
	return level.is_wfx_playing and level.is_wfx_playing()
end

local function weather_paused()
	return weather and weather.is_paused and weather.is_paused()
end

local function apply_force(preset)
	if not preset or weather_paused() then
		return false
	end
	level.set_weather(preset, true)
	return true
end

local function apply_lerp(last, current, weight)
	if not (last and current and last ~= current and type(weight) == "number") then
		return apply_force(current)
	end
	if weather_paused() then
		return false
	end
	level.set_weather(last, true)
	if level.set_weather_smooth then
		level.set_weather_smooth(current)
	else
		level.set_weather(current, false)
	end
	if level.set_weather_weight then
		local w = weight
		if w < 0 then
			w = 0
		elseif w > 1 then
			w = 1
		end
		level.set_weather_weight(w)
	end
	return true
end

local function restore(self, reason)
	local tostr = tostring
	if not persist_on() or not outdoor(self) or wfx(self) then
		return
	end
	local current = current_preset(self)
	if not current then
		return
	end

	local ok
	if lerp_on() then
		ok = apply_lerp(self._dogma_last_weather_file, current, self._dogma_weather_weight)
	else
		ok = apply_force(current)
	end
	if not ok then
		return
	end
	log(
		"restore %s preset=%s last=%s weight=%s lerp=%s",
		tostr(reason),
		tostr(current),
		tostr(self._dogma_last_weather_file),
		tostr(self._dogma_weather_weight),
		tostr(lerp_on())
	)
	if reason == "load" and dogma.console and dogma.console.say then
		dogma.console.say("Melancholy weather restored: " .. tostr(current), "blue")
	end
end

local function snapshot_weight(self)
	if not (self and level.get_weather_weight) then
		return
	end
	self._dogma_weather_weight = level.get_weather_weight()
end

local function remember_last(self, preset)
	local prev = self.weather_file
	if (not prev or prev == "") and level.get_weather then
		prev = level.get_weather()
	end
	if prev and prev ~= "" and prev ~= preset then
		self._dogma_last_weather_file = prev
	end
end

local function patch()
	if HOOK_STATE.patched then
		return true
	end
	local WM = level_weathers and level_weathers.WeatherManager
	if not (WM and WM.reset and WM.load_state and WM.save_state and WM.apply_weather) then
		return false
	end

	local orig_apply = WM.apply_weather
	local orig_save = WM.save_state
	local orig_load = WM.load_state
	local orig_reset = WM.reset

	WM.apply_weather = function(self, preset, mode)
		remember_last(self, preset)
		return orig_apply(self, preset, mode)
	end

	WM.save_state = function(self, m_data, ...)
		local ret = orig_save(self, m_data, ...)
		if persist_on() and m_data and m_data.weather_manager then
			snapshot_weight(self)
			m_data.weather_manager.dogma_last_weather_file = self._dogma_last_weather_file
			m_data.weather_manager.dogma_weather_weight = self._dogma_weather_weight
		end
		return ret
	end

	WM.load_state = function(self, m_data, ...)
		local ret = orig_load(self, m_data, ...)
		local data = m_data and m_data.weather_manager
		if data then
			self._dogma_last_weather_file = data.dogma_last_weather_file
			self._dogma_weather_weight = data.dogma_weather_weight
		end
		restore(self, "load")
		return ret
	end

	WM.reset = function(self, ...)
		local ret = orig_reset(self, ...)
		restore(self, "reset")
		return ret
	end

	HOOK_STATE.patched = true
	log("patched WeatherManager reset/load/save/apply")
	return true
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	if not patch() then
		log("Melancholy WeatherManager missing - persist skipped")
		return
	end
	RegisterScriptCallback("on_level_changing", function()
		local mgr = level_weathers.get_weather_manager and level_weathers.get_weather_manager()
		snapshot_weight(mgr)
	end)
end
