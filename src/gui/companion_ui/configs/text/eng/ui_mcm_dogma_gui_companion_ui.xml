<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_gui">
		<text>GUI</text>
	</string>
	<string id="ui_mcm_menu_dogma_gui_companion_ui">
		<text>Companion UI</text>
	</string>
	<string id="ui_mcm_dogma_gui_companion_ui_page_description">
		<text>Stock companion health bars on the right. Off hides the list (Show false). X/Y are offsets from the default HUD position.</text>
	</string>
	<string id="ui_mcm_dogma_gui_companion_ui_enabled">
		<text>Show companion bars</text>
	</string>
	<string id="ui_mcm_dogma_gui_companion_ui_enabled_desc">
		<text>When off, the companion list is hidden. Companions still work.</text>
	</string>
	<string id="ui_mcm_dogma_gui_companion_ui_pos_x">
		<text>X offset</text>
	</string>
	<string id="ui_mcm_dogma_gui_companion_ui_pos_x_desc">
		<text>Horizontal shift from the default companion list position. Negative = left.</text>
	</string>
	<string id="ui_mcm_dogma_gui_companion_ui_pos_y">
		<text>Y offset</text>
	</string>
	<string id="ui_mcm_dogma_gui_companion_ui_pos_y_desc">
		<text>Vertical shift from the default companion list position. Negative = up.</text>
	</string>
</string_table>
