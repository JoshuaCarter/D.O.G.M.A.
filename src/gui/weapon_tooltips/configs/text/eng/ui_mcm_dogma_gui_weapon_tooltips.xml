		<text>Ammo row ordering</text>
	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_ammo_order_desc">
		<text>Order for ammunitions in the damage table, Dmg vs Stalkers stat, and Dmg vs Mutants stat.</text>
	</string>
	<string id="dogma_gui_weapon_tooltips_ammo_order_lst_default">
		<text>Match default ammo order</text>
	</string>
