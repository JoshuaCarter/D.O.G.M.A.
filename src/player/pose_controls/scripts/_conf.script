-- player/pose_controls conf
-- crouch/prone/sprint + hold_toggle are mirrored from Options→Controls via MCM curr/functor.
-- walk_key stays MCM-only (-1 = unbound).

local defaults = {
	["walk_key"] = -1,
}

_G.dogma_player_pose_controls_conf = {
	MOD_ID = "dogma/player/pose_controls",
	DEFAULTS = defaults,
	loaded = {
		enabled = true,
		walk_key = defaults["walk_key"],
		crouch_key = nil,
		prone_key = nil,
		sprint_key = nil,
		-- true = toggle, false = hold (after sync)
		toggle_mode = false,
		debug_log = true,
		debug_overlay = false,
	},
}
