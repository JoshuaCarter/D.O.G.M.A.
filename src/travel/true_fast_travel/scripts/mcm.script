function on_mcm_load(options)
	local CONFIG = _G.dogma_travel_true_fast_travel_conf
	dogma_mcm.attach(options, "travel", "ui_mcm_menu_dogma_travel", {
		id = "true_fast_travel",
		sh = true,
		text = "ui_mcm_menu_dogma_travel_true_fast_travel",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_true_fast_travel_page_description",
			},
			{
				id = "fly_camera",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["fly_camera"],
				hint = "dogma_true_fast_travel_fly_camera",
			},
			{
				id = "fly_speed_mult_normal",
				type = "track",
				val = 2,
				min = 1,
				max = 12,
				step = 0.5,
				def = CONFIG.DEFAULTS["fly_speed_mult_normal"],
				hint = "dogma_true_fast_travel_fly_speed_mult_normal",
			},
			{
				id = "fly_speed_mult_sneak",
				type = "track",
				val = 2,
				min = 1,
				max = 8,
				step = 0.5,
				def = CONFIG.DEFAULTS["fly_speed_mult_sneak"],
				hint = "dogma_true_fast_travel_fly_speed_mult_sneak",
			},
			{
				id = "fade_travel",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["fade_travel"],
				hint = "dogma_true_fast_travel_fade_travel",
			},
			{
				id = "path_preview",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["path_preview"],
				hint = "dogma_true_fast_travel_path_preview",
			},
			{
				id = "message_duration",
				type = "track",
				val = 2,
				min = 3,
				max = 60,
				step = 1,
				def = CONFIG.DEFAULTS["message_duration"],
				hint = "dogma_true_fast_travel_message_duration",
			},
			{
				id = "block_transition_in_combat",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["block_transition_in_combat"],
				hint = "dogma_true_fast_travel_block_transition_in_combat",
			},
			{
				id = "show_ambush_range",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["show_ambush_range"],
				hint = "dogma_true_fast_travel_show_ambush_range",
			},
			{
				id = "companion_teleport_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["companion_teleport_key"],
				hint = "dogma_true_fast_travel_companion_teleport_key",
			},
		}),
	})
end
