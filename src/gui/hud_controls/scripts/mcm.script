-- gui/hud_controls conf
-- Hide BHS, status icons, minimap, and companion bars by default.
-- Hold key or reactive conditions unpark them.

_G.dogma_gui_hud_controls_conf = {
	MOD_ID = "dogma/gui/hud_controls",
	DEFAULTS = {
		enabled = true,
		hide_body = true,
		key_bhs = -1,
		key_bhs_modifier = 0,
		always_show = true,
		hp_show_below_pct = 99,
		limb_show_below_pct = 100,
		psy_show_below_pct = 99,
		rad_show_above_pct = 1,
		show_when_temp_health = true,
		keep_showing_sec = 5,
		stam_show_below_pct = 99,
		hide_status_icons = true,
		key_icons = -1,
		key_icons_modifier = 0,
		icons_radiation = true,
		icons_bleed = true,
		icons_hunger = true,
		icons_thirst = true,
		icons_sleep = true,
		grey_hide_after_sec = 5,
		thirst_blur_yellow = true,
		hide_minimap = true,
		minimap_key = -1,
		minimap_modifier = 0,
		hide_companion = true,
		companion_key = -1,
		companion_modifier = 0,
		companion_always_show = true,
		companion_hp_show_below_pct = 99,
		companion_show_in_combat = true,
		companion_keep_showing_sec = 5,
	},
	loaded = {},
}

function on_mcm_load(options)
	local CONFIG = _G.dogma_gui_hud_controls_conf
	local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
	local mod_content = {
		{ 0, "mcm_kb_mod_none" },
		{ 1, "mcm_kb_mod_shift" },
		{ 2, "mcm_kb_mod_ctrl" },
		{ 3, "mcm_kb_mod_alt" },
	}
	local function h(id)
		return "dogma_gui_hud_controls_" .. id
	end

	dogma_mcm.attach(options, "gui", "ui_mcm_menu_dogma_gui", {
		id = "hud_controls",
		sh = true,
		text = "ui_mcm_menu_dogma_gui_hud_controls",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_gui_hud_controls_page_description",
			},
			{
				id = "enabled",
				type = "check",
				val = 1,
				def = true,
				hint = "dogma_gui_hud_controls_enabled",
			},
			{
				id = "hdr_bhs",
				type = "desc",
				text = "ui_mcm_dogma_gui_hud_controls_bhs_section",
			},
			{
				id = "hide_body",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.hide_body,
				hint = h("hide_body"),
			},
			{
				id = "key_bhs",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS.key_bhs,
				hint = h("key_bhs"),
			},
			{
				id = "key_bhs_modifier",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS.key_bhs_modifier,
				hint = "mcm_kb_modifier",
				content = mod_content,
			},
			{ id = "section_always", type = "line" },
			{
				id = "always_show",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.always_show,
				hint = h("always_show"),
			},
			{
				id = "hp_show_below_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS.hp_show_below_pct,
				hint = h("hp_show_below_pct"),
			},
			{
				id = "limb_show_below_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 25,
				def = CONFIG.DEFAULTS.limb_show_below_pct,
				hint = h("limb_show_below_pct"),
			},
			{
				id = "psy_show_below_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS.psy_show_below_pct,
				hint = h("psy_show_below_pct"),
			},
			{
				id = "rad_show_above_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS.rad_show_above_pct,
				hint = h("rad_show_above_pct"),
			},
			{
				id = "show_when_temp_health",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.show_when_temp_health,
				hint = h("show_when_temp_health"),
			},
			{
				id = "keep_showing_sec",
				type = "track",
				val = 2,
				min = 0,
				max = 10,
				step = 1,
				def = CONFIG.DEFAULTS.keep_showing_sec,
				hint = h("keep_showing_sec"),
			},
			{ id = "section_stam", type = "line" },
			{
				id = "stam_show_below_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS.stam_show_below_pct,
				hint = h("stam_show_below_pct"),
			},
			{ id = "section_icons", type = "line" },
			{
				id = "hide_status_icons",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.hide_status_icons,
				hint = h("hide_status_icons"),
			},
			{
				id = "key_icons",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS.key_icons,
				hint = h("key_icons"),
			},
			{
				id = "key_icons_modifier",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS.key_icons_modifier,
				hint = "mcm_kb_modifier",
				content = mod_content,
			},
			{
				id = "icons_radiation",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.icons_radiation,
				hint = h("icons_radiation"),
			},
			{
				id = "icons_bleed",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.icons_bleed,
				hint = h("icons_bleed"),
			},
			{
				id = "icons_hunger",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.icons_hunger,
				hint = h("icons_hunger"),
			},
			{
				id = "icons_thirst",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.icons_thirst,
				hint = h("icons_thirst"),
			},
			{
				id = "icons_sleep",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.icons_sleep,
				hint = h("icons_sleep"),
			},
			{
				id = "grey_hide_after_sec",
				type = "track",
				val = 2,
				min = 0,
				max = 10,
				step = 1,
				def = CONFIG.DEFAULTS.grey_hide_after_sec,
				hint = h("grey_hide_after_sec"),
			},
			{ id = "section_thirst_ppe", type = "line" },
			{
				id = "thirst_blur_yellow",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.thirst_blur_yellow,
				hint = h("thirst_blur_yellow"),
			},
			{ id = "line_minimap", type = "line" },
			{
				id = "hdr_minimap",
				type = "desc",
				text = "ui_mcm_dogma_gui_hud_controls_minimap_section",
			},
			{
				id = "hide_minimap",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.hide_minimap,
				hint = h("hide_minimap"),
			},
			{
				id = "minimap_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS.minimap_key,
				hint = h("minimap_key"),
			},
			{
				id = "minimap_modifier",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS.minimap_modifier,
				hint = "mcm_kb_modifier",
				content = mod_content,
			},
			{ id = "line_companion", type = "line" },
			{
				id = "hdr_companion",
				type = "desc",
				text = "ui_mcm_dogma_gui_hud_controls_companion_section",
			},
			{
				id = "hide_companion",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.hide_companion,
				hint = h("hide_companion"),
			},
			{
				id = "companion_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS.companion_key,
				hint = h("companion_key"),
			},
			{
				id = "companion_modifier",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS.companion_modifier,
				hint = "mcm_kb_modifier",
				content = mod_content,
			},
			{ id = "section_companion_always", type = "line" },
			{
				id = "companion_always_show",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.companion_always_show,
				hint = h("companion_always_show"),
			},
			{
				id = "companion_hp_show_below_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS.companion_hp_show_below_pct,
				hint = h("companion_hp_show_below_pct"),
			},
			{
				id = "companion_show_in_combat",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.companion_show_in_combat,
				hint = h("companion_show_in_combat"),
			},
			{
				id = "companion_keep_showing_sec",
				type = "track",
				val = 2,
				min = 0,
				max = 10,
				step = 1,
				def = CONFIG.DEFAULTS.companion_keep_showing_sec,
				hint = h("companion_keep_showing_sec"),
			},
		}),
	})
end
