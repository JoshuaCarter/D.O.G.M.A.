--[[
    Global Stash: sprint lock + one shared bolt invbox.

    Place / pickup do nothing to the shared id.
    Open a box: park the bolt at that dummy, then swap ui_inventory.start.
    Park only before the UI opens. Mid-UI teleport crashes item moves.
    Map change does not move the bolt. First open on a map brings it to that box.
    CFS: dummy in range -> pin bolt and add it to GetStashesInRange. Offline bolt
    parks at that dummy. Id lives in save_state. Map load never creates.
    Dummy is an invbox so engine Use opens loot and HF hold-Use never fires.
    Mute the dummy. Tap Use opens. Hold Use (or MCM key) picks the furniture up.
    Bolt stays. HF radial on this box is skipped so hold is pickup, not a menu.
]]

local MOD_ID = "dogma/game/global_stash"
local ITEM_SEC = "dogma_global_stash_item"
local PLACEABLE_SEC = "placeable_dogma_global_stash"
local SHARED_SEC = "dogma_game_global_stash"
local PARK_DIST = 0.005
local HOLD_MS = 400
local USE_RANGE = 2
-- Placeable bbox (ltx). Sphere at object origin covers the mesh at any yaw.
local BOX_HX = 0.985824 * 0.5
local BOX_HY = 0.512219 * 0.5
local BOX_HZ = 0.462447 * 0.5
local BOX_OX = -0.000008
local BOX_OY = 0.231224
local BOX_OZ = 0.000513
local BOX_R2 = 0
for ix = -1, 1, 2 do
	for iy = -1, 1, 2 do
		for iz = -1, 1, 2 do
			local x = BOX_OX + ix * BOX_HX
			local y = BOX_OY + iy * BOX_HY
			local z = BOX_OZ + iz * BOX_HZ
			local r2 = x * x + y * y + z * z
			if r2 > BOX_R2 then
				BOX_R2 = r2
			end
		end
	end
end

local xobject = dogma.xlibs.xobject
local xsmart = dogma.xlibs.xsmart
local xdata = dogma.xlibs.xdata
local xinventory = dogma.xlibs.xinventory
local api = {}
_G.dogma_game_global_stash = api

local blocked = false
local planted_level = nil
local saved_id = nil
local stocked = {}
local pending_dummy = nil
local pending_mode = nil
local drain_from = nil
local drain_to = nil
local drain_n = 0
local opening = false
local dummies = {}
local muted = {}
local pending_id = nil
local pending_dik = nil
local picked = false
local orig_ui_start
local orig_get_stashes
local orig_hf_radial

local try_object = function(actor, sec)
    return actor:object(sec)
end

local try_allow_sprint = function(actor, allowed)
    actor:allow_sprint(allowed)
end

local try_pos = function(obj)
    return obj:position()
end

local try_lvid = function(obj)
    return obj:level_vertex_id()
end

local try_gvid = function(obj)
    return obj:game_vertex_id()
end

local try_se_section = function(se)
    return se:section_name()
end

local try_alife_create = function(sec, pos, lvid, gvid)
    return alife_create(sec, pos, lvid, gvid)
end

local try_teleport = function(sim, id, gvid, lvid, pos)
    sim:teleport_object(id, gvid, lvid, pos)
end

local try_online = function(sim, id)
    sim:set_switch_online(id, true)
    sim:set_switch_offline(id, false)
end

local try_cloak = function(box)
    box:set_nonscript_usable(false)
    box:set_tip_text("")
end

local try_transfer = function(from, item, to)
    xinventory.transfer_item(from, item, to)
end

local try_iterate_box = function(box, fn)
    box:iterate_inventory_box(fn, box)
end

local try_m_state = function()
    return alife_storage_manager.get_state()
end

local try_section = function(obj)
    return obj:section()
end

local try_id = function(obj)
    return obj:id()
end

local try_name = function(obj)
    return obj:name()
end

local try_roles = function(npc)
    return xsmart.get_npc_roles(npc)
end

local try_create_item = function(sec, npc)
    return alife_create_item(sec, npc)
end

local try_talking = function(actor)
    return actor:get_talking_npc()
end

local try_distance = function(here, dest)
    return here:distance_to(dest)
end

local try_dist_safe = function(a, b)
    return distance_between_safe(a, b)
end

local try_target = function()
    return level.get_target_obj()
end

local try_target_dist = function()
    return level.get_target_dist()
end

local try_cam = function()
	local d = device()
	return d.cam_pos, d.cam_dir
end

local try_dik_bind = function(dik)
    return dik_to_bind(dik)
end

local try_mute = function(box)
    box:set_nonscript_usable(false)
    box:set_tip_text("st_dogma_global_stash_tip")
end

local try_release_id = function(id)
    xinventory.release_item_id(id)
end

local function log(msg, color)
    dogma.log.log(MOD_ID, tostring(msg), color)
end

local function m_state()
    local ok, state = pcall(try_m_state)
    if ok then
        return state
    end
end

local function set_blocked(want)
    if want == blocked then
        return
    end
    local actor = db.actor
    if not actor then
        if not want then
            blocked = false
        end
        return
    end
    local ok = pcall(try_allow_sprint, actor, not want)
    if not ok then
        log("allow_sprint failed", "red")
        return
    end
    blocked = want
    if want then
        log("sprint blocked (stash in inventory)", "yellow")
    else
        log("sprint restored", "green")
    end
end

local function sync_sprint()
    if not dogma.sys.ready(MOD_ID, db) then
        return
    end
    local ok, obj = pcall(try_object, db.actor, ITEM_SEC)
    set_blocked(ok and obj ~= nil)
end

local function clear_spawn_cache(id)
    if db.offline_objects and db.offline_objects[id] then
        db.offline_objects[id].level_vertex_id = nil
    end
    if db.spawned_vertex_by_id then
        db.spawned_vertex_by_id[id] = nil
    end
end

local function se_is_ours(se)
    if not se then
        return false
    end
    local ok, sec = pcall(try_se_section, se)
    return ok and sec == SHARED_SEC
end

local function se_is_placeable(se)
    if not se then
        return false
    end
    local ok, sec = pcall(try_se_section, se)
    return ok and sec == PLACEABLE_SEC
end

-- WPI zone_keeper Close calls GetStash. String keys (PDA / name) fatal in get_object_by_id.
local function hf_id_is_ours(id)
    if id == SHARED_SEC or id == PLACEABLE_SEC then
        return true
    end
    local nid = tonumber(id)
    if not nid then
        return false
    end
    local se = xobject.se(nid)
    return se_is_ours(se) or se_is_placeable(se)
end

local function remember_id(m_data, id)
    saved_id = id
    if m_data then
        m_data.dogma_game_global_stash = id
    end
end

-- ponytail: O(65534) alife walk. Only when saved id is dead. Drop when orphans are gone.
local function find_existing()
    local found
    local extra = 0
    for i = 1, 65534 do
        if se_is_ours(xobject.se(i)) then
            if found then
                extra = extra + 1
            else
                found = i
            end
        end
    end
    if extra > 0 then
        log("orphan bolts extra=" .. tostring(extra) .. " kept=" .. tostring(found), "yellow")
    end
    return found
end

local function resolve_id()
    local tostr = tostring
    if se_is_ours(xobject.se(saved_id)) then
        return saved_id
    end
    if saved_id then
        log("saved id dead id=" .. tostr(saved_id), "yellow")
    end
    local found = find_existing()
    if found then
        remember_id(m_state(), found)
        log("adopted stash " .. tostr(found), "yellow")
    end
    return found
end

local function dest_of(go)
    local ok_p, pos = pcall(try_pos, go)
    local ok_l, lvid = pcall(try_lvid, go)
    local ok_g, gvid = pcall(try_gvid, go)
    if not (ok_p and pos and ok_l and lvid and ok_g and gvid) then
        return
    end
    return vec_set(pos), lvid, gvid
end

-- Create or teleport the bolt to dest. Pin online. Does not cloak.
local function plant_dest(dest, lvid, gvid)
    local tostr = tostring
    local sim = alife()
    if not (sim and dest and lvid and gvid) then
        log("plant abort: no sim/dest", "red")
        return
    end
    local m_data = m_state()
    if not m_data then
        log("plant abort: no m_data", "red")
        return
    end

    local id = resolve_id()
    local se = id and xobject.se(id)
    if not se_is_ours(se) then
        local ok, created = pcall(try_alife_create, SHARED_SEC, dest, lvid, gvid)
        if not (ok and created) then
            log("plant abort: alife_create failed", "red")
            return
        end
        id = tonumber(created.id) or created.id
        remember_id(m_data, id)
        log("created stash " .. tostr(id), "green")
    else
        remember_id(m_data, id)
        -- TAS rule: never teleport an online box. Mid-UI teleport = item-move crash.
        if xobject.go(id) then
            log("plant skip: online id=" .. tostr(id))
            return id
        end
        local here = se and se.position
        local dist = -1
        if here then
            local ok_d, d = pcall(try_distance, here, dest)
            if ok_d then
                dist = d
            end
        end
        log(string.format("plant existing stash=%s online=false dist=%.3f", tostr(id), dist))
        if not (here and dist <= PARK_DIST) then
            clear_spawn_cache(id)
            local ok_tp = pcall(try_teleport, sim, id, gvid, lvid, dest)
            if not ok_tp then
                log("teleport failed id=" .. tostr(id), "red")
                return
            end
            log("teleported stash " .. tostr(id), "yellow")
        end
    end

	pcall(try_online, sim, id)
	log("planted stash " .. tostr(id) .. " online")
    return id
end

local function plant_at(go)
    if not go then
        log("plant abort: no go", "red")
        return
    end
    local ok, sec = pcall(try_section, go)
    if not (ok and sec == PLACEABLE_SEC) then
        log("plant abort: not our box sec=" .. tostring(sec), "red")
        return
    end
    local dest, lvid, gvid = dest_of(go)
    if not dest then
        log("plant abort: no dest", "red")
        return
    end
    return plant_dest(dest, lvid, gvid)
end

-- Online bolt stays. Alife snaps ~3m off the dummy; moving it every open dumps items.
local function park_at(dummy)
	local id = resolve_id()
	if id and xobject.go(id) then
		remember_id(m_state(), id)
		log("park online id=" .. tostring(id))
		return id
	end
	return plant_at(dummy)
end

local function cloak_id(id)
    local box = id and xobject.go(id)
    if not box then
        if not (id and xobject.se(id)) then
            log("cloak abort: no se id=" .. tostring(id), "red")
            return true
        end
        return false
    end
    local ok = pcall(try_cloak, box)
    if not ok then
        log("cloak failed id=" .. tostring(id), "red")
        return false
    end
    log("cloaked stash " .. tostring(id))
    return true
end

local function drain_one(_, item)
    if not (drain_from and drain_to and item) then
        return
    end
    local ok = pcall(try_transfer, drain_from, item, drain_to)
    if ok then
        drain_n = drain_n + 1
    end
end

local function drain_dummy(dummy, bolt)
    if not (dummy and bolt) then
        return
    end
    local ok_a, a = pcall(try_id, dummy)
    local ok_b, b = pcall(try_id, bolt)
    if not (ok_a and ok_b and a and b and a ~= b) then
        return
    end
    drain_from = dummy
    drain_to = bolt
    drain_n = 0
    pcall(try_iterate_box, dummy, drain_one)
    drain_from = nil
    drain_to = nil
    if drain_n > 0 then
        log("drained dummy " .. tostring(a) .. " items=" .. tostring(drain_n), "yellow")
    end
end

local orig_get_stash
local orig_create_stash
local start_with_bolt

-- Close / craft must not teleport. Online bolt stays put.
local function hooked_get_stash(id)
    if hf_id_is_ours(id) then
        local bolt = resolve_id()
        log("GetStash ours id=" .. tostring(id) .. " bolt=" .. tostring(bolt))
        return bolt
    end
    local nid = tonumber(id)
    if nid and orig_get_stash then
        return orig_get_stash(nid)
    end
    log("GetStash skip string=" .. tostring(id), "yellow")
    return nil
end

-- Place may create once. Never move an existing bolt.
local function hooked_create_stash(id)
    if hf_id_is_ours(id) then
        local bolt = resolve_id()
        if not bolt then
            local nid = tonumber(id)
            local go = nid and xobject.go(nid)
            if go then
                bolt = plant_at(go)
            else
                local actor = db.actor
                if actor then
                    local dest, lvid, gvid = dest_of(actor)
                    if dest then
                        bolt = plant_dest(dest, lvid, gvid)
                    end
                end
            end
        end
        log("CreateStash ours id=" .. tostring(id) .. " bolt=" .. tostring(bolt))
        return bolt and xobject.se(bolt)
    end
    local nid = tonumber(id)
    if nid and orig_create_stash then
        return orig_create_stash(nid)
    end
    log("CreateStash skip string=" .. tostring(id), "yellow")
    return nil
end

local function hook_hf()
    local hf = rawget(_G, "ui_furniture_workshop")
    if not (hf and hf.GetStash and hf.CreateStash) then
        log("hf wrap skip: no workshop script", "red")
        return
    end
    if orig_get_stash then
        return
    end
    orig_get_stash = hf.GetStash
    orig_create_stash = hf.CreateStash
    hf.GetStash = hooked_get_stash
    hf.CreateStash = hooked_create_stash
    _G.GetStash = hooked_get_stash
    _G.CreateStash = hooked_create_stash
    log("hf GetStash wrapped")
end

local function show_bolt(id)
	local bolt = xobject.go(id)
	if not bolt then
		if not xobject.se(id) then
			log("ui start abort: no se id=" .. tostring(id), "red")
			opening = false
			pending_dummy = nil
			pending_mode = nil
			return true
		end
		return false
	end
	cloak_id(id)
	if pending_dummy then
		drain_dummy(pending_dummy, bolt)
		pending_dummy = nil
	end
	opening = false
	if orig_ui_start then
		orig_ui_start(pending_mode or "loot", bolt)
	end
	pending_mode = nil
	log("opened stash " .. tostring(id), "green")
	return true
end

-- Same trick as The Anomalous Stash: swap dummy for the shared box in ui_inventory.start.
-- Park at this dummy first so CFS range matches the box the player is standing at.
start_with_bolt = function(mode, dummy)
	if opening then
		log("ui start skip: already opening")
		return
	end
	if not dummy then
		log("ui start abort: no dummy", "red")
		return
	end
	opening = true
	pending_dummy = dummy
	pending_mode = mode
	local id = park_at(dummy)
	if not id then
		opening = false
		pending_dummy = nil
		pending_mode = nil
		return
	end
	if show_bolt(id) then
		return
	end
	log("ui start: waiting go " .. tostring(id))
	CreateTimeEvent("dogma_game_global_stash", "ui_" .. tostring(id), 0.1, show_bolt, id)
end

function api.open_at(anchor)
	start_with_bolt("loot", anchor)
end

local function hooked_ui_start(mode, obj)
	if obj then
		local ok, sec = pcall(try_section, obj)
		if ok and sec == PLACEABLE_SEC then
			local ok_id, id = pcall(try_id, obj)
			log("ui start dummy id=" .. tostring(ok_id and id))
			start_with_bolt(mode, obj)
			return
		end
	end
	if orig_ui_start then
		orig_ui_start(mode, obj)
	end
end

local function hook_ui()
	if orig_ui_start or not (ui_inventory and ui_inventory.start) then
		log("ui wrap skip", "red")
		return
	end
	orig_ui_start = ui_inventory.start
	ui_inventory.start = hooked_ui_start
	log("ui_inventory.start wrapped")
end

-- CFS ranges the dummy, then iterates the hidden box. Same portal as TAS.
local function dummy_in_range(range)
	if type(range) ~= "number" or not db.actor then
		return
	end
	local best
	local best_d
	for id in pairs(dummies) do
		local obj = xobject.go(id)
		if obj then
			local ok, dist = pcall(try_dist_safe, db.actor, obj)
			if ok and dist and dist <= range then
				if not best_d or dist < best_d then
					best = obj
					best_d = dist
				end
			end
		end
	end
	return best
end

local function list_has_id(list, id)
	if not (list and id) then
		return false
	end
	for i = 1, #list do
		if list[i] == id then
			return true
		end
	end
	return false
end

local function cfs_bolt(range)
	local dummy = dummy_in_range(range)
	if not dummy then
		return
	end
	local id = resolve_id()
	if id and xobject.go(id) then
		local sim = alife()
		if sim then
			pcall(try_online, sim, id)
		end
		return id
	end
	if opening then
		return id
	end
	id = plant_at(dummy)
	if id then
		log("cfs plant bolt=" .. tostring(id) .. " at dummy")
	end
	return id
end

local function hooked_get_stashes(range)
	local stashes
	if orig_get_stashes then
		stashes = orig_get_stashes(range)
	end
	if type(stashes) ~= "table" then
		stashes = {}
	end
	local bolt = cfs_bolt(range)
	if bolt and not list_has_id(stashes, bolt) then
		stashes[#stashes + 1] = bolt
	end
	return stashes
end

local function hook_cfs()
	if orig_get_stashes then
		return true
	end
	if type(_G.GetStashesInRange) ~= "function" then
		log("cfs wrap skip: no GetStashesInRange")
		return true
	end
	orig_get_stashes = _G.GetStashesInRange
	_G.GetStashesInRange = hooked_get_stashes
	log("GetStashesInRange wrapped")
	return true
end

local function hooked_hf_radial(wrapper)
	if wrapper and wrapper.object then
		local ok, sec = pcall(try_section, wrapper.object)
		if ok and sec == PLACEABLE_SEC then
			log("hf radial skip: our box")
			return
		end
	end
	if orig_hf_radial then
		return orig_hf_radial(wrapper)
	end
end

local function hook_hf_radial()
	local pf = rawget(_G, "placeable_furniture")
	if not (pf and pf.open_interact_gui) then
		log("hf radial wrap skip")
		return true
	end
	if orig_hf_radial then
		return true
	end
	orig_hf_radial = pf.open_interact_gui
	pf.open_interact_gui = hooked_hf_radial
	log("hf radial wrapped")
	return true
end

local function hook_late()
	hook_cfs()
	hook_hf_radial()
	return true
end

-- Dummy must not take items if UI swap misses.
local function on_item_before_move(flags, stash_id)
	local nid = tonumber(stash_id)
	if nid and se_is_placeable(xobject.se(nid)) then
		flags.ret_value = false
		log("block put in dummy " .. tostring(nid), "yellow")
	end
end

-- Take-all empty must not destroy dummy furniture or the shared bolt.
local function on_stash_remove(data)
	if not data then
		return
	end
	local se = xobject.se(data.stash_id)
	if se_is_ours(se) or se_is_placeable(se) then
		data.cancel = true
		log("stash remove cancel id=" .. tostring(data.stash_id))
	end
end

local function remember_dummy(id)
	if id then
		dummies[id] = true
	end
end

local function mute_go(id)
	local go = xobject.go(id)
	if not go then
		muted[id] = nil
		return
	end
	local ok = pcall(try_mute, go)
	if not ok then
		muted[id] = nil
		log("mute failed id=" .. tostring(id), "red")
		return
	end
	if not muted[id] then
		log("muted dummy " .. tostring(id))
	end
	muted[id] = true
end

-- Ray vs sphere at dummy origin. get_target_obj misses inv_backpack.
local function ray_hit_t(cam, dir, pos)
	local ox = pos.x - cam.x
	local oy = pos.y - cam.y
	local oz = pos.z - cam.z
	local tca = ox * dir.x + oy * dir.y + oz * dir.z
	local oc2 = ox * ox + oy * oy + oz * oz
	if tca < 0 and oc2 > BOX_R2 then
		return
	end
	local d2 = oc2 - tca * tca
	if d2 > BOX_R2 then
		return
	end
	local thc = math.sqrt(BOX_R2 - d2)
	local t = tca - thc
	if t < 0 then
		t = tca + thc
	end
	if t < 0 then
		return
	end
	return t
end

local function look_dummy()
	local ok_d, dist = pcall(try_target_dist)
	if ok_d and dist and dist <= USE_RANGE then
		local ok, obj = pcall(try_target)
		if ok and obj then
			local ok_s, sec = pcall(try_section, obj)
			if ok_s and sec == PLACEABLE_SEC then
				local ok_id, id = pcall(try_id, obj)
				if ok_id and id then
					remember_dummy(id)
					mute_go(id)
				end
				return obj
			end
		end
	end
	local ok_c, cam, dir = pcall(try_cam)
	if not (ok_c and cam and dir) then
		return
	end
	local best
	local best_t
	for id in pairs(dummies) do
		local obj = xobject.go(id)
		if obj then
			local ok_p, pos = pcall(try_pos, obj)
			if ok_p and pos then
				local t = ray_hit_t(cam, dir, pos)
				if t and t <= USE_RANGE then
					if not best_t or t < best_t then
						best = obj
						best_t = t
					end
				end
			end
		end
	end
	if best then
		local ok_id, id = pcall(try_id, best)
		if ok_id and id then
			mute_go(id)
		end
	end
	return best
end

local function pickup_dummy(obj)
	local tostr = tostring
	if not obj then
		log("pickup abort: no go", "red")
		return
	end
	local ok_id, id = pcall(try_id, obj)
	if not (ok_id and id) then
		log("pickup abort: no id", "red")
		return
	end
	local actor = db.actor
	if not actor then
		log("pickup abort: no actor id=" .. tostr(id), "red")
		return
	end
	if not se_is_placeable(xobject.se(id)) then
		log("pickup abort: not dummy id=" .. tostr(id), "red")
		return
	end
	local ok_item, se = pcall(try_create_item, ITEM_SEC, actor)
	if not (ok_item and se) then
		log("pickup abort: create item failed id=" .. tostr(id), "red")
		return
	end
	local m_data = m_state()
	if m_data and m_data.player_created_stashes then
		m_data.player_created_stashes[id] = nil
	end
	if pending_dummy then
		local ok_p, pid = pcall(try_id, pending_dummy)
		if ok_p and pid == id then
			opening = false
			pending_dummy = nil
			pending_mode = nil
		end
	end
	dummies[id] = nil
	muted[id] = nil
	local ok_rel = pcall(try_release_id, id)
	if not ok_rel then
		log("pickup release failed id=" .. tostr(id), "red")
		return
	end
	log("picked up dummy id=" .. tostr(id) .. " bolt=" .. tostr(resolve_id()), "green")
end

function api.pickup(anchor)
	pickup_dummy(anchor)
end

local function latch_use(dummy, dik)
	local ok, id = pcall(try_id, dummy)
	if not (ok and id) then
		return
	end
	pending_id = id
	pending_dik = dik
	picked = false
	if dik then
		dogma.input.is_key_down(dik)
	end
	log("use press dummy=" .. tostring(id) .. " dik=" .. tostring(dik))
end

local function poll_use()
	if not pending_id then
		return
	end
	local dik = pending_dik
	if not dik then
		log("use abort: no dik id=" .. tostring(pending_id), "yellow")
		pending_id = nil
		pending_dik = nil
		picked = false
		return
	end
	local input = dogma.input
	if input.is_key_down(dik) then
		if not picked and input.is_key_held(dik, HOLD_MS) then
			local obj = xobject.go(pending_id)
			if obj then
				pickup_dummy(obj)
			else
				log("pickup abort: dummy gone id=" .. tostring(pending_id), "yellow")
			end
			picked = true
		end
		return
	end
	if not picked then
		local obj = xobject.go(pending_id)
		if obj then
			api.open_at(obj)
		else
			log("open abort: dummy gone id=" .. tostring(pending_id), "yellow")
		end
	end
	pending_id = nil
	pending_dik = nil
	picked = false
end

local function on_key_press(dik)
	local pk = dogma.mcm.key(MOD_ID, "pickup_key", -1)
	if pk and dik == pk then
		local dummy = look_dummy()
		if dummy then
			pickup_dummy(dummy)
		else
			log("pickup key: no box in range")
		end
		return
	end
	if not key_bindings then
		return
	end
	local ok, bind = pcall(try_dik_bind, dik)
	if not (ok and bind == key_bindings.kUSE) then
		return
	end
	local dummy = look_dummy()
	if dummy then
		latch_use(dummy, dik)
	end
end

local function on_before_use(dik, bind, _dis, flags)
	if not (key_bindings and bind == key_bindings.kUSE) then
		return
	end
	local dummy = look_dummy()
	if dummy then
		flags.ret_value = false
		latch_use(dummy, dik)
	elseif pending_id then
		flags.ret_value = false
	end
end

-- ponytail: O(65534) once per map. Ids only, no bind_object.
local function find_map_dummies()
	for i = 1, 65534 do
		if se_is_placeable(xobject.se(i)) then
			dummies[i] = true
		end
	end
end

local function maybe_bring()
	if not dogma.sys.ready(MOD_ID, db) then
		return
	end
	if not (level and level.name) then
		return
	end
	local name = level.name()
	if name == planted_level then
		return
	end
	planted_level = name
	dummies = {}
	muted = {}
	log("map now " .. tostring(name))
	find_map_dummies()
end

local function on_update()
	maybe_bring()
	for id in pairs(dummies) do
		if not muted[id] then
			mute_go(id)
		end
	end
	poll_use()
end

local function on_save_state(m_data)
    if m_data then
        m_data.dogma_game_global_stash = saved_id
    end
end

local function on_load_state(m_data)
    local id = m_data and m_data.dogma_game_global_stash
    saved_id = id and (tonumber(id) or id) or nil
    log("load_state id=" .. tostring(saved_id))
end

local function on_load()
    blocked = false
    planted_level = nil
    stocked = {}
    dummies = {}
    muted = {}
    pending_id = nil
    pending_dik = nil
    picked = false
    pending_dummy = nil
    pending_mode = nil
    opening = false
    log("load, resync id=" .. tostring(saved_id))
    sync_sprint()
end

local function on_destroy()
    blocked = false
    planted_level = nil
    saved_id = nil
    stocked = {}
    dummies = {}
    muted = {}
    pending_id = nil
    pending_dik = nil
    picked = false
    pending_dummy = nil
    pending_mode = nil
    opening = false
    log("reset (net destroy)")
end

-- HF spawn_items uses IsStalker; script traders die there. Destockifier/xsmart + xdata.traders do not.
local function is_supply_trader(npc)
    local ok, roles = pcall(try_roles, npc)
    if ok and roles and roles.trader and not roles.mechanic and not roles.medic then
        return true
    end
    local ok_sec, sec = pcall(try_section, npc)
    local ok_name, name = pcall(try_name, npc)
    local entry = (ok_sec and sec and xdata.npc_roles[sec]) or (ok_name and name and xdata.npc_roles[name])
    return entry and entry.trader and not entry.mechanic and not entry.medic
end

local function stock_trader(npc, force)
    if not npc then
        return
    end
    local ok_id, id = pcall(try_id, npc)
    if not (ok_id and id) then
        return
    end
    if force == true then
        stocked[id] = nil
    elseif stocked[id] then
        return
    end
    if not is_supply_trader(npc) then
        return
    end
    local ok_has, has = pcall(try_object, npc, ITEM_SEC)
    if ok_has and has then
        stocked[id] = true
        return
    end
    local ok_name, name = pcall(try_name, npc)
    local ok, se = pcall(try_create_item, ITEM_SEC, npc)
    if ok and se then
        stocked[id] = true
        log("stocked " .. tostring(ok_name and name or id))
    else
        log("stock fail " .. tostring(ok_name and name or id), "red")
    end
end

local function stock_talking()
    local actor = db.actor
    if not actor then
        return
    end
    local ok, npc = pcall(try_talking, actor)
    if ok then
        stock_trader(npc, false)
    end
end

local function stock_restock(npc)
    stock_trader(npc, true)
end

function on_game_start()
    dogma.load(MOD_ID)
    hook_hf()
    hook_ui()
    CreateTimeEvent("dogma_game_global_stash", "late", 0.1, hook_late)
    RegisterScriptCallback("actor_on_item_take", sync_sprint)
    RegisterScriptCallback("actor_on_item_drop", sync_sprint)
    RegisterScriptCallback("actor_on_item_take_from_box", sync_sprint)
    RegisterScriptCallback("actor_on_item_put_in_box", sync_sprint)
    RegisterScriptCallback("actor_on_item_use", sync_sprint)
    RegisterScriptCallback("actor_on_trade", sync_sprint)
    RegisterScriptCallback("actor_on_first_update", sync_sprint)
    RegisterScriptCallback("actor_on_update", on_update)
    RegisterScriptCallback("on_game_load", on_load)
    RegisterScriptCallback("actor_on_net_destroy", on_destroy)
    RegisterScriptCallback("hf_on_furniture_place", remember_dummy)
    RegisterScriptCallback("on_key_press", on_key_press)
    RegisterScriptCallback("on_before_key_press", on_before_use)
    RegisterScriptCallback("npc_on_use", stock_trader)
    RegisterScriptCallback("trader_on_restock", stock_restock)
    RegisterScriptCallback("ActorMenu_on_trade_started", stock_talking)
    RegisterScriptCallback("save_state", on_save_state)
    RegisterScriptCallback("load_state", on_load_state)
    RegisterScriptCallback("ActorMenu_on_item_before_move", on_item_before_move)
    RegisterScriptCallback("actor_on_stash_remove", on_stash_remove)
    log("game/global_stash ready")
end
