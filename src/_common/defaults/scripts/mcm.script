--[[
	DOGMA Defaults — 3rd-party MCM / [options] / console.

	Buttons queue a pack. MCM Apply commits. MCM Reset drops the queue.
]]

-- Shared across MCM gather vs in-game (same pattern as other _G.__dogma_* state).
local function pending_q()
	return _G.__dogma_defaults_pending
end

local function packs()
	return _G.dogma_defaults_data or {}
end

local function ensure_pending()
	local q = pending_q()
	if not q then
		q = { mcm = {}, options = {}, commands = {} }
		_G.__dogma_defaults_pending = q
	end
	return q
end

local function queue_pack(pack)
	if not pack then
		return
	end
	local q = ensure_pending()
	if pack.mcm then
		for k, v in pairs(pack.mcm) do
			q.mcm[k] = v
		end
	end
	if pack.options then
		for k, v in pairs(pack.options) do
			q.options[k] = v
		end
	end
	local cmds = pack.commands
	if cmds then
		for i = 1, #cmds do
			q.commands[#q.commands + 1] = cmds[i]
		end
	end
end

local function queued()
	local q = pending_q()
	return q
		and (
			next(q.mcm)
			or next(q.options)
			or (q.commands and q.commands[1])
		)
end

local function write_axr(section, key, value)
	local cfg = axr_main and axr_main.config
	if not (cfg and cfg.w_value) then
		return
	end
	cfg:w_value(section, key, value)
end

local function commit_pending()
	if not queued() then
		return
	end
	local q = pending_q()
	_G.__dogma_defaults_pending = nil
	if ui_mcm and ui_mcm.set then
		for k, v in pairs(q.mcm) do
			ui_mcm.set(k, v)
		end
	else
		for k, v in pairs(q.mcm) do
			write_axr("mcm", k, v)
		end
	end
	for k, v in pairs(q.options) do
		write_axr("options", k, v)
	end
	local cfg = axr_main and axr_main.config
	if cfg and cfg.save then
		cfg:save()
	end
	local cmds = q.commands
	if cmds then
		for i = 1, #cmds do
			if exec_console_cmd then
				exec_console_cmd(cmds[i])
			end
		end
	end
end

local function drop_pending()
	_G.__dogma_defaults_pending = nil
end

local function msg(gui, loc)
	if gui and gui.owner and gui.owner.SetMsg then
		gui.owner:SetMsg(game.translate_string(loc), 5)
	end
end

local function on_apply_all(gui)
	local data = packs()
	for i = 1, #data do
		queue_pack(data[i])
	end
	msg(gui, "ui_mcm_dogma_defaults_queued_msg")
end

local function pack_button(pack)
	return function(gui)
		queue_pack(pack)
		msg(gui, "ui_mcm_dogma_defaults_queued_msg")
	end
end

function on_mcm_load(options)
	local data = packs()
	local items = {
		{
			id = "page_description",
			type = "desc",
			text = "ui_mcm_dogma_defaults_third_party_page_description",
		},
		{
			id = "apply_all",
			type = "button",
			hint = "dogma_defaults_third_party_apply_all",
			functor_ui = { on_apply_all },
		},
		{ id = "line_apply", type = "line" },
	}
	for i = 1, #data do
		local pack = data[i]
		items[#items + 1] = {
			id = "hdr_" .. pack.id,
			type = "title",
			text = pack.name,
		}
		items[#items + 1] = {
			id = "apply_" .. pack.id,
			type = "button",
			hint = "dogma_defaults_third_party_apply",
			functor_ui = { pack_button(pack) },
		}
	end
	dogma_mcm.attach(options, "defaults", "ui_mcm_menu_dogma_defaults", {
		id = "third_party",
		sh = true,
		text = "ui_mcm_menu_dogma_defaults_third_party",
		gr = dogma_mcm.with_header(items),
	})
end

if RegisterScriptCallback then
	RegisterScriptCallback("mcm_option_change", commit_pending)
	RegisterScriptCallback("mcm_option_reset", drop_pending)
end
