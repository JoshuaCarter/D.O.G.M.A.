	<!-- Shared Debug page -->
	<string id="ui_mcm_menu_dogma_debug">
		<text>Debug</text>
	</string>
	<string id="ui_mcm_dogma_debug_page_description">
		<text>Shared debug logging, on-screen overlay, and feature test keys. Leave logging on if you are reporting a bug.</text>
	</string>
	<string id="ui_mcm_dogma_debug_debug_log">
		<text>Enable debug logging</text>
	</string>
	<string id="ui_mcm_dogma_debug_debug_log_desc">
		<text>Writes D.O.G.M.A. debug lines to xray_*.log under appdata/logs. On by default.</text>
	</string>
	<string id="ui_mcm_dogma_debug_debug_overlay">
		<text>Enable debug overlay</text>
	</string>
	<string id="ui_mcm_dogma_debug_debug_overlay_desc">
		<text>On-screen D.O.G.M.A. debug overlay used by features that support it.</text>
	</string>
	<string id="ui_mcm_dogma_debug_hdr_grain">
		<text>Radiation</text>
	</string>
	<string id="ui_mcm_dogma_debug_grain_add_radiation_key">
		<text>Add radiation (key)</text>
	</string>
	<string id="ui_mcm_dogma_debug_grain_add_radiation_key_desc">
		<text>Development keybind: add a chunk of radiation to the actor for testing grain FX.</text>
	</string>
	<string id="ui_mcm_dogma_debug_grain_clear_radiation_key">
		<text>Clear radiation (key)</text>
	</string>
	<string id="ui_mcm_dogma_debug_grain_clear_radiation_key_desc">
		<text>Development keybind: clear the actor's radiation.</text>
	</string>
	<string id="ui_mcm_dogma_debug_hdr_fast_travel">
		<text>Fast Travel</text>
	</string>
	<string id="ui_mcm_dogma_debug_ft_path_preview">
		<text>Path preview on PDA</text>
	</string>
	<string id="ui_mcm_dogma_debug_ft_path_preview_desc">
		<text>Show the route on the PDA when you right-click a destination, before you start travelling.</text>
	</string>
	<string id="ui_mcm_dogma_debug_ft_sneaking_level_up">
		<text>Sneaking level +</text>
	</string>
	<string id="ui_mcm_dogma_debug_ft_sneaking_level_up_desc">
		<text>Development keybind: increase Sneaking skill level by 1.</text>
	</string>
	<string id="ui_mcm_dogma_debug_ft_sneaking_level_down">
		<text>Sneaking level -</text>
	</string>
	<string id="ui_mcm_dogma_debug_ft_sneaking_level_down_desc">
		<text>Development keybind: decrease Sneaking skill level by 1.</text>
	</string>
	<string id="ui_mcm_dogma_debug_ft_coarse_nav_rebuild_on_load">
		<text>Rebuild coarse nav on load</text>
	</string>
	<string id="ui_mcm_dogma_debug_ft_coarse_nav_rebuild_on_load_desc">
		<text>When on, always rebuild this level's coarse nav on load (ignores a matching cache). Off = load the cache if present, else rebuild.</text>
	</string>
	<string id="ui_mcm_dogma_debug_ft_coarse_nav_build">
		<text>Rebuild coarse nav (key)</text>
	</string>
	<string id="ui_mcm_dogma_debug_ft_coarse_nav_build_desc">
		<text>Development keybind: force-rebuild this level's coarse nav graph and overwrite the cache. When bound, the graph is shown on the PDA map.</text>
	</string>
	<string id="ui_mcm_dogma_debug_hdr_fps">
		<text>FPS</text>
	</string>
	<string id="ui_mcm_dogma_debug_fps_long_frame_threshold_desc">
