--[[
	MCM Runtime Read Cache

	Wraps ui_mcm.get with an in-Lua table so mods that spam get() every
	update pay one axr_options:r_value per key until the value changes.

	Lifecycle (checked against ui_mcm On_Accept):
	  - Caching starts empty on on_game_load (first enable only; map/save
	    reloads keep a warm cache — axr_options is profile-scoped).
	  - main_menu_on_init disables + clears (main-menu Accept does NOT send
	    on_option_change — only mcm_option_change — so menu must not use cache).
	  - In-game Accept: on_option_change clears slots, cache stays on.
	  - ui_mcm.set drops that key only.

	Debug (DOGMA → Debug → debug_log): clears/sets log immediately;
	get hit/miss aggregates print at most once per SUMMARY_MS.
]]

local CONFIG = _G.dogma_perf_mcm_runtime_read_cache_conf
local MOD_ID = (CONFIG and CONFIG.MOD_ID) or "dogma/perf/mcm_runtime_read_cache"
local TAG = "dogma_perf_mcm_runtime_read_cache"
local SUMMARY_MS = 10000
local TOP_N = 20

local HOOK = _G.__dogma_perf_mcm_runtime_read_cache or {}
_G.__dogma_perf_mcm_runtime_read_cache = HOOK

-- present[id] marks a cached slot (value may be false or nil).
local cache = HOOK.cache or {}
local present = HOOK.present or {}
HOOK.cache = cache
HOOK.present = present

local hits = HOOK.hits or {}
local misses = HOOK.misses or {}
HOOK.hits = hits
HOOK.misses = misses

local hit_total = HOOK.hit_total or 0
local miss_total = HOOK.miss_total or 0
local last_flush_ms = HOOK.last_flush_ms or 0
local logging_on = HOOK.logging_on or false
-- Only serve/fill cache while a game session is loaded.
local active = HOOK.active or false
HOOK.hit_total = hit_total
HOOK.miss_total = miss_total
HOOK.last_flush_ms = last_flush_ms
HOOK.logging_on = logging_on
HOOK.active = active

local function now_ms()
	if time_continual then
		return time_continual()
	end
	if time_global then
		return time_global()
	end
	return 0
end

local function sync_logging()
	local on = false
	local dogma = rawget(_G, "dogma")
	if dogma and dogma.dbg and dogma.dbg.logging then
		on = dogma.dbg.logging() == true
	end
	logging_on = on
	HOOK.logging_on = on
	return on
end

local function emit(msg)
	local dogma = rawget(_G, "dogma")
	if dogma and dogma.dbg and dogma.dbg.log then
		dogma.dbg.log(MOD_ID, msg)
		return
	end
	printf("[%s] %s", TAG, tostring(msg))
end

local function reset_window_stats()
	for id in pairs(hits) do
		hits[id] = nil
	end
	for id in pairs(misses) do
		misses[id] = nil
	end
	hit_total = 0
	miss_total = 0
	HOOK.hit_total = 0
	HOOK.miss_total = 0
end

local function count_present()
	local n = 0
	for _ in pairs(present) do
		n = n + 1
	end
	return n
end

local function wipe_slots()
	for id in pairs(present) do
		present[id] = nil
		cache[id] = nil
	end
end

local function note_hit(id)
	hits[id] = (hits[id] or 0) + 1
	hit_total = hit_total + 1
	HOOK.hit_total = hit_total
end

local function note_miss(id)
	misses[id] = (misses[id] or 0) + 1
	miss_total = miss_total + 1
	HOOK.miss_total = miss_total
end

local function flush_summary(force)
	if not logging_on then
		return
	end
	if hit_total == 0 and miss_total == 0 then
		last_flush_ms = now_ms()
		HOOK.last_flush_ms = last_flush_ms
		return
	end
	local t = now_ms()
	if not force and (t - last_flush_ms) < SUMMARY_MS then
		return
	end
	last_flush_ms = t
	HOOK.last_flush_ms = t

	local total = hit_total + miss_total
	local uniq = {}
	local n_uniq = 0
	for id, n in pairs(hits) do
		uniq[id] = (uniq[id] or 0) + n
	end
	for id, n in pairs(misses) do
		uniq[id] = (uniq[id] or 0) + n
	end
	local ranked = {}
	for id, n in pairs(uniq) do
		n_uniq = n_uniq + 1
		ranked[#ranked + 1] = { id = id, n = n, h = hits[id] or 0, m = misses[id] or 0 }
	end
	table.sort(ranked, function(a, b)
		if a.n == b.n then
			return tostring(a.id) < tostring(b.id)
		end
		return a.n > b.n
	end)

	local hit_pct = total > 0 and (100 * hit_total / total) or 0
	emit(string.format(
		"get window: total=%d hit=%d miss=%d hit_rate=%.1f%% unique=%d cached=%d active=%s",
		total, hit_total, miss_total, hit_pct, n_uniq, count_present(), tostring(active)
	))

	local limit = math.min(TOP_N, #ranked)
	for i = 1, limit do
		local r = ranked[i]
		emit(string.format("  #%d %s  reads=%d (hit=%d miss=%d)", i, tostring(r.id), r.n, r.h, r.m))
	end
	if #ranked > limit then
		emit(string.format("  ... +%d more keys", #ranked - limit))
	end

	reset_window_stats()
end

local function clear_slots(reason)
	if logging_on then
		flush_summary(true)
		emit(string.format("clear (%s) dropped=%d active=%s", tostring(reason or "?"), count_present(), tostring(active)))
	end
	wipe_slots()
	reset_window_stats()
end

local function enable_cache(reason)
	sync_logging()
	if active then
		return
	end
	wipe_slots()
	reset_window_stats()
	active = true
	HOOK.active = true
	if logging_on then
		emit(string.format("cache on (%s)", tostring(reason or "?")))
	end
end

local function disable_cache(reason)
	sync_logging()
	if not active then
		wipe_slots()
		return
	end
	clear_slots(reason)
	active = false
	HOOK.active = false
	if logging_on then
		emit(string.format("cache off (%s)", tostring(reason or "?")))
	end
end

local function patch_get_set()
	if HOOK.patched then
		return true
	end
	if not (ui_mcm and type(ui_mcm.get) == "function") then
		return false
	end

	local orig_get = ui_mcm.get
	local orig_set = ui_mcm.set

	-- Gates read HOOK.logging_on (not a closed-over local) so bench can mute.
	ui_mcm.get = function(id)
		-- MCM asserts on get while gathering (e.g. Reset/Default). Soft-fail like dogma.mcm.
		if ui_mcm.is_gathering and ui_mcm.is_gathering() then
			local ok, value = pcall(orig_get, id)
			if ok then
				return value
			end
			return nil
		end
		if active and present[id] then
			if HOOK.logging_on then
				note_hit(id)
				flush_summary(false)
			end
			return cache[id]
		end
		local value = orig_get(id)
		if active then
			present[id] = true
			cache[id] = value
			if HOOK.logging_on then
				note_miss(id)
				flush_summary(false)
			end
		end
		return value
	end

	-- Keep disk/write behavior; drop so the next get re-reads axr.
	if type(orig_set) == "function" then
		ui_mcm.set = function(id, value)
			local had = present[id]
			present[id] = nil
			cache[id] = nil
			if HOOK.logging_on then
				emit(string.format(
					"set %s := %s (cache_%s active=%s)",
					tostring(id),
					tostring(value),
					had and "dropped" or "miss",
					tostring(active)
				))
			end
			return orig_set(id, value)
		end
	end

	HOOK.orig_get = orig_get
	HOOK.orig_set = orig_set
	HOOK.patched = true
	printf("[%s] patched ui_mcm.get/set", TAG)
	return true
end

local function register_lifecycle()
	if HOOK.callbacks then
		return
	end
	if not RegisterScriptCallback then
		return
	end
	-- In-game Accept only (ui_mcm gates on level.present()).
	RegisterScriptCallback("on_option_change", function()
		sync_logging()
		if active then
			clear_slots("on_option_change")
		end
	end)
	-- Fresh enable when entering a loaded game; warm across later map loads.
	RegisterScriptCallback("on_game_load", function()
		enable_cache("on_game_load")
	end)
	-- Menu Accept skips on_option_change — do not cache until the next load.
	RegisterScriptCallback("main_menu_on_init", function()
		disable_cache("main_menu_on_init")
	end)
	HOOK.callbacks = true
end

-- MCM gather loads this file at main menu - patch immediately (inactive).
patch_get_set()
register_lifecycle()
sync_logging()

function on_mcm_load(options)
	patch_get_set()
	register_lifecycle()
	sync_logging()

	dogma_mcm.attach(options, "perf", "ui_mcm_menu_dogma_perf", {
		id = "mcm_runtime_read_cache",
		sh = true,
		text = "ui_mcm_menu_dogma_perf_mcm_runtime_read_cache",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_perf_mcm_runtime_read_cache_page_description",
			},
		}),
	})
end

function on_game_start()
	if not patch_get_set() then
		printf("[%s] ui_mcm.get missing - patch skipped", TAG)
	end
	register_lifecycle()
	sync_logging()
end
