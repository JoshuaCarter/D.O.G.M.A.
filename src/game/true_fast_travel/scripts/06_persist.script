-- True Fast Travel MVP: clear travel flags (no mid-journey save resume).

local tft = _G.tft

local function clear()
	local actor = db.actor
	if not actor then return end

	tft.is_traveling = false
	if tft_set_fft_trip_in_progress then
		tft_set_fft_trip_in_progress(false)
	end
	tft.path_chain = nil
	tft.path_chain_meta = nil
	tft.dest_anchor_key = nil
	if tft_clear_path_preview then
		pcall(tft_clear_path_preview)
	elseif tft_cleanup_dots then
		pcall(tft_cleanup_dots)
	end
	tft.is_path_preview = false
	tft.path_preview_id = nil
	tft.menu_path_cache = nil

	local sv = tft_save_vars or {}
	if sv.traveling then save_var(actor, sv.traveling, false) end
	if sv.final_gvid then save_var(actor, sv.final_gvid, false) end
	if sv.final_x then save_var(actor, sv.final_x, nil) end
	if sv.final_y then save_var(actor, sv.final_y, nil) end
	if sv.final_z then save_var(actor, sv.final_z, nil) end
	if sv.final_lvid then save_var(actor, sv.final_lvid, nil) end
end

local function save()
	-- MVP: do not persist in-progress trips across save/load.
end

local function load()
	clear()
end

do
	_G.tft_clear = clear
	_G.tft_save = save
	_G.tft_load = load
end
