-- controls/equipment_controls conf
-- Device keys via dogma_mcm.keys (RF / Glowstick customs).

local defaults = {
	["auto_bolt_on_detector"] = true,
	["key_radio"] = -1,
	["key_glowstick"] = -1,
}

local BINDS = {
	rf_scanner = {
		action = "custom23",
		kb = "kCUSTOM23",
		control = {
			id = "kb_rf_scanner",
			label = "RF Scanner",
			group = "kb_grp_inventory",
			after = "kb_geiger",
		},
	},
	glowstick = {
		action = "custom12",
		kb = "kCUSTOM12",
		control = {
			id = "kb_glowstick",
			label = "Glowstick",
			group = "kb_grp_inventory",
			after = "kb_torch",
		},
	},
}

_G.dogma_controls_equipment_controls_conf = {
	MOD_ID = "dogma/controls/equipment_controls",
	DEFAULTS = defaults,
	BINDS = BINDS,
	loaded = {
		enabled = true,
		auto_bolt_on_detector = defaults["auto_bolt_on_detector"],
		key_radio = nil,
		key_glowstick = nil,
		key_detector = nil,
		key_geiger = nil,
		key_torch = nil,
	},
}

do
	local KM = dogma_mcm.keys
	if KM then
		local order = { "rf_scanner", "glowstick" }
		for i = 1, #order do
			local spec = BINDS[order[i]]
			local c = spec and spec.control
			if c then
				KM.claim_control({
					action = spec.action,
					id = c.id,
					label = c.label,
					group = c.group,
					after = c.after,
				})
			end
		end
	end
end
