function on_mcm_load(options)
	dogma_mcm.attach(options, "hud", "ui_mcm_menu_dogma_hud", {
		id = "medik",
		sh = true,
		text = "ui_mcm_menu_dogma_hud_medik",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_hud_medik_page_description",
			},
		}),
	})
end
