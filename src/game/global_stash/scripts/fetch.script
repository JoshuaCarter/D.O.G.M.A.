--[[
	Fetch stash count.

	Real path (traced):
	  trigger_fetch_func
	    -> tasks_fetch.postpone_fetch_for_next_frame
	      -> z_fetch_shows_count.extend_news_text
	         OR a_ui_pda_inventory_cache.get_cached_fetch_count_text
	      -> give_talk_message2
	  iTheon/Gamma intercepts give_talk_message2 into task details.
	  Vanilla dialog shows that same news text.

	Both counters iterate m_data.workshop_stashes values (bolt ids)
	that are online. We register there and plant bolts first.
]]

local MOD_ID = "dogma/game/global_stash"

local orig_news
local orig_cached
local orig_postpone
local logged = {}

local function log(msg, color)
	dogma.log.log(MOD_ID, tostring(msg), color)
end

local function get_api()
	return _G.dogma_game_global_stash
end

local function before_count(why)
	local api = get_api()
	if api and api.ensure_online then
		api.ensure_online()
	end
	if not logged[why] then
		logged[why] = true
		log("fetch count via " .. tostring(why))
	end
end

local function wrapped_news(text, section, amount, task_id)
	before_count("news")
	return orig_news(text, section, amount, task_id)
end

local function wrapped_cached(a, b, c, d)
	before_count("cached")
	return orig_cached(a, b, c, d)
end

local function wrapped_postpone(task_id, section, amount)
	before_count("postpone")
	return orig_postpone(task_id, section, amount)
end

local function hook_news()
	local z = z_fetch_shows_count
	if not (z and z.extend_news_text) then
		log("fetch news skip")
		return false
	end
	if z.extend_news_text == wrapped_news then
		return true
	end
	orig_news = z.extend_news_text
	z.extend_news_text = wrapped_news
	log("fetch news hooked")
	return true
end

local function hook_cached()
	local a = a_ui_pda_inventory_cache
	if not (a and a.get_cached_fetch_count_text) then
		log("fetch cached skip")
		return false
	end
	if a.get_cached_fetch_count_text == wrapped_cached then
		return true
	end
	orig_cached = a.get_cached_fetch_count_text
	a.get_cached_fetch_count_text = wrapped_cached
	log("fetch cached hooked")
	return true
end

local function hook_postpone()
	if not (tasks_fetch and tasks_fetch.postpone_fetch_for_next_frame) then
		log("fetch postpone skip")
		return false
	end
	if tasks_fetch.postpone_fetch_for_next_frame == wrapped_postpone then
		return true
	end
	orig_postpone = tasks_fetch.postpone_fetch_for_next_frame
	tasks_fetch.postpone_fetch_for_next_frame = wrapped_postpone
	log("fetch postpone hooked")
	return true
end

local function hook_all()
	hook_news()
	hook_cached()
	hook_postpone()
	local api = get_api()
	if api and api.register_fetch then
		api.register_fetch()
	end
	return true
end

function on_game_start()
	RegisterScriptCallback("on_game_load", hook_all)
	CreateTimeEvent("dogma_game_global_stash", "fetch_late", 0.2, hook_all)
	log("fetch ready")
end
