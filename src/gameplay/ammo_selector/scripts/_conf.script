-- gameplay/ammo_selector conf
-- Hold mode: MCM ammo_key (overlaps OK). Toggle: vanilla wpn_next in Settings→Controls.

local defaults = {
	-- Hold-mode key (MCM-only; may overlap engine binds). Unbound until set.
	["ammo_key"] = -1,
	-- 0 = toggle (vanilla release-open), 2 = hold (open on down, close on up)
	["mode"] = 2,
	-- Hold only: ms to wait before opening (release before this = no open).
	["hold_delay_ms"] = 200,
	-- Hold only: release while hovering a slot selects it (like a click).
	["select_on_release"] = true,
}

_G.dogma_gameplay_ammo_selector_conf = {
	MOD_ID = "dogma/gameplay/ammo_selector",
	DEFAULTS = defaults,
	loaded = {
		ammo_key = defaults["ammo_key"],
		mode = defaults["mode"],
		hold_delay_ms = defaults["hold_delay_ms"],
		select_on_release = defaults["select_on_release"],
	},
}
