--[[
	Inventory strip keybind (hold+hover).
	Burst work stays in stripping.script; this only queues via dogma_strip.
]]

local CONFIG = _G.dogma_input_inventory_controls_conf
local MOD_ID = CONFIG.MOD_ID

local ALLOWED_BAGS = {
	actor_bag = true,
	actor_equ = true,
	actor_belt = true,
	npc_bag = true,
	picker = true,
}

local key = nil
local modifier = 0
local bind = nil

local function log(msg)
	if dogma.dbg.logging() then
		dogma.dbg.log(MOD_ID, tostring(msg))
	end
end

local function inv_mode_ok(gui)
	local mode = gui and gui.mode
	return mode == "inventory" or mode == "loot"
end

local function key_down()
	return key and dogma.input.is_key_down(key) and dogma.input.is_mod_down(modifier)
end

local function fire(gui, obj, bag, idx)
	local api = _G.dogma_strip
	if not (api and api.strip_hover) then
		return
	end
	local items = _G.dogma_inv_hover.stack_items(gui, obj, bag)
	for i = 1, #items do
		api.strip_hover(items[i], bag, idx, gui)
	end
end

local function on_option_change()
	key = dogma.mcm.key(MOD_ID, "key")
	modifier = dogma.mcm.int(MOD_ID, "key_modifier", 0)
	if bind then
		_G.dogma_inv_hover.reset(bind)
	end
end

function on_game_start()
	dogma.load(MOD_ID)
	RegisterScriptCallback("on_option_change", on_option_change)
	on_option_change()
	bind = _G.dogma_inv_hover.register({
		key_down = key_down,
		mode_ok = inv_mode_ok,
		bags = ALLOWED_BAGS,
		fire = fire,
	})
	log("strip keys ready")
end
