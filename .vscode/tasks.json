{
	"version": "2.0.0",
	"options": {
		"cwd": "${workspaceFolder}",
		"env": {
			"DOGMA_DEPLOY": "C:/GAMMA/mods/DOGMA"
		}
	},
	"tasks": [
		{
			"label": "DOGMA: Build",
			"type": "shell",
			"command": "tools/build.sh",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "DOGMA: Hotload live assets",
			"type": "shell",
			"command": "tools/patch_live.sh",
			"detail": "Copy UI/text XML + DDS/THM into GAMMA mods/DOGMA (no scripts; game can stay open)",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"problemMatcher": []
		}
	]
}
