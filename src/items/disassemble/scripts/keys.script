--[[
	Inventory disassemble keybinds.
	Press / dtap: one stack. Hold: one stack then step-timed repeats while held;
	hovered item id change resets the streak and fires again.
]]

local CONFIG = _G.dogma_items_disassemble_conf
local MOD_ID = CONFIG.MOD_ID
local DOGMA

local MODE_DTAP = 1
local MODE_HOLD = 2

local ALLOWED_BAGS = {
	actor_bag = true,
	actor_equ = true,
	actor_belt = true,
	npc_bag = true,
	picker = true,
}

local BINDS = {}
local dtap_last = {}
local hold_state = {} -- [dik] = { bind, t0, fire_count, last_id }

local function log(msg)
	if DOGMA and DOGMA.dbg and DOGMA.dbg.logging() then
		DOGMA.dbg.log(MOD_ID, tostring(msg))
	end
end

local function on_option_change()
	CONFIG.loaded.disa_safe_equipped = DOGMA.mcm.bool(MOD_ID, "disa_safe_equipped")
	BINDS = {}
	local key = DOGMA.mcm.key(MOD_ID, "key_disa")
	if key then
		BINDS[1] = {
			id = "disa",
			key = key,
			modifier = math.floor(DOGMA.mcm.number(MOD_ID, "key_disa_modifier", 0) + 0.5),
			mode = math.floor(DOGMA.mcm.number(MOD_ID, "key_disa_mode", 0) + 0.5),
		}
	end
end

local function mod_ok(modifier)
	if not (ui_mcm and ui_mcm.get_mod_key) then
		return true
	end
	return ui_mcm.get_mod_key(modifier)
end

local function dtap_window_ms()
	if not ui_mcm then
		return 250
	end
	return ui_mcm.get("mcm/mcm_kb/mcm_kb_main/dtaptime2") or 250
end

local function inv_mode_ok(gui)
	local mode = gui and gui.mode
	return mode == "inventory" or mode == "loot"
end

local function bag_allowed(bag)
	return bag and ALLOWED_BAGS[bag]
end

local function get_hover(gui)
	gui = gui or (ui_inventory and ui_inventory.GUI)
	if not (gui and gui.hover) then
		return nil
	end
	local bag, idx = gui.hover.bag, gui.hover.idx
	if not (bag_allowed(bag) and idx) then
		return nil
	end
	local cc = gui.CC and gui.CC[bag]
	local obj = cc and cc:GetObj(idx)
	if not obj then
		return nil
	end
	return obj, bag, idx, gui
end

local function is_equipped(obj)
	if not (obj and db.actor and _G.SCANNED_SLOTS) then
		return false
	end
	local id = obj:id()
	local n = 0
	for _ in pairs(_G.SCANNED_SLOTS) do
		n = n + 1
	end
	for i = 0, n + 1 do
		local slot_obj = db.actor:item_in_slot(i)
		if slot_obj and slot_obj:id() == id then
			return true
		end
	end
	return false
end

local function do_disa(gui, obj)
	if CONFIG.loaded.disa_safe_equipped and is_equipped(obj) then
		return
	end
	if not (item_parts and item_parts.menu_disassembly and item_parts.func_disassembly) then
		return
	end
	if not item_parts.menu_disassembly(obj) then
		return
	end
	item_parts.func_disassembly(obj)
	if gui and gui.mode == "loot" and gui.On_Item_Update then
		gui:On_Item_Update()
	end
end

local function repeat_delay_ms(fire_count)
	if fire_count <= 0 then
		return 0
	end
	if fire_count == 1 then
		return 1000
	end
	if fire_count == 2 then
		return 1500
	end
	if fire_count == 3 then
		return 2000
	end
	return 2250 + (fire_count - 4) * 250
end

local function fire_bind()
	local obj, bag, idx, gui = get_hover()
	if not obj then
		return false
	end
	do_disa(gui, obj)
	return true, obj:id()
end

local function start_hold(bind, dik)
	local now = time_continual()
	local hs = { bind = bind, t0 = now, fire_count = 0, last_id = nil }
	hold_state[dik] = hs
	local ok, id = fire_bind()
	if ok then
		hs.last_id = id
		hs.fire_count = 1
		hs.t0 = now
	end
end

local function on_key_pressed(dik, gui)
	if gui and gui.mode == "loot" and (dik == DIK_keys.DIK_LSHIFT or dik == DIK_keys.DIK_RSHIFT) then
		return
	end
	for i = 1, #BINDS do
		local bind = BINDS[i]
		if bind.key ~= dik or not mod_ok(bind.modifier) then
			-- skip
		elseif bind.mode == MODE_HOLD then
			start_hold(bind, dik)
		elseif bind.mode == MODE_DTAP then
			local now = time_continual()
			local prev = dtap_last[bind.id]
			dtap_last[bind.id] = now
			if prev and (now - prev) <= dtap_window_ms() then
				dtap_last[bind.id] = nil
				fire_bind()
			end
		else
			fire_bind()
		end
	end
end

local function on_key_released(dik)
	hold_state[dik] = nil
end

local function hold_tick(gui)
	if not inv_mode_ok(gui) then
		return
	end
	local now = time_continual()
	for dik, hs in pairs(hold_state) do
		if key_state(dik) == 0 or not mod_ok(hs.bind.modifier) then
			hold_state[dik] = nil
		else
			local obj, bag, idx, g = get_hover()
			local id = obj and obj:id() or nil
			if not id then
				hs.last_id = nil
				hs.fire_count = 0
				hs.t0 = now
			elseif id ~= hs.last_id then
				hs.last_id = id
				hs.fire_count = 0
				hs.t0 = now
				do_disa(g, obj)
				hs.fire_count = 1
			elseif (now - hs.t0) >= repeat_delay_ms(hs.fire_count) then
				do_disa(g, obj)
				hs.fire_count = hs.fire_count + 1
			end
		end
	end
end

local original_on_keyboard = ui_inventory and ui_inventory.UIInventory and ui_inventory.UIInventory.OnKeyboard
if original_on_keyboard then
	function ui_inventory.UIInventory:OnKeyboard(dik, keyboard_action)
		local res = original_on_keyboard(self, dik, keyboard_action)
		if not (DOGMA and DOGMA.sys and DOGMA.sys.ready(MOD_ID, db, on_option_change)) then
			return res
		end
		if not inv_mode_ok(self) then
			return res
		end
		if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
			on_key_pressed(dik, self)
		elseif keyboard_action == ui_events.WINDOW_KEY_RELEASED then
			on_key_released(dik)
		end
		return res
	end
end

local original_on_update = ui_inventory and ui_inventory.UIInventory and ui_inventory.UIInventory.Update
if original_on_update then
	function ui_inventory.UIInventory:Update()
		original_on_update(self)
		if DOGMA and DOGMA.sys and DOGMA.sys.ready(MOD_ID, db, on_option_change) then
			hold_tick(self)
		end
	end
end

function on_game_start()
	DOGMA = dogma_common.load(MOD_ID)
	RegisterScriptCallback("on_option_change", on_option_change)
	on_option_change()
	log("disassemble keys ready")
end
