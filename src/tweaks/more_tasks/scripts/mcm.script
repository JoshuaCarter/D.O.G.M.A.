-- tweaks/more_tasks conf (info-only MCM; always on while installed)

_G.dogma_tweaks_more_tasks_conf = {
	MOD_ID = "dogma/tweaks/more_tasks",
}

function on_mcm_load(options)
	dogma_mcm.append(options, "tweaks", "ui_mcm_menu_dogma_tweaks", {
