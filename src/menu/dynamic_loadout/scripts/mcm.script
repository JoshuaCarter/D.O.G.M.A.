		{
			id = "hdr_weights",
			type = "desc",
			text = "ui_mcm_dogma_menu_dynamic_loadout_weights_section",
		},
	}

	-- Every scoring weight gets a 0-1 track (driven from CONFIG.WEIGHT_KEYS).
	-- Def is always 1 (ignore stale/mismatched DEFAULTS for MCM reset).
	local keys = CONFIG.WEIGHT_KEYS or {}
	for i = 1, #keys do
		local id = keys[i]
		if id == "w_mut_dps" then
			gr[#gr + 1] = {
				id = "hdr_w_weapon",
				type = "desc",
				text = "ui_mcm_dogma_menu_dynamic_loadout_weights_weapon",
			}
		elseif id == "a_fire_wound" then
			gr[#gr + 1] = {
				id = "hdr_w_armor",
				type = "desc",
				text = "ui_mcm_dogma_menu_dynamic_loadout_weights_armor",
			}
		elseif id == "ammo_dmg_ap" then
			gr[#gr + 1] = {
				id = "hdr_w_ammo",
				type = "desc",
				text = "ui_mcm_dogma_menu_dynamic_loadout_weights_ammo",
			}
		elseif id == "sight_zoom" then
			gr[#gr + 1] = {
				id = "hdr_w_sight",
				type = "desc",
				text = "ui_mcm_dogma_menu_dynamic_loadout_weights_sight",
			}
		end
		gr[#gr + 1] = wtrack(id, 0.5)
	end

	dogma_mcm.attach(options, "menu", "ui_mcm_menu_dogma_menu", {
		id = "dynamic_loadout",
		sh = true,
		text = "ui_mcm_menu_dogma_menu_dynamic_loadout",
		gr = dogma_mcm.with_header(gr),
	})

	patch_score_preview()
end

--------------------------------------------------------------------------
-- Trivial MCM score preview (hardcoded gun snapshots, top-left text)
--------------------------------------------------------------------------

-- Frozen raw stats (not live ini). Enough to see weight / cost_mult slider effect.
-- mut = armor col 1; mutant = tip mutant-row max (preview uses max(mut, mutant) as mut dmg).
-- reload = empty→full seconds (approx; live scoring uses tip motion lengths).
local PREVIEW_GUNS = {
	{
		name = "PM", ammo = "9x18",
		mut = 42, mutant = 38, lgt = 38, mid = 28, hvy = 18, max = 10,
		rpm = 180, mag = 8, reload = 2.4, burst = 4,
		ads = 0.35, hip = 2.8, scope = 0, sil = 1, cost = 1500,
	},
	{
		name = "Kiparis", ammo = "9x18",
		mut = 48, mutant = 44, lgt = 44, mid = 34, hvy = 22, max = 12,
		rpm = 850, mag = 30, reload = 2.5, burst = 6,
		ads = 0.45, hip = 3.5, scope = 0, sil = 1, cost = 6500,
	},
	{
		name = "AK-74", ammo = "5.45",
		mut = 72, mutant = 65, lgt = 68, mid = 55, hvy = 40, max = 28,
		rpm = 650, mag = 30, reload = 2.8, burst = 5,
		ads = 0.25, hip = 2.2, scope = 1, sil = 1, cost = 14000,
	},
	{
		name = "PPSh-41", ammo = "7.62x25",
		mut = 55, mutant = 70, lgt = 50, mid = 38, hvy = 24, max = 14,
		rpm = 900, mag = 71, reload = 3.2, burst = 7,
		ads = 0.55, hip = 4.0, scope = 0, sil = 0, cost = 9000,
	},
	{
		name = "TOZ-66", ammo = "12x70",
		mut = 40, mutant = 120, lgt = 55, mid = 35, hvy = 20, max = 10,
		rpm = 120, mag = 2, reload = 4.0, burst = 1,
		ads = 0.80, hip = 5.0, scope = 0, sil = 0, cost = 4000,
	},
}

local PREVIEW_XML = "ui_dogma_menu_dynamic_loadout_preview.xml"
local PREVIEW_ID = "dl_score_preview"
local PREVIEW_HOOK = _G.__dogma_dl_score_preview or {}
_G.__dogma_dl_score_preview = PREVIEW_HOOK

local function preview_score_gun(g)
	local st = avg_state_new()
	-- Same rule as live scoring: mut dmg = max(armor col 1, tip mutant-row).
	local mut = g.mut or 0
	if (g.mutant or 0) > mut then
		mut = g.mutant
	end
	local rpm = g.rpm or 0
	local mag = g.mag or 0
	local reload_s = g.reload or 2.5
	local cols = {
		{ key = "mut_dps", w = "w_mut_dps", dmg = mut },
		{ key = "lgt_dps", w = "w_lgt_dps", dmg = g.lgt },
		{ key = "mid_dps", w = "w_mid_dps", dmg = g.mid },
		{ key = "hvy_dps", w = "w_hvy_dps", dmg = g.hvy },
		{ key = "max_dps", w = "w_max_dps", dmg = g.max },
	}
	for i = 1, #cols do
		local c = cols[i]
		local dps = sustained_dps(c.dmg, rpm, mag, reload_s)
		avg_add(st, c.key, dps, norm01(dps, NORM.dps), c.w, true)
	end
	avg_add(st, "burst", g.burst, norm01(g.burst, NORM.burst), "w_burst", true)
	avg_add(st, "spread_ads", g.ads, inv_norm01(g.ads, NORM.spread_ads), "w_spread_ads", true)
	avg_add(st, "spread_hip", g.hip, inv_norm01(g.hip, NORM.spread_hip), "w_spread_hip", true)
	avg_add(st, "scope", g.scope, g.scope, "w_scope", true)
	avg_add(st, "silencer", g.sil, g.sil, "w_silencer", true)
	avg_add(st, "price", g.cost, inv_norm01(g.cost, MAX_COST.weapon), "w_price", true)
	local avg = avg_finish(st)
	local pts = score_to_points(avg, "weapon")
	return pts, st.lines
end

local function preview_fingerprint()
	local keys = CONFIG.WEIGHT_KEYS or {}
	local parts = { tostring(cost_mult_for("weapon")) }
	for i = 1, #keys do
		local id = keys[i]
		if string.sub(id, 1, 2) == "w_" then
			parts[#parts + 1] = id .. "=" .. tostring(cfg_num(id))
		end
	end
	return table.concat(parts, "|")
end

local function preview_build_text()
	local lines = {}
	for i = 1, #PREVIEW_GUNS do
		local g = PREVIEW_GUNS[i]
		local pts, terms = preview_score_gun(g)
		if #lines > 0 then
			-- Space (not "") so the UI actually keeps a blank row between guns.
			lines[#lines + 1] = " "
		end
		lines[#lines + 1] = string.format(
			"%s (%d, %d, %s):",
			g.name, pts, g.cost or 0, g.ammo or "-"
		)
		for j = 1, #terms do
			lines[#lines + 1] = terms[j]
		end
	end
	return table.concat(lines, "\\n")
end

local function preview_collect_live(mcm)
	-- Read current track-bar positions from the open MCM page (not saved axr values).
	local live = {}
	local prefix = MOD_ID .. "/"
	local tracks = mcm and mcm._Track
	if not tracks then
		return live
	end
	for id, e in pairs(tracks) do
		if type(id) == "string" and string.sub(id, 1, #prefix) == prefix and e then
			local key = string.sub(id, #prefix + 1)
			local val = nil
			if e.ctrl and e.ctrl.GetFValue then
				local ok, v = pcall(function()
					return e.ctrl:GetFValue()
				end)
				if ok then
					val = v
				end
			end
			if val == nil then
				val = e.value
			end
			if val ~= nil then
				live[key] = val
			end
		end
	end
	return live
end

local function preview_on_dl_page(mcm)
	local path = tostring(mcm.last_path or mcm.path or "")
	return string.find(path, "dynamic_loadout", 1, true) ~= nil
end

local function preview_hide(mcm)
	LIVE_CFG = nil
	if PREVIEW_HOOK.label then
		pcall(function()
			PREVIEW_HOOK.label:Show(false)
		end)
	end
	PREVIEW_HOOK.fp = nil
	if mcm then
		mcm._dogma_dl_preview = nil
	end
end

local function preview_tick(mcm)
	if not preview_on_dl_page(mcm) then
		preview_hide(mcm)
		return
	end

	LIVE_CFG = preview_collect_live(mcm)
	local fp = preview_fingerprint()
	if PREVIEW_HOOK.fp == fp and PREVIEW_HOOK.label then
		PREVIEW_HOOK.label:Show(true)
		return
	end
	PREVIEW_HOOK.fp = fp

	local ok = pcall(function()
		if not PREVIEW_HOOK.label or mcm._dogma_dl_preview ~= PREVIEW_HOOK.label then
			local xml = CScriptXmlInit()
			xml:ParseFile(PREVIEW_XML)
			PREVIEW_HOOK.label = xml:InitTextWnd(PREVIEW_ID, mcm)
			mcm._dogma_dl_preview = PREVIEW_HOOK.label
		end
		PREVIEW_HOOK.label:SetText(preview_build_text())
		PREVIEW_HOOK.label:Show(true)
	end)
	if not ok then
		PREVIEW_HOOK.label = nil
		LIVE_CFG = nil
	end
end

function patch_score_preview()
	if PREVIEW_HOOK.patched then
		return true
	end
	local cls = ui_mcm and ui_mcm.UI_MCM
	if not (cls and cls.Update) then
		return false
	end
	local orig = cls.Update
	cls.Update = function(self)
		orig(self)
		preview_tick(self)
	end
	PREVIEW_HOOK.patched = true
	printf("[dogma_menu_dynamic_loadout] MCM score preview hooked")
	return true
end

patch_score_preview()
