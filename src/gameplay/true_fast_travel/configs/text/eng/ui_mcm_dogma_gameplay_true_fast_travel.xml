<string_table>
	<string id="ui_mcm_menu_dogma_gameplay">
		<text>Gameplay</text>
	</string>
	<string id="ui_mcm_menu_dogma_gameplay_true_fast_travel">
		<text>True Fast Travel</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_page_description">
		<text>MVP: right-click a discovered map POI to preview the nav path, then Travel here. Demo cam walks that path at 2x game speed with weapon HUD on. Press Space to cancel. Disable Fair Fast Travel / Limited Fast Travel if they conflict.</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_block_travel_when_unfit">
		<text>Block travel when unfit</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_block_travel_when_unfit_desc">
		<text>Refuse travel start when bleeding, badly wounded, heavily irradiated, or similarly unfit. Off keeps only hard blockers (can't walk, emission, hostiles nearby).</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_time_factor_travel">
		<text>Travel time scale</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_time_factor_travel_desc">
		<text>World time_factor and camera travel speed while traveling (1 = real-time, 10 = fastest).</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_time_factor_backslide">
		<text>Time speed during backslide</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_time_factor_backslide_desc">
		<text>Console time_factor while reversing along the path after a stop (0-1). Near 0 feels like a near-pause rewind.</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_cam_speed_mult">
		<text>Camera move speed multiplier</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_cam_speed_mult_desc">
		<text>Multiplies your sampled run/crouch speed for camera travel (1-3).</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_backslide_clear_m">
		<text>Backslide enemy clear distance</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_backslide_clear_m_desc">
		<text>Reverse along the path until hostiles are at least this far (0-100 m). 0 = off (skip distance reverse).</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_pause_on_stop">
		<text>Pause after cancelled / interrupted travel</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_pause_on_stop_desc">
		<text>After backslide from agro or Space cancel, pause the game once (same as Pause key).</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_pause_on_done">
		<text>Pause after successful arrival</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_pause_on_done_desc">
		<text>After arrival backslide/clear, pause the game once.</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_show_hud_during_travel">
		<text>Show HUD during travel</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_show_hud_during_travel_desc">
		<text>When off, travel prefers a cleaner view (hands/HUD hidden when the engine allows).</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_screen_msg_duration">
		<text>On-screen message duration</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_screen_msg_duration_desc">
		<text>Seconds for travel toasts (0-20). 0 = off.</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_path_preview">
		<text>Show path before travel</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_path_preview_desc">
		<text>Draw the planned route on the PDA map when you open a travel destination.</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_block_transition_in_combat">
		<text>Block Zone Transitions in Combat</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_block_transition_in_combat_desc">
		<text>Blocks level transitions while an alerted enemy is engaging you nearby.</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_companion_teleport_key">
		<text>Teleport companions key</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_true_fast_travel_companion_teleport_key_desc">
		<text>Press to pull companions to your position. Replaces Fair Fast Travel squad teleport and Quick Companion Teleport.</text>
	</string>
</string_table>
