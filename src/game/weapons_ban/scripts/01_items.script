local ITEMS_STRIP_ONLY = {
    "wpn_sil_apb", "apsabigo", "rakurs", "wpn_sil_hexagon", "susatov",
    "wpn_addon_grenade_launcher_monolit", "pritseldob",
    "wpn_addon_scope", "wpn_addon_scope_g43", "wpn_addon_scope_susat",
    "wpn_addon_silencer",
    "ammo_12x70_buck_self", "ammo_12x76_bull", "ammo_23_eco", "ammo_dyno",
}

local ITEMS_IGNORE = {
    "infiltrator_tactical_kit_off",
    "spectre_tactical_kit_off",
    "cleaning_kit_u",
}

local function flatten(by_tier)
    local out = {}
    for _, group in pairs(by_tier) do
        for i = 1, #group do
            out[#out + 1] = group[i]
        end
    end
    return out
end

local ITEMS = {
    sight = flatten(SIGHT_BY_TIER),
    kit = flatten(KIT_BY_TIER),
    suppressor = flatten(SUPPRESSOR_BY_TIER),
    gl = flatten(GL_BY_TIER),
    ammo = flatten(AMMO_BY_TIER),
    parts = flatten(PARTS_BY_TIER),
}

local STRIP = {}
local KIND = {}
local IGNORE = {}

for cat, ids in pairs(ITEMS) do
    for i = 1, #ids do
        local sec = ids[i]
        STRIP[sec] = true
        KIND[sec] = cat
    end
end
for i = 1, #ITEMS_STRIP_ONLY do
    STRIP[ITEMS_STRIP_ONLY[i]] = true
end
for i = 1, #ITEMS_IGNORE do
    IGNORE[ITEMS_IGNORE[i]] = true
end

_G.dogma_game_weapons_ban_lists = {
    BY_TIER = {
        sight = SIGHT_BY_TIER,
        kit = KIT_BY_TIER,
        suppressor = SUPPRESSOR_BY_TIER,
        gl = GL_BY_TIER,
        ammo = AMMO_BY_TIER,
        parts = PARTS_BY_TIER,
    },
    ITEMS = ITEMS,
    ITEMS_STRIP_ONLY = ITEMS_STRIP_ONLY,
    ITEMS_IGNORE = ITEMS_IGNORE,
    is_listed = function(sec)
        return sec and STRIP[sec] == true
    end,
    is_ignored = function(sec)
        return sec and IGNORE[sec] == true
    end,
    kind_of = function(sec)
        return sec and KIND[sec]
    end,
}
