--[[
	Witnessed hits/kills: write personal goodwill on same-faction stalkers.
	First seen hit parks general_goodwill at -40 (no longer friend).
	2.0 lethals or 2 murders slams -9000.
	Hit power comes from on_before_hit_after_calcs (npc_on_before_hit has power=0).
	Visibility poke only after the slam, using the scan's has_los flag.
	Steal (steal.script) slams through slam_npcs / track_agrod; sleep decays both.
]]

local CONFIG = _G.dogma_game_badwill_conf

local WITNESS_M = 40
local COMBAT_ALERT_M = 50
local PARK_GW = -40
local SLAM_GW = -9000
local DECAY_PERSONAL = 2000
local SAVE_KEY = "dogma_badwill"

local SKIP_COMM = {
	zombied = true,
	arena_enemy = true,
	trader = true,
}

local faction_memory = {}

local function log(msg)
	if dogma.log.logging() then
		dogma.log.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function enabled()
	return dogma.mcm.bool(CONFIG.MOD_ID, "enabled", CONFIG.DEFAULTS.enabled)
end

local function steal_enabled()
	return dogma.mcm.bool(CONFIG.MOD_ID, "steal_enabled", CONFIG.DEFAULTS.steal_enabled)
end

local try_is_player_side = function(obj)
	return obj:has_info("npcx_is_companion")
end

local function is_player_side(obj)
	if not obj then
		return false
	end
	if db.actor and obj:id() == db.actor:id() then
		return true
	end
	local ok, has = pcall(try_is_player_side, obj)
	return ok and has
end

local function is_story(npc)
	if not (npc and get_object_story_id) then
		return false
	end
	local ok, sid = pcall(get_object_story_id, npc:id())
	if not (ok and sid) then
		return false
	end
	if sid == 65535 or sid == 4294967295 or sid == -1 or sid == 0 or sid == "" then
		return false
	end
	return true
end

local function is_trader(npc)
	if not npc then
		return false
	end
	if clsid then
		local ok, c = pcall(npc.clsid, npc)
		if ok and (c == clsid.script_trader or c == clsid.trader) then
			return true
		end
	end
	return dogma.alife.community(npc) == "trader"
end

local function is_excluded(npc)
	if not (npc and IsStalker and IsStalker(npc)) then
		return true
	end
	local ok_alive, alive = pcall(npc.alive, npc)
	if not (ok_alive and alive) then
		return true
	end
	if is_player_side(npc) then
		return true
	end
	local comm = dogma.alife.community(npc)
	if comm and SKIP_COMM[comm] then
		return true
	end
	if is_trader(npc) or is_story(npc) then
		return true
	end
	return false
end

local function is_busy(npc)
	local ok, enemy = pcall(npc.best_enemy, npc)
	return ok and enemy ~= nil
end

local function entry(comm)
	local e = faction_memory[comm]
	if not e then
		e = { damage = 0, murders = 0, agrod_stalker_ids = {} }
		faction_memory[comm] = e
	end
	if not e.agrod_stalker_ids then
		e.agrod_stalker_ids = e.witness_ids or {}
		e.witness_ids = nil
	end
	return e
end

local function object_by_id(id)
	local st = db.storage and db.storage[id]
	return st and st.object
end

local function alife_exists(id)
	local sim = alife()
	if sim then
		return sim and sim:object(id) ~= nil
	end
end

local function prune_ids(ids)
	local keep = {}
	for id in pairs(ids or {}) do
		if object_by_id(id) or alife_exists(id) then
			keep[id] = true
		end
	end
	return keep
end

local function parse_id_set(src)
	local ids = {}
	if type(src) ~= "table" then
		return ids
	end
	for k, v in pairs(src) do
		local id = tonumber(k)
		if id and (v == true or v == 1) then
			ids[id] = true
		elseif type(v) == "number" then
			ids[v] = true
		end
	end
	return ids
end

local function track_agrod(comm, ids)
	if not comm or not ids then
		return
	end
	local e = entry(comm)
	if ids[1] ~= nil then
		for i = 1, #ids do
			local id = tonumber(ids[i])
			if id then
				e.agrod_stalker_ids[id] = true
			end
		end
		return
	end
	for k, v in pairs(ids) do
		local id = tonumber(k)
		if id and v then
			e.agrod_stalker_ids[id] = true
		elseif type(v) == "number" then
			e.agrod_stalker_ids[v] = true
		end
	end
end

local try_snap = function(npc)
	return npc:character_name()
end

local function snap(npc, actor)
	local tostr = tostring
	local name = "?"
	local _ok, _name = pcall(try_snap, npc)
	if _ok then name = _name end
	local pers, gen, rel = "?", "?", "?"
	local ok_p, p = pcall(npc.goodwill, npc, actor)
	if ok_p then
		pers = tostr(p)
	end
	local ok_g, g = pcall(npc.general_goodwill, npc, actor)
	if ok_g then
		gen = tostr(g)
	end
	local ok_r, r = pcall(npc.relation, npc, actor)
	if ok_r then
		rel = tostr(r)
	end
	return string.format(
		"%s#%s pers=%s gen=%s band=%s rel=%s",
		name,
		tostr(npc:id()),
		pers,
		gen,
		tostr(dogma.alife.npc_relation_band(npc, actor)),
		rel
	)
end

local function slam_npcs(npcs)
	local actor = db.actor
	if not (actor and npcs) then
		return
	end
	for i = 1, #npcs do
		local item = npcs[i]
		local npc = item
		local has_los = true
		if type(item) == "table" then
			npc = item.npc
			if item.has_los == false then
				has_los = false
			end
		end
		if npc and not is_excluded(npc) then
			log("  slam before " .. snap(npc, actor) .. " los=" .. tostring(has_los))
			pcall(npc.force_set_goodwill, npc, SLAM_GW, actor)
			if has_los and npc.make_object_visible_somewhen then
				pcall(npc.make_object_visible_somewhen, npc, actor)
			end
			local comm = dogma.alife.community(npc)
			if comm then
				track_agrod(comm, { npc:id() })
			end
			log("  slam after  " .. snap(npc, actor) .. " poke=" .. tostring(has_los))
		end
	end
end

-- One LOS/FOV pass. has_los = LOS to the player (no second ray later).
local function collect_witnesses(victim)
	local witnesses = {}
	local was_seen = false
	local pos = victim:position()
	local comm = dogma.alife.community(victim)
	local near = dogma.alife.get_stalkers_near_point(pos, WITNESS_M, comm)
	local actor = db.actor
	if not actor then
		return witnesses, false
	end
	for i = 1, #near do
		local npc = near[i]
		if not is_excluded(npc) then
			local saw_victim
			if dogma.alife.npc_is_in_combat(npc, COMBAT_ALERT_M) then
				saw_victim = dogma.alife.npc_has_los_to_stalker(npc, victim, true)
			else
				saw_victim = dogma.alife.npc_has_los_to_stalker(npc, victim, false)
			end
			if saw_victim then
				local has_los = dogma.alife.npc_has_los_to_stalker(npc, actor, false)
				witnesses[#witnesses + 1] = { npc = npc, id = npc:id(), has_los = has_los }
				if has_los then
					was_seen = true
				end
			end
		end
	end
	return witnesses, was_seen
end

local function remember(comm, damage, dead, witnesses)
	local e = entry(comm)
	e.damage = (tonumber(e.damage) or 0) + (tonumber(damage) or 0)
	if dead then
		e.murders = (tonumber(e.murders) or 0) + 1
	end
	local ids = {}
	for i = 1, #witnesses do
		ids[#ids + 1] = witnesses[i].id
	end
	track_agrod(comm, ids)
	return e
end

local function apply_writes(mem, witnesses)
	local actor = db.actor
	if not actor then
		return
	end
	local slam = (mem.murders or 0) >= 2 or (mem.damage or 0) >= 2
	local park = (mem.murders or 0) >= 1 or (mem.damage or 0) > 0
	for i = 1, #witnesses do
		local w = witnesses[i]
		local npc = w.npc
		if not (npc and not is_excluded(npc)) then
			log("  skip gone " .. tostring(w.id))
		elseif is_busy(npc) then
			log("  skip busy " .. snap(npc, actor) .. " los=" .. tostring(w.has_los))
		elseif slam then
			slam_npcs({ { npc = npc, has_los = w.has_los } })
		elseif park then
			log("  park before " .. snap(npc, actor) .. " los=" .. tostring(w.has_los))
			pcall(npc.force_set_goodwill, npc, PARK_GW, actor)
			log("  park after  " .. snap(npc, actor))
		end
	end
end

local function on_badwill(victim, damage, dead)
	local tostr = tostring
	if not (enabled() and victim and db.actor) then
		return
	end
	if not (IsStalker and IsStalker(victim)) then
		return
	end
	if is_player_side(victim) then
		return
	end
	local comm = dogma.alife.community(victim)
	if not comm or SKIP_COMM[comm] or is_trader(victim) or is_story(victim) then
		return
	end
	local witnesses, was_seen = collect_witnesses(victim)
	if not was_seen then
		log(string.format(
			"unseen %s dead=%s power=%.2f near=%d",
			tostr(comm),
			tostr(dead),
			tonumber(damage) or 0,
			#witnesses
		))
		return
	end
	local add_dmg = dead and 0 or (tonumber(damage) or 0)
	if add_dmg <= 0 and not dead then
		log("skip 0-power")
		return
	end
	local mem = remember(comm, add_dmg, dead, witnesses)
	local slam = (mem.murders or 0) >= 2 or (mem.damage or 0) >= 2
	log(string.format(
		"%s dead=%s lethals=+%.2f murders=%s dmg=%.2f witnesses=%d slam=%s",
		comm,
		tostr(dead),
		add_dmg,
		tostr(mem.murders),
		mem.damage,
		#witnesses,
		tostr(slam)
	))
	apply_writes(mem, witnesses)
end

-- Engine fills shit.power here. npc_on_before_hit is always 0 in this callback set.
local function on_before_hit_after_calcs(shit, target)
	if not (shit and target and shit.draftsman) then
		return
	end
	if not is_player_side(shit.draftsman) then
		return
	end
	local power = tonumber(shit.power) or 0
	log(string.format("after_calcs power=%.3f type=%s", power, tostring(shit.type)))
	on_badwill(target, power, false)
end

local function npc_on_death_callback(victim, killer)
	if not (victim and killer and is_player_side(killer)) then
		return
	end
	on_badwill(victim, 0, true)
end

local function has_agrod()
	for _, e in pairs(faction_memory) do
		if e.agrod_stalker_ids and next(e.agrod_stalker_ids) then
			return true
		end
	end
	return false
end

local function should_decay()
	return enabled() or steal_enabled() or has_agrod()
end

local function decay_entry(e)
	e.damage = math.max(0, (tonumber(e.damage) or 0) - 1)
	e.murders = math.max(0, (tonumber(e.murders) or 0) - 1)
	local actor = db.actor
	local keep = {}
	for id in pairs(e.agrod_stalker_ids or {}) do
		local npc = object_by_id(id)
		if npc then
			if actor then
				local ok, gw = pcall(npc.goodwill, npc, actor)
				if ok and type(gw) == "number" and gw < 0 then
					local next_gw = math.min(0, gw + DECAY_PERSONAL)
					pcall(npc.set_goodwill, npc, next_gw, actor)
				end
			end
			keep[id] = true
		elseif alife_exists(id) then
			keep[id] = true
		end
	end
	e.agrod_stalker_ids = keep
end

local function actor_on_sleep()
	if not should_decay() then
		return
	end
	for _, e in pairs(faction_memory) do
		decay_entry(e)
	end
	log("sleep decay")
end

local function on_save_state(m_data)
	local dump = {}
	for comm, e in pairs(faction_memory) do
		dump[comm] = {
			damage = tonumber(e.damage) or 0,
			murders = tonumber(e.murders) or 0,
			agrod_stalker_ids = prune_ids(e.agrod_stalker_ids),
		}
	end
	m_data[SAVE_KEY] = dump
end

local function on_load_state(m_data)
	local type_ = type
	faction_memory = {}
	local dump = m_data and m_data[SAVE_KEY]
	if type_(dump) ~= "table" then
		return
	end
	for comm, e in pairs(dump) do
		if type_(e) == "table" then
			local ids = parse_id_set(e.agrod_stalker_ids)
			if not next(ids) then
				ids = parse_id_set(e.witness_ids)
			end
			faction_memory[comm] = {
				damage = tonumber(e.damage) or 0,
				murders = tonumber(e.murders) or 0,
				agrod_stalker_ids = ids,
			}
		end
	end
end

CONFIG.is_excluded = is_excluded
CONFIG.is_player_side = is_player_side
CONFIG.is_story = is_story
CONFIG.track_agrod = track_agrod
CONFIG.slam_npcs = slam_npcs
CONFIG.SKIP_COMM = SKIP_COMM

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	RegisterScriptCallback("on_before_hit_after_calcs", on_before_hit_after_calcs)
	RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)
	RegisterScriptCallback("actor_on_sleep", actor_on_sleep)
	RegisterScriptCallback("save_state", on_save_state)
	RegisterScriptCallback("load_state", on_load_state)
	log("loaded")
end
