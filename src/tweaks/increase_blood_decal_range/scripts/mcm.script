-- tweaks/increase_blood_decal_range conf (info-only MCM; always on while installed)

_G.dogma_tweaks_increase_blood_decal_range_conf = {
	MOD_ID = "dogma/tweaks/increase_blood_decal_range",
	-- Engine blood wallmarks stop drawing past this distance (metres).
	MIN_DISTANCE = 50,
	WM_TTL = 600,
}

function on_mcm_load(options)
	dogma_mcm.append(options, "tweaks", "ui_mcm_menu_dogma_tweaks", {
		{
			id = "increase_blood_decal_range_description",
			type = "desc",
			text = "ui_mcm_dogma_tweaks_increase_blood_decal_range_page_description",
		},
	})
end
