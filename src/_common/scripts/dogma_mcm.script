--[[
	dogma_mcm.script - MCM-gather API (*mcm name).

	Same fields as dogma.* where MCM scripts need them:
	  dogma_mcm.mcm / .keys / .load / …

	MCM gather cannot load dogma.script — feature *mcm.script uses dogma_mcm.*.
	In-game scripts use dogma.* (dogma.script copies these fields).
]]

local M = __dogma_mcm

mcm = M
keys = __dogma_key_mirror_mcm
attach = M.attach
append = M.append
with_header = M.with_header
register_debug_page = M.register_debug_page

function on_mcm_load(options)
	M.register_debug_page(options)
end

--- Wire sys→mcm; optionally reset per-mod overlay state.
function load(mod_id)
	local sys_mod = rawget(_G, "__dogma_sys")
	local overlay_mod = rawget(_G, "__dogma_overlay")
	if not (sys_mod and mcm) then
		return getfenv(1)
	end
	sys_mod.set_deps(mcm)
	if mod_id then
		sys_mod.reset_mod(mod_id)
		if overlay_mod and overlay_mod.clear then
			overlay_mod.clear(mod_id)
		end
	end
	return getfenv(1)
end
