--[[
	Campfire heal (Body Health System + main HP).

	Each tick (+1 step, both pools capped at 80%):
	  1. Collect limbs with total HP < 80% (need temp).
	     If any — roll one and add temp. Done.
	  2. Else collect limbs with permanent HP < 80% (need perm conversion)
	     and main HP if below 80%. If any — roll one and heal. Done.
	  3. Else nothing left to heal.

	Disable other campfire heal mods to avoid stacking.
]]

local CONFIG = _G.dogma_player_campfire_conf
local DOGMA

local LIMBS = { "head", "torso", "rightarm", "leftarm", "rightleg", "leftleg" }
local RANGE_SQR = 10 * 10
local HEAL_CAP = 0.8
local MAIN_HEAL = 0.01 -- 1% main HP when that target is picked

local next_tick = 0

local function enabled()
	return DOGMA and DOGMA.mcm.bool(CONFIG.MOD_ID, "enabled")
end

local function interval_ms()
	local sec = DOGMA and DOGMA.mcm.number(CONFIG.MOD_ID, "interval", CONFIG.DEFAULTS.interval) or CONFIG.DEFAULTS.interval
	if sec < 1 then
		sec = 1
	end
	return sec * 1000
end

local function near_lit_campfire()
	if not (db.actor and bind_campfire and bind_campfire.campfires_all) then
		return false
	end
	local pos = db.actor:position()
	for _, binder in pairs(bind_campfire.campfires_all) do
		if binder and binder.campfire and binder.campfire:is_on() and binder.object then
			if pos:distance_to_sqr(binder.object:position()) <= RANGE_SQR then
				return true
			end
		end
	end
	return false
end

local function limb_cap(max)
	return math.floor(max * HEAL_CAP)
end

local function save_limb(bhs, key)
	utils_obj.save_var(db.actor, "health." .. key, bhs.health[key])
	utils_obj.save_var(db.actor, "timedhp." .. key, bhs.timedhp[key])
end

-- Note: hp/temp may be 0 (falsy) — only reject nil.
local function limb_needs_temp(bhs, key)
	local hp = bhs.health[key]
	local max = bhs.maxhp[key]
	local temp = bhs.timedhp[key]
	if hp == nil or max == nil or temp == nil or max <= 0 then
		return false
	end
	return hp < limb_cap(max)
end

local function limb_needs_perm(bhs, key)
	local hp = bhs.health[key]
	local max = bhs.maxhp[key]
	local temp = bhs.timedhp[key]
	if hp == nil or max == nil or temp == nil or max <= 0 then
		return false
	end
	local perm = hp - temp
	return temp > 0 and perm < limb_cap(max)
end

local function heal_limb_temp(bhs, key)
	local hp = bhs.health[key]
	local max = bhs.maxhp[key]
	local temp = bhs.timedhp[key]
	if hp == nil or max == nil or temp == nil or max <= 0 then
		return false
	end
	if hp >= limb_cap(max) then
		return false
	end
	bhs.health[key] = hp + 1
	bhs.timedhp[key] = temp + 1
	return true
end

local function heal_limb_perm(bhs, key)
	local hp = bhs.health[key]
	local max = bhs.maxhp[key]
	local temp = bhs.timedhp[key]
	if hp == nil or max == nil or temp == nil or max <= 0 then
		return false
	end
	local perm = hp - temp
	if temp <= 0 or perm >= limb_cap(max) then
		return false
	end
	bhs.timedhp[key] = temp - 1
	return true
end

local function main_needs_heal()
	return db.actor and db.actor.health < HEAL_CAP
end

local function heal_main()
	local actor = db.actor
	if not actor or actor.health >= HEAL_CAP then
		return false
	end
	local amt = math.min(MAIN_HEAL, HEAL_CAP - actor.health)
	if amt <= 0 then
		return false
	end
	actor:change_health(amt)
	return true
end

local function pick(targets)
	if #targets == 0 then
		return nil
	end
	return targets[math.random(#targets)]
end

local function tick_heal()
	local bhs = rawget(_G, "zzz_player_injuries")
	local has_bhs = bhs and bhs.health and bhs.timedhp and bhs.maxhp

	-- Phase 1: limbs with total HP < 80% → roll one, +1 temp.
	local temp_targets = {}
	if has_bhs then
		for i = 1, #LIMBS do
			local key = LIMBS[i]
			if limb_needs_temp(bhs, key) then
				temp_targets[#temp_targets + 1] = key
			end
		end
	end
	local temp_pick = pick(temp_targets)
	if temp_pick then
		if heal_limb_temp(bhs, temp_pick) then
			save_limb(bhs, temp_pick)
		end
		return
	end

	-- Phase 2: limbs with perm < 80% (and temp to convert) + main HP < 80%.
	local perm_targets = {}
	if has_bhs then
		for i = 1, #LIMBS do
			local key = LIMBS[i]
			if limb_needs_perm(bhs, key) then
				perm_targets[#perm_targets + 1] = { kind = "limb", key = key }
			end
		end
	end
	if main_needs_heal() then
		perm_targets[#perm_targets + 1] = { kind = "main" }
	end
	local perm_pick = pick(perm_targets)
	if not perm_pick then
		return
	end
	if perm_pick.kind == "main" then
		heal_main()
		return
	end
	if heal_limb_perm(bhs, perm_pick.key) then
		save_limb(bhs, perm_pick.key)
	end
end

local function actor_on_update()
	if not enabled() or not db.actor then
		return
	end
	local now = time_global()
	if now < next_tick then
		return
	end
	next_tick = now + interval_ms()
	if near_lit_campfire() then
		tick_heal()
	end
end

function on_game_start()
	DOGMA = dogma_common.load(CONFIG.MOD_ID)
	RegisterScriptCallback("actor_on_update", actor_on_update)
end
