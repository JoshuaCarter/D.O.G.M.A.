--[[
	DOGMA inventory actions — drop / disassemble / strip keybinds.

	Lives in common so Drop and Disassemble work without Stripping installed.
	Owns inventory key detection (press / dtap / hold + modifiers), hold-paint
	On_Hover, and drop/disassemble actions. Strip binds call _G.dogma_strip
	(no-op if Stripping is not loaded).

	MCM paths:
	  dogma/items/drop         — key_drop*, drop_safe_equipped
	  dogma/items/disassemble  — key_disa*, disa_safe_equipped
	  dogma/items/stripping    — key, key_all, key_* strip modifiers/modes
]]

local DROP_MOD = "dogma/items/drop"
local DISA_MOD = "dogma/items/disassemble"
local STRIP_MOD = "dogma/items/stripping"
local READY_MOD = "dogma/items/inv_actions"

local DOGMA
local CONFIG = {
	drop_safe_equipped = true,
	disa_safe_equipped = true,
	drop_disa_debug_log = false,
}

local MODE_DTAP = 1
local MODE_HOLD = 2

local ALLOWED_BAGS = {
	actor_bag = true,
	actor_equ = true,
	actor_belt = true,
	npc_bag = true,
	picker = true,
}

-- bind defs filled in on_option_change: { id, key, modifier, mode, kind, all_stacks }
local BINDS = {}

local dtap_last = {} -- [bind_id] = time_continual
local hold_state = {} -- [dik] = { bind, t0, fired }
local paint = {
	active = false,
	dik = nil,
	modifier = 0,
	kind = nil,
	all_stacks = false,
	last_bag = nil,
	last_idx = nil,
}
local in_action = false

local original_on_hover = nil
local hover_wrapper = nil
local patched_on_hover = false

local function log(msg)
	if not (DOGMA and DOGMA.dbg) then
		return
	end
	if CONFIG.drop_disa_debug_log then
		DOGMA.dbg.log(READY_MOD, tostring(msg))
	end
end

local function read_mode(mod_id, path)
	return math.floor(DOGMA.mcm.number(mod_id, path, 0) + 0.5)
end

local function make_bind(id, mod_id, key_path, mod_path, mode_path, kind, all_stacks)
	local key = DOGMA.mcm.key(mod_id, key_path)
	if not key then
		return nil
	end
	return {
		id = id,
		key = key,
		modifier = read_mode(mod_id, mod_path),
		mode = read_mode(mod_id, mode_path),
		kind = kind,
		all_stacks = all_stacks,
	}
end

local function on_option_change()
	CONFIG.drop_safe_equipped = DOGMA.mcm.bool(DROP_MOD, "drop_safe_equipped")
	CONFIG.disa_safe_equipped = DOGMA.mcm.bool(DISA_MOD, "disa_safe_equipped")
	CONFIG.drop_disa_debug_log = DOGMA.dbg.logging()

	BINDS = {}
	local function add(bind)
		if bind then
			BINDS[#BINDS + 1] = bind
		end
	end

	add(make_bind("drop", DROP_MOD, "key_drop", "key_drop_modifier", "key_drop_mode", "drop", false))
	add(make_bind("drop_all", DROP_MOD, "key_drop_all", "key_drop_all_modifier", "key_drop_all_mode", "drop", true))
	add(make_bind("disa", DISA_MOD, "key_disa", "key_disa_modifier", "key_disa_mode", "disa", false))
	add(make_bind("disa_all", DISA_MOD, "key_disa_all", "key_disa_all_modifier", "key_disa_all_mode", "disa", true))
	add(make_bind("strip", STRIP_MOD, "key", "key_modifier", "key_mode", "strip", false))
	add(make_bind("strip_all", STRIP_MOD, "key_all", "key_all_modifier", "key_all_mode", "strip", true))

	local function key_of(id)
		for i = 1, #BINDS do
			if BINDS[i].id == id then
				return tostring(BINDS[i].key)
			end
		end
		return "nil"
	end
	log(string.format(
		"on_option_change: drop=%s/%s disa=%s/%s strip=%s/%s",
		key_of("drop"), key_of("drop_all"),
		key_of("disa"), key_of("disa_all"),
		key_of("strip"), key_of("strip_all")
	))
end

local function mod_ok(modifier)
	if not (ui_mcm and ui_mcm.get_mod_key) then
		return true
	end
	return ui_mcm.get_mod_key(modifier)
end

local function hold_time_ms()
	if not ui_mcm then
		return 400
	end
	local dtaptime = ui_mcm.get("mcm/mcm_kb/mcm_kb_main/dtaptime2") or 250
	local presstime = ui_mcm.get("mcm/mcm_kb/mcm_kb_main/presstime") or 1.5
	return dtaptime * presstime
end

local function dtap_window_ms()
	if not ui_mcm then
		return 250
	end
	return ui_mcm.get("mcm/mcm_kb/mcm_kb_main/dtaptime2") or 250
end

local function inv_mode_ok(gui)
	local mode = gui and gui.mode
	return mode == "inventory" or mode == "loot"
end

local function yield_shift_in_loot(gui, dik)
	if not (gui and gui.mode == "loot") then
		return false
	end
	return dik == DIK_keys.DIK_LSHIFT or dik == DIK_keys.DIK_RSHIFT
end

local function bag_allowed(bag)
	return bag and ALLOWED_BAGS[bag]
end

local function get_hover(gui)
	gui = gui or (ui_inventory and ui_inventory.GUI)
	if not (gui and gui.hover) then
		return nil
	end
	local bag, idx = gui.hover.bag, gui.hover.idx
	if not (bag_allowed(bag) and idx) then
		return nil
	end
	local cc = gui.CC and gui.CC[bag]
	if not cc then
		return nil
	end
	local obj = cc:GetObj(idx)
	if not obj then
		return nil
	end
	return obj, bag, idx, gui
end

local function is_equipped(obj)
	if not (obj and db.actor and _G.SCANNED_SLOTS) then
		return false
	end
	local id = obj:id()
	local n = 0
	for _ in pairs(_G.SCANNED_SLOTS) do
		n = n + 1
	end
	for i = 0, n + 1 do
		local slot_obj = db.actor:item_in_slot(i)
		if slot_obj and slot_obj:id() == id then
			return true
		end
	end
	return false
end

local function is_quest(gui, obj, bag)
	if not (gui and gui.Cond_NotQuest and obj) then
		return false
	end
	return not gui:Cond_NotQuest(obj, bag)
end

local function cell_has_childs(gui, obj, bag)
	if not (gui and gui.Cond_Childs and obj and bag) then
		return false
	end
	local ok, has = pcall(function()
		return gui:Cond_Childs(obj, bag)
	end)
	return ok and has
end

local function each_stack_obj(gui, obj, bag, all_stacks, fn)
	if all_stacks and cell_has_childs(gui, obj, bag) then
		local cc = gui.CC[bag]
		local ci = cc and cc:GetCell_ID(obj:id())
		if ci and ci.childs then
			for id, _ in pairs(ci.childs) do
				local child = level.object_by_id(id)
				if child then
					fn(child)
				end
			end
		end
	end
	fn(obj)
end

local function do_drop_one(gui, obj, bag)
	if CONFIG.drop_safe_equipped and is_equipped(obj) then
		log("drop: skip equipped " .. obj:section())
		return
	end
	if is_quest(gui, obj, bag) then
		log("drop: skip quest " .. obj:section())
		return
	end
	if gui.Action_Drop then
		gui:Action_Drop(obj, bag)
	else
		db.actor:drop_item(obj)
	end
end

local function do_drop(gui, obj, bag, all_stacks)
	if all_stacks and cell_has_childs(gui, obj, bag) then
		local cc = gui.CC[bag]
		local ci = cc and cc:GetCell_ID(obj:id())
		if ci and ci.childs then
			for id, _ in pairs(ci.childs) do
				local child = level.object_by_id(id)
				if child then
					do_drop_one(gui, child, bag)
				end
			end
		end
		do_drop_one(gui, obj, bag)
		return
	end
	do_drop_one(gui, obj, bag)
end

local function do_disa_one(gui, obj)
	if CONFIG.disa_safe_equipped and is_equipped(obj) then
		log("disa: skip equipped " .. obj:section())
		return
	end
	if not (item_parts and item_parts.menu_disassembly and item_parts.func_disassembly) then
		return
	end
	if not item_parts.menu_disassembly(obj) then
		return
	end
	item_parts.func_disassembly(obj)
	if gui and gui.mode == "loot" and gui.On_Item_Update then
		gui:On_Item_Update()
	end
end

local function do_disa(gui, obj, bag, all_stacks)
	each_stack_obj(gui, obj, bag, all_stacks, function(o)
		do_disa_one(gui, o)
	end)
end

local function do_strip(gui, obj, bag, idx, all_stacks)
	local api = _G.dogma_strip
	if not (api and api.strip_hover) then
		log("strip: dogma_strip API missing")
		return
	end
	api.strip_hover(all_stacks, obj, bag, idx, gui)
end

local function run_action(kind, all_stacks, bag, idx, gui)
	gui = gui or (ui_inventory and ui_inventory.GUI)
	if not inv_mode_ok(gui) then
		return
	end
	if not bag_allowed(bag) then
		return
	end
	local cc = gui.CC and gui.CC[bag]
	local obj = cc and cc:GetObj(idx)
	if not obj then
		return
	end

	in_action = true
	paint.last_bag = bag
	paint.last_idx = idx

	log(string.format("act kind=%s all=%s bag=%s idx=%s sec=%s", tostring(kind), tostring(all_stacks), tostring(bag), tostring(idx), obj:section()))

	if kind == "drop" then
		do_drop(gui, obj, bag, all_stacks)
	elseif kind == "disa" then
		do_disa(gui, obj, bag, all_stacks)
	elseif kind == "strip" then
		do_strip(gui, obj, bag, idx, all_stacks)
	end

	in_action = false
end

local function fire_bind(bind)
	local obj, bag, idx, gui = get_hover()
	if not obj then
		log("fire: no hover for " .. bind.id)
		return
	end
	run_action(bind.kind, bind.all_stacks, bag, idx, gui)
end

local function arm_paint(bind)
	paint.active = true
	paint.dik = bind.key
	paint.modifier = bind.modifier
	paint.kind = bind.kind
	paint.all_stacks = bind.all_stacks
end

local function clear_paint()
	paint.active = false
	paint.dik = nil
	paint.kind = nil
	paint.last_bag = nil
	paint.last_idx = nil
end

local function fire_and_maybe_paint(bind)
	fire_bind(bind)
	if bind.mode == MODE_HOLD then
		arm_paint(bind)
	end
end

local function find_binds_for_dik(dik)
	local list = {}
	for i = 1, #BINDS do
		local b = BINDS[i]
		if b.key and b.key == dik then
			list[#list + 1] = b
		end
	end
	return list
end

local function on_key_pressed(dik, gui)
	if yield_shift_in_loot(gui, dik) then
		return
	end
	local matches = find_binds_for_dik(dik)
	if #matches == 0 then
		return
	end

	for i = 1, #matches do
		local bind = matches[i]
		if not mod_ok(bind.modifier) then
			log("mod mismatch for " .. bind.id)
		elseif bind.mode == MODE_HOLD then
			hold_state[dik] = { bind = bind, t0 = time_continual(), fired = false }
			log("hold armed " .. bind.id)
		elseif bind.mode == MODE_DTAP then
			local now = time_continual()
			local prev = dtap_last[bind.id]
			dtap_last[bind.id] = now
			if prev and (now - prev) <= dtap_window_ms() then
				dtap_last[bind.id] = nil
				fire_and_maybe_paint(bind)
			end
		else
			-- Simple press: fire on PRESSED
			fire_and_maybe_paint(bind)
		end
	end
end

local function on_key_released(dik)
	local hs = hold_state[dik]
	if hs then
		hold_state[dik] = nil
	end
	if paint.active and paint.dik == dik then
		clear_paint()
	end
end

local function hold_tick(gui)
	if not inv_mode_ok(gui) then
		return
	end
	local now = time_continual()
	local threshold = hold_time_ms()
	for dik, hs in pairs(hold_state) do
		if hs and not hs.fired then
			if key_state(dik) == 0 then
				hold_state[dik] = nil
			elseif mod_ok(hs.bind.modifier) and (now - hs.t0) >= threshold then
				hs.fired = true
				fire_and_maybe_paint(hs.bind)
			end
		elseif hs and hs.fired then
			if key_state(dik) == 0 or not mod_ok(hs.bind.modifier) then
				hold_state[dik] = nil
				if paint.active and paint.dik == dik then
					clear_paint()
				end
			end
		end
	end
end

local function call_base_hover(self, idx)
	if original_on_hover then
		return original_on_hover(self, idx)
	end
end

local function paint_on_hover(self, idx)
	if in_action then
		return call_base_hover(self, idx)
	end
	if not paint.active then
		return call_base_hover(self, idx)
	end
	if not idx then
		return call_base_hover(self, idx)
	end
	if key_state(paint.dik) == 0 or not mod_ok(paint.modifier) then
		clear_paint()
		return call_base_hover(self, idx)
	end

	local bag = self.ID
	if not bag_allowed(bag) then
		return call_base_hover(self, idx)
	end
	if paint.last_bag == bag and paint.last_idx == idx then
		return call_base_hover(self, idx)
	end

	local gui = ui_inventory and ui_inventory.GUI
	if not inv_mode_ok(gui) then
		return call_base_hover(self, idx)
	end

	run_action(paint.kind, paint.all_stacks, bag, idx, gui)
	return call_base_hover(self, idx)
end

local function reapply_on_hover_patch()
	local cc_class = utils_ui and utils_ui.UICellContainer
	if not (cc_class and cc_class.On_Hover) then
		return
	end
	if cc_class.On_Hover == hover_wrapper then
		return
	end
	original_on_hover = cc_class.On_Hover
	hover_wrapper = function(self, idx)
		return paint_on_hover(self, idx)
	end
	cc_class.On_Hover = hover_wrapper
	patched_on_hover = true
	log("On_Hover patched")
end

-- Parse-time OnKeyboard wrap (chains with later wrappers such as strip if any remain).
local original_on_keyboard = ui_inventory and ui_inventory.UIInventory and ui_inventory.UIInventory.OnKeyboard
if original_on_keyboard then
	function ui_inventory.UIInventory:OnKeyboard(dik, keyboard_action)
		local res = original_on_keyboard(self, dik, keyboard_action)
		if not (DOGMA and DOGMA.sys and DOGMA.sys.ready(READY_MOD, db, on_option_change)) then
			return res
		end
		if not inv_mode_ok(self) then
			return res
		end
		if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
			on_key_pressed(dik, self)
		elseif keyboard_action == ui_events.WINDOW_KEY_RELEASED then
			on_key_released(dik)
		end
		return res
	end
end

local original_on_update = ui_inventory and ui_inventory.UIInventory and ui_inventory.UIInventory.Update
if original_on_update then
	function ui_inventory.UIInventory:Update()
		original_on_update(self)
		if DOGMA and DOGMA.sys and DOGMA.sys.ready(READY_MOD, db, on_option_change) then
			hold_tick(self)
		end
	end
end

function on_game_start()
	DOGMA = dogma_common.load(READY_MOD)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_first_update", function()
		reapply_on_hover_patch()
	end)
	on_option_change()
	reapply_on_hover_patch()
	log(string.format("on_game_start: on_hover_patched=%s", tostring(patched_on_hover)))
end
