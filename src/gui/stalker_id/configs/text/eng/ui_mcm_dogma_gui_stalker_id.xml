<?xml version="1.0" encoding="windows-1251"?>
<string_table>
    <string id="ui_mcm_menu_dogma_gui">
        <text>GUI</text>
    </string>
    <string id="ui_mcm_menu_dogma_gui_stalker_id">
        <text>Stalker ID</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_page_description">
        <text>Name, rank, and faction icon when you look at a stalker.</text>
    </string>

    <string id="ui_mcm_dogma_gui_stalker_id_enabled">
        <text>Enabled</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_enabled_desc">
        <text>Off hides this ID. Uninstall to restore vanilla G.A.M.M.A. Identification UI.</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_show_always">
        <text>Show always</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_show_always_desc">
        <text>On: ID whenever you look at a stalker. Off: only when a Show when option below is met.</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_show_keybind">
        <text>Show when held</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_show_keybind_desc">
        <text>Hold to ID the stalker the camera aims at.</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_show_when_ads">
        <text>Show when ADS</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_show_when_rmb">
        <text>Show when holding RMB</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_show_when_rmb_desc">
        <text>Works without a weapon out.</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_show_when_free_zoom">
        <text>Show when free zoomed</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_show_when_binoc">
        <text>Show when binoculars</text>
    </string>

    <string id="ui_mcm_dogma_gui_stalker_id_dead_id">
        <text>Identify dead stalkers</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_zombie_id">
        <text>Identify zombies</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_name_id">
        <text>Show stalker names</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_goodwill_color">
        <text>Color names by goodwill</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_goodwill_color_desc">
        <text>Color living names by goodwill. Off: white names.</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_rank_id">
        <text>Show stalker rank</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_hide_on_death">
        <text>Hide ID when you die</text>
    </string>

    <string id="ui_mcm_dogma_gui_stalker_id_aim_section">
        <text>Detection</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_min_size_px">
        <text>Range: min size on screen (px/768)</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_min_size_px_desc">
        <text>Stalkers must appear this tall (out of 768 UI px) to ID. This means that ID range is visually consitent due to dynamically updating with zoom/fov.</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_circle_size">
        <text>Tollerance: detection circle size (% of 1.8m)</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_circle_size_desc">
        <text>Screen-center circle used to ID stalkers (more tollerant than raycast). 100% = same height as a standing NPC at their current distance.</text>
    </string>

    <string id="ui_mcm_dogma_gui_stalker_id_line_section">
        <text>Lead line</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_always_show_line">
        <text>Show line to friendly NPCs</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_always_show_line_binoc">
        <text>Show line to all in binoculars</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_line_a">
        <text>Line alpha (0-255)</text>
    </string>

    <string id="ui_mcm_dogma_gui_stalker_id_pos_section">
        <text>Layout</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_position">
        <text>Adjust layout</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_position_desc">
        <text>Opens sliders over the world so you can place the ID while looking at it.</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_position_need_game">
        <text>Load a game to edit the layout.</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_name_y">
        <text>Name Y</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_rank_y">
        <text>Rank Y</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_icon_y">
        <text>Icon Y</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_icon_scale">
        <text>Icon size (%)</text>
    </string>

    <string id="ui_mcm_dogma_gui_stalker_id_alpha_section">
        <text>Opacity</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_name_a">
        <text>Name alpha (0-255)</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_rank_a">
        <text>Rank alpha (0-255)</text>
    </string>
    <string id="ui_mcm_dogma_gui_stalker_id_icon_a">
        <text>Icon alpha (0-255)</text>
    </string>

    <string id="ui_dogma_gui_stalker_id_zombified">
        <text>Zombified</text>
    </string>
</string_table>
