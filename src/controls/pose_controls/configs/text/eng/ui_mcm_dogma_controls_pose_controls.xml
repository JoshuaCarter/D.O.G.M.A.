	<string id="ui_mcm_menu_dogma_controls_pose_controls">
		<text>Pose Controls</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_main_description">
		<text>Crouch crouches; Prone goes prone; Sprint sprints; Walk walks. Hold/Toggle sets crouch, walk, and sprint hold/toggle together. Pose keys are in Settings → Controls.</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_hold_toggle">
		<text>Hold / Toggle</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_hold_toggle_desc">
		<text>Sets crouch, walk, and sprint hold/toggle together. First load copies crouch's current setting, then forces all three to match.</text>
	</string>
	<string id="dogma_controls_pose_controls_hold_toggle_lst_hold">
		<text>Hold</text>
	</string>
	<string id="dogma_controls_pose_controls_hold_toggle_lst_toggle">
		<text>Toggle</text>
	</string>
</string_table>
