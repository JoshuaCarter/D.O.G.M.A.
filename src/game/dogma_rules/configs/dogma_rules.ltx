; D.O.G.M.A. Rules — lock + apply other mods' settings.
; Installed = active. Missing target mods are skipped (no extra MCM pages).
;
; [mcm]      MCM path = value          (true / false / number / string)
; [options]  axr [options] key = value
; [commands] id = console command      (run on game start)

[mcm]
; exo/debug = false

[options]
; video/player/blood_splash = false

[commands]
; 01 = cfg_load melancholy
