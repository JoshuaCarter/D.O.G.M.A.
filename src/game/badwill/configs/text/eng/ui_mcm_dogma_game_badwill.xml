<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_game">
		<text>Game</text>
	</string>
	<string id="ui_mcm_menu_dogma_game_badwill">
		<text>Badwill</text>
	</string>
	<string id="ui_mcm_dogma_game_badwill_page_description">
		<text>Same-faction stalkers turn on you if they see you hit their people, or if they catch you looting a claimed corpse. Sleep eases that personal score.</text>
	</string>
	<string id="ui_mcm_dogma_game_badwill_witness_header">
		<text>Hits and kills</text>
	</string>
	<string id="ui_mcm_dogma_game_badwill_enabled">
		<text>Enabled</text>
	</string>
	<string id="ui_mcm_dogma_game_badwill_enabled_desc">
		<text>Nearby same-faction stalkers remember hits and kills they see.</text>
	</string>
	<string id="ui_mcm_dogma_game_badwill_steal_header">
		<text>Steal</text>
	</string>
	<string id="ui_mcm_dogma_game_badwill_steal_enabled">
		<text>Steal claimed corpses</text>
	</string>
	<string id="ui_mcm_dogma_game_badwill_steal_enabled_desc">
		<text>When a body is claimed, the key below opens it. They turn hostile if they see you.</text>
	</string>
	<string id="ui_mcm_dogma_game_badwill_steal_key">
		<text>Steal</text>
	</string>
	<string id="ui_mcm_dogma_game_badwill_steal_key_desc">
		<text>Opens a claimed corpse. Unbound does nothing.</text>
	</string>
	<string id="ui_mcm_dogma_game_badwill_steal_timer">
		<text>Watch time (sec)</text>
	</string>
	<string id="ui_mcm_dogma_game_badwill_steal_timer_desc">
		<text>They keep watching this long after you close the loot window. Timer resets while it is open.</text>
	</string>
	<string id="ui_mcm_dogma_game_badwill_steal_nearby_faction">
		<text>Nearby faction</text>
	</string>
	<string id="ui_mcm_dogma_game_badwill_steal_nearby_faction_desc">
		<text>Also watch other stalkers of that faction within 100 m when you start stealing.</text>
	</string>
	<string id="st_dogma_badwill_steal_loot">
		<text>Steal loot (%s)</text>
	</string>
	<string id="st_dogma_badwill_steal_caught">
		<text>Caught you red handed, thief.</text>
	</string>
</string_table>
