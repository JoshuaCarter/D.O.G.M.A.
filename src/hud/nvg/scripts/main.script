--[[
	Stock item_device turns NV off in device_binder:net_destroy on level change.
	Torch light restores from the engine flag; NV is script-only and never restored.
	Stash wanted state on level change / save; re-apply on first update after spawn.
]]

local CONF = _G.dogma_hud_nvg_conf
local MOD_ID = CONF.MOD_ID
local DOGMA

local want_on = false

local function nv_is_on()
	return item_device and item_device.nv_state == true
end

local function stash()
	if not DOGMA.mcm.bool(MOD_ID, "enabled") then
		return
	end
	want_on = nv_is_on()
end

local function restore()
	if not DOGMA.mcm.bool(MOD_ID, "enabled") then
		return
	end
	if not want_on then
		return
	end
	want_on = false
	if not (db.actor and item_device and item_device.set_nightvision) then
		return
	end
	local torch = db.actor:item_in_slot(10)
	if not torch then
		return
	end
	-- FDDA only animates when play_animation was set by the keybind path.
	item_device.set_nightvision(torch:section(), true)
end

function on_game_start()
	DOGMA = dogma_common.load(MOD_ID)
	RegisterScriptCallback("on_level_changing", stash)
	RegisterScriptCallback("actor_on_first_update", restore)
	if USE_MARSHAL then
		RegisterScriptCallback("save_state", function(mdata)
			if DOGMA.mcm.bool(MOD_ID, "enabled") then
				mdata.dogma_hud_nvg_on = nv_is_on() or want_on
			end
		end)
		RegisterScriptCallback("load_state", function(mdata)
			want_on = mdata.dogma_hud_nvg_on == true
		end)
	end
end
