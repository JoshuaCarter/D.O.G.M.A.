<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_gameplay">
		<text>Gameplay</text>
	</string>
	<string id="ui_mcm_menu_dogma_gameplay_free_zoom">
		<text>Free Zoom</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_zoom_description">
		<text>Free zoom lets you zoom your view with the options below. No effect while ADS (ADS Zoom handles that). Cannot free zoom while sprinting or using items. Disable GAMMA/Kute/SlowVibe Free Zoom. Keybinds Free Zoom is blanked by DOGMA.</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_ads_description">
		<text>ADS zoom: FOV zoom (world FOV, cap 15; magnified scopes keep their own). Irons / Sights / Scopes set HUD only (caps 15 / 25 / 35; 0 = off). Free zoom clears on ADS; ADS clears when you leave ADS (including reload). Disable Adjustable Scope View. Blindside/3DSS ADS FOV scripts are blanked by DOGMA.</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_zoom_header">
		<text>Zoom</text>
	</string>
