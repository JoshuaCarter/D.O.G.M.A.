-- tweaks/fix_new_game_loadout_tooltips conf (info-only MCM; all fixes always on while installed)

_G.dogma_tweaks_fix_new_game_loadout_tooltips_conf = {
	MOD_ID = "dogma/tweaks/fix_new_game_loadout_tooltips",
}

function on_mcm_load(options)
	-- UINewGame may only exist after faction_select loads; re-assert hooks.
	if zzzz_dogma_tweaks_fix_new_game_loadout_tooltips_main
		and zzzz_dogma_tweaks_fix_new_game_loadout_tooltips_main.patch_new_game_ui
	then
		zzzz_dogma_tweaks_fix_new_game_loadout_tooltips_main.patch_new_game_ui()
	end

	dogma_mcm.append(options, "tweaks", "ui_mcm_menu_dogma_tweaks", {
		{
			id = "fix_new_game_loadout_tooltips_description",
			type = "desc",
			text = "ui_mcm_dogma_tweaks_fix_new_game_loadout_tooltips_page_description",
		},
	})
end

--[[
	Force-load main.script into the menu VM (root cause empirically proven,
	xray log 2026-07-31): scripts load lazily on first global reference, and
	axr_main's load-everything loop only runs from on_game_start(). Nothing
	references zzzz_dogma_tweaks_fix_new_game_loadout_tooltips_main before a game starts, so
	its main_menu_on_init registration would never execute in a fresh-launch
	menu VM - and the first New Game Loadout screen would render stock-Anomaly
	tooltips. MCM's gather_options() force-loads all *mcm.script files from
	main_menu:__init(), strictly before main_menu_on_init is sent, so this
	bare reference is enough to get main.script registered in time.
]]
local main = zzzz_dogma_tweaks_fix_new_game_loadout_tooltips_main
if main and main.patch_new_game_ui then
	main.patch_new_game_ui()
end
