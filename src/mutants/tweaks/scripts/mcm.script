function on_mcm_load(options)
	local CONFIG = _G.dogma_mutants_tweaks_conf
	dogma_mcm.attach(options, "mutants", "ui_mcm_menu_dogma_mutants", {
		id = "tweaks",
		sh = true,
		text = "ui_mcm_menu_dogma_mutants_tweaks",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_tweaks_page_description",
			},
			{
				id = "controller_tube_5s",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["controller_tube_5s"],
				hint = "dogma_tweaks_controller_tube_5s",
			},
		}),
	})
end
