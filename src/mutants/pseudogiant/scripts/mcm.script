-- dogma_mcm_banner:begin (managed by sync-dogma-common.sh)
local function dogma_mcm()
	return _G.dogma_mcm
end
-- dogma_mcm_banner:end

function on_mcm_load()
	local MCM = dogma_mcm()
	return {
		id = "giant_jump",
		text = "ui_mcm_menu_dogma_giant_jump",
		gr = {
			{
				id = "main",
				sh = true,
				text = "Main",
				gr = MCM.with_header({
					{
						id = "main_description",
						type = "desc",
						text = "ui_mcm_dogma_giant_jump_main_description",
					},
					{
						id = "enabled",
						type = "check",
						val = 1,
						def = true,
						hint = "dogma_giant_jump_enabled",
					},
				}),
			},
			{
				id = "development",
				sh = true,
				text = "ui_mcm_dogma_giant_jump_development_section",
				gr = MCM.with_header({
					{
						id = "debug_log",
						type = "check",
						val = 1,
						def = false,
						hint = "dogma_giant_jump_debug_log",
					},
				}),
			},
		},
	}, "dogma"
end
