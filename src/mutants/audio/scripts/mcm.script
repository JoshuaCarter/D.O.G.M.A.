function on_mcm_load(options)
	dogma_mcm.attach(options, "mutants", "ui_mcm_menu_dogma_mutants", {
		id = "audio",
		sh = true,
		text = "ui_mcm_menu_dogma_mutants_audio",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_audio_page_description",
			},
		}),
	})
end
