--[[
	Safe Atmos Visibility

	Overrides Atmospherics' visual_memory_manager so the engine hook
	cannot crash without Stealth. Sight is vanilla C++ math plus torch,
	guard/sniper 0.5, and unsilenced-shot spike.
]]

local CONFIG = _G.dogma_tweaks_safe_atmos_visibility_conf

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
end
