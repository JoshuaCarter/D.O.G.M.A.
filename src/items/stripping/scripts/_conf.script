-- items/stripping conf - shared loaded options for all strip scripts.

local defaults = {
	["block_companion_special_items"] = true,
	["intercept_disassemble"] = true,
	["keep_parts_with_weapon"] = true,
	["key"] = -1,
	["key_mode"] = 0,
	["key_modifier"] = 0,
}

_G.dogma_items_stripping_conf = {
	MOD_ID = "dogma/items/stripping",
	DEFAULTS = defaults,
	loaded = {
		intercept_disassemble = defaults["intercept_disassemble"],
		keep_parts_with_weapon = defaults["keep_parts_with_weapon"],
		block_special_items = defaults["block_companion_special_items"],
	},
}

function _G.dogma_items_stripping_conf:ensure_dogma()
	dogma.load(self.MOD_ID)
	return dogma
end
