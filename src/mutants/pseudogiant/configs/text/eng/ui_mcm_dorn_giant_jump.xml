<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dorn_giant_jump">
		<text>Dorn's Giant Jump</text>
	</string>
	<string id="ui_mcm_dorn_giant_jump_main_description">
		<text>A pseudogiant's ground slam only hits if you're still touching the ground when it lands. Jump the instant before impact and you take no damage.</text>
	</string>
	<string id="ui_mcm_dorn_giant_jump_enabled">
		<text>Enabled</text>
	</string>
	<string id="ui_mcm_dorn_giant_jump_enabled_desc">
		<text>Cancel pseudogiant ground slam damage to the player while airborne.</text>
	</string>
	<string id="ui_mcm_dorn_giant_jump_development_section">
		<text>Development</text>
	</string>
	<string id="ui_mcm_dorn_giant_jump_debug_log">
		<text>Enable debug logging</text>
	</string>
	<string id="ui_mcm_dorn_giant_jump_debug_log_desc">
		<text>Write dodge/hit decisions to the game log file.</text>
	</string>
</string_table>
