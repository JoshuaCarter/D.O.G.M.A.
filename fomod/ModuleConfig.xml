<!-- Hand-authored FOMOD wizard. Edit this file; packaging copies it as-is. -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
	<moduleName>D.O.G.M.A.</moduleName>
	<requiredInstallFiles>
		<folder source="common\gamedata" destination="gamedata" />
		<folder source="common\mo2" destination="mo2" />
	</requiredInstallFiles>
	<installSteps order="Explicit">
		<installStep name="Preset">
			<optionalFileGroups order="Explicit">
				<group name="Install preset" type="SelectExactlyOne">
					<plugins order="Explicit">
						<plugin name="Baseline">
							<description>Most features preselected. Weapons Ban is left off (traders still buy guns, ammo, and attachments).</description>
							<conditionFlags>
								<flag name="preset">baseline</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Recommended"/>
							</typeDescriptor>
						</plugin>
						<plugin name="Pick and choose">
							<description>Nothing preselected. Choose features on the next pages.</description>
							<conditionFlags>
								<flag name="preset">pick</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Optional"/>
							</typeDescriptor>
						</plugin>
						<plugin name="All">
							<description>Every listed feature preselected, including Weapons Ban.</description>
							<conditionFlags>
								<flag name="preset">all</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Optional"/>
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
		<installStep name="Weapons Ban">
			<optionalFileGroups order="Explicit">
				<group name="Core" type="SelectAny">
					<plugins order="Explicit">
						<plugin name="Weapons Ban">
							<description>Traders won't buy your guns, ammo, or attachments - you must find them in stashes and corpses. Ammo craft: 1 casing + 1 bullet per round; powder is round(vanilla/box) per round.</description>
							<files>
								<folder source="game_weapons_ban\gamedata" destination="gamedata" priority="0" />
							</files>
							<typeDescriptor>
								<dependencyType>
									<defaultType name="Optional"/>
									<patterns>
										<pattern>
											<dependencies>
												<flagDependency flag="preset" value="all"/>
											</dependencies>
											<type name="Recommended"/>
										</pattern>
									</patterns>
								</dependencyType>
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
				<group name="Recommended" type="SelectAny">
					<plugins order="Explicit">
						<plugin name="Sobre Loadouts">
							<description>New vanilla-like loadout options</description>
							<files>
								<folder source="tweaks_sobre_loadouts\gamedata" destination="gamedata" priority="0" />
							</files>
							<typeDescriptor>
								<dependencyType>
									<defaultType name="Optional"/>
									<patterns>
										<pattern>
											<dependencies>
												<flagDependency flag="preset" value="all"/>
											</dependencies>
											<type name="Recommended"/>
										</pattern>
										<pattern>
											<dependencies>
												<flagDependency flag="preset" value="baseline"/>
											</dependencies>
											<type name="Recommended"/>
										</pattern>
									</patterns>
								</dependencyType>
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
