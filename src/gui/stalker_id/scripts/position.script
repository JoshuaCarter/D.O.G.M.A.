-- Stalker ID -- in-game layout panel (right side, pos/size/alpha).

local CONFIG = _G.dogma_gui_stalker_id_conf

-- position.script can load before main. Never cache that table at file top.
local function main()
    return rawget(_G, "zzzz_dogma_gui_stalker_id_main")
end

local POS_MIN = 0
local POS_MAX = 768

local function read_int(key)
    return dogma.mcm.int(CONFIG.MOD_ID, key)
end

local function read_uint(key)
    return dogma.mcm.uint(CONFIG.MOD_ID, key)
end

local function write_num(key, value)
    if ui_mcm then
        ui_mcm.set(CONFIG.MOD_ID .. "/" .. key, value)
    end
    CONFIG.loaded[key] = value
    dogma.log.log(CONFIG.MOD_ID, key .. "=" .. tostring(value))
    local m = main()
    if m and m.refresh_layout then
        m.refresh_layout()
    end
end

local commands = {
    { name = "ui_mcm_dogma_gui_stalker_id_pos_section", kind = "hdr" },
    { name = "ui_mcm_dogma_gui_stalker_id_name_y", key = "name_y", kind = "int", min = POS_MIN, max = POS_MAX, step = 1 },
    { name = "ui_mcm_dogma_gui_stalker_id_rank_y", key = "rank_y", kind = "int", min = POS_MIN, max = POS_MAX, step = 1 },
    { name = "ui_mcm_dogma_gui_stalker_id_icon_y", key = "icon_y", kind = "int", min = POS_MIN, max = POS_MAX, step = 1 },
    { name = "ui_mcm_dogma_gui_stalker_id_icon_scale", key = "icon_scale", kind = "uint", min = 50, max = 150, step = 10 },
    { name = "ui_mcm_dogma_gui_stalker_id_alpha_section", kind = "hdr" },
    { name = "ui_mcm_dogma_gui_stalker_id_name_a", key = "name_a", kind = "uint", min = 0, max = 255, step = 1 },
    { name = "ui_mcm_dogma_gui_stalker_id_rank_a", key = "rank_a", kind = "uint", min = 0, max = 255, step = 1 },
    { name = "ui_mcm_dogma_gui_stalker_id_icon_a", key = "icon_a", kind = "uint", min = 0, max = 255, step = 1 },
    { name = "ui_mcm_dogma_gui_stalker_id_line_a", key = "line_a", kind = "uint", min = 0, max = 255, step = 1 },
}

GUI = nil

local function cmd_get(cmd)
    if cmd.kind == "uint" then
        return read_uint(cmd.key)
    end
    return read_int(cmd.key)
end

local function add_hdr(xml, scroll, cmd)
    local row = xml:InitStatic("panel:hdr_st", nil)
    xml:InitStatic("panel:hdr", row):TextControl()
        :SetText(game.translate_string(cmd.name))
    scroll:AddWindow(row, true)
    row:SetAutoDelete(true)
end

local function add_track(self, xml, cmd)
    local val = math.floor((cmd_get(cmd) or 0) + 0.5)
    local n = #self.track + 1

    local row = xml:InitStatic("panel:st", nil)
    xml:InitStatic("panel:cap", row):TextControl()
        :SetText(game.translate_string(cmd.name))

    self.track[n] = xml:InitTrackBar("panel:track", row)
    self.track[n]:SetStep(cmd.step)
    self.track[n]:SetOptFBounds(cmd.min, cmd.max)
    self.track[n]:SetFValue(val)

    self.value[n] = val
    self.cmd[n] = cmd
    self.num[n] = xml:InitTextWnd("panel:num", row)
    self.num[n]:SetText(tostring(val))

    self.scroll:AddWindow(row, true)
    row:SetAutoDelete(true)
end

class "SIDPositionPanel" (CUIScriptWnd)

function SIDPositionPanel:__init() super()
    self:InitControls()
    RegisterScriptCallback("actor_on_net_destroy", self)
end

function SIDPositionPanel:__finalize()
end

function SIDPositionPanel:actor_on_net_destroy()
    self:Close()
end

function SIDPositionPanel:InitControls()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)

    self.xml = CScriptXmlInit()
    local xml = self.xml
    xml:ParseFile("ui_dogma_stalker_id_layout.xml")

    self.dialog = xml:InitStatic("panel", self)
    xml:InitFrame("panel:frame", self.dialog)

    local cap = xml:InitStatic("panel:cap_main", self.dialog)
    cap:TextControl():SetText(game.translate_string("ui_mcm_dogma_gui_stalker_id_position"))

    self.scroll = xml:InitScrollView("panel:scroll", self.dialog)
    self.scroll:Clear()

    self.track = {}
    self.value = {}
    self.num = {}
    self.cmd = {}

    for i = 1, #commands do
        local cmd = commands[i]
        if cmd.kind == "hdr" then
            add_hdr(xml, self.scroll, cmd)
        else
            add_track(self, xml, cmd)
        end
    end
end

function SIDPositionPanel:Update()
    CUIScriptWnd.Update(self)

    for i = 1, #self.track do
        local ctrl = self.track[i]
        if ctrl:IsCursorOverWindow() then
            local val = math.floor(ctrl:GetFValue() + 0.5)
            if val ~= self.value[i] then
                self.value[i] = val
                write_num(self.cmd[i].key, val)
                self.num[i]:SetText(tostring(val))
                return
            end
        end
    end
end

function SIDPositionPanel:OnKeyboard(dik, keyboard_action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if res == false and keyboard_action == ui_events.WINDOW_KEY_PRESSED then
        if dik == DIK_keys.DIK_ESCAPE then
            self:Close()
        end
    end
    return res
end

function SIDPositionPanel:Close()
    self:HideDialog()
    self:Show(false)
    Unregister_UI("SIDPositionPanel")
    local m = main()
    if m then
        m.force_preview = false
    end
    GUI = nil
    dogma.log.log(CONFIG.MOD_ID, "layout panel closed")
end

function start(mcm_dialog)
    if not ui_mcm then
        return
    end

    local m = main()
    if not m then
        dogma.log.log(CONFIG.MOD_ID, "layout panel skipped (no main)")
        return
    end

    dogma.log.log(CONFIG.MOD_ID, "layout panel")
    if mcm_dialog then
        mcm_dialog:On_Cancel()
    end
    exec_console_cmd("main_menu off")

    if not GUI then
        GUI = SIDPositionPanel()
    end
    if GUI and not GUI:IsShown() then
        m.force_preview = true
        if m.show_preview then
            m.show_preview()
        end
        GUI:ShowDialog(true)
        Register_UI("SIDPositionPanel", "zzzz_dogma_gui_stalker_id_position")
    end
end
