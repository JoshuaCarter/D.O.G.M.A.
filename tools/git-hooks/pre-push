#!/usr/bin/env bash
# pre-push: catch appdata changes made after the last commit (CLI push path).
# Commit+Push in Cursor/VS Code often skips pre-push (--no-verify); pre-commit handles that.
# Install: bash tools/git-hooks/install.sh
# Skip:    DOGMA_NO_APPDATA_SYNC=1 git push …
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
case "$HOOK_DIR" in
	*/.git/hooks) ROOT="$(cd "$HOOK_DIR/../.." && pwd)" ;;
	*/tools/git-hooks) ROOT="$(cd "$HOOK_DIR/../.." && pwd)" ;;
	*) ROOT="$(cd "$HOOK_DIR/../.." && pwd)" ;;
esac

if [[ "${DOGMA_APPDATA_SYNC_PUSH:-}" == "1" ]]; then
	exit 0
fi

# shellcheck source=sync-appdata.sh
source "$HOOK_DIR/sync-appdata.sh"
sync_appdata "$ROOT" || exit 1

if git -C "$ROOT" diff --cached --quiet; then
	exit 0
fi

git -C "$ROOT" commit -m "$(cat <<'EOF'
sync appdata config

Snapshot Anomaly user.ltx and GAMMA axr_options.ltx before push.
EOF
)"

echo "pre-push: committed synced appdata/ — re-running push…"
export DOGMA_APPDATA_SYNC_PUSH=1
remote="${1:-}"
if [[ -n "$remote" ]]; then
	exec git -C "$ROOT" push "$remote"
fi
exec git -C "$ROOT" push
