local dp = kute_common

local function print(...)
    if not mcm_settings.dbug[1] then return end
    dp.print(...)
end
local getCharPos = dp.getCharPos
local toRad = dp.toRad
local lerp = dp.lerp
local nextTick = dp.nextTick
local clamp = dp.clamp
local concat = dp.concat
local compact = dp.compact
local getSummation = dp.getSummation

local PRESET_ORDER = {"very_small","small","mid","large"}
local SIZE_KEY = { very_small = "very_small_size", small = "small_size", mid = "mid_size", large = "large_size" }
local PRESET_KEY = { very_small = "very_small_preset", small = "small_preset", mid = "mid_preset", large = "large_preset" }
local STR_KEY = { very_small = "very_small_strength", small = "small_strength", mid = "mid_strength", large = "large_strength" }
local LERP_A, LERP_B, LERP_C = {}, {}, {}
local trim_data, trim_final = {}, {}
local editor_on = false
local cached_ray
local V_UP, V_DIR, V_CHECK, V_OFF, V_RAY, V_REF

local function trim_cmp(a, b)
    return (a and a[1] or 0) < (b and b[1] or 0)
end

local function ensure_scratch()
    if V_UP then
        return
    end
    V_UP = vector():set(0, 1, 0)
    V_DIR = vector()
    V_CHECK = vector()
    V_OFF = vector()
    V_RAY = vector()
    V_REF = vector()
end

local function indoor_check_pos(hit_pos, dir)
    ensure_scratch()
    V_CHECK:set(hit_pos)
    V_CHECK.y = V_CHECK.y - 0.5
    V_OFF:set(dir)
    V_OFF:mul(-0.5)
    V_CHECK:add(V_OFF)
    return V_CHECK
end

local function slot2(t, i, a, b)
    local s = t[i]
    if not s then
        t[i] = {a, b}
    else
        s[1] = a
        s[2] = b
    end
end

function isBlackListedMaterial(m)
    for i = 1,#material_black_list do
        if string.find(m,material_black_list[i]) then
            return true
        end
    end
    return false
end

function getSummationForLength(n)
    local s = 0
    for i = 1,n do
        s = s+lengthMultPerBouce[i]
    end
    return s
end

function TrimTableForLength(t, trimPercent)
    if #t < 4 then return t end
    local n = #t
    for i = 1, n do trim_data[i] = t[i] end
    for i = n + 1, #trim_data do trim_data[i] = nil end
    table.sort(trim_data, trim_cmp)
    local trimCount = math.floor(n * trimPercent)
    local j = 0
    for i = trimCount + 1, n - trimCount do
        j = j + 1
        trim_final[j] = trim_data[i]
    end
    for i = j + 1, #trim_final do trim_final[i] = nil end
    return trim_final
end
--------------------------
function actor_on_first_update(wpn,gun)
    cached_ray = nil
    exec_console_cmd("snd_efx " .. 1)
    exec_console_cmd("snd_efx_reverb_overwrite " .. 1)
    last_tick = time_global()
    current_score = 0
end

function on_option_change(mcm)
    editor_on = ui_mcm and ui_mcm.get("spatial_audio/sar_editor/enable_editor") or false
    if mcm then
        score_list = {}
        size_list = {}
        current_score_index = 0
        current_size_index = 0
    end
end

function getPreset(input)
    if type(input) == "table" then
        return input
    elseif type(input) == "string" then
        local preset = sar_reverb_preset.ReverbPresets[input]
        if not preset then
            printf("! PRESET "..input.." NOT FOUND, PLEASE TYPE THE PRESET NAME CORRECTLY, SWTICHED TO GENERIC PRESET INSTEAD")
            return getPreset("GENERIC")
        else
            return preset
        end
    end
end

local last_reverb_cache = {}
function loadReverb(preset)
    for i, v in pairs(getPreset(preset)) do
        if last_reverb_cache[i] ~= v then
            exec_console_cmd("snd_efx_reverb_overwrite_" .. i .. " " .. v)
            last_reverb_cache[i] = v
        end
    end
end

function lerpReverb(preset1,preset2,alpha,dest)
    dest = dest or LERP_A
    preset1 = getPreset(preset1)
    preset2 = getPreset(preset2)
    for i,v in pairs(preset1) do
        dest[i] = lerp(preset1[i],preset2[i],alpha)
    end
    return dest
end

function raycast(dir,length,fire_pos)
    ensure_scratch()
    local pos = fire_pos or getCharPos()
    if not cached_ray then
        cached_ray = demonized_geometry_ray.geometry_ray({
            ray_range = length,
            contact_range = length-0.1,
            flags = 2,
            ignore_object = db.actor,
            visualize = mcm_settings.ray_dbug[1]
        })
    else
        cached_ray.ray_range = length
        cached_ray.contact_range = length-0.1
        cached_ray.ray:set_range(length)
        cached_ray.visualize = mcm_settings.ray_dbug[1]
    end
    local result = cached_ray:get(V_RAY:set(pos), dir)

    -- This loop checks if the contact surface is a bush, and re-casts the ray just inside it if it is -- By Ujtan
    -- while result.in_contact and result.result.material_name and isBlackListedMaterial(result.result.material_name) do
    --  ray_args.ray_range = ray_args.ray_range - result.distance
    --  ray_args.contact_range = ray_args.contact_range - result.distance
    --  ray = demonized_geometry_ray.geometry_ray(ray_args)
    --  local new_pos = vector():set(result.position):add(vector():set(dir):mul(0.5))
    --  result = ray:get(new_pos, dir)
    -- end
    if result.in_contact and result.result.material_name and isBlackListedMaterial(result.result.material_name) then
        result.in_contact = false
    end
    return result
end

function RayForDetection(dir,length,max_bounce,fire_pos)
    local pos = fire_pos or getCharPos()
    local point = 0
    local bounced = 0
    for bounce = 1,max_bounce do
        local result = raycast(dir,length*lengthMultPerBouce[bounce]*mcm_settings.ray_length_mult[1],pos)
        if result.in_contact then
            -- check if ray hit position is indoor (fire a ray upward to see if it hit anything)
            local check_result = raycast(V_UP,70,indoor_check_pos(result.position,dir))
            if not check_result.in_contact then break end
            point = point+bounce
            bounced = bounced + 1
            local surface_normal = demonized_geometry_ray.get_surface_normal(pos,dir,nil,nil,result)
            if surface_normal then
                dir = V_REF:reflect(dir, surface_normal)
            else break end
            pos = result.position
        else
            break
        end
    end
    return point/getSummation(max_bounce)
end

function getScore()
    local dir = device().cam_dir:normalize()
    local horz = dir:getH() -- Range 0 2pi

    for i = 1,mcm_settings.ray_per_frame_mult[1] do
        current_score_index = (current_score_index % #score_ray_dir_configs) + 1

        local config = score_ray_dir_configs[current_score_index]
        ensure_scratch()
        V_DIR:setHP(horz + toRad(config[1]), toRad(config[2]))

        local point = RayForDetection(V_DIR:normalize(),config[3],mcm_settings.ray_bounce_count[1])

        slot2(score_list, current_score_index, point*config[4], config[4])
    end

    local scoreSum = 0
    local scoreMultSum = 0
    for i = 1,#score_list do
        scoreSum = scoreSum+score_list[i][1]
        scoreMultSum = scoreMultSum+score_list[i][2]
    end
    ------ process score ---------
    local raw_score = scoreSum/scoreMultSum

    if raw_score>mcm_settings.lower_threshold[1] then
        target_score = (raw_score-mcm_settings.lower_threshold[1])/(1-mcm_settings.lower_threshold[1])
        if target_score>mcm_settings.upper_threshold[1] then
            target_score = 1
        end
    else
        target_score = 0
    end
end

function RayForSizeCal(dir,length,max_bounce,fire_pos,dont_check)
    local pos = fire_pos or getCharPos()
    local total_length = 0
    local bounced = 0
    local point = 0
    for bounce = 1,max_bounce do
        local result = raycast(dir,length*lengthMultPerBouce[bounce]*mcm_settings.ray_length_mult[1],pos)
        if result.in_contact then
            -- check if ray hit position is indoor (fire a ray upward to see if it hit anything)
            local check_result = raycast(V_UP,70,indoor_check_pos(result.position,dir))
            if not check_result.in_contact then break end
            ----
            total_length = total_length+result.position:distance_to(getCharPos())*lengthMultPerBouce[bounce]
            bounced = bounced + 1
            point = point+bounce
            local surface_normal = demonized_geometry_ray.get_surface_normal(pos,dir,nil,nil,result)
            if surface_normal then
                dir = V_REF:reflect(dir, surface_normal)
            else break end
            pos = result.position
        else break end
    end
    return point/getSummation(max_bounce),(bounced == 0 and length) or total_length/getSummationForLength(bounced)
end

function getRoomSize()
    if target_score==0 then target_size = 0 return end

    local room_size_ray_count = 20
    for i = 1,mcm_settings.ray_per_frame_mult[1] do
        current_size_index = (current_size_index % room_size_ray_count) + 1
        ensure_scratch()
        V_DIR:setHP(math.pi*2*(current_size_index/room_size_ray_count), toRad(5))
        local point,length = RayForSizeCal(V_DIR:normalize(),180,mcm_settings.ray_bounce_count[1])

        slot2(size_list, current_size_index, length, point)
    end
    local lengthSum = 0
    local lengthMultSum = 0

    local trimmed_size_list = TrimTableForLength(size_list,0.1)
    for i = 1,#trimmed_size_list do
        if trimmed_size_list[i] then
            lengthSum = lengthSum+trimmed_size_list[i][1]*trimmed_size_list[i][2]
            lengthMultSum = lengthMultSum+trimmed_size_list[i][2]
        end
    end
    if lengthMultSum ~= 0 then
        target_size = lengthSum/lengthMultSum
    else
        target_size = 0
    end
end

local apply_frame = false

function actor_on_update(_,delta)
    if not mcm_settings.enable[1] or editor_on then return end

    --- per 2 frame dectection
    if not apply_frame then
        getScore()
        getRoomSize()
    end

    -- dectection interpolation --------------- every frame
    if (target_score-current_score)<0 and current_score<0.25 then
        current_score = 0
    elseif (target_score-current_score)>0 and current_score>0.9 then
        current_score = 1
    else
        current_score = current_score+(target_score-current_score)*0.98*(delta/mcm_settings.interpolation_interval[1])
    end

    current_size = current_size+(target_size-current_size)*0.98*(delta/mcm_settings.size_interpolation_interval[1])

    -- apply effect ----------------------- per 2 frame
    if mcm_settings.ray_dbug[1] then return end
    if apply_frame then
        for i = 0,#PRESET_ORDER do
            local type = (i == 0 and PRESET_ORDER[1]) or PRESET_ORDER[i]
            local next_type = (i<#PRESET_ORDER and PRESET_ORDER[i+1]) or PRESET_ORDER[#PRESET_ORDER]
            -- fucking hell
            if current_size < mcm_settings[SIZE_KEY[next_type]][1] then
                local reverb = lerpReverb("NO_REVERB",mcm_settings[PRESET_KEY[type]][1],mcm_settings[STR_KEY[type]][1],LERP_A)
                local next_reverb = lerpReverb("NO_REVERB",mcm_settings[PRESET_KEY[next_type]][1],mcm_settings[STR_KEY[next_type]][1],LERP_B)

                local size_delta = (type == next_type and 1) or (current_size-mcm_settings[SIZE_KEY[type]][1])/(mcm_settings[SIZE_KEY[next_type]][1]-mcm_settings[SIZE_KEY[type]][1])

                local final_reverb = lerpReverb(reverb,next_reverb,size_delta,LERP_C)

                loadReverb(lerpReverb(mcm_settings.outdoor_preset[1],final_reverb,current_score,LERP_A))

                break
            end
        end
    end
    apply_frame = not apply_frame
    if time_global()-last_tick<750 then return end

    print("score: "..tostring(current_score))
    print(current_size)
    ------------------
    last_tick = time_global()
end

-- ray debug -------------------
function actor_on_weapon_before_fire()
    if not mcm_settings.enable[1] then return end
    if not mcm_settings.ray_dbug[1] then return end
    --------------------
    getScore()
    getRoomSize()
    print("score: "..tostring(target_score))
    print(target_size)
    --------------------
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update",actor_on_first_update)
    RegisterScriptCallback("actor_on_update",actor_on_update)
    RegisterScriptCallback("actor_on_weapon_before_fire",actor_on_weapon_before_fire)
    RegisterScriptCallback("on_option_change",on_option_change)
    on_option_change(true)
end