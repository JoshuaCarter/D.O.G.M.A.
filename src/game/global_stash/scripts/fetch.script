--[[
    Fetch stash count from idx. Never plant. Never iterate_inventory_box.

    PDA: get_cached_fetch_count_text / live_stash_count walks
    workshop_stashes + player_created_stashes GOs per task.
    We stay off those lists. Add our idx_n into the stash line.
]]

local MOD_ID = "dogma/game/global_stash"

local orig_news
local orig_cached
local orig_sort
local orig_sort_for
local logged = {}

local function log(msg, color)
    dogma.log.log(MOD_ID, tostring(msg), color)
end

local function get_api()
    return _G.dogma_game_global_stash
end

local function our_n(section)
    local api = get_api()
    if not (api and api.stash_count) then
        return 0
    end
    return api.stash_count(section)
end

local function stash_color(n, amount)
    if n == 0 then
        return utils_xml.get_color("d_red")
    end
    if amount and n >= amount then
        return utils_xml.get_color("pda_green")
    end
    return utils_xml.get_color("pda_yellow")
end

local function loc_name()
    local key = level.name()
    if not key then
        return nil
    end
    local t = game.translate_string(key)
    if t and t ~= key then
        return t
    end
    return key
end

local function colored_x(n, amount)
    return stash_color(n, amount) .. "x" .. tostring(n) .. utils_xml.get_color("pda_white")
end

local function loc_entry(name, n, amount)
    return utils_xml.get_color("pda_white") .. name .. " " .. colored_x(n, amount)
end

local function skip_color(s, i)
    local a, b = string.find(s, "^%%c%[%d+,%d+,%d+,%d+%]", i)
    if a then
        return b + 1
    end
    a, b = string.find(s, "^%[%d+,%d+,%d+,%d+%]", i)
    if a then
        return b + 1
    end
    a, b = string.find(s, "^%[%d+,%d+,%d+%]", i)
    if a then
        return b + 1
    end
    return i
end

local function find_list_close(s, open_i)
    local i = open_i + 1
    local n = #s
    while i <= n do
        local ni = skip_color(s, i)
        if ni ~= i then
            i = ni
        elseif string.sub(s, i, i) == "]" then
            return i
        else
            i = i + 1
        end
    end
end

local function with_our_stashes(text, section, amount)
    local sfind = string.find
    local ssub = string.sub
    local extra = our_n(section)
    if extra <= 0 or not text then
        return text
    end
    if not logged.suffix then
        logged.suffix = true
        log("fetch stash sec=" .. tostring(section) .. " extra=" .. tostring(extra) .. " need=" .. tostring(amount))
    end
    local clr_txt = utils_xml.get_color("pda_white")
    local label = game.translate_string("st_inv_cache_stashes")
    local pos = sfind(text, label, 1, true)
    if not pos then
        local i
        local j
        local num
        local from = 1
        while true do
            local a, b, n = sfind(text, "x(%d+)", from)
            if not a then
                break
            end
            i, j, num = a, b, n
            from = b + 1
        end
        if not i then
            return text .. "\\n" .. clr_txt .. label .. " " .. colored_x(extra, amount)
        end
        local n = (tonumber(num) or 0) + extra
        return ssub(text, 1, i - 1) .. colored_x(n, amount) .. ssub(text, j + 1)
    end
    local i, j, num = sfind(text, "x(%d+)", pos + #label)
    local name = loc_name()
    if not i then
        local line = clr_txt .. label .. " " .. colored_x(extra, amount)
        if name then
            line = line .. ": [" .. loc_entry(name, extra, amount) .. clr_txt .. "]"
        end
        return text .. "\\n" .. line
    end
    local total = (tonumber(num) or 0) + extra
    local out = ssub(text, 1, i - 1) .. colored_x(total, amount) .. ssub(text, j + 1)
    if not name then
        return out
    end
    local list_mark = sfind(out, ": [", pos, true)
    if not list_mark then
        return out .. ": [" .. loc_entry(name, extra, amount) .. clr_txt .. "]"
    end
    local open_i = list_mark + 2
    local close_i = find_list_close(out, open_i)
    if not close_i then
        return out
    end
    local inside = ssub(out, open_i + 1, close_i - 1)
    local name_pos = sfind(inside, name, 1, true)
    if name_pos then
        local xi, xj, xnum = sfind(inside, "x(%d+)", name_pos + #name)
        if xi then
            local loc_n = (tonumber(xnum) or 0) + extra
            inside = ssub(inside, 1, xi - 1) .. colored_x(loc_n, amount) .. ssub(inside, xj + 1)
        end
    elseif inside == "" then
        inside = loc_entry(name, extra, amount)
    else
        inside = loc_entry(name, extra, amount) .. clr_txt .. ", " .. inside
    end
    return ssub(out, 1, open_i) .. inside .. ssub(out, close_i)
end

local function bump_prio(prio, section, amount)
    local n = our_n(section)
    if n <= 0 or not amount then
        return prio
    end
    if n >= amount then
        if prio > 2 then
            return 2
        end
        return prio
    end
    if prio > 3 then
        return 3
    end
    return prio
end

local function wrapped_news(text, section, amount, task_id)
    if not logged.news then
        logged.news = true
        log("fetch count via news")
    end
    local t = orig_news(text, section, amount, task_id)
    if orig_cached then
        return t
    end
    return with_our_stashes(t, section, amount)
end

local function wrapped_cached(a, b, c, d)
    if not logged.cached then
        logged.cached = true
        log("fetch count via cached")
    end
    local t = orig_cached(a, b, c, d)
    if c then
        return with_our_stashes(t, b, c)
    end
    return with_our_stashes(t, a, b)
end

local function wrapped_sort(task_id, npc_id)
    local prio = orig_sort(task_id, npc_id)
    local cache = a_ui_pda_inventory_cache
    local params = cache and cache.get_fetch_task_params and cache.get_fetch_task_params(task_id, npc_id)
    if params then
        return bump_prio(prio, params.section, params.amount)
    end
    return prio
end

local function wrapped_sort_for(section, amount)
    return bump_prio(orig_sort_for(section, amount), section, amount)
end

local function hook_news()
    local z = z_fetch_shows_count
    if not (z and z.extend_news_text) then
        log("fetch news skip")
        return false
    end
    if z.extend_news_text == wrapped_news then
        return true
    end
    orig_news = z.extend_news_text
    z.extend_news_text = wrapped_news
    log("fetch news hooked")
    return true
end

local function hook_cached()
    local a = a_ui_pda_inventory_cache
    if not (a and a.get_cached_fetch_count_text) then
        log("fetch cached skip")
        return false
    end
    if a.get_cached_fetch_count_text == wrapped_cached then
        return true
    end
    orig_cached = a.get_cached_fetch_count_text
    a.get_cached_fetch_count_text = wrapped_cached
    log("fetch cached hooked")
    return true
end

local function hook_sort()
    local a = a_ui_pda_inventory_cache
    if not (a and a.get_fetch_task_sort_priority) then
        log("fetch sort skip")
        return false
    end
    if a.get_fetch_task_sort_priority == wrapped_sort then
        return true
    end
    orig_sort = a.get_fetch_task_sort_priority
    a.get_fetch_task_sort_priority = wrapped_sort
    if a.get_fetch_sort_priority_for then
        orig_sort_for = a.get_fetch_sort_priority_for
        a.get_fetch_sort_priority_for = wrapped_sort_for
    end
    log("fetch sort hooked")
    return true
end

local function hook_all()
    hook_news()
    hook_cached()
    hook_sort()
    local api = get_api()
    if api and api.unregister_fetch then
        api.unregister_fetch()
    end
    return true
end

function on_game_start()
    RegisterScriptCallback("on_game_load", hook_all)
    CreateTimeEvent("dogma_game_global_stash", "fetch_late", 0.2, hook_all)
    log("fetch ready")
end
