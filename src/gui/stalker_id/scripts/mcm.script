-- gui/stalker_id conf

local defaults = {
	["dead_id"] = true,
	["name_id"] = true,
	["rank_id"] = true,
	["name_y"] = 20,
	["rank_y"] = 32,
	["icon_y"] = 60,
	["name_a"] = 100,
