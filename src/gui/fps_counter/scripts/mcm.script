                    },
                    {
                        id = "vertical_spacing",
                        type = "track",
                        val = 2,
                        min = 0,
                        max = 10,
                        step = 1,
                        def = CONFIG.DEFAULTS.vertical_spacing,
                        hint = "dogma_gui_fps_counter_vertical_spacing",
                    },
                    { id = "line_pos", type = "line" },
                    {
                        id = "pos_anchor",
                        type = "list",
                        val = 2,
