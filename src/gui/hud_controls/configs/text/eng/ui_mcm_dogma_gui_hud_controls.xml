<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_gui">
		<text>GUI</text>
	</string>
	<string id="ui_mcm_menu_dogma_gui_hud_controls">
		<text>HUD Controls</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_page_description">
		<text>Only show HUD elements (BHS, minimap, status icons) until condition is met or key held.</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_enabled">
		<text>Enabled</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_enabled_desc">
		<text>Off: body, icons, minimap, and companions stay visible.</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_bhs_section">
		<text>BHS</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_hide_body">
		<text>Hide BHS by default (body, limbs, psy, rads, stam)</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_key_bhs">
		<text>Show BHS</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_always_show">
		<text>Always show BHS when</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_always_show_desc">
		<text>Keep BHS up while any condition below is true. 0 on a slider turns that condition off.</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_hp_show_below_pct">
		<text>Show BHS when body health below (%)</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_limb_show_below_pct">
		<text>Show BHS when limb health below (%)</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_stam_show_below_pct">
		<text>Show just stamina when below (%)</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_psy_show_below_pct">
		<text>Show BHS when psy health below (%)</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_rad_show_above_pct">
		<text>Show BHS when radiation above (%)</text>
	</string>
	<string id="ui_mcm_dogma_gui_hud_controls_show_when_temp_health">
