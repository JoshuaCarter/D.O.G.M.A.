--[[
	DOGMA debug helpers (namespace module, no globals).

	Private impl; features use dogma.dbg (wired by dogma.script).

	overlay(source, order, msg, color) - on-screen HUD slots (colored).
	log(mod_id, msg)                   - plain printf to the game log file only.
	tag(mod_id)                        - "dogma/cat/feat" → "dogma_cat_feat"
	logging() / overlay_enabled()      - global MCM toggles from DOGMA → Debug.

	Log lines are always prefixed [dogma_{cat}_{feat}] (slashes → underscores).
]]

local DEBUG_MOD = "dogma/debug"

-- MOD_ID "dogma/cat/feat" → log/HUD tag "dogma_cat_feat"
function tag(mod_id)
	return tostring(mod_id or "dogma"):gsub("/", "_")
end

local HUD_STATIC = "dogma_debug_overlay_text"
local FALLBACK_STATIC = "debug_info"
local PANEL_STATIC = "dogma_debug_overlay_panel"
local text_static = HUD_STATIC
local PANEL_TEX = "ui_inGame2_white_rect"
local ORIGIN_X = 10
local ORIGIN_Y = 50
local PANEL_PAD = 8
local PANEL_W = 200
local LINE_H = 16

local COLORS = {
	white       = "%c[255,255,255,255]",
	light_gray  = "%c[255,210,210,210]",
	gray        = "%c[255,160,160,160]",
	dark_gray   = "%c[255,96,96,96]",
	black       = "%c[255,16,16,16]",
	light_red   = "%c[255,255,140,140]",
	red         = "%c[255,255,64,64]",
	dark_red    = "%c[255,170,32,32]",
	light_green = "%c[255,150,255,150]",
	green       = "%c[255,96,224,96]",
	dark_green  = "%c[255,40,150,40]",
	light_blue  = "%c[255,150,190,255]",
	blue        = "%c[255,96,160,255]",
	dark_blue   = "%c[255,48,90,200]",
	light_yellow= "%c[255,255,240,150]",
	yellow      = "%c[255,255,224,64]",
	dark_yellow = "%c[255,200,170,32]",
	light_cyan  = "%c[255,170,240,255]",
	cyan        = "%c[255,96,224,255]",
	dark_cyan   = "%c[255,40,160,180]",
	light_orange= "%c[255,255,200,130]",
	orange      = "%c[255,255,160,48]",
	dark_orange = "%c[255,200,110,24]",
	light_purple= "%c[255,210,170,255]",
	purple      = "%c[255,170,96,255]",
	dark_purple = "%c[255,110,48,170]",
	light_pink  = "%c[255,255,190,225]",
	pink        = "%c[255,255,128,200]",
	dark_pink   = "%c[255,200,72,140]",
	magenta     = "%c[255,255,64,255]",
	teal        = "%c[255,32,170,160]",
	lime        = "%c[255,170,255,64]",
	brown       = "%c[255,150,100,60]",
}

local sources = {}

local function resolve_color(color)
	if color == nil then
		return COLORS.white
	end
	if type(color) == "string" and color:sub(1, 3) == "%c[" then
		return color
	end
	return COLORS[color] or COLORS.white
end

local function get_source(source)
	source = source or "default"
	if not sources[source] then
		sources[source] = { slots = {} }
	end
	return sources[source]
end

local function any_overlay_content()
	for _, s in pairs(sources) do
		if next(s.slots) then
			return true
		end
	end
	return false
end

local function hud_wnd(name, create)
	local hud = get_hud()
	if not hud then
		return nil
	end
	local cs = hud:GetCustomStatic(name)
	if not cs and create then
		hud:AddCustomStatic(name, true)
		cs = hud:GetCustomStatic(name)
	end
	return cs and cs:wnd()
end

local function remove_static(name)
	local hud = get_hud()
	if hud and hud:GetCustomStatic(name) then
		hud:RemoveCustomStatic(name)
	end
end

local function try_add(hud, name)
	local cs = hud:GetCustomStatic(name)
	if cs then
		return cs
	end
	pcall(function()
		hud:AddCustomStatic(name, true)
	end)
	return hud:GetCustomStatic(name)
end

local function get_static()
	local hud = get_hud()
	if not hud then
		return nil
	end
	-- Panel needs DXML inject. Skip if the name is not in ui_custom_msgs.
	try_add(hud, PANEL_STATIC)
	local cs = try_add(hud, HUD_STATIC)
	if cs then
		text_static = HUD_STATIC
		return cs
	end
	cs = try_add(hud, FALLBACK_STATIC)
	if cs then
		text_static = FALLBACK_STATIC
	end
	return cs
end

local function clear_overlay()
	remove_static(HUD_STATIC)
	remove_static(PANEL_STATIC)
	if text_static == FALLBACK_STATIC then
		remove_static(FALLBACK_STATIC)
	end
end

local function show_panel(x, y, w, h)
	local wnd = hud_wnd(PANEL_STATIC, true)
	if not wnd then
		return
	end
	wnd:SetWndPos(vector2():set(x, y))
	wnd:SetWndSize(vector2():set(w, h))
	pcall(function()
		wnd:InitTexture(PANEL_TEX)
	end)
	pcall(function()
		wnd:SetStretchTexture(true)
	end)
	pcall(function()
		wnd:SetTextureColor(GetARGB(76, 8, 8, 10))
	end)
end

local function render()
	if not overlay_enabled() or not any_overlay_content() then
		clear_overlay()
		return
	end

	local cs = get_static()
	if not cs then
		return
	end
	local wnd = cs:wnd()
	if not wnd then
		return
	end
	local text_x = ORIGIN_X + PANEL_PAD
	local text_y = ORIGIN_Y + PANEL_PAD
	local text_w = PANEL_W - PANEL_PAD * 2
	wnd:SetWndPos(vector2():set(text_x, text_y))
	pcall(function()
		wnd:SetWndSize(vector2():set(text_w, 768))
	end)
	pcall(function()
		wnd:SetTextComplexMode(true)
	end)
	local font = GetFontLetterica16Russian and GetFontLetterica16Russian()
	if font then
		pcall(function()
			wnd:SetFont(font)
		end)
	end

	local names = {}
	for name, s in pairs(sources) do
		if next(s.slots) then
			names[#names + 1] = name
		end
	end
	table.sort(names)

	local lines = {}
	for _, name in ipairs(names) do
		local slots = sources[name].slots

		if #lines > 0 then
			lines[#lines + 1] = ""
		end
		lines[#lines + 1] = COLORS.white .. "[" .. tag(name) .. "]"

		local max_order = -1
		for order in pairs(slots) do
			if order > max_order then
				max_order = order
			end
		end
		for order = 0, max_order do
			local slot = slots[order]
			if slot then
				lines[#lines + 1] = resolve_color(slot.color) .. slot.msg
			else
				lines[#lines + 1] = ""
			end
		end
	end

	if #lines == 0 then
		clear_overlay()
		return
	end

	-- Same as death report: estimate, draw panel, set text, measure, resize panel.
	local est_h = math.floor(#lines * LINE_H + 0.5)
	show_panel(ORIGIN_X, ORIGIN_Y, PANEL_W, est_h + PANEL_PAD * 2)
	local tc = wnd:TextControl()
	if tc then
		pcall(function()
			tc:SetTextComplexMode(true)
		end)
		if font then
			pcall(function()
				tc:SetFont(font)
			end)
		end
		tc:SetText(table.concat(lines, "\\n"))
	end
	pcall(function()
		wnd:AdjustHeightToText()
	end)
	local text_h = tonumber(wnd.GetHeight and wnd:GetHeight()) or 0
	if text_h >= 1 then
		local pw = hud_wnd(PANEL_STATIC)
		if pw then
			pw:SetWndSize(vector2():set(PANEL_W, text_h + PANEL_PAD * 2))
		end
	end
end

local function mcm_bool(key, default)
	if ui_mcm then
		local value = ui_mcm.get(DEBUG_MOD .. "/" .. key)
		if value ~= nil then
			return value == true or value == 1
		end
	end
	local conf = _G.dogma_debug_conf
	local defaults = conf and conf.DEFAULTS
	if defaults and defaults[key] ~= nil then
		return defaults[key] == true or defaults[key] == 1
	end
	return default
end

function logging()
	return mcm_bool("debug_log", true)
end

function overlay_enabled()
	return mcm_bool("debug_overlay", false)
end

function overlay(source, order, msg, color)
	if not overlay_enabled() then
		return
	end
	local s = get_source(source)
	s.slots[order or 0] = { msg = tostring(msg), color = color }
	render()
end

function log(mod_id, msg)
	if not logging() then
		return
	end
	printf("[%s] %s", tag(mod_id), tostring(msg))
end

function clear_source(source)
	if not source then
		return
	end
	local s = sources[source]
	if not s then
		return
	end
	s.slots = {}
	render()
end

function on_game_start()
	RegisterScriptCallback("on_option_change", render)
end

