function on_mcm_load(options)
	patch_new_game()

	local function wtrack(id, def)
		return {
			id = id,
			type = "track",
			val = 2,
			min = 0,
			max = 1,
			step = 0.01,
			def = def or 0.5,
			hint = "dogma_menu_dynamic_loadout_" .. id,
		}
	end

	local gr = {
		{
			id = "page_description",
			type = "desc",
			text = "ui_mcm_dogma_menu_dynamic_loadout_page_description",
		},
		{
			id = "enabled",
			type = "check",
			val = 1,
			def = CONFIG.DEFAULTS.enabled,
			hint = "dogma_menu_dynamic_loadout_enabled",
		},
		{
			id = "log_scores",
			type = "check",
			val = 1,
			def = CONFIG.DEFAULTS.log_scores,
			hint = "dogma_menu_dynamic_loadout_log_scores",
		},
		{
			id = "include_universal_armor",
			type = "check",
			val = 1,
			def = CONFIG.DEFAULTS.include_universal_armor,
			hint = "dogma_menu_dynamic_loadout_include_universal_armor",
		},
		{ id = "line_caps", type = "line" },
		{
			id = "hdr_caps",
			type = "desc",
			text = "ui_mcm_dogma_menu_dynamic_loadout_caps_section",
		},
		{
			id = "max_pts_weapon",
			type = "track",
			val = 2,
			min = 1,
			max = 1000,
			step = 1,
			def = CONFIG.DEFAULTS.max_pts_weapon,
			hint = "dogma_menu_dynamic_loadout_max_pts_weapon",
		},
		{
			id = "max_pts_armor",
			type = "track",
			val = 2,
			min = 1,
			max = 1000,
			step = 1,
			def = CONFIG.DEFAULTS.max_pts_armor,
			hint = "dogma_menu_dynamic_loadout_max_pts_armor",
		},
		{
			id = "max_pts_helmet",
			type = "track",
			val = 2,
			min = 1,
			max = 1000,
			step = 1,
			def = CONFIG.DEFAULTS.max_pts_helmet,
			hint = "dogma_menu_dynamic_loadout_max_pts_helmet",
		},
		{
			id = "max_pts_ammo",
			type = "track",
			val = 2,
			min = 1,
			max = 1000,
			step = 1,
			def = CONFIG.DEFAULTS.max_pts_ammo,
			hint = "dogma_menu_dynamic_loadout_max_pts_ammo",
		},
		{
			id = "max_pts_sight",
			type = "track",
			val = 2,
			min = 1,
			max = 1000,
			step = 1,
			def = CONFIG.DEFAULTS.max_pts_sight,
			hint = "dogma_menu_dynamic_loadout_max_pts_sight",
		},
		{ id = "line_cost_mult", type = "line" },
		{
			id = "hdr_cost_mult",
			type = "desc",
			text = "ui_mcm_dogma_menu_dynamic_loadout_cost_mult_section",
		},
		{
			id = "cost_mult_weapon",
			type = "track",
			val = 2,
			min = 1,
			max = 100000,
			step = 1,
			def = CONFIG.DEFAULTS.cost_mult_weapon,
			hint = "dogma_menu_dynamic_loadout_cost_mult_weapon",
		},
		{
			id = "cost_mult_armor",
			type = "track",
			val = 2,
			min = 1,
			max = 100000,
			step = 1,
			def = CONFIG.DEFAULTS.cost_mult_armor,
			hint = "dogma_menu_dynamic_loadout_cost_mult_armor",
		},
		{
			id = "cost_mult_helmet",
			type = "track",
			val = 2,
			min = 1,
			max = 100000,
			step = 1,
			def = CONFIG.DEFAULTS.cost_mult_helmet,
			hint = "dogma_menu_dynamic_loadout_cost_mult_helmet",
		},
		{
			id = "cost_mult_ammo",
			type = "track",
			val = 2,
			min = 1,
			max = 100000,
			step = 1,
			def = CONFIG.DEFAULTS.cost_mult_ammo,
			hint = "dogma_menu_dynamic_loadout_cost_mult_ammo",
		},
		{
			id = "cost_mult_sight",
			type = "track",
