local function ammo_display_label(sec)
	local base = sec or ""
	if base:sub(-8) == "_verybad" then
		base = base:sub(1, -9)
	elseif base:sub(-4) == "_bad" then
		base = base:sub(1, -5)
	end
	return AMMO_TYPE_SHORT[base] or AMMO_TYPE_UNKNOWN
end

local function ammo_type_color(label)
	local name = AMMO_TYPE_COLOR[label]
	return (name and TYPE_ARGB[name]) or TYPE_ARGB.grey
end

-- Color family used for slash compare matching (FMJ↔SLUG, HP↔BUCK, AP↔SLAP, …).
-- Grey is intentionally excluded: it is a misc bucket (ECO/VOG/????), not a type family.
local function ammo_color_key(label)
	local key = AMMO_TYPE_COLOR[label]
	if key == "yellow" or key == "blue" or key == "orange" then
		return key
	end
	return nil
end

local function color_ammo_value(label, text)
	local name = AMMO_TYPE_COLOR[label]
	return ((name and TYPE_CODE[name]) or TYPE_CODE.grey) .. tostring(text)
end

local CLR = {
	white = GetARGB(255, 255, 255, 255),
	value = GetARGB(255, 175, 175, 175),
	-- Column header labels (Type / AP / armor tiers).
	hdr = GetARGB(255, 230, 210, 160),
	-- Match utils_ui clr_list p1/n1 (stock stat value colors).
	stat_pos = GetARGB(255, 170, 170, 170),
	stat_neg = GetARGB(255, 200, 50, 50),
	-- Match utils_ui clr_list info_p_txt / info_n_txt (compare column).
	cmp_pos = GetARGB(200, 100, 255, 100),
	cmp_neg = GetARGB(200, 255, 100, 100),
}

-- Complex %c often ignores alpha vs SetTextColor(GetARGB(a,...)); bake A into RGB
-- so multipart compares match stock single-value compare brightness.
local function cmp_text_code(a, r, g, b)
	local s = a / 255
	return string.format("%%c[255,%d,%d,%d]",
		math.floor(r * s + 0.5),
		math.floor(g * s + 0.5),
		math.floor(b * s + 0.5))
end

local CMP_CODE_POS = cmp_text_code(200, 100, 255, 100)
local CMP_CODE_NEG = cmp_text_code(200, 255, 100, 100)
-- Punctuation / placeholders / zero deltas in compare text (not green/red).
local CMP_CODE_GREY = "%c[255,175,175,175]"

-- Forward-declared here so the display helpers below capture these as upvalues.
local format_raw_ammo_damage_slash
local format_stalker_ammo_damage_slash
local mutant_ammo_damage_items
local stalker_ammo_damage_items

local ENHANCED_STAT_LABELS = {}

local function refresh_enhanced_stat_labels()
	ENHANCED_STAT_LABELS = {
		hit_power = game.translate_string("ui_dogma_gui_weapon_tooltips_hit_power"),
		stalker_damage = game.translate_string("ui_dogma_gui_weapon_tooltips_stalker_damage"),
		ammo_damage = game.translate_string("ui_dogma_gui_weapon_tooltips_ammo_torso"),
		dispersion = game.translate_string("ui_dogma_gui_weapon_tooltips_dispersion"),
		spread = game.translate_string("ui_dogma_gui_weapon_tooltips_spread"),
		barrel_wear = game.translate_string("ui_dogma_gui_weapon_tooltips_barrel_wear"),
		burst_control = game.translate_string("ui_dogma_gui_weapon_tooltips_burst_control"),
		bullet_drop = game.translate_string("ui_dogma_gui_weapon_tooltips_bullet_drop"),
	}
end

local function custom_stat_text(cap, obj, sec)
	if not cap then
		return nil
	end
	if CONFIG.loaded.show_stalker_damage and cap == ENHANCED_STAT_LABELS.stalker_damage then
		return format_stalker_ammo_damage_slash(obj, sec)
	end
	if CONFIG.loaded.show_mutant_damage and cap == ENHANCED_STAT_LABELS.ammo_damage then
		return format_raw_ammo_damage_slash(obj, sec)
	end
	if not zzzz_dogma_gui_weapon_tooltips_stats or not zzzz_dogma_gui_weapon_tooltips_stats.text_for_name then
		return nil
	end
	local S = zzzz_dogma_gui_weapon_tooltips_stats
	local N = S.NAME
	if CONFIG.loaded.show_dispersion and cap == ENHANCED_STAT_LABELS.dispersion then
		return S.text_for_name(N.dispersion, obj, sec)
	end
	if CONFIG.loaded.show_spread and cap == ENHANCED_STAT_LABELS.spread then
		return S.text_for_name(N.spread, obj, sec)
	end
	if CONFIG.loaded.show_barrel_wear and cap == ENHANCED_STAT_LABELS.barrel_wear then
		return S.text_for_name(N.barrel_wear, obj, sec)
	end
	if CONFIG.loaded.show_burst_control and cap == ENHANCED_STAT_LABELS.burst_control then
		return S.text_for_name(N.burst_control, obj, sec)
	end
	if CONFIG.loaded.show_bullet_drop and cap == ENHANCED_STAT_LABELS.bullet_drop then
		return S.text_for_name(N.bullet_drop, obj, sec)
	end
	return nil
end

-- Companion stat name_id for a translated caption (nil for slash rows / Hit Power).
local function companion_name_id_for_cap(cap)
	if not cap or not zzzz_dogma_gui_weapon_tooltips_stats or not zzzz_dogma_gui_weapon_tooltips_stats.NAME then
		return nil
	end
	local L = ENHANCED_STAT_LABELS
	local N = zzzz_dogma_gui_weapon_tooltips_stats.NAME
	if cap == L.dispersion then
		return N.dispersion
	end
	if cap == L.spread then
		return N.spread
	end
	if cap == L.barrel_wear then
		return N.barrel_wear
	end
	if cap == L.burst_control then
		return N.burst_control
	end
	if cap == L.bullet_drop then
		return N.bullet_drop
	end
	return nil
end

-- Equipped weapon in the same slot (stock UIInfoItem compare target).
local function slot_compare_weapon(info, obj, sec)
	if not info or not info.can_compare or not obj or not sec or sec == "" then
		return nil
	end
	if not db or not db.actor then
		return nil
	end
	local slot = (SYS_GetParam(2, sec, "slot", -1) or -1) + 1
	if slot <= 0 then
		return nil
	end
	local obj_b = db.actor:item_in_slot(slot)
	if not obj_b then
		return nil
	end
	local ok_a, id_a = pcall(function()
		return obj:id()
	end)
	local ok_b, id_b = pcall(function()
		return obj_b:id()
	end)
	if ok_a and ok_b and id_a == id_b then
		return nil
	end
	return obj_b
end

local function round_compare(v, decimals)
	local d = decimals or 2
	local mult = 10 ^ d
	return math.floor(v * mult + 0.5) / mult
end

local function format_signed_diff(diff, decimals)
	local diff_txt = string.format("%." .. tostring(decimals or 2) .. "f", diff)
	diff_txt = diff_txt:gsub("(%..-)0+$", "%1"):gsub("%.$", "")
	if diff > 0 then
		return "+" .. diff_txt
	end
	return diff_txt
end

-- Inline compare colors for multi-part (+/-) text (same RGB/alpha as CLR.cmp_*).
-- Only the signed number is tinted; callers wrap punctuation in CMP_CODE_GREY.
local function colored_signed_diff(diff, decimals, lower_is_better)
	local body = format_signed_diff(diff, decimals)
	if diff == 0 then
		return CMP_CODE_GREY .. body
	end
	local better
	if lower_is_better then
		better = diff < 0
	else
		better = diff > 0
	end
	return (better and CMP_CODE_POS or CMP_CODE_NEG) .. body
end

-- Whitens main value when color_value ~= false (slash rows pass false to keep ammo colors).
local function maybe_whiten_value(ele, color_value)
	if color_value ~= false and ele and ele.txt then
		ele.txt:SetTextColor(CLR.white)
	end
end

-- Build "(a / b / …)" or "(a, b)" with grey punctuation; only ±N is green/red.
-- diffs[i]=false → "-" placeholder (grey).
local function apply_multipart_compare(ele, diffs, decimals, lower_is_better, color_value, sep)
	if not ele or not ele.comp or not diffs or #diffs == 0 then
		return false
	end
	sep = sep or ", "
	local n = 0
	local any = false
	local any_placeholder = false
	for i = 1, #diffs do
		local d = diffs[i]
		if d == false then
			any_placeholder = true
		else
			n = n + 1
			if d ~= 0 then
				any = true
			end
		end
	end
	-- Hide only when every slot is a real 0 (no placeholders, nothing differs).
	if n == 0 and not any_placeholder then
		ele.comp:Show(false)
		return false
	end
	if n > 0 and not any and not any_placeholder then
		ele.comp:Show(false)
		return false
	end

	local parts = {}
	for i = 1, #diffs do
		if diffs[i] == false then
			parts[i] = CMP_CODE_GREY .. "-"
		else
			parts[i] = colored_signed_diff(diffs[i], decimals, lower_is_better)
		end
	end
	ele.comp:SetTextComplexMode(true)
	ele.comp:SetText(CMP_CODE_GREY .. "("
		.. table.concat(parts, CMP_CODE_GREY .. sep)
		.. CMP_CODE_GREY .. ")")
	ele.comp:Show(true)
	ele.comp:SetTextColor(CLR.white)
	maybe_whiten_value(ele, color_value)
	return true
end

-- Stock text compare: "(+/-diff)" with default parens; only ±N is green/red.
-- color_value=false: never paint the main text (slash rows keep ammo colors).
local function apply_numeric_compare(ele, val_a, val_b, lower_is_better, decimals, color_value)
	if not ele or not ele.comp or val_a == nil or val_b == nil then
		return false
	end
	local a = round_compare(val_a, decimals)
	local b = round_compare(val_b, decimals)
	if a == b then
		ele.comp:Show(false)
		return false
	end
	local diff = a - b
	ele.comp:SetTextComplexMode(true)
	ele.comp:SetText(CMP_CODE_GREY .. "("
		.. colored_signed_diff(diff, decimals, lower_is_better)
		.. CMP_CODE_GREY .. ")")
	ele.comp:Show(true)
	ele.comp:SetTextColor(CLR.white)
	maybe_whiten_value(ele, color_value)
	return true
end

local function resolve_compare_sec(obj_b)
	if not obj_b then
		return nil
	end
	local ok, section = pcall(function()
		return obj_b:section()
	end)
	if ok and section then
		return ini_sys:r_string_ex(section, "parent_section") or section
	end
	return nil
end

-- Spread: per-angle deltas with individual green/red (lower is better).
local function apply_spread_compare(ele, obj, sec, obj_b, decimals)
	local S = zzzz_dogma_gui_weapon_tooltips_stats
	if not ele or not ele.comp or not S or not obj_b then
		return false
	end
	if not S.value_base_spread or not S.value_movement_spread then
		return false
	end
	local sec_b = resolve_compare_sec(obj_b)
	local lo_a = S.value_base_spread(obj, sec)
	local hi_a = S.value_movement_spread(obj, sec)
	local lo_b = S.value_base_spread(obj_b, sec_b)
	local hi_b = S.value_movement_spread(obj_b, sec_b)
	if not lo_a or not hi_a or not lo_b or not hi_b then
		return false
	end
	local d_lo = round_compare(lo_a, decimals) - round_compare(lo_b, decimals)
	local d_hi = round_compare(hi_a, decimals) - round_compare(hi_b, decimals)
	return apply_multipart_compare(ele, { d_lo, d_hi }, decimals, true, true)
end

-- Stock p1 grey for vanilla rows (not white). Leading "-" → n1 red.
local function stock_value_color(text)
	if type(text) == "string" and string.find(text, "^%-") then
		return CLR.stat_neg
	end
	return CLR.stat_pos
end

-- Move stock green/red off the main number; recolor compare so only ±N is tinted
-- (parens / % stay grey). Bar rows already paint (+/-); leave alone when txt hidden.
-- value_clr: white for DOGMA rows, stock grey for vanilla GAMMA rows.
local function relocate_stock_compare_colors(ele, value_clr)
	if not ele or not ele.comp or not ele.comp:IsShown() then
		return
	end
	if ele.txt and ele.txt:IsShown() then
		ele.txt:SetTextColor(value_clr or stock_value_color(ele.txt:GetText()))
	end
	local raw = ele.comp:GetText()
	if not raw or raw == "" then
		return
	end
	-- "(±N)" / "(±N%)" or bare "±N%"
	local body = raw:match("^%((.+)%)$")
	local wrapped = body ~= nil
	if not body then
		body = raw
	end
	local num_part, pct = body:match("^(.*)(%%)$")
	if not num_part then
		num_part, pct = body, ""
	end
	local n = tonumber(num_part)
	local code = CMP_CODE_GREY
	if n then
		if n > 0 then
			code = CMP_CODE_POS
		elseif n < 0 then
			code = CMP_CODE_NEG
		end
	end
	ele.comp:SetTextComplexMode(true)
	if wrapped then
		ele.comp:SetText(CMP_CODE_GREY .. "(" .. code .. num_part .. pct .. CMP_CODE_GREY .. ")")
	else
		ele.comp:SetText(code .. num_part .. CMP_CODE_GREY .. pct)
	end
	ele.comp:SetTextColor(CLR.white)
end

local function apply_companion_compare(ele, name_id, obj, sec, obj_b)
	local S = zzzz_dogma_gui_weapon_tooltips_stats
	if not S or not S.value_for_name or not obj_b then
		return false
	end
	local lower_better, decimals = false, 2
	if S.compare_meta_for_name then
		lower_better, decimals = S.compare_meta_for_name(name_id)
	end
	if S.NAME and name_id == S.NAME.spread then
		return apply_spread_compare(ele, obj, sec, obj_b, decimals)
	end
	local val_a = S.value_for_name(name_id, obj, sec)
	local val_b = S.value_for_name(name_id, obj_b, resolve_compare_sec(obj_b))
	return apply_numeric_compare(ele, val_a, val_b, lower_better, decimals)
end

-- True if items list has two+ rounds in the same compare color family.
local function items_have_duplicate_color(items)
	if not items then
		return false
	end
	local seen = {}
	for i = 1, #items do
		local ck = items[i].label and ammo_color_key(items[i].label)
		if ck then
			if seen[ck] then
				return true
			end
			seen[ck] = true
		end
	end
	return false
end

-- Slash rows: walk current-weapon ammo order. Match by section, else Type label,
-- else Type color family (yellow/blue/orange only - same map as slash value colors:
-- FMJ↔SLUG, HP↔BUCK, AP↔SLAP). Missing on B → "-" placeholder so (+/-) lines up
-- with the left slash (e.g. FMJ/HP/AP vs FMJ/AP → "(+5 / - / -3)").
-- No shared matches at all → "(- / - / -)" so the column is not left blank.
-- Skip entirely if either gun has two rounds in the same color family.
local function apply_slash_damage_compare(ele, items_fn, obj, sec, obj_b)
	if not items_fn or not obj_b or not ele or not ele.comp then
		return false
	end
	local items_a = items_fn(obj, sec)
	local items_b = items_fn(obj_b, resolve_compare_sec(obj_b))
	if not items_a or not items_b or #items_a == 0 or #items_b == 0 then
		return false
	end
	if items_have_duplicate_color(items_a) or items_have_duplicate_color(items_b) then
		ele.comp:Show(false)
		return false
	end
	local b_by_sec = {}
	local b_by_label = {}
	local b_by_color = {}
	for i = 1, #items_b do
		local it = items_b[i]
		if it.sec then
			b_by_sec[it.sec] = it.dmg
		end
		if it.label then
			b_by_label[it.label] = it.dmg
			local ck = ammo_color_key(it.label)
			if ck then
				b_by_color[ck] = it.dmg
			end
		end
	end
	local diffs = {}
	local any_shared = false
	local any_nonzero = false
	local any_placeholder = false
	for i = 1, #items_a do
		local it = items_a[i]
		local ck = it.label and ammo_color_key(it.label)
		local b = (it.sec and b_by_sec[it.sec])
			or (it.label and b_by_label[it.label])
			or (ck and b_by_color[ck])
		if b ~= nil then
			any_shared = true
			local d = round_compare(it.dmg, 1) - round_compare(b, 1)
			diffs[i] = d
			if d ~= 0 then
				any_nonzero = true
			end
		else
			diffs[i] = false
			any_placeholder = true
		end
	end
	-- Identical on every shared type and nothing missing → nothing to show.
	if any_shared and not any_nonzero and not any_placeholder then
		ele.comp:Show(false)
		return false
	end
	-- No shared matches: still emit placeholders in current-weapon order.
	if not any_shared then
		local parts = {}
		for i = 1, #diffs do
			parts[i] = CMP_CODE_GREY .. "-"
		end
		ele.comp:SetTextComplexMode(true)
		ele.comp:SetText(CMP_CODE_GREY .. "("
			.. table.concat(parts, CMP_CODE_GREY .. " / ")
			.. CMP_CODE_GREY .. ")")
		ele.comp:Show(true)
		ele.comp:SetTextColor(CLR.white)
		return true
	end
	-- " / " matches left slash separators; punctuation grey, ±N tinted.
	return apply_multipart_compare(ele, diffs, 1, false, false, " / ")
end

local function apply_custom_stat_display(info, obj, sec)
	if not info or not info.stats then
		return
	end
	-- Stat slots are reused across items. Complex mode sticks and breaks stock
	-- strings that contain '%' (Accuracy etc.) - always clear first.
	for _, ele in pairs(info.stats) do
		if ele.txt then
			ele.txt:SetTextComplexMode(false)
		end
		if ele.comp then
			ele.comp:SetTextComplexMode(false)
		end
	end
	if not CONFIG.loaded.custom_stats_tooltips then
		return
	end
	if (not sec or sec == "") and obj then
		local ok, section = pcall(function()
			return obj:section()
		end)
		if ok and section then
			sec = ini_sys:r_string_ex(section, "parent_section") or section
		end
	end
	-- Match GetType("weapon"): IsWeapon(sec) crashes - it calls :clsid() on the string.
	if not sec or info:GetType(sec) ~= "weapon" then
		return
	end

	local obj_b = slot_compare_weapon(info, obj, sec)
	local painted = {}

	for _, ele in pairs(info.stats) do
		if ele.cap and ele.txt then
			local cap = ele.cap:GetText()
			if cap then
				if CONFIG.loaded.show_hit_power and cap == ENHANCED_STAT_LABELS.hit_power then
					ele.cap:SetTextColor(CLR.white)
					-- Stock Update already fills ele.comp + green/red when values differ.
					if not (ele.comp and ele.comp:IsShown()) then
						ele.txt:SetTextColor(CLR.white)
					end
				else
					local custom = custom_stat_text(cap, obj, sec)
					if custom then
						ele.cap:SetTextColor(CLR.white)
						if cap == ENHANCED_STAT_LABELS.stalker_damage
							or cap == ENHANCED_STAT_LABELS.ammo_damage
							or cap == ENHANCED_STAT_LABELS.bullet_drop
							or cap == ENHANCED_STAT_LABELS.dispersion
							or cap == ENHANCED_STAT_LABELS.spread
							or cap == ENHANCED_STAT_LABELS.burst_control
							or cap == ENHANCED_STAT_LABELS.barrel_wear then
							ele.txt:SetTextComplexMode(true)
						end
						ele.txt:SetText(custom)
						ele.txt:Show(true)
						ele.txt:SetTextColor(CLR.white)

						local comparing = false
						if obj_b and ele.comp then
							if cap == ENHANCED_STAT_LABELS.stalker_damage then
								comparing = apply_slash_damage_compare(
									ele, stalker_ammo_damage_items, obj, sec, obj_b)
							elseif cap == ENHANCED_STAT_LABELS.ammo_damage then
								comparing = apply_slash_damage_compare(
									ele, mutant_ammo_damage_items, obj, sec, obj_b)
							else
								local name_id = companion_name_id_for_cap(cap)
								if name_id then
									comparing = apply_companion_compare(ele, name_id, obj, sec, obj_b)
								end
							end
						end
						if comparing then
							painted[ele] = true
						elseif ele.comp then
							ele.comp:Show(false)
						end
					elseif ele.txt:IsShown() then
						-- Vanilla GAMMA rows: stock grey (ADV self-compare paints them white).
						ele.txt:SetTextColor(stock_value_color(ele.txt:GetText()))
					end
				end
			end
		end
	end

	-- Vanilla / Hit Power: restyle existing compare colors (no recalc).
	for _, ele in pairs(info.stats) do
		if ele.comp and ele.comp:IsShown() and not painted[ele] then
			local cap = ele.cap and ele.cap:GetText()
			local hit_power_row = CONFIG.loaded.show_hit_power and cap == ENHANCED_STAT_LABELS.hit_power
			relocate_stock_compare_colors(ele, hit_power_row and CLR.white or nil)
		end
	end
end

local PANEL_TOP_OFFSET = 0    -- gap below item description, above our damage panel
local BOTTOM_OFFSET = 2       -- gap between damage panel and stats block
local SECTION_GAP = 10        -- match vanilla UIInfoItem:Sync_Finale section spacing

-- Generic rows, filled top-down in order. Rows beyond the data are hidden.
local ROW_XML = {
	"panel:row_1",
	"panel:row_2",
	"panel:row_3",
	"panel:row_4",
}

-- Parsed once; layout lives in configs/ui/ui_dogma_gui_weapon_tooltips.xml.
local DAMAGE_XML = CScriptXmlInit()
DAMAGE_XML:ParseFile("ui_dogma_gui_weapon_tooltips.xml")

-- Own handle for the vanilla stat-box layout (item_info:stats_box lives in
-- utils.xml, same file utils_ui.get_stats_xml uses). Used to rebuild our
-- damage/hit-power stat row in the details sheet with white text.
local STAT_XML = CScriptXmlInit()
STAT_XML:ParseFile("utils.xml")

local base_uiinfo_init
local base_uiinfo_update
local base_uiinfo_show

local HIT_POWER_STAT = {
	index = 3,
	typ = "float",
	name = "ui_dogma_gui_weapon_tooltips_hit_power",
	icon_p = "ui_wp_prop_damage",
	icon_n = "",
	track = false,
	magnitude = 1,
	unit = "%",
	compare = false,
	sign = false,
	show_always = true,
	value_functor = {
		"zzzz_dogma_gui_weapon_tooltips_main", "scale_hit_power_display",
		"zzzz_dogma_gui_weapon_tooltips_main", "prop_hit_power",
	},
}

-- Flesh (mutant) damage per ammo type, table order: hit_power / range x k_hit x
-- pellets x CQC mutant_mult 0.85 x ammo_mult x difficulty.
-- No species or weak-spot factors.
local RAW_AMMO_DAMAGE_STAT = {
	index = 3.5,
	typ = "float",
	name = "ui_dogma_gui_weapon_tooltips_ammo_torso",
	icon_p = "ui_wp_prop_damage",
	icon_n = "",
	track = false,
	magnitude = 1,
	unit = "",
	compare = false,
	sign = false,
	show_always = true,
	value_functor = { "zzzz_dogma_gui_weapon_tooltips_main", "prop_raw_ammo_damage_slash_flag" },
}

-- Pre-armor stalker (NPC) torso damage per ammo at calc_range(): CQC power
-- before AP/armor/chip. Outfit ap_scale omitted (1.0) so this is universal max
-- before armor math. Same ammo order as the damage table.
local STALKER_DAMAGE_STAT = {
	index = 3.25,
	typ = "float",
	name = "ui_dogma_gui_weapon_tooltips_stalker_damage",
	icon_p = "ui_wp_prop_damage",
	icon_n = "",
	track = false,
	magnitude = 1,
	unit = "",
	compare = false,
	sign = false,
	show_always = true,
	value_functor = { "zzzz_dogma_gui_weapon_tooltips_main", "prop_stalker_ammo_damage_slash_flag" },
}

-- Cached non-DOGMA base rows so MCM can hide/restore them.
local saved_base_stats = {}

local function cache_base_stat(weapon_stats, key)
	local cur = weapon_stats[key]
	-- Skip our own ui_dogma_gui_weapon_tooltips_* rows when caching vanilla base defs.
	if cur and not (cur.name and string.find(cur.name, "ui_dogma_gui_weapon_tooltips_", 1, true) == 1) then
		saved_base_stats[key] = cur
	end
end

local function set_base_stat(weapon_stats, key, enabled)
	cache_base_stat(weapon_stats, key)
	if enabled then
		if saved_base_stats[key] then
			weapon_stats[key] = saved_base_stats[key]
		end
	else
		weapon_stats[key] = nil
	end
end

local function make_stat_row(index, name, icon, prop)
	return {
		index = index,
		typ = "float",
		name = name,
		icon_p = icon,
		icon_n = "",
		track = false,
		magnitude = 1,
		unit = "",
		compare = false,
		sign = false,
		show_always = true,
		-- Functors must live on this script module (zzzz_dogma_gui_weapon_tooltips_main.*);
		-- X-Ray resolves _G[file][func], not nested table fields on another script.
		value_functor = { "zzzz_dogma_gui_weapon_tooltips_main", prop },
	}
end

-- Highest sort index among stock/Momopate weapon rows (excludes DOGMA keys).
local function max_non_dogma_weapon_index(weapon_stats)
	local max_i = 0
	for key, def in pairs(weapon_stats) do
		if def and type(def) == "table" and def.index
			and key ~= "damage"
			and string.find(key, "dogma_", 1, true) ~= 1
		then
			if def.index > max_i then
				max_i = def.index
			end
		end
	end
	return max_i
end

-- Resolve a base row's sort index from the cached stock def (survives MCM hide).
local function resolved_base_index(key)
	local saved = saved_base_stats[key]
	if saved and saved.index then
		return saved.index
	end
	return BASE_INDEX[key] or 0
end

-- Inline: sit under the parent when it is visible; take its index when hidden
-- so companions remain drop-in replacements for their related base rows.
local function inline_companion_index(parent_key, parent_shown)
	local parent_idx = resolved_base_index(parent_key)
	if parent_shown then
		return parent_idx + 0.5
	end
	return parent_idx
end

-- Two companions under one parent (upper first). Spread sits above Dispersion.
local function inline_companion_pair(parent_key, parent_shown, upper_shown, lower_shown)
	local parent_idx = resolved_base_index(parent_key)
	if parent_shown then
		if upper_shown and lower_shown then
			return parent_idx + 0.25, parent_idx + 0.5
		end
		-- Solo companion: same slot as other single companions (parent + 0.5).
		return parent_idx + 0.5, parent_idx + 0.5
	end
	if upper_shown and lower_shown then
		return parent_idx, parent_idx + 0.25
	end
	return parent_idx, parent_idx
end

local function placement_indices(weapon_stats)
	if CONFIG.loaded.stat_row_placement == "after" then
		-- All DOGMA rows at end of list (after remaining non-DOGMA rows).
		local base = max_non_dogma_weapon_index(weapon_stats)
		return {
			hit_power = base + 1,
			stalker_damage = base + 2,
			mutant_damage = base + 3,
			spread = base + 4,
			dispersion = base + 5,
			bullet_drop = base + 6,
			barrel_wear = base + 7,
			burst_control = base + 8,
		}
	end

	-- Hit Power / Stalker / Mutant have no related base row: always lead.
	local dmg = {
		hit_power = 0.1,
		stalker_damage = 0.2,
		mutant_damage = 0.3,
	}

	if CONFIG.loaded.stat_row_placement == "start" then
		-- Companions join the lead block before Accuracy / any non-DOGMA rows.
		return {
			hit_power = dmg.hit_power,
			stalker_damage = dmg.stalker_damage,
			mutant_damage = dmg.mutant_damage,
			spread = 0.4,
			dispersion = 0.5,
			bullet_drop = 0.6,
			barrel_wear = 0.7,
			burst_control = 0.8,
		}
	end

	-- Inline: companions after related base; damage trio still first.
	local spread_idx, disp_idx = inline_companion_pair(
		"accuracy", CONFIG.loaded.show_accuracy, CONFIG.loaded.show_spread, CONFIG.loaded.show_dispersion)
	return {
		hit_power = dmg.hit_power,
		stalker_damage = dmg.stalker_damage,
		mutant_damage = dmg.mutant_damage,
		spread = spread_idx,
		dispersion = disp_idx,
		bullet_drop = inline_companion_index("speed", CONFIG.loaded.show_muzzle_velocity),
		barrel_wear = inline_companion_index("reliability", CONFIG.loaded.show_reliability),
		burst_control = inline_companion_index("recoil", CONFIG.loaded.show_recoil),
	}
end

local function apply_enhanced_weapon_stats()
	if not utils_ui or not utils_ui.stats_table then
		return
	end
	dogma.perf.start("weapon_tooltips", "apply_enhanced_weapon_stats")

	-- utils_ui.stats_table["weapon"] is normally only built lazily, the first
	-- time any item tooltip/details sheet is shown (utils_ui.get_stats_table ->
	-- prepare_stats_table). Called this early (main_menu_on_init, before the
	-- player has ever hovered an item), it would still be empty and we would
	-- have nothing to add our rows to. prepare_stats_table() itself no-ops once
	-- stats_table is populated (by us here, by the stock game, or by ADV), so
	-- forcing it early is always safe and never clobbers a later rebuild.
	if utils_ui.prepare_stats_table then
		utils_ui.prepare_stats_table()
	end

	local weapon_stats = utils_ui.stats_table["weapon"]
	if not weapon_stats then
		dogma.perf.stop()
		return
	end

	-- Cache every known base row first so inline anchors survive MCM hide.
	for key, _ in pairs(BASE_INDEX) do
		cache_base_stat(weapon_stats, key)
	end

	set_base_stat(weapon_stats, "accuracy", CONFIG.loaded.show_accuracy)
	set_base_stat(weapon_stats, "handling", CONFIG.loaded.show_handling)
	set_base_stat(weapon_stats, "fire_rate", CONFIG.loaded.show_fire_rate)
	set_base_stat(weapon_stats, "ammo_mag_size", CONFIG.loaded.show_mag_size)
	set_base_stat(weapon_stats, "reliability", CONFIG.loaded.show_reliability)
	set_base_stat(weapon_stats, "recoil", CONFIG.loaded.show_recoil)
	set_base_stat(weapon_stats, "speed", CONFIG.loaded.show_muzzle_velocity)

	local idx = placement_indices(weapon_stats)

	HIT_POWER_STAT.index = idx.hit_power
	STALKER_DAMAGE_STAT.index = idx.stalker_damage
	RAW_AMMO_DAMAGE_STAT.index = idx.mutant_damage

	cache_base_stat(weapon_stats, "damage")
	if CONFIG.loaded.show_hit_power then
		weapon_stats["damage"] = HIT_POWER_STAT
	else
		weapon_stats["damage"] = saved_base_stats["damage"]
	end

	if CONFIG.loaded.show_stalker_damage then
		weapon_stats["dogma_stalker_damage"] = STALKER_DAMAGE_STAT
	else
		weapon_stats["dogma_stalker_damage"] = nil
	end
	if CONFIG.loaded.show_mutant_damage then
		weapon_stats["dogma_ammo_damage"] = RAW_AMMO_DAMAGE_STAT
	else
		weapon_stats["dogma_ammo_damage"] = nil
	end

	local N = (zzzz_dogma_gui_weapon_tooltips_stats and zzzz_dogma_gui_weapon_tooltips_stats.NAME) or EXTRA_STAT_NAME
	weapon_stats["dogma_dispersion"] = CONFIG.loaded.show_dispersion
		and make_stat_row(idx.dispersion, N.dispersion, "ui_wp_prop_contrast", "prop_dispersion")
		or nil
	weapon_stats["dogma_spread"] = CONFIG.loaded.show_spread
		and make_stat_row(idx.spread, N.spread, "ui_wp_propery_13", "prop_spread")
		or nil
	-- Drop legacy dual-spread rows if a previous session registered them.
	weapon_stats["dogma_base_spread"] = nil
	weapon_stats["dogma_movement_spread"] = nil
	weapon_stats["dogma_bullet_drop"] = CONFIG.loaded.show_bullet_drop
		and make_stat_row(idx.bullet_drop, N.bullet_drop, "ui_wp_prop_nastilnost", "prop_bullet_drop")
		or nil
	weapon_stats["dogma_barrel_wear"] = CONFIG.loaded.show_barrel_wear
		and make_stat_row(idx.barrel_wear, N.barrel_wear, "ui_wp_prop_nadezhnost", "prop_barrel_wear")
		or nil
	weapon_stats["dogma_burst_control"] = CONFIG.loaded.show_burst_control
		and make_stat_row(idx.burst_control, N.burst_control, "ui_wp_prop_otdacha", "prop_burst_control")
		or nil
	dogma.perf.stop()
end

local DOGMA_STAT_KEYS = {
	"dogma_stalker_damage",
	"dogma_ammo_damage",
	"dogma_dispersion",
	"dogma_spread",
	"dogma_base_spread",
	"dogma_movement_spread",
	"dogma_bullet_drop",
	"dogma_barrel_wear",
	"dogma_burst_control",
}

-- Stock GAMMA/ADV rows only (no DOGMA extras, vanilla visibility).
local function restore_default_weapon_stats()
	if not utils_ui or not utils_ui.stats_table then
		return
	end
	if utils_ui.prepare_stats_table then
		utils_ui.prepare_stats_table()
	end
	local weapon_stats = utils_ui.stats_table["weapon"]
	if not weapon_stats then
		return
	end
	for key, _ in pairs(BASE_INDEX) do
		cache_base_stat(weapon_stats, key)
		set_base_stat(weapon_stats, key, true)
	end
	for i = 1, #DOGMA_STAT_KEYS do
		weapon_stats[DOGMA_STAT_KEYS[i]] = nil
	end
end

-- Shared stats_table is used by both surfaces; swap right before each render.
local last_custom_stats = nil

local function apply_weapon_stats(use_custom)
	if last_custom_stats == use_custom then
		return
	end
	if use_custom then
		apply_enhanced_weapon_stats()
	else
		restore_default_weapon_stats()
	end
	last_custom_stats = use_custom
end

local function apply_standing_weapon_stats()
	last_custom_stats = nil
	apply_weapon_stats(
		CONFIG.loaded.custom_stats_tooltips or CONFIG.loaded.custom_stats_details
	)
end

local logged_once = {}
-- Keys logged for the current tooltip open (reset when the hovered item changes).
local tooltip_logged = {}

local OVERLAY = {
	RANGE = { order = 1, color = "cyan" },
}

-- HUD-only: for values that change every frame (crosshair range).
local function overlay(slot, msg)
	if CONFIG.loaded.debug_overlay then
		local s = slot or OVERLAY.RANGE
		dogma.dbg.overlay(CONFIG.MOD_ID, s.order, tostring(msg), s.color)
	end
end

local function log(msg)
	if CONFIG.loaded.debug_log then
		dogma.dbg.log(CONFIG.MOD_ID, tostring(msg))
	end
end

-- Log each key at most once per session (debug_log only). Global/bootstrap events
-- use plain keys; per-item paths use log_item_once(reason, sec, msg) instead.
local function log_once(key, msg)
	if logged_once[key] then
		return
	end
	if not CONFIG.loaded.debug_log then
		return
	end
	logged_once[key] = true
	log(msg)
end

-- Per weapon section: dedupe repeated hovers on the same item, not across items.
local function log_item_once(reason, sec, msg)
	log_once(reason .. ":" .. tostring(sec), msg)
end

-- Once per tooltip open (cleared when the hovered item changes).
local function log_tooltip(key, msg)
	if not CONFIG.loaded.debug_log then
		return
	end
	if tooltip_logged[key] then
		return
	end
	tooltip_logged[key] = true
	log(msg)
end

-- UIInfoItem:Update caches by item id/section and early-returns for the same
-- item, so after an MCM change we must clear that cache or stat rows won't
-- rebuild until a different item is hovered.
local tracked_infos = setmetatable({}, { __mode = "k" })

local function on_option_change()
	local tostr = tostring
	local prev_debug = CONFIG.loaded.debug_log
	CONFIG.loaded.damage_table_tooltips = dogma.mcm.bool(CONFIG.MOD_ID, "damage_table_tooltips")
	CONFIG.loaded.damage_table_details = dogma.mcm.bool(CONFIG.MOD_ID, "damage_table_details")
	CONFIG.loaded.custom_stats_tooltips = dogma.mcm.bool(CONFIG.MOD_ID, "custom_stats_tooltips")
	CONFIG.loaded.custom_stats_details = dogma.mcm.bool(CONFIG.MOD_ID, "custom_stats_details")
	CONFIG.loaded.show_hit_power = dogma.mcm.bool(CONFIG.MOD_ID, "show_hit_power")
	CONFIG.loaded.show_stalker_damage = dogma.mcm.bool(CONFIG.MOD_ID, "show_stalker_damage")
	CONFIG.loaded.show_mutant_damage = dogma.mcm.bool(CONFIG.MOD_ID, "show_mutant_damage")
	CONFIG.loaded.show_accuracy = dogma.mcm.bool(CONFIG.MOD_ID, "show_accuracy")
	CONFIG.loaded.show_handling = dogma.mcm.bool(CONFIG.MOD_ID, "show_handling")
	CONFIG.loaded.show_fire_rate = dogma.mcm.bool(CONFIG.MOD_ID, "show_fire_rate")
	CONFIG.loaded.show_mag_size = dogma.mcm.bool(CONFIG.MOD_ID, "show_mag_size")
	CONFIG.loaded.show_reliability = dogma.mcm.bool(CONFIG.MOD_ID, "show_reliability")
	CONFIG.loaded.show_recoil = dogma.mcm.bool(CONFIG.MOD_ID, "show_recoil")
	CONFIG.loaded.show_muzzle_velocity = dogma.mcm.bool(CONFIG.MOD_ID, "show_muzzle_velocity")
	CONFIG.loaded.show_dispersion = dogma.mcm.bool(CONFIG.MOD_ID, "show_dispersion")
	CONFIG.loaded.show_spread = dogma.mcm.bool(CONFIG.MOD_ID, "show_spread")
	CONFIG.loaded.show_barrel_wear = dogma.mcm.bool(CONFIG.MOD_ID, "show_barrel_wear")
	CONFIG.loaded.show_burst_control = dogma.mcm.bool(CONFIG.MOD_ID, "show_burst_control")
	CONFIG.loaded.show_bullet_drop = dogma.mcm.bool(CONFIG.MOD_ID, "show_bullet_drop")
	-- "raw" = bone armor floats; "raw100" = floats x100 floored; "names" = class labels.
	local headers = dogma.mcm.string(CONFIG.MOD_ID, "column_headers")
	if headers == "raw" or headers == "raw100" or headers == "names" then
		CONFIG.loaded.column_headers = headers
	else
		CONFIG.loaded.column_headers = CONFIG.DEFAULTS.column_headers
	end
	local scale_from = dogma.mcm.string(CONFIG.MOD_ID, "color_scale_from")
	if scale_from == "white" or scale_from == "grey" or scale_from == "darkgrey" then
		CONFIG.loaded.color_scale_from = scale_from
	else
		CONFIG.loaded.color_scale_from = CONFIG.DEFAULTS.color_scale_from
	end
	local order = dogma.mcm.string(CONFIG.MOD_ID, "ammo_order")
	if order == "ap" or order == "damage" or order == "default" then
		CONFIG.loaded.ammo_order = order
	else
		CONFIG.loaded.ammo_order = CONFIG.DEFAULTS.ammo_order
	end
	local place = dogma.mcm.string(CONFIG.MOD_ID, "stat_row_placement")
	if place == "after" or place == "start" or place == "inline" then
		CONFIG.loaded.stat_row_placement = place
	else
		CONFIG.loaded.stat_row_placement = CONFIG.DEFAULTS.stat_row_placement
	end
	CONFIG.loaded.compact_header = dogma.mcm.bool(CONFIG.MOD_ID, "compact_header")
	CONFIG.loaded.table_row_pad = dogma.mcm.uint(CONFIG.MOD_ID, "table_row_pad")
	for i = 1, NUM_TORSO_TIERS do
		CONFIG.loaded["show_torso_" .. i] = dogma.mcm.bool(CONFIG.MOD_ID, "show_torso_" .. i)
	end
	for i = 1, NUM_HEAD_TIERS do
		CONFIG.loaded["show_head_" .. i] = dogma.mcm.bool(CONFIG.MOD_ID, "show_head_" .. i)
	end
	CONFIG.loaded.calc_range_m = dogma.mcm.int(CONFIG.MOD_ID, "calc_range")
	CONFIG.loaded.pellet_hit_pct = dogma.mcm.uint(CONFIG.MOD_ID, "pellet_hit_pct")
	local drop_range = dogma.mcm.int(CONFIG.MOD_ID, "drop_range")
	if zzzz_dogma_gui_weapon_tooltips_stats and zzzz_dogma_gui_weapon_tooltips_stats.set_drop_range then
		zzzz_dogma_gui_weapon_tooltips_stats.set_drop_range(drop_range)
	end
	local burst_threshold = dogma.mcm.int(CONFIG.MOD_ID, "burst_threshold")
	if zzzz_dogma_gui_weapon_tooltips_stats and zzzz_dogma_gui_weapon_tooltips_stats.set_burst_threshold then
		zzzz_dogma_gui_weapon_tooltips_stats.set_burst_threshold(burst_threshold)
	end
	CONFIG.loaded.use_condition_table = dogma.mcm.bool(CONFIG.MOD_ID, "use_condition_table")
	CONFIG.loaded.use_condition_stats = dogma.mcm.bool(CONFIG.MOD_ID, "use_condition_stats")
	CONFIG.loaded.apply_silencer_table = dogma.mcm.bool(CONFIG.MOD_ID, "apply_silencer_table")
	CONFIG.loaded.apply_silencer_stats = dogma.mcm.bool(CONFIG.MOD_ID, "apply_silencer_stats")
	if zzzz_dogma_gui_weapon_tooltips_stats and zzzz_dogma_gui_weapon_tooltips_stats.set_apply_silencer then
		zzzz_dogma_gui_weapon_tooltips_stats.set_apply_silencer(CONFIG.loaded.apply_silencer_stats)
	end
	CONFIG.loaded.debug_log = dogma.dbg.logging()
	CONFIG.loaded.debug_overlay = dogma.dbg.overlay_enabled()

	if CONFIG.loaded.debug_log and not prev_debug then
		logged_once = {}
		tooltip_logged = {}
	end

	if zzzz_dogma_gui_weapon_tooltips_stats and zzzz_dogma_gui_weapon_tooltips_stats.set_debug then
		zzzz_dogma_gui_weapon_tooltips_stats.set_debug(CONFIG.loaded.debug_log)
	end

	dogma.dbg.set_enabled(CONFIG.MOD_ID, dogma.dbg.overlay_enabled())

	refresh_enhanced_stat_labels()
	apply_standing_weapon_stats()
	for info in pairs(tracked_infos) do
		info.id = nil
		info.section = nil
	end

	log_once("config", string.format(
		"config: table=%s/%s custom=%s/%s hit=%s stalker=%s mutant=%s base=%s/%s/%s/%s/%s/%s/%s extra=%s/%s/%s/%s/%s place=%s headers=%s order=%s range=%s pellet%%=%s cond=%s/%s sil=%s/%s",
		tostr(CONFIG.loaded.damage_table_tooltips), tostr(CONFIG.loaded.damage_table_details),
		tostr(CONFIG.loaded.custom_stats_tooltips), tostr(CONFIG.loaded.custom_stats_details),
		tostr(CONFIG.loaded.show_hit_power),
		tostr(CONFIG.loaded.show_stalker_damage), tostr(CONFIG.loaded.show_mutant_damage),
		tostr(CONFIG.loaded.show_accuracy), tostr(CONFIG.loaded.show_handling),
		tostr(CONFIG.loaded.show_fire_rate), tostr(CONFIG.loaded.show_mag_size),
		tostr(CONFIG.loaded.show_muzzle_velocity),
		tostr(CONFIG.loaded.show_reliability), tostr(CONFIG.loaded.show_recoil),
		tostr(CONFIG.loaded.show_dispersion), tostr(CONFIG.loaded.show_spread),
		tostr(CONFIG.loaded.show_barrel_wear),
		tostr(CONFIG.loaded.show_burst_control),
		tostr(CONFIG.loaded.show_bullet_drop), tostr(CONFIG.loaded.stat_row_placement),
		tostr(CONFIG.loaded.column_headers), tostr(CONFIG.loaded.ammo_order),
		tostr(CONFIG.loaded.calc_range_m), tostr(CONFIG.loaded.pellet_hit_pct),
		tostr(CONFIG.loaded.use_condition_table),
		tostr(CONFIG.loaded.use_condition_stats),
		tostr(CONFIG.loaded.apply_silencer_table), tostr(CONFIG.loaded.apply_silencer_stats)))
end

local function safe_id(obj)
	if not obj then
		return nil
	end
	local ok, id = pcall(function()
		return obj:id()
	end)
	if ok then
		return id
	end
	return nil
end

local function safe_section(obj)
	if not obj then
		return nil
	end
	local ok, section = pcall(function()
		return obj:section()
	end)
	if ok and section then
		return section
	end
	return nil
end

-- Weapon hit_power (first float if LTX is a comma list). Avoid get_wpn_param's
-- false 0 the same way zzzz_dogma_gui_weapon_tooltips_stats.wpn_param does for other floats.
local function gun_hit_power(obj, sec)
	-- CQC grok_bo: TOZ-106 family uses fixed hit_power 0.8 (not LTX).
	if sec and string.find(sec, "wpn_toz106", 1, true) then
		return 0.8
	end

	local id = safe_id(obj)
	local from_param = nil

	if utils_item and utils_item.get_param then
		local raw_p = utils_item.get_param(sec, id, "hit_power", "float", true)
		if raw_p ~= nil then
			local v = tonumber(raw_p)
			if v ~= nil then
				if v ~= 0 then
					return v
				end
				from_param = 0
			end
		end
	end

	local raw = sec and ini_sys:r_string_ex(sec, "hit_power") or nil
	if not raw and sec then
		raw = SYS_GetParam(0, sec, "hit_power", nil)
	end
	if type(raw) == "string" then
		local n = tonumber(raw:match("[%-%d%.]+"))
		if n ~= nil then
			if n ~= 0 then
				return n
			end
			from_param = from_param or 0
		end
	elseif type(raw) == "number" then
		if raw ~= 0 then
			return raw
		end
		from_param = from_param or 0
	end

	if obj and utils_item and utils_item.get_wpn_param then
		local raw_w = utils_item.get_wpn_param(obj, sec, "hit_power", nil)
		if raw_w ~= nil then
			local v = tonumber(raw_w)
			if v ~= nil then
				if v ~= 0 then
					return v
				end
				from_param = from_param or 0
			end
		end
	end

	return from_param or 0
end

local function is_degraded_ammo(sec)
	if not sec then
		return true
	end
	return sec:sub(-8) == "_verybad" or sec:sub(-4) == "_bad"
end

function prop_hit_power(obj, sec)
	return gun_hit_power(obj, sec)
end

-- Sentinel so the stat row shows; display text is set in apply_custom_stat_display.
function prop_raw_ammo_damage_slash_flag(obj, sec)
