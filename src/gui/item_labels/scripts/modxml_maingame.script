--[[
	Item Labels. Hide look-at pickup icon.

	DXML only loads modxml_*.script. Moves floating look-at pickup icon
	off-screen when Enabled and hide_icons are both on (default). Hold-Use
	name text is killed separately via g_draw_pickup_item_names in main.script.
]]

local xml_read_cb = function(xml_file_name, xml_obj)
	if xml_file_name ~= [[ui\maingame.xml]]
		and xml_file_name ~= [[ui\maingame_16.xml]]
		and xml_file_name ~= [[ui\maingame_21.xml]]
	then
		return
	end
	local CONFIG = _G.dogma_gui_item_labels_conf
	if CONFIG and dogma and dogma.mcm
		and (not dogma.mcm.bool(CONFIG.MOD_ID, "enabled")
			or not dogma.mcm.bool(CONFIG.MOD_ID, "hide_icons"))
	then
		return
	end
	local res = xml_obj:query("pick_up_item")
	if res and res[1] then
		xml_obj:setElementAttr(res[1], {x = -9999})
	end
end

function on_xml_read()
	RegisterScriptCallback("on_xml_read", xml_read_cb)
end
