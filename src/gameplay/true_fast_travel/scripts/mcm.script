function on_mcm_load(options)
	dogma_mcm.mcm.attach(options, "gameplay", "ui_mcm_menu_dogma_gameplay", {
		id = "true_fast_travel",
		sh = true,
		text = "ui_mcm_menu_dogma_gameplay_true_fast_travel",
		gr = dogma_mcm.mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_gameplay_true_fast_travel_page_description",
			},
		}),
	})
end
