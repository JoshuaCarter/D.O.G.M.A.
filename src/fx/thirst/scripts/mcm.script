function on_mcm_load(options)
	local CONFIG = _G.dogma_fx_thirst_conf
	dogma_mcm.attach(options, "fx", "ui_mcm_menu_dogma_fx", {
		id = "thirst",
		sh = true,
		text = "ui_mcm_menu_dogma_fx_thirst",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_thirst_page_description",
			},
		}),
	})
end
