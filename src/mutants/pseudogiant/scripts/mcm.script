function on_mcm_load(options)
	local CONF = _G.dogma_mutants_pseudogiant_conf
	local D = CONF.defaults
	dogma_mcm.attach(options, "mutants", "ui_mcm_menu_dogma_mutants", {
		id = "pseudogiant",
		sh = true,
		text = "ui_mcm_menu_dogma_mutants_pseudogiant",
		gr = dogma_mcm.with_header({
			{
				id = "main_description",
				type = "desc",
				text = "ui_mcm_dogma_giant_jump_main_description",
			},
			{
				id = "enabled",
				type = "check",
				val = 1,
				def = D["enabled"],
				hint = "dogma_giant_jump_enabled",
			},
		}),
	})
end
