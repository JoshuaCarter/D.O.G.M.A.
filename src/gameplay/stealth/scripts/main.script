--[[
	DOGMA gameplay/stealth — MCM cache + bottom-center visibility gem.
]]

local CONFIG = _G.dogma_gameplay_stealth_conf
local DOGMA

local TINT_MAX = 245
local gem

local function clamp01(x)
	if x < 0 then
		return 0
	end
	if x > 1 then
		return 1
	end
	return x
end

local function clamp_slider(n, fallback)
	n = tonumber(n)
	if n == nil then
		return fallback
	end
	if n < 0 then
		return 0
	end
	if n > 1 then
		return 1
	end
	return n
end

local function refresh_settings()
	local d = CONFIG.DEFAULTS
	local L = CONFIG.loaded
	if DOGMA and DOGMA.mcm then
		local mid = CONFIG.MOD_ID
		L.scale = clamp_slider(DOGMA.mcm.number(mid, "scale", d.scale), d.scale)
		L.mult_stand = clamp_slider(DOGMA.mcm.number(mid, "mult_stand", d.mult_stand), d.mult_stand)
		L.mult_crouch = clamp_slider(DOGMA.mcm.number(mid, "mult_crouch", d.mult_crouch), d.mult_crouch)
		L.mult_prone = clamp_slider(DOGMA.mcm.number(mid, "mult_prone", d.mult_prone), d.mult_prone)
		L.icon = DOGMA.mcm.bool(mid, "icon", d.icon)
		L.debug = DOGMA.mcm.bool(mid, "debug", d.debug)
	else
		L.scale = d.scale
		L.mult_stand = d.mult_stand
		L.mult_crouch = d.mult_crouch
		L.mult_prone = d.mult_prone
		L.icon = d.icon
		L.debug = d.debug
	end
end

local function on_option_change()
	refresh_settings()
end

local function ensure_gem()
	local hud = get_hud()
	if not hud then
		return
	end
	local cs = hud:GetCustomStatic("mp_warm_up")
	if cs == nil then
		hud:AddCustomStatic("mp_warm_up", true)
		local xml = CScriptXmlInit()
		xml:ParseFile("ui_dogma_stealth_gem.xml")
		cs = hud:GetCustomStatic("mp_warm_up")
		local w = cs:wnd()
		local pos = w:GetWndPos()
		if pos.x ~= 0 or pos.y ~= 0 then
			pos.x = 0
			pos.y = 0
			w:SetWndPos(pos)
		end
		gem = xml:InitStatic("gem", w)
	elseif not gem then
		-- Custom static already existed (another mod); try to bind our gem once.
		local xml = CScriptXmlInit()
		xml:ParseFile("ui_dogma_stealth_gem.xml")
		gem = xml:InitStatic("gem", cs:wnd())
	end
end

local function update_gem()
	if not (db and db.actor) then
		return
	end
	if not CONFIG.loaded.icon then
		if gem then
			gem:Show(false)
		end
		return
	end

	ensure_gem()
	if not gem then
		return
	end

	gem:Show(true)
	local out = 0
	if visual_memory_manager and visual_memory_manager.icon_out then
		out = visual_memory_manager.icon_out() or 0
	end
	out = clamp01(out)
	local val = TINT_MAX - clamp(TINT_MAX * out, 0, TINT_MAX)
	gem:SetTextureColor(GetARGB(255, 255 - val, 255 - val, 255 - val))

	if CONFIG.loaded.debug and actor_menu and actor_menu.set_msg then
		local vis = visual_memory_manager.icon_vis and visual_memory_manager.icon_vis() or 0
		local mult = visual_memory_manager.icon_mult and visual_memory_manager.icon_mult() or 0
		actor_menu.set_msg(
			1,
			string.format("Stealth vis=%.2f mult=%.2f out=%.2f", vis, mult, out),
			0
		)
	end
end

local function on_actor_update()
	if not DOGMA.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return
	end
	update_gem()
end

function on_game_start()
	DOGMA = dogma_common.load(CONFIG.MOD_ID)
	refresh_settings()
	RegisterScriptCallback("actor_on_update", on_actor_update)
	RegisterScriptCallback("on_option_change", on_option_change)
end
