<string_table>
	<string id="ui_mcm_menu_dogma_game">
		<text>Game</text>
	</string>
	<string id="ui_mcm_menu_dogma_game_campfire_healing">
		<text>Campfire Healing</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_page_description">
		<text>Near a lit campfire, body, psy, and limbs heal on their own timers.</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_enabled">
		<text>Enabled</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_enabled_desc">
		<text>Off stops campfire healing and the orange tint.</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_range_m">
		<text>Range (m)</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_range_m_desc">
		<text>How close you must stand to a lit campfire.</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_pause_in_combat">
		<text>Pause while in combat</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_pause_in_combat_desc">
		<text>Pause healing while someone is fighting you.</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_body_sec">
		<text>Body: 20% every (sec)</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_body_sec_desc">
		<text>Seconds for body HP and psy to gain 20%.</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_limb_sec">
		<text>Limbs: 20% every (sec)</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_limb_sec_desc">
		<text>Seconds between turning temporary limb health into permanent on the worst limb.</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_fx_enable">
		<text>Healing tint</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_fx_enable_desc">
		<text>Orange tint while a campfire is healing you and body HP is below 100%.</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_fx_intensity">
		<text>Tint intensity</text>
	</string>
	<string id="ui_mcm_dogma_game_campfire_healing_fx_intensity_desc">
		<text>How strong the orange wash is. 0 = none.</text>
	</string>
