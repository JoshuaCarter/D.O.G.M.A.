--[[
	New Game loadout (UINewGame) uses the same UIInfoItem as inventory, but
	G.A.M.M.A. Accurate Defense Values only swaps stats_table in on_game_start —
	too late for the main-menu loadout screen, which still shows Anomaly bars.

	Also routes section-only descriptions through build_desc_header + footer so
	they match inventory tooltips (cost mods, etc.).
]]

local STATE = _G.__dogma_tooltips_loadout or {}
_G.__dogma_tooltips_loadout = STATE

local function apply_gamma_loadout_tooltips()
	if not STATE.stats_ok then
		if ish_item_stats and ish_item_stats.override_stats_table and utils_ui then
			ish_item_stats.override_stats_table()
			STATE.stats_ok = true
		elseif utils_ui then
			-- No ADV in load order; leave stock tables.
			STATE.stats_ok = true
		end
	end

	if not STATE.desc_ok and ui_item and ui_item.build_desc_footer then
		ui_item.get_sec_desc = function(sec)
			if not sec then
				return ""
			end
			local raw = ini_sys:r_string_ex(sec, "description")
			local str = (raw and game.translate_string(raw)) or ""
			if ui_item.build_desc_header then
				str = ui_item.build_desc_header(nil, sec, str)
			end
			return ui_item.build_desc_footer(nil, sec, str)
		end
		STATE.desc_ok = true
	end

	return STATE.stats_ok == true
end

_G.dogma_tooltips_loadout_apply = apply_gamma_loadout_tooltips

-- Non-zzzz mcm.script loads with the script engine (main menu), before New Game.
apply_gamma_loadout_tooltips()

function on_mcm_load(options)
	apply_gamma_loadout_tooltips()

	dogma_mcm.attach(options, "tooltips", "ui_mcm_menu_dogma_tooltips", {
		id = "loadout",
		sh = true,
		text = "ui_mcm_menu_dogma_tooltips_loadout",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_tooltips_loadout_page_description",
			},
		}),
	})
end

function on_game_start()
	-- ADV also runs here; re-apply so we stay last if load order flipped.
	STATE.stats_ok = false
	apply_gamma_loadout_tooltips()
end
