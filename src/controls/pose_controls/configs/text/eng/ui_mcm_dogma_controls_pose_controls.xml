<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_controls">
		<text>Controls</text>
	</string>
	<string id="ui_mcm_menu_dogma_controls_pose_controls">
		<text>Pose Controls</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_main_description">
		<text>Crouch crouches; Prone goes prone; Sprint sprints; Walk walks. Hold/Toggle and all four pose keys mirror into game Controls so names and binds always match.</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_hold_toggle">
		<text>Hold / Toggle</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_hold_toggle_desc">
		<text>Sets crouch, walk, and sprint hold/toggle together. First load copies crouch's current setting, then forces all three to match.</text>
	</string>
	<string id="dogma_controls_pose_controls_hold_toggle_lst_hold">
		<text>Hold</text>
	</string>
	<string id="dogma_controls_pose_controls_hold_toggle_lst_toggle">
		<text>Toggle</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_keys_desc">
		<text>These binds write to Options - Controls (Crouch / Prone / Sprint / Walk).</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_crouch_key">
		<text>Crouch</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_crouch_key_desc">
		<text>Always enters crouch pose.</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_prone_key">
		<text>Prone</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_prone_key_desc">
		<text>Always enters prone.</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_sprint_key">
		<text>Sprint</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_sprint_key_desc">
		<text>Vanilla sprint.</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_walk_key">
		<text>Walk</text>
	</string>
	<string id="ui_mcm_dogma_controls_pose_controls_walk_key_desc">
		<text>Only way to enter walk mode. Uses the Hold/Toggle mode above.</text>
	</string>
</string_table>
