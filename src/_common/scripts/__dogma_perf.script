--[[
	DOGMA perf timing (namespace module, no globals).

	Private impl; features use dogma.perf (wired by dogma.script).

	Prefer start/stop (no callback). time() is a thin wrapper for rare cases.

	start(mod_id, method[, threshold_us])
	  Label becomes "mod_id.method" (unique per feature). No-op if perf_log off
	  or during level load (on_game_load through actor_on_first_update).
	stop()
	  Pop; always record stats while logging; warn if slow; return elapsed_us.
	time(mod_id, method, fn)
	time(mod_id, method, threshold_us, fn)
	  start/fn/stop; returns fn's returns.

	Warnings require MCM dogma/debug perf_log. Threshold: call arg (µs) →
	perf_warn_threshold_us → ≤0 = no console warn. One console/xray line per
	key per 10s via console.say only (printf + say wrote the same line twice).

	dogma_perf.log records every stop while perf_log is on (threshold only
	gates console/xray warns). First flush is 10s after first_update. Then
	rewritten every ~10s as a fixed-width table:
	  n  n/s  min  max  avg  key
	Totals reset on game load (and when logging is toggled). Empty snapshots
	are never written, so quit/menu reload cannot blank the last flush.
	Failed writes cool down the same 10s — they do not retry every poll.
	Overwrite dogma_perf.log in place. Units: us.

	Timing uses engine profile_timer (QPC → microseconds) when available.
	os.clock fallback is ~1ms quantum and cannot resolve sub-ms work.
]]

local DEBUG_MOD = "dogma/debug"
local LOG_NAME = "dogma_perf.log"
local SEC_TO_US = 1000000
local FLUSH_INTERVAL_SEC = 10
local FLUSH_INTERVAL_MS = FLUSH_INTERVAL_SEC * 1000
local FLUSH_POLL_SEC = 1 -- poll cadence; write is gated by FLUSH_INTERVAL_MS
local stack = {}
-- [label] = { n, sum, min, max, first_ms }
local stats = {}
local last_flush_ms = 0
local flush_count = 0
local log_path = nil
local log_path_tried = false
-- Cached so hot start()/stop() paths avoid MCM lookups every call.
local logging_on = false
local load_quiet = true
-- [label] = last console-warn game_ms
local last_warn_ms = {}
local use_profile_timer = false

-- Detect once: luabind exposes profile_timer as a constructible class.
do
	local ok, t = pcall(function()
		return profile_timer()
	end)
	use_profile_timer = ok and t ~= nil and type(t.start) == "function"
		and type(t.stop) == "function" and type(t.time) == "function"
end

local function now_us_fallback()
	if os and os.clock then
		return os.clock() * SEC_TO_US
	end
	if time_global then
		return time_global() * 1000 -- ms → µs
	end
	return 0
end

local function resolve_log_path()
	if log_path_tried then
		return log_path
	end
	log_path_tried = true
	if not (getFS and getFS().update_path) then
		return nil
	end
	local ok, path = pcall(function()
		return getFS():update_path("$logs$", LOG_NAME)
	end)
	if ok and path and path ~= "" then
		log_path = path
	end
	return log_path
end

local function clear_stats()
	for k in pairs(stats) do
		stats[k] = nil
	end
	for k in pairs(last_warn_ms) do
		last_warn_ms[k] = nil
	end
	flush_count = 0
end

local function sorted_labels()
	local labels = {}
	for label in pairs(stats) do
		labels[#labels + 1] = label
	end
	table.sort(labels)
	return labels
end

local COL_HDR = string.format(
	"%-8s %-8s %-8s %-8s %-8s  %s",
	"n", "n/s", "min", "max", "avg", "key"
)
local SEP = "--------------------------------------------------------------------------------"

local function fmt_row(n, cps, min_v, max_v, avg, label)
	return string.format(
		"%-8d %-8.1f %-8d %-8d %-8d  %s",
		n,
		cps,
		math.floor(min_v + 0.5),
		math.floor(max_v + 0.5),
		math.floor(avg + 0.5),
		label
	)
end

local function has_stats()
	return next(stats) ~= nil
end

local function write_log(path, body)
	local ok, f = pcall(io.open, path, "w")
	if not (ok and f) then
		return false
	end
	f:write(body)
	f:close()
	return true
end

local function write_summary()
	local stamp = time_global and time_global() or 0
	-- Cool down before I/O so a locked file cannot retry every poll.
	last_flush_ms = stamp
	if not has_stats() then
		return
	end
	local path = resolve_log_path()
	if not path then
		return
	end
	local lines = {
		string.format(
			"# dogma_perf (us) flush=%d interval=%ds game_ms=%d\n",
			flush_count + 1,
			FLUSH_INTERVAL_SEC,
			stamp
		),
		SEP,
		"\n",
		COL_HDR,
		"\n",
		SEP,
		"\n",
	}
	for _, label in ipairs(sorted_labels()) do
		local s = stats[label]
		local avg = s.n > 0 and (s.sum / s.n) or 0
		local total_ms = stamp - (s.first_ms or stamp)
		if total_ms < 1 then
			total_ms = 1
		end
		local cps = s.n * 1000 / total_ms
		lines[#lines + 1] = fmt_row(s.n, cps, s.min, s.max, avg, label)
		lines[#lines + 1] = "\n"
	end
	if write_log(path, table.concat(lines)) then
		flush_count = flush_count + 1
	end
end

local function record(label, elapsed_us)
	local key = tostring(label or "?")
	local now = time_global and time_global() or 0
	local s = stats[key]
	if not s then
		stats[key] = {
			n = 1,
			sum = elapsed_us,
			min = elapsed_us,
			max = elapsed_us,
			first_ms = now,
		}
		return
	end
	s.n = s.n + 1
	s.sum = s.sum + elapsed_us
	if elapsed_us < s.min then
		s.min = elapsed_us
	end
	if elapsed_us > s.max then
		s.max = elapsed_us
	end
end

local function read_logging_enabled()
	local mcm = rawget(_G, "__dogma_mcm")
	if mcm and mcm.bool then
		return mcm.bool(DEBUG_MOD, "perf_log", false)
	end
	return false
end

local function flush_tick()
	if not logging_on then
		return true -- stop timer
	end
	local now = time_global and time_global() or 0
	if load_quiet then
		-- Same-frame CreateTimeEvent fire must not unquiet mid first_update.
		if (now - last_flush_ms) < 1 then
			return false
		end
		load_quiet = false
		last_flush_ms = now
		return false
	end
	-- CreateTimeEvent(return false) often re-fires without re-arming the delay.
	-- Gate the rewrite on game time so the log only updates every 10s.
	if (now - last_flush_ms) >= FLUSH_INTERVAL_MS then
		write_summary()
	end
	return false
end

local function ensure_flush_timer()
	if not CreateTimeEvent then
		return
	end
	if RemoveTimeEvent then
		pcall(RemoveTimeEvent, "dogma_perf", "flush")
	end
	CreateTimeEvent("dogma_perf", "flush", FLUSH_POLL_SEC, flush_tick)
end

local function begin_session(start_timer)
	clear_stats()
	stack = {}
	last_flush_ms = time_global and time_global() or 0
	if start_timer then
		ensure_flush_timer()
	end
end

function sync()
	local was_on = logging_on
	logging_on = read_logging_enabled()
	if logging_on and not was_on then
		begin_session(not load_quiet)
	elseif was_on and not logging_on then
		write_summary()
		clear_stats()
		stack = {}
		if RemoveTimeEvent then
			pcall(RemoveTimeEvent, "dogma_perf", "flush")
		end
	end
	return logging_on
end

local function default_threshold_us()
	local mcm = rawget(_G, "__dogma_mcm")
	if mcm and mcm.uint then
		local us = mcm.uint(DEBUG_MOD, "perf_warn_threshold_us", 0)
		if us > 0 then
			return us
		end
		-- Legacy mislabeled key (same numeric intent).
		return mcm.uint(DEBUG_MOD, "perf_warn_threshold_ns", 0)
	end
	return 0
end

-- Call override and MCM default are both microseconds.
local function effective_threshold_us(override_us)
	if override_us ~= nil then
		local n = tonumber(override_us)
		if n ~= nil then
			return math.max(0, math.floor(n + 0.5))
		end
	end
	return default_threshold_us()
end

local function warn_slow(label, elapsed_us, threshold_us)
	if not logging_on then
		return
	end
	if threshold_us <= 0 or elapsed_us < threshold_us then
		return
	end
	local now = time_global and time_global() or 0
	local prev = last_warn_ms[label]
	if prev and (now - prev) < FLUSH_INTERVAL_MS then
		return
	end
	last_warn_ms[label] = now
	local console = rawget(_G, "__dogma_console")
	if console and console.say then
		console.say(string.format(
			"[dogma_perf] SLOW %s took %dus (threshold %dus)",
			tostring(label or "?"),
			math.floor(elapsed_us + 0.5),
			threshold_us
		), "yellow")
	end
end

function start(mod_id, method, threshold_us)
	if not logging_on or load_quiet then
		return
	end
	local frame = {
		label = tostring(mod_id or "?") .. "." .. tostring(method or "?"),
		threshold = threshold_us,
	}
	if use_profile_timer then
		local ok, timer = pcall(profile_timer)
		if ok and timer then
			timer:start()
			frame.timer = timer
		else
			frame.t0 = now_us_fallback()
		end
	else
		frame.t0 = now_us_fallback()
	end
	stack[#stack + 1] = frame
end

function stop()
	local n = #stack
	if n < 1 then
		return nil
	end
	local frame = stack[n]
	stack[n] = nil

	local elapsed
	if frame.timer then
		frame.timer:stop()
		-- profile_timer:time() is already microseconds (engine QPC).
		elapsed = frame.timer:time() or 0
	else
		elapsed = now_us_fallback() - (frame.t0 or 0)
	end

	if logging_on then
		record(frame.label, elapsed)
		warn_slow(frame.label, elapsed, effective_threshold_us(frame.threshold))
	end
	return elapsed
end

-- time(mod, method, fn) or time(mod, method, threshold_us, fn)
function time(mod_id, method, a, b)
	local threshold_us, fn
	if type(a) == "function" then
		fn = a
	else
		threshold_us = a
		fn = b
	end
	if type(fn) ~= "function" then
		return
	end
	if not logging_on then
		return fn()
	end
	start(mod_id, method, threshold_us)
	-- Preserve all returns (Lua 5.1 `{ fn() }` only keeps the first).
	return (function(...)
		stop()
		return ...
	end)(fn())
end

-- Totals reset on game load only. Empty writes are skipped so the last
-- flush stays on disk through quit, menu reload, and crash.
if RegisterScriptCallback then
	RegisterScriptCallback("on_option_change", sync)
	RegisterScriptCallback("on_game_load", function()
		load_quiet = true
		stack = {}
		sync()
		if logging_on then
			begin_session(false)
		end
	end)
	RegisterScriptCallback("actor_on_first_update", function()
		sync()
		if logging_on then
			last_flush_ms = time_global and time_global() or 0
			ensure_flush_timer()
		end
	end)
end
