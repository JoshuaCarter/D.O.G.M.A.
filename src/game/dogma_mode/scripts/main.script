--[[
	DOGMA Mode — after D.O.G.M.A. Start: stamp dogma_mode, grant kit once.
	Start pistol is already in the loadout string so stock on_game_load gave boxes.
]]

local CONFIG = _G.dogma_game_dogma_mode_conf
local MOD_ID = (CONFIG and CONFIG.MOD_ID) or "dogma/game/dogma_mode"
local SAVE_KEY = "dogma_start_kit"
local MODE_KEY = "dogma_mode"
local PARTS_COND = 59
local START_MONEY = 500

local KIT = {
	{ sec = "itm_ammokit", n = 1 },
	{ sec = "medkit", n = 1, uses = 2 },
	{ sec = "yadylin", n = 2 },
	{ sec = "helm_resp", n = 1 },
}

local function is_pistol(sec)
	return sec and ini_sys and ini_sys:r_string_ex(sec, "kind") == "w_pistol"
end

local function flag_path()
	if CONFIG and CONFIG.flag_path then
		return CONFIG.flag_path()
	end
end

local function has_flag()
	local path = flag_path()
	if not path then
		return false
	end
	local f = io.open(path, "r")
	if not f then
		return false
	end
	f:close()
	return true
end

local function clear_flag()
	if CONFIG and CONFIG.clear_flag then
		CONFIG.clear_flag()
	end
end

local function game_obj(id)
	local obj = id and db.actor and db.actor.object_id and db.actor:object_id(id)
	if not obj and id and level and level.object_by_id then
		obj = level.object_by_id(id)
	end
	return obj
end

local function apply_parts(id)
	local obj = game_obj(id)
	if not (obj and item_parts and item_parts.get_parts_con and item_parts.set_parts_con) then
		return false
	end
	local parts = item_parts.get_parts_con(obj, nil, true)
	if type(parts) ~= "table" then
		return false
	end
	local any = false
	for k, _ in pairs(parts) do
		parts[k] = PARTS_COND
		any = true
	end
	if not any then
		return false
	end
	item_parts.set_parts_con(obj:id(), parts)
	return true
end

local function apply_uses(id, uses)
	local obj = game_obj(id)
	if obj and obj.set_remaining_uses then
		obj:set_remaining_uses(uses)
		return true
	end
	return false
end

local function later(name, id, fn)
	if fn(id) or not CreateTimeEvent then
		return
	end
	CreateTimeEvent(MOD_ID, name .. tostring(id), 0.1, function()
		fn(id)
		return true
	end)
end

local function grant_kit()
	if not has_flag() then
		return
	end
	if has_alife_info and has_alife_info("start_equippment_handled") then
		clear_flag()
		return
	end
	local actor = db.actor
	if not actor then
		return
	end
	local ok, m_data = pcall(function()
		return alife_storage_manager.get_state()
	end)
	if not (ok and m_data) then
		return
	end
	if m_data[SAVE_KEY] then
		clear_flag()
		return
	end
	m_data[SAVE_KEY] = true
	m_data[MODE_KEY] = true
	clear_flag()

	if actor.give_money then
		actor:give_money(START_MONEY - actor:money())
	end

	actor:iterate_inventory(function(_, itm)
		if itm and is_pistol(itm:section()) then
			later("parts_", itm:id(), apply_parts)
		end
	end)

	for i = 1, #KIT do
		local e = KIT[i]
		if not ini_sys or ini_sys:section_exist(e.sec) then
			for _ = 1, e.n do
				local se = alife_create_item(e.sec, actor)
				if e.uses and se and se.id then
					later("uses_", se.id, function(id)
						return apply_uses(id, e.uses)
					end)
				end
			end
		end
	end
end

function on_game_start()
	if CONFIG and dogma.load then
		dogma.load(MOD_ID)
	end
	if CONFIG and CONFIG.patch_new_game then
		CONFIG.patch_new_game()
	end
	RegisterScriptCallback("actor_on_first_update", grant_kit)
end
