<?xml version="1.0" encoding="windows-1251" ?>
<string_table>
	<string id="ui_mcm_menu_dogma_game">
		<text>Game</text>
	</string>
	<string id="ui_mcm_menu_dogma_game_ads_zoom">
		<text>ADS Zoom</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_ads_description">
		<text>World zoom while ADS, plus HUD zoom for irons, sights, and scopes. 0 = off.</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_enabled">
		<text>Enabled</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_enabled_desc">
		<text>Off restores stock ADS zoom.</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_binoculars_zoomed_out">
		<text>Binoculars start zoomed out</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_binoculars_zoomed_out_desc">
		<text>Raising binoculars starts zoomed out.</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_defaults_header">
		<text>ADS zoom</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_fov_zoom">
		<text>FOV zoom</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_fov_zoom_desc">
		<text>World zoom while ADS. Cap 15%. 0 = off. Magnified scopes keep their own zoom.</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_irons">
		<text>Irons</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_irons_desc">
		<text>HUD zoom for iron sights. Cap 15%. 0 = off.</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_sight">
		<text>Sights</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_sight_desc">
		<text>HUD zoom for non-magnified sights. Cap 25%. 0 = off.</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_scope">
		<text>Scopes</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_scope_desc">
		<text>HUD zoom for magnified scopes. Cap 35%. 0 = off.</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_keys_header">
		<text>This weapon</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_inc_key">
		<text>Increase ADS zoom</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_inc_key_desc">
		<text>While ADS, raise HUD zoom for this weapon and sight.</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_dec_key">
		<text>Decrease ADS zoom</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_dec_key_desc">
		<text>While ADS, lower HUD zoom for this weapon and sight.</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_reset_key">
		<text>Reset ADS zoom</text>
	</string>
	<string id="ui_mcm_dogma_game_ads_zoom_wads_reset_key_desc">
		<text>Clear this weapon's HUD zoom and use the default again.</text>
	</string>
</string_table>
