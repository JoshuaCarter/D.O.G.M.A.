--[[
	Pose Controls

	Maps movement pose keys directly instead of cycling:
	- Crouch bind -> crouch only (mcCrouch, never mcAccel)
	- Walk/Low Crouch bind -> prone only (mcCrouch + mcAccel)
	- Sprint bind -> vanilla stand + sprint
	- Walk bind (CONFIG.BINDS.walk) -> walk only (mcAccel without mcCrouch)

	MCM Hold/Toggle and pose keys mirror Options→Controls
	(live curr/functor - not axr copies).
	Hold/Toggle forces g_crouch_toggle / g_walk_toggle / g_sprint_toggle to match.

	FDDA body search / Faster Skinning briefly flip g_crouch_toggle to pulse
	crouch. We cache the player's real preference so that trick does not yank us
	into toggle handling, and we pass those scripted pulses straight through.

	Engine move states remain the source of truth so true_prone and other
	mods can read pose via IsMoveState("mcCrouch") / IsMoveState("mcAccel").

	Toggle: keys only set the latest wanted pose. One XOR pulse per frame.
	Same-goal spam is ignored. A different key replaces intent.

	Limp: flags lie (XOR adds accel). Crouch key = crouch box, prone key = prone box.
	Arrival is cam height. Do not stand-retry while cam lerps.

	Optional: while sprinting, Lean Left/Right pulse free look instead of lean.
	If Free Look is unbound, a script-only virtual key is bound for the pulse.
]]

local CONFIG = _G.dogma_input_pose_controls_conf

local POSE = {
	STAND = "stand",
	CROUCH = "crouch",
	PRONE = "prone",
	WALK = "walk",
}

local BLOCKED_MOVE_STATES = {
	mcJump = true,
	mcFall = true,
	mcClimb = true,
}

local LOG = {
	POSE = { order = 1, color = "yellow" },
	KEY = { order = 2, color = "cyan" },
}

local applying_pose = false
-- g_walk_toggle flip for limp-prone must not run on_option_change (it would restore toggle).
local mute_option = false
local pending_goal = nil
-- Pose we last pulsed from. Toggle XOR must not fire again until the engine moves.
local step_from = nil
-- Limp: we pulsed crouch from walk with wishful accel. Wait for cam, do not stand back up.
local limp_prone_entering = false
-- Player preference from MCM sync. Not the live console value -
-- other mods temporarily flip g_crouch_toggle for scripted crouch pulses.
local cached_crouch_toggle = false
-- Hold-mode free look dies unless its own key is down. Toggle stays after a pulse.
local sprint_freelook_on = false
local saved_freelook_toggle = nil
local bind_dik

local bind_accel = function() return key_bindings.kACCEL end

local bind_crouch = function() return key_bindings.kCROUCH end

local bind_walk = function()
	return dogma.keys.bind_kb(CONFIG.BINDS.walk.kb)
end

local bind_sprint = function() return key_bindings.kSPRINT_TOGGLE or key_bindings.kSPRINT end

local ENGINE_BINDS = {
	crouch = { action = "crouch", bind = bind_crouch, mcm = "crouch_key" },
	prone = { action = "accel", bind = bind_accel, mcm = "prone_key" },
	sprint = {
		action = "sprint_toggle",
		bind = bind_sprint,
		mcm = "sprint_key",
	},
	walk = {
		action = CONFIG.BINDS.walk.action,
		bind = bind_walk,
		mcm = "walk_key",
	},
}

local TOGGLE_CMDS = { "g_crouch_toggle", "g_walk_toggle", "g_sprint_toggle" }

local function log(msg)
	if not (dogma.log) then
		return
	end
	if CONFIG.loaded.debug_log then
		dogma.log.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function overlay(log_type, msg)
	if not (dogma.overlay) then
		return
	end
	if CONFIG.loaded.debug_overlay then
		local slot = log_type or LOG.POSE
		dogma.overlay.set(CONFIG.MOD_ID, slot.order, tostring(msg), slot.color)
	end
end

local function get_pose()
	if IsMoveState("mcCrouch") then
		if IsMoveState("mcAccel") then
			return POSE.PRONE
		end
		return POSE.CROUCH
	end
	if IsMoveState("mcAccel") then
		return POSE.WALK
	end
	return POSE.STAND
end

local try_actor_limping = function(actor)
	return actor:cast_Actor():conditions():IsLimping()
end

local try_cam_height = function(actor)
	return device().cam_pos.y - actor:position().y
end

local function is_limping()
	local actor = db and db.actor
	if not actor then
		return false
	end
	local ok, v = pcall(try_actor_limping, actor)
	return ok and v
end

-- Limp XOR sets mcAccel on real only. Flags then read as prone while cam is still crouch.
-- Box is picked from wishful accel at crouch-enter: accel on = box 2 (prone), off = box 1.
-- Cam lerps; do not treat a mid-lerp sample as a miss.
local function cam_posture()
	local actor = db and db.actor
	if not actor then
		return POSE.STAND
	end
	local ok, h = pcall(try_cam_height, actor)
	if not (ok and h) then
		return POSE.STAND
	end
	local stand_h = 1.65
	local crouch_h = 1.2
	local prone_h = 0.45
	local conf = _G.dogma_game_true_prone_conf
	if conf and conf.loaded then
		stand_h = conf.loaded.cam_height_stand or stand_h
		crouch_h = conf.loaded.cam_height_crouch or crouch_h
		prone_h = conf.loaded.cam_height_prone or prone_h
	end
	local ds = math.abs(h - stand_h)
	local dc = math.abs(h - crouch_h)
	local dp = math.abs(h - prone_h)
	if dp <= dc and dp <= ds then
		return POSE.PRONE
	end
	if dc <= ds then
		return POSE.CROUCH
	end
	return POSE.STAND
end

-- Limp flags lie. Arrival is cam height.
local function pose_reached(goal, pose)
	if is_limping() then
		local cam = cam_posture()
		if goal == POSE.PRONE then
			return cam == POSE.PRONE
		end
		if goal == POSE.CROUCH then
			return cam == POSE.CROUCH
		end
		return cam == POSE.STAND
	end
	return pose == goal
end

-- Limp forces mcAccel. Stand is walk. Crouch and prone stay distinct (box 1 vs 2).
local function resolve_goal(goal)
	if not is_limping() then
		return goal
	end
	if goal == POSE.STAND then
		return POSE.WALK
	end
	return goal
end

local function use_hold_mode()
	return not cached_crouch_toggle
end

local function mod_active()
	return CONFIG.loaded.enabled
end

-- Let FDDA / skinning crouch pulses hit the engine instead of our key remap.
local function passthrough_scripted_pose_pulse()
	-- Those mods only force-enable toggle for a press/release; never force-disable.
	local live_crouch_toggle = get_console_cmd(1, "g_crouch_toggle") or false
	if live_crouch_toggle and not cached_crouch_toggle then
		return true
	end
	if _G.lam2 and lam2.get_current_action then
		local action = lam2.get_current_action()
		if action and action.tag == "body_search" then
			return true
		end
	end
	return false
end

-- DIK -> console bind token handled by dogma.keys (via dogma.mcm).
-- main only reads engine binds.
local function engine_bind_dik(kb)
	local bind = kb.bind()
	if not bind then
		return
	end
	local dik = bind_to_dik(bind)
	if dik and dik ~= 0 then
		return dik
	end
end

local function set_engine_toggle(toggle_on)
	local word = toggle_on and "1" or "0"
	for _, cmd in ipairs(TOGGLE_CMDS) do
		exec_console_cmd(cmd .. " " .. word)
	end
	log(string.format("toggle modes -> %s", word))
end

-- Mirror Hold/Toggle + crouch/prone/sprint/walk from Options→Controls.
-- MCM key rows use curr/functor so they always show engine binds; this only
-- refreshes CONFIG.loaded and keeps walk/sprint toggle bits matched to crouch.
local function sync_mirrored_controls()
	local crouch_toggle = get_console_cmd(1, "g_crouch_toggle") or false
	CONFIG.loaded.toggle_mode = crouch_toggle and true or false
	cached_crouch_toggle = CONFIG.loaded.toggle_mode
	-- Keep the three engine toggle cmds matched while the feature is on.
	set_engine_toggle(CONFIG.loaded.toggle_mode)

	for _, kb in pairs(ENGINE_BINDS) do
		CONFIG.loaded[kb.mcm] = engine_bind_dik(kb)
	end
end

local function is_lookout_bind(bind)
	return bind == key_bindings.kL_LOOKOUT or bind == key_bindings.kR_LOOKOUT
end

local function dik_down(bind)
	local dik = bind_dik(bind)
	return dik and dogma.input.is_key_down(dik)
end

local function lookout_held()
	return dik_down(key_bindings.kL_LOOKOUT) or dik_down(key_bindings.kR_LOOKOUT)
end

-- Script-only dik (not a real key). press_action can fire it; keyboard cannot.
local FREELOOK_GHOST_KEY = "kCUSTOM99"
local FREELOOK_GHOST_DIK = 1099

local function pulse_freelook()
	local dik = bind_dik(key_bindings.kFREELOOK)
	local ghost = not dik
	if ghost then
		exec_console_cmd("bind freelook " .. FREELOOK_GHOST_KEY)
		dik = FREELOOK_GHOST_DIK
	end
	level.press_action(dik)
	level.release_action(dik)
	if ghost then
		exec_console_cmd("unbind freelook")
	end
end

local function stop_sprint_freelook()
	if not sprint_freelook_on then
		return
	end
	if db.actor then
		pulse_freelook()
	end
	if not saved_freelook_toggle then
		exec_console_cmd("g_freelook_toggle 0")
	end
	saved_freelook_toggle = nil
	sprint_freelook_on = false
end

local function start_sprint_freelook()
	if sprint_freelook_on then
		return
	end
	saved_freelook_toggle = get_console_cmd(1, "g_freelook_toggle") or false
	if not saved_freelook_toggle then
		exec_console_cmd("g_freelook_toggle 1")
	end
	pulse_freelook()
	sprint_freelook_on = true
end

local function want_sprint_freelook()
	return CONFIG.loaded.sprint_lean_freelook
		and dogma.status.is_sprinting()
		and lookout_held()
end

local function sync_sprint_freelook()
	if want_sprint_freelook() then
		start_sprint_freelook()
	else
		stop_sprint_freelook()
	end
end

local function on_option_change()
	if mute_option then
		return
	end
	CONFIG.loaded.enabled = true
	-- Promote legacy MCM-only walk DIK into Controls if unbound.
	dogma.mcm.migrate_key_to_mirror(CONFIG.MOD_ID, "walk_key", CONFIG.BINDS.walk)
	CONFIG.loaded.debug_log = dogma.log.logging()
	CONFIG.loaded.debug_overlay = dogma.overlay.enabled()
	CONFIG.loaded.sprint_lean_freelook = dogma.mcm.bool(CONFIG.MOD_ID, "sprint_lean_freelook")
	-- Always refresh mirrored CONFIG.loaded from Controls (MCM curr already wrote
	-- Accept changes into the engine).
	sync_mirrored_controls()
	if not CONFIG.loaded.sprint_lean_freelook then
		stop_sprint_freelook()
	end
end

-- Keys need a free HUD. Pending pose steps may finish during loot UI.
local function actor_can_change_pose()
	if not dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return false
	end
	if device():is_paused() then
		return false
	end
	for state in pairs(BLOCKED_MOVE_STATES) do
		if IsMoveState(state) then
			return false
		end
	end
	return true
end

local function input_allowed()
	return actor_can_change_pose() and actor_menu and actor_menu.is_hud_free and actor_menu.is_hud_free()
end

local function is_walk_bind(bind)
	local walk = dogma.keys.bind_kb(CONFIG.BINDS.walk.kb)
	return walk and bind == walk
end

local function is_sprint_bind(bind)
	return bind == key_bindings.kSPRINT_TOGGLE or bind == key_bindings.kSPRINT
end

bind_dik = function(bind)
	local dik = bind_to_dik(bind)
	if dik and dik ~= 0 then
		return dik
	end
end

local function block(flags)
	if flags then
		flags.ret_value = false
	end
end

local function with_synthetic_input(fn)
	applying_pose = true
	fn()
	applying_pose = false
end

local function pulse_bind(bind)
	local dik = bind_dik(bind)
	if not dik then
		return
	end
	level.press_action(dik)
	level.release_action(dik)
end

local function set_bind_down(bind, down)
	local dik = bind_dik(bind)
	if not dik then
		return
	end
	if down then
		level.press_action(dik)
	else
		level.release_action(dik)
	end
end

local function hold_bind(bind)
	local dik = bind_dik(bind)
	if dik then
		level.hold_action(dik)
	end
end

-- Hold-mode accel ORs wishful. Toggle XOR can turn it off. Flip walk toggle off for the hold.
local function or_wishful_accel()
	local restore = not use_hold_mode()
	if restore then
		mute_option = true
		exec_console_cmd("g_walk_toggle 0")
	end
	hold_bind(key_bindings.kACCEL)
	if restore then
		exec_console_cmd("g_walk_toggle 1")
		mute_option = false
	end
end

-- Toggle: one XOR pulse per step. Do not pulse again until the engine pose changes.
local function step_toward(goal)
	goal = resolve_goal(goal)
	local pose = get_pose()
	if pose_reached(goal, pose) then
		if step_from or limp_prone_entering then
			log(string.format("arrived %s flags=%s cam=%s limp=%s", goal, pose, cam_posture(), tostring(is_limping())))
		end
		step_from = nil
		limp_prone_entering = false
		return true
	end
	-- Limp: flags flip before cam. Wait. Exception: uncrouch landed, now enter prone.
	if is_limping() and step_from then
		local uncrouch_landed = goal == POSE.PRONE and not limp_prone_entering
			and (pose == POSE.WALK or pose == POSE.STAND)
		if not uncrouch_landed then
			return false
		end
	elseif step_from == pose then
		return false
	end

	if goal == POSE.STAND then
		if pose == POSE.PRONE then
			pulse_bind(key_bindings.kACCEL)
		elseif pose == POSE.CROUCH then
			pulse_bind(key_bindings.kCROUCH)
		elseif pose == POSE.WALK then
			pulse_bind(key_bindings.kACCEL)
		end
	elseif goal == POSE.CROUCH then
		if pose == POSE.PRONE then
			pulse_bind(key_bindings.kACCEL)
		elseif pose == POSE.WALK then
			-- Limp walk already has accel. XOR walk would no-op; crouch enter is box 1.
			if is_limping() then
				pulse_bind(key_bindings.kCROUCH)
			else
				pulse_bind(key_bindings.kACCEL)
			end
		elseif pose == POSE.STAND then
			pulse_bind(key_bindings.kCROUCH)
		end
	elseif goal == POSE.PRONE then
		if is_limping() then
			if pose == POSE.WALK or pose == POSE.STAND then
				or_wishful_accel()
				limp_prone_entering = true
				log(string.format("limp prone enter cam=%s", cam_posture()))
				pulse_bind(key_bindings.kCROUCH)
			else
				-- Box 2 only on crouch-enter from walk. One uncrouch, then enter next frame.
				log(string.format("limp prone uncrouch first flags=%s cam=%s", pose, cam_posture()))
				pulse_bind(key_bindings.kCROUCH)
			end
		elseif pose == POSE.WALK or pose == POSE.STAND then
			pulse_bind(key_bindings.kCROUCH)
		elseif pose == POSE.CROUCH then
			pulse_bind(key_bindings.kACCEL)
		end
	elseif goal == POSE.WALK then
		if pose == POSE.PRONE then
			pulse_bind(key_bindings.kCROUCH)
		elseif pose == POSE.CROUCH then
			pulse_bind(key_bindings.kCROUCH)
		elseif pose == POSE.STAND then
			pulse_bind(key_bindings.kACCEL)
		end
	end

	log(string.format("step %s -> %s limp=%s cam=%s", pose, goal, tostring(is_limping()), cam_posture()))
	step_from = pose
	return pose_reached(goal, get_pose())
end

local function drop_pending(reason)
	if not pending_goal then
		return
	end
	log(string.format("drop pending %s (%s)", pending_goal, reason))
	pending_goal = nil
	step_from = nil
	limp_prone_entering = false
end

local function finish_pending()
	if not pending_goal then
		return
	end
	if dogma.status.is_sprinting() then
		drop_pending("sprint")
		return
	end
	if step_toward(pending_goal) then
		pending_goal = nil
		step_from = nil
		limp_prone_entering = false
	end
end

-- Latest key wins. Do not pulse here; actor_on_update does one step per frame.
local function request_pose(goal)
	goal = resolve_goal(goal)
	local pose = get_pose()
	if pose_reached(goal, pose) then
		pending_goal = nil
		step_from = nil
		limp_prone_entering = false
		return
	end
	if pending_goal == goal then
		return
	end
	pending_goal = goal
	step_from = nil
	limp_prone_entering = false
	log(string.format("request %s (engine: %s limp=%s cam=%s)", goal, pose, tostring(is_limping()), cam_posture()))
end

local function on_before_key_press(key, bind, _dis, flags)
	if applying_pose or not mod_active() or not input_allowed() then
		return
	end

	if CONFIG.loaded.sprint_lean_freelook and is_lookout_bind(bind) and dogma.status.is_sprinting() then
		block(flags)
		start_sprint_freelook()
		return
	end

	-- Sprint owns stand. Do not XOR crouch/accel back on after the engine clears them.
	if is_sprint_bind(bind) then
		drop_pending("sprint key")
		return
	end

	if is_walk_bind(bind) then
		if use_hold_mode() then
			block(flags)
		else
			block(flags)
			if get_pose() == POSE.WALK then
				request_pose(POSE.STAND)
			else
				request_pose(POSE.WALK)
			end
			overlay(LOG.KEY, "walk key")
		end
		return
	end

	-- Scripted crouch pulses (FDDA body search, Faster Skinning) - leave alone.
	if passthrough_scripted_pose_pulse() then
		return
	end

	if bind == key_bindings.kCROUCH then
		if not use_hold_mode() then
			block(flags)
			if is_limping() then
				if cam_posture() == POSE.CROUCH then
					request_pose(POSE.STAND)
				else
					request_pose(POSE.CROUCH)
				end
			elseif get_pose() == POSE.CROUCH then
				request_pose(POSE.STAND)
			else
				request_pose(POSE.CROUCH)
			end
			overlay(LOG.KEY, "crouch key")
		end
	elseif bind == key_bindings.kACCEL and not use_hold_mode() then
		block(flags)
		if is_limping() then
			if cam_posture() == POSE.PRONE then
				request_pose(POSE.STAND)
			else
				request_pose(POSE.PRONE)
			end
		elseif get_pose() == POSE.PRONE then
			request_pose(POSE.STAND)
		else
			request_pose(POSE.PRONE)
		end
		overlay(LOG.KEY, "prone key")
	end
end

local try_on_before_key_hold = function()
	hold_bind(key_bindings.kCROUCH)
	hold_bind(key_bindings.kACCEL)
end

local try_on_before_key_hold_2 = function()
	if not is_limping() and IsMoveState("mcAccel") then
		set_bind_down(key_bindings.kACCEL, false)
	end
	hold_bind(key_bindings.kCROUCH)
end

local try_on_before_key_hold_3 = function()
	if IsMoveState("mcCrouch") then
		set_bind_down(key_bindings.kCROUCH, false)
	end
	hold_bind(key_bindings.kACCEL)
end

local function on_before_key_hold(key, bind, _dis, flags)
	if applying_pose or not mod_active() or not input_allowed() then
		return
	end

	if CONFIG.loaded.sprint_lean_freelook and is_lookout_bind(bind) and dogma.status.is_sprinting() then
		block(flags)
		start_sprint_freelook()
		return
	end

	if is_sprint_bind(bind) then
		drop_pending("sprint hold")
		return
	end

	if not use_hold_mode() then
		return
	end

	if passthrough_scripted_pose_pulse() then
		return
	end

	if is_walk_bind(bind) then
		block(flags)
		with_synthetic_input(try_on_before_key_hold_3)
		return
	end

	if bind == key_bindings.kCROUCH then
		block(flags)
		with_synthetic_input(try_on_before_key_hold_2)
	elseif bind == key_bindings.kACCEL then
		block(flags)
		with_synthetic_input(try_on_before_key_hold)
	end
end

local try_on_before_key_release = function()
	set_bind_down(key_bindings.kACCEL, false)
end

local function on_before_key_release(key, bind, _dis, flags)
	if applying_pose or not mod_active() or not input_allowed() then
		return
	end

	if passthrough_scripted_pose_pulse() then
		return
	end

	if use_hold_mode() then
		if is_walk_bind(bind) and get_pose() == POSE.WALK then
			with_synthetic_input(try_on_before_key_release)
			pending_goal = nil
			log(string.format("walk key release -> %s", get_pose()))
		end
		return
	end

	if bind == key_bindings.kCROUCH or bind == key_bindings.kACCEL then
		block(flags)
	end
end

local function on_actor_on_first_update()
	dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change)
end

local function on_actor_on_update()
	if not dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return
	end

	-- Finish in-progress transitions even while loot UI is open (FDDA body search).
	if pending_goal and mod_active() and actor_can_change_pose() and not use_hold_mode() then
		with_synthetic_input(finish_pending)
	end

	if mod_active() and input_allowed() then
		sync_sprint_freelook()
	else
		stop_sprint_freelook()
	end

	overlay(LOG.POSE, "pose: " .. get_pose())
end

local function reset_pose_state()
	pending_goal = nil
	step_from = nil
	limp_prone_entering = false
	stop_sprint_freelook()
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)

	RegisterScriptCallback("on_before_key_press", on_before_key_press)
	RegisterScriptCallback("on_before_key_hold", on_before_key_hold)
	RegisterScriptCallback("on_before_key_release", on_before_key_release)
	RegisterScriptCallback("actor_on_first_update", on_actor_on_first_update)
	RegisterScriptCallback("actor_on_update", on_actor_on_update)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("on_game_load", reset_pose_state)
	RegisterScriptCallback("main_menu_on_init", reset_pose_state)
	RegisterScriptCallback("actor_on_net_destroy", reset_pose_state)
	log("loaded")
end
