--[[
	Fix Ammo Aggregation Crash

	Vanilla item_weapon.ammo_aggregation releases ammo game objects whose
	server entity is already gone. alife_release dumps a stack and the
	process dies the same tick (close inventory + draw weapon is a common
	window).

	Wrap the stock functions. Do not reimplement merge or the verybad->bad
	replace; that convert is how old ammo started showing up.
]]

local CONFIG = _G.dogma_tweaks_fix_ammo_aggregation_crash_conf

local try_id = function(obj) return obj:id() end

local orig_agg

local function log(msg)
	dogma.log.log(CONFIG.MOD_ID, msg)
end

local function wrap_agg(obj, npc)
	if obj then
		local ok, id = pcall(try_id, obj)
		if not (ok and id and alife_object(id)) then
			log("skip agg, no se")
			return true
		end
	end
	return orig_agg(obj, npc)
end

local function patch()
	local iw = _G.item_weapon
	if not iw or iw._dogma_ammo_agg_crash then
		return iw and iw._dogma_ammo_agg_crash or false
	end
	if type(iw.ammo_aggregation) ~= "function" then
		return false
	end
	orig_agg = iw.ammo_aggregation
	iw.ammo_aggregation = wrap_agg
	iw._dogma_ammo_agg_crash = true
	log("patched item_weapon.ammo_aggregation")
	return true
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	patch()
	RegisterScriptCallback("actor_on_first_update", patch)
	RegisterScriptCallback("on_game_load", patch)
end
