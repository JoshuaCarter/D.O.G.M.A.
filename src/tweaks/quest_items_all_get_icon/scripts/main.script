--[[
	Quest Item Icon

	Utjan's fetch-item icon matches bring-X tasks by section (`task_id.."_fetch"`).
	Quest items (kind i_quest / quest_item) never hit that path.

	Same secondary-mission overlay on every quest item. Skip the wallet
	(`cash`) and sections Utjan already marks so the chip does not draw twice.
]]

local CONFIG = _G.dogma_tweaks_quest_items_all_get_icon_conf

local HOOK_STATE = _G.__dogma_quest_items_all_get_icon or {}
_G.__dogma_quest_items_all_get_icon = HOOK_STATE

local function is_fetch_section(sec)
	local actor = db.actor
	local tm = task_manager and task_manager.get_task_manager and task_manager.get_task_manager()
	local info = tm and tm.task_info
	if not (actor and info and sec) then
		return false
	end
	for task_id, _ in pairs(info) do
		if actor:get_task(task_id, true) then
			local fetch = load_var(actor, task_id .. "_fetch", "")
			if fetch ~= "" and fetch == sec then
				return true
			end
		end
	end
	return false
end

local function quest_item_icon(cell, obj, sec)
	if not (sec and IsItem and IsItem("quest", sec)) then
		return
	end
	if sec == "cash" or is_fetch_section(sec) then
		return
	end
	local axis = utils_xml.get_item_axis(sec)
	return {
		texture = "ui_inGame2_PDA_icon_Secondary_mission",
		x = (axis.w - 13),
		y = 1,
		w = 12,
		h = 12,
	}
end

local function register_icon()
	if HOOK_STATE.icon_registered then
		return
	end
	if not (rax_icon_layers and rax_icon_layers.register) then
		return
	end
	rax_icon_layers.register("dogma_quest_items_all_get_icon", quest_item_icon)
	HOOK_STATE.icon_registered = true
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	register_icon()
end
