function on_mcm_load(options)
	local CONF = _G.dogma_mutants_skinning_conf
	local D = CONF.defaults
	dogma_mcm.attach(options, "mutants", "ui_mcm_menu_dogma_mutants", {
		id = "skinning",
		sh = true,
		text = "ui_mcm_menu_dogma_mutants_skinning",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_skinning_page_description",
			},
			{
				id = "enabled",
				type = "check",
				val = 1,
				def = D["enabled"],
				hint = "dogma_faster_skinning_enabled",
			},
			{
				id = "skin_speed_multiplier",
				type = "track",
				val = 2,
				min = 1,
				max = 2,
				step = 0.1,
				def = D["skin_speed_multiplier"],
				hint = "dogma_faster_skinning_skin_speed_multiplier",
			},
			{
				id = "auto_crouch",
				type = "check",
				val = 1,
				def = D["auto_crouch"],
				hint = "dogma_faster_skinning_auto_crouch",
			},
			{
				id = "look_at_mutant",
				type = "check",
				val = 1,
				def = D["look_at_mutant"],
				hint = "dogma_faster_skinning_look_at_mutant",
			},
			{
				id = "look_at_offset",
				type = "track",
				val = 2,
				min = 0,
				max = 1,
				step = 0.05,
				def = D["look_at_offset"],
				hint = "dogma_faster_skinning_look_at_offset",
			},
			{
				id = "slash_loot",
				type = "check",
				val = 1,
				def = D["slash_loot"],
				hint = "dogma_faster_skinning_slash_loot",
			},
		}),
	})
end
