function on_mcm_load(options)
	local CONFIG = _G.dogma_gameplay_exo_power_conf
	local d = CONFIG.DEFAULTS
	dogma_mcm.attach(options, "gameplay", "ui_mcm_menu_dogma_gameplay", {
		id = "exo_power",
		sh = true,
		text = "ui_mcm_menu_dogma_gameplay_exo_power",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_gameplay_exo_power_page_description",
			},
			-- Idle default is 0 (2x still 0) - no slider; always no idle drain.
			{
				id = "run_drain",
				type = "track",
				val = 2,
				min = d.run_drain,
				max = d.run_drain * 2,
				step = 0.1,
				def = d.run_drain,
				hint = "dogma_gameplay_exo_power_run_drain",
			},
			{
				id = "sprint_drain",
				type = "track",
				val = 2,
				min = d.sprint_drain,
				max = d.sprint_drain * 2,
				step = 0.1,
				def = d.sprint_drain,
				hint = "dogma_gameplay_exo_power_sprint_drain",
			},
		}),
	})
end
