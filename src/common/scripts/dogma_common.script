--[[
	DOGMA common loader (vendored into DOGMA — stable, no commit hash).

	Ships alongside dogma_mcm / dogma_dbg / dogma_sys as dogma_common.script.
	X-Ray auto-loads every .script file in gamedata/scripts at boot, so this
	and its 3 siblings are already loaded globals by the time any mod's
	on_game_start() runs — no process_file() call needed.

	Usage from a feature main.script:

		local MOD_ID = "dogma/feature"  -- MCM path under collection "dogma"

		local DOGMA

		function on_game_start()
			DOGMA = _G.dogma_common.load(MOD_ID)
			-- ...
		end

	Resolve via _G.dogma_common and call load() inside on_game_start()
	only — never at the top level of the script, since load order across
	auto-loaded files isn't guaranteed there.
]]

local SUFFIX = ""

function load(mod_id)
	local mcm = _G["dogma_mcm" .. SUFFIX]
	local dbg = _G["dogma_dbg" .. SUFFIX]
	local sys = _G["dogma_sys" .. SUFFIX]
	sys.set_deps(mcm, dbg)
	if mod_id then
		sys.reset_mod(mod_id)
		dbg.clear_source(mod_id)
	end
	printf("[DOGMA] %s: common loaded (vendored)", tostring(mod_id))
	return { mcm = mcm, dbg = dbg, sys = sys }
end
