<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_controls">
		<text>Controls</text>
	</string>
	<string id="ui_mcm_menu_dogma_controls_equipment_controls">
		<text>Equipment Controls</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_page_description">
		<text>Keys mirror Settings - Controls (same names). Melee / Pistol / Binoculars only act when that item is in melee or vision; otherwise the key does nothing. Detector / Geiger / RF / Glowstick / Flashlight put devices in the detector slot. Torch toggles your headlamp when equipped, or draws a handheld flashlight when not.</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_auto_bolt_on_detector">
		<text>Draw bolt with detector</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_auto_bolt_on_detector_desc">
		<text>Draws your bolt when you draw an artefact detector (not RF, Geiger, or Glowstick).</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_melee_key">
		<text>Weapon 1 (Melee)</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_melee_key_desc">
		<text>Always draws a knife from melee or vision (swaps if needed). Does nothing if you have no knife there.</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_secondary_key">
		<text>Weapon 2 (Secondary)</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_secondary_key_desc">
		<text>Draws your secondary weapon.</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_primary_key">
		<text>Weapon 3 (Primary)</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_primary_key_desc">
		<text>Draws your primary weapon.</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_tertiary_key">
		<text>Weapon 4 (Pistol)</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_tertiary_key_desc">
		<text>Always draws a pistol from melee or vision (swaps if needed). Does nothing if you have no pistol there.</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_grenade_key">
		<text>Grenade</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_grenade_key_desc">
		<text>Equips a grenade.</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_grenade_throw_key">
		<text>Grenade quick-throw</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_grenade_throw_key_desc">
		<text>Throws a grenade without equipping it first.</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_bolt_key">
		<text>Bolt</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_bolt_key_desc">
		<text>Equips your bolt.</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_vision_key">
		<text>Binoculars</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_vision_key_desc">
		<text>If binoculars are in melee or vision, swaps those holsters then draws melee. Does nothing if you have no binoculars.</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_key_detector">
		<text>Detector</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_key_detector_desc">
		<text>Puts an artefact detector in the detector slot. Press again to put away.</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_key_geiger">
		<text>Geiger Counter</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_key_geiger_desc">
		<text>Puts a geiger in the detector slot. Press again to put away.</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_key_radio">
		<text>RF Scanner</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_key_radio_desc">
		<text>Puts an RF receiver in the detector slot. Press again to put away.</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_key_torch">
		<text>Torch</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_key_torch_desc">
		<text>With a headlamp equipped, toggles it normally. Without one, puts a handheld flashlight in the detector slot. Press again to put away. Does nothing if you have neither.</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_key_glowstick">
		<text>Glowstick</text>
	</string>
	<string id="ui_mcm_dogma_controls_equipment_controls_key_glowstick_desc">
		<text>Puts a glowstick in the detector slot (left hand). Press again to put away.</text>
	</string>
</string_table>
