<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_game">
		<text>Game</text>
	</string>
	<string id="ui_mcm_menu_dogma_game_escort_tweaks">
		<text>Escort Tweaks</text>
	</string>
	<string id="ui_mcm_dogma_game_escort_tweaks_page_description">
		<text>Escorts join you alone, late escorts leave unpaid, and Fanatic stays in Cordon. Each part can be turned off.</text>
	</string>
	<string id="ui_mcm_dogma_game_escort_tweaks_solo">
		<text>Escorts join alone</text>
	</string>
	<string id="ui_mcm_dogma_game_escort_tweaks_solo_desc">
		<text>Only the person you talk to joins. Story squads and hostages still join as a group.</text>
	</string>
	<string id="ui_mcm_dogma_game_escort_tweaks_unpaid">
		<text>Late escorts leave unpaid</text>
	</string>
	<string id="ui_mcm_dogma_game_escort_tweaks_unpaid_desc">
		<text>They walk off and do not take your money.</text>
	</string>
	<string id="ui_mcm_dogma_game_escort_tweaks_fanatic">
		<text>Fanatic stays in Cordon</text>
	</string>
	<string id="ui_mcm_dogma_game_escort_tweaks_fanatic_desc">
		<text>He does not follow you out. Leave with him and Training Day is cancelled.</text>
	</string>
	<string id="st_dogma_game_escort_tweaks_leave">
		<text>Then I'll continue on my own. You won't get paid. What a shame.</text>
	</string>
</string_table>
