		{
			id = "wads_key_mode",
			type = kb_mod,
			val = 2,
			def = 0,
			hint = "dorn_free_zoom_wads_key_mode",
			content = {
				{ 0, "dorn_free_zoom_wads_mode_press" },
				{ 1, "dorn_free_zoom_wads_mode_hold" },
			},
		},
		{
			id = "wads_key_modifier",
			type = kb_mod,
			val = 2,
			def = 0,
			hint = "mcm_kb_modifier",
			content = {
				{ 0, "mcm_kb_mod_none" },
				{ 1, "mcm_kb_mod_shift" },
				{ 2, "mcm_kb_mod_ctrl" },
				{ 3, "mcm_kb_mod_alt" },
			},
		},
		{ id = "line_wads_defaults", type = "line" },
		{
			id = "wads_defaults_header",
			type = "title",
			text = "ui_mcm_dorn_free_zoom_wads_defaults_header",
		},
		{
			id = "use_global_wads",
			type = "check",
			val = 1,
			def = false,
			hint = "dorn_free_zoom_use_global_wads",
		},
		wads_track("global_wads", "dorn_free_zoom_global_wads"),
	}
	for _, cat in ipairs({ "pistol", "smg", "rifle", "sniper", "shotgun", "explosive" }) do
		for _, row in ipairs(category_wads(cat)) do
			ads_gr[#ads_gr + 1] = row
		end
	end

