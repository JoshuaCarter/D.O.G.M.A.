-- CQC head AP bonuses apply to eyes/eyelid/jaw/neck, not bip01_head.
-- Our "vs Head" columns model bip01_head, so no AP boost.

local function clamp(v, lo, hi)
	if v < lo then
		return lo
	end
	if v > hi then
		return hi
	end
	return v
end

local function lerp(a, b, t)
	return a + (b - a) * t
end

-- Damage cells fade (MCM color_scale_from) to green (most damage). Scaled 1..max
-- across all rows in a section (torso or head) so identical numbers always
-- share the same color and higher damage is always brighter than lower.
-- Head uses its own max (headshots hit much harder than torso).
-- gamma < 1 brightens the mid-range so the ramp reads as a smooth gradient.
local DMG_COLOR_GAMMA = 0.75
local DMG_CLR_MAX = { 64, 255, 64 }
local COLOR_SCALE_FROM = {
	white = { 255, 255, 255 },
	grey = { 175, 175, 175 },
	darkgrey = { 80, 80, 80 },
}

local function scale_from_rgb()
	return COLOR_SCALE_FROM[CONFIG.loaded.color_scale_from] or COLOR_SCALE_FROM.darkgrey
end

local function dmg_value_color(dmg, lo, hi)
	local span = hi - lo
	local t = (span > 0) and clamp((dmg - lo) / span, 0, 1) or 1
	t = t ^ DMG_COLOR_GAMMA
	local lo_rgb = scale_from_rgb()
	return GetARGB(255,
		math.floor(lerp(lo_rgb[1], DMG_CLR_MAX[1], t)),
		math.floor(lerp(lo_rgb[2], DMG_CLR_MAX[2], t)),
		math.floor(lerp(lo_rgb[3], DMG_CLR_MAX[3], t)))
end

local function column_header_text(tier)
	local mode = CONFIG.loaded.column_headers
	if mode == "raw" then
		-- Raw bone armor float (same value used in the pen check).
		local armor = tier.armor
		if armor == 0 then
			return "0"
		end
		local s = string.format("%.3f", armor)
		return (s:gsub("0+$", ""):gsub("%.$", ""))
	end
	if mode == "raw100" then
		return string.format("%d", math.floor(tier.armor * 100))
	end
	return tier.name
end

