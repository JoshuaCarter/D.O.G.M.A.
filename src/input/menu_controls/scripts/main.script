--[[
	Menu Controls

	Those UIs own input, so on_before_key_press is swallowed. Poll the MCM
	close key via dogma.input and pulse the Exit bind (kQUIT) instead.
]]

local CONFIG = _G.dogma_input_menu_controls_conf

local POLL = "poll"
local MM_TRADE = 2
local craft_open = false
local dialog_open = false
local trade_open = false
local polling = false

local function close_dik()
	return CONFIG.loaded.close_key
end

-- Toolbench picker (stash / use / pickup) and the workshop craft UI.
local CRAFT_GUI = {
	UIWorkshop = true,
	UIFurnitureWorkshop = true,
	ui_hf_workshop = true,
}

local function is_craft_gui(gui, extra)
	local function hit(name)
		if type(name) ~= "string" or name == "" then
			return false
		end
		if CRAFT_GUI[name] then
			return true
		end
		return name:lower():find("workshop", 1, true)
	end
	return hit(gui) or hit(extra)
end

-- Do not call ActorMenu.get_menu_mode(): GrabMenuMode is CurrentGameUI()->
-- with no null check, so on_game_start native-crashes before the HUD exists.
local function current_ctx()
	if trade_open then
		if CONFIG.loaded.trade then
			return "trade"
		end
		return nil
	end
	if craft_open then
		if CONFIG.loaded.crafting then
			return "craft"
		end
		return nil
	end
	if dialog_open then
		if CONFIG.loaded.dialogue then
			return "dialogue"
		end
	end
end

local function pulse_exit()
	local bind = key_bindings and key_bindings.kQUIT
	if not (bind and bind_to_dik and level and level.press_action) then
		return
	end
	local dik = bind_to_dik(bind)
	if not dik or dik == 0 then
		return
	end
	level.press_action(dik)
	if level.release_action then
		level.release_action(dik)
	end
end

local function stop_poll()
	polling = false
	RemoveTimeEvent(CONFIG.MOD_ID, POLL)
end

local function poll()
	if not (close_dik() and current_ctx()) then
		polling = false
		return true
	end
	if dogma.input.is_key_pressed(close_dik()) then
		pulse_exit()
	end
	return false
end

local function ensure_poll()
	local dik = close_dik()
	if not (dik and current_ctx()) then
		stop_poll()
		return
	end
	if polling then
		return
	end
	polling = true
	-- Prime dogma.input tracking (only tracks DIKs after first query).
	dogma.input.is_key_down(dik)
	RemoveTimeEvent(CONFIG.MOD_ID, POLL)
	CreateTimeEvent(CONFIG.MOD_ID, POLL, 0, poll)
end

local function reset()
	craft_open = false
	dialog_open = false
	trade_open = false
	stop_poll()
end

local function on_mode_changed(mode)
	trade_open = mode == MM_TRADE
	ensure_poll()
end

local function on_gui_show(gui, extra)
	if gui == "Dialog" then
		dialog_open = true
	elseif is_craft_gui(gui, extra) then
		craft_open = true
	end
	ensure_poll()
end

local function on_gui_hide(gui, extra)
	if gui == "Dialog" then
		dialog_open = false
	elseif is_craft_gui(gui, extra) then
		craft_open = false
	end
end

function on_option_change()
	CONFIG.loaded.close_key = dogma.mcm.key(CONFIG.MOD_ID, "close_key")
	CONFIG.loaded.trade = dogma.mcm.bool(CONFIG.MOD_ID, "trade")
	CONFIG.loaded.crafting = dogma.mcm.bool(CONFIG.MOD_ID, "crafting")
	CONFIG.loaded.dialogue = dogma.mcm.bool(CONFIG.MOD_ID, "dialogue")
	ensure_poll()
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	on_option_change()
	RegisterScriptCallback("GUI_on_show", on_gui_show)
	RegisterScriptCallback("GUI_on_hide", on_gui_hide)
	RegisterScriptCallback("ActorMenu_on_mode_changed", on_mode_changed)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("on_game_load", reset)
	RegisterScriptCallback("main_menu_on_init", reset)
	RegisterScriptCallback("actor_on_net_destroy", reset)
end
