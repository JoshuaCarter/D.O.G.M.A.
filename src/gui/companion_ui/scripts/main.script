--[[
	Companion UI

	axr_companions.HUD.dialog is companion_list. No stock hide flag.
	Off = dialog:Show(false). X/Y offset the dialog from its XML home.
]]

local CONFIG = _G.dogma_gui_companion_ui_conf

local FLAG = "__dogma_companion_ui"

local scratch_pos = nil
local home = nil
local logged_missing = false

local function log(msg)
	if dogma.dbg.logging() then
		dogma.dbg.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function hud()
	local axr = rawget(_G, "axr_companions")
	return axr and axr.HUD
end

local function dialog()
	local h = hud()
	local d = h and h.dialog
	if d and d.Show and d.SetWndPos then
		return d
	end
	return nil
end

local function read_xy(wnd)
	local ok, p = pcall(function()
		return wnd:GetWndPos()
	end)
	if ok and p then
		return p.x, p.y
	end
	return nil
end

local function apply()
	local wnd = dialog()
	if not wnd then
		return
	end

	local x, y = read_xy(wnd)
	if x ~= nil and not home then
		home = { x = x, y = y }
		log(string.format("home x=%.0f y=%.0f", x, y))
	end

	if not CONFIG.loaded.enabled then
		pcall(function()
			wnd:Show(false)
		end)
		return
	end

	pcall(function()
		wnd:Show(true)
	end)
	if not home then
		return
	end
	if not scratch_pos then
		scratch_pos = vector2()
	end
	local dx = home.x + (CONFIG.loaded.pos_x or 0)
	local dy = home.y + (CONFIG.loaded.pos_y or 0)
	if x == dx and y == dy then
		return
	end
	pcall(function()
		wnd:SetWndPos(scratch_pos:set(dx, dy))
	end)
end

local function companion_class()
	local axr = rawget(_G, "axr_companions")
	return axr and axr.UICompanionList
end

local function patch()
	local cls = companion_class()
	if not cls then
		if not logged_missing then
			logged_missing = true
			log("axr_companions.UICompanionList missing")
		end
		return false
	end
	if cls[FLAG] then
		return true
	end

	local orig_init = cls.InitControls
	if orig_init then
		cls.InitControls = function(self, ...)
			orig_init(self, ...)
			home = nil
			apply()
		end
	end

	local orig_update = cls.Update
	if orig_update then
		cls.Update = function(self, ...)
			orig_update(self, ...)
			apply()
		end
	end

	cls[FLAG] = true
	log("patched UICompanionList")
	return true
end

local function load_opts()
	CONFIG.loaded.enabled = dogma.mcm.bool(CONFIG.MOD_ID, "enabled")
	CONFIG.loaded.pos_x = dogma.mcm.int(CONFIG.MOD_ID, "pos_x")
	CONFIG.loaded.pos_y = dogma.mcm.int(CONFIG.MOD_ID, "pos_y")
end

local function on_option_change()
	load_opts()
	apply()
end

local function reset()
	home = nil
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	load_opts()
	reset()
	logged_missing = false
	patch()
	RegisterScriptCallback("actor_on_first_update", function()
		if not dogma.sys.ready(CONFIG.MOD_ID, db, load_opts) then
			return
		end
		patch()
		apply()
	end)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("on_game_load", reset)
	RegisterScriptCallback("main_menu_on_init", reset)
	RegisterScriptCallback("actor_on_net_destroy", reset)
end
