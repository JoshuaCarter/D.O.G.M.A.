-- Extra Equip Slots: ensure actor_menu has a 15th <slot> tag (order = index).
-- Blank cell is enough for POC; persistent=false shows the item in the bag.

local SLOT_XML = [[		<slot><!--15 Extra pistol (POC) --></slot>
]]

local function ensure_slot_15(xml_obj)
	local slots = xml_obj:query("inventory_slot_wnd > slot")
	if not slots or #slots < 14 then
		return
	end
	if #slots >= 15 then
		return
	end
	local last = slots[#slots]
	if not last then
		return
	end
	local pos = xml_obj:getElementPosition(last)
	if not pos then
		return
	end
	xml_obj:insertFromXMLString(SLOT_XML, last.parent, pos + 1)
end

function on_xml_read()
	RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)
		if xml_file_name == [[ui\actor_menu.xml]]
			or xml_file_name == [[ui\actor_menu_16.xml]]
		then
			ensure_slot_15(xml_obj)
		end
	end)
end
