--[[
	DOGMA debug overlay (namespace module, no globals).

	Features use dogma.overlay (wired by dogma.script).

	set(source, order, msg, color) - HUD slot
	clear(source)                  - wipe that source
	enabled()                      - D.O.G.M.A. -> Debug -> debug overlay
]]

local DEBUG_MOD = "dogma/debug"

local HUD_STATIC = "dogma_debug_overlay_text"
local FALLBACK_STATIC = "debug_info"
local PANEL_STATIC = "dogma_debug_overlay_panel"
local text_static = FALLBACK_STATIC
local PANEL_TEX = "ui_inGame2_white_rect"
local ORIGIN_X = 10
local ORIGIN_Y = 50
local PANEL_PAD = 8
local PANEL_W = 200
local LINE_H = 16

local sources = {}

local function xml_ready()
	return _G.dogma_dbg_overlay_xml == true
end

local function hud_code(color)
	local log = rawget(_G, "__dogma_log")
	if log and log.hud_color then
		return log.hud_color(color)
	end
	return "%c[255,255,255,255]"
end

local function tag(mod_id)
	local log = rawget(_G, "__dogma_log")
	if log and log.tag then
		return log.tag(mod_id)
	end
	return tostring(mod_id or "dogma"):gsub("/", "_")
end

local function get_source(source)
	source = source or "default"
	if not sources[source] then
		sources[source] = { slots = {} }
	end
	return sources[source]
end

local function any_content()
	for _, s in pairs(sources) do
		if next(s.slots) then
			return true
		end
	end
	return false
end

local function hud_wnd(name, create)
	local hud = get_hud()
	if not hud then
		return nil
	end
	local cs = hud:GetCustomStatic(name)
	if not cs and create then
		hud:AddCustomStatic(name, true)
		cs = hud:GetCustomStatic(name)
	end
	return cs and cs:wnd()
end

local function remove_static(name)
	local hud = get_hud()
	if hud and hud:GetCustomStatic(name) then
		hud:RemoveCustomStatic(name)
	end
end

local function add_static(hud, name)
	local cs = hud:GetCustomStatic(name)
	if cs then
		return cs
	end
	hud:AddCustomStatic(name, true)
	return hud:GetCustomStatic(name)
end

local function get_static()
	local hud = get_hud()
	if not hud then
		return nil
	end
	if xml_ready() then
		add_static(hud, PANEL_STATIC)
		local cs = add_static(hud, HUD_STATIC)
		if cs then
			text_static = HUD_STATIC
			return cs
		end
	end
	local cs = add_static(hud, FALLBACK_STATIC)
	if cs then
		text_static = FALLBACK_STATIC
	end
	return cs
end

local function hide()
	if text_static == HUD_STATIC then
		remove_static(HUD_STATIC)
		remove_static(PANEL_STATIC)
	else
		remove_static(FALLBACK_STATIC)
	end
end

local function show_panel(x, y, w, h)
	if not xml_ready() then
		return
	end
	local wnd = hud_wnd(PANEL_STATIC, true)
	if not wnd then
		return
	end
	wnd:SetWndPos(vector2():set(x, y))
	wnd:SetWndSize(vector2():set(w, h))
	pcall(function()
		wnd:InitTexture(PANEL_TEX)
	end)
	pcall(function()
		wnd:SetStretchTexture(true)
	end)
	pcall(function()
		wnd:SetTextureColor(GetARGB(76, 8, 8, 10))
	end)
end

local function mcm_bool(key, default)
	if ui_mcm then
		local value = ui_mcm.get(DEBUG_MOD .. "/" .. key)
		if value ~= nil then
			return value == true or value == 1
		end
	end
	local conf = _G.dogma_debug_conf
	local defaults = conf and conf.DEFAULTS
	if defaults and defaults[key] ~= nil then
		return defaults[key] == true or defaults[key] == 1
	end
	return default
end

function enabled()
	return mcm_bool("debug_overlay", false)
end

local function render()
	if not enabled() or not any_content() then
		hide()
		return
	end

	local cs = get_static()
	if not cs then
		return
	end
	local wnd = cs:wnd()
	if not wnd then
		return
	end
	local text_x = ORIGIN_X + PANEL_PAD
	local text_y = ORIGIN_Y + PANEL_PAD
	local text_w = PANEL_W - PANEL_PAD * 2
	wnd:SetWndPos(vector2():set(text_x, text_y))
	pcall(function()
		wnd:SetWndSize(vector2():set(text_w, 768))
	end)
	pcall(function()
		wnd:SetTextComplexMode(true)
	end)
	local font = GetFontLetterica16Russian and GetFontLetterica16Russian()
	if font then
		pcall(function()
			wnd:SetFont(font)
		end)
	end

	local names = {}
	for name, s in pairs(sources) do
		if next(s.slots) then
			names[#names + 1] = name
		end
	end
	table.sort(names)

	local white = hud_code("white")
	local lines = {}
	for _, name in ipairs(names) do
		local slots = sources[name].slots
		if #lines > 0 then
			lines[#lines + 1] = ""
		end
		lines[#lines + 1] = white .. "[" .. tag(name) .. "]"
		local max_order = -1
		for order in pairs(slots) do
			if order > max_order then
				max_order = order
			end
		end
		for order = 0, max_order do
			local slot = slots[order]
			if slot then
				lines[#lines + 1] = hud_code(slot.color) .. slot.msg
			else
				lines[#lines + 1] = ""
			end
		end
	end

	if #lines == 0 then
		hide()
		return
	end

	local est_h = math.floor(#lines * LINE_H + 0.5)
	show_panel(ORIGIN_X, ORIGIN_Y, PANEL_W, est_h + PANEL_PAD * 2)
	local tc = wnd:TextControl()
	if tc then
		pcall(function()
			tc:SetTextComplexMode(true)
		end)
		if font then
			pcall(function()
				tc:SetFont(font)
			end)
		end
		tc:SetText(table.concat(lines, "\\n"))
	end
	pcall(function()
		wnd:AdjustHeightToText()
	end)
	local text_h = tonumber(wnd.GetHeight and wnd:GetHeight()) or 0
	if text_h >= 1 then
		local pw = hud_wnd(PANEL_STATIC)
		if pw then
			pw:SetWndSize(vector2():set(PANEL_W, text_h + PANEL_PAD * 2))
		end
	end
end

function set(source, order, msg, color)
	if not enabled() then
		return
	end
	local s = get_source(source)
	s.slots[order or 0] = { msg = tostring(msg), color = color }
	render()
end

function clear(source)
	if not source then
		return
	end
	local s = sources[source]
	if not s then
		return
	end
	s.slots = {}
	render()
end

function on_game_start()
	RegisterScriptCallback("on_option_change", render)
end
