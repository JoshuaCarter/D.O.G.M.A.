-- gui/newgame conf
--
-- Patch lives in this *mcm.script so main.script (in-session) can share one
-- wrap via _G. New Game UI is not loaded until MCM gather on a cold boot.

local MOD_ID = "dogma/gui/newgame"
local SECTION = "dogma_new_game_remember"

local CHECKS = {
	{ "ck_story", "story", "remember_story" },
	{ "ck_azazel_mode", "azazel", "remember_azazel" },
	{ "ck_survival", "survival", "remember_survival" },
	{ "ck_warfare", "warfare", "remember_warfare" },
	{ "ck_hardcore", "hardcore", "remember_hardcore" },
	{ "ck_routes", "routes", "remember_routes" },
	{ "ck_conditions", "conditions", "remember_conditions" },
	{ "ck_campfire", "campfire", "remember_campfire" },
	{ "ck_soulslike_mode", "soulslike", "remember_soulslike" },
	{ "ck_drx", "drx", "remember_drx" },
}

local REMEMBER_OPTS = {
	{ "remember_name", "dogma_gui_newgame_remember_name" },
	{ "remember_portrait", "dogma_gui_newgame_remember_portrait" },
	{ "remember_faction", "dogma_gui_newgame_remember_faction" },
	{ "remember_spawn", "dogma_gui_newgame_remember_spawn" },
	{ "remember_difficulty", "dogma_gui_newgame_remember_difficulty" },
	{ "remember_economy", "dogma_gui_newgame_remember_economy" },
	{ "remember_lives", "dogma_gui_newgame_remember_lives" },
	{ "remember_regen", "dogma_gui_newgame_remember_regen" },
	{ "remember_timer", "dogma_gui_newgame_remember_timer" },
	{ "remember_story", "dogma_gui_newgame_remember_story" },
	{ "remember_azazel", "dogma_gui_newgame_remember_azazel" },
	{ "remember_survival", "dogma_gui_newgame_remember_survival" },
	{ "remember_warfare", "dogma_gui_newgame_remember_warfare" },
	{ "remember_hardcore", "dogma_gui_newgame_remember_hardcore" },
	{ "remember_routes", "dogma_gui_newgame_remember_routes" },
	{ "remember_conditions", "dogma_gui_newgame_remember_conditions" },
	{ "remember_campfire", "dogma_gui_newgame_remember_campfire" },
	{ "remember_soulslike", "dogma_gui_newgame_remember_soulslike" },
	{ "remember_drx", "dogma_gui_newgame_remember_drx" },
}

local STATE = _G.__dogma_gui_newgame or {}
_G.__dogma_gui_newgame = STATE

local function want(key)
	if dogma_mcm and dogma_mcm.bool then
		return dogma_mcm.bool(MOD_ID, key)
	end
	return true
end

local function cfg()
	return axr_main and axr_main.config
end

local function r_str(c, key)
	local v = c:r_value(SECTION, key, 3)
	if v and v ~= "" then
		return v
	end
end

local function r_num(c, key)
	return c:r_value(SECTION, key, 2)
end

local function r_on(c, key)
	return c:r_value(SECTION, key, 1) == true
end

local function saved()
	local c = cfg()
	if not (c and c.r_value) then
		return
	end
	if c:r_value(SECTION, "started", 1) ~= true and not r_str(c, "faction") then
		return
	end
	local s = {
		faction = r_str(c, "faction"),
		map = r_str(c, "map"),
		name = r_str(c, "name"),
		icon = r_str(c, "icon"),
		difficulty = r_str(c, "difficulty"),
		economy = r_str(c, "economy"),
		lives = r_num(c, "lives"),
		regen = r_num(c, "regen"),
		timer = r_num(c, "timer"),
		ck = {},
	}
	for i = 1, #CHECKS do
		s.ck[CHECKS[i][1]] = r_on(c, CHECKS[i][2])
	end
	return s
end

local function set_check(self, key, on)
	if self[key] and self[key].SetCheck then
		self[key]:SetCheck(on)
	end
	if self.ck_states then
		self.ck_states[key] = on
	end
end

local function is_on(self, key)
	if self[key] and self[key].GetCheck then
		return self[key]:GetCheck() and true or false
	end
	return self.ck_states and self.ck_states[key] and true or false
end

local function row_n(sel)
	return type(sel) == "table" and sel[1] or nil
end

local function can_start(self)
	if not self.access then
		return false
	end
	local t = self.character_name and self.character_name.GetText and self.character_name:GetText()
	return t and t ~= ""
end

local function persist(self)
	local c = cfg()
	if not (c and c.w_value and can_start(self)) then
		return
	end
	local name = self.character_name and self.character_name.GetText and self.character_name:GetText()
	c:w_value(SECTION, "started", true)
	c:w_value(SECTION, "faction", self.selected_faction or nil)
	c:w_value(SECTION, "map", self.selected_map or nil)
	c:w_value(SECTION, "name", name and name:gsub(" ", "_") or nil)
	c:w_value(SECTION, "icon", self.selected_icon or nil)
	c:w_value(SECTION, "difficulty", self.selected_difficulty or nil)
	c:w_value(SECTION, "economy", self.selected_economy or nil)
	c:w_value(SECTION, "lives", row_n(self.selected_hardcore_lives))
	c:w_value(SECTION, "regen", row_n(self.selected_hardcore_regen))
	c:w_value(SECTION, "timer", row_n(self.selected_timer))
	for i = 1, #CHECKS do
		c:w_value(SECTION, CHECKS[i][2], is_on(self, CHECKS[i][1]))
	end
	if c.save then
		c:save()
	end
end

local function set_list(list, text, idx)
	if not list then
		return
	end
	if idx then
		if list.SetCurrentIdx then
			list:SetCurrentIdx(idx - 1)
		end
		if list.SetCurrentID then
			list:SetCurrentID(idx)
		end
	end
	if text and list.SetText then
		list:SetText(text)
	end
end

local function pick_id(self, list, table_key, selected_key, want_id)
	local t = self[table_key]
	if not (want_id and t and self[list]) then
		return
	end
	for i = 1, #t do
		if t[i] == want_id then
			set_list(self[list], game.translate_string(want_id), i)
			self[selected_key] = want_id
			return
		end
	end
end

local function pick_row(self, list, table_key, selected_key, want_id, text_of)
	local t = self[table_key]
	if not t or not self[list] then
		return
	end
	for i = 1, #t do
		local row = t[i]
		if type(row) == "table" and row[1] == want_id then
			set_list(self[list], text_of(row), i)
			self[selected_key] = row
			return
		end
	end
end

local function apply_checks(self, s)
	for i = 1, #CHECKS do
		local key = CHECKS[i][1]
		if want(CHECKS[i][3]) and self[key] then
			set_check(self, key, s.ck[key] and true or false)
		end
	end
end

local function apply_zombied_story(self)
	if self.selected_faction == "zombied" and self.ck_story then
		set_check(self, "ck_story", false)
		if self.ck_story.Enable then
			self.ck_story:Enable(false)
		end
	elseif self.ck_story and self.ck_story.Enable then
		self.ck_story:Enable(true)
	end
end

local function apply_faction(self, s)
	if not (want("remember_faction") and s.faction and self.LoadFaction) then
		return
	end
	if self.table_faction and not self.table_faction[s.faction] then
		return
	end
	self:LoadFaction(false, s.faction)
	if self.UpdateDescr then
		self:UpdateDescr()
	end
	apply_zombied_story(self)
end

local apply_dropdowns_anon_1 = function(row)
	return (row[1] or "") .. " " .. game.translate_string(row[2])
end

local apply_dropdowns_anon_2 = function(row)
	return (row[1] or "") .. " " .. game.translate_string(row[2])
end

local apply_dropdowns_anon_3 = function(row)
	local n = row[1] and (round_idp and round_idp(row[1] / 24) or math.floor(row[1] / 24))
	return (n and tostring(n) or "") .. " " .. game.translate_string(row[2])
end

local function apply_dropdowns(self, s)
	if want("remember_difficulty") then
		pick_id(self, "list_difficulty", "table_difficulty", "selected_difficulty", s.difficulty)
	end
	if want("remember_economy") then
		pick_id(self, "list_economy", "table_economy", "selected_economy", s.economy)
	end
	if want("remember_lives") then
		pick_row(self, "list_hardcore_lives", "table_hardcore_lives", "selected_hardcore_lives", s.lives, apply_dropdowns_anon_1)
	end
	if want("remember_regen") then
		pick_row(self, "list_hardcore_regen", "table_hardcore_regen", "selected_hardcore_regen", s.regen, apply_dropdowns_anon_3)
	end
	if want("remember_timer") then
		pick_row(self, "list_timer", "table_timer", "selected_timer", s.timer, apply_dropdowns_anon_2)
	end
end

local function apply_name(self, s)
	if want("remember_name") and s.name and self.character_name and self.character_name.SetText then
		self.character_name:SetText(s.name:gsub("_", " "))
	end
end

local function apply_icon(self, s)
	if not want("remember_portrait") then
		return
	end
	if self.LoadIcon then
		self:LoadIcon(false)
	end
	local t = self.table_icon
	if not (s.icon and t) then
		return
	end
	for i = 1, #t do
		if t[i] == s.icon then
			self.selected_icon = s.icon
			if self.UpdateIcon then
				self:UpdateIcon()
			end
			return
		end
	end
end

local function apply_map(self, s)
	if not want("remember_spawn") then
		return
	end
	if self.LoadMap then
		self:LoadMap(false)
	end
	local t = self.table_map
	if not (s.map and t and self.list_map) then
		return
	end
	for i = 1, #t do
		if t[i] == s.map then
			set_list(self.list_map, game.translate_string("ui_st_" .. s.map), i)
			self.selected_map = s.map
			if self.UpdateMap then
				self:UpdateMap()
			end
			return
		end
	end
end

local function reload_shop(self)
	if self.LoadLoadout then
		self:LoadLoadout(false)
	end
end

local function apply(self, reload_loadout)
	local s = saved()
	if not (s and self and self.CC) then
		return
	end
	local prev_fac = self.selected_faction
	local prev_diff = self.selected_difficulty
	local prev_eco = self.selected_economy
	apply_faction(self, s)
	apply_name(self, s)
	apply_icon(self, s)
	apply_checks(self, s)
	apply_dropdowns(self, s)
	apply_map(self, s)
	-- Shop catalog + point budget are built from selected_difficulty / selected_economy.
	-- Setting the dropdown text alone leaves the default easy/medium loadout on screen.
	if reload_loadout and (
		prev_fac ~= self.selected_faction
		or prev_diff ~= self.selected_difficulty
		or prev_eco ~= self.selected_economy
	) then
		reload_shop(self)
	end
end

-- Main-menu New Game click sits over the loadout; eat purchases until LMB is up.
-- Dialog is cached (ShowFactionUI); Main_Controls only runs on the first construct.
-- key_state: dogma.input TimeEvent does not tick on the main-menu New Game UI.
local function mouse1_down()
	local dik = DIK_keys and DIK_keys.MOUSE_1
	return dik and key_state and key_state(dik) ~= 0
end

local function arm_eat()
	STATE.eat_click = mouse1_down() or nil
end

local function wrap(cls, key, state_key, make)
	if STATE[state_key] and cls[key] == STATE[state_key] then
		return true
	end
	local wrapped = make(cls[key])
	if not wrapped then
		return false
	end
	cls[key] = wrapped
	STATE[state_key] = wrapped
	return true
end

local wrap_on_cc_mouse1_anon_1 = function(base)
	if not base then
		return
	end
	return function(self, cont, idx)
		if not STATE.active then
			arm_eat()
		end
		if STATE.eat_click then
			return
		end
		return base(self, cont, idx)
	end
end

local function wrap_on_cc_mouse1(cls)
	return wrap(cls, "On_CC_Mouse1", "wrap_mouse1", wrap_on_cc_mouse1_anon_1)
end

local wrap_update_anon_1 = function(base)
	return function(self, ...)
		if not STATE.active then
			STATE.active = true
			arm_eat()
		end
		if self and self.CC and not self._dogma_remember_visit then
			self._dogma_remember_visit = true
			apply(self, true)
		end
		if base then
			base(self, ...)
		end
		if STATE.eat_click and not mouse1_down() then
			STATE.eat_click = nil
		end
	end
end

local function wrap_update(cls)
	return wrap(cls, "Update", "wrap_update", wrap_update_anon_1)
end

local wrap_on_quit_anon_1 = function(base)
	if not base then
		return
	end
	return function(self, ...)
		STATE.active = nil
		STATE.eat_click = nil
		if self then
			self._dogma_remember_visit = nil
		end
		return base(self, ...)
	end
end

local function wrap_on_quit(cls)
	return wrap(cls, "OnQuit", "wrap_quit", wrap_on_quit_anon_1)
end

local function wrap_main_controls(cls)
	return wrap(cls, "Main_Controls", "wrap_controls", function(base)
		if not base then
			return
		end
		return function(self, ...)
			arm_eat()
			local r = base(self, ...)
			wrap_on_cc_mouse1(cls)
			wrap_update(cls)
			wrap_on_quit(cls)
			return r
		end
	end)
end

local patch_new_game_anon_1 = function(base)
	return function(self, ...)
		persist(self)
		if base then
			return base(self, ...)
		end
	end
end

local patch_new_game_anon_2 = function(base)
	if not base then
		return
	end
	return function(self, rand, faction)
		if not rand then
			return base(self, rand, faction)
		end
		local s = saved()
		if s then
			apply_checks(self, s)
			if want("remember_faction") and s.faction and (not self.table_faction or self.table_faction[s.faction]) then
				faction = s.faction
			end
		end
		local r = base(self, true, faction)
		if s then
			local prev_diff = self.selected_difficulty
			local prev_eco = self.selected_economy
			apply_zombied_story(self)
			apply_name(self, s)
			apply_icon(self, s)
			apply_dropdowns(self, s)
			apply_map(self, s)
			if prev_diff ~= self.selected_difficulty or prev_eco ~= self.selected_economy then
				reload_shop(self)
			end
		end
		return r
	end
end

local function patch_new_game()
	local cls = ui_mm_faction_select and ui_mm_faction_select.UINewGame
	if not cls then
		return false
	end

	wrap(cls, "OnStartGame", "wrap_start", patch_new_game_anon_1)

	wrap(cls, "UpdateAll", "wrap_all", patch_new_game_anon_2)

	wrap_on_cc_mouse1(cls)
	wrap_update(cls)
	wrap_on_quit(cls)
	wrap_main_controls(cls)
	return true
end

local DEFAULTS = {}
for i = 1, #REMEMBER_OPTS do
	DEFAULTS[REMEMBER_OPTS[i][1]] = true
end

_G.dogma_gui_newgame_conf = {
	MOD_ID = MOD_ID,
	DEFAULTS = DEFAULTS,
	loaded = {},
	patch_new_game = patch_new_game,
}

--[[
	New Game - MCM + main-menu patch.

	Must live in *mcm.script: MCM loads those at the main menu.
	zzzz_* body scripts are not loaded until a game session, so a main.script
	patch never sees New Game on a cold boot.

	Wider loadout panel (XML). Last-start settings restore on New Game /
	Randomize, gated by MCM remember toggles (all on by default). Loadout
	purchases are not remembered. LMB eat stops the New Game click from
	buying the first shop cell.

	Soulslike checkbox: we replace their injector
	(scripts/override/souslike_gamemode_injector_mcm.script).
]]

local CONFIG = _G.dogma_gui_newgame_conf

CONFIG.patch_new_game()
RegisterScriptCallback("main_menu_on_init", CONFIG.patch_new_game)

function on_mcm_load(options)
	CONFIG.patch_new_game()

	local gr = {
		{
			id = "page_description",
			type = "desc",
			text = "ui_mcm_dogma_gui_newgame_page_description",
		},
	}
	for i = 1, #REMEMBER_OPTS do
		gr[#gr + 1] = {
			id = REMEMBER_OPTS[i][1],
			type = "check",
			val = 1,
			def = true,
			hint = REMEMBER_OPTS[i][2],
		}
	end

	dogma_mcm.attach(options, "gui", "ui_mcm_menu_dogma_gui", {
		id = "newgame",
		sh = true,
		text = "ui_mcm_menu_dogma_gui_newgame",
		gr = dogma_mcm.with_header(gr),
	})
end
