--[[
    Weapons Ban — ammo craft 1:1

    LoadRecipes overwrites GAMMA slots for ammo recipes in dogma.db.craft.
    Casing/bullet 1 per round. Powder n from the dump, per round, capped
    at 200% of casings (2/round). Cost = per-round × dogma.db box.
    Vanilla UpdateItem paints have / (part_box * amount). We let that
    (and nearby-stash wraps) count, then rewrite the need to
    per-round × dogma.db box. Orig collects full boxes; Craft drains
    that many rounds off those ids so spend matches the label.

    Exo batteries: the gauss slot is 1 box. A second recipe in
    the same list swaps that slot for 16 headlamp batteries.

    Built as zzzzzzzzzz_dogma_*_ammo_craft so on_game_start runs after
    zzzz_serious / zzzzz* / zzzzzzz_ workshop scripts.
]]

local CONFIG = _G.dogma_game_weapons_ban_conf
local TAG = (CONFIG and CONFIG.MOD_ID or "dogma/game/weapons_ban"):gsub("/", "_")
local HOOK = "_dogma_wb_ammo_craft"
local POWDER_PER_MAX = 2
local EXO_BATT_SEC = "batteries_exo"
local EXO_GAUSS_SEC = "ammo_gauss"
local EXO_CELL_SEC = "batteries_dead"
local EXO_CELL_NEED = 16

local function log(msg, color)
    dogma.log.log(CONFIG.MOD_ID, tostring(msg), color)
end

local function cap_powder_per(p_n)
    if p_n > POWDER_PER_MAX then
        return POWDER_PER_MAX
    end
    return p_n
end

local function recipe_sec(r)
    if not r then
        return nil
    end
    local s = r.sec or r.section or r.id
    if type(s) == "string" and s ~= "" then
        return s
    end
    return nil
end

local function recipe_override(sec)
    local parts = dogma.db.craft(sec)
    if not parts then
        return nil
    end
	local casing, powder, bullet, p_n, c_n, b_n, other = nil, nil, nil, 0, 0, 0, 0
	for i = 1, #parts do
		local s = parts[i][1]
		local n = parts[i][2]
		if dogma.db.is_ammo_casing(s) then
			casing = s
			c_n = n
		elseif dogma.db.is_ammo_powder(s) then
			powder = s
			p_n = n
		elseif dogma.db.is_ammo_bullet(s) then
			bullet = s
			b_n = n
		else
			other = other + 1
		end
	end
	if casing and powder and bullet and other == 0 and p_n > 0 then
		return { casing, powder, p_n, bullet, c_n, b_n }
	end
    return nil
end

local function part_per_round(spec, sec)
    if dogma.db.is_ammo_powder(sec) then
        return cap_powder_per(spec[3])
    end
    return 1
end

-- Gauss amount is boxes. 1 box spends through vanilla Craft.
-- Headlamp cells are batteries_dead, counted as items, so 16 is 16 cells.
local function patch_exo_recipes(self)
    if not (self and self.recipes) then
        return
    end
    for _, list in pairs(self.recipes) do
        if type(list) == "table" then
            local extra = {}
            for i = 1, #list do
                local r = list[i]
                if r and not r._dogma_exo_done and recipe_sec(r) == EXO_BATT_SEC then
                    local gauss_i
                    for s = 1, 4 do
                        local slot = r[s]
                        if slot and slot[1] == EXO_GAUSS_SEC then
                            gauss_i = s
                        end
                    end
                    if gauss_i then
                        local was = r[gauss_i][2]
                        r[gauss_i][2] = 1
                        r._dogma_exo_done = true
                        local dup = {
                            sec = r.sec,
                            tool = r.tool,
                            rsp = r.rsp,
                            _dogma_exo_done = true,
                        }
                        for s = 1, 4 do
                            local slot = r[s]
                            if slot then
                                dup[s] = { slot[1], slot[2] }
                            end
                        end
                        dup[gauss_i] = { EXO_CELL_SEC, EXO_CELL_NEED }
                        extra[#extra + 1] = { i, dup }
                        log(string.format(
                            "exo recipe gauss boxes %s -> 1, alt %s x%s",
                            tostring(was),
                            EXO_CELL_SEC,
                            EXO_CELL_NEED
                        ), "gray")
                    end
                end
            end
            for n = #extra, 1, -1 do
                table.insert(list, extra[n][1] + 1, extra[n][2])
            end
        end
    end
end

-- After GAMMA LoadRecipes: overwrite slots for 3-part ammo dump recipes.
local function apply_recipes(self)
    if not (self and self.recipes) then
        return
    end
    for _, list in pairs(self.recipes) do
        if type(list) == "table" then
            for i = 1, #list do
                local r = list[i]
                local spec = r and recipe_override(recipe_sec(r))
                if spec then
                    local sec = recipe_sec(r)
                    local row = dogma.db.get(sec)
                    local box = (row and row.box) or 0
					local dump = spec[3]
					local per = cap_powder_per(dump)
					log(string.format(
						"ammo recipe %s box=%s dump cas=%s pwd=%s bul=%s -> %s/%s/%s",
						sec,
						box,
						spec[5],
						dump,
						spec[6],
						box,
						per * box,
						box
					), "gray")
                    r[1] = { spec[1], 1 }
                    r[2] = { spec[2], per }
                    r[3] = { spec[4], 1 }
                    r[4] = nil
                    r._dogma_wb_box = box
                end
            end
        end
    end
    patch_exo_recipes(self)
end

local function selected_recipe(self)
    local t = self.last_type
    local idx = self.selected_index or self.last_index
    if t and idx and self.recipes and self.recipes[t] then
        return self.recipes[t][idx]
    end
    return nil
end

local function selected_out(self)
    local out = recipe_sec(selected_recipe(self))
    if out then
        return out
    end
    local cr = self.craft_item_r
    if type(cr) == "table" and type(cr[1]) == "string" and cr[1] ~= "" then
        return cr[1]
    end
    return nil
end

local function craft_cls()
    local mod = rawget(_G, "ui_workshop") or ui_workshop
    if mod and mod.UIWorkshopCraft then
        return mod.UIWorkshopCraft
    end
    return rawget(_G, "UIWorkshopCraft")
end

-- Vanilla paints "have/need" (have already includes nearby stashes).
-- Steal have, write our need, retint.
local function retint_need(self, n, sec, need)
    local w = self.itm_num and self.itm_num[n]
    if not w then
        return
    end
    local txt = w:GetText() or ""
    local have = tonumber(string.match(txt, "^(%d+)")) or 0
    w:SetText(tostring(have) .. "/" .. tostring(need))
    local ok = have >= need
    log(string.format("retint n=%s %s have=%s need=%s", n, sec, have, need), ok and "gray" or "red")
    if ok then
        w:SetTextColor(GetARGB(200, 50, 255, 50))
        self.craft_allow[n] = true
    else
        w:SetTextColor(GetARGB(250, 255, 50, 50))
        self.craft_allow[n] = false
    end
    utils_xml.set_icon(sec, not ok, self.itm_ico_temp[n], self.itm_ico[n])
end

-- Drain `need` rounds from orig's craft_item ids (stash+full boxes) then
-- actor inventory. Do not release during iterate_inventory.
local _grab_sec
local _grab_n = 0
local _grab_id = {}
local _grab_cnt = {}
local _grab_seen = {}

local function wipe_grab()
    for i = 1, _grab_n do
        _grab_id[i] = nil
        _grab_cnt[i] = nil
    end
    _grab_n = 0
    for k in pairs(_grab_seen) do
        _grab_seen[k] = nil
    end
end

local function grab_push(id, cnt)
    if not id or _grab_seen[id] or not (cnt and cnt > 0) then
        return
    end
    _grab_n = _grab_n + 1
    _grab_id[_grab_n] = id
    _grab_cnt[_grab_n] = cnt
    _grab_seen[id] = true
end

local function grab_known(id)
    if not id then
        return
    end
    local obj = level.object_by_id(id)
    if obj then
        grab_push(id, obj and obj:ammo_get_count() or 0)
    end
end

local function grab_stack(_, obj)
    if obj and _grab_sec and obj:section() == _grab_sec then
        grab_push(obj:id(), obj:ammo_get_count() or 0)
    end
end

local function spend_ammo_rounds(npc, section, need, known)
    if not (section and need and need > 0) then
        return true
    end
    wipe_grab()
    _grab_sec = section
    if known then
        for i = 1, #known do
            grab_known(known[i])
        end
    end
    if npc then
        npc:iterate_inventory(grab_stack, nil)
    end
    local remain = need
    for i = 1, _grab_n do
        if remain <= 0 then
            break
        end
        local id, cnt = _grab_id[i], _grab_cnt[i]
        if cnt <= remain then
            alife_release_id(id)
            remain = remain - cnt
        else
            local se = dogma.alife.obj(id)
            if se then
                se:ammo_set_count(cnt - remain)
            end
            remain = 0
        end
    end
    if remain > 0 then
        log(string.format("spend short %s left=%s", section, remain), "red")
    else
        log(string.format("spend %s need=%s", section, need), "gray")
    end
    return remain <= 0
end

local function ammo_need(spec, sec, n, out_box)
    local per = 1
    if dogma.db.is_ammo_part(sec) then
        per = part_per_round(spec, sec)
    elseif n == 2 then
        per = cap_powder_per(spec[3])
    elseif n ~= 1 and n ~= 3 then
        return nil
    end
    return per * out_box
end

local function patch()
    local cls = craft_cls()
    if not cls then
        return false
    end

    local wrapped_update = cls._dogma_wb_ammo_craft_update
    local wrapped_craft = cls._dogma_wb_ammo_craft_craft
    local wrapped_load = cls._dogma_wb_ammo_craft_load
    if cls[HOOK] and wrapped_update and wrapped_craft and wrapped_load then
        if cls.UpdateItem ~= wrapped_update or cls.Craft ~= wrapped_craft
            or cls.LoadRecipes ~= wrapped_load
        then
            cls.UpdateItem = wrapped_update
            cls.Craft = wrapped_craft
            cls.LoadRecipes = wrapped_load
            log("reclaimed UIWorkshopCraft on patch")
        end
        return true
    end

    local orig_update = cls.UpdateItem
    local orig_craft = cls.Craft
    local orig_load = cls.LoadRecipes
    if type(orig_update) ~= "function" or type(orig_craft) ~= "function"
        or type(orig_load) ~= "function"
    then
        return false
    end

    local function update_hook(self, n, sec, amount, result, toolkit_idx, toolkit_sec)
        if n == 1 and not result then
            self._dogma_ammo_cost = nil
        end

        local r = selected_recipe(self)
        local out = recipe_sec(r) or selected_out(self)
        local spec = recipe_override(out)
        local row = out and dogma.db.get(out)
        local out_box = (r and r._dogma_wb_box) or (row and row.box) or 0
        local need = (not result and n and sec and spec and out_box > 0)
            and ammo_need(spec, sec, n, out_box)

        local orig_amt = amount
        if need then
            local part_box = IsItem("ammo", sec)
            if type(part_box) ~= "number" or part_box < 1 then
                part_box = 10
            end
            orig_amt = math.ceil(need / part_box)
        end

        orig_update(self, n, sec, orig_amt, result, toolkit_idx, toolkit_sec)
        if not need then
            return
        end

        retint_need(self, n, sec, need)
        local cost = self._dogma_ammo_cost
        if not cost then
            cost = {}
            self._dogma_ammo_cost = cost
        end
        cost[n] = { sec = sec, need = need }
    end

    local function craft_hook(self)
        if not self.craft_allow_r then
            return orig_craft(self)
        end
        local cost = self._dogma_ammo_cost
        local spent = false
        if cost then
            for i = 1, 4 do
                local entry = cost[i]
                if entry and entry.sec and entry.need then
                    spend_ammo_rounds(
                        db.actor,
                        entry.sec,
                        entry.need,
                        self.craft_item and self.craft_item[i]
                    )
                    spent = true
                end
            end
            self._dogma_ammo_cost = nil
        end
        -- Only wipe after we spent. Empty cost used to be truthy and
        -- cleared craft_item so vanilla Craft created the output for free.
        if spent and self.craft_item then
            log("ammo spend, wipe craft_item")
            for i = 1, 4 do
                self.craft_item[i] = {}
                self.craft_item_remain[i] = {}
            end
        end
        return orig_craft(self)
    end

    local load_hook
    local function reclaim(tag)
        local stole = cls.UpdateItem ~= update_hook or cls.Craft ~= craft_hook
            or cls.LoadRecipes ~= load_hook
        cls.UpdateItem = update_hook
        cls.Craft = craft_hook
        cls.LoadRecipes = load_hook
        if stole then
            log("reclaimed UIWorkshopCraft " .. tag)
        end
    end

    load_hook = function(self, ...)
        reclaim("before load")
        orig_load(self, ...)
        apply_recipes(self)
        reclaim("after load")
    end

    cls.UpdateItem = update_hook
    cls.Craft = craft_hook
    cls.LoadRecipes = load_hook
    cls._dogma_wb_ammo_craft_update = update_hook
    cls._dogma_wb_ammo_craft_craft = craft_hook
    cls._dogma_wb_ammo_craft_load = load_hook
    cls[HOOK] = true
    printf("[%s] patched UIWorkshopCraft ammo recipe retint + spend", TAG)
    return true
end

function on_game_start()
    if patch() then
        return
    end
    RegisterScriptCallback("actor_on_first_update", patch)
    if not CreateTimeEvent then
        return
    end
    local tries = 0
    CreateTimeEvent("dogma_wb_ammo", "patch", 1, function()
        if patch() then
            return true
        end
        tries = tries + 1
        return tries >= 30
    end)
end
