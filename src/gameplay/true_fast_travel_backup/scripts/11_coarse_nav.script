-- True Fast Travel: packed level.ai aimap graph (load / pathfind / PDA display).
-- Node index == engine level_vertex_id. Live travel uses A* on packaged adjacency.
-- Assets ship in db/mods/dogma_nav_mesh.db0 as configs/tft_aimap/<level>.spawn.

local tft = _G.tft

local CN_AIMAP_VFS_DIR = "tft_aimap\\"
local CN_HEADER_SIZE = 44
local CN_MAGIC = "DFT_AIM1"
local CN_INVALID = dogma_xlibs.xconst.INVALID_LEVEL_VERTEX_ID
local CN_PATH_SUBSAMPLE_M = 12
local CN_ASTAR_MAX_EXPAND = 750000
local CN_DISPLAY_STRIDE = 80
local CN_DISPLAY_MARKERS_MAX = 2500
local CN_UNDERGROUND_Y = 1000

local SPOT_NODE = "tft_nav_mesh_node"
local SPOT_ENDPOINT = "tft_nav_mesh_endpoint"
local SPOT_EDGE = "tft_nav_mesh_edge"

local function cn_msg(text, style)
    local cfg = _G.tft_config
    if not (cfg and cfg.debug_overlay) then return end
    if _G.tft_msg then _G.tft_msg(text, style) end
end

local function cn_log(fmt, ...)
    if _G.tft_log then
        _G.tft_log("[aimap] " .. fmt, ...)
    end
end

local function cn_state()
    if not tft.nav_mesh then
        tft.nav_mesh = {
            graph = nil,
            dot_ids = {},
            endpoint_dot_ids = {},
            edge_dot_ids = {},
            build = nil,
            dest_lvid_cache = {},
        }
    end
    return tft.nav_mesh
end

local function cn_valid_lvid(lvid)
    return lvid and lvid ~= _G.tft_invalid_lvid and lvid ~= -1
end

local function cn_horizontal_dist(a, b)
    if not (a and b) then return nil end
    local dx, dz = a.x - b.x, a.z - b.z
    return math.sqrt(dx * dx + dz * dz)
end

local function cn_level_name()
    return (level and level.name) and level.name() or nil
end

-- ============================================================
-- Binary helpers (Lua 5.1, little-endian)
-- ============================================================

local function cn_u32(blob, off1)
    local b1, b2, b3, b4 = blob:byte(off1, off1 + 3)
    if not b4 then return nil end
    return b1 + b2 * 256 + b3 * 65536 + b4 * 16777216
end

local function cn_f32(blob, off1)
    local b1, b2, b3, b4 = blob:byte(off1, off1 + 3)
    if not b4 then return nil end
    local sign = 1
    if b4 >= 128 then
        sign = -1
        b4 = b4 - 128
    end
    local exp = b4 * 2 + math.floor(b3 / 128)
    local mant = ((b3 % 128) * 65536 + b2 * 256 + b1) / 8388608
    if exp == 0 then
        if mant == 0 then return 0 end
        return sign * mant * (2 ^ (-126))
    elseif exp == 255 then
        return sign * math.huge
    end
    return sign * (1 + mant) * (2 ^ (exp - 127))
end

local function cn_neighbor(g, node_id, slot)
    -- node_id 0-based; slot 0..3; links blob starts after header
    local off = CN_HEADER_SIZE + node_id * 16 + slot * 4 + 1
    local v = cn_u32(g.blob, off)
    if not v or v == CN_INVALID or v >= g.node_count then return nil end
    return v
end

-- ============================================================
-- Load packaged aimap
-- ============================================================

-- Packaged archive uses *.spawn (xrCompress strong-compresses that ext).
-- Loose authoring dumps may still be *.aimap beside the scripts during dev.
local function cn_aimap_rel_candidates(level_name)
    local stem = CN_AIMAP_VFS_DIR .. (level_name or "unknown")
    return { stem .. ".spawn", stem .. ".aimap" }
end

local function cn_ensure_dir(path)
    if not path or path == "" then return false end
    path = path:gsub("/", "\\")
    if path:sub(-1) == "\\" then path = path:sub(1, -2) end
    pcall(function()
        os.execute('cmd /c mkdir "' .. path .. '" >nul 2>nul')
    end)
    return true
end

local function cn_appdata_aimap_path(level_name)
    if not (getFS and getFS().update_path) then return nil end
    local ok, dir = pcall(function()
        return getFS():update_path("$app_data_root$", "dogma_aimap_cache\\")
    end)
    if not ok or not dir or dir == "" then return nil end
    dir = dir:gsub("/", "\\")
    if dir:sub(-1) ~= "\\" then dir = dir .. "\\" end
    cn_ensure_dir(dir)
    -- Cache decompressed payload as .aimap for fast io.open reloads.
    return dir .. (level_name or "unknown") .. ".aimap"
end

local function cn_read_file_rb(abs_path)
    if not abs_path then return nil end
    local ok, data = pcall(function()
        local f = io.open(abs_path, "rb")
        if not f then return nil end
        local s = f:read("*a")
        f:close()
        return (s and s ~= "") and s or nil
    end)
    if ok then return data end
    return nil
end

local function cn_write_file_wb(abs_path, data)
    if not (abs_path and data) then return false end
    local ok = pcall(function()
        local f = io.open(abs_path, "wb")
        if not f then error("open failed") end
        f:write(data)
        f:close()
    end)
    return ok == true
end

local function cn_vfs_read_rel(rel)
    if not getFS then return nil end
    local ok, data = pcall(function()
        local fr = getFS():r_open("$game_config$", rel)
        if not fr then return nil end
        local chunks = {}
        local buf = {}
        local n = 0
        while not fr:r_eof() do
            n = n + 1
            buf[n] = string.char(fr:r_u8())
            if n >= 65536 then
                chunks[#chunks + 1] = table.concat(buf, "", 1, n)
                n = 0
            end
        end
        if n > 0 then
            chunks[#chunks + 1] = table.concat(buf, "", 1, n)
        end
        local s = table.concat(chunks)
        return (s ~= "") and s or nil
    end)
    if ok then return data end
    cn_log("vfs read error (%s): %s", tostring(rel), tostring(data))
    return nil
end

local function cn_read_aimap_bytes(level_name)
    local candidates = cn_aimap_rel_candidates(level_name)

    -- 1) Appdata cache (fast io.open after first VFS extract / db decompress)
    local app_path = cn_appdata_aimap_path(level_name)
    if app_path then
        local cached = cn_read_file_rb(app_path)
        if cached and cached:sub(1, 8) == CN_MAGIC then
            return cached, app_path
        end
    end

    for i = 1, #candidates do
        local rel = candidates[i]

        -- 2) Loose file via update_path + io.open (dev / unpacked)
        if getFS and getFS().update_path then
            local ok, abs = pcall(function()
                return getFS():update_path("$game_config$", rel)
            end)
            if ok and abs and abs ~= "" then
                local data = cn_read_file_rb(abs)
                if data and data:sub(1, 8) == CN_MAGIC then
                    if app_path then pcall(cn_write_file_wb, app_path, data) end
                    return data, abs
                end
            end
        end

        -- 3) VFS (db/mods archive or virtualized loose): decompress happens in engine
        local data = cn_vfs_read_rel(rel)
        if data and data:sub(1, 8) == CN_MAGIC then
            if app_path then
                if cn_write_file_wb(app_path, data) then
                    cn_log("cached aimap to appdata: %s", app_path)
                end
            end
            return data, rel
        end
    end

    cn_log("missing aimap for %s (tried .spawn/.aimap under %s)",
        tostring(level_name), CN_AIMAP_VFS_DIR)
    return nil
end

local function cn_parse_aimap(blob, level_name)
    if not (blob and #blob >= CN_HEADER_SIZE) then return nil, "short" end
    if blob:sub(1, 8) ~= CN_MAGIC then return nil, "bad_magic" end
    local ver = cn_u32(blob, 9)
    local count = cn_u32(blob, 13)
    if ver ~= 1 then return nil, "bad_version" end
    if not count or count < 1 then return nil, "empty" end
    local expect = CN_HEADER_SIZE + count * 16
    if #blob < expect then return nil, "truncated" end
    local cell = cn_f32(blob, 17)
    local g = {
        level_name = level_name,
        blob = blob,
        node_count = count,
        cell = cell or 0.7,
        aabb = {
            cn_f32(blob, 21), cn_f32(blob, 25), cn_f32(blob, 29),
            cn_f32(blob, 33), cn_f32(blob, 37), cn_f32(blob, 41),
        },
        adj = true,
        anchor_by_key = {},
    }
    return g
end

local function cn_graph_ready()
    local g = cn_state().graph
    return g ~= nil and g.node_count and g.node_count >= 1 and g.blob ~= nil
end

local function cn_try_load()
    local tostr = tostring
    local level_name = cn_level_name()
    if not level_name then
        cn_log("try_load: no level name")
        return false
    end
    local blob, src = cn_read_aimap_bytes(level_name)
    if not blob then
        cn_log("try_load: missing aimap for %s", tostr(level_name))
        cn_state().graph = nil
        return false
    end
    local g, err = cn_parse_aimap(blob, level_name)
    if not g then
        cn_log("try_load: parse failed for %s: %s", tostr(level_name), tostr(err))
        cn_state().graph = nil
        return false
    end
    cn_state().graph = g
    cn_log("loaded %s nodes=%d from %s (%.1f MB)",
        tostr(level_name), g.node_count, tostr(src), #blob / (1024 * 1024))
    return true
end

local function cn_clear_appdata_cache(level_name)
    local path = cn_appdata_aimap_path(level_name or cn_level_name())
    if not path then return end
    pcall(function()
        os.remove(path)
    end)
end

local function cn_ensure_ready(force)
    if force then
        cn_clear_appdata_cache(cn_level_name())
        cn_state().graph = nil
        if tft then
            tft.path_build_cache = nil
            tft.menu_path_cache = nil
        end
    end
    if cn_graph_ready() then return true end
    return cn_try_load()
end

local function cn_build_sync()
    -- Packaged nav mesh is immutable; reload from db/mods (drop appdata cache first).
    cn_clear_appdata_cache(cn_level_name())
    cn_state().graph = nil
    if tft then
        tft.path_build_cache = nil
        tft.menu_path_cache = nil
    end
    local ok = cn_try_load()
    if ok then
        cn_msg("Nav mesh reloaded", "info")
    else
        cn_msg("Nav mesh reload failed", "warning")
    end
    return ok
end

-- ============================================================
-- Positions / nearest (engine lvid == aimap index)
-- ============================================================

local function cn_vertex_pos(lvid, cache)
    if cache and cache[lvid] then return cache[lvid] end
    if not (level and level.vertex_position and cn_valid_lvid(lvid)) then return nil end
    local ok, p = pcall(function() return level.vertex_position(lvid) end)
    if not (ok and p and p.x) then return nil end
    local v = vector():set(p.x, p.y, p.z)
    if cache then cache[lvid] = v end
    return v
end

local function cn_lvid_in_graph(lvid)
    if not cn_valid_lvid(lvid) then return nil end
    local g = cn_state().graph
    if g and lvid >= g.node_count then return nil end
    return lvid
end

-- Cheap point cover query only (no ring scan). Used for destinations / generic snaps.
local function cn_resolve_lvid(pos, hint_lvid)
    local from_hint = cn_lvid_in_graph(hint_lvid)
    if from_hint then return from_hint end
    if not (pos and level and level.vertex_id) then return nil end
    local ok, lvid = pcall(function() return level.vertex_id(pos) end)
    local hit = ok and cn_lvid_in_graph(lvid) or nil
    if hit then return hit end
    if pos.y then
        local raised = vector():set(pos.x, pos.y + 1.0, pos.z)
        ok, lvid = pcall(function() return level.vertex_id(raised) end)
        hit = ok and cn_lvid_in_graph(lvid) or nil
        if hit then return hit end
    end
    return nil
end

-- Travel always starts at the player. Prefer the engine's tracked actor node (O(1)) —
-- level.vertex_id(actor_pos) can fail on slopes / feet-under-plane while the actor is
-- still on a valid graph node. No nearest-node scan needed.
local function cn_start_lvid(start_pos, hint_lvid)
    if db and db.actor and db.actor.level_vertex_id then
        local ok_a, actor_lvid = pcall(function() return db.actor:level_vertex_id() end)
        local from_actor = ok_a and cn_lvid_in_graph(actor_lvid) or nil
        if from_actor then return from_actor end
    end
    return cn_resolve_lvid(start_pos, hint_lvid)
end

local function cn_nearest_graph_node(g, pos, max_m)
    if not (g and pos) then return nil end
    local lvid = cn_resolve_lvid(pos, nil)
    if not lvid then return nil end
    if max_m then
        local p = cn_vertex_pos(lvid, nil)
        local d = p and cn_horizontal_dist(pos, p)
        if d and d > max_m then return nil end
    end
    return lvid
end

-- ============================================================
-- A* on aimap adjacency
-- ============================================================

local function cn_heap_swap(heap, i, j)
    local a, b = heap.items[i], heap.items[j]
    heap.items[i], heap.items[j] = b, a
    heap.index[a] = j
    heap.index[b] = i
end

local function cn_heap_sift_up(heap, nodes, i)
    while i > 1 do
        local parent = math.floor(i / 2)
        if nodes[heap.items[i]].f < nodes[heap.items[parent]].f then
            cn_heap_swap(heap, i, parent)
            i = parent
        else
            break
        end
    end
end

local function cn_heap_sift_down(heap, nodes, i)
    local n = #heap.items
    while true do
        local l, r, smallest = i * 2, i * 2 + 1, i
        if l <= n and nodes[heap.items[l]].f < nodes[heap.items[smallest]].f then smallest = l end
        if r <= n and nodes[heap.items[r]].f < nodes[heap.items[smallest]].f then smallest = r end
        if smallest == i then break end
        cn_heap_swap(heap, i, smallest)
        i = smallest
    end
end

local function cn_heap_push(heap, nodes, id)
    local n = #heap.items + 1
    heap.items[n] = id
    heap.index[id] = n
    cn_heap_sift_up(heap, nodes, n)
end

local function cn_heap_decrease(heap, nodes, id)
    local i = heap.index[id]
    if not i then cn_heap_push(heap, nodes, id); return end
    cn_heap_sift_up(heap, nodes, i)
end

local function cn_heap_pop(heap, nodes)
    local n = #heap.items
    if n < 1 then return nil end
    local top = heap.items[1]
    local last = heap.items[n]
    heap.items[n] = nil
    heap.index[top] = nil
    if n == 1 then return top end
    heap.items[1] = last
    heap.index[last] = 1
    cn_heap_sift_down(heap, nodes, 1)
    return top
end

local function cn_graph_path(g, start_id, goal_id, _direct_only)
    if not (g and g.blob and start_id and goal_id) then return nil end
    if start_id == goal_id then return { start_id } end
    if start_id < 0 or goal_id < 0 or start_id >= g.node_count or goal_id >= g.node_count then
        return nil
    end

    local pos_cache = {}
    local goal_pos = cn_vertex_pos(goal_id, pos_cache)
    if not goal_pos then return nil end

    local nodes = {}
    local heap = { items = {}, index = {} }
    local start_pos = cn_vertex_pos(start_id, pos_cache)
    if not start_pos then return nil end

    local h0 = cn_horizontal_dist(start_pos, goal_pos) or start_pos:distance_to(goal_pos)
    nodes[start_id] = { g = 0, f = h0, parent = nil }
    cn_heap_push(heap, nodes, start_id)

    local expanded = 0
    local max_expand = CN_ASTAR_MAX_EXPAND
    while #heap.items > 0 do
        local cur = cn_heap_pop(heap, nodes)
        if cur == goal_id then break end
        expanded = expanded + 1
        if expanded > max_expand then
            cn_log("A* expand cap (%d) start=%d goal=%d", max_expand, start_id, goal_id)
            return nil
        end
        local cur_n = nodes[cur]
        local cur_pos = cn_vertex_pos(cur, pos_cache)
        if cur_pos then
            for slot = 0, 3 do
                local nxt = cn_neighbor(g, cur, slot)
                if nxt then
                    local nxt_pos = cn_vertex_pos(nxt, pos_cache)
                    if nxt_pos then
                        local step = cn_horizontal_dist(cur_pos, nxt_pos) or cur_pos:distance_to(nxt_pos)
                        local tent = cur_n.g + (step or 0)
                        local prev = nodes[nxt]
                        if not prev or tent < prev.g then
                            local h = cn_horizontal_dist(nxt_pos, goal_pos) or nxt_pos:distance_to(goal_pos)
                            nodes[nxt] = { g = tent, f = tent + (h or 0), parent = cur }
                            cn_heap_decrease(heap, nodes, nxt)
                        end
                    end
                end
            end
        end
    end

    if not nodes[goal_id] then
        cn_log("A* failed start=%d goal=%d expanded=%d", start_id, goal_id, expanded)
        return nil
    end

    local rev = {}
    local id = goal_id
    while id ~= nil do
        rev[#rev + 1] = id
        id = nodes[id].parent
    end
    local path = {}
    for i = #rev, 1, -1 do
        path[#path + 1] = rev[i]
    end
    return path, pos_cache
end

local function cn_subsample_node_path(g, node_path, pos_cache, spacing_m)
    spacing_m = spacing_m or CN_PATH_SUBSAMPLE_M
    if not (node_path and #node_path >= 1) then return {} end
    local out = {}
    local last_pos = nil
    local carry = 0
    for i = 1, #node_path do
        local p = cn_vertex_pos(node_path[i], pos_cache)
        if p then
            if not last_pos then
                out[#out + 1] = vector():set(p.x, p.y, p.z)
                last_pos = p
                carry = 0
            else
                local seg = cn_horizontal_dist(last_pos, p) or last_pos:distance_to(p) or 0
                carry = carry + seg
                if carry >= spacing_m or i == #node_path then
                    out[#out + 1] = vector():set(p.x, p.y, p.z)
                    last_pos = p
                    carry = 0
                else
                    last_pos = p
                end
            end
        end
    end
    return out
end

local function cn_graph_path_positions(g, node_ids)
    local out = {}
    local cache = {}
    for i = 1, #(node_ids or {}) do
        local p = cn_vertex_pos(node_ids[i], cache)
        if p then out[#out + 1] = vector():set(p.x, p.y, p.z) end
    end
    return out
end

-- ============================================================
-- Dest anchor keys (cache resolved lvids)
-- ============================================================

local function cn_dest_anchor_key_for_id(id)
    if not id then return nil end
    local st = cn_state()
    local kinds = { "base", "transition", "campfire", "dest" }
    for i = 1, #kinds do
        local k = kinds[i] .. ":" .. tostring(id)
        if st.dest_lvid_cache[k] then return k end
    end
    if not _G.tft_resolve_travel_target then return nil end
    local target = _G.tft_resolve_travel_target(id, cn_level_name(), nil)
    if not (target and target.pos) then return nil end
    local kind = "dest"
    if target.kind then
        kind = tostring(target.kind)
    elseif target.is_transition then
        kind = "transition"
    end
    local key = kind .. ":" .. tostring(id)
    local lvid = target.lvid
    if not cn_valid_lvid(lvid) then
        lvid = cn_resolve_lvid(target.pos, nil)
    end
    if cn_valid_lvid(lvid) then
        st.dest_lvid_cache[key] = lvid
        local g = st.graph
        if g then g.anchor_by_key[key] = lvid end
    end
    return key
end

local function cn_goal_lvid(dest_pos, dest_anchor_key)
    local g = cn_state().graph
    if dest_anchor_key then
        local cached = cn_state().dest_lvid_cache[dest_anchor_key]
        if cached and g and cached < g.node_count then return cached end
        if g and g.anchor_by_key[dest_anchor_key] then
            return g.anchor_by_key[dest_anchor_key]
        end
    end
    if tft and cn_valid_lvid(tft.dest_lvid) and g and tft.dest_lvid < g.node_count then
        return tft.dest_lvid
    end
    return cn_resolve_lvid(dest_pos, nil)
end

-- Live travel/preview: aimap A* only.
local function cn_build_path(start_pos, dest_pos, dest_anchor_key)
    local g = cn_state().graph
    if not cn_graph_ready() then
        cn_log("build_path: no aimap loaded")
        return nil
    end
    if not (start_pos and start_pos.x and dest_pos and dest_pos.x) then
        return nil
    end
    local start_hint = tft and tft.start_lvid or nil
    local start_id = cn_start_lvid(start_pos, start_hint)
    if not start_id then
        cn_log("build_path: no start lvid (start=%s hint=%s)",
            start_pos and string.format("(%.0f,%.0f,%.0f)", start_pos.x, start_pos.y or 0, start_pos.z) or "nil",
            tostring(start_hint))
        return nil
    end
    if tft then
        tft.start_lvid = start_id
    end
    local goal_id = cn_goal_lvid(dest_pos, dest_anchor_key)
    if not goal_id then
        cn_log("build_path: no goal lvid (key=%s)", tostring(dest_anchor_key))
        return nil
    end
    local node_path, pos_cache = cn_graph_path(g, start_id, goal_id, false)
    if not (node_path and #node_path >= 1) then
        return nil
    end
    local mid = cn_subsample_node_path(g, node_path, pos_cache, CN_PATH_SUBSAMPLE_M)
    if not (mid and #mid >= 1) then
        mid = cn_graph_path_positions(g, node_path)
    end
    local chain = {}
    chain[#chain + 1] = vector():set(start_pos.x, start_pos.y, start_pos.z)
    for i = 1, #mid do
        chain[#chain + 1] = mid[i]
    end
    chain[#chain + 1] = vector():set(dest_pos.x, dest_pos.y, dest_pos.z)
    local is_vertex = {}
    for i = 1, #chain do
        is_vertex[i] = (i > 1 and i < #chain)
    end
    local path_len = 0
    for i = 2, #chain do
        path_len = path_len + (cn_horizontal_dist(chain[i - 1], chain[i]) or chain[i - 1]:distance_to(chain[i]) or 0)
    end
    local meta = {
        mode = "aimap",
        safe_vertices = {},
        no_land_segments = {},
        start_node = start_id,
        goal_node = goal_id,
        dest_anchor_key = dest_anchor_key,
        node_count = #node_path,
    }
    return chain, is_vertex, path_len, meta
end

-- ============================================================
-- Compatibility stubs (rarely used helpers)
-- ============================================================

local function cn_finalize_graph(g)
    return g
end

local function cn_direct_dest_keys(_g, _node_id)
    return nil
end

local function cn_splice_to_dest(g, from_node_id, dest_anchor_key)
    local dest_id = cn_goal_lvid(nil, dest_anchor_key)
    if not (g and from_node_id and dest_id) then return nil end
    local node_path, cache = cn_graph_path(g, from_node_id, dest_id, false)
    if not node_path then return nil end
    return node_path, cn_subsample_node_path(g, node_path, cache, CN_PATH_SUBSAMPLE_M)
end

local function cn_splice_from_pos(g, pos, dest_anchor_key, max_m)
    local node_id = cn_nearest_graph_node(g, pos, max_m)
    if not node_id then return nil end
    local node_path, positions = cn_splice_to_dest(g, node_id, dest_anchor_key)
    if not node_path then return nil end
    return node_id, node_path, positions
end

local function cn_astar_graph(g, start_id, goal_id)
    return cn_graph_path(g, start_id, goal_id, false)
end

-- ============================================================
-- PDA debug overlay (subsampled - full mesh is too dense)
-- ============================================================

local function cn_want_display()
    local cfg = _G.tft_config
    return cfg and cfg.show_nav_mesh == true
end

local function cn_is_pda_map_shown()
    local shown = false
    pcall(function()
        if ActorMenu and ActorMenu.get_pda_menu then
            local pda = ActorMenu.get_pda_menu()
            if pda and pda:IsShown() then shown = true end
        end
    end)
    return shown
end

local function cn_freeze_buried_dot(obj_id, attempts_left)
    attempts_left = attempts_left or 8
    local obj = level.object_by_id(obj_id)
    if obj then
        pcall(function()
            local shell = obj:get_physics_shell()
            if shell then
                shell:set_active(false)
                shell:set_ignore_gravity(true)
            end
        end)
        return
    end
    if attempts_left <= 0 then return end
    CreateTimeEvent("tft_cn", "freeze_dot_" .. tostring(obj_id), 0.2, function()
        cn_freeze_buried_dot(obj_id, attempts_left - 1)
        return true
    end)
end

local function cn_spawn_dot(ids, index, pos, spot)
    if not ids then return end
    if ids[index] then return end
    if not (pos and pos.x and db.actor) then return end
    local lvid = nil
    if level and level.vertex_id then
        local ok, v = pcall(function() return level.vertex_id(pos) end)
        if ok and cn_valid_lvid(v) then lvid = v end
    end
    if not lvid then lvid = db.actor:level_vertex_id() end
    local buried = vector():set(pos.x, pos.y - CN_UNDERGROUND_Y, pos.z)
    local se = alife_create("device_pda", buried, lvid, db.actor:game_vertex_id())
    if not se then return end
    ids[index] = se.id
    pcall(function() level.map_add_object_spot_ser(se.id, spot, "") end)
    cn_freeze_buried_dot(se.id)
end

local function cn_clear_display()
    local st = cn_state()
    local function clear_table(ids, spot)
        for _, obj_id in pairs(ids or {}) do
            pcall(function()
                if level and level.map_remove_object_spot then
                    level.map_remove_object_spot(obj_id, spot)
                end
                local obj = alife_object(obj_id)
                if obj then pcall(alife_release, obj) end
            end)
        end
    end
    clear_table(st.dot_ids, SPOT_NODE)
    clear_table(st.endpoint_dot_ids, SPOT_ENDPOINT)
    clear_table(st.edge_dot_ids, SPOT_EDGE)
    st.dot_ids = {}
    st.endpoint_dot_ids = {}
    st.edge_dot_ids = {}
    st.display_active = false
end

local function cn_refresh_display()
    cn_clear_display()
    local st = cn_state()
    local g = st.graph
    if not g then return end
    local cache = {}
    local placed = 0
    local idx = 0
    for id = 0, g.node_count - 1, CN_DISPLAY_STRIDE do
        if placed >= CN_DISPLAY_MARKERS_MAX then break end
        local p = cn_vertex_pos(id, cache)
        if p then
            idx = idx + 1
            cn_spawn_dot(st.dot_ids, idx, vector():set(p.x, p.y + 0.1, p.z), SPOT_NODE)
            placed = placed + 1
        end
    end
    st.display_active = true
    cn_log("display ON: %d subsampled nodes (stride=%d)", placed, CN_DISPLAY_STRIDE)
end

local function cn_sync_display()
    local st = cn_state()
    if cn_want_display() and st.graph and cn_is_pda_map_shown() then
        cn_refresh_display()
    else
        cn_clear_display()
    end
end

local function cn_sync_display_pda()
    local st = cn_state()
    if not cn_want_display() or not st.graph then
        if st.display_active then cn_clear_display() end
        return
    end
    local shown = cn_is_pda_map_shown()
    if shown and not st.display_active then
        cn_refresh_display()
    elseif not shown and st.display_active then
        cn_clear_display()
    end
end

local function cn_on_actor_update()
    cn_sync_display_pda()
end

local function cn_on_level_change()
    cn_clear_display()
    cn_state().graph = nil
    cn_state().dest_lvid_cache = {}
    if tft then
        tft.path_build_cache = nil
        tft.menu_path_cache = nil
        tft.path_chain = nil
        tft.path_chain_meta = nil
    end
    pcall(function()
        RemoveTimeEvent("tft_cn", "load_after_level")
    end)
    CreateTimeEvent("tft_cn", "load_after_level", 2.0, function()
        pcall(cn_try_load)
        return true
    end)
end

local function cn_handle_key(key)
    if not key then return end
    local cfg = _G.tft_config
    if not cfg then return end
    if cfg.nav_mesh_reload and key == cfg.nav_mesh_reload then
        cn_log("dev key: reload packaged nav mesh")
        pcall(cn_build_sync)
    end
end

do
    _G.tft_nav_mesh_try_load = cn_try_load
    _G.tft_nav_mesh_ensure_ready = cn_ensure_ready
    _G.tft_nav_mesh_build_sync = cn_build_sync
    _G.tft_nav_mesh_build_path = cn_build_path
    _G.tft_nav_mesh_dest_anchor_key = cn_dest_anchor_key_for_id
    _G.tft_nav_mesh_graph_ready = cn_graph_ready
    _G.tft_nav_mesh_on_level_change = cn_on_level_change
    _G.tft_nav_mesh_handle_key = cn_handle_key
    _G.tft_nav_mesh_sync_display = cn_sync_display
    _G.tft_nav_mesh_sync_display_pda = cn_sync_display_pda
    _G.tft_nav_mesh_clear_display = cn_clear_display
    _G.tft_nav_mesh_on_actor_update = cn_on_actor_update
    _G.tft_nav_mesh_astar_test = cn_astar_graph
    _G.tft_nav_mesh_graph_path = cn_graph_path
    _G.tft_nav_mesh_direct_dest_keys = cn_direct_dest_keys
    _G.tft_nav_mesh_nearest_node = cn_nearest_graph_node
    _G.tft_nav_mesh_splice_to_dest = cn_splice_to_dest
    _G.tft_nav_mesh_splice_from_pos = cn_splice_from_pos
    _G.tft_nav_mesh_finalize_graph = cn_finalize_graph
    printf("[dogma_gameplay_true_fast_travel] nav mesh module loaded")
end
