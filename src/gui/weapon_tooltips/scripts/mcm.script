		show_torso_7 = true,
		show_torso_8 = true,
		show_torso_9 = true,
		stat_row_placement = "inline",
		table_row_pad = 0,
		use_condition_stats = false,
		use_condition_table = false,
	},
	-- Filled by on_option_change (runs at boot before any read).
	loaded = {},
}

-- Vanilla GAMMA rows: dark-grey MCM captions (DOGMA rows stay default).
-- MCM only honors clr on title/desc; checks need a hook. CacheValue also resets
-- captions to stock grey/orange on toggle, so re-paint in on_selection too.
local VANILLA_CAP = {}
local CLR_VANILLA = GetARGB(255, 80, 80, 80) -- same as color_scale_from darkgrey
local CLR_PENDING = GetARGB(255, 250, 150, 75) -- MCM pending (clr_o)

local function paint_vanilla_cap(opt, pending)
	local cap = VANILLA_CAP[opt]
	if not cap then
		return
	end
	local tc = cap.TextControl and cap:TextControl()
	if not tc then
		return
	end
	tc:SetTextColor(pending and CLR_PENDING or CLR_VANILLA)
end

local function vanilla_ui_hook(_anchor, handlers, attrs, flags)
	if not (flags and flags.etype == "check" and handlers and handlers.cap and attrs) then
		return
	end
	local opt = attrs.id
	VANILLA_CAP[opt] = handlers.cap
	local pending = false
	if handlers.ctrl and handlers.ctrl.GetCheck and flags.path and ui_mcm then
		local shown = handlers.ctrl:GetCheck()
		local saved = ui_mcm.get(tostring(flags.path) .. "/" .. tostring(opt))
		pending = (shown and true or false) ~= (saved and true or false)
	end
	paint_vanilla_cap(opt, pending)
end

local function vanilla_on_select(path, opt, value, _attrs)
	local saved = ui_mcm and ui_mcm.get(tostring(path) .. "/" .. tostring(opt))
	local pending = (value and true or false) ~= (saved and true or false)
	paint_vanilla_cap(opt, pending)
end

local function vanilla_check(id, def, hint)
	return {
		id = id,
		type = "check",
		val = 1,
		def = def,
		hint = hint,
		ui_hook_functor = { vanilla_ui_hook },
		on_selection_functor = { vanilla_on_select },
	}
end

-- After Reset pending, MCM paints stock grey; re-apply dark grey.
RegisterScriptCallback("mcm_option_reset", function()
	for opt, _ in pairs(VANILLA_CAP) do
		paint_vanilla_cap(opt, false)
	end
end)
