--[[
	Inventory transfer keybind (hold+hover, replaces GAMMA Fast Transfer).
	Stacked cells transfer every item. Picker rows transfer the hovered item.
	Sort/rebuild that fills the same cell is locked until the cursor moves.
]]

local CONFIG = _G.dogma_input_inventory_controls_conf
local MOD_ID = CONFIG.MOD_ID

local ALLOWED_BAGS = {
	actor_bag = true,
	npc_bag = true,
	actor_trade = true,
	actor_trade_bag = true,
	npc_trade = true,
	npc_trade_bag = true,
	picker = true,
}

local BATCH_SIZE = 10
local LSHIFT = DIK_keys.DIK_LSHIFT
local RSHIFT = DIK_keys.DIK_RSHIFT

local key = nil
local modifier = 0
local bind = nil
local allow = 0
local original_action_move = nil
local original_action_move_all = nil
local move_wrapper = nil
local move_all_wrapper = nil

local function log(msg)
	if dogma.dbg.logging() then
		dogma.dbg.log(MOD_ID, tostring(msg))
	end
end

local function is_shift_key(dik)
	return dik == LSHIFT or dik == RSHIFT
end

local function on_option_change()
	key = dogma.mcm.key(MOD_ID, "key_transfer")
	modifier = dogma.mcm.int(MOD_ID, "key_transfer_modifier", 0)
	if bind then
		_G.dogma_inv_hover.reset(bind)
	end
end

local function inv_mode_ok(gui)
	local mode = gui and gui.mode
	return mode == "inventory" or mode == "loot" or mode == "trade"
end

local function key_down()
	if not key then
		return false
	end
	local down
	if key == LSHIFT or key == RSHIFT then
		down = dogma.input.is_shift_down()
	else
		down = dogma.input.is_key_down(key)
	end
	return down and dogma.input.is_mod_down(modifier)
end

-- Stock/GAMMA shift-hover also calls Action_Move. When our bind is Shift,
-- swallow those so only hold+hover runs.
local function suppress_inner()
	return allow == 0 and is_shift_key(key) and dogma.input.is_shift_down()
end

local function tick(gui)
	if gui and is_shift_key(key) and dogma.input.is_shift_down() then
		gui.holding_shift = false
	end
end

local function move_one(gui, obj, bag, idx)
	if not (gui and obj and gui.Action_Move) then
		return
	end
	if gui.Picker_Ownership then
		bag, idx = gui:Picker_Ownership(bag, idx, obj)
	end
	if gui.Cond_Move and not gui:Cond_Move(obj, bag) then
		return
	end
	allow = allow + 1
	gui:Action_Move(obj, bag)
	allow = allow - 1
end

local function move_many(gui, items, bag, idx)
	local ids = {}
	for i = 1, #items do
		ids[#ids + 1] = items[i]:id()
	end
	local i = 1
	CreateTimeEvent("dogma_transfer", ids[1], 0, function()
		local g = ui_inventory and ui_inventory.GUI
		if not (g and g.IsShown and g:IsShown()) then
			return true
		end
		for _ = 1, BATCH_SIZE do
			if i > #ids then
				return true
			end
			local item = level.object_by_id(ids[i])
			if item then
				move_one(g, item, bag, idx)
			end
			i = i + 1
		end
		return false
	end)
end

local function fire(gui, obj, bag, idx)
	local items = _G.dogma_inv_hover.stack_items(gui, obj, bag)
	if #items <= 1 then
		move_one(gui, obj, bag, idx)
		return
	end
	move_many(gui, items, bag, idx)
end

local function reapply_move_patch()
	local cls = ui_inventory and ui_inventory.UIInventory
	if not cls then
		return
	end
	if cls.Action_Move and cls.Action_Move ~= move_wrapper then
		original_action_move = cls.Action_Move
		move_wrapper = function(self, obj, bag)
			if suppress_inner() then
				return
			end
			return original_action_move(self, obj, bag)
		end
		cls.Action_Move = move_wrapper
	end
	if cls.Action_Move_All and cls.Action_Move_All ~= move_all_wrapper then
		original_action_move_all = cls.Action_Move_All
		move_all_wrapper = function(self, obj, bag)
			if suppress_inner() then
				return
			end
			return original_action_move_all(self, obj, bag)
		end
		cls.Action_Move_All = move_all_wrapper
	end
end

function on_game_start()
	dogma.load(MOD_ID)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_first_update", reapply_move_patch)
	on_option_change()
	reapply_move_patch()
	bind = _G.dogma_inv_hover.register({
		key_down = key_down,
		mode_ok = inv_mode_ok,
		bags = ALLOWED_BAGS,
		tick = tick,
		fire = fire,
	})
	log("transfer keys ready")
end
