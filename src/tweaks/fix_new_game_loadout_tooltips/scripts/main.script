--[[
	Tooltips Fix - always-on tooltip fixes for ALL item types.

	Seven independent fixes live here:

	1. LAYOUT: item tooltips (utils_ui.UIInfoItem) often end up with
	   overlapping / clipped sections after other mods append widgets (Parts
	   in Tooltip, Crafting Info, Weapon Tooltips' damage panel, etc.). Stock
	   Sync_Finale only knows about the vanilla chain (desc -> stats -> ammo ->
	   frame); anything else either overlaps or is left outside the frame.
	   Compare rebuilds and same-item Updates re-run that vanilla stack.
	   fix() runs once per tooltip (item change, or first Show after a hidden
	   Update), not every hover frame.

	2. LOADOUT ARMING: the New Game Loadout screen renders tooltips before any
	   on_game_start has fired, so the stats_table builders have not run yet:
	   utils_ui only populates its stock table lazily, ish_item_stats
	   (G.A.M.M.A. Accurate Defense Values) only rebuilds the GAMMA-rebalanced
	   rows from its own on_game_start, and DOGMA's Weapon Tooltips hooks are
	   likewise on_game_start-gated. Without this, the first Loadout screen of
	   a session shows raw stock-Anomaly tooltips; they only turn correct
	   after a game has been started once. run_early_inits() (bottom) runs all
	   of that on every main_menu_on_init - including outfit/artefact/booster
	   /backpack ADV rows, device power tables, and section-only outfit
	   FireWound / AP-res functors (stock ADB only computes those from a live
	   object).

	3. SECTION DESC HEADER: ui_item.get_obj_desc() builds a description header
	   (uses / power / condition / artefact-container lines) via
	   build_desc_header, which needs a live game object. The section-only
	   path, get_sec_desc(), skips the header entirely - so multi-use items,
	   devices, outfits, etc. look bare anywhere tooltips render from a
	   section: New Game Loadout, craft/repair previews, etc. We wrap
	   get_sec_desc to prepend whatever header lines a *fresh* item would
	   show (max uses, 100% power/condition, contained artefact name).

	4. SECTION OUTFIT FOOTER: build_desc_footer's outfit property block
	   (faction / helmet / sprint) gates on IsOutfit(obj), so section-only
	   outfit tooltips skip it even though every field is readable from the
	   section. We wrap build_desc_footer to inject that block when obj is nil.

	5. ICON OVERLAYS: Utjan Item UI Improvements draws outfit/helmet class
	   (novice/light/medium/heavy) and gun repair class (A/B/C/D colour chips)
	   on cell icons, but only after its on_game_start has run - so the first
	   New Game screen of a cold boot misses them, and they appear after you
	   start a game and quit back. early_init_icon_overlays() force-loads and
	   arms those modules on main_menu_on_init (nil-safe if Utjan is absent).

	6. LOADOUT / INVENTORY SORT: SortingPlus replaces utils_ui sort fns at MCM
	   load but only fills item_order on actor_on_first_update - so both New
	   Game panels can reshuffle after a game session. We pin:
	   - Loadout: misc → weapons → outfits/helms; each section size ascending
	     (small → large), then alpha.
	   - Inventory: cold-boot first-load order (size descending, then alpha)
	     so quit-back matches the first open.

	7. LOADOUT PTS: paints each item's point cost on its New Game icon
	   (Add_CustomText, small font). Free (0 pts) items show no number.
	   Fingerprint of shown cells; LoadLoadout / click invalidate so Reinit
	   always gets a fresh paint.

	Load timing (empirically established, xray log 2026-07-31): the engine
	loads .script modules LAZILY, on first reference of their global
	namespace. axr_main's load-every-script loop only runs from
	on_game_start(), so in a fresh-launch menu VM this file would never load
	(and the main_menu_on_init registration below would never execute) on its
	own (zzzz_dogma_tweaks_fix_new_game_loadout_tooltips_main). It is instead force-loaded by
	this mod's own mcm.script: MCM's gather_options() loads all *mcm.script
	files from main_menu:__init(),
	strictly before main_menu_on_init is sent. Also note main_menu_on_init
	fires on EVERY main-menu construction (including in-game ESC menus and
	after quitting a game), and the whole Lua VM is torn down and rebuilt
	during new-game creation - so everything here must be idempotent per-call
	and re-armed per-VM.
]]

local SECTION_GAP = 10 -- match vanilla UIInfoItem:Sync_Finale section spacing
-- Weapon Tooltips' damage panel sits flush under desc, then stats with a
-- tighter gap than the stock 10px.
local PANEL_TOP_OFFSET = 0
local STATS_AFTER_PANEL = 2
-- Match grok_actor_damage_balancer.get_adb_constants("FireWound").adjuster
local FIREWOUND_ADJUSTER = 0.80

local base_uiinfo_update
local base_uiinfo_show
local base_get_sec_desc
local base_build_desc_footer
local hooks_ok = false
local device_init_wrapped = false
local outfit_functors_wrapped = false

------------------------------------------------------------------------------
-- Fix 1: layout restacking
------------------------------------------------------------------------------

local function prepare_text_heights(info)
	if not info then
		return
	end
	pcall(function()
		if info.name then
			info.name:AdjustHeightToText()
		end
		if info.note and info.note:IsShown() then
			info.note:AdjustHeightToText()
		end
		if info.desc and info.desc:IsShown() then
			info.desc:AdjustHeightToText()
		end
	end)
end

-- Parts in Tooltip may sit beside stats (vertical) or under ammo (horizontal).
local function sync_parts(info, tail)
	if not info.parts or not info.parts:IsShown() then
		return tail
	end

	local stats = info.stats_dialog
	local stats_x = stats and stats:GetWndPos().x or 0
	local parts_x = info.parts:GetWndPos().x
	local vertical = stats and parts_x > stats_x + 50

	if vertical then
		local stats_pos = stats:GetWndPos()
		local parts_pos = info.parts:GetWndPos()
		info.parts:SetWndPos(vector2():set(parts_pos.x, stats_pos.y))
		if info.SyncPartsText then
			info:SyncPartsText(true)
		end
		local parts_bottom = stats_pos.y + info.parts:GetHeight()
		local tail_bottom = tail:GetWndPos().y + tail:GetHeight()
		if parts_bottom > tail_bottom then
			tail = info.parts
		end
	else
		info:Sync_Y(tail, info.parts, SECTION_GAP)
		tail = info.parts
		if info.SyncPartsText then
			info:SyncPartsText()
		end
	end

	return tail
end

local function pick_header_tail(info)
	-- Prefer desc when visible and non-zero height (Weapon Tooltips zeros height
	-- when hide_description is on; Show(false) alone still leaves stock height).
	if info.desc and info.desc:IsShown() then
		local h = 0
		pcall(function()
			h = info.desc:GetHeight()
		end)
		if h > 0 then
			return info.desc
		end
	end
	if info.note and info.note:IsShown() then
		return info.note
	end
	return info.weight
end

-- Public: re-measure + restack one tooltip. Idempotent.
function fix(info)
	if not info or not info.frame or not info.Sync_Y or not info.Sync_H then
		return
	end

	prepare_text_heights(info)

	local tail = pick_header_tail(info)
	if not tail then
		return
	end

	local after_panel = false
	if info.dogma_wpn_damage and info.dogma_wpn_damage:IsShown() then
		info:Sync_Y(tail, info.dogma_wpn_damage, PANEL_TOP_OFFSET)
		tail = info.dogma_wpn_damage
		after_panel = true
	end

	if info.stats_dialog and info.stats_dialog:IsShown() then
		info:Sync_Y(tail, info.stats_dialog, after_panel and STATS_AFTER_PANEL or SECTION_GAP)
		tail = info.stats_dialog
	end

	if info.ammo and info.ammo:IsShown() then
		info:Sync_Y(tail, info.ammo, SECTION_GAP)
		tail = info.ammo
	end

	tail = sync_parts(info, tail)

	if info.recipes and info.recipes:IsShown() then
		info:Sync_Y(tail, info.recipes, SECTION_GAP)
		tail = info.recipes
	end

	if info.cooking and info.cooking:IsShown() then
		info:Sync_Y(tail, info.cooking, SECTION_GAP)
		tail = info.cooking
	end

	info:Sync_H(tail, info.frame, SECTION_GAP)
end

-- Vanilla UIInfoItem:Show pins the dialog (cursor, then lift / top-of-screen
-- when taller than 768). Sync_H above can grow the box after that clamp.
local function clamp_tooltip(info)
	if not info or not base_uiinfo_show then
		return
	end
	if not (info.IsShown and info:IsShown()) then
		return
	end
	base_uiinfo_show(info, true)
end

local function safe_id(obj)
	if not obj then
		return nil
	end
	local ok, id = pcall(function()
		return obj:id()
	end)
	if ok then
		return id
	end
	return nil
end

local function stats_overlap_table(info)
	local panel = info and info.dogma_wpn_damage
	local stats = info and info.stats_dialog
	if not (panel and stats and panel.IsShown and panel:IsShown() and stats:IsShown()) then
		return false
	end
	return stats:GetWndPos().y < panel:GetWndPos().y + panel:GetHeight()
end

local function uiinfo_update_hook(self, obj, sec, flags)
	local oid = safe_id(obj)
	local same_item = (oid and self.id and oid == self.id)
		or (not obj and sec and self.section == sec)

	if base_uiinfo_update then
		base_uiinfo_update(self, obj, sec, flags)
	end

	-- Read dirty after the inner hook (Weapon Tooltips may set it). Once per
	-- item; do not restack every hidden Update while waiting for Show.
	local dirty = self.dogma_layout_dirty
	if not same_item then
		fix(self)
		if self.IsShown and self:IsShown() then
			self.dogma_layout_dirty = false
			clamp_tooltip(self)
		else
			self.dogma_layout_dirty = true
		end
	elseif dirty and self.IsShown and self:IsShown() then
		fix(self)
		self.dogma_layout_dirty = false
		clamp_tooltip(self)
	elseif stats_overlap_table(self) then
		fix(self)
		clamp_tooltip(self)
	end
end

local function uiinfo_show_hook(self, state)
	if state and self.dogma_layout_dirty then
		fix(self)
		self.dogma_layout_dirty = false
	end
	if base_uiinfo_show then
		base_uiinfo_show(self, state)
	end
end

------------------------------------------------------------------------------
-- Fix 3 / 4: section-only description header + outfit footer
------------------------------------------------------------------------------

local function gc(id)
	return game.translate_string(id)
end

-- Header lines a fresh (section-only) item can show. Mirrors ui_item.build_desc_header
-- without needing a live object; condition/power assume a brand-new item (100%).
local function build_sec_desc_header(sec)
	if not sec or not ini_sys then
		return ""
	end

	local clr_g = utils_xml.get_color("d_green")
	local clr_o = utils_xml.get_color("d_orange")
	local clr_b1 = utils_xml.get_color("pda_blue")
	local clr_2 = utils_xml.get_color("ui_gray_1")

	-- Consumable uses (IsItem("multiuse") returns max_uses as a number).
	local uses = IsItem("multiuse", sec)
	if type(uses) ~= "number" then
		uses = ini_sys:r_float_ex(sec, "max_uses")
	end
	if type(uses) == "number" and uses > 0 then
		return clr_g .. "  " .. clr_2 .. gc("st_ui_number_of_uses") .. ": " .. clr_g
			.. string.format("%d", uses) .. "\\n \\n" .. clr_2
	end

	-- Device / battery power (fresh = full).
	if IsItem("device", sec) or IsItem("battery", sec) then
		return clr_b1 .. "  " .. clr_2 .. gc("st_ui_power") .. ": " .. clr_b1
			.. "100%" .. "\\n \\n" .. clr_2
	end

	-- Outfit / helmet / backpack / disassemble condition (fresh = 100%).
	if IsItem("outfit", sec) or IsItem("helmet", sec)
		or IsItem("backpack", sec) or IsItem("disassemble", sec)
	then
		local clr = utils_xml.get_color_con and utils_xml.get_color_con(100) or clr_g
		return clr .. "  " .. clr_2 .. gc("st_condition") .. ": " .. clr
			.. "100%" .. "\\n \\n" .. clr_2
	end

	-- Named condition parts (fresh = excellent / 100).
	if ini_sys:r_bool_ex(sec, "cond_part") then
		local con_name = (utils_xml.get_name_cond and utils_xml.get_name_cond(100, nil, sec))
			or "100%"
		local clr = utils_xml.get_color_con and utils_xml.get_color_con(100) or clr_g
		return clr .. "  " .. clr_2 .. gc("st_condition") .. ": " .. clr
			.. con_name .. "\\n \\n" .. clr_2
	end

	-- Contained artefact (lead box / IAM / AAC / AAM) - name only, no obj needed.
	if string.find(sec, "af_", 1, true) then
		local break_arty
		if string.find(sec, "_lead_box", 1, true) then
			break_arty = sec:gsub("_lead_box", "")
		elseif string.find(sec, "_af_iam", 1, true) then
			break_arty = sec:gsub("_af_iam", "")
		elseif string.find(sec, "_af_aac", 1, true) then
			break_arty = sec:gsub("_af_aac", "")
		elseif string.find(sec, "_af_aam", 1, true) then
			break_arty = sec:gsub("_af_aam", "")
		end
		if break_arty and ini_sys:section_exist(break_arty) then
			local name = (ui_item and ui_item.get_sec_name and ui_item.get_sec_name(break_arty))
				or gc(ini_sys:r_string_ex(break_arty, "inv_name") or "")
			if name and name ~= "" then
				return clr_o .. "  " .. clr_2 .. gc("st_itm_desc_arty_cont") .. ": "
					.. clr_o .. name .. "\\n \\n" .. clr_2
			end
		end
	end

	return ""
end

-- Outfit property block from section (stock gates on IsOutfit(obj)).
local function build_outfit_props_from_sec(sec)
	if not sec or not ini_sys or not IsItem("outfit", sec) then
		return ""
	end

	local clr_y = utils_xml.get_color("yellow")
	local clr_p = utils_xml.get_color("d_purple")
	local clr_1 = utils_xml.get_color("ui_gray_2")
	local clr_2 = utils_xml.get_color("ui_gray_1")

	local helmet_avaliable = ini_sys:r_bool_ex(sec, "helmet_avaliable") ~= false
	local sprint_allowed = ini_sys:r_bool_ex(sec, "sprint_allowed") ~= false
	local community = ini_sys:r_string_ex(sec, "community")
	local comm_str = (community and community ~= ""
		and gc("st_dyn_news_comm_" .. community .. "_6"))
		or gc("st_dyn_news_unknown_contact")

	local _str = clr_2 .. " " .. gc("st_itm_desc_properties") .. ":\\n"
	_str = _str .. clr_y .. "  " .. clr_1 .. " " .. gc("st_itm_desc_outfit_faction")
		.. ": " .. clr_2 .. comm_str .. " \\n"
	_str = _str .. clr_p .. "  " .. clr_1 .. " " .. gc("st_itm_desc_outfit_heardgear")
		.. ": " .. clr_2
		.. (helmet_avaliable and gc("st_itm_desc_state_not_included")
			or gc("st_itm_desc_state_avail"))
		.. " \\n"
	_str = _str .. clr_p .. "  " .. clr_1 .. " " .. gc("st_itm_desc_outfit_run") .. " "
		.. (sprint_allowed and gc("st_itm_desc_state_possible")
			or gc("st_itm_desc_state_not_possible"))
		.. " \\n"
	return _str
end

local function sec_desc_hook(sec)
	local str = base_get_sec_desc and base_get_sec_desc(sec) or ""
	if not sec or str == "" then
		return str
	end

	local header = build_sec_desc_header(sec)
	if header ~= "" then
		str = header .. str
	end
	return str
end

local function build_desc_footer_hook(obj, sec, str)
	local result = base_build_desc_footer and base_build_desc_footer(obj, sec, str) or (str or "")
	-- Stock skips the outfit props block when obj is nil (IsOutfit(nil) == false).
	if obj or not sec or not IsItem("outfit", sec) then
		return result
	end

	local helm_label = gc("st_itm_desc_outfit_heardgear")
	if string.find(result, helm_label, 1, true) then
		return result
	end

	local props = build_outfit_props_from_sec(sec)
	if props == "" then
		return result
	end

	-- Insert outfit props immediately after the pre-footer description text.
	local base_str = str or ""
	if base_str ~= "" and string.sub(result, 1, #base_str) == base_str then
		return base_str .. props .. string.sub(result, #base_str + 1)
	end
	return props .. result
end

------------------------------------------------------------------------------
-- Early arming helpers (device power table + outfit ADB functors)
------------------------------------------------------------------------------

-- item_device.initialize() only runs from its on_game_start; without it,
-- build_desc_footer's power-consumption line reads an empty table. Stock
-- initialize is not idempotent (re-run doubles totals), so wrap once and
-- skip if the table was already filled by an earlier on_game_start.
local function early_init_item_device()
	-- Direct global reference: lazy-loads the module into the menu VM.
	if not item_device or not item_device.initialize then
		return
	end

	if not device_init_wrapped then
		device_init_wrapped = true
		local base_init = item_device.initialize
		local done = false
		item_device.initialize = function()
			if done then
				return
			end
			done = true
			if item_device.dev_consumption_tot
				and next(item_device.dev_consumption_tot)
			then
				return
			end
			base_init()
		end
	end

	item_device.initialize()
end

-- ADB outfit functors: AP-res has no section path; FireWound's section path
-- wrongly uses hit_fraction_actor instead of bones_koeff bone armor. Wrap so
-- Loadout / craft previews match in-game fresh-item tooltips.
local function wrap_outfit_functors()
	if outfit_functors_wrapped then
		return
	end
	-- Direct global reference: lazy-loads Actor Damage Balancer.
	if not grok_actor_damage_balancer then
		return
	end
	local grok = grok_actor_damage_balancer
	outfit_functors_wrapped = true

	local base_ap = grok.get_outfit_ap_res
	if base_ap then
		grok.get_outfit_ap_res = function(obj, sec)
			local v = base_ap(obj, sec)
			if v ~= nil then
				return v
			end
			sec = sec or (obj and obj:section())
			if not sec or not ini_sys then
				return
			end
			local hit_frac = ini_sys:r_float_ex(sec, "hit_fraction_actor")
			if hit_frac then
				return 1 - hit_frac
			end
		end
	end

	local base_val = grok.get_outfit_value
	if base_val then
		grok.get_outfit_value = function(obj, sec, name, def)
			if obj then
				return base_val(obj, sec, name, def)
			end
			-- Section-only FireWound: bone armor x FireWound adjuster x 100
			-- (matches cast_CustomOutfit():GetBoneArmor path at condition 1.0).
			if name == "FireWound" and sec and ini_sys and parse_list then
				local bones = ini_sys:r_string_ex(sec, "bones_koeff_protection")
				if bones and bones ~= "" then
					local bone = IsItem("helmet", sec) and "bip01_head" or "bip01_spine"
					local vals = parse_list(ini_sys, bones, bone)
					local br = vals and tonumber(vals[2])
					if br then
						return math.ceil(br * FIREWOUND_ADJUSTER * 100)
					end
				end
			end
			return base_val(obj, sec, name, def)
		end
	end
end

------------------------------------------------------------------------------
-- Hook install / arming
------------------------------------------------------------------------------

local function install_hooks()
	if not utils_ui or not utils_ui.UIInfoItem then
		return false
	end

	-- Always reclaim outermost so Parts/Craft/Weapon Tooltips' Sync_Finale
	-- cannot leave the stack wrong after we return.
	if utils_ui.UIInfoItem.Update ~= uiinfo_update_hook then
		-- Capture the underlying Update exactly once per Lua VM. Re-capturing
		-- on a reclaim can grab a wrapper that itself chains back to this hook
		-- (e.g. Weapon Tooltips'), creating L->W->L infinite recursion =
		-- engine stack-overflow crash on the first tooltip.
		if not base_uiinfo_update then
			base_uiinfo_update = utils_ui.UIInfoItem.Update
		end
		utils_ui.UIInfoItem.Update = uiinfo_update_hook
	end

	if utils_ui.UIInfoItem.Show and utils_ui.UIInfoItem.Show ~= uiinfo_show_hook then
		if not base_uiinfo_show then
			base_uiinfo_show = utils_ui.UIInfoItem.Show
		end
		utils_ui.UIInfoItem.Show = uiinfo_show_hook
	end

	if ui_item and ui_item.get_sec_desc and ui_item.get_sec_desc ~= sec_desc_hook then
		if not base_get_sec_desc then
			base_get_sec_desc = ui_item.get_sec_desc
		end
		ui_item.get_sec_desc = sec_desc_hook
	end

	if ui_item and ui_item.build_desc_footer
		and ui_item.build_desc_footer ~= build_desc_footer_hook
	then
		if not base_build_desc_footer then
			base_build_desc_footer = ui_item.build_desc_footer
		end
		ui_item.build_desc_footer = build_desc_footer_hook
	end

	hooks_ok = true
	return true
end

local function on_actor_update()
	-- Reclaim if another mod re-wrapped Update/Show after us.
	if hooks_ok and utils_ui and utils_ui.UIInfoItem
		and (utils_ui.UIInfoItem.Update ~= uiinfo_update_hook
			or (utils_ui.UIInfoItem.Show and utils_ui.UIInfoItem.Show ~= uiinfo_show_hook))
	then
		install_hooks()
	end
end

local callbacks_registered = false
local gsm_wrapped = false
local ng_wrap_state = {}

------------------------------------------------------------------------------
-- Fix 5: Utjan icon overlays on first New Game screen
------------------------------------------------------------------------------

-- Force-load + arm Item UI Improvements so outfit/helmet class chips and gun
-- repair-class icons paint on showcase cells before any on_game_start.
local function early_init_icon_overlays()
	-- Direct refs: lazy-load into the menu VM (nil if Utjan is not installed).
	if not z_item_icon_info then
		return
	end

	-- Hooks (Add_Counter / Add_ProgressBar wrappers) install at module load.
	-- XML + MCM settings normally wait for z_item_icon_info.on_game_start.
	if not z_item_icon_info.utjan_xml and CScriptXmlInit then
		z_item_icon_info.utjan_xml = CScriptXmlInit()
		z_item_icon_info.utjan_xml:ParseFile("ui_utjan_icon_info.xml")
	end
	if z_item_icon_info.load_settings then
		z_item_icon_info.load_settings()
	end

	-- Armor/helmet class layers register via rax_icon_layers in
	-- dynamic_eq_icon.on_game_start. Wrap once so a later real on_game_start
	-- does not double-register the same functors (duplicate chips).
	if dynamic_eq_icon and dynamic_eq_icon.on_game_start then
		if not dynamic_eq_icon._dogma_ogs_wrapped then
			dynamic_eq_icon._dogma_ogs_wrapped = true
			local base_ogs = dynamic_eq_icon.on_game_start
			dynamic_eq_icon.on_game_start = function()
				if dynamic_eq_icon.ini_icons then
					return
				end
				base_ogs()
			end
		end
		dynamic_eq_icon.on_game_start()
	end
end

------------------------------------------------------------------------------
-- Fix 6: New Game Loadout sort (first-load safe, loadout panel only)
------------------------------------------------------------------------------

local GROUP_MISC = 1
local GROUP_WEAP = 2
local GROUP_OUTFIT = 3

local function loadout_group(sec)
	if not sec then
		return GROUP_MISC
	end
	if IsItem("helmet", sec) or IsItem("outfit", sec) then
		return GROUP_OUTFIT
	end
	local kind = SYS_GetParam and SYS_GetParam(0, sec, "kind", "") or ""
	if kind == "o_helmet" or string.sub(kind, 1, 2) == "o_" then
		return GROUP_OUTFIT
	end
	if string.sub(kind, 1, 2) == "w_" then
		return GROUP_WEAP
	end
	return GROUP_MISC
end

local function loadout_size(sec)
	local w, h = 1, 1
	if SYS_GetParam then
		w = SYS_GetParam(2, sec, "inv_grid_width", 1) or 1
		h = SYS_GetParam(2, sec, "inv_grid_height", 1) or 1
	end
	return (w * h), w, h
end

local function sec_of(entry)
	if type(entry) == "string" then
		return entry
	end
	if entry and entry.section then
		return entry:section()
	end
	return nil
end

-- Size ascending (small → large by grid w, then h), then alpha.
local function sort_size_asc(t, a, b)
	local seca = sec_of(t[a])
	local secb = sec_of(t[b])
	if not seca then
		return false
	end
	if not secb then
		return true
	end

	local _, wa, ha = loadout_size(seca)
	local _, wb, hb = loadout_size(secb)
	if wa ~= wb then
		return wa < wb
	end
	if ha ~= hb then
		return ha < hb
	end
	return seca < secb
end

-- Cold-boot sizekind with empty SortingPlus item_order: bigger w/h first, then alpha.
local function sort_size_desc(t, a, b)
	local seca = sec_of(t[a])
	local secb = sec_of(t[b])
	if not seca then
		return false
	end
	if not secb then
		return true
	end

	local _, wa, ha = loadout_size(seca)
	local _, wb, hb = loadout_size(secb)
	if wa ~= wb then
		return wa > wb
	end
	if ha ~= hb then
		return ha > hb
	end
	return seca < secb
end

-- Loadout: misc → weapons → outfits/helms; each section size ascending.
local function sort_loadout(t, a, b)
	local seca = sec_of(t[a])
	local secb = sec_of(t[b])
	if not seca then
		return false
	end
	if not secb then
		return true
	end

	local ga = loadout_group(seca)
	local gb = loadout_group(secb)
	if ga ~= gb then
		return ga < gb
	end
	return sort_size_asc(t, a, b)
end

-- Inventory: same cold-boot first-load order end-to-end.
local function sort_inventory_first_load(t, a, b)
	return sort_size_desc(t, a, b)
end

local function wrap_get_sort_method()
	if gsm_wrapped or not utils_ui or not utils_ui.UICellContainer then
		return gsm_wrapped
	end
	local base = utils_ui.UICellContainer.GetSortMethod
	if not base then
		return false
	end
	utils_ui.UICellContainer.GetSortMethod = function(self)
		if self and self.dogma_ng_loadout_sort then
			return self.dogma_ng_loadout_sort
		end
		return base(self)
	end
	gsm_wrapped = true
	return true
end

local function mark_loadout_sort(self)
	local cc = self and self.CC and self.CC["loadout"]
	if cc then
		cc.dogma_ng_loadout_sort = sort_loadout
	end
	-- Inventory: freeze cold-boot first-load order (size desc), so SortingPlus
	-- filling item_order after a game session cannot reshuffle it.
	local inv = self and self.CC and self.CC["inventory"]
	if inv then
		inv.dogma_ng_loadout_sort = sort_inventory_first_load
	end
end

-- Fix 7: point cost on New Game icons (G.A.M.M.A. UICellItem:Add_CustomText).
local function paint_pts_on_cells(cc)
	if not (cc and cc.cell) then
		return
	end
	local fnt = GetFontSmall and GetFontSmall() or nil
	local clr = GetARGB and GetARGB(255, 180, 180, 180) or nil
	local align_l, align_top = 0, 0 -- utils_ui: 0=left/top
	for _, ci in pairs(cc.cell) do
		if ci:IsShown() and ci.Add_CustomText then
			local pts = ci.flags and (ci.flags.info or ci.flags.value) or 0
			if pts and pts > 0 then
				ci:Add_CustomText(tostring(pts), align_l, align_top, clr, fnt)
			end
		end
	end
end

local function paint_pts_both(self)
	if self.CC then
		paint_pts_on_cells(self.CC["inventory"])
		paint_pts_on_cells(self.CC["loadout"])
	end
end

local function cells_fp(self)
	local parts = {}
	local names = { "inventory", "loadout" }
	for i = 1, #names do
		local cc = self.CC and self.CC[names[i]]
		if cc and cc.cell then
			for _, ci in pairs(cc.cell) do
				if ci:IsShown() then
					local sec = ci.section or ""
					local pts = ci.flags and (ci.flags.info or ci.flags.value) or 0
					parts[#parts + 1] = names[i] .. ":" .. tostring(sec) .. "=" .. tostring(pts)
				end
			end
		end
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

local function invalidate_pts(self)
	if self then
		self._dogma_loadout_pts_fp = nil
	end
end

local function wrap_update(cls)
	if ng_wrap_state.update and cls.Update == ng_wrap_state.update then
		return true
	end
	local base = cls.Update
	if not base then
		return false
	end
	local function wrapped(self, ...)
		local r = base(self, ...)
		local fp = cells_fp(self)
		if fp ~= "" and fp ~= self._dogma_loadout_pts_fp then
			self._dogma_loadout_pts_fp = fp
			pcall(paint_pts_both, self)
		end
		return r
	end
	cls.Update = wrapped
	ng_wrap_state.update = wrapped
	return true
end

local function wrap_on_cc_mouse1(cls)
	if ng_wrap_state.mouse1 and cls.On_CC_Mouse1 == ng_wrap_state.mouse1 then
		return true
	end
	local base = cls.On_CC_Mouse1
	if not base then
		return false
	end
	local function wrapped(self, cont, idx)
		local r = base(self, cont, idx)
		invalidate_pts(self)
		return r
	end
	cls.On_CC_Mouse1 = wrapped
	ng_wrap_state.mouse1 = wrapped
	return true
end

local function wrap_load_loadout(cls)
	if ng_wrap_state.load and cls.LoadLoadout == ng_wrap_state.load then
		return true
	end
	local base = cls.LoadLoadout
	if not base then
		return false
	end
	local function wrapped(self, rand)
		mark_loadout_sort(self)
		local r = base(self, rand)
		invalidate_pts(self)
		return r
	end
	cls.LoadLoadout = wrapped
	ng_wrap_state.load = wrapped
	return true
end

local function wrap_main_controls(cls)
	if ng_wrap_state.controls and cls.Main_Controls == ng_wrap_state.controls then
		return true
	end
	local base = cls.Main_Controls
	if not base then
		return false
	end
	local function wrapped(self, ...)
		-- Wrap LoadLoadout before base so any LoadLoadout inside uses our sort.
		wrap_get_sort_method()
		wrap_load_loadout(cls)
		local r = base(self, ...)
		-- Re-assert as outermost after other mods re-wrap inside Main_Controls.
		wrap_load_loadout(cls)
		wrap_on_cc_mouse1(cls)
		wrap_update(cls)
		mark_loadout_sort(self)
		invalidate_pts(self)
		return r
	end
	cls.Main_Controls = wrapped
	ng_wrap_state.controls = wrapped
	return true
end

-- Public: patch UINewGame so Loadout Reinit uses our comparator and pts paint.
-- Safe to call repeatedly (menu MCM load, main_menu_on_init, Main_Controls).
function patch_new_game_ui()
	wrap_get_sort_method()
	local cls = ui_mm_faction_select and ui_mm_faction_select.UINewGame
	if not cls then
		return false
	end
	local ok = wrap_load_loadout(cls) and wrap_on_cc_mouse1(cls) and wrap_update(cls)
	wrap_main_controls(cls)
	return ok
end

-- Idempotent. Safe from main_menu_on_init (no game loaded yet).
function early_init()
	install_hooks()
	early_init_item_device()
	wrap_outfit_functors()
	early_init_icon_overlays()
	patch_new_game_ui()

	if not callbacks_registered then
		callbacks_registered = true
		RegisterScriptCallback("actor_on_update", on_actor_update)
		RegisterScriptCallback("actor_on_first_update", install_hooks)
	end
end

------------------------------------------------------------------------------
-- Fix 2: menu-time arming so the first Loadout screen is already correct
------------------------------------------------------------------------------

--[[
	On every main_menu_on_init: populate the stock stats table, arm this
	module and Weapon Tooltips (if installed), then force ish_item_stats'
	GAMMA rebuild (Weapon Tooltips wraps override_stats_table in its
	early_init, so its rows are re-applied on top). Also warm item_device
	power tables, wrap ADB outfit functors, arm Utjan icon overlays, and
	patch New Game Loadout sorting. All steps are idempotent / internally
	guarded, and they re-run safely when the real on_game_start eventually
	fires.

	Deliberately NOT forced early: ish_item_stats.on_game_start() itself - its
	UIInfoItem.Update tweak needs db.actor paths the Loadout screen never
	takes, and calling it would double-register its on_console_execute
	callback once the real on_game_start fires.
]]
local function run_early_inits()
	if utils_ui and utils_ui.prepare_stats_table then
		utils_ui.prepare_stats_table()
	end

	-- Direct global reference on purpose: it triggers the engine's lazy script
	-- loader, pulling Weapon Tooltips into the menu VM (nil if not installed).
	if zzzz_dogma_gui_weapon_tooltips_main and zzzz_dogma_gui_weapon_tooltips_main.early_init then
		zzzz_dogma_gui_weapon_tooltips_main.early_init()
	end

	early_init()

	if ish_item_stats and ish_item_stats.override_stats_table then
		ish_item_stats.override_stats_table()
	end
end

RegisterScriptCallback("main_menu_on_init", run_early_inits)

function on_game_start()
	early_init()
end
