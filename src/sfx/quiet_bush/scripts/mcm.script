function on_mcm_load(options)
	dogma_mcm.attach(options, "sfx", "ui_mcm_menu_dogma_sfx", {
		id = "quiet_bush",
		sh = true,
		text = "ui_mcm_menu_dogma_sfx_quiet_bush",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_sfx_quiet_bush_page_description",
			},
		}),
	})
end
