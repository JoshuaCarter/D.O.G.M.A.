-- Controls label renames for pose_controls. Patches ui_st_keybinding.
-- Stock Walk/Low Crouch (kb_walk / accel) is Prone under this mod.
-- Uses remove+insert so a failed child-text query cannot leave the old string.

local LABELS = {
	kb_walk = "Prone",
}

local function is_keybinding_strings(xml_file_name)
	return xml_file_name == [[text\eng\ui_st_keybinding.xml]]
		or xml_file_name == [[text/eng/ui_st_keybinding.xml]]
		or xml_file_name == [[text\rus\ui_st_keybinding.xml]]
		or xml_file_name == [[text/rus/ui_st_keybinding.xml]]
end

local function set_label(xml_obj, id, text)
	local q = string.format("string[id=%s]", id)
	local existing = xml_obj:query(q)
	while existing[1] do
		xml_obj:removeElement(existing[1])
		existing = xml_obj:query(q)
	end
	xml_obj:insertFromXMLString(string.format(
		'<string id="%s">\n\t\t<text>%s</text>\n\t</string>',
		id,
		text
	))
end

local xml_read_cb = function(xml_file_name, xml_obj)
	if not is_keybinding_strings(xml_file_name) then
		return
	end
	for id, text in pairs(LABELS) do
		set_label(xml_obj, id, text)
	end
end

function on_xml_read()
	RegisterScriptCallback("on_xml_read", xml_read_cb)
end
