--[[
	Random helpers. Tickets are weights; rand_from_tickets returns the index.
]]

function rand(min, max)
	if min == nil or max == nil then
		return math.random()
	end
	min = math.floor(min)
	max = math.floor(max)
	if max < min then
		min, max = max, min
	end
	return math.random(min, max)
end

function rand_from_tickets(tickets)
	if not tickets then
		return nil
	end
	local total = 0
	for i = 1, #tickets do
		local n = tickets[i]
		if n and n > 0 then
			total = total + n
		end
	end
	if total <= 0 then
		return nil
	end
	local r = rand(1, total)
	local acc = 0
	for i = 1, #tickets do
		local n = tickets[i]
		if n and n > 0 then
			acc = acc + n
			if r <= acc then
				return i
			end
		end
	end
	return nil
end
