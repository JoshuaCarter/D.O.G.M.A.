<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_menu">
		<text>Menu</text>
	</string>
	<string id="ui_mcm_menu_dogma_menu_dynamic_loadout">
		<text>Dynamic Loadout</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_page_description">
		<text>When Enabled, New Game strips stock weapons/ammo/outfits/helmets from the panels, then adds scored options into the loadout (purchase) list. Other stock items stay. Weights 0-1 step 0.01.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_caps_section">
		<text>Per-category pts caps</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_weights_section">
		<text>Score weights (0-1)</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_weights_weapon">
		<text>- Weapons -</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_weights_armor">
		<text>- Armor / helmet -</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_weights_ammo">
		<text>- Ammo -</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_weights_sight">
		<text>- Sights -</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_enabled">
		<text>Enabled</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_enabled_desc">
		<text>When on, opening New Game rebuilds the loadout (shop) options from scored weapons/ammo/outfits/helmets. Inventory keeps non-gear basics.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_log_scores">
		<text>Log scores</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_log_scores_desc">
		<text>Dump every scored item to the game log ([dogma_menu_dynamic_loadout]).</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_include_universal_armor">
		<text>Include universal armor</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_include_universal_armor_desc">
		<text>Also allow outfits with empty/actor community alongside faction suits.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_weapon">
		<text>Max weapon pts</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_weapon_desc">
		<text>Supply all weapons with pts strictly below this.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_armor">
		<text>Max armor pts</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_armor_desc">
		<text>Supply all outfits with pts strictly below this.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_helmet">
		<text>Max helmet pts</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_helmet_desc">
		<text>Supply all helmets with pts strictly below this.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_ammo">
		<text>Max ammo pts</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_ammo_desc">
		<text>Among non-AP ammo used by supplied guns, only types under this pts get 2 stacks.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_sight">
		<text>Max sight pts</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_sight_desc">
		<text>Supply compatible plain sights with pts strictly below this.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_cost_mult_section">
		<text>--- Cost multipliers (pts = avg x mult) ---</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_cost_mult_weapon">
		<text>Weapon cost mult</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_cost_mult_weapon_desc">
		<text>Shop pts for weapons = weighted avg of 0-1 stats x this (1-100000).</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_cost_mult_armor">
		<text>Armor cost mult</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_cost_mult_armor_desc">
		<text>Shop pts for outfits = weighted avg of 0-1 stats x this (1-100000).</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_cost_mult_helmet">
		<text>Helmet cost mult</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_cost_mult_helmet_desc">
		<text>Shop pts for helmets = weighted avg of 0-1 stats x this (1-100000).</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_cost_mult_ammo">
		<text>Ammo cost mult</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_cost_mult_ammo_desc">
		<text>Shop pts for ammo = weighted avg of 0-1 stats x this (1-100000).</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_cost_mult_sight">
		<text>Sight cost mult</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_cost_mult_sight_desc">
		<text>Shop pts for sights = weighted avg of 0-1 stats x this (1-100000).</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_mut_dmg">
		<text>Weapon: mut_dmg (armor col 1)</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_mut_dmg_desc">
		<text>Highest TT table damage vs Min armor across all ammo_class rounds.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_lgt_dmg">
		<text>Weapon: lgt_dmg (armor col 2)</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_lgt_dmg_desc">
		<text>Highest TT table damage vs Lgt armor across all ammo_class rounds.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_mid_dmg">
		<text>Weapon: mid_dmg (armor col 3)</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_mid_dmg_desc">
		<text>Highest TT table damage vs Lgt+ armor across all ammo_class rounds.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_hvy_dmg">
		<text>Weapon: hvy_dmg (armor col 4)</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_hvy_dmg_desc">
		<text>Highest TT table damage vs Mid armor across all ammo_class rounds.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_max_dmg">
		<text>Weapon: max_dmg (armor col 5)</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_max_dmg_desc">
		<text>Highest TT table damage vs Mid+ armor across all ammo_class rounds.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_rpm">
		<text>Weapon: fire rate</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_rpm_desc">
		<text>Base-GAMMA rpm (allowed with mag size).</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_mag">
		<text>Weapon: mag size</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_mag_desc">
		<text>ammo_mag_size normalized 0-1 with soft ceiling 50 (50+ clamps to 1).</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_burst">
		<text>Weapon: Burst Size</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_burst_desc">
		<text>DOGMA Burst Size (shots to ~3 deg cam climb), normalized /10 (10+ = 1).</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_use_mag">
		<text>Weapon: use mag</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_use_mag_desc">
		<text>0/1 from Weapon Tooltips: magazine cycle = 1; rounds-reload (tube, break-action, revolver) = 0. Always included.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_spread_ads">
		<text>Weapon: Spread ADS</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_spread_ads_desc">
		<text>ADS/base cone (deg). Lower better: 0 deg->1, soft ceiling 1 deg->0.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_spread_hip">
		<text>Weapon: Spread hip</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_spread_hip_desc">
		<text>Hip-run cone (deg). Lower better: 0 deg->1, soft ceiling 10 deg->0.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_scope">
		<text>Weapon: scope</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_scope_desc">
		<text>0/1 from scope_status &gt; 0 (can mount a sight). Always included in the average.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_silencer">
		<text>Weapon: silencer</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_silencer_desc">
		<text>0/1 from silencer_status &gt; 0 (can mount a suppressor). Always included in the average.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_affordable">
		<text>Weapon: affordable</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_w_affordable_desc">
		<text>Gun cost: 1 at 0 ru, 0 at hardcoded max weapon cost (30k).</text>
	</string>
