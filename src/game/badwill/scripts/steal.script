--[[
    Steal a claimed corpse. Claimed = AP _claim_owner (bound once from
    ap_ext_loot_claim upvalues). Keybind opens via corpse:use(actor).
    Watch list collected once, xslice 1 LoS/frame every 1000ms.
]]

local CONFIG = _G.dogma_game_badwill_conf
local xobject = dogma.xlibs.xobject
local xsquad = dogma.xlibs.xsquad
local xcreature = dogma.xlibs.xcreature
local xslice = dogma.xlibs.xslice
local xpda = dogma.xlibs.xpda
local xcombat = dogma.xlibs.xcombat
local xtime = dogma.xlibs.xtime
local xconst = dogma.xlibs.xconst

local CAUGHT_MSG = "st_dogma_badwill_steal_caught"
local WARN_PREFIX = "st_ap_loot_claim_warn"
local WARN_VARIANTS_MAX = 16

local SAVE_KEY = "dogma_badwill_steal"
local QUEUE = "dogma_badwill_steal_los"
local FACTION_M = 100
local XSLICE_GAP_MS = 1000

local owners = {}
local pending_owners = nil
local ap_claim_fn = nil
local session = nil
local marked = {}
local last_xslice_ms = 0
local HUD_STATIC = "dogma_badwill_steal_prompt"
local PROMPT_H = 56
local COL_STEAL = "%c[255,231,168,12]"
local COL_OWNER = "%c[255,175,175,175]"
local SEARCH_AWAY = -9999
local TAKEALL_NAMES = { "takeall_button", "take_all_button", "m_takeall_button", "takeall" }
local prompt_text = nil
local prompt_skip_logged = false
local search_home = nil
local deny_wrapped = false
local orig_deny = {}
local orig_cond_move = nil
local takeall_hidden = false
local hold_fired = false
local last_look = nil
local opening = false
local search_tip_ok = false
local warn_n = 0

local MODE_PRESS = 0
local MODE_HOLD = 1

local MOD_LABEL = {
    [1] = "Shift+",
    [2] = "Ctrl+",
    [3] = "Alt+",
}

local function log(msg)
    if dogma.log.logging() then
        dogma.log.log(CONFIG.MOD_ID, "steal " .. tostring(msg))
    end
end

local function steal_on()
    return dogma.mcm.bool(CONFIG.MOD_ID, "steal_enabled", CONFIG.DEFAULTS.steal_enabled)
end

local function steal_dik()
    return dogma.mcm.key(CONFIG.MOD_ID, "steal_key", CONFIG.DEFAULTS.steal_key)
end

local function steal_mod()
    return dogma.mcm.int(CONFIG.MOD_ID, "steal_key_modifier", CONFIG.DEFAULTS.steal_key_modifier)
end

local function steal_mode()
    local mode = dogma.mcm.int(CONFIG.MOD_ID, "steal_key_mode", CONFIG.DEFAULTS.steal_key_mode)
    if mode == MODE_HOLD then
        return MODE_HOLD
    end
    return MODE_PRESS
end

local function steal_hold_ms()
    local ms = dogma.mcm.int(CONFIG.MOD_ID, "steal_hold_ms", CONFIG.DEFAULTS.steal_hold_ms)
    if not ms or ms < 500 then
        return 500
    end
    if ms > 2000 then
        return 2000
    end
    return ms
end

local function steal_fired()
    local dik = steal_dik()
    if not (dik and dogma.input.is_mod_down(steal_mod())) then
        hold_fired = false
        return false
    end
    if not dogma.input.is_key_down(dik) then
        hold_fired = false
        return false
    end
    if hold_fired then
        return false
    end
    local hit
    if steal_mode() == MODE_HOLD then
        hit = dogma.input.is_key_held(dik, steal_hold_ms())
    else
        hit = dogma.input.is_key_pressed(dik)
    end
    if hit then
        hold_fired = true
        return true
    end
    return false
end

local function steal_timer_ms()
    local sec = dogma.mcm.int(CONFIG.MOD_ID, "steal_timer", CONFIG.DEFAULTS.steal_timer)
    if not sec or sec < 5 then
        sec = 5
    end
    return sec * 1000
end

local function nearby_faction()
    return dogma.mcm.bool(CONFIG.MOD_ID, "steal_nearby_faction", CONFIG.DEFAULTS.steal_nearby_faction)
end

local function is_dead_loot(obj)
    if not obj then
        return false
    end
    if not ((IsStalker and IsStalker(obj)) or (IsMonster and IsMonster(obj))) then
        return false
    end
    local ok, alive = pcall(obj.alive, obj)
    if ok and alive and alive ~= 0 then
        return false
    end
    return true
end

local try_parent = function(obj)
    return obj.parent and obj:parent()
end

-- looking_at often hits a weapon on the body, not the corpse.
local function corpse_from_look(obj)
    if is_dead_loot(obj) then
        return obj
    end
    if not obj then
        return nil
    end
    local ok, parent = pcall(try_parent, obj)
    if ok and is_dead_loot(parent) then
        return parent
    end
    return nil
end

local function look_corpse()
    local actor = db.actor
    if not (actor and actor.get_actor_object_looking_at) then
        return nil
    end
    local ok, obj = pcall(actor.get_actor_object_looking_at, actor)
    return ok and corpse_from_look(obj) or nil
end

-- last_mode, not ActorMenu:IsShown(). Loot is last_mode=4 with IsShown false,
-- so is_inv_open() stayed false, opening stuck, takes stayed AP-blocked.
local function menu_up()
    if dogma.status.is_talking() then
        return true
    end
    return actor_menu and actor_menu.last_mode and actor_menu.last_mode ~= 0
end

local function actor_id()
    return db.actor and db.actor:id() or nil
end

local function find_upvalue(fn, name)
    if not (type(fn) == "function" and debug and debug.getupvalue) then
        return nil
    end
    local i = 1
    while true do
        local n, v = debug.getupvalue(fn, i)
        if not n then
            return nil
        end
        if n == name then
            return v
        end
        i = i + 1
    end
end

-- AP never exports _claim_owner. on_game_start closes over the keypress
-- veto; that closes over _claim_owner. One bind, then that is the gate.
local function bind_ap_claim()
    if ap_claim_fn then
        return ap_claim_fn
    end
    local mod = rawget(_G, "ap_ext_loot_claim")
    local start = mod and mod.on_game_start
    local keypress = find_upvalue(start, "_on_before_key_press")
    local fn = find_upvalue(keypress, "_claim_owner")
    if type(fn) ~= "function" then
        local move = find_upvalue(start, "_on_item_before_move")
        fn = find_upvalue(move, "_claim_owner")
    end
    if type(fn) ~= "function" then
        log("ap claim bind fail")
        return nil
    end
    ap_claim_fn = fn
    log("ap claim bind ok")
    return fn
end

local function claim_owner(corpse)
    if not corpse then
        return nil, "no_corpse"
    end
    local fn = bind_ap_claim()
    if not fn then
        return nil, "no_ap"
    end
    local owner = fn(corpse)
    if not owner then
        return nil, "void"
    end
    return owner, nil
end

local function loot_blocked(obj)
    local npc = claim_owner(obj)
    return npc ~= nil
end

local function loot_gui()
    return ui_inventory and ui_inventory.GUI or nil
end

local try_loot_partner = function(gui)
    return gui:GetPartner()
end

local function partner_id(gui)
    if not (gui and gui.GetPartner) then
        return nil
    end
    local ok, partner = pcall(try_loot_partner, gui)
    if not (ok and partner) then
        return nil
    end
    return partner:id()
end

-- last_mode=4 is loot. Do not require GetPartner: luabind partners have
-- :id() but partner.id is often nil, which kept loot_open_on false and
-- left the AP claim veto on.
local function loot_open_on(corpse_id)
    if not (corpse_id and session and session.corpse_id == corpse_id) then
        return false
    end
    local gui = loot_gui()
    if gui and gui.mode == "loot" then
        local pid = partner_id(gui)
        if pid then
            return pid == corpse_id
        end
        return true
    end
    return actor_menu and actor_menu.last_mode == 4
end

local function takeall_btn()
    local type_ = type
    local gui = loot_gui()
    if not gui then
        return nil
    end
    for i = 1, #TAKEALL_NAMES do
        local btn = gui[TAKEALL_NAMES[i]]
        if type_(btn) == "userdata" and btn.Show then
            return btn
        end
    end
    if type_(gui) ~= "table" then
        return nil
    end
    for k, v in pairs(gui) do
        if type_(k) == "string" and type_(v) == "userdata" and v.Show then
            if k:lower():find("takeall", 1, true) or k:lower():find("take_all", 1, true) then
                return v
            end
        end
    end
    return nil
end

local function set_takeall_shown(show)
    local btn = takeall_btn()
    if not btn then
        return
    end
    local ok = pcall(btn.Show, btn, show)
    if ok then
        takeall_hidden = not show
    end
end

local function session_allows_take()
    return session and session.corpse_id and loot_open_on(session.corpse_id)
end

local function wrap_deny_move()
    if deny_wrapped then
        return
    end
    local function wrap(tbl)
        if not (tbl and tbl.deny_move) then
            return
        end
        if orig_deny[tbl] then
            return
        end
        local prev = tbl.deny_move
        orig_deny[tbl] = prev
        tbl.deny_move = function(flags)
            if session_allows_take() then
                log("deny skip")
                return
            end
            return prev(flags)
        end
    end
    wrap(rawget(_G, "xinventory"))
    wrap(dogma.xlibs and dogma.xlibs.xinventory)
    deny_wrapped = true
end

-- AP may set flags.ret_value=false after our before_move. Cond_Move is
-- the funnel; override after orig so steal-session takes from npc_bag.
local function cond_move_wrap(self, obj, bag)
    local ok = orig_cond_move and orig_cond_move(self, obj, bag)
    if ok then
        return true
    end
    if not (session and session.corpse_id and bag == "npc_bag") then
        return ok
    end
    if self and self.mode and self.mode ~= "loot" then
        return ok
    end
    log("cond allow corpse=" .. tostring(session.corpse_id))
    return true
end

local function wrap_cond_move()
    if orig_cond_move then
        return
    end
    local cls = ui_inventory and ui_inventory.UIInventory
    if not (cls and cls.Cond_Move) then
        return
    end
    orig_cond_move = cls.Cond_Move
    cls.Cond_Move = cond_move_wrap
    log("cond wrap ok")
end

local function on_gui_on_show(name)
    if name == "UIInventory" then
        wrap_cond_move()
    end
end

local function key_label(dik)
    if not dik then
        return nil
    end
    if dik_to_keyname then
        local ok, name = pcall(dik_to_keyname, dik, true)
        if not (ok and type(name) == "string" and name ~= "") then
            ok, name = pcall(dik_to_keyname, dik, false)
        end
        if ok and type(name) == "string" and name ~= "" then
            name = name:gsub("^DIK_", ""):gsub("^k", "")
            if name ~= "" then
                return name
            end
        end
    end
    return tostring(dik)
end

local function prompt_y()
    local y = dogma.mcm.int(CONFIG.MOD_ID, "steal_prompt_y", CONFIG.DEFAULTS.steal_prompt_y)
    if not y then
        return CONFIG.DEFAULTS.steal_prompt_y
    end
    if y < 500 then
        return 500
    end
    if y > 750 then
        return 750
    end
    return y
end

local function owner_line(obj)
    local v = obj and owners[obj:id()]
    if not (v and v.killer) then
        return nil
    end
    local name = xcreature.get_name(v.killer)
    if not name or name == "" then
        return nil
    end
    local comm = xcreature.community(v.killer)
    local fact = comm and game.translate_string(comm) or comm
    if not fact or fact == "" then
        return "Killed by: " .. name
    end
    local fmt = game.translate_string("st_dogma_badwill_steal_killed_by")
    if not fmt or fmt == "st_dogma_badwill_steal_killed_by" then
        fmt = "Killed by: %s (%s)"
    end
    return string.format(fmt, name, fact)
end

local function steal_prompt(obj)
    local dik = steal_dik()
    local label = key_label(dik)
    if not label then
        return nil
    end
    local fmt = game.translate_string("st_dogma_badwill_steal_loot")
    if not fmt or fmt == "st_dogma_badwill_steal_loot" then
        fmt = "Steal loot (%s)"
    end
    local prefix = MOD_LABEL[steal_mod()] or ""
    local line1 = string.format(fmt, prefix .. label)
    local line2 = owner_line(obj)
    if line2 then
        return COL_STEAL .. line1 .. "\\n" .. COL_OWNER .. line2
    end
    return COL_STEAL .. line1
end

local function hud_raw()
    if not (db.actor and get_hud) then
        return nil
    end
    local ok, hud = pcall(get_hud)
    if ok and hud then
        return hud
    end
    return nil
end

local function world_hud()
    if opening or menu_up() then
        return nil
    end
    return hud_raw()
end

local try_search_wnd = function(ActorMenu)
    local mgui = ActorMenu.get_maingame()
    return mgui and (mgui.UIStaticQuickHelp or mgui.quick_info)
end

local function search_wnd()
    if not (world_hud() and ActorMenu and ActorMenu.get_maingame) then
        return nil
    end
    local ok, wnd = pcall(try_search_wnd, ActorMenu)
    if ok and wnd and wnd.SetWndPos then
        return wnd
    end
    return nil
end

local try_park_search = function(SEARCH_AWAY, search_home, vector2, wnd)
    if not search_home then
        local pos = wnd:GetWndPos()
        if pos and pos.x and pos.x > -1000 then
            search_home = { x = pos.x, y = pos.y }
        end
    end
    if search_home then
        wnd:SetWndPos(vector2():set(SEARCH_AWAY, search_home.y))
    end
    return search_home
end

local function park_search()
    local wnd = search_wnd()
    if not wnd then
        return
    end
    local ok, home = pcall(try_park_search, SEARCH_AWAY, search_home, vector2, wnd)
    if ok and home then
        search_home = home
    end
end

local try_unpark_search = function(search_home, vector2, wnd)
    wnd:SetWndPos(vector2():set(search_home.x, search_home.y))
end

local function unpark_search()
    if not search_home then
        return
    end
    local wnd = search_wnd()
    if wnd then
        pcall(try_unpark_search, search_home, vector2, wnd)
        search_home = nil
    end
end

local try_get_cs = function(hud, name)
    return hud:GetCustomStatic(name)
end

local try_add_cs = function(hud, name)
    hud:AddCustomStatic(name, true)
    return hud:GetCustomStatic(name)
end

local try_cs_wnd = function(cs)
    return cs:wnd()
end

local try_hide_prompt = function(HUD_STATIC, hud)
    local cs = hud:GetCustomStatic(HUD_STATIC)
    local wnd = cs and cs.wnd and cs:wnd()
    if wnd and wnd.Show then
        wnd:Show(false)
    end
end

local function hide_prompt()
    if not prompt_text then
        unpark_search()
        return
    end
    prompt_text = nil
    local hud = hud_raw()
    if hud and hud.GetCustomStatic then
        pcall(try_hide_prompt, HUD_STATIC, hud)
    end
    unpark_search()
    log("prompt hide")
end

local function prompt_wnd()
    local hud = world_hud()
    if not hud then
        return nil
    end
    local ok, cs = pcall(try_get_cs, hud, HUD_STATIC)
    if not (ok and cs) then
        ok, cs = pcall(try_add_cs, hud, HUD_STATIC)
        if not (ok and cs) then
            if not prompt_skip_logged then
                prompt_skip_logged = true
                log("prompt skip add static fail")
            end
            return nil
        end
    end
    _G.dogma_badwill_steal_xml = true
    local wok, wnd = pcall(try_cs_wnd, cs)
    if wok then
        return wnd
    end
    return nil
end

local try_show_prompt = function(PROMPT_H, text, vector2, wnd, y)
    wnd:SetWndPos(vector2():set(0, y))
    if wnd.SetWndSize then
        wnd:SetWndSize(vector2():set(1024, PROMPT_H))
    end
    if wnd.SetTextComplexMode then
        wnd:SetTextComplexMode(true)
    end
    local tc = wnd.TextControl and wnd:TextControl()
    if tc then
        if tc.SetTextComplexMode then
            tc:SetTextComplexMode(true)
        end
        if tc.SetText then
            tc:SetText(text)
        end
    elseif wnd.SetText then
        wnd:SetText(text)
    end
    if wnd.Show then
        wnd:Show(true)
    end
end

local function show_prompt(text)
    local wnd = prompt_wnd()
    if not wnd then
        return
    end
    local fresh = prompt_text ~= text
    pcall(try_show_prompt, PROMPT_H, text, vector2, wnd, prompt_y())
    park_search()
    if fresh then
        log("prompt show " .. text)
        prompt_text = text
    end
end

local function update_prompt(obj)
    if opening or menu_up() then
        hide_prompt()
        return
    end
    if not (steal_on() and steal_dik() and obj and loot_blocked(obj)) then
        hide_prompt()
        return
    end
    local text = steal_prompt(obj)
    if not text then
        hide_prompt()
        return
    end
    show_prompt(text)
end

local function collect_watch(claimer)
    local watch = {}
    local hunt = {}
    local seen = {}
    local function add(npc, is_hunt)
        if not npc or CONFIG.is_excluded(npc) then
            return
        end
        local id = npc:id()
        if seen[id] then
            return
        end
        seen[id] = true
        watch[#watch + 1] = id
        if is_hunt then
            hunt[#hunt + 1] = id
        end
    end
    add(claimer, true)
    local squad = get_object_squad and get_object_squad(claimer)
    if squad then
        for id in xsquad.iter_member_ids(squad) do
            add(xobject.go(id), true)
        end
    end
    if nearby_faction() then
        local actor = db.actor
        local comm = dogma.alife.community(claimer)
        if actor and comm then
            local near = dogma.alife.get_stalkers_near_point(actor:position(), FACTION_M, comm)
            for i = 1, #near do
                add(near[i], false)
            end
        end
    end
    return watch, hunt
end

local try_send_hunt = function(anim, game_object, move, npc)
    if game_object and game_object.level_path then
        npc:set_path_type(game_object.level_path)
    end
    if anim and anim.danger then
        npc:set_mental_state(anim.danger)
    end
    if move and move.run then
        npc:set_movement_type(move.run)
    end
    if move and move.standing then
        npc:set_body_state(move.standing)
    end
end

local function send_hunt(vid)
    if not (session and session.hunt and vid) then
        return
    end
    for i = 1, #session.hunt do
        local npc = xobject.go(session.hunt[i])
        if npc and npc:alive() then
            xcombat.send_to(npc, vid)
            pcall(try_send_hunt, anim, game_object, move, npc)
        end
    end
end

local function count_warn_pool()
    local n = 0
    for i = 1, WARN_VARIANTS_MAX do
        local key = string.format("%s_%03d", WARN_PREFIX, i)
        local text = game.translate_string(key)
        if not text or text == "" or text == key then
            break
        end
        n = i
    end
    return n
end

local function ap_warn_line()
    if warn_n < 1 then
        warn_n = count_warn_pool()
    end
    if warn_n < 1 then
        return game.translate_string(CAUGHT_MSG)
    end
    local key = string.format("%s_%03d", WARN_PREFIX, math.random(1, warn_n))
    local text = game.translate_string(key)
    local name = db.actor and db.actor:character_name()
    if name and text and text:find("#name#", 1, true) then
        text = text:gsub("#name#", function()
            return name
        end)
    end
    return text
end

local function corpse_loot_open()
    local gui = loot_gui()
    if not (gui and gui.mode == "loot") then
        return false
    end
    local partner = gui.GetPartner and gui:GetPartner()
    return is_dead_loot(partner)
end

local function is_caught_msg(msg)
    if type(msg) ~= "string" then
        return false
    end
    if msg == CAUGHT_MSG then
        return true
    end
    local caught = game.translate_string(CAUGHT_MSG)
    return caught ~= nil and msg == caught
end

local function suppress_claim_tip(msg)
    if search_tip_ok or is_caught_msg(msg) then
        return false
    end
    return corpse_loot_open()
end

local function wrap_tip_fn(mod, field)
    if not (mod and type(mod[field]) == "function") then
        return
    end
    if mod.__dogma_steal_tip then
        return
    end
    local prev = mod[field]
    mod[field] = function(a, b, c, d, e, f, g)
        local msg = (field == "npc_tip") and b or a
        if suppress_claim_tip(msg) then
            log("suppress take tip")
            return true
        end
        return prev(a, b, c, d, e, f, g)
    end
    mod.__dogma_steal_tip = true
end

local function wrap_claim_tips()
    wrap_tip_fn(rawget(_G, "xpda"), "npc_tip")
    wrap_tip_fn(xpda, "npc_tip")
    wrap_tip_fn(rawget(_G, "dynamic_news_helper"), "send_tip")
end

local function first_watcher_seeing()
    local actor = db.actor
    if not (actor and session and session.watch) then
        return nil
    end
    for i = 1, #session.watch do
        local npc = xobject.go(session.watch[i])
        if npc and npc:alive() and dogma.alife.npc_has_los_to_stalker(npc, actor, true) then
            return npc
        end
    end
    return nil
end

local function warn_on_search()
    local spotter = first_watcher_seeing()
    if not spotter then
        log("search tip skip no los")
        return
    end
    search_tip_ok = true
    local ok = xpda.npc_tip(spotter, ap_warn_line(), { sound = "beep_1" })
    search_tip_ok = false
    log("search tip los id=" .. tostring(spotter:id()) .. " ok=" .. tostring(ok))
end

local function notify_caught(spotter, vid)
    if spotter then
        local ok = xpda.npc_tip(spotter, CAUGHT_MSG, { sound = "danger" })
        if not ok then
            xpda.send(spotter:character_name(), game.translate_string(CAUGHT_MSG), spotter:character_icon())
        end
    end
    send_hunt(vid)
end

local function cancel_xslice()
    if xslice.is_active(QUEUE) then
        xslice.cancel(QUEUE, true)
    end
end

local function clear_session()
    cancel_xslice()
    if takeall_hidden then
        set_takeall_shown(true)
    end
    session = nil
    marked = {}
    log("session clear")
end

local function end_watch(reason)
    if not session then
        return
    end
    session.watching = false
    cancel_xslice()
    log("watch end " .. tostring(reason))
    if not loot_open_on(session.corpse_id) then
        clear_session()
    end
end

local function on_xslice_done()
    if not (session and session.watching) then
        return
    end
    if #marked > 0 then
        local actor = db.actor
        local vid = actor and actor:level_vertex_id()
        log("slam " .. tostring(#marked))
        notify_caught(marked[1], vid)
        CONFIG.slam_npcs(marked)
        end_watch("slam")
        return
    end
    log("pass none")
end

local function start_xslice()
    if not (session and session.watching and session.watch and #session.watch > 0) then
        return
    end
    if xslice.is_active(QUEUE) then
        return
    end
    marked = {}
    local actor = db.actor
    if not actor then
        return
    end
    xslice.start(QUEUE, session.watch, {
        step = 1,
        func = function(id)
            local npc = xobject.go(id)
            if npc and npc:alive() and dogma.alife.npc_has_los_to_stalker(npc, actor, true) then
                marked[#marked + 1] = npc
            end
            return true
        end,
        on_done = on_xslice_done,
    })
    last_xslice_ms = time_global()
    log("xslice n=" .. tostring(#session.watch))
end

local function begin_session(corpse, claimer)
    cancel_xslice()
    local watch, hunt = collect_watch(claimer)
    session = {
        corpse_id = corpse:id(),
        deadline = time_global() + steal_timer_ms(),
        watch = watch,
        hunt = hunt,
        watching = true,
    }
    takeall_hidden = false
    start_xslice()
    log("session corpse=" .. tostring(session.corpse_id) .. " watch=" .. tostring(#session.watch))
end

local function log_cfg()
    local tostr = tostring
    log(string.format(
        "cfg on=%s key=%s mod=%s mode=%s hold=%s",
        tostr(steal_on()),
        tostr(steal_dik()),
        tostr(steal_mod()),
        tostr(steal_mode()),
        tostr(steal_hold_ms())
    ))
end

local function log_look(obj)
    local tostr = tostring
    local id = obj and obj:id() or 0
    local v = obj and owners[id]
    local claimer, why = claim_owner(obj)
    local last_mode = actor_menu and actor_menu.last_mode or 0
    local sig = string.format(
        "%s:%s:%s:%s:%s:%s:%s:%s",
        tostr(id),
        tostr(claimer and claimer:id() or 0),
        tostr(why),
        tostr(steal_dik()),
        tostr(steal_mode()),
        tostr(steal_mod()),
        tostr(last_mode),
        tostr(opening)
    )
    if sig == last_look then
        return
    end
    last_look = sig
    if not obj then
        log("look none")
        return
    end
    log(string.format(
        "look id=%s sec=%s have=%s claimer=%s why=%s key=%s last_mode=%s xml=%s opening=%s talking=%s",
        tostr(id),
        tostr(obj:section()),
        tostr(v ~= nil),
        tostr(claimer and claimer:id() or nil),
        tostr(why),
        tostr(steal_dik()),
        tostr(last_mode),
        tostr(_G.dogma_badwill_steal_xml),
        tostr(opening),
        tostr(dogma.status.is_talking())
    ))
end

local function try_open()
    local tostr = tostring
    if not steal_on() then
        return
    end
    if menu_up() then
        return
    end
    if not steal_fired() then
        return
    end
    local corpse = look_corpse()
    if not corpse then
        log("fire no corpse")
        return
    end
    local corpse_id = corpse:id()
    local claimer, why = claim_owner(corpse)
    if not claimer then
        log("fire no claimer id=" .. tostr(corpse_id) .. " have=" .. tostr(owners[corpse_id] ~= nil) .. " why=" .. tostr(why))
        return
    end
    local actor = db.actor
    if not (actor and corpse.use) then
        log("fire no use id=" .. tostr(corpse_id))
        return
    end
    log("fire id=" .. tostr(corpse_id) .. " claimer=" .. tostr(claimer:id()))
    hide_prompt()
    wrap_deny_move()
    opening = true
    local ok, ret = pcall(corpse.use, corpse, actor)
    if not ok then
        opening = false
        log("use failed")
        return
    end
    if ret == false then
        opening = false
        log("use blocked")
        return
    end
    begin_session(corpse, claimer)
    warn_on_search()
end

local function void_own_kill(victim_id, why)
    if not victim_id then
        return
    end
    if owners[victim_id] then
        log("claim void " .. tostring(why) .. " v=" .. tostring(victim_id))
    end
    owners[victim_id] = nil
end

local function record_death(victim, killer)
    local tostr = tostring
    if not (victim and killer) then
        return
    end
    local actor = db.actor
    if not actor then
        return
    end
    local victim_id, killer_id = victim:id(), killer:id()
    if victim_id == killer_id then
        log("claim skip suicide v=" .. tostr(victim_id))
        return
    end
    if killer_id == actor:id() then
        void_own_kill(victim_id, "actor_death")
        return
    end
    if CONFIG.is_player_side(killer) or CONFIG.is_player_side(victim) then
        log("claim skip player-side v=" .. tostr(victim_id) .. " k=" .. tostr(killer_id))
        return
    end
    if CONFIG.is_story(victim) then
        log("claim skip story v=" .. tostr(victim_id))
        return
    end
    if not xcreature.is_stalker(killer) then
        log("claim skip killer not stalker v=" .. tostr(victim_id) .. " k=" .. tostr(killer_id))
        return
    end
    local comm = dogma.alife.community(killer)
    if comm and CONFIG.SKIP_COMM[comm] then
        log("claim skip comm=" .. tostr(comm) .. " v=" .. tostr(victim_id))
        return
    end
    local squad = get_object_squad and get_object_squad(killer)
    local squad_id = squad and squad.id or nil
    if squad_id and axr_companions and axr_companions.companion_squads and axr_companions.companion_squads[squad_id] then
        log("claim skip companion squad v=" .. tostr(victim_id))
        return
    end
    local t = xtime and xtime.game_sec and xtime.game_sec() or nil
    owners[victim_id] = { killer = killer_id, squad = squad_id, t = t }
    log("claim v=" .. tostr(victim_id) .. " k=" .. tostr(killer_id) .. " squad=" .. tostr(squad_id))
end

-- AP records actor kills here (npc_on_death never fires with actor as killer).
-- Same signal: drop our row so we cannot keep a prior NPC hit as the claimer.
local function on_death_hit(obj, _amount, _dir, who, bone_index)
    if bone_index ~= "from_death_callback" then
        return
    end
    if not (obj and who) then
        return
    end
    local aid = actor_id()
    if not aid or who:id() ~= aid then
        return
    end
    void_own_kill(obj:id(), "actor_hit")
end

local function refresh_deadline()
    if not (session and session.watching) then
        return
    end
    if loot_open_on(session.corpse_id) then
        session.deadline = time_global() + steal_timer_ms()
        set_takeall_shown(false)
    end
end

local function tick_watch()
    local tostr = tostring
    if not session then
        opening = false
        return
    end
    if opening and menu_up() then
        opening = false
        local gui = loot_gui()
        log(string.format(
            "opening cleared mode=%s last=%s partner=%s loot_open=%s gui=%s",
            tostr(gui and gui.mode),
            tostr(actor_menu and actor_menu.last_mode),
            tostr(partner_id(gui)),
            tostr(loot_open_on(session.corpse_id)),
            tostr(type(gui))
        ))
    end
    refresh_deadline()
    if session.watching then
        if time_global() > session.deadline and not loot_open_on(session.corpse_id) then
            end_watch("timeout")
            return
        end
        if time_global() - last_xslice_ms >= XSLICE_GAP_MS then
            start_xslice()
        end
    elseif not loot_open_on(session.corpse_id) then
        clear_session()
    else
        set_takeall_shown(false)
    end
end

local function tick()
    if not db.actor then
        return
    end
    local corpse = look_corpse()
    log_look(corpse)
    try_open()
    update_prompt(corpse)
    tick_watch()
end

local function ingest_owner(id, v, src)
    local tostr = tostring
    local kid = v and tonumber(v.killer)
    if not (id and kid) then
        return false
    end
    local aid = actor_id()
    if not aid then
        aid = xconst and xconst.ACTOR_ENTITY_ID or 0
    end
    if kid == aid then
        void_own_kill(id, "ingest_" .. tostr(src))
        return false
    end
    if owners[id] then
        return false
    end
    owners[id] = {
        killer = kid,
        squad = v.squad and tonumber(v.squad) or nil,
        t = v.t and tonumber(v.t) or nil,
    }
    return true
end

local function reset()
    hold_fired = false
    last_look = nil
    opening = false
    prompt_text = nil
    prompt_skip_logged = false
    search_home = nil
    takeall_hidden = false
    session = nil
    marked = {}
    if xslice.is_active(QUEUE) then
        pcall(xslice.cancel, QUEUE, true)
    end
    log_cfg()
end

local function on_save_state(m_data)
    m_data[SAVE_KEY] = { owner = owners }
end

local function ingest_table(tbl, src)
    if type(tbl) ~= "table" then
        return
    end
    for k, v in pairs(tbl) do
        if type(v) == "table" then
            ingest_owner(tonumber(k), v, src)
        end
    end
end

local function apply_pending()
    if not pending_owners then
        return
    end
    local p = pending_owners
    pending_owners = nil
    owners = {}
    ingest_table(p.save, "save")
    ingest_table(p.ap, "ap")
    local n = 0
    for _ in pairs(owners) do
        n = n + 1
    end
    log("load n=" .. tostring(n))
end

local function on_load_state(m_data)
    -- Stash only. Ingest needs actor id (own_kill void). Same reason AP
    -- defers _owner:import to first_update.
    owners = {}
    local saved = m_data and m_data[SAVE_KEY]
    local ap = m_data and m_data.ap_ext_loot_claim
    pending_owners = {
        save = type(saved) == "table" and saved.owner or nil,
        ap = type(ap) == "table" and ap.owner or nil,
    }
end

local function on_item_before_move(flags, npc_id)
    if not (session and session.corpse_id and flags) then
        return
    end
    if npc_id == session.corpse_id then
        flags.ret_value = true
        log("before_move allow npc=" .. tostring(npc_id))
    end
end

local on_actor_on_first_update = function()
    apply_pending()
    bind_ap_claim()
    wrap_deny_move()
    wrap_cond_move()
    wrap_claim_tips()
end

function on_game_start()
    dogma.load(CONFIG.MOD_ID)
    RegisterScriptCallback("npc_on_death_callback", record_death)
    RegisterScriptCallback("monster_on_death_callback", record_death)
    RegisterScriptCallback("npc_on_hit_callback", on_death_hit)
    RegisterScriptCallback("monster_on_hit_callback", on_death_hit)
    RegisterScriptCallback("actor_on_first_update", on_actor_on_first_update)
    RegisterScriptCallback("actor_on_update", tick)
    RegisterScriptCallback("ActorMenu_on_item_before_move", on_item_before_move)
    RegisterScriptCallback("GUI_on_show", on_gui_on_show)
    RegisterScriptCallback("save_state", on_save_state)
    RegisterScriptCallback("load_state", on_load_state)
    RegisterScriptCallback("on_game_load", reset)
    RegisterScriptCallback("main_menu_on_init", reset)
    RegisterScriptCallback("actor_on_net_destroy", reset)
    log_cfg()
    log("loaded")
end
