-- Controls label renames (stock weapon slots). Patches ui_st_keybinding.

local LABELS = {
	kb_weapon1 = "Weapon 1 (Melee)",
	kb_weapon2 = "Weapon 2 (Secondary)",
	kb_weapon3 = "Weapon 3 (Primary)",
}

local function set_string_text(xml_obj, id, text)
	local nodes = xml_obj:query(string.format("string[id=%s] > text", id))
	if nodes[1] then
		xml_obj:setText(nodes[1], text)
		return true
	end
	return false
end

function on_xml_read()
	RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)
		if xml_file_name ~= [[text\eng\ui_st_keybinding.xml]]
			and xml_file_name ~= [[text\rus\ui_st_keybinding.xml]]
		then
			return
		end
		for id, text in pairs(LABELS) do
			set_string_text(xml_obj, id, text)
		end
	end)
end
