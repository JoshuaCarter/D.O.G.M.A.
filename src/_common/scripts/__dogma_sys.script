--[[
	DOGMA runtime - gate feature logic until deps and config are ready.

	Wired by dogma.load (dogma.script). Features use dogma.sys.
]]

local _mcm = nil
local _dbg = nil
local loaded_configs = {}

function set_deps(mcm, dbg)
	_mcm = mcm
	_dbg = dbg
end

function ready(mod_id, db, load_fn)
	if not (_mcm and _dbg and db and db.actor) then
		return nil
	end
	if load_fn and not loaded_configs[mod_id] then
		load_fn()
		loaded_configs[mod_id] = true
	end
	return db.actor
end

function reset_mod(mod_id)
	if mod_id then
		loaded_configs[mod_id] = nil
	end
end

-- True only on saves started with the D.O.G.M.A. button (alife .scoc).
function is_dogma_run()
	if not (alife_storage_manager and alife_storage_manager.get_state) then
		return false
	end
	local ok, m_data = pcall(alife_storage_manager.get_state)
	return ok and m_data and m_data.dogma_mode == true
end

