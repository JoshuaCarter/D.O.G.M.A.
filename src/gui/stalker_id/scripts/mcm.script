		aim_radius_px = defaults["aim_radius_px"],
		require_visible = defaults["require_visible"],
		bush_pierce = defaults["bush_pierce"],
		hide_on_death = defaults["hide_on_death"],
		always_show_line = defaults["always_show_line"],
		always_show_line_binoc = defaults["always_show_line_binoc"],
		hide_line_on_pda = defaults["hide_line_on_pda"],
		line_keybind = defaults["line_keybind"],
