--[[
	Quick Action Wheel — MCM

	Injects "Hide HUD" into haru_quick_action_wheel_mcm → Controls (base,
	G.A.M.M.A. Balance, and Overhaul all share that module id). Also keeps a
	short info page under D.O.G.M.A. → HUD pointing at that control.
]]

local CONFIG = _G.dogma_hud_quick_action_wheel_conf

local HIDE_HUD_OPT = {
	id = "hide_hud",
	type = "check",
	val = 1,
	def = CONFIG.DEFAULTS["hide_hud"],
	hint = "dogma_qaw_hide_hud",
}

local function find_gr_child(gr, id)
	if not gr then
		return nil
	end
	for i = 1, #gr do
		if gr[i].id == id then
			return gr[i], i
		end
	end
	return nil
end

local function inject_hide_hud(tree)
	if not tree or type(tree.gr) ~= "table" then
		return
	end
	local controls = find_gr_child(tree.gr, "controls")
	if not (controls and type(controls.gr) == "table") then
		return
	end
	if find_gr_child(controls.gr, "hide_hud") then
		return
	end

	-- Place after stock "hold" when present; otherwise append.
	local _, hold_i = find_gr_child(controls.gr, "hold")
	local at = hold_i and (hold_i + 1) or (#controls.gr + 1)
	table.insert(controls.gr, at, { id = "divider_dogma_hide_hud", type = "line" })
	table.insert(controls.gr, at + 1, HIDE_HUD_OPT)
end

local function inject_into_options(options)
	if not options then
		return
	end
	for i = 1, #options do
		if options[i].id == "haru_quick_action_wheel_mcm" then
			inject_hide_hud(options[i])
		end
	end
end

-- If we gather before QAW, wrap so injection still happens when they return.
local function wrap_qaw_on_mcm_load()
	local qaw = rawget(_G, "haru_quick_action_wheel_mcm")
	if not (qaw and type(qaw.on_mcm_load) == "function") then
		return
	end
	if qaw._dogma_hide_hud_mcm then
		return
	end
	local orig = qaw.on_mcm_load
	qaw.on_mcm_load = function(...)
		local tree, name = orig(...)
		if tree then
			inject_hide_hud(tree)
		end
		return tree, name
	end
	qaw._dogma_hide_hud_mcm = true
end

-- Top-level: all *mcm.script modules exist before any on_mcm_load runs.
wrap_qaw_on_mcm_load()

function on_mcm_load(options)
	wrap_qaw_on_mcm_load()
	inject_into_options(options)

	dogma_mcm.attach(options, "hud", "ui_mcm_menu_dogma_hud", {
		id = "quick_action_wheel",
		sh = true,
		text = "ui_mcm_menu_dogma_hud_quick_action_wheel",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_hud_quick_action_wheel_page_description",
			},
		}),
	})
end
