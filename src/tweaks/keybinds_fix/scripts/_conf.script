-- tweaks/keybinds_fix conf
--
-- Options→Controls: Escape unbinds (MCM-style), Exit stays on Escape.
-- Persistence: this feature ships a minimal configs/default_controls.ltx
-- (Exit only). Boot + cfg_save always run `default_controls` first; an empty
-- default list is what stops unbound keys from coming back. Stamping unbind
-- into user.ltx fails because destroyConsole cfg_save's on exit.

_G.dogma_tweaks_keybinds_fix_conf = {
	MOD_ID = "dogma/tweaks/keybinds_fix",
	-- Console action → key_bindings field → EGameActions id fallback.
	ACTIONS = {
		{ "left", "kLEFT", 0 },
		{ "right", "kRIGHT", 1 },
		{ "up", "kUP", 2 },
		{ "down", "kDOWN", 3 },
		{ "jump", "kJUMP", 4 },
		{ "crouch", "kCROUCH", 5 },
		{ "accel", "kACCEL", 6 },
		{ "sprint_toggle", "kSPRINT_TOGGLE", 7 },
		{ "forward", "kFWD", 8 },
		{ "back", "kBACK", 9 },
		{ "lstrafe", "kL_STRAFE", 10 },
		{ "rstrafe", "kR_STRAFE", 11 },
		{ "llookout", "kL_LOOKOUT", 12 },
		{ "rlookout", "kR_LOOKOUT", 13 },
		{ "cam_1", "kCAM_1", 14 },
		{ "cam_2", "kCAM_2", 15 },
		{ "cam_3", "kCAM_3", 16 },
		{ "cam_zoom_in", "kCAM_ZOOM_IN", 17 },
		{ "cam_zoom_out", "kCAM_ZOOM_OUT", 18 },
		{ "torch", "kTORCH", 19 },
		{ "night_vision", "kNIGHT_VISION", 20 },
		{ "show_detector", "kDETECTOR", 21 },
		{ "wpn_1", "kWPN_1", 22 },
		{ "wpn_2", "kWPN_2", 23 },
		{ "wpn_3", "kWPN_3", 24 },
		{ "wpn_4", "kWPN_4", 25 },
		{ "wpn_5", "kWPN_5", 26 },
		{ "wpn_6", "kWPN_6", 27 },
		{ "wpn_next", "kWPN_NEXT", 29 },
		{ "wpn_fire", "kWPN_FIRE", 30 },
		{ "wpn_zoom", "kWPN_ZOOM", 31 },
		{ "wpn_reload", "kWPN_RELOAD", 34 },
		{ "wpn_func", "kWPN_FUNC", 35 },
		{ "wpn_firemode_prev", "kWPN_FIREMODE_PREV", 36 },
		{ "wpn_firemode_next", "kWPN_FIREMODE_NEXT", 37 },
		{ "pause", "kPAUSE", 38 },
		{ "drop", "kDROP", 39 },
		{ "use", "kUSE", 40 },
		{ "scores", "kSCORES", 41 },
		{ "screenshot", "kSCREENSHOT", 44 },
		{ "quit", "kQUIT", 45 },
		{ "console", "kCONSOLE", 46 },
		{ "inventory", "kINVENTORY", 47 },
		{ "active_jobs", "kACTIVE_JOBS", 51 },
		{ "next_slot", "kNEXT_SLOT", 57 },
		{ "prev_slot", "kPREV_SLOT", 58 },
		{ "quick_use_1", "kQUICK_USE_1", 61 },
		{ "quick_use_2", "kQUICK_USE_2", 62 },
		{ "quick_use_3", "kQUICK_USE_3", 63 },
		{ "quick_use_4", "kQUICK_USE_4", 64 },
		{ "quick_save", "kQUICK_SAVE", 65 },
		{ "quick_load", "kQUICK_LOAD", 66 },
		{ "custom1", "kCUSTOM1", 67 },
		{ "custom2", "kCUSTOM2", 68 },
		{ "custom3", "kCUSTOM3", 69 },
		{ "custom4", "kCUSTOM4", 70 },
		{ "custom5", "kCUSTOM5", 71 },
		{ "custom6", "kCUSTOM6", 72 },
		{ "custom7", "kCUSTOM7", 73 },
		{ "custom8", "kCUSTOM8", 74 },
		{ "custom9", "kCUSTOM9", 75 },
		{ "custom10", "kCUSTOM10", 76 },
		{ "custom11", "kCUSTOM11", 77 },
		{ "custom12", "kCUSTOM12", 78 },
		{ "custom13", "kCUSTOM13", 79 },
		{ "custom14", "kCUSTOM14", 80 },
		{ "custom15", "kCUSTOM15", 81 },
		{ "custom16", "kCUSTOM16", 82 },
		{ "custom17", "kCUSTOM17", 83 },
		{ "custom18", "kCUSTOM18", 84 },
		{ "custom19", "kCUSTOM19", 85 },
		{ "custom20", "kCUSTOM20", 86 },
		{ "custom21", "kCUSTOM21", 87 },
		{ "custom22", "kCUSTOM22", 88 },
		{ "custom23", "kCUSTOM23", 89 },
		{ "custom24", "kCUSTOM24", 90 },
		{ "custom25", "kCUSTOM25", 91 },
		{ "safemode", "kSAFEMODE", 92 },
		{ "freelook", "kFREELOOK", 93 },
	},
}

local CONFIG = _G.dogma_tweaks_keybinds_fix_conf

local function enabled()
	return true
end

local function kb_id(entry)
	local field = entry[2]
	local fallback = entry[3]
	if key_bindings and field and key_bindings[field] ~= nil then
		return key_bindings[field]
	end
	return fallback
end

local function engine_dik(bind, slot)
	if bind == nil or not bind_to_dik then
		return -1
	end
	local attempts
	if slot == 1 then
		attempts = { function() return bind_to_dik(bind, 1) end }
	else
		attempts = { function() return bind_to_dik(bind, 0) end }
	end
	for i = 1, #attempts do
		local ok, dik = pcall(attempts[i])
		if ok and type(dik) == "number" and dik ~= 0 then
			return dik
		end
	end
	if slot ~= 1 then
		local ok, dik = pcall(function() return bind_to_dik(bind) end)
		if ok and type(dik) == "number" and dik ~= 0 then
			return dik
		end
	end
	return -1
end

local function ensure_quit_escape()
	exec_console_cmd("bind quit kESCAPE")
end

local function clear_escape_binds()
	local esc = DIK_keys and DIK_keys.DIK_ESCAPE
	if not esc then
		ensure_quit_escape()
		return
	end
	for i = 1, #CONFIG.ACTIONS do
		local entry = CONFIG.ACTIONS[i]
		local action = entry[1]
		if action ~= "quit" then
			local bind = kb_id(entry)
			if bind ~= nil then
				if engine_dik(bind, 0) == esc then
					exec_console_cmd("unbind " .. action)
				end
				if engine_dik(bind, 1) == esc then
					exec_console_cmd("unbind_sec " .. action)
				end
			end
		end
	end
	ensure_quit_escape()
end

local function repair_keybinds()
	if not enabled() then
		return
	end
	clear_escape_binds()
	ensure_quit_escape()
end

CONFIG.enabled = enabled
CONFIG.ensure_quit_escape = ensure_quit_escape
CONFIG.clear_escape_binds = clear_escape_binds
CONFIG.repair_keybinds = repair_keybinds

--------------------------------------------------------------------------------
-- ui_options hooks (Options → Controls → Keybinds)
--------------------------------------------------------------------------------

local STATE = _G.__dogma_tweaks_keybinds_fix or {}
_G.__dogma_tweaks_keybinds_fix = STATE

local function patch_ui_options()
	local cls = ui_options and ui_options.UIOptions
	if not (cls and cls.OnKeyboard and cls.On_Accept) then
		return false
	end
	if STATE.wrap_keyboard and cls.OnKeyboard == STATE.wrap_keyboard then
		return true
	end

	local base_keyboard = cls.OnKeyboard
	local base_accept = cls.On_Accept
	local base_default = cls.OnButton_Default

	local function keybinds_page_open(self)
		return self.Keybinds_Shown
			and self.dlg_controls
			and self.dlg_controls.IsShown
			and self.dlg_controls:IsShown()
	end

	local function refresh_keybind_widgets()
		if not COptionsManager then
			return
		end
		local opt = COptionsManager()
		opt:SetCurrentValues("key_binding")
	end

	-- C++ assigns Escape into the pending UI slot; steal it back via conflict
	-- message so the slot becomes "---" (do not SetCurrentValues - that
	-- reloads the old engine bind).
	local function escape_unbind_pending_slot()
		if not COptionsManager then
			return
		end
		local opt = COptionsManager()
		opt:SendMessage2Group("key_binding", "quit=kESCAPE")
		ensure_quit_escape()
	end

	local function wrap_keyboard(self, dik, keyboard_action)
		if not enabled() then
			return base_keyboard(self, dik, keyboard_action)
		end

		local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
		if keyboard_action == ui_events.WINDOW_KEY_PRESSED
			and dik == DIK_keys.DIK_ESCAPE
			and keybinds_page_open(self)
		then
			if res then
				escape_unbind_pending_slot()
				return true
			end
			self:OnButton_Cancel()
			return res
		end

		if res == false and keyboard_action == ui_events.WINDOW_KEY_PRESSED
			and dik == DIK_keys.DIK_ESCAPE
		then
			self:OnButton_Cancel()
		end
		return res
	end

	local function wrap_accept(self)
		base_accept(self)
		if enabled() then
			repair_keybinds()
			exec_console_cmd("cfg_save")
		end
	end

	local function wrap_default(self)
		base_default(self)
		if enabled() then
			-- Our default_controls.ltx is Exit-only; pin it and refresh UI.
			ensure_quit_escape()
			if keybinds_page_open(self) then
				refresh_keybind_widgets()
			end
		end
	end

	cls.OnKeyboard = wrap_keyboard
	cls.On_Accept = wrap_accept
	if base_default then
		cls.OnButton_Default = wrap_default
	end
	STATE.wrap_keyboard = wrap_keyboard
	STATE.wrap_accept = wrap_accept
	STATE.wrap_default = wrap_default
	return true
end

CONFIG.patch_ui_options = patch_ui_options
