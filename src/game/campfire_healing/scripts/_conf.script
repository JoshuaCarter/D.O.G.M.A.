-- game/campfire_healing conf
-- Lit campfire within range_m (0–5, def 2): convert existing limb temp→perm, heal body.
-- body_sec / limb_sec: seconds for a 20% step (body 30–100 def 30; limbs 20–100 def 20).
-- pause_in_combat: optional; default off (heal even if something still has you as best_enemy).
-- fx_enable / fx_intensity: orange PPE while body HP < 100% and a heal is running.

_G.dogma_game_campfire_healing_conf = {
	MOD_ID = "dogma/game/campfire_healing",
	DEFAULTS = {
		["range_m"] = 3,
		["body_sec"] = 30,
		["limb_sec"] = 20,
		["pause_in_combat"] = false,
		["fx_enable"] = true,
		["fx_intensity"] = 0.5,
	},
	PPE = {
		name = "dogma_campfire_heal.ppe",
		id = 2041,
	},
}
