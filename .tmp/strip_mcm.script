function on_mcm_load()
	local CONF = _G.dogma_strip_everything_conf
	local D = CONF.defaults

	local function kb_bind(id, hint)
		return {
			id = id,
			type = "key_bind",
			val = 2,
			def = D["main/" .. id],
			hint = hint,
		}
	end

	local function kb_modifier(id)
		local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
		return {
			id = id,
			type = kb_mod,
			val = 2,
			def = D["main/" .. id],
			hint = "mcm_kb_modifier",
			content = {
				{ 0, "mcm_kb_mod_none" },
				{ 1, "mcm_kb_mod_shift" },
				{ 2, "mcm_kb_mod_ctrl" },
				{ 3, "mcm_kb_mod_alt" },
			},
		}
	end

	local function kb_mode(id)
		local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
		return {
			id = id,
			type = kb_mod,
			val = 2,
			def = D["main/" .. id],
			hint = "mcm_kb_mode",
			content = {
				{ 0, "mcm_kb_mode_press" },
				{ 1, "mcm_kb_mode_dtap" },
				{ 2, "mcm_kb_mode_hold" },
			},
		}
	end

	return {
		id = "strip_everything",
		text = "ui_mcm_menu_dogma_fieldstrip_all_keybind",
		gr = {
			{
				id = "main",
				sh = true,
				text = "ui_mcm_dogma_fieldstrip_all_keybind_main_section",
				gr = dogma_mcm.with_header({
					{
						id = "main_drop_description",
						type = "desc",
						text = "ui_mcm_dogma_strip_everything_main_drop_description",
					},
					kb_bind("key_drop", "dogma_strip_everything_key_drop"),
					kb_modifier("key_drop_modifier"),
					kb_mode("key_drop_mode"),
					kb_bind("key_drop_all", "dogma_strip_everything_key_drop_all"),
					kb_modifier("key_drop_all_modifier"),
					kb_mode("key_drop_all_mode"),
					{
						id = "drop_safe_equipped",
						type = "check",
						val = 1,
						def = D["main/drop_safe_equipped"],
						hint = "dogma_strip_everything_drop_safe_equipped",
					},
					{
						id = "main_disa_description",
						type = "desc",
						text = "ui_mcm_dogma_strip_everything_main_disa_description",
					},
					kb_bind("key_disa", "dogma_strip_everything_key_disa"),
					kb_modifier("key_disa_modifier"),
					kb_mode("key_disa_mode"),
					kb_bind("key_disa_all", "dogma_strip_everything_key_disa_all"),
					kb_modifier("key_disa_all_modifier"),
					kb_mode("key_disa_all_mode"),
					{
						id = "disa_safe_equipped",
						type = "check",
						val = 1,
						def = D["main/disa_safe_equipped"],
						hint = "dogma_strip_everything_disa_safe_equipped",
					},
					{
						id = "main_strip_description",
						type = "desc",
						text = "ui_mcm_dogma_fieldstrip_all_keybind_main_description",
					},
					kb_bind("key", "dogma_strip_everything_key"),
					kb_modifier("key_modifier"),
					kb_mode("key_mode"),
					kb_bind("key_all", "dogma_strip_everything_key_all"),
					kb_modifier("key_all_modifier"),
					kb_mode("key_all_mode"),
					{
						id = "intercept_disassemble",
						type = "check",
						val = 1,
						def = D["main/intercept_disassemble"],
						hint = "dogma_strip_everything_intercept_disassemble",
					},
					{
						id = "keep_parts_with_weapon",
						type = "check",
						val = 1,
						def = D["main/keep_parts_with_weapon"],
						hint = "dogma_strip_everything_keep_parts_with_weapon",
					},
					{
						id = "pda_stash_on_disassemble",
						type = "check",
						val = 1,
						def = D["main/pda_stash_on_disassemble"],
						hint = "dogma_strip_everything_pda_stash_on_disassemble",
					},
					{
						id = "companion_loot_description",
						type = "desc",
						text = "ui_mcm_dogma_strip_everything_companion_loot_description",
					},
					{
						id = "block_companion_special_items",
						type = "check",
						val = 1,
						def = D["main/block_companion_special_items"],
						hint = "dogma_strip_everything_block_companion_special_items",
					},
				}),
			},
			{
				id = "dis_weap_attach",
				sh = true,
				text = "ui_mcm_dogma_strip_everything_attachments_section",
				gr = dogma_mcm.with_header({
					{
						id = "dis_weap_attach_description",
						type = "desc",
						text = "ui_mcm_dogma_strip_everything_attachments_description",
					},
					{
						id = "enabled",
						type = "check",
						val = 1,
						def = D["dis_weap_attach/enabled"],
						hint = "dogma_strip_everything_attachments_enabled",
					},
				}),
			},
			{
				id = "development",
				sh = true,
				text = "ui_mcm_dogma_fieldstrip_all_keybind_development_section",
				gr = dogma_mcm.with_header({
					{
						id = "debug_log",
						type = "check",
						val = 1,
						def = D["development/debug_log"],
						hint = "dogma_strip_everything_debug_log",
					},
					{
						id = "drop_disa_debug_log",
						type = "check",
						val = 1,
						def = D["development/drop_disa_debug_log"],
						hint = "dogma_strip_everything_drop_disa_debug_log",
					},
					{
						id = "dis_weap_attach_debug_log",
						type = "check",
						val = 1,
						def = D["development/dis_weap_attach_debug_log"],
						hint = "dogma_strip_everything_dis_weap_attach_debug_log",
					},
				}),
			},
		},
	}, "dogma"
end
