--[[
	Stalker ID - centered Faction Identification replacement.

	Every 100ms: exact camera look-ray first, then soft aim (screen tolerance +
	optional LOS). Both rays share one bush-pierce budget. Hipfire both 100m; binoculars both 200m;
	other ADS/zoom keeps soft at 100m but exact at 200m. Leader line:
	living non-hostiles normally, all living stalkers in binocs; never corpses.
	Living hostile / zombified names are red; dead names are grey. Losing the target fades over 2s.
]]

local CONFIG = _G.dogma_gui_stalker_id_conf

local UI_WIDTH = 1024
local UI_HEIGHT = 768
local UI_CENTER_X = UI_WIDTH * 0.5
local UI_CX, UI_CY = 512, 384
local ALIGN_CENTER = 2 -- CGameFont::alCenter
local UPDATE_DELAY = 100
local FADE_MS = 2000
local NAME_HOSTILE_RGB = { 220, 48, 48 }
local NAME_DEAD_RGB = { 200, 200, 200 }
local RANK_RGB = { 200, 200, 200 }
local RANK_DEAD_RGB = { 160, 160, 160 }

-- Aim / nearest: pelvis. LOS: upper spine. Line tip: head (lifted toward crown).
local BONES_AIM = { "bip01_pelvis" }
local BONES_LOS = { "bip01_spine2", "bip01_spine1", "bip01_neck" }
local BONES_LINE = { "bip01_head" }
local HEAD_CROWN_LIFT = 0.12 -- metres above head bone ≈ top of head

-- Objects + statics. Bushes recast up to MCM bush_pierce; walls still block.
local LOOK_FLAGS = 3 -- rqtObject | rqtStatic
local LOOK_BUSH_STEP = 0.2 -- metres nudged past each bush hit to avoid re-hitting it
local look_pick = nil
local LOOK_POS = vector()
local LOOK_DIR = vector()
local LOOK_SCRATCH = vector()
local W2U_SCRATCH = vector()

-- Line thickness: real pixels from MCM (halo +1), converted to virtual UI space.
local LINE_HALO_REAL_PX = 1
local PATCH_H = 24 -- faction patch / zombified row height in ui xml
local LINE_START_BELOW_PX = 5 -- below bottom of patch (or zombified text)
local FOV_ZOOM_RATIO = 0.7
local FACTION_KEYS = {
	"stalker", "bandit", "csky", "army", "freedom", "dolg", "ecolog",
	"killer", "monolith", "greh", "renegade", "isg",
}

local HUD = nil
local nametable = {}
local LastHitObject = nil
local line_target_id = nil
local trigger = 0
local grok_delay = 0

local fade_active = false
local fade_start_ms = 0
local fade_mul = 1
local shown_faction = nil
local name_r, name_g, name_b = 255, 255, 255
local rank_r, rank_g, rank_b = RANK_RGB[1], RANK_RGB[2], RANK_RGB[3]

local zombified_text
local _fov_baseline = 60
local UI_KX = 1
local _ui_w = 0

local POS_VEC = vector2()
local SIZE_VEC = vector2()

local floor, sqrt, atan2 = math.floor, math.sqrt, math.atan2

local function clamp01(v)
	if v < 0 then
		return 0
	end
	if v > 1 then
		return 1
	end
	return v
end

local function pct_to_byte(pct, mul)
	return floor(255 * clamp01((tonumber(pct) or 0) / 100) * clamp01(mul) + 0.5)
end

local function on_option_change()
	local id = CONFIG.MOD_ID
	CONFIG.loaded.dead_id = dogma.mcm.bool(id, "dead_id")
	CONFIG.loaded.name_id = dogma.mcm.bool(id, "name_id")
	CONFIG.loaded.rank_id = dogma.mcm.bool(id, "rank_id")
	CONFIG.loaded.name_y = dogma.mcm.int(id, "name_y")
	CONFIG.loaded.rank_y = dogma.mcm.int(id, "rank_y")
	CONFIG.loaded.icon_y = dogma.mcm.int(id, "icon_y")
	CONFIG.loaded.name_a = dogma.mcm.uint(id, "name_a")
	CONFIG.loaded.rank_a = dogma.mcm.uint(id, "rank_a")
	CONFIG.loaded.icon_a = dogma.mcm.uint(id, "icon_a")
	CONFIG.loaded.max_range = dogma.mcm.uint(id, "max_range")
	CONFIG.loaded.binoc_max_range = dogma.mcm.uint(id, "binoc_max_range")
	CONFIG.loaded.aim_radius_px = dogma.mcm.uint(id, "aim_radius_px")
	CONFIG.loaded.require_visible = dogma.mcm.bool(id, "require_visible")
	CONFIG.loaded.bush_pierce = math.min(5, dogma.mcm.uint(id, "bush_pierce"))
	CONFIG.loaded.hide_on_death = dogma.mcm.bool(id, "hide_on_death")
	CONFIG.loaded.always_show_line = dogma.mcm.bool(id, "always_show_line")
	CONFIG.loaded.always_show_line_binoc = dogma.mcm.bool(id, "always_show_line_binoc")
	CONFIG.loaded.hide_line_on_pda = dogma.mcm.bool(id, "hide_line_on_pda")
	CONFIG.loaded.line_keybind = dogma.mcm.key(id, "line_keybind")
	CONFIG.loaded.line_width_px = dogma.mcm.uint(id, "line_width_px")
	CONFIG.loaded.line_r = dogma.mcm.uint(id, "line_r")
	CONFIG.loaded.line_g = dogma.mcm.uint(id, "line_g")
	CONFIG.loaded.line_b = dogma.mcm.uint(id, "line_b")
	CONFIG.loaded.line_a = dogma.mcm.uint(id, "line_a")
end

local function hide_all_patches(hud)
	for i = 1, #FACTION_KEYS do
		local key = FACTION_KEYS[i]
		hud.factions[key]:Show(false)
		hud.factions[key .. "_dead"]:Show(false)
	end
end

local function clear_text(hud)
	hud.name:TextControl():SetText("")
	hud.rank:TextControl():SetText("")
	hud.zombified:TextControl():SetText("")
	hud.zombified:Show(false)
end

local function hide_line(hud)
	hud = hud or HUD
	if not hud then
		return
	end
	hud.line:Show(false)
	hud.line_sh:Show(false)
end

local function apply_alphas(mul)
	if not HUD then
		return
	end
	fade_mul = clamp01(mul)
	local cfg = CONFIG.loaded
	local name_a = pct_to_byte(cfg.name_a, fade_mul)
	local rank_a = pct_to_byte(cfg.rank_a, fade_mul)
	local icon_a = pct_to_byte(cfg.icon_a, fade_mul)

	HUD.name:TextControl():SetTextColor(GetARGB(name_a, name_r, name_g, name_b))
	HUD.rank:TextControl():SetTextColor(GetARGB(rank_a, rank_r, rank_g, rank_b))
	HUD.zombified:TextControl():SetTextColor(GetARGB(icon_a, 255, 255, 255))

	if shown_faction and HUD.factions[shown_faction] then
		pcall(function()
			HUD.factions[shown_faction]:SetTextureColor(GetARGB(icon_a, 255, 255, 255))
		end)
	end
end

local function cancel_fade()
	fade_active = false
	fade_start_ms = 0
	fade_mul = 1
end

local function start_fade()
	fade_active = true
	fade_start_ms = time_global()
end

local function clear()
	cancel_fade()
	shown_faction = nil
	line_target_id = nil
	name_r, name_g, name_b = 255, 255, 255
	rank_r, rank_g, rank_b = RANK_RGB[1], RANK_RGB[2], RANK_RGB[3]
	if HUD then
		HUD:Reset()
	end
end

class "UIStalkerIDHUD" (CUIScriptWnd)

function UIStalkerIDHUD:__init() super()
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_dogma_stalker_id.xml")

	self.line_sh = xml:InitStatic("line_sh", self)
	self.line = xml:InitStatic("line", self)
	self.line_sh:EnableHeading(true)
	self.line:EnableHeading(true)
	self.line_sh:Show(false)
	self.line:Show(false)

	self.factions = {}
	for i = 1, #FACTION_KEYS do
		local key = FACTION_KEYS[i]
		self.factions[key] = xml:InitStatic("patch_" .. key, self)
		self.factions[key .. "_dead"] = xml:InitStatic("patch_dead_" .. key, self)
	end

	self.name = xml:InitStatic("name", self)
	self.rank = xml:InitStatic("rank", self)
	self.zombified = xml:InitStatic("zombified", self)

	pcall(function()
		self.name:TextControl():SetTextComplexMode(false)
		self.name:TextControl():SetTextAlignment(ALIGN_CENTER)
		self.rank:TextControl():SetTextComplexMode(false)
		self.rank:TextControl():SetTextAlignment(ALIGN_CENTER)
		self.zombified:TextControl():SetTextComplexMode(false)
		self.zombified:TextControl():SetTextAlignment(ALIGN_CENTER)
	end)

	hide_all_patches(self)
	clear_text(self)
end

function UIStalkerIDHUD:__finalize()
end

function UIStalkerIDHUD:Reset()
	hide_all_patches(self)
	clear_text(self)
	hide_line(self)
end

local function activate_hud()
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	if HUD == nil then
		HUD = UIStalkerIDHUD()
		get_hud():AddDialogToRender(HUD)
	end
end

local function deactivate_hud()
	if HUD ~= nil then
		get_hud():RemoveDialogToRender(HUD)
		HUD = nil
	end
	UnregisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
end

function on_screen_resolution_changed()
	deactivate_hud()
	activate_hud()
	_ui_w = 0
end

function actor_on_net_destroy()
	if HUD ~= nil then
		get_hud():RemoveDialogToRender(HUD)
		HUD = nil
	end
	line_target_id = nil
end

function actor_on_first_update()
	activate_hud()
end

local function is_zombied(community)
	return community == "zombied"
end

local function is_valid_community(community)
	if not community then
		return false
	end
	if is_zombied(community) then
		return true
	end
	return HUD and HUD.factions[community] ~= nil
end

local function is_hostile(obj)
	if not (obj and db.actor and game_object and game_object.enemy) then
		return false
	end
	local ok, rel = pcall(obj.relation, obj, db.actor)
	return ok and rel ~= nil and rel >= game_object.enemy
end

local function set_name_color_for(obj)
	local alive = obj and obj.health and obj.health > 0
	if not alive then
		name_r, name_g, name_b = NAME_DEAD_RGB[1], NAME_DEAD_RGB[2], NAME_DEAD_RGB[3]
		rank_r, rank_g, rank_b = RANK_DEAD_RGB[1], RANK_DEAD_RGB[2], RANK_DEAD_RGB[3]
		return
	end
	rank_r, rank_g, rank_b = RANK_RGB[1], RANK_RGB[2], RANK_RGB[3]
	if is_zombied(obj:character_community()) or is_hostile(obj) then
		name_r, name_g, name_b = NAME_HOSTILE_RGB[1], NAME_HOSTILE_RGB[2], NAME_HOSTILE_RGB[3]
	else
		name_r, name_g, name_b = 255, 255, 255
	end
end

local function display(faction, name, rank, zombified)
	if not HUD then
		return
	end

	local cfg = CONFIG.loaded
	cancel_fade()
	shown_faction = nil
	hide_all_patches(HUD)
	clear_text(HUD)

	HUD.name:SetWndPos(POS_VEC:set(0, cfg.name_y))
	HUD.rank:SetWndPos(POS_VEC:set(0, cfg.rank_y))

	if name then
		HUD.name:TextControl():SetText(name)
	end
	if rank then
		HUD.rank:TextControl():SetText(rank)
	end

	if zombified then
		HUD.zombified:SetWndPos(POS_VEC:set(0, cfg.icon_y))
		HUD.zombified:TextControl():SetText(zombified_text)
		HUD.zombified:Show(true)
		apply_alphas(1)
		return
	end

	if faction and HUD.factions[faction] then
		shown_faction = faction
		HUD.factions[faction]:SetWndPos(POS_VEC:set(UI_CENTER_X, cfg.icon_y))
		HUD.factions[faction]:Show(true)
	end
	apply_alphas(1)
end

local function display_faction(obj)
	if not obj then
		return
	end

	local cfg = CONFIG.loaded
	local fact = obj:character_community()
	local name = obj:character_name()
	local rank = game.translate_string("st_rank_" .. ranks.get_obj_rank_name(obj)) or ""

	if not cfg.rank_id then
		rank = nil
	end
	if not cfg.name_id then
		name = nil
	end

	if name == nil or name == "" then
		name = nil
	end
	if rank == nil or rank == "" then
		rank = nil
	end

	set_name_color_for(obj)

	if is_zombied(fact) then
		display(nil, name, rank, true)
		return
	end

	if cfg.dead_id and obj.health <= 0 then
		fact = fact .. "_dead"
	end

	display(fact, name, rank, false)
end

local function bone_pos(obj, bones, y_lift)
	for i = 1, #bones do
		local ok, p = pcall(obj.bone_position, obj, bones[i])
		if ok and p then
			if y_lift and y_lift ~= 0 then
				return LOOK_SCRATCH:set(p.x, p.y + y_lift, p.z)
			end
			return p
		end
	end
	local p = obj:position()
	return LOOK_SCRATCH:set(p.x, p.y + 1.2, p.z)
end

local function aim_pos(obj)
	return bone_pos(obj, BONES_AIM, 0)
end

local function los_pos(obj)
	return bone_pos(obj, BONES_LOS, 0)
end

local function line_tip_pos(obj)
	return bone_pos(obj, BONES_LINE, HEAD_CROWN_LIFT)
end

local function project_world(pos)
	local w2u = (game and game.world2ui) or (level and level.world2ui)
	if not w2u then
		return nil
	end
	local ui = w2u(W2U_SCRATCH:set(pos), false, false)
	if not ui or ui.x < -9000 then
		return nil
	end
	return ui.x, ui.y
end

local function is_bush_material(name)
	if type(name) ~= "string" then
		return false
	end
	return name:find("bush", 1, true) ~= nil
end

-- Recast through up to bush_pierce static bushes. Returns the first non-bush
-- hit object (nil if a wall / miss). Shared by exact look-ray and LOS.
local function query_look_object(ox, oy, oz, dx, dy, dz, remaining)
	if not look_pick then
		look_pick = ray_pick()
	end
	local pick = look_pick
	pick:set_flags(LOOK_FLAGS)
	LOOK_DIR:set(dx, dy, dz)
	local actor = db and db.actor
	local max_pierce = CONFIG.loaded.bush_pierce or 0
	local pierces = 0

	while remaining > LOOK_BUSH_STEP and pierces <= max_pierce do
		LOOK_POS:set(ox, oy, oz)
		pick:set_position(LOOK_POS)
		pick:set_direction(LOOK_DIR)
		pick:set_range(remaining)
		if actor then
			pick:set_ignore_object(actor)
		end

		local ok, hit = pcall(function()
			return pick:query()
		end)
		if not (ok and hit) then
			return nil
		end

		local obj = pick:get_object()
		if obj then
			return obj
		end

		local result = pick:get_result()
		local hit_dist = pick:get_distance()
		if not (result and hit_dist and hit_dist > 0 and is_bush_material(result.material_name)) then
			return nil
		end

		local step = hit_dist + LOOK_BUSH_STEP
		ox = ox + dx * step
		oy = oy + dy * step
		oz = oz + dz * step
		remaining = remaining - step
		pierces = pierces + 1
	end
	return nil
end

-- First non-bush hit from camera toward `to_pos`. True if that object is `target_obj`.
local function ray_hits_object(target_obj, to_pos, max_range)
	local d = device()
	if not (ray_pick and d and d.cam_pos and target_obj and to_pos) then
		return false
	end

	local ox, oy, oz = d.cam_pos.x, d.cam_pos.y, d.cam_pos.z
	local dx = to_pos.x - ox
	local dy = to_pos.y - oy
	local dz = to_pos.z - oz
	local dist = sqrt(dx * dx + dy * dy + dz * dz)
	if dist < 0.05 then
		return true
	end
	dx, dy, dz = dx / dist, dy / dist, dz / dist

	local remaining = dist + 0.5
	if max_range and remaining > max_range then
		remaining = max_range
	end

	local obj = query_look_object(ox, oy, oz, dx, dy, dz, remaining)
	return obj and obj:id() == target_obj:id()
end

local function screen_dist_to_center(pos)
	local sx, sy = project_world(pos)
	if not sx then
		return nil
	end
	local dx, dy = sx - UI_CX, sy - UI_CY
	return sqrt(dx * dx + dy * dy)
end

-- Pelvis vs screen centre (nil if it does not project inside the aim circle).
local function aim_screen_dist(obj, max_range, apos, radius)
	local pelvis = aim_pos(obj)
	if not (pelvis and apos:distance_to(pelvis) <= max_range) then
		return nil
	end
	local sd = screen_dist_to_center(pelvis)
	if sd and sd <= radius then
		return sd
	end
	return nil
end

local function cand_screen_cmp(a, b)
	return a.sd < b.sd
end

local function is_binoc_held()
	if not db.actor then
		return false
	end
	local ok, item = pcall(db.actor.active_item, db.actor)
	if not ok or not item then
		return false
	end
	local ok2, sec = pcall(item.section, item)
	if not ok2 or not sec then
		return false
	end
	return sec == "wpn_binoc_inv" or sec:find("binoc") ~= nil
end

local function update_fov_baseline()
	if is_binoc_held() then
		return
	end
	local d = device and device()
	local fov = d and d.fov
	if fov and fov > _fov_baseline then
		_fov_baseline = fov
	end
end

local function is_binoc_active()
	local axr = axr_main
	if axr and axr.binoc_is_zoomed then
		return true
	end
	if not is_binoc_held() then
		return false
	end
	local d = device and device()
	local fov = d and d.fov
	if not fov or fov <= 0 then
		return true
	end
	return fov < _fov_baseline * FOV_ZOOM_RATIO
end

local function using_binocs()
	return is_binoc_held() or (axr_main and axr_main.binoc_is_zoomed)
end

-- Soft-aim search: 100m hipfire, 200m with binoculars only.
local function approx_max_range()
	local cfg = CONFIG.loaded
	if using_binocs() then
		return cfg.binoc_max_range or cfg.max_range or 0
	end
	return cfg.max_range or 0
end

-- ADS / free-zoom / binoc zoom: FOV below hipfire baseline.
local function is_ads_zoomed()
	if using_binocs() then
		return true
	end
	local d = device and device()
	local fov = d and d.fov
	if not fov or fov <= 0 or not _fov_baseline or _fov_baseline <= 0 then
		return false
	end
	return fov < _fov_baseline * FOV_ZOOM_RATIO
end

-- Exact look-ray: 100m hipfire; 200m with binocs or other ADS/zoom.
local function exact_max_range()
	local cfg = CONFIG.loaded
	if using_binocs() or is_ads_zoomed() then
		return cfg.binoc_max_range or cfg.max_range or 0
	end
	return cfg.max_range or 0
end

local function is_id_candidate(obj)
	local cfg = CONFIG.loaded
	if not obj or not IsStalker(obj) then
		return false
	end
	if db.actor and obj:id() == db.actor:id() then
		return false
	end
	if not (obj.health > 0 or cfg.dead_id) then
		return false
	end
	return is_valid_community(obj:character_community())
end

-- Exact look-ray: first non-bush object under crosshair within range.
local function cam_look_object(max_range)
	local d = device and device()
	if not (ray_pick and d and d.cam_pos and d.cam_dir and max_range and max_range > 0) then
		return nil
	end
	return query_look_object(
		d.cam_pos.x, d.cam_pos.y, d.cam_pos.z,
		d.cam_dir.x, d.cam_dir.y, d.cam_dir.z,
		max_range)
end

local function find_exact_target()
	local obj = cam_look_object(exact_max_range())
	if obj and is_id_candidate(obj) then
		return obj
	end
	return nil
end

local function find_id_target()
	-- Exact under crosshair + optional soft-aim iterate_nearest; runs on 100ms tick.
	dogma.perf.start("stalker_id", "find_target")
	local result = nil
	repeat
		local exact = find_exact_target()
		if exact then
			result = exact
			break
		end

		local cfg = CONFIG.loaded
		local max_range = approx_max_range()
		if max_range <= 0 or not (db and db.actor) or not level.iterate_nearest then
			break
		end
		if not HUD then
			break
		end

		local apos = db.actor:position()
		local actor_id = db.actor:id()
		local radius = cfg.aim_radius_px or 0
		local candidates = {}

		pcall(level.iterate_nearest, apos, max_range, function(obj)
			if not obj then
				return false
			end
			if obj:id() == 0 or obj:id() == actor_id then
				return false
			end
			if not is_id_candidate(obj) then
				return false
			end

			local sd = aim_screen_dist(obj, max_range, apos, radius)
			if sd then
				candidates[#candidates + 1] = { obj = obj, sd = sd }
			end
			return false
		end)

		if #candidates == 0 then
			break
		end
		table.sort(candidates, cand_screen_cmp)

		if not cfg.require_visible then
			result = candidates[1].obj
			break
		end

		for i = 1, #candidates do
			local obj = candidates[i].obj
			local chest = los_pos(obj)
			if chest and ray_hits_object(obj, chest, max_range) then
				result = obj
				break
			end
		end
	until true
	dogma.perf.stop()
	return result
end

local PDA_SLOT = 8

local function pda_in_hands()
	local actor = db and db.actor
	return actor and actor:active_slot() == PDA_SLOT
end

local function want_line()
	local cfg = CONFIG.loaded
	if cfg.hide_line_on_pda and pda_in_hands() then
		return false
	end
	if cfg.always_show_line then
		return true
	end
	if cfg.always_show_line_binoc and is_binoc_active() then
		return true
	end
	local key = cfg.line_keybind
	if key and dogma.input and dogma.input.is_key_down(key) then
		return true
	end
	return false
end

local function allow_line_for(obj)
	-- Living only: non-hostiles anytime the line is wanted; hostiles only in binocs.
	if not obj or not (obj.health and obj.health > 0) then
		return false
	end
	if is_binoc_active() then
		return true
	end
	return not is_hostile(obj)
end

local function refresh_ui_kx()
	local d = device and device()
	if not (d and d.width and d.width > 0) then
		return
	end
	if d.width == _ui_w then
		return
	end
	_ui_w = d.width
	UI_KX = (d.height / d.width) / (UI_HEIGHT / UI_WIDTH)
end

-- Virtual-UI thickness for a given real-pixel width (UI is always 1024x768).
local function line_thick_ui(real_px)
	local d = device and device()
	local h = (d and d.height and d.height > 0) and d.height or UI_HEIGHT
	local t = (real_px or 1) * UI_HEIGHT / h
	if t < 0.35 then
		t = 0.35
	end
	return t
end

-- Leader-line start: centered under the faction patch (or zombified row), +5px.
local function line_start_ui()
	local icon_y = CONFIG.loaded.icon_y or 60
	local uy
	if shown_faction then
		-- Patch uses alignment="c"; icon_y is the vertical centre.
		uy = icon_y + PATCH_H * 0.5 + LINE_START_BELOW_PX
	else
		-- Zombified text static is top-aligned at icon_y.
		uy = icon_y + PATCH_H + LINE_START_BELOW_PX
	end
	return UI_CENTER_X, uy
end

local function update_leader_line()
	-- Active ID or fading: line_target_id is kept through fade, cleared on clear().
	if not (HUD and line_target_id and want_line() and fade_mul > 0 and (LastHitObject or fade_active)) then
		hide_line()
		return
	end

	dogma.perf.start("stalker_id", "leader_line")
	repeat
		local obj = level.object_by_id and level.object_by_id(line_target_id)
		if not obj then
			hide_line()
			break
		end
		if not allow_line_for(obj) then
			hide_line()
			break
		end

		local tip = line_tip_pos(obj)
		local hx, hy = project_world(tip)
		if not hx then
			hide_line()
			break
		end

		refresh_ui_kx()
		local ux, uy = line_start_ui()
		local dx = hx - ux
		local dy = hy - uy
		local screen_len = sqrt(dx * dx + dy * dy)
		if screen_len < 1 then
			hide_line()
			break
		end

		-- Shorten by screen-space upper-spine→head span so tip sits near upper spine.
		local spine = los_pos(obj)
		local sx, sy = project_world(spine)
		if sx then
			local bdx = hx - sx
			local bdy = hy - sy
			local gap = sqrt(bdx * bdx + bdy * bdy)
			if gap > 0 then
				if gap > screen_len * 0.9 then
					gap = screen_len * 0.9
				end
				local f = gap / screen_len
				hx = hx - dx * f
				hy = hy - dy * f
				dx = hx - ux
				dy = hy - uy
				screen_len = sqrt(dx * dx + dy * dy)
				if screen_len < 1 then
					hide_line()
					break
				end
			end
		end

		local dxk = dx / UI_KX
		local len = sqrt(dxk * dxk + dy * dy)
		if len < 1 then
			hide_line()
			break
		end

		local ang = atan2(-dy, dxk)
		local mx = (ux + hx) * 0.5
		local my = (uy + hy) * 0.5
		local cfg = CONFIG.loaded
		local a = floor((cfg.line_a or 200) * fade_mul + 0.5)
		if a < 1 then
			hide_line()
			break
		end
		if a > 255 then
			a = 255
		end

		local thick = line_thick_ui(cfg.line_width_px or 1)
		local halo_t = thick + line_thick_ui(LINE_HALO_REAL_PX)
		HUD.line_sh:SetWndSize(SIZE_VEC:set(len, halo_t))
		HUD.line_sh:SetWndPos(POS_VEC:set(mx - len * 0.5, my - halo_t * 0.5))
		HUD.line_sh:SetHeading(ang)
		HUD.line_sh:SetTextureColor(GetARGB(floor(a * 0.6), 0, 0, 0))
		HUD.line_sh:Show(true)

		local lr = cfg.line_r or 255
		local lg = cfg.line_g or 255
		local lb = cfg.line_b or 255
		if lr > 255 then lr = 255 end
		if lg > 255 then lg = 255 end
		if lb > 255 then lb = 255 end
		HUD.line:SetWndSize(SIZE_VEC:set(len, thick))
		HUD.line:SetWndPos(POS_VEC:set(mx - len * 0.5, my - thick * 0.5))
		HUD.line:SetHeading(ang)
		HUD.line:SetTextureColor(GetARGB(a, lr, lg, lb))
		HUD.line:Show(true)
	until true
	dogma.perf.stop()
end

local function target_enter(obj)
	if not obj then
		return
	end
	line_target_id = obj:id()
	display_faction(obj)
end

local function target_lost()
	if not HUD then
		return
	end
	start_fade()
	apply_alphas(1)
end

local function update_fade()
	if not fade_active then
		return
	end
	local elapsed = time_global() - fade_start_ms
	if elapsed >= FADE_MS then
		clear()
		return
	end
	apply_alphas(1 - (elapsed / FADE_MS))
end

function actor_on_update()
	if CONFIG.loaded.hide_on_death and db.actor and not db.actor:alive() then
		return
	end

	update_fov_baseline()
	update_fade()
	update_leader_line()

	local tg = time_global()
	local cfg = CONFIG.loaded

	if trigger == 0 then
		grok_delay = tg + UPDATE_DELAY
		trigger = 1
	end

	if not (trigger == 1 and tg > grok_delay) then
		return
	end
	trigger = 0

	local obj = find_id_target()
	local valid = HUD and obj ~= nil

	if valid then
		if LastHitObject then
			if obj:id() ~= LastHitObject:id() then
				target_enter(obj)
			elseif fade_active then
				target_enter(obj)
			end
		else
			target_enter(obj)
		end
		LastHitObject = obj
		line_target_id = obj:id()
		return
	end

	if LastHitObject then
		-- Keep line_target_id through fade so the leader line can track.
		LastHitObject = nil
		target_lost()
	end
end

function actor_on_before_death()
	if not CONFIG.loaded.hide_on_death then
		return
	end
	LastHitObject = nil
	clear()
end

function npc_on_death_callback(npc, who)
	if not LastHitObject then
		return
	end
	if npc:id() ~= LastHitObject:id() then
		return
	end

	if CONFIG.loaded.dead_id then
		cancel_fade()
		display_faction(npc)
	else
		LastHitObject = nil
		target_lost()
	end
end

function npc_on_net_destroy(npc)
	if line_target_id and npc:id() == line_target_id then
		line_target_id = nil
	end
	if not LastHitObject then
		return
	end
	if npc:id() == LastHitObject:id() then
		LastHitObject = nil
		clear()
	end
end

function GUI_on_show(gui, str2)
	if gui == "Dialog" then
		local obj = mob_trade.GetTalkingNpc()
		if obj and LastHitObject and LastHitObject:id() == obj:id() then
			nametable[obj:character_name()] = true
			display_faction(obj)
		end
		return
	end

	if gui == "UIInventory" then
		local obj = find_id_target()
		if not (obj and IsStalker(obj)) then
			return
		end
		if obj and obj.health <= 0 and LastHitObject and LastHitObject:id() == obj:id() then
			local mid = utils_obj.safe_bone_pos(LastHitObject, "bip01_spine")
			local pos = device().cam_pos
			if mid and pos and pos:distance_to_sqr(mid) < 4.9 then
				nametable[obj:character_name()] = true
				display_faction(obj)
			end
		end
	end
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	zombified_text = game.translate_string("ui_dogma_gui_stalker_id_zombified")
	on_option_change()

	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("on_screen_resolution_changed", on_screen_resolution_changed)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_before_death", actor_on_before_death)
	RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)
	RegisterScriptCallback("npc_on_net_destroy", npc_on_net_destroy)
	RegisterScriptCallback("GUI_on_show", GUI_on_show)
	RegisterScriptCallback("on_option_change", on_option_change)
end
