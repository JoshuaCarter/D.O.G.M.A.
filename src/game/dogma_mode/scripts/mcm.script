-- game/dogma_mode conf
--
-- Replaces New Game Randomize with a D.O.G.M.A. start. Patch lives in this
-- *mcm.script so a cold-boot New Game screen is already wrapped.

local MOD_ID = "dogma/game/dogma_mode"
local HARD_INDEX = 3
local LIVES = 2
local BTN_TEXT = "D.O.G.M.A."
local FLAG_SUB = "dogma_start_kit.flag"

local STATE = _G.__dogma_game_dogma_mode or {}
_G.__dogma_game_dogma_mode = STATE

local function flag_path()
	if not (getFS and getFS().update_path) then
		return nil
	end
	local ok, path = pcall(function()
		return getFS():update_path("$app_data_root$", FLAG_SUB)
	end)
	if ok and path and path ~= "" then
		return path
	end
	return nil
end

local function write_flag()
	local path = flag_path()
	if not path then
		return false
	end
	local f = io.open(path, "w")
	if not f then
		return false
	end
	f:write("1\n")
	f:close()
	return true
end

local function clear_flag()
	local path = flag_path()
	if not path then
		return
	end
	pcall(os.remove, path)
end

-- Same pick as gui/newgame_layout (Veteran / Survivalist = index 3).
local function force_hard_pick(self, list, table_key, selected_key)
	local t = self[table_key]
	if not (self[list] and t) then
		return
	end
	local pick = t[HARD_INDEX] or t[1]
	if not pick then
		return
	end
	self[list]:SetText(game.translate_string(pick))
	self[selected_key] = pick
end

local function relabel(self)
	local btn = self.btn_random
	if not btn then
		return
	end
	-- CUI3tButton has no Lua SetText; the caption is CUILines via TextControl.
	local tc = btn.TextControl and btn:TextControl()
	if tc and tc.SetText then
		tc:SetText(BTN_TEXT)
	end
end

local function set_check(self, key, on)
	local ck = self[key]
	if ck and ck.SetCheck then
		ck:SetCheck(on)
	end
	if self.ck_states then
		self.ck_states[key] = on
	end
end

local function lives_row_matches(row, want)
	if row == want or row == tostring(want) then
		return true
	end
	if type(row) == "table" then
		return row[1] == want or row[2] == want
			or row[1] == tostring(want) or row[2] == tostring(want)
	end
	return false
end

local function set_combo_idx(list, idx)
	local zero = idx - 1
	if list.SetCurrentIdx then
		list:SetCurrentIdx(zero)
	end
	-- SetCurrentIdx does not update the caption; use the item text, never tostring(row).
	if list.GetTextOf and list.SetText then
		local text = list:GetTextOf(zero)
		if text and text ~= "" then
			list:SetText(text)
		end
	end
end

-- Invictus still-possible at start: Story, not Warfare, Ironman, 2 lives.
-- Combo rows are often {id, n} tables; SetText(tostring(row)) shows "table: 0x…".
local function force_invictus(self)
	set_check(self, "ck_story", true)
	set_check(self, "ck_warfare", false)
	set_check(self, "ck_azazel_mode", false)
	set_check(self, "ck_hardcore", true)
	set_check(self, "ck_soulslike_mode", false)

	if self.LoadHardcoreLives then
		self:LoadHardcoreLives(false)
	end

	local t = self.table_hardcore_lives
	local list = self.list_hardcore_lives
	if not list then
		self.selected_hardcore_lives = LIVES
		return
	end

	local idx
	if t then
		for i = 1, #t do
			if lives_row_matches(t[i], LIVES) then
				idx = i
				break
			end
		end
	end
	if not idx and list.GetTextOf then
		local n = (list.GetSize and list:GetSize()) or (t and #t) or 0
		for i = 1, n do
			local text = list:GetTextOf(i - 1) or ""
			if string.find(text, tostring(LIVES), 1, true) then
				idx = i
				break
			end
		end
	end
	-- 1 life, 2 lives, … — index 2 is the 2-lives row when values are nested tables.
	idx = idx or LIVES
	set_combo_idx(list, idx)
	self.selected_hardcore_lives = LIVES
end

local function clear_purchases(self)
	if self.OnCheckResetList then
		self:OnCheckResetList()
	elseif self.LoadLoadout then
		self:LoadLoadout(false)
	end
end

-- Frame 2: rebuild spawn list for Story (stock LoadMap). Keep the user's pick.
local function apply_level(self)
	local keep = self.selected_map
	if self.LoadMap then
		self:LoadMap(false)
	end
	local t = self.table_map
	if not (keep and t and self.list_map) then
		return
	end
	for i = 1, #t do
		if t[i] == keep then
			self.selected_map = keep
			self.list_map:SetText(game.translate_string("ui_st_" .. keep))
			if self.UpdateMap then
				self:UpdateMap()
			end
			return
		end
	end
end

local function apply_opts(self)
	clear_purchases(self)
	force_invictus(self)
	force_hard_pick(self, "list_difficulty", "table_difficulty", "selected_difficulty")
	force_hard_pick(self, "list_economy", "table_economy", "selected_economy")
	write_flag()
	relabel(self)
end

local function on_dogma_mode(self)
	if STATE.phase then
		return
	end
	apply_opts(self)
	STATE.dlg = self
	STATE.phase = "level"
end

local function wrap_on_randomize(cls)
	if STATE.wrap_rand and cls.OnRandomize == STATE.wrap_rand then
		return true
	end
	local base = cls.OnRandomize
	if not base then
		return false
	end

	local function wrapped(self)
		on_dogma_mode(self)
	end

	cls.OnRandomize = wrapped
	STATE.wrap_rand = wrapped
	return true
end

local function wrap_update(cls)
	if STATE.wrap_update and cls.Update == STATE.wrap_update then
		return true
	end
	local base = cls.Update

	local function wrapped(self)
		if base then
			base(self)
		end
		if STATE.dlg ~= self then
			return
		end
		if STATE.phase == "level" then
			apply_level(self)
			STATE.phase = "start"
		elseif STATE.phase == "start" then
			STATE.phase = nil
			STATE.dlg = nil
			if self.OnStartGame then
				self:OnStartGame()
			end
		end
	end

	cls.Update = wrapped
	STATE.wrap_update = wrapped
	return true
end

local function wrap_main_controls(cls)
	if STATE.wrap_controls and cls.Main_Controls == STATE.wrap_controls then
		return true
	end
	local base = cls.Main_Controls
	if not base then
		return false
	end

	local function wrapped(self, ...)
		local r = base(self, ...)
		wrap_on_randomize(cls)
		relabel(self)
		return r
	end

	cls.Main_Controls = wrapped
	STATE.wrap_controls = wrapped
	return true
end

local function patch_new_game()
	STATE.phase = nil
	STATE.dlg = nil
	local cls = ui_mm_faction_select and ui_mm_faction_select.UINewGame
	if not cls then
		return false
	end
	local ok = wrap_on_randomize(cls)
	wrap_main_controls(cls)
	wrap_update(cls)
	return ok
end

_G.dogma_game_dogma_mode_conf = {
	MOD_ID = MOD_ID,
	DEFAULTS = {},
	loaded = {},
	flag_path = flag_path,
	write_flag = write_flag,
	clear_flag = clear_flag,
	patch_new_game = patch_new_game,
}

local CONFIG = _G.dogma_game_dogma_mode_conf

CONFIG.patch_new_game()
RegisterScriptCallback("main_menu_on_init", CONFIG.patch_new_game)

function on_mcm_load(options)
	CONFIG.patch_new_game()

	dogma_mcm.attach(options, "game", "ui_mcm_menu_dogma_game", {
		id = "dogma_mode",
		sh = true,
		text = "ui_mcm_menu_dogma_game_dogma_mode",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_game_dogma_mode_page_description",
			},
		}),
	})
end
