{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "env": {
            "DOGMA_DEPLOY": "C:/GAMMA/mods/DOGMA"
        }
    },
    "tasks": [
        {
            "label": "DOGMA: Build",
            "type": "shell",
            "command": "dev/build.sh",
            "options": {
                "env": {
                    "DOGMA_DEPLOY": "C:/GAMMA/mods/DOGMA",
                    "DOGMA_SKIP_FOMOD": "1"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true,
                "close": false,
                "showReuseMessage": false
            },
            "problemMatcher": {
                "owner": "dogma-build",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "."
                }
            }
        },
        {
            "label": "DOGMA: Build FOMOD",
            "type": "shell",
            "command": "dev/build.sh",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true,
                "close": false,
                "showReuseMessage": false
            },
            "problemMatcher": {
                "owner": "dogma-build-fomod",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "."
                }
            }
        }
    ]
}
