			id = "wads_keys_header",
			type = "title",
			text = "ui_mcm_dorn_free_zoom_wads_keys_header",
		},
		{
			id = "wads_inc_key",
			type = "key_bind",
			val = 2,
			def = -1,
			hint = "dorn_free_zoom_wads_inc_key",
		},
		{
			id = "wads_dec_key",
			type = "key_bind",
			val = 2,
			def = -1,
			hint = "dorn_free_zoom_wads_dec_key",
		},
		{
			id = "wads_reset_key",
			type = "key_bind",
			val = 2,
			def = -1,
			hint = "dorn_free_zoom_wads_reset_key",
