; Cat: Larkin names the run `stand_run_fwd_0`; the model uses vanilla `stand_run_0`,
; so sprint played no steps. Same timings, louder power so the paw bank carries.
; AOM chase is `stand_run_attack_0`, not `stand_run_fwd_0`.
; Jump pack is `run_jamp_0/1/2`. Larkin never listed them.
@[cat_step_params]
stand_walk_fwd_0        =   3,   0.70,    1.6,    0.25,    1.2,    0.90,    1.6,    0.40,    1.6
stand_walk_dmg_0        =   3,   0.80,    1.6,    0.25,    1.2,    0.70,    1.6,    0.20,    0.8
stand_run_0             =   1,   0.97,    1.6,    0.25,    1.2,    0.50,    1.6,    0.40,    1.6
stand_run_fwd_0         =   1,   0.97,    1.6,    0.25,    1.2,    0.50,    1.6,    0.40,    1.6
stand_run_attack_0      =   1,   0.97,    1.6,    0.25,    1.2,    0.50,    1.6,    0.40,    1.6
stand_run_dmg_0         =   4,   0.50,    1.6,    0.20,    1.2,    0.50,    1.6,    0.70,    0.0
run_jamp_0              =   1,   0.01,    1.6,    0.25,    1.2,    0.50,    1.6,    0.40,    1.6
run_jamp_1              =   1,   0.01,    1.6,    0.25,    1.2,    0.50,    1.6,    0.40,    1.6
run_jamp_2              =   1,   0.01,    1.6,    0.25,    1.2,    0.50,    1.6,    0.40,    1.6

; Chimera: vanilla walk is `stand_walk_0`; Larkin only has `stand_walk_fwd_0`.
; Fewer cycles so the chimera bank does not machine-gun.
