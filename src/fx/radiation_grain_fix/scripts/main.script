--[[
	Radiation Grain Fix

	Replaces stock radiation.ppe with a no-op so zone/location radiation postprocesses
	draw nothing. This script applies our own graded grain PPEs from player body
	radiation (db.actor.radiation).
]]

local MOD_ID = "dogma/grain_fix"

local DOGMA

local PP_GRAIN_ID = 2021
local PP_BLUR_ID = 2023
local PP_DUAL_ID = 2024

local GRAIN_PPES = {
	"dogma_grain_01.ppe",
	"dogma_grain_02.ppe",
	"dogma_grain_03.ppe",
	"dogma_grain_04.ppe",
	"dogma_grain_05.ppe",
	"dogma_grain_06.ppe",
	"dogma_grain_07.ppe",
	"dogma_grain_08.ppe",
	"dogma_grain_09.ppe",
	"dogma_grain_10.ppe",
}

local CONFIG = {}
local GRAIN_LEVELS = {}
local current_ppe = nil
local blur_active = false
local dual_active = false

local LOG = {
	LIFECYCLE = {order = 0, color = "gray"},
	RADS      = {order = 1, color = "green"},
	MSV       = {order = 2, color = "yellow"},
	GRAIN     = {order = 3, color = "orange"},
	BLUR      = {order = 4, color = "cyan"},
	DUAL      = {order = 5, color = "purple"},
}

-- HUD-only: for values that change every frame (Rads/MSV/Grain/Blur/Dual).
local function overlay(log_type, msg)
	if not DOGMA.dbg then
		return
	end
	if CONFIG.debug_overlay then
		local slot = log_type or LOG.LIFECYCLE
		DOGMA.dbg.overlay(MOD_ID, slot.order, tostring(msg), slot.color)
	end
end

-- File-only: for one-off/lifecycle events worth keeping in the log.
local function log(msg)
	if not DOGMA.dbg then
		return
	end
	if CONFIG.debug_log then
		DOGMA.dbg.log(MOD_ID, tostring(msg))
	end
end

local function on_option_change()
	CONFIG.debug_log = DOGMA.mcm.bool(MOD_ID, "development/debug_log", false)
	CONFIG.debug_overlay = DOGMA.mcm.bool(MOD_ID, "development/debug_overlay", false)
	CONFIG.grain_enabled = DOGMA.mcm.bool(MOD_ID, "grain/enable", true)
	CONFIG.blur_enabled = DOGMA.mcm.bool(MOD_ID, "desaturation/enable", true)
	CONFIG.dual_enabled = DOGMA.mcm.bool(MOD_ID, "duality/enable", true)
	CONFIG.level_msv = {}
	CONFIG.level_msv[1] = DOGMA.mcm.number(MOD_ID, "grain/level_01_msv", 50)
	CONFIG.level_msv[2] = DOGMA.mcm.number(MOD_ID, "grain/level_02_msv", 100)
	CONFIG.level_msv[3] = DOGMA.mcm.number(MOD_ID, "grain/level_03_msv", 150)
	CONFIG.level_msv[4] = DOGMA.mcm.number(MOD_ID, "grain/level_04_msv", 250)
	CONFIG.level_msv[5] = DOGMA.mcm.number(MOD_ID, "grain/level_05_msv", 350)
	CONFIG.level_msv[6] = DOGMA.mcm.number(MOD_ID, "grain/level_06_msv", 450)
	CONFIG.level_msv[7] = DOGMA.mcm.number(MOD_ID, "grain/level_07_msv", 550)
	CONFIG.level_msv[8] = DOGMA.mcm.number(MOD_ID, "grain/level_08_msv", 700)
	CONFIG.level_msv[9] = DOGMA.mcm.number(MOD_ID, "grain/level_09_msv", 850)
	CONFIG.level_msv[10] = DOGMA.mcm.number(MOD_ID, "grain/level_10_msv", 1000)
	CONFIG.blur_range = DOGMA.mcm.range(MOD_ID, "desaturation/blur_min", "desaturation/blur_max", 500, 2000)
	CONFIG.dual_range = DOGMA.mcm.range(MOD_ID, "duality/dual_min", "duality/dual_max", 1000, 2000)
	CONFIG.add_radiation_key = DOGMA.mcm.key(MOD_ID, "development/add_radiation_key")
	CONFIG.clear_radiation_key = DOGMA.mcm.key(MOD_ID, "development/clear_radiation_key")

	GRAIN_LEVELS = {}
	for i, ppe in ipairs(GRAIN_PPES) do
		GRAIN_LEVELS[#GRAIN_LEVELS+1] = { msv = CONFIG.level_msv[i], ppe = ppe }
	end

	DOGMA.dbg.set_enabled(MOD_ID, CONFIG.debug_overlay)
end

local function set_grain(msv)
	if not CONFIG.grain_enabled then
		if current_ppe then
			level.remove_pp_effector(PP_GRAIN_ID)
			current_ppe = nil
		end
		overlay(LOG.GRAIN, "Grain: 0")
		return
	end

	local ppe = nil
	local tier = 0
	for i = #GRAIN_LEVELS, 1, -1 do
		local level = GRAIN_LEVELS[i]
		if msv >= level.msv then
			ppe = level.ppe
			tier = i
			break
		end
	end

	overlay(LOG.GRAIN, string.format("Grain: %d", tier))

	-- no change?
	if ppe == current_ppe then
		return
	end

	-- want no grain?
	if ppe == nil and current_ppe then
		level.remove_pp_effector(PP_GRAIN_ID)
		current_ppe = nil
		return
	end

	-- replace grain
	if ppe then
		if current_ppe then
			level.remove_pp_effector(PP_GRAIN_ID)
		end
		level.add_pp_effector(ppe, PP_GRAIN_ID, true)
		current_ppe = ppe
	end
end

local function set_blur(msv)
	if not CONFIG.blur_enabled then
		if blur_active then
			level.remove_pp_effector(PP_BLUR_ID)
			blur_active = false
		end
		overlay(LOG.BLUR, "Blur: 0")
		return
	end

	local intensity = CONFIG.blur_range:normalize(msv)
	overlay(LOG.BLUR, string.format("Blur: %.2f", intensity))

	if intensity == 0 then
		if blur_active then
			level.remove_pp_effector(PP_BLUR_ID)
			blur_active = false
		end
		return
	end

	if not blur_active then
		level.add_pp_effector("dogma_blur.ppe", PP_BLUR_ID, true)
		blur_active = true
	end

	level.set_pp_effector_factor(PP_BLUR_ID, intensity)
end

local function set_dual(msv)
	if not CONFIG.dual_enabled then
		if dual_active then
			level.remove_pp_effector(PP_DUAL_ID)
			dual_active = false
		end
		overlay(LOG.DUAL, "Dual: 0")
		return
	end

	local intensity = CONFIG.dual_range:normalize(msv)
	overlay(LOG.DUAL, string.format("Dual: %.2f", intensity))

	if intensity == 0 then
		if dual_active then
			level.remove_pp_effector(PP_DUAL_ID)
			dual_active = false
		end
		return
	end

	if not dual_active then
		level.add_pp_effector("dogma_dual.ppe", PP_DUAL_ID, true)
		dual_active = true
	end

	level.set_pp_effector_factor(PP_DUAL_ID, intensity)
end

local function on_actor_on_update()
	local _, actor = DOGMA.sys.ready(MOD_ID, db, on_option_change)
	if not actor then
		return
	end

	if not actor:alive() then
		level.remove_pp_effector(PP_GRAIN_ID)
		level.remove_pp_effector(PP_BLUR_ID)
		level.remove_pp_effector(PP_DUAL_ID)
		current_ppe = nil
		blur_active = false
		dual_active = false
		return
	end

	local radiation = actor.radiation or 0
	local msv = radiation * 10000 * 0.387

	overlay(LOG.RADS, string.format("Rads: %.2f", radiation))
	overlay(LOG.MSV, string.format("MSV: %d", math.ceil(msv)))

	set_grain(msv)
	set_blur(msv)
	set_dual(msv)
end

local function on_key_press(key)
	if CONFIG.add_radiation_key and key == CONFIG.add_radiation_key and db.actor then
		db.actor.radiation = (db.actor.radiation or 0) + 50 / (10000 * 0.387)
	elseif CONFIG.clear_radiation_key and key == CONFIG.clear_radiation_key and db.actor then
		db.actor.radiation = 0
	end
end

function on_game_start()
	DOGMA = _G.dogma_common.load(MOD_ID)

	current_ppe = nil
	blur_active = false
	dual_active = false
	RegisterScriptCallback("actor_on_update", on_actor_on_update)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("on_key_press", on_key_press)
	log("loaded")
end
