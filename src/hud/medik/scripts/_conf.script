-- hud/medik conf
-- Remaps Medik's booster icon+digit row to rad/bleed vitals (6 slots, 2x3).

_G.dogma_hud_medik_conf = {
	MOD_ID = "dogma/hud/medik",
	DEFAULTS = {},

	-- Medik atlas L→R (1-based): 1 hp, 2 bleed, 3 rad, 4 carry, 5 power, 6 ext_rad, 7 psi, 8 chem
	SLOT_TEX = {
		"bo_hp",
		"bo_bleed",
		"bo_rad",
		"bo_carry",
		"bo_power",
		"bo_ext_rad",
		"bo_psi",
		"bo_chem",
	},

	-- Visible slots (2x3). `tex` = atlas index. `fmt`: int | pct
	-- `tint`: nil = always white glyph; "rad"/"bleed" = white→green/red by value.
	SLOTS = {
		-- row 1
		{ id = "rad_dose", tex = 3, fmt = "int", tint = "rad", tint_max = 999 },
		{ id = "rad_restore", tex = 3, fmt = "int" },
		{ id = "rad_protect", tex = 6, fmt = "pct" },
		-- row 2
		{ id = "bleed", tex = 2, fmt = "int", tint = "bleed", tint_max = 999 },
		{ id = "bleed_restore", tex = 2, fmt = "int" },
		{ id = "bleed_protect", tex = 2, fmt = "pct" },
	},

	-- HUD rad-icon mSv scale (G_FLAT Msv Above Radiation Icon / item_device tip).
	MSV_K = 10000 * 0.387,

	-- Medik layout constants (medik_ui UIMedik:__init)
	LAYOUT = {
		BO_X0 = 0.02270,
		BO_COLW = 0.011185,
		ICON_WH = 0.009,
		DIG_W = 0.0022,
		DIG_H = 0.0032,
		ICON_Y0 = 0.04438,
		ROW_PITCH = 0.0130,
		DIG_GAP = 0.0006,
		COLS = 3,
	},
}
