#include "common.h"
#include "sload.h"

f_deffer main(p_flat I)
{
	float3 D = tbase(I.tcdh);
	D.g = saturate(D.g + D.b);
	D.b = 0;

	float3 Ne = normalize((float3)I.N.xyz);
	float h = I.position.w;
	float ms = xmaterial;
#ifdef USE_R2_STATIC_SUN
	ms = I.tcdh.w;
#endif

	return pack_gbuffer(
		float4(Ne, h),
		float4(I.position.xyz + Ne * def_virtualh / 2.h, ms),
		float4(D, def_gloss));
}
