-- game/death_report conf
-- panel_width: UI-px (1024-wide hud). Default 400.
-- panel_top: UI-px from top of screen. Title sits here; report is under it.
-- hit_cap: recent hits kept (1-20).
-- dot_seconds: bleed/rad/other DoT window (0 = hide that section).
-- preview: show the report while alive (layout / tracking test).

_G.dogma_game_death_report_conf = {
	MOD_ID = "dogma/game/death_report",
	DEFAULTS = {
		enabled = true,
		panel_width = 400,
		panel_top = 250,
		hit_cap = 10,
		dot_seconds = 5,
		preview = false,
	},
	loaded = {
		debug_log = true,
	},
}

function on_mcm_load(options)
	local CONFIG = _G.dogma_game_death_report_conf
	dogma_mcm.attach(options, "game", "ui_mcm_menu_dogma_game", {
		id = "death_report",
		sh = true,
		text = "ui_mcm_menu_dogma_game_death_report",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_game_death_report_page_description",
			},
			{
				id = "enabled",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.enabled,
				hint = "dogma_game_death_report_enabled",
			},
			{
				id = "panel_width",
				type = "track",
				val = 2,
				min = 200,
				max = 1024,
				step = 10,
				def = CONFIG.DEFAULTS.panel_width,
				hint = "dogma_game_death_report_panel_width",
			},
			{
				id = "panel_top",
				type = "track",
				val = 2,
				min = 0,
				max = 700,
				step = 10,
				def = CONFIG.DEFAULTS.panel_top,
				hint = "dogma_game_death_report_panel_top",
			},
			{
				id = "hit_cap",
				type = "track",
				val = 2,
				min = 1,
				max = 20,
				step = 1,
				def = CONFIG.DEFAULTS.hit_cap,
				hint = "dogma_game_death_report_hit_cap",
			},
			{
				id = "dot_seconds",
				type = "track",
				val = 2,
				min = 0,
				max = 10,
				step = 1,
				def = CONFIG.DEFAULTS.dot_seconds,
				hint = "dogma_game_death_report_dot_seconds",
			},
			{
				id = "preview",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.preview,
				hint = "dogma_game_death_report_preview",
			},
		}),
	})
end
