--[[
	Minimap

	Keybind show/hide for the HUD minimap (video/hud/show_minimap + UIZoneMap).
	Toggle: flip visibility. Hold: visible only while the key is down.
	Based on RavenAscendant Mini Map Toggle, with hold-to-show.

	Hold uses press/release latch (like hud/fps) plus key_state / on_key_hold
	recovery. Spurious on_key_release (common when a dialog steals focus) is
	ignored while key_state still reports down, so show_delay_ms can elapse.

	While the user wants the map on, we re-assert every update: option flag,
	UIZoneMap.disabled, motion icon, hud_draw, and show_indicators so dialogs /
	Hide HUD / scopes that clear indicators cannot leave it stuck off. Option
	disk writes only happen when the stored value actually changes.

	show_delay_ms: wait after press/hold before showing (hide is immediate).
]]

local CONFIG = _G.dogma_hud_minimap_conf
local DOGMA

local MODE_TOGGLE = 0
local MODE_HOLD = 2

-- Hold: latched from press/release (key_state alone is unreliable with dialogs).
local holding = false
-- True once key_state reported down during this hold (missed-release recovery).
local seen_key_down = false
-- Continual-ms when the current show request started (hold down / toggle-on).
local show_request_at = nil
-- Toggle mode: waiting to show after delay.
local pending_toggle_show = false
-- Source of truth: user wants the map visible (independent of option / UI).
local desired_show = false
-- Debounce spurious press/release pairs.
local press_at_ms = nil

local function log(msg)
	if not (DOGMA and DOGMA.dbg) then
		return
	end
	if DOGMA.dbg.logging and DOGMA.dbg.logging() then
		DOGMA.dbg.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function now_ms()
	if time_continual then
		return time_continual()
	end
	if time_global then
		return time_global()
	end
	return 0
end

local function mod_ok()
	local modifier = CONFIG.loaded.modifier
	if not modifier or modifier == 0 then
		return true
	end
	if not (ui_mcm and ui_mcm.get_mod_key) then
		return true
	end
	return ui_mcm.get_mod_key(modifier)
end

local function maingame()
	return ActorMenu and ActorMenu.get_maingame and ActorMenu.get_maingame()
end

local function key_is_down(dik)
	return dik and dik > 0 and key_state and (key_state(dik) or 0) ~= 0
end

local function option_shown()
	if not (ui_options and ui_options.get) then
		return false
	end
	local v = ui_options.get("video/hud/show_minimap")
	-- Config may be bool or 0/1; only nil/false/0 count as off.
	return v ~= nil and v ~= false and v ~= 0
end

local function ui_minimap_enabled()
	local ui = maingame()
	if ui and ui.UIZoneMap then
		return not ui.UIZoneMap.disabled
	end
	return option_shown()
end

local function delay_ms()
	local d = CONFIG.loaded.show_delay_ms
	if type(d) ~= "number" or d < 0 then
		return 0
	end
	return d
end

local function delay_elapsed()
	if not show_request_at then
		return true
	end
	local d = delay_ms()
	if d <= 0 then
		return true
	end
	return (now_ms() - show_request_at) >= d
end

local function force_hud_draw()
	-- MainIngameWnd draw also needs HUD_DRAW (console hud_draw).
	if get_console_cmd and not get_console_cmd(1, "hud_draw") then
		if exec_console_cmd then
			exec_console_cmd("hud_draw 1")
		elseif get_console then
			local c = get_console()
			if c and c.execute then
				c:execute("hud_draw 1")
			end
		end
	end
end

local function force_indicators()
	if level and level.show_indicators then
		level.show_indicators()
	end
	-- _g.script wrapper also clears related HUD-hide state.
	if show_indicators then
		show_indicators(true)
	end
end

-- Apply desired visibility. Cheap UI writes every call; option disk write only
-- on change. When showing, punch through indicator / hud_draw hides.
local function set_minimap(want_show)
	want_show = not not want_show

	if ui_options and ui_options.set then
		if option_shown() ~= want_show then
			ui_options.set("video/hud/show_minimap", want_show)
		end
	end

	local ui = maingame()
	if ui and ui.UIZoneMap then
		ui.UIZoneMap.disabled = not want_show
		-- visible is engine-readonly in bindings; try anyway (some builds allow it).
		pcall(function()
			ui.UIZoneMap.visible = want_show
		end)
		if ui.ShowZoneMap then
			pcall(function()
				ui:ShowZoneMap(want_show)
			end)
		end
		if want_show and ui.DrawZoneMap then
			pcall(function()
				ui:DrawZoneMap()
			end)
		end
		if ui.UIMotionIcon and ui.UIMotionIcon.Show then
			ui.UIMotionIcon:Show(want_show)
		end
	end

	if want_show then
		force_hud_draw()
		force_indicators()
	end
end

local function enforce_desired(source)
	if not desired_show then
		return
	end
	if not delay_elapsed() then
		return
	end
	set_minimap(true)
	if source and source ~= "tick" and source ~= "key_hold" then
		log(string.format("enforce show (%s)", source))
	end
end

local function begin_show_request(source)
	desired_show = true
	show_request_at = now_ms()
	if delay_elapsed() then
		set_minimap(true)
		log(string.format("show (%s)", source or "now"))
		return true
	end
	log(string.format("show pending %dms (%s)", delay_ms(), source or "delay"))
	return false
end

local function cancel_show_request()
	show_request_at = nil
	pending_toggle_show = false
end

local function hide_minimap(source)
	desired_show = false
	cancel_show_request()
	set_minimap(false)
	log(string.format("hide (%s)", source or "hide"))
end

local function toggle_minimap(source)
	if pending_toggle_show then
		hide_minimap(source or "cancel pending")
		return
	end
	if desired_show or ui_minimap_enabled() then
		hide_minimap(source or "toggle")
		return
	end
	pending_toggle_show = true
	if begin_show_request(source or "toggle") then
		pending_toggle_show = false
	end
end

local function tick_pending_toggle()
	if not pending_toggle_show then
		return
	end
	if delay_elapsed() then
		pending_toggle_show = false
		desired_show = true
		set_minimap(true)
		log("show (toggle delay)")
	end
end

-- Hold: press latches on; release latches off (ignored if key still down).
-- Tick / on_key_hold recover from missed press/release when dialogs steal focus.
local function sync_hold_visibility(source)
	if not (CONFIG.loaded.enabled and CONFIG.loaded.mode == MODE_HOLD) then
		return
	end
	local key = CONFIG.loaded.keybind
	if not key or key <= 0 then
		return
	end

	local state_down = key_is_down(key) and mod_ok()

	if source == "press" then
		if not mod_ok() then
			return
		end
		holding = true
		seen_key_down = state_down
		press_at_ms = now_ms()
		begin_show_request("press")
		return
	end

	if source == "release" then
		-- Spurious release while physically held (dialogs / input quirks).
		if state_down then
			log("ignore release (key still down)")
			return
		end
		holding = false
		seen_key_down = false
		press_at_ms = nil
		if desired_show then
			hide_minimap("release")
		end
		return
	end

	if source == "key_hold" then
		if not mod_ok() then
			return
		end
		holding = true
		seen_key_down = true
		if not desired_show then
			begin_show_request("key_hold")
		else
			enforce_desired("key_hold")
		end
		return
	end

	-- tick / opts / start: reconcile latch with key_state
	if state_down then
		seen_key_down = true
		if not holding then
			holding = true
			begin_show_request(source or "tick")
		else
			enforce_desired(source or "tick")
		end
	elseif holding then
		if seen_key_down then
			-- key_state was down, now up: missed real release.
			holding = false
			seen_key_down = false
			press_at_ms = nil
			hide_minimap(source or "tick")
		else
			-- Press-latched; key_state never confirmed - keep enforcing.
			enforce_desired(source or "tick")
		end
	elseif source ~= "tick" then
		desired_show = false
		set_minimap(false)
	end
end

local function on_option_change()
	local tostr = tostring
	if not DOGMA then
		return
	end
	local prev_mode = CONFIG.loaded.mode
	CONFIG.loaded.enabled = true
	CONFIG.loaded.keybind = DOGMA.mcm.key(CONFIG.MOD_ID, "keybind")
	CONFIG.loaded.modifier = DOGMA.mcm.number(CONFIG.MOD_ID, "modifier")
	CONFIG.loaded.mode = DOGMA.mcm.number(CONFIG.MOD_ID, "mode")
	CONFIG.loaded.show_delay_ms = DOGMA.mcm.number(CONFIG.MOD_ID, "show_delay_ms")
	if CONFIG.loaded.mode ~= MODE_HOLD then
		CONFIG.loaded.mode = MODE_TOGGLE
	end

	cancel_show_request()
	holding = false
	seen_key_down = false
	press_at_ms = nil
	desired_show = false
	if CONFIG.loaded.enabled and CONFIG.loaded.mode == MODE_HOLD then
		sync_hold_visibility("opts")
	end

	log(string.format(
		"opts: en=%s key=%s mod=%s mode=%s delay=%s (was %s)",
		tostr(CONFIG.loaded.enabled),
		tostr(CONFIG.loaded.keybind),
		tostr(CONFIG.loaded.modifier),
		tostr(CONFIG.loaded.mode),
		tostr(CONFIG.loaded.show_delay_ms),
		tostr(prev_mode)
	))
end

local function on_key_press(key)
	if not DOGMA or not DOGMA.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return
	end
	if not CONFIG.loaded.enabled then
		return
	end
	if not CONFIG.loaded.keybind or key ~= CONFIG.loaded.keybind then
		return
	end

	if CONFIG.loaded.mode == MODE_HOLD then
		sync_hold_visibility("press")
		return
	end

	if not mod_ok() then
		return
	end

	toggle_minimap("toggle")
end

local function on_key_release(key)
	if not CONFIG.loaded.enabled then
		return
	end
	if not CONFIG.loaded.keybind or key ~= CONFIG.loaded.keybind then
		return
	end
	if CONFIG.loaded.mode == MODE_HOLD then
		sync_hold_visibility("release")
	end
end

local function on_key_hold(key)
	if not CONFIG.loaded.enabled then
		return
	end
	if not CONFIG.loaded.keybind or key ~= CONFIG.loaded.keybind then
		return
	end
	if CONFIG.loaded.mode == MODE_HOLD then
		sync_hold_visibility("key_hold")
	end
end

local function actor_on_first_update()
	if not DOGMA or not DOGMA.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return
	end
	sync_hold_visibility("start")
end

local function actor_on_update()
	if not DOGMA or not DOGMA.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return
	end
	if CONFIG.loaded.mode == MODE_HOLD then
		sync_hold_visibility("tick")
	else
		tick_pending_toggle()
		enforce_desired("tick")
	end
end

function on_game_start()
	DOGMA = dogma_common.load(CONFIG.MOD_ID)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("on_key_press", on_key_press)
	RegisterScriptCallback("on_key_release", on_key_release)
	RegisterScriptCallback("on_key_hold", on_key_hold)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	log("on_game_start: callbacks registered")
end
