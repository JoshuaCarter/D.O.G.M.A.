--[[
    dogma.db layers on STALKER_DB.
    Ours: db/ext, SKIP (list only), prefix sub-cats, decorate aliases, craft remap.
    Callers keep dogma cat names (weapons_pistols, artifacts, ...).
    is/get: listed dump id, else one parent_section hop (addon variants).
]]

local EXT = "db\\ext\\"
local loaded = false
local sdb = nil
local by_id = {}
local listed = {}
local groups = {}
local in_group = {}
local EMPTY = {}
local list_sorted = {}
local recipes = {}
local by_name = {}
local name_miss = 0
local parent_of = {}
local SKIP = {
    ["wpn_addon_silencer"] = true,
    ["ammo_23_eco"] = true,
}

-- Dump gaps. Same cats as the real item. Strip/stash use list/is.
-- ied_rpg_new: live IED; dump only has unobtainable ied_rpg.
-- magnifier: Eotech magnifier lens; dump left it in materials (skipped).
local EXTRA = {
    { "ied_rpg_new", "explosives", "st_ied_rpg" },
    { "magnifier", "weapon_attach_scopes", "st_addon_scope_mag" },
}

-- site slug -> dogma cat name (same table)
local SITE = {
    { "pistols", "weapons_pistols" },
    { "smgs", "weapons_smgs" },
    { "rifles", "weapons_rifles" },
    { "snipers", "weapons_snipers" },
    { "shotguns", "weapons_shotguns" },
    { "melee", "weapons_melee" },
    { "launchers", "weapons_launchers" },
    { "scopes", "weapon_attach_scopes" },
    { "silencers", "weapon_attach_silencers" },
    { "grenade-launchers", "weapon_attach_gls" },
    { "tactical-kits", "weapon_upgrade_kits" },
    { "weapon-parts", "weapon_parts" },
    { "outfits", "armor_outfits" },
    { "helmets", "armor_helmets" },
    { "ammo", "ammo" },
    { "mutant-parts", "mutant_parts" },
    { "outfit-parts", "outfit_parts" },
    { "medicine", "medicine" },
    { "food", "food" },
    { "artefacts", "artifacts" },
    { "explosives", "explosives" },
    { "belt-attachments", "belt_attachments" },
    { "misc", "misc" },
}

local UNIONS = {
    weapons = {
        "weapons_pistols", "weapons_smgs", "weapons_rifles", "weapons_snipers",
        "weapons_shotguns", "weapons_melee", "weapons_launchers",
    },
    weapon_attach = {
        "weapon_attach_scopes",
        "weapon_attach_silencers",
        "weapon_attach_gls",
    },
    ["weapon-attach"] = {
        "weapon_attach_scopes",
        "weapon_attach_silencers",
        "weapon_attach_gls",
    },
    armor = { "armor_outfits", "armor_helmets" },
}

local function grab_sdb()
    if sdb then
        return true
    end
    if not (STALKER_DB and STALKER_DB.open) then
        printf("DOGMA.db: STALKER_DB missing")
        return false
    end
    sdb = STALKER_DB.open("dogma")
    if not sdb then
        printf("DOGMA.db: STALKER_DB.open failed")
        return false
    end
    return true
end

local try_read_path = function(getFS, rel)
    return getFS():update_path("$game_config$", rel)
end

local try_open = function(abs)
    return io.open(abs, "r")
end

local function read_text(rel)
    if not (getFS and getFS().update_path) then
        return nil
    end
    local ok, abs = pcall(try_read_path, getFS, rel)
    if not (ok and abs and abs ~= "") then
        return nil
    end
    local okf, f = pcall(try_open, abs)
    if not (okf and f) then
        return nil
    end
    local s = f:read("*a")
    f:close()
    if s and s ~= "" then
        return s
    end
    return nil
end

local function decode_ext(file)
    local text = read_text(EXT .. file)
    if not text then
        return nil
    end
    local ok, data = pcall(__dogma_json.decode, text)
    if ok then
        return data
    end
    printf("DOGMA.db: failed to decode ext %s", file)
    return nil
end

local function num(v)
    if v == nil or v == "" then
        return 0
    end
    if type(v) == "number" then
        return v
    end
    local s = tostring(v):gsub("%%$", "")
    return tonumber(s) or 0
end

local function decorate(row, typ)
    row.type = typ
    row.cost = num(row.st_upgr_cost)
    row.weight = num(row.st_prop_weight)
    local key = row.pda_encyclopedia_name or row.displayName
    local name = key and sdb.translate(key)
    if name and name ~= "" then
        row.name = name
    else
        row.name = row.id or ""
        if key then
            name_miss = name_miss + 1
        end
    end
    row.damage = num(row.ui_inv_damage)
    row.ap = num(row.st_data_export_ap)
    row.k_ap = num(row.st_data_export_k_ap)
    row.box = num(row.st_data_export_ammo_box_size)
    row.projectiles = num(row.st_data_export_projectiles)
    row.br = num(row.brClass)
    row.ballistic = num(row.ui_inv_outfit_fire_wound_protection)
    row.rad = num(row.ui_inv_outfit_radiation_protection)
    row.slots = num(row.ui_inv_outfit_artefact_count)
    row.carry = num(row.ui_inv_outfit_additional_weight)
    row.hit = num(row.st_data_export_hit_power)
    row.rof = num(row.ui_inv_rate_of_fire)
    row.mag = num(row.base_mag_size)
    row.recoil = num(row.ui_inv_recoil)
    row.accuracy = num(row.ui_inv_accuracy)
    row.handling = num(row.ui_inv_handling)
    row.zoom = num(row.st_data_export_zoom_factor)
    return row
end

local function remember_name(row)
    if row.displayName then
        by_name[row.displayName] = row.id
        by_name[string.lower(row.displayName)] = row.id
    end
    if row.pda_encyclopedia_name then
        by_name[row.pda_encyclopedia_name] = row.id
        by_name[string.lower(row.pda_encyclopedia_name)] = row.id
    end
end

local function add_row(typ, row)
    if not (row and row.id) then
        return
    end
    decorate(row, typ)
    remember_name(row)
    if not by_id[row.id] then
        by_id[row.id] = row
        listed[row.id] = true
    end
    local g = groups[typ]
    g[#g + 1] = row
end

local function take_site(slug, typ)
    groups[typ] = {}
    local src = sdb.list(slug)
    for i = 1, #src do
        add_row(typ, src[i])
    end
    if slug ~= typ then
        groups[slug] = groups[typ]
    end
end

local function concat(types)
    local out = {}
    for i = 1, #types do
        local g = groups[types[i]]
        if g then
            for j = 1, #g do
                out[#out + 1] = g[j]
            end
        end
    end
    return out
end

local function starts(id, pfx)
    return id:sub(1, #pfx) == pfx
end

local function build_subs()
    groups.weapon_cleaning_kits = {}
    groups.weapon_repair_kits = {}
    local misc = groups.misc or {}
    for i = 1, #misc do
        local row = misc[i]
        local id = row.id
        if starts(id, "cleaning_kit_") and id ~= "cleaning_kit_u" then
            groups.weapon_cleaning_kits[#groups.weapon_cleaning_kits + 1] = row
        elseif starts(id, "toolkit_") then
            groups.weapon_repair_kits[#groups.weapon_repair_kits + 1] = row
        end
    end
    groups.ammo_casings = {}
    groups.ammo_powder = {}
    groups.ammo_bullets = {}
    local parts = groups.ammo_parts or {}
    for i = 1, #parts do
        local row = parts[i]
        local id = row.id
        if starts(id, "casing_") then
            groups.ammo_casings[#groups.ammo_casings + 1] = row
        elseif starts(id, "powder_") then
            groups.ammo_powder[#groups.ammo_powder + 1] = row
        elseif starts(id, "bullet_") then
            groups.ammo_bullets[#groups.ammo_bullets + 1] = row
        end
    end
end

local function index_all()
    in_group = {}
    for typ, rows in pairs(groups) do
        local idx = {}
        for i = 1, #rows do
            local id = rows[i].id
            if id then
                idx[id] = true
            end
        end
        in_group[typ] = idx
    end
end

local function parse_amount(s)
    if type(s) == "number" then
        return math.floor(s)
    end
    local n = tostring(s or ""):match("(%d+)")
    return tonumber(n) or 0
end

local function load_recipes()
    recipes = {}
    local missed = 0
    local function remap(id)
        local rec = sdb.craft(id)
        local ings = rec and rec.ingredients
        if not ings then
            return
        end
        local parts = {}
        for i = 1, #ings do
            local ing = ings[i]
            local key = ing and ing.name
            local sec = key and (by_name[key] or by_name[string.lower(key)] or (by_id[key] and key))
            if sec then
                parts[#parts + 1] = { sec, parse_amount(ing.amount) }
            else
                missed = missed + 1
                printf("DOGMA.db: craft miss %s ingredient %s", id, tostring(key))
            end
        end
        recipes[id] = parts
    end
    local raw = sdb.json("craft-recipes.json")
    if type(raw) ~= "table" then
        printf("DOGMA.db: craft-recipes missing")
        return
    end
    for _, cat in pairs(raw) do
        local items = cat and cat.items
        if items then
            for i = 1, #items do
                local it = items[i]
                if it and it.id then
                    remap(it.id)
                end
            end
        end
    end
    if missed > 0 then
        printf("DOGMA.db: craft unmatched ingredients %s", missed)
    end
end

local function hide_skipped()
    if not next(SKIP) then
        return
    end
    local keys = {}
    for typ, rows in pairs(groups) do
        keys[#keys + 1] = { typ, rows }
    end
    local mapped = {}
    for i = 1, #keys do
        local rows = keys[i][2]
        if not mapped[rows] then
            local out = {}
            for j = 1, #rows do
                if not SKIP[rows[j].id] then
                    out[#out + 1] = rows[j]
                end
            end
            mapped[rows] = out
        end
    end
    for i = 1, #keys do
        groups[keys[i][1]] = mapped[keys[i][2]]
    end
end

local function load_all()
    if loaded then
        return
    end
    if not sdb then
        printf("DOGMA.db: STALKER_DB not open")
        return
    end
    loaded = true
    by_id = {}
    listed = {}
    parent_of = {}
    groups = {}
    recipes = {}
    by_name = {}
    name_miss = 0
    local n_site = 0
    for i = 1, #SITE do
        local slug, typ = SITE[i][1], SITE[i][2]
        take_site(slug, typ)
        n_site = n_site + #(groups[typ] or EMPTY)
    end
    for i = 1, #EXTRA do
        local id, typ, key = EXTRA[i][1], EXTRA[i][2], EXTRA[i][3]
        if not by_id[id] then
            add_row(typ, { id = id, displayName = key, pda_encyclopedia_name = key })
            printf("DOGMA.db: extra %s -> %s", id, typ)
        end
    end
    groups.ammo_parts = {}
    local ext = decode_ext("ammo-parts.json")
    local items = ext and ext.items
    if items then
        for j = 1, #items do
            add_row("ammo_parts", items[j])
        end
    else
        printf("DOGMA.db: ext ammo-parts missing")
    end
    for name, types in pairs(UNIONS) do
        groups[name] = concat(types)
    end
    build_subs()
    index_all()
    hide_skipped()
    load_recipes()
    printf("DOGMA.db: loaded %s site rows, %s ammo_parts, name_miss %s", n_site, #(groups.ammo_parts or EMPTY), name_miss)
end

function init()
    if not loaded and sdb then
        load_all()
    end
end

local try_parent = function(ini, sec)
    return ini:r_string_ex(sec, "parent_section")
end

local function ltx_parent(id)
    local hit = parent_of[id]
    if hit ~= nil then
        return hit or nil
    end
    if not ini_sys then
        return nil
    end
    local ok, p = pcall(try_parent, ini_sys, id)
    if ok and p and p ~= "" and p ~= id then
        parent_of[id] = p
        return p
    end
    parent_of[id] = false
    return nil
end

local function cmp(key, desc)
    return function(a, b)
        local va, vb = a[key], b[key]
        local na, nb = tonumber(va), tonumber(vb)
        if na and nb then
            va, vb = na, nb
        else
            va = tostring(va or "")
            vb = tostring(vb or "")
        end
        if va == vb then
            return false
        end
        if desc then
            return va > vb
        end
        return va < vb
    end
end

-- Dump section for this id. Listed children stay themselves (mp5k vs mp5).
-- Addon variants are not in the dump; hop parent_section once.
function catalog_id(id)
    init()
    if not id then
        return nil
    end
    if listed[id] then
        return id
    end
    local parent = ltx_parent(id)
    if parent and listed[parent] then
        return parent
    end
    return id
end

function get(id, typ)
    init()
    if not id then
        return nil
    end
    local key = catalog_id(id)
    local row = by_id[key]
    if not row then
        row = sdb and sdb.get(id)
        if row then
            decorate(row, row.type or "")
            remember_name(row)
            by_id[id] = row
            key = id
        end
    end
    if not row then
        return nil
    end
    if typ then
        local idx = in_group[typ]
        if not (idx and idx[key]) then
            return nil
        end
    end
    return row
end

function is(id, typ)
    init()
    if not (id and typ) then
        return false
    end
    local idx = in_group[typ]
    if not idx then
        return false
    end
    return idx[catalog_id(id)] == true
end

function is_any(id, types)
    if not (id and types) then
        return false
    end
    for i = 1, #types do
        if is(id, types[i]) then
            return true
        end
    end
    return false
end

function is_weapon(id) return is(id, "weapons") end
function is_pistol(id) return is(id, "weapons_pistols") end
function is_smg(id) return is(id, "weapons_smgs") end
function is_rifle(id) return is(id, "weapons_rifles") end
function is_sniper(id) return is(id, "weapons_snipers") end
function is_shotgun(id) return is(id, "weapons_shotguns") end
function is_melee(id) return is(id, "weapons_melee") end
function is_launcher(id) return is(id, "weapons_launchers") end
function is_attach(id) return is(id, "weapon_attach") end
function is_scope(id) return is(id, "weapon_attach_scopes") end
function is_silencer(id) return is(id, "weapon_attach_silencers") end
function is_gl(id) return is(id, "weapon_attach_gls") end
function is_upgrade_kit(id) return is(id, "weapon_upgrade_kits") end
function is_repair_kit(id) return is(id, "weapon_repair_kits") end
function is_cleaning_kit(id) return is(id, "weapon_cleaning_kits") end
function is_weapon_part(id) return is(id, "weapon_parts") end
function is_armor(id) return is(id, "armor") end
function is_outfit(id) return is(id, "armor_outfits") end
function is_helmet(id) return is(id, "armor_helmets") end
function is_ammo(id) return is(id, "ammo") end
-- OG-7B / VOG / M209. ammo.json projectiles=0. Not the explosives item cat.
function is_grenade_ammo(id)
    return is_ammo(id) and get(id).projectiles == 0
end
-- Workshop recipe in craft-recipes.json. Leftover calibers (4.6x30) are in
-- ammo.json but have no ingredients; do not spawn those.
function is_craft_ammo(id)
    local r = is_ammo(id) and craft(id)
    return r and #r > 0
end
function is_ammo_part(id) return is(id, "ammo_parts") end
function is_ammo_casing(id) return is(id, "ammo_casings") end
function is_ammo_powder(id) return is(id, "ammo_powder") end
function is_ammo_bullet(id) return is(id, "ammo_bullets") end
function is_medicine(id) return is(id, "medicine") end
function is_food(id) return is(id, "food") end
function is_artifact(id) return is(id, "artifacts") end
function is_explosive(id) return is(id, "explosives") end
function is_belt_attachment(id) return is(id, "belt_attachments") end
function is_misc(id) return is(id, "misc") end
function is_mutant_part(id) return is(id, "mutant_parts") end
function is_outfit_part(id) return is(id, "outfit_parts") end

function cost(id)
    local row = get(id)
    return (row and row.cost) or 0
end

function craft(id)
    init()
    return id and recipes[id] or nil
end

function list(typ, sort, dir)
    init()
    local src = typ and groups[typ]
    if not src then
        return EMPTY
    end
    if not sort then
        return src
    end
    local key = typ .. "\0" .. sort .. "\0" .. (dir or "")
    local hit = list_sorted[key]
    if hit then
        return hit
    end
    local out = {}
    for i = 1, #src do
        out[i] = src[i]
    end
    table.sort(out, cmp(sort, dir == "desc"))
    list_sorted[key] = out
    return out
end

local function wrap(typ)
    return function(sort, dir)
        return list(typ, sort, dir)
    end
end

weapons = wrap("weapons")
weapons_pistols = wrap("weapons_pistols")
weapons_smgs = wrap("weapons_smgs")
weapons_rifles = wrap("weapons_rifles")
weapons_snipers = wrap("weapons_snipers")
weapons_shotguns = wrap("weapons_shotguns")
weapons_melee = wrap("weapons_melee")
weapons_launchers = wrap("weapons_launchers")

weapon_attach = wrap("weapon_attach")
weapon_attach_scopes = wrap("weapon_attach_scopes")
weapon_attach_silencers = wrap("weapon_attach_silencers")
weapon_attach_gls = wrap("weapon_attach_gls")

weapon_upgrade_kits = wrap("weapon_upgrade_kits")
weapon_repair_kits = wrap("weapon_repair_kits")
weapon_cleaning_kits = wrap("weapon_cleaning_kits")
weapon_parts = wrap("weapon_parts")

armor = wrap("armor")
armor_outfits = wrap("armor_outfits")
armor_helmets = wrap("armor_helmets")

ammo = wrap("ammo")
ammo_parts = wrap("ammo_parts")
ammo_casings = wrap("ammo_casings")
ammo_powder = wrap("ammo_powder")
ammo_bullets = wrap("ammo_bullets")
mutant_parts = wrap("mutant_parts")
outfit_parts = wrap("outfit_parts")
medicine = wrap("medicine")
food = wrap("food")
artifacts = wrap("artifacts")
explosives = wrap("explosives")
belt_attachments = wrap("belt_attachments")
misc = wrap("misc")

function on_game_start()
    grab_sdb()
    load_all()
end

function on_game_load()
    grab_sdb()
    if not loaded then
        load_all()
    end
end
