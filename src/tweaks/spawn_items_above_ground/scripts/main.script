--[[
	Spawn items above ground

	After the level is live, new unparented items (crate loot) often register
	in the floor. Raise that server position by MCM metres (0 = off).
	Off during load / new game / map change so existing world loot is left alone.

	Online inventory spawns (stashes, NPCs, corpses) register with parent_id
	cleared; the owner is still sitting on that same point so we skip those.
]]

local CONFIG = _G.dogma_tweaks_spawn_items_above_ground_conf
local xconst = dogma.xlibs.xconst
local INVALID = xconst.INVALID_ENTITY_ID
local IsInvbox, IsStalker, IsMonster = IsInvbox, IsStalker, IsMonster

local live = false
-- 0.1m: engine copies owner pos exactly. Crate loot sits 0.3m above the crate.
local OWNER_R = 0.1
local owned = false

local function on_option_change()
	CONFIG.loaded.height = dogma.mcm.float(CONFIG.MOD_ID, "height", CONFIG.DEFAULTS.height)
end

local function arm()
	live = true
end

local function disarm()
	live = false
end

local try_server_object_on_register = function(se)
	return se:section_name()
end

local owner_clsid_anon = function(obj)
	return obj:clsid()
end

local function owner_near(obj)
	if owned then
		return
	end
	local ok, cls = pcall(owner_clsid_anon, obj)
	if ok and cls and (IsInvbox(nil, cls) or IsStalker(nil, cls) or IsMonster(nil, cls)) then
		owned = true
	end
end

local iterate_owners_anon = function(pos)
	level.iterate_nearest(pos, OWNER_R, owner_near)
end

local function world_item(sec)
	if dogma.db.ready() then
		return dogma.db.get(sec) ~= nil
	end
	-- No catalog: inventory items have inv_name. Zones and NPCs do not.
	if not (ini_sys and ini_sys.section_exist and ini_sys:section_exist(sec)) then
		return false
	end
	local inv = ini_sys:r_string_ex(sec, "inv_name")
	return inv ~= nil and inv ~= ""
end

local function server_object_on_register(se)
	local h = CONFIG.loaded.height
	if not (live and se and h and h > 0) then
		return
	end
	-- parent_id 0 is the actor; only 65535 means world
	if se.parent_id ~= INVALID then
		return
	end
	local ok, sec = pcall(try_server_object_on_register, se)
	if not (ok and sec and world_item(sec)) then
		return
	end
	local p = se.position
	if not p then
		return
	end
	owned = false
	pcall(iterate_owners_anon, p)
	if owned then
		return
	end
	local bx, by, bz = p.x, p.y, p.z
	se.position = vector():set(bx, by + h, bz)
	if dogma.log.logging() then
		local row = dogma.db.get(sec)
		local name = (row and row.name) or sec
		dogma.log.log(CONFIG.MOD_ID, string.format(
			"%s  (%.2f, %.2f, %.2f) -> (%.2f, %.2f, %.2f)",
			name, bx, by, bz, bx, by + h, bz
		))
	end
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	on_option_change()
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("server_object_on_register", server_object_on_register)
	RegisterScriptCallback("actor_on_first_update", arm)
	RegisterScriptCallback("on_game_load", disarm)
	RegisterScriptCallback("on_level_changing", disarm)
	RegisterScriptCallback("main_menu_on_init", disarm)
	RegisterScriptCallback("actor_on_net_destroy", disarm)
end
