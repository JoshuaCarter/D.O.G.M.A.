function on_mcm_load(options)
	dogma_mcm.attach(options, "misc", "ui_mcm_menu_dogma_misc", {
		id = "remember_options",
		sh = true,
		text = "ui_mcm_menu_dogma_misc_remember_options",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_misc_remember_options_page_description",
			},
		}),
	})
end
