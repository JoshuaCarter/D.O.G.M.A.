--[[
	True Prone

	Prone (mcCrouch + mcAccel): play_cycle("dorn_prone") from stalker_smart_cover_animation.omf.
	Engine ID_Cycle FATALS on missing names - pcall does not catch that.
	Torch: camera-locked via mod_system_dogma_true_prone.ltx (torch_inertion = false).
]]

local CONFIG = _G.dogma_gameplay_true_prone_conf

local POSTURES = {
	STAND 	= "stand",
	CROUCH 	= "crouch",
	PRONE 	= "prone",
}

local LOG = {
	LIFECYCLE 		= {order = 0, color = "gray"},
	HEIGHT 			= {order = 1, color = "cyan"},
	HEIGHT_POSTURE 	= {order = 2, color = "blue"},
	INPUT_POSTURE 	= {order = 3, color = "yellow"},
	CROUCH 			= {order = 7, color = "dark_orange"},
	ACCEL 			= {order = 8, color = "dark_orange"},
	ANIM 			= {order = 9, color = "light_pink"},
}

local is_prone = nil
local set_prone_bones_visible
-- Lazy: get_console() can be nil while scripts load.
local blend_move_anims = false

local function console_bool(key)
	local c = get_console and get_console()
	return c and c.get_bool and c:get_bool(key) or false
end

local function console_exec(cmd)
	local c = get_console and get_console()
	if c and c.execute then
		c:execute(cmd)
	end
end

-- HUD-only: for values that change every frame (height/posture/crouch/slow/motion).
local function overlay(log_type, msg)
	if CONFIG.loaded.debug_overlay then
		local slot = log_type or LOG.LIFECYCLE
		dogma.dbg.overlay(CONFIG.MOD_ID, slot.order, tostring(msg), slot.color)
	end
end

-- File-only: for one-off/lifecycle and state-transition events worth keeping in the log.
local function log(msg)
	if CONFIG.loaded.debug_log then
		dogma.dbg.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function on_option_change()
	CONFIG.loaded.enabled = true
	CONFIG.loaded.debug_log = dogma.dbg.logging()
	CONFIG.loaded.debug_overlay = dogma.dbg.overlay_enabled()
	CONFIG.loaded.hide_prone_bones = dogma.mcm.bool(CONFIG.MOD_ID, "hide_prone_bones")
	CONFIG.loaded.prone_damage_mult = dogma.mcm.float(CONFIG.MOD_ID, "prone_damage_mult")
	blend_move_anims = console_bool("blend_move_anims")
	dogma.dbg.set_enabled(CONFIG.MOD_ID, dogma.dbg.overlay_enabled())

	local actor = dogma.sys.ready(CONFIG.MOD_ID, db)
	if actor and actor:alive() then
		if CONFIG.loaded.hide_prone_bones then
			set_prone_bones_visible(actor, not is_prone)
		else
			set_prone_bones_visible(actor, true)
		end
	end
end

set_prone_bones_visible = function(actor, visible)
	if visible then
		log("bones: shown")
	else
		log("bones: hidden")
	end

	pcall(function()
		actor:set_bone_visible("bip01_l_thigh", visible, true, false)
	end)
	pcall(function()
		actor:set_bone_visible("bip01_r_thigh", visible, true, false)
	end)
	pcall(function()
		actor:set_bone_visible("bip01_l_upperarm", visible, true, false)
	end)
	pcall(function()
		actor:set_bone_visible("bip01_r_upperarm", visible, true, false)
	end)
end

local function play_motion(actor, motion, mix_in)
	overlay(LOG.ANIM, "Motion: " .. tostring(motion))
	local ok = pcall(function()
		actor:play_cycle(motion, mix_in)
	end)
	if not ok then
		log("play_cycle failed: " .. tostring(motion))
	end
	return ok
end

local function on_actor_on_update()
	local tostr = tostring
	local actor = dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change)
	if not actor then
		return
	end
	if not CONFIG.loaded.enabled then
		return
	end

	dogma.perf.start("true_prone", "actor_on_update")
	-- nearest posture from camera height (feet to cam)
	local ok, height = pcall(function()
		return device().cam_pos.y - actor:position().y
	end)
	if not ok or not height then
		height = CONFIG.loaded.cam_height_stand
	end
	overlay(LOG.HEIGHT, string.format("cam height: %.2f", height))

	local stand_dist = math.abs(CONFIG.loaded.cam_height_stand - height)
	local crouch_dist = math.abs(CONFIG.loaded.cam_height_crouch - height)
	local prone_dist = math.abs(CONFIG.loaded.cam_height_prone - height)

	local camera_posture
	if stand_dist < crouch_dist and stand_dist < prone_dist then
		overlay(LOG.HEIGHT_POSTURE, "height posture: " .. tostr(POSTURES.STAND))
		camera_posture = POSTURES.STAND
	elseif crouch_dist < stand_dist and crouch_dist < prone_dist then
		overlay(LOG.HEIGHT_POSTURE, "height posture: " .. tostr(POSTURES.CROUCH))
		camera_posture = POSTURES.CROUCH
	else
		overlay(LOG.HEIGHT_POSTURE, "height posture: " .. tostr(POSTURES.PRONE))
		camera_posture = POSTURES.PRONE
	end

	-- input posture from move states
	local is_slow = IsMoveState("mcAccel")
	local is_crouching = IsMoveState("mcCrouch")
	overlay(LOG.CROUCH, "Crouch: " .. tostr(is_crouching))
	overlay(LOG.ACCEL, "Slow: " .. tostr(is_slow))

	local input_posture
	if not is_crouching then
		overlay(LOG.INPUT_POSTURE, "input posture: " .. tostr(POSTURES.STAND))
		input_posture = POSTURES.STAND
	elseif not is_slow then
		overlay(LOG.INPUT_POSTURE, "input posture: " .. tostr(POSTURES.CROUCH))
		input_posture = POSTURES.CROUCH
	else
		overlay(LOG.INPUT_POSTURE, "input posture: " .. tostr(POSTURES.PRONE))
		input_posture = POSTURES.PRONE
	end

	-- first update
	if is_prone == nil then
		is_prone = camera_posture == POSTURES.PRONE
		if is_prone then
			log("state: start prone")
			if blend_move_anims then
				console_exec("blend_move_anims off")
			end
		else
			log("state: start not prone")
			if blend_move_anims then
				console_exec("blend_move_anims on")
			end
		end
	end

	-- enter prone
	if camera_posture == POSTURES.PRONE then
		-- spam prone motion
		play_motion(actor, "dorn_prone", false)

		if not is_prone then
			log("state: enter prone")
			is_prone = true

			-- hide bones when camera is nearest the prone posture
			if CONFIG.loaded.hide_prone_bones then
				set_prone_bones_visible(actor, false)
			end

			-- disable 1st person player blend_move_anims
			if blend_move_anims then
				console_exec("blend_move_anims off")
			end
		end
	-- leave prone
	elseif is_prone then
		is_prone = false

		-- show bones and trigger new idle motion on leaving prone
		if CONFIG.loaded.hide_prone_bones then
			set_prone_bones_visible(actor, true)
		end
		if input_posture == POSTURES.STAND then
			log("state: standing")
			play_motion(actor, "norm_idle_0", true)
			play_motion(actor, "norm_torso_10_aim_0", true)
		elseif input_posture == POSTURES.CROUCH then
			log("state: crouching")
			play_motion(actor, "cr_idle_0", true)
			play_motion(actor, "cr_torso_10_aim_0", true)
		else
			log("state: input prone but cam not prone!")
			play_motion(actor, "cr_idle_0", false)
		end

		-- enable 1st person player blend_move_anims
		if blend_move_anims then
			console_exec("blend_move_anims on")
		end
	end
	dogma.perf.stop()
end

local function on_actor_on_before_hit(shit, bone_id, flags)
	if not dogma.sys.ready(CONFIG.MOD_ID, db) then
		return
	end
	if not CONFIG.loaded.enabled then
		return
	end
	if not is_prone or not shit or not shit.power or shit.power <= 0 then
		return
	end
	if CONFIG.loaded.prone_damage_mult <= 1 then
		return
	end

	local before = shit.power
	shit.power = before * CONFIG.loaded.prone_damage_mult
	log(string.format("damage: x%.2f: %.2f -> %.2f", CONFIG.loaded.prone_damage_mult, before, shit.power))
end

-- actor_on_update is skipped while dead; restore limbs here for death cam / corpse.
local function on_actor_on_before_death()
	local actor = db and db.actor
	if not actor then
		return
	end
	if CONFIG.loaded.hide_prone_bones then
		set_prone_bones_visible(actor, true)
	end
	if is_prone then
		log("state: died, restore bones")
		is_prone = false
		if blend_move_anims then
			console_exec("blend_move_anims on")
		end
	end
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	blend_move_anims = console_bool("blend_move_anims")

	is_prone = nil
	RegisterScriptCallback("actor_on_update", on_actor_on_update)
	RegisterScriptCallback("actor_on_before_hit", on_actor_on_before_hit)
	RegisterScriptCallback("actor_on_before_death", on_actor_on_before_death)
	RegisterScriptCallback("on_option_change", on_option_change)
	log("loaded")
end
