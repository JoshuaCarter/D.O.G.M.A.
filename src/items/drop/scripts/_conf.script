-- items/drop conf - shared loaded options for drop scripts.

local defaults = {
	["drop_safe_equipped"] = true,
	["key_drop"] = -1,
	["key_drop_mode"] = 2,
	["key_drop_modifier"] = 0,
}

_G.dogma_items_drop_conf = {
	MOD_ID = "dogma/items/drop",
	DEFAULTS = defaults,
	loaded = {
		drop_safe_equipped = defaults["drop_safe_equipped"],
	},
}

function _G.dogma_items_drop_conf:ensure_dogma()
	if not self.DOGMA then
		self.DOGMA = dogma_common.load(self.MOD_ID)
	end
	return self.DOGMA
end
