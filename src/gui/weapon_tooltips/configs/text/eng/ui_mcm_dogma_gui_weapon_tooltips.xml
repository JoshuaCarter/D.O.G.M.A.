	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_show_bullet_drop">
		<text>Show Bullet Drop Stat</text>
	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_show_bullet_drop_desc">
