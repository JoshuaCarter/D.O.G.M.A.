function on_mcm_load(options)
	local CONF = _G.dogma_items_favourites_conf
	local D = CONF.defaults
	dogma_mcm.attach(options, "items", "ui_mcm_menu_dogma_items", {
		id = "favourites",
		sh = true,
		text = "ui_mcm_menu_dogma_items_favourites",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_items_favourites_page_description",
			},
			{
				id = "enabled",
				type = "check",
				val = 1,
				def = D["enabled"],
				hint = "dogma_items_favourites_enabled",
			},
		}),
	})
end
