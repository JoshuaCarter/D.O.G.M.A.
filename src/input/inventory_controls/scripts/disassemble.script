--[[
	Inventory disassemble keybind (hold+hover).
	Stacked cells disassemble every item. Picker rows do the hovered item.
	Non-disassemble-able items are skipped. Sort/rebuild that fills the
	same cell is locked until the cursor moves.
]]

local CONFIG = _G.dogma_input_inventory_controls_conf
local MOD_ID = CONFIG.MOD_ID

local ALLOWED_BAGS = {
	actor_bag = true,
	actor_equ = true,
	actor_belt = true,
	npc_bag = true,
	picker = true,
}

local key = nil
local modifier = 0
local bind = nil

local function log(msg)
	if dogma.dbg.logging() then
		dogma.dbg.log(MOD_ID, tostring(msg))
	end
end

local function on_option_change()
	key = dogma.mcm.key(MOD_ID, "key_disa")
	modifier = dogma.mcm.int(MOD_ID, "key_disa_modifier", 0)
	if bind then
		_G.dogma_inv_hover.reset(bind)
	end
end

local function inv_mode_ok(gui)
	local mode = gui and gui.mode
	return mode == "inventory" or mode == "loot"
end

local function key_down()
	return key and dogma.input.is_key_down(key) and dogma.input.is_mod_down(modifier)
end

local function is_equipped(obj)
	if not (obj and db.actor and _G.SCANNED_SLOTS) then
		return false
	end
	local id = obj:id()
	local n = 0
	for _ in pairs(_G.SCANNED_SLOTS) do
		n = n + 1
	end
	for i = 0, n + 1 do
		local slot_obj = db.actor:item_in_slot(i)
		if slot_obj and slot_obj:id() == id then
			return true
		end
	end
	return false
end

local function do_disa(gui, obj)
	if is_equipped(obj) then
		return
	end
	if not (item_parts and item_parts.menu_disassembly and item_parts.func_disassembly) then
		return
	end
	if not item_parts.menu_disassembly(obj) then
		return
	end
	local id = obj:id()
	item_parts.func_disassembly(obj)
	-- Give-parts is a CreateTimeEvent (0s / 3s). Same-time events have
	-- undefined order, so wait a tick after that delay before rebuilding loot.
	if gui and gui.mode == "loot" then
		local delay = actor_effects.is_animations_on() and 3.05 or 0.05
		CreateTimeEvent("dogma_disa_loot", id, delay, function()
			local g = ui_inventory and ui_inventory.GUI
			if g and g.mode == "loot" and g.On_Item_Update then
				g:On_Item_Update()
			end
			return true
		end)
	end
end

local function fire(gui, obj, bag)
	local items = _G.dogma_inv_hover.stack_items(gui, obj, bag)
	for i = 1, #items do
		do_disa(gui, items[i])
	end
end

function on_game_start()
	dogma.load(MOD_ID)
	RegisterScriptCallback("on_option_change", on_option_change)
	on_option_change()
	bind = _G.dogma_inv_hover.register({
		key_down = key_down,
		mode_ok = inv_mode_ok,
		bags = ALLOWED_BAGS,
		still = true,
		fire = fire,
	})
	log("disassemble keys ready")
end
