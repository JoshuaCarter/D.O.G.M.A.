<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_gameplay">
		<text>Gameplay</text>
	</string>
	<string id="ui_mcm_menu_dogma_gameplay_pose_visibility">
		<text>Pose Visibility</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_pose_visibility_page_description">
		<text>Max visibility cap after Stealth_ runs its full formula. Actor step_incr clamped to min(Stealth result, NPC visibility threshold x pose cap). 0-1 per pose.</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_pose_visibility_cap_stand">
		<text>Cap: stand / walk / run / sprint</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_pose_visibility_cap_stand_desc">
		<text>Max fraction of per-NPC visibility threshold while standing. Default 1.0.</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_pose_visibility_cap_crouch">
		<text>Cap: crouch</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_pose_visibility_cap_crouch_desc">
		<text>Max fraction while crouching (not prone). Default 0.75.</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_pose_visibility_cap_prone">
		<text>Cap: prone</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_pose_visibility_cap_prone_desc">
		<text>Max fraction while prone (crouch + accel / True Prone). Default 0.50.</text>
	</string>
</string_table>
