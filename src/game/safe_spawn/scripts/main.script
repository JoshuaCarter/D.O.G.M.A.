--[[
	Safe Spawn

	Arms on the first actor update after a game load, and on the first
	update after Fair Fast Travel (the teleport has already moved the
	actor). Clears STYPE_VISIBLEFORAI on the actor so sight queries
	skip them, and puts the flag back when the grace ends. Hits that
	already landed are undone (actor_on_before_hit). Online companions
	are switched offline so mutants cannot aggro them either. Companion
	combat orders are never rewritten. When the grace ends they teleport
	near the actor (walkable verts, not stacked on the actor or each
	other).

	Ends after duration_sec of unpaused time, or when the actor moves or fires.
]]

local CONFIG = _G.dogma_game_safe_spawn_conf
local xsquad = dogma.xlibs.xsquad

local MOVE_M = 5
local MAX_DT_MS = 1000 -- a longer gap is a pause or a stall, not grace time
local AI_BIT = 8 -- STYPE_VISIBLEFORAI (1 << 3)
local PULL_MIN_M = 0.5
local PULL_RINGS = { 1, 2, 3 }
local PULL_XZ = {
	{ 1, 0 }, { 0.707, 0.707 }, { 0, 1 }, { -0.707, 0.707 },
	{ -1, 0 }, { -0.707, -0.707 }, { 0, -1 }, { 0.707, -0.707 },
}
local pull_dir = vector()
local HUD_STATIC = "dogma_game_safe_spawn_prompt"
local HUD_FMT = "st_dogma_game_safe_spawn_visible"

local active = false
local left_ms = 0
local pause_held = false
local origin = nil
local actor_id = nil
local quiet = {}
local hidden = {}
local shown_sec = nil
local arm_pending = false
local arm_why = nil
local logged_hit = false
local hud_fail_logged = false
local safe_hp = nil
local sight_off = false
local sight_fail = false

local hud_get_anon = function(get_hud)
	return get_hud()
end

local hud_cs_anon = function(hud, name)
	local cs = hud:GetCustomStatic(name)
	if not cs then
		hud:AddCustomStatic(name, true)
		cs = hud:GetCustomStatic(name)
	end
	return cs
end

local hud_wnd_anon = function(cs)
	return cs:wnd()
end

local hud_set_anon = function(wnd, text)
	if wnd.SetTextComplexMode then
		wnd:SetTextComplexMode(true)
	end
	local tc = wnd.TextControl and wnd:TextControl()
	if tc and tc.SetText then
		tc:SetText(text)
	elseif wnd.SetText then
		wnd:SetText(text)
	end
	if wnd.Show then
		wnd:Show(true)
	end
end

local hud_hide_anon = function(hud, name)
	if hud:GetCustomStatic(name) then
		hud:RemoveCustomStatic(name)
	end
end

local function world_hud()
	if not (db.actor and get_hud) then
		return nil
	end
	local ok, hud = pcall(hud_get_anon, get_hud)
	if ok and hud and hud.AddCustomStatic then
		return hud
	end
	return nil
end

local function hide_hud()
	if not shown_sec then
		return
	end
	shown_sec = nil
	local hud = world_hud()
	if hud and hud.GetCustomStatic then
		pcall(hud_hide_anon, hud, HUD_STATIC)
	end
end

local function show_hud(sec)
	local hud = world_hud()
	if not hud then
		if not hud_fail_logged then
			hud_fail_logged = true
			log("prompt skip no hud")
		end
		return
	end
	local cs = hud.GetCustomStatic and hud:GetCustomStatic(HUD_STATIC)
	if not cs then
		local ok
		ok, cs = pcall(hud_cs_anon, hud, HUD_STATIC)
		if not (ok and cs) then
			if not hud_fail_logged then
				hud_fail_logged = true
				log("prompt skip add fail")
			end
			return
		end
		shown_sec = nil
	end
	if shown_sec == sec then
		return
	end
	local wok, wnd = pcall(hud_wnd_anon, cs)
	if not (wok and wnd) then
		shown_sec = nil
		return
	end
	local fmt = game.translate_string(HUD_FMT)
	if not fmt or fmt == HUD_FMT then
		fmt = "Visible in %s"
	end
	local sok = pcall(hud_set_anon, wnd, string.format(fmt, tostring(sec)))
	if not sok then
		shown_sec = nil
		return
	end
	if not shown_sec then
		log("prompt on")
	end
	shown_sec = sec
end

local function update_hud()
	local left = left_ms
	if left < 0 then
		left = 0
	end
	local sec = math.ceil(left / 1000)
	if sec < 1 then
		hide_hud()
		return
	end
	show_hud(sec)
end

local function log(msg)
	if CONFIG.loaded.debug_log then
		dogma.log.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function on_option_change()
	CONFIG.loaded.debug_log = dogma.log.logging()
	CONFIG.loaded.enabled = dogma.mcm.bool(CONFIG.MOD_ID, "enabled", CONFIG.DEFAULTS.enabled)
	CONFIG.loaded.duration_sec = dogma.mcm.int(CONFIG.MOD_ID, "duration_sec", CONFIG.DEFAULTS.duration_sec)
end

local function clear_quiet()
	for id in pairs(quiet) do
		quiet[id] = nil
	end
end

local function refill_quiet()
	clear_quiet()
	local squads = axr_companions and axr_companions.companion_squads
	if not squads then
		return
	end
	for _, squad in pairs(squads) do
		for id in xsquad.iter_member_ids(squad) do
			quiet[id] = true
		end
	end
end

-- Flags alone do not despawn someone already online. switch_offline does.
local function hide_se(se, id)
	if not (se and se.online) then
		return
	end
	se:can_switch_online(false)
	se:can_switch_offline(true)
	if se.switch_offline then
		se:switch_offline()
	end
	hidden[id] = true
end

local function hide_companions()
	refill_quiet()
	local squads = axr_companions and axr_companions.companion_squads
	if not squads then
		return
	end
	for sid, squad in pairs(squads) do
		if type(sid) == "number" then
			hide_se(alife_object(sid), sid)
			for id in xsquad.iter_member_ids(squad) do
				hide_se(alife_object(id), id)
				if hidden[id] then
					hidden[sid] = true
				end
			end
		end
	end
end

local function copy_pos(pos)
	return vector():set(pos.x, pos.y, pos.z)
end

-- ponytail: 8-dir rings on navmesh; a one-vertex cell (doorway) still stacks. Upgrade: BFS neighbors.
local function pick_pull_spot(from_lvid, spots, used, slot)
	if not (level and level.vertex_in_direction) then
		return nil
	end
	local n = #PULL_XZ
	local start = (slot - 1) % n
	for r = 1, #PULL_RINGS do
		local dist = PULL_RINGS[r]
		for i = 0, n - 1 do
			local xz = PULL_XZ[(start + i) % n + 1]
			pull_dir:set(xz[1], 0, xz[2])
			local vid = level.vertex_in_direction(from_lvid, pull_dir, dist)
			if vid and not used[vid] then
				used[vid] = true
				local pos = level.vertex_position(vid)
				if pos then
					local close = false
					for s = 1, #spots do
						if pos:distance_to(spots[s]) < PULL_MIN_M then
							close = true
							break
						end
					end
					if not close then
						local p = copy_pos(pos)
						spots[#spots + 1] = p
						return p, vid
					end
				end
			end
		end
	end
	return nil
end

-- Restore flags on the whole roster (crash cannot leave can_switch_online false).
-- Never call switch_online ourselves: while hidden, LSS retries bringing the squad
-- online every tick and is only rejected by can_switch_online(false) (see the
-- "[LSS] Spawning object" spam during the grace window). The moment the flag flips
-- true, that in-flight LSS retry completes the spawn on its own; a manual
-- switch_online() here races it and can double-net_spawn the same id, which the
-- engine does not survive (net_spawn "Object with ID already exists" hard crash).
-- Hidden members teleport to nearby walkable verts (not the actor vertex).
local function show_companions()
	local squads = axr_companions and axr_companions.companion_squads
	local actor = db.actor
	if squads and actor and next(hidden) and TeleportObject then
		local pos = actor:position()
		local lvid = actor:level_vertex_id()
		local gvid = actor:game_vertex_id()
		local can = axr_companions.companion_squad_can_teleport
		if pos and lvid and gvid then
			local spots = { copy_pos(pos) }
			local used = { [lvid] = true }
			local slot = 0
			for sid, squad in pairs(squads) do
				if type(sid) == "number" and hidden[sid] and squad and squad.commander_id then
					if not can or can(squad) then
						TeleportObject(sid, pos, lvid, gvid)
						for id in xsquad.iter_member_ids(squad) do
							slot = slot + 1
							local p, v = pick_pull_spot(lvid, spots, used, slot)
							if not p then
								p, v = pos, lvid
							end
							TeleportObject(id, p, v, gvid)
						end
					end
				end
			end
		end
	end
	if squads then
		for sid, squad in pairs(squads) do
			if type(sid) == "number" then
				local se = alife_object(sid)
				if se then
					se:can_switch_online(true)
					se:can_switch_offline(true)
				end
			end
			for id in xsquad.iter_member_ids(squad) do
				local se = alife_object(id)
				if se then
					se:can_switch_online(true)
					se:can_switch_offline(true)
				end
			end
		end
	end
	for id in pairs(hidden) do
		hidden[id] = nil
	end
	clear_quiet()
end

local function ai_bit_on(t)
	return math.floor(t / AI_BIT) % 2 == 1
end

-- Vision frustum, stalker touch, and enemy selection all require this bit.
-- The rendered model is not what they test.
local function hide_from_ai(actor)
	if not (actor and actor.get_spatial_type and actor.set_spatial_type) then
		if actor and not sight_fail then
			sight_fail = true
			log("sight hide failed")
		end
		return
	end
	local t = actor:get_spatial_type()
	if type(t) ~= "number" or not ai_bit_on(t) then
		return
	end
	actor:set_spatial_type(t - AI_BIT)
	if not sight_off then
		sight_off = true
		log("hidden from sight")
	end
end

local function show_to_ai(actor)
	if not sight_off then
		return
	end
	sight_off = false
	if not (actor and actor.get_spatial_type and actor.set_spatial_type) then
		log("sight flag left off")
		return
	end
	local t = actor:get_spatial_type()
	if type(t) == "number" and not ai_bit_on(t) then
		actor:set_spatial_type(t + AI_BIT)
	end
	log("visible to sight")
end

local function stop(reason)
	if not active then
		hide_hud()
		show_companions()
		return
	end
	active = false
	show_to_ai(db.actor)
	left_ms = 0
	pause_held = false
	origin = nil
	actor_id = nil
	safe_hp = nil
	hide_hud()
	show_companions()
	log("off (" .. reason .. ")")
end

local function arm(why)
	local tostr = tostring
	local actor = dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change)
	if not (actor and actor:alive()) or not CONFIG.loaded.enabled then
		show_to_ai(actor)
		log("skip (" .. tostr(why) .. ")")
		return
	end
	local sec = CONFIG.loaded.duration_sec
	if not sec or sec <= 0 then
		show_to_ai(actor)
		log("skip (" .. tostr(why) .. ") duration")
		return
	end
	active = true
	logged_hit = false
	hud_fail_logged = false
	shown_sec = nil
	actor_id = actor:id()
	safe_hp = actor.health
	origin = copy_pos(actor:position())
	left_ms = sec * 1000
	pause_held = false
	hide_companions()
	hide_from_ai(actor)
	update_hud()
	log("on " .. tostr(sec) .. "s (" .. tostr(why) .. ")")
end

local function queue_arm(why)
	if arm_pending then
		return
	end
	arm_pending = true
	arm_why = why
	log("queued (" .. tostring(why) .. ")")
	hide_from_ai(db.actor)
end

local function on_enemy_eval(obj, enemy, flags)
	if not active then
		return
	end
	if not enemy then
		return
	end
	local eid = enemy:id()
	if eid == actor_id or quiet[eid] then
		flags.override = true
		flags.result = false
		return
	end
	if obj and quiet[obj:id()] then
		flags.override = true
		flags.result = false
	end
end

-- Grok's balancer applies health inside this callback and zeros the engine hit,
-- and callback order is unordered. Zero the hit, then put health back if it
-- already landed.
local function actor_on_before_hit(shit, _bone_id, flags)
	if not active then
		return
	end
	if shit then
		shit.power = 0
	end
	if flags then
		flags.ret_value = false
	end
	local actor = db.actor
	if actor and safe_hp and actor.health and actor.health < safe_hp then
		actor.health = safe_hp
	end
	if not logged_hit then
		logged_hit = true
		log("hit ignored")
	end
end

local function actor_on_update()
	if arm_pending then
		local why = arm_why
		arm_pending = false
		arm_why = nil
		arm(why or "spawn")
		return
	end
	if not active then
		return
	end
	local actor = dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change)
	if not (actor and actor:alive()) or not CONFIG.loaded.enabled then
		stop("off")
		return
	end
	if device():is_paused() then
		if not pause_held then
			pause_held = true
			log("timer held")
		end
		update_hud()
		hide_companions()
		hide_from_ai(actor)
		return
	end
	pause_held = false
	local dt = device().time_delta
	if type(dt) == "number" and dt > 0 and dt <= MAX_DT_MS then
		left_ms = left_ms - dt
	end
	if left_ms <= 0 then
		stop("time")
		return
	end
	if origin and actor:position():distance_to(origin) > MOVE_M then
		stop("move")
		return
	end
	if IsMoveState("mcAnyMove") then
		stop("move")
		return
	end
	local hp = actor.health
	if hp and (not safe_hp or hp > safe_hp) then
		safe_hp = hp
	end
	update_hud()
	hide_companions()
	hide_from_ai(actor)
end

local function actor_on_weapon_fired()
	if active then
		stop("shot")
	end
end

local function actor_on_first_update()
	queue_arm("spawn")
end

-- Before the teleport. Same-map travel does not reload scripts, so the
-- next actor update arms at the new position. A level change reloads
-- scripts; on_game_load queues again.
local function on_before_fast_travel(trip)
	if not (trip and trip.dpos) then
		return
	end
	queue_arm("travel")
end

local function on_game_load()
	stop("load")
	queue_arm("load")
end

local function reset()
	stop("reset")
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	on_option_change()
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("on_enemy_eval", on_enemy_eval)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_weapon_fired", actor_on_weapon_fired)
	RegisterScriptCallback("actor_on_before_hit", actor_on_before_hit)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("on_game_load", on_game_load)
	RegisterScriptCallback("actor_on_net_destroy", reset)
	if rawget(_G, "game_fast_travel") then
		RegisterScriptCallback("on_before_fast_travel", on_before_fast_travel)
	end
	log("loaded")
end
