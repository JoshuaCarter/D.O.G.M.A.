--[[
	Solo guides & hired escorts.

	Guide jobs + friend/paid hire: only the speaker joins.
	- Offline squad mates are removed (they would pop in on accept).
	- Online squad mates are moved to a leftover squad (not deleted).
	Max one active guide (stock guider_start) and one hired escort (paid or free).
	Hostage join and story/special companions are untouched.
]]

local CONFIG = _G.dogma_npcs_companions_conf
local DOGMA

-- Free (high-rep) hire squad id; paid uses txr_paid_companions.paid_companions.
local free_hire_squad_id = nil

local function enabled()
	return DOGMA and DOGMA.mcm.bool(CONFIG.MOD_ID, "enabled")
end

local function is_hostage(actor, npc)
	local d = dialogs_axr_companion
	return d and d.is_hostage_task_giver and d.is_hostage_task_giver(actor, npc)
end

local function is_guide_job(actor, npc)
	return tasks_guide and tasks_guide.prec_1 and tasks_guide.prec_1(actor, npc)
end

local function paid_escort_active()
	local paid = txr_paid_companions and txr_paid_companions.paid_companions
	if not paid then
		return false
	end
	for id, _ in pairs(paid) do
		if axr_companions and axr_companions.companion_squads and axr_companions.companion_squads[id] then
			return true
		end
	end
	return false
end

local function free_escort_active()
	if not free_hire_squad_id then
		return false
	end
	if axr_companions and axr_companions.companion_squads and axr_companions.companion_squads[free_hire_squad_id] then
		return true
	end
	free_hire_squad_id = nil
	return false
end

local function has_hired_escort()
	return paid_escort_active() or free_escort_active()
end

local function member_online(id)
	local se = alife_object(id)
	if se and se.online then
		return true
	end
	local client = db.storage[id] and db.storage[id].object
	return client and client:alive() and true or false
end

local function remove_members(squad, ids)
	for i = 1, #ids do
		if squad.remove_npc then
			squad:remove_npc(ids[i], true)
		end
	end
end

-- Move online leftovers into a new squad; scrub any auto-spawned section roster.
-- Returns false if rehome failed (caller should fall back to remove).
local function rehome_online(squad, keep_id, online_ids)
	if #online_ids == 0 then
		return true
	end
	local section = squad:section_name()
	if not section then
		return false
	end
	local speaker = level.object_by_id(keep_id) or (db.storage[keep_id] and db.storage[keep_id].object)
	if not speaker then
		return false
	end
	local pos = speaker:position()
	local lvid = speaker:level_vertex_id()
	local gvid = speaker:game_vertex_id()
	local new_squad = alife_create(section, pos, lvid, gvid)
	if not new_squad then
		return false
	end

	local keep = {}
	for i = 1, #online_ids do
		keep[online_ids[i]] = true
	end

	-- Drop anyone the section auto-spawned that isn't one of our leftovers.
	local spawned = {}
	for k in new_squad:squad_members() do
		if k.id and not keep[k.id] then
			spawned[#spawned + 1] = k.id
		end
	end
	remove_members(new_squad, spawned)

	for i = 1, #online_ids do
		local id = online_ids[i]
		local se = alife_object(id)
		if se then
			squad:unregister_member(id)
			new_squad:register_member(id)
			if SIMBOARD and SIMBOARD.setup_squad_and_group then
				SIMBOARD:setup_squad_and_group(se)
			end
		end
	end
	if squad.refresh then
		squad:refresh()
	end
	if new_squad.refresh then
		new_squad:refresh()
	end
	local smart = smart_terrain and smart_terrain.nearest_to_actor_smart
	if smart and SIMBOARD and SIMBOARD.assign_squad_to_smart then
		SIMBOARD:assign_squad_to_smart(new_squad, smart.id)
	end
	return true
end

-- Offline mates: remove (prevent pop-in). Online mates: rehome, don't delete.
local function strip_to_speaker(npc)
	local squad = get_object_squad(npc)
	if not squad then
		return
	end
	local keep_id = npc:id()
	local offline = {}
	local online = {}
	for k in squad:squad_members() do
		if k.id and k.id ~= keep_id then
			if member_online(k.id) then
				online[#online + 1] = k.id
			else
				offline[#offline + 1] = k.id
			end
		end
	end
	remove_members(squad, offline)
	if not rehome_online(squad, keep_id, online) then
		-- Solo guarantee: better to despawn online mates than let them join.
		remove_members(squad, online)
	end
end

local function become_solo_hire_or_guide(actor, npc, orig)
	local npc = dialogs.who_is_npc(actor, npc)
	strip_to_speaker(npc)
	orig(actor, npc)

	-- Track free hire (not guide, not hostage, not paid — paid registers after).
	if is_guide_job(actor, npc) or is_hostage(actor, npc) then
		return
	end
	local squad = get_object_squad(npc)
	if squad then
		free_hire_squad_id = squad.id
	end
end

local function patch_module(mod)
	if not mod or mod.__dogma_npcs_companions then
		return
	end

	local orig_become = mod.become_actor_companion
	if orig_become then
		mod.become_actor_companion = function(actor, npc)
			if not enabled() or is_hostage(actor, npc) then
				return orig_become(actor, npc)
			end
			-- Story squads use add_special_squad, not this path; still skip story ids.
			if mod.is_non_story and not mod.is_non_story(actor, npc) then
				return orig_become(actor, npc)
			end
			return become_solo_hire_or_guide(actor, npc, orig_become)
		end
	end

	local orig_room = mod.is_room_in_actor_squad
	if orig_room then
		mod.is_room_in_actor_squad = function(actor, npc)
			if not enabled() or is_hostage(actor, npc) then
				return orig_room(actor, npc)
			end
			-- Friend + paid hire dialogs share this check: block a second escort,
			-- and count room for one body (mates are stripped).
			if has_hired_escort() then
				return false
			end
			-- Preserve Catspaw / stock max math; only force squad size to 1.
			local real_count = utils_obj.get_squad_count
			utils_obj.get_squad_count = function()
				return 1
			end
			local ok, result = pcall(orig_room, actor, npc)
			utils_obj.get_squad_count = real_count
			return ok and result
		end
	end

	mod.__dogma_npcs_companions = true
end

local function patch_paid_register()
	if not (txr_paid_companions and txr_paid_companions.register_paid_companion) then
		return
	end
	if txr_paid_companions.__dogma_npcs_companions then
		return
	end
	local orig = txr_paid_companions.register_paid_companion
	txr_paid_companions.register_paid_companion = function(actor, npc)
		free_hire_squad_id = nil -- paid table owns the escort slot
		return orig(actor, npc)
	end
	txr_paid_companions.__dogma_npcs_companions = true
end

local function patch_dismiss()
	if not (axr_companions and axr_companions.remove_from_actor_squad) then
		return
	end
	if axr_companions.__dogma_npcs_companions_dismiss then
		return
	end
	local orig = axr_companions.remove_from_actor_squad
	axr_companions.remove_from_actor_squad = function(npc)
		local squad = npc and get_object_squad(npc)
		if squad and free_hire_squad_id == squad.id then
			free_hire_squad_id = nil
		end
		return orig(npc)
	end
	axr_companions.__dogma_npcs_companions_dismiss = true
end

local function save_state(m_data)
	m_data.dogma_npcs_companions_free_hire = free_hire_squad_id
end

local function load_state(m_data)
	free_hire_squad_id = m_data.dogma_npcs_companions_free_hire
	m_data.dogma_npcs_companions_free_hire = nil
end

local function patch_all()
	patch_module(dialogs_axr_companion)
	if rawget(_G, "dialogs_axr_companion2") then
		patch_module(dialogs_axr_companion2)
	end
	patch_paid_register()
	patch_dismiss()
end

function on_game_start()
	DOGMA = dogma_common.load(CONFIG.MOD_ID)
	patch_all()
	RegisterScriptCallback("on_game_load", patch_all)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
end
