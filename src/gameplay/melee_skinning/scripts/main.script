--[[
	Melee Skinning

	Light knife slash on a dead mutant synthesizes Use so loot-claim mods can veto
	and FDDA/vanilla mutant loot handle success. Suppresses FDDA mutant_skin /
	mutant_loot spam from auto-loot, then queues one mutant_loot pickup if loot
	succeeded and the corpse is still the use-target. Setup turns off FDDA
	skinning anims and enables auto-loot-all.
]]

local CONFIG = _G.dogma_gameplay_melee_skinning_conf
local DOGMA

local ACTION_MUTANT_LOOT = "mutant_loot"
local ACTION_MUTANT_SKIN = "mutant_skin"

-- Knife HUD states (HudItem eLastBaseState=eBore=4; Weapon eFire/eFire2 follow)
local KNIFE_STATE_FIRE = 5

local USE_DEBOUNCE_MS = 400

local original_lam2_add_action = nil
local original_ui_mutant_loot_start = nil

local last_knife_state = 0
local last_use_ms = 0
local awaiting_use_outcome = false
local use_opened_loot = false
local pending_obj_id = nil

local function log(msg)
	if not (DOGMA and DOGMA.dbg) then
		return
	end
	if CONFIG.loaded.debug_log then
		DOGMA.dbg.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function input_blocked()
	if not db.actor then
		return true
	end
	if db.actor.is_talking and db.actor:is_talking() then
		return true
	end
	if actor_menu and actor_menu.get_last_mode and actor_menu.get_last_mode() ~= 0 then
		return true
	end
	return false
end

local function use_target_dead_mutant()
	local target = level.get_target_obj and level.get_target_obj()
	if target and IsMonster(target) and not target:alive() then
		return target
	end
	return nil
end

local function is_corpse_looted(obj)
	return se_load_var(obj:id(), obj:name(), "looted")
end

local function equipped_knife()
	local wpn = db.actor and db.actor:active_item()
	if not (wpn and wpn:clsid() == clsid.wpn_knife_s) then
		return nil
	end
	local sec = wpn:section()
	if string.find(sec, "animation_hit_", 1, true) then
		return nil
	end
	return wpn
end

local function patched_add_action(action)
	if CONFIG.loaded.enabled and action and (action.name == ACTION_MUTANT_SKIN or action.name == ACTION_MUTANT_LOOT) then
		log("fdda: dropped " .. tostring(action.name) .. " from queue")
		return
	end
	return original_lam2_add_action(action)
end

local function patch_lam2()
	if original_lam2_add_action then
		return
	end
	if not (_G.lam2 and _G.lam2.add_action) then
		log("lam2.add_action not found, FDDA Redone mutant skinning may be absent")
		return
	end
	original_lam2_add_action = _G.lam2.add_action
	_G.lam2.add_action = patched_add_action
	log("lam2.add_action patched (suppress mutant_skin/mutant_loot)")
end

local function patched_ui_mutant_loot_start(obj, for_bug1, for_bug2)
	if awaiting_use_outcome and obj and pending_obj_id and obj:id() == pending_obj_id then
		use_opened_loot = true
		log("use outcome: ui_mutant_loot.start id=" .. tostring(pending_obj_id))
	end
	return original_ui_mutant_loot_start(obj, for_bug1, for_bug2)
end

local function patch_ui_mutant_loot()
	if original_ui_mutant_loot_start then
		return
	end
	if not (_G.ui_mutant_loot and _G.ui_mutant_loot.start) then
		log("ui_mutant_loot.start not found, cannot observe Use loot outcome")
		return
	end
	original_ui_mutant_loot_start = _G.ui_mutant_loot.start
	_G.ui_mutant_loot.start = patched_ui_mutant_loot_start
	log("ui_mutant_loot.start patched")
end

-- press_action bypasses on_before_key_press; claim mods veto there, so gate first.
local function claim_allows_use(dik)
	local flags = { ret_value = true }
	SendScriptCallback("on_before_key_press", dik, key_bindings.kUSE, false, flags)
	return flags.ret_value ~= false
end

local function synthesize_use()
	local dik = bind_to_dik(key_bindings.kUSE)
	if not (dik and dik ~= 0) then
		log("use: no kUSE bind")
		return false
	end
	if not claim_allows_use(dik) then
		log("use: blocked by claim / on_before_key_press")
		return false
	end
	level.press_action(dik)
	level.release_action(dik)
	return true
end

local function queue_pickup_anim()
	local fdda = _G.liz_fdda_redone_mutant_skinning
	if not (fdda and fdda.get_template_action_mutant_loot and original_lam2_add_action) then
		log("pickup: FDDA mutant_loot template unavailable")
		return
	end
	local anim_sec = "item_ea_harv_meat_" .. tostring(math.random(14)) .. "_hud"
	-- nil target: skip must not drop_item a part/corpse
	local action = fdda.get_template_action_mutant_loot(nil, anim_sec)
	if not action then
		log("pickup: get_template_action_mutant_loot returned nil")
		return
	end
	original_lam2_add_action(action)
	log("pickup: queued mutant_loot " .. anim_sec)
end

local function degrade_knife()
	if item_knife and item_knife.degradate then
		item_knife.degradate()
		log("knife: degradate")
	end
end

local function try_light_skin()
	if not CONFIG.loaded.enabled then
		return
	end
	if awaiting_use_outcome then
		return
	end
	if input_blocked() then
		return
	end
	local wpn = equipped_knife()
	if not wpn then
		return
	end
	local now = time_global()
	if now - last_use_ms < USE_DEBOUNCE_MS then
		return
	end

	local obj = use_target_dead_mutant()
	if not obj then
		log("light: missed (no dead mutant use-target)")
		return
	end
	if is_corpse_looted(obj) then
		log("light: already looted id=" .. tostring(obj:id()))
		return
	end

	last_use_ms = now
	pending_obj_id = obj:id()
	use_opened_loot = false
	awaiting_use_outcome = true

	log("light: synthesize Use id=" .. tostring(pending_obj_id))
	local ok = synthesize_use()
	awaiting_use_outcome = false

	if not ok then
		pending_obj_id = nil
		use_opened_loot = false
		return
	end

	if use_opened_loot then
		local still = use_target_dead_mutant()
		if still and still:id() == pending_obj_id then
			log("light: loot ok, still targeting - pickup")
			queue_pickup_anim()
			degrade_knife()
		else
			log("light: loot ok, look lost - skip pickup")
			degrade_knife()
		end
	else
		log("light: Use blocked or no loot UI")
	end
	pending_obj_id = nil
	use_opened_loot = false
end

local function tick_knife_light()
	if not CONFIG.loaded.enabled then
		last_knife_state = 0
		return
	end
	if input_blocked() then
		last_knife_state = 0
		return
	end

	local wpn = equipped_knife()
	if not wpn then
		last_knife_state = 0
		return
	end

	local state = wpn:get_state()
	local rising_fire = state == KNIFE_STATE_FIRE and state ~= last_knife_state
	last_knife_state = state
	if rising_fire then
		try_light_skin()
	end
end

local function on_option_change()
	CONFIG.loaded.enabled = DOGMA.mcm.bool(CONFIG.MOD_ID, "enabled")
	CONFIG.loaded.debug_log = DOGMA.dbg.logging()
	if not CONFIG.loaded.enabled then
		awaiting_use_outcome = false
		use_opened_loot = false
		pending_obj_id = nil
	end
	log(string.format("options: enabled=%s", tostring(CONFIG.loaded.enabled)))
end

function on_game_start()
	DOGMA = dogma_common.load(CONFIG.MOD_ID)

	on_option_change()

	patch_lam2()
	patch_ui_mutant_loot()

	RegisterScriptCallback("actor_on_update", function()
		DOGMA.sys.ready(CONFIG.MOD_ID, db, on_option_change)
		tick_knife_light()
	end)
	RegisterScriptCallback("on_option_change", on_option_change)
	log("loaded")
end
