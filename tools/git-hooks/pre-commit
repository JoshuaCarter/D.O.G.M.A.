#!/usr/bin/env bash
# Run ALAO on local src/ before commit (same flags as DOGMA Optimize).
# Install: cp tools/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Skip:    DOGMA_NO_ALAO=1 git commit …
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
case "$HOOK_DIR" in
	*/.git/hooks) ROOT="$(cd "$HOOK_DIR/../.." && pwd)" ;;
	*/tools/git-hooks) ROOT="$(cd "$HOOK_DIR/../.." && pwd)" ;;
	*) ROOT="$(cd "$HOOK_DIR/../.." && pwd)" ;;
esac

if [[ -n "${DOGMA_NO_ALAO:-}" ]]; then
	echo "pre-commit: skipping ALAO (DOGMA_NO_ALAO set)"
	exit 0
fi

# Only when committing script changes under src/
if ! git -C "$ROOT" diff --cached --name-only --diff-filter=ACM | grep -qE '^src/.*\.(script|lua)$'; then
	exit 0
fi

py=()
if command -v py >/dev/null 2>&1; then
	py=(py -3)
elif command -v python3 >/dev/null 2>&1; then
	py=(python3)
elif command -v python >/dev/null 2>&1; then
	py=(python)
else
	echo "pre-commit: Python 3 required for ALAO" >&2
	exit 1
fi

echo "pre-commit: ALAO on src/…"
"${py[@]}" "$ROOT/tools/alao_local.py"

# Re-stage tracked scripts ALAO rewrote so the commit includes optimizations.
changed=()
while IFS= read -r -d '' f; do
	changed+=("$f")
done < <(git -C "$ROOT" diff -z --name-only -- 'src/**/*.script' 'src/**/*.lua' 2>/dev/null || true)

if ((${#changed[@]} > 0)); then
	git -C "$ROOT" add -- "${changed[@]}"
	echo "pre-commit: re-staged ${#changed[@]} script(s) after ALAO"
fi

exit 0
