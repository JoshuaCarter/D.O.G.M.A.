--[[
	DOGMA common loader (vendored — stable, no commit hash).

	Ships as dogma_common.script (no zzzz_), with dogma_mcm / dogma_dbg / dogma_sys.
	Feature body scripts are zzzz_*, so these globals exist before any feature
	on_game_start(). Feature _conf.script builds to dogma_{cat}_{feat}_conf.script
	(also no zzzz_) and publishes MOD_ID + defaults on _G.dogma_<feature>_conf.

	Usage:

		local CONF = _G.dogma_feature_conf
		local MOD_ID = CONF.MOD_ID
		local DOGMA

		function on_game_start()
			DOGMA = dogma_common.load(MOD_ID)
			-- defaults come from CONF via DOGMA.mcm.*; MCM trees still use def = CONF.defaults["…"]
			-- CONFIG.x = DOGMA.mcm.bool(MOD_ID, "main/x")
		end
]]

local SUFFIX = ""

function load(mod_id)
	local mcm = _G["dogma_mcm" .. SUFFIX]
	local dbg = _G["dogma_dbg" .. SUFFIX]
	local sys = _G["dogma_sys" .. SUFFIX]
	sys.set_deps(mcm, dbg)
	if mod_id then
		sys.reset_mod(mod_id)
		dbg.clear_source(mod_id)
	end
	printf("[DOGMA] %s: common loaded", tostring(mod_id))
	return { mcm = mcm, dbg = dbg, sys = sys }
end
