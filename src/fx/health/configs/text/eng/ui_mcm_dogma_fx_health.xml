	</string>
	<string id="ui_mcm_dogma_fx_health_page_description">
		<text>Low-health screen FX from stock edge-blood overlays and/or xlibs PPE washes. Intensity rises as HP falls (50% → 5%). Disables Anomaly Bleeding effect and Low health blur so they don't stack.</text>
	</string>
	<string id="ui_mcm_dogma_fx_health_enable">
		<text>Enable</text>
	</string>
	<string id="ui_mcm_dogma_fx_health_enable_desc">
		<text>When off, low-health screen FX is completely disabled.</text>
	</string>
	<string id="ui_mcm_dogma_fx_health_intensity">
		<text>Intensity</text>
	</string>
	<string id="ui_mcm_dogma_fx_health_intensity_desc">
		<text>Overall strength of all enabled effects (0 = off, 1 = full).</text>
	</string>
	<string id="ui_mcm_dogma_fx_health_edge_blood">
		<text>Edge blood (stock HUD)</text>
	</string>
	<string id="ui_mcm_dogma_fx_health_edge_blood_desc">
		<text>Stock screen-edge blood overlays (hud_blood1–4). Does not include low-health blur, shock, or other Bleeding-effect extras.</text>
	</string>
