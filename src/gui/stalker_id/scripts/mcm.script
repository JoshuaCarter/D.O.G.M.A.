-- gui/stalker_id conf

_G.dogma_gui_stalker_id_conf = {
    MOD_ID = "dogma/gui/stalker_id",
    DEFAULTS = {
        enabled = true,
        show_always = true,
        show_keybind = -1,
        show_when_ads = true,
        show_when_rmb = true,
        show_when_free_zoom = true,
        show_when_binoc = true,
        dead_id = true,
        zombie_id = true,
        name_id = true,
        goodwill_color = true,
        rank_id = true,
        name_y = 15,
        rank_y = 26,
        icon_y = 50,
        icon_scale = 100,
        name_a = 255,
        rank_a = 255,
        icon_a = 200,
        line_a = 80,
        min_size_px = 20,
        circle_size = 70,
        hide_on_death = false,
        fade_out_ms = 500,
        fade_in_ms = 500,
        always_show_line = false,
        always_show_line_binoc = true,
    },
    loaded = {},
}

-- MCM: precondition {fn} -> fn(). False = skip widget. Track still in opt_val.
local function hidden()
    return false
end

local function in_level()
    return level and level.present and level.present()
end

-- MCM: functor_ui {fn} -> fn(UI_MCM). zzzz_ not safe to index at gather.
local function start_layout(gui)
    local pos = rawget(_G, "zzzz_dogma_gui_stalker_id_position")
    if pos and pos.start then
        pos.start(gui)
        return
    end
    dogma.log.log(_G.dogma_gui_stalker_id_conf.MOD_ID, "layout button: no position script")
end

function on_mcm_load(options)
    local CONFIG = _G.dogma_gui_stalker_id_conf
    dogma_mcm.attach(options, "gui", "ui_mcm_menu_dogma_gui", {
        id = "stalker_id",
        sh = true,
        text = "ui_mcm_menu_dogma_gui_stalker_id",
        gr = dogma_mcm.with_header({
            {
                id = "page_description",
                type = "desc",
                text = "ui_mcm_dogma_gui_stalker_id_page_description",
            },
            {
                id = "enabled",
                type = "check",
                val = 1,
                def = CONFIG.DEFAULTS.enabled,
                hint = "dogma_gui_stalker_id_enabled",
            },
            {
                id = "position",
                type = "button",
                functor_ui = { start_layout },
                precondition = { in_level },
            },
            {
                id = "show_always",
                type = "check",
                val = 1,
                def = CONFIG.DEFAULTS.show_always,
                hint = "dogma_gui_stalker_id_show_always",
            },
            {
                id = "show_keybind",
