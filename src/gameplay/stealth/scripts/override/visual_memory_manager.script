--[[
	DOGMA gameplay/stealth — replaces stock visual_memory_manager.get_visible_value.

	Actor-only: scale stock vis, then multiply by pose factor (stand / crouch / prone).
	NPC↔NPC / non-actor: stock timed formula (underground lumin bump kept).
]]

local CONFIG = _G.dogma_gameplay_stealth_conf

-- Last actor-facing values for gem / debug.
local last_vis = 0
local last_mult = 1
local last_out = 0

local function clamp01(x)
	if x < 0 then
		return 0
	end
	if x > 1 then
		return 1
	end
	return x
end

local function loaded_num(key, fallback)
	local loaded = CONFIG and CONFIG.loaded
	if loaded and loaded[key] ~= nil then
		local n = tonumber(loaded[key])
		if n ~= nil then
			return n
		end
	end
	local d = CONFIG and CONFIG.DEFAULTS
	if d and d[key] ~= nil then
		local n = tonumber(d[key])
		if n ~= nil then
			return n
		end
	end
	return fallback
end

local function pose_mult()
	if IsMoveState("mcCrouch") then
		if IsMoveState("mcAccel") then
			return loaded_num("mult_prone", 0.30)
		end
		return loaded_num("mult_crouch", 0.70)
	end
	return loaded_num("mult_stand", 1.0)
end

local function stock_vis(luminocity, velocity_factor, velocity, distance, object_distance)
	return luminocity * (1 + velocity_factor * velocity) * (distance - object_distance) / distance
end

local function is_actor(who)
	local actor = db and db.actor
	if not (actor and who and who.id) then
		return false
	end
	local ok, aid = pcall(function()
		return actor:id()
	end)
	local ok2, wid = pcall(function()
		return who:id()
	end)
	return ok and ok2 and aid == wid
end

-- called from engine
-- warning npc and who can be nil sometimes
function get_visible_value(npc, who, time_delta, time_quant, luminocity, velocity_factor, velocity, distance, object_distance, always_visible_distance)
	distance = distance <= 0 and 0.00001 or distance
	luminocity = luminocity <= 0 and 0.0001 or luminocity

	if level_weathers and level_weathers.bLevelUnderground then
		luminocity = luminocity + 0.35
	end

	local vis_stock = stock_vis(luminocity, velocity_factor, velocity, distance, object_distance)

	if not is_actor(who) then
		return time_delta / time_quant * vis_stock
	end

	local scale = loaded_num("scale", 1.0)
	local mult = pose_mult()
	local vis = clamp01(vis_stock * scale)
	local vis_out = clamp01(vis * mult)

	last_vis = vis
	last_mult = mult
	last_out = vis_out
	return time_delta / time_quant * vis_out
end

function icon_vis()
	return last_vis
end

function icon_mult()
	return last_mult
end

function icon_out()
	return last_out
end
