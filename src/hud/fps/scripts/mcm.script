							{ 0, "simple_small" },
							{ 1, "simple_large" },
							{ 2, "detailed_small" },
							{ 3, "detailed_large" },
							{ 4, "graph_small" },
							{ 5, "graph_large" },
						},
					},
					{
						id = "sample_window",
