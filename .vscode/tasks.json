{
	"version": "2.0.0",
	"options": {
		"cwd": "${workspaceFolder}",
		"env": {
			"DOGMA_DEPLOY": "C:/GAMMA/mods/DOGMA"
		}
	},
	"tasks": [
		{
			"label": "DOGMA: Build",
			"type": "shell",
			"command": "tools/build.sh",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
				"clear": true,
				"close": false,
				"showReuseMessage": false
			},
			"problemMatcher": {
				"owner": "dogma-build",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": "."
				}
			}
		},
		{
			"label": "DOGMA: Hot deploy assets",
			"type": "shell",
			"command": "tools/patch_live.sh",
			"detail": "Deploy UI/text XML + DDS/THM into GAMMA mods/DOGMA. XML: reopen UI. DDS: restart game.",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"problemMatcher": []
		}
	]
}
