-- Inject Controls rows claimed by features; keep Settings labels matched to MCM.
-- Feature MCM scripts claim via __dogma_key_mirror_mcm.claim_control / mirror_spec.
-- Claiming an engine action replaces any other Controls row on that same exe=.

local fmt = string.format

local function ensure_string(xml_obj, id, text)
	-- Replace the whole string node. Prefer this over setText on a child query:
	-- a failed `string[id] > text` match used to insert a duplicate and leave
	-- the stock label (e.g. Walk/Low Crouch) as the first hit.
	local q = fmt("string[id=%s]", id)
	local existing = xml_obj:query(q)
	while existing[1] do
		xml_obj:removeElement(existing[1])
		existing = xml_obj:query(q)
	end
	xml_obj:insertFromXMLString(fmt(
		'<string id="%s">\n\t\t<text>%s</text>\n\t</string>',
		id,
		text
	))
end

local function remove_other_rows_for_action(xml_obj, action, keep_id)
	local nodes = xml_obj:query(fmt("command[exe=%s]", action))
	if not is_not_empty(nodes) then
		return
	end
	local remove = {}
	for i = 1, #nodes do
		local el = nodes[i]
		local attr = xml_obj:getElementAttr(el)
		local id = attr and attr.id
		if id and id ~= keep_id then
			remove[#remove + 1] = el
		end
	end
	for i = 1, #remove do
		xml_obj:removeElement(remove[i])
	end
end

local function insert_after_command(xml_obj, group_name, after_id, new_id, exe)
	if is_not_empty(xml_obj:query(fmt("command[id=%s]", new_id))) then
		return
	end
	local anchor = xml_obj:query(fmt(
		"group[name=%s] > command[id=%s]",
		group_name,
		after_id
	))
	if not anchor[1] then
		return
	end
	local el = anchor[1]
	local pos = xml_obj:getElementPosition(el)
	if not pos then
		return
	end
	xml_obj:insertFromXMLString(
		fmt('<command id="%s"\t\t\t\t\t\texe="%s"/>', new_id, exe),
		el.parent,
		pos + 1
	)
end

local function each_control(fn)
	local m = __dogma_key_mirror_mcm
	local list = m and m.CONTROLS
	if not list then
		return
	end
	for i = 1, #list do
		fn(list[i])
	end
end

local function patch_keybinding_ui(xml_obj)
	each_control(function(e)
		if e.group and e.after and e.id and e.action then
			insert_after_command(xml_obj, e.group, e.after, e.id, e.action)
			remove_other_rows_for_action(xml_obj, e.action, e.id)
		end
	end)
end

-- Russian Controls labels (Windows-1251 bytes: the engine reads text\rus\*.xml as cp1251).
local RU_LABELS = {
	["Weapon 4 (Pistol)"] = "\xCE\xF0\xF3\xE6\xE8\xE5\x20\x34\x20\x28\xEF\xE8\xF1\xF2\xEE\xEB\xE5\xF2\x29",
	["Prone"] = "\xCB\xE5\xF7\xFC",
	["Walk"] = "\xC8\xE4\xF2\xE8\x20\xF8\xE0\xE3\xEE\xEC",
}

local function patch_keybinding_strings(xml_obj, rus)
	each_control(function(e)
		if e.id and e.label then
			ensure_string(xml_obj, e.id, (rus and RU_LABELS[e.label]) or e.label)
		end
	end)
end

local xml_read_cb = function(xml_file_name, xml_obj)
	if xml_file_name == [[ui\ui_keybinding.xml]] then
		patch_keybinding_ui(xml_obj)
		return
	end
	if xml_file_name == [[text\eng\ui_st_keybinding.xml]] then
		patch_keybinding_strings(xml_obj, false)
	elseif xml_file_name == [[text\rus\ui_st_keybinding.xml]] then
		patch_keybinding_strings(xml_obj, true)
	end
end

function on_xml_read()
	RegisterScriptCallback("on_xml_read", xml_read_cb)
end
