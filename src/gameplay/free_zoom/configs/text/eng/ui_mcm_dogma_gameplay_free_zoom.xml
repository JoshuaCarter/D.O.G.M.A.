	<string id="ui_mcm_dogma_free_zoom_mmb_zoom">
		<text>Middle click</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_rmb_zoom_desc">
		<text>Toggle or hold free zoom. Does not block ADS.</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_mmb_zoom_desc">
