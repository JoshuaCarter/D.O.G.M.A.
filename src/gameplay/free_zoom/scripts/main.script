--[[
	Free Zoom - free zoom + ADS Zoom.

	Drivers → fov + hud_fov (shrink %: base * (1 - pct/100)):
	  Free: both channels = free% (cleared on ADS enter; never while ADS)
	  ADS world FOV: FOV zoom % (cap 15; skipped on magnified optical scopes)
	  ADS HUD: Irons / Sights / Scopes % (caps 15 / 25 / 35)
	Optional peripheral DOF (SSFX ssfx_wpn_dof_*) while free-zoomed / ADS.
	Console fov snaps; we lerp live → target quickly. Free/ADS publish tgt FOVs to
	_G.dogma_fov_tgt_free / _G.dogma_fov_tgt_ads; lerp clamps so zoom-out never
	passes the other system's more-zoomed floor.
	± keys override gun+optic HUD %. Owns ADS hud_fov - blanks Blindside/Keybinds ADS FOV / Free_ZoomV2 via scripts/override/; disable Free Zoom packages via config/disabled.ini.
]]

local CONFIG = _G.dogma_gameplay_free_zoom_conf
local ADS_MOD = "dogma/gameplay/ads_zoom"

-- Lower FOV number = more zoom. nil = not requesting (other systems may read these).
_G.dogma_fov_tgt_free = nil
_G.dogma_fov_tgt_ads = nil

-- SSFX Weapons DOF: edge-only peripheral blur (shader needs .w + _2; .z is far/fullscreen).
-- Full intensity matches SSFX aim defaults (blur 1.6, edgeblur MCM 1.0 → console 0.5).
-- Snapshot prior console values on enter; restore them on exit only if still ours.
local DOF_BLUR_AT_FULL = 1.6
local DOF_EDGE_AT_FULL = 0.5
local dof_we_own = false
local dof_saved_1 = nil -- status string for ssfx_wpn_dof_1
local dof_saved_2 = nil -- number for ssfx_wpn_dof_2
local dof_ours_blur = nil
local dof_ours_edge = nil

-- zoom_key_mode: 0=toggle, 2=hold (in on down, out on up; 1 was double, removed)
local MODE_TOGGLE = 0
local MODE_HOLD = 2

-- Mouse button zoom: 0=no, 1=toggle, 2=hold (RMB/MMB)
local MOUSE_NONE = 0
local MOUSE_TOGGLE = 1
local MOUSE_HOLD = 2
local DIK_RMB = 338
local DIK_MMB = 339

-- WADS ± keys: +5% / -5% per press while ADS
local WADS_STEP = 5
local ADS_MAX = {
	irons = 15,
	sight = 25,
	scope = 35,
}
local ADS_FOV_MAX = 15

local KIND_CAT = {
	w_pistol = "pistol",
	w_smg = "smg",
	w_rifle = "rifle",
	w_sniper = "sniper",
	w_shotgun = "shotgun",
	w_explosive = "explosive",
}
local free_on = false
local ads_on = false
-- Hold mode: true while a hold-source key (zoom key / RMB / MMB) is down.
local hold_zoom_latched = false

local CTX = {
	OK = "ok",
	DISABLED = "disabled",
	DEAD = "dead",
	PDA = "pda",
	GUI = "gui",
	RELOAD = "reload",
	OPTICAL = "optical",
	SPRINT = "sprint",
	NO_GUN = "no_gun",
	HANDS_FULL = "hands_full",
	LOWERED = "lowered",
}

local CTX_BLOCK_FREE = {
	[CTX.DISABLED] = true,
	[CTX.DEAD] = true,
	[CTX.PDA] = true,
	[CTX.GUI] = true,
	[CTX.RELOAD] = true,
	[CTX.OPTICAL] = true,
	[CTX.SPRINT] = true,
	[CTX.NO_GUN] = true,
	[CTX.HANDS_FULL] = true,
	[CTX.LOWERED] = true,
}

-- Scroll must pass through (PDA map, inventory UI, optical, sprint, etc.).
local CTX_SCROLL_PASS = {
	[CTX.DEAD] = true,
	[CTX.PDA] = true,
	[CTX.GUI] = true,
	[CTX.OPTICAL] = true,
	[CTX.SPRINT] = true,
	[CTX.NO_GUN] = true,
	[CTX.HANDS_FULL] = true,
	[CTX.LOWERED] = true,
}

local MENU_BLOCK = {
	UIInventory = true,
	Dialog = true,
	UIWorkshop = true,
}

local hip_fov = 60
local hip_sens = 0.5
local sens_per_fov = 0.5
local hip_hud = 0.6
local we_wrote_hud = false
local we_wrote_fov = false

-- Console fov/hud_fov snap instantly (engine has no blend). We lerp live → target.
local FOV_SMOOTH_RATE = 22
local live_fov = nil
local live_hud = nil
local tgt_fov = nil
local tgt_hud = nil
local last_smooth_ms = nil
-- After optical restore reaches hip, stop writing world FOV so the scope owns it.
local world_write = false

-- parent|opticKey → WADS % override (persisted via save_state)
local gun_scope_override = {}

local wpn = nil
local last_item_sec = nil
local last_item_id = nil
local menus_open = {}

local scroll_accum = 0
local scroll_want_in = false
local scroll_last_ms = 0
local last_ctx = nil

-- Crash breadcrumbs: last mark() line in xray log is the phase we reached.
-- Native AVs after Lua returns still leave the prior mark as the smoking gun.
local crash_phase = "boot"
local ads_enter_ms = 0
local ads_post_frames = 0
local ADS_POST_LOG_FRAMES = 8
-- Hot window: verbose marks around ADS enter / FOV writes (avoids every-frame spam).
local diag_hot = false
local diag_hot_frames = 0
-- Forward decl: assigned after weapon helpers. Must be above every caller.
local zoom_diag

local on_mouse_wheel

local function clamp(n, lo, hi)
	if n < lo then
		return lo
	end
	if n > hi then
		return hi
	end
	return n
end

local function log(msg)
	if CONFIG.loaded.debug_log then
		dogma.dbg.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function logf(fmt, ...)
	log(string.format(fmt, ...))
end

-- Always update crash_phase; only print during the ADS hot window or force=true
-- so a native crash leaves a precise "last alive" line without drowning the log.
local function mark(phase, detail, force)
	crash_phase = phase
	if not force and not diag_hot then
		return
	end
	local tick = (time_global and time_global()) or 0
	if detail and detail ~= "" then
		logf("phase=%s tick=%s %s", phase, tostring(tick), detail)
	else
		logf("phase=%s tick=%s", phase, tostring(tick))
	end
end

local function diag_hot_begin(reason)
	diag_hot = true
	diag_hot_frames = 0
	ads_post_frames = 0
	mark("diag_hot_begin", tostring(reason or ""), true)
end

-- Returns true while the ADS enter hot window is active (including this frame).
local function diag_hot_on_update()
	if not diag_hot then
		return false
	end
	diag_hot_frames = diag_hot_frames + 1
	ads_post_frames = diag_hot_frames
	mark(
		"update_ads_frame",
		string.format(
			"frame=%d since_enter=%sms %s",
			diag_hot_frames,
			tostring(((time_global and time_global()) or 0) - ads_enter_ms),
			zoom_diag("upd")
		),
		true
	)
	return true
end

local function diag_hot_end_if_due()
	if not diag_hot then
		return
	end
	if diag_hot_frames >= ADS_POST_LOG_FRAMES then
		mark("diag_hot_end", string.format("frames=%d", diag_hot_frames), true)
		diag_hot = false
	end
end

local function wpn_label()
	if not wpn then
		return "nil"
	end
	local ok, sec = pcall(function()
		return wpn:section()
	end)
	return (ok and sec) or "?"
end

local function mode_label()
	if ads_on then
		return "ads"
	end
	if free_on then
		return "free"
	end
	return "hip"
end

local function refresh_config()
	CONFIG.loaded.enabled = true
	CONFIG.loaded.allow_during_sprint = dogma.mcm.bool(CONFIG.MOD_ID, "free_zoom/allow_during_sprint")
	CONFIG.loaded.empty_hands_only = dogma.mcm.bool(CONFIG.MOD_ID, "free_zoom/empty_hands_only")
	CONFIG.loaded.zoom_key = dogma.mcm.key(CONFIG.MOD_ID, "free_zoom/zoom_key")
	CONFIG.loaded.zoom_key_modifier = dogma.mcm.int(CONFIG.MOD_ID, "free_zoom/zoom_key_modifier")
	-- Legacy MCM: Hold was 3 when Long occupied 2. Double (1) maps to toggle.
	local zoom_key_mode = dogma.mcm.int(CONFIG.MOD_ID, "free_zoom/zoom_key_mode")
	if zoom_key_mode >= 2 then
		zoom_key_mode = MODE_HOLD
	else
		zoom_key_mode = MODE_TOGGLE
	end
	CONFIG.loaded.zoom_key_mode = zoom_key_mode
	CONFIG.loaded.rmb_zoom = dogma.mcm.int(CONFIG.MOD_ID, "free_zoom/rmb_zoom")
	CONFIG.loaded.mmb_zoom = dogma.mcm.int(CONFIG.MOD_ID, "free_zoom/mmb_zoom")
	CONFIG.loaded.scroll_wheel_zoom = dogma.mcm.bool(CONFIG.MOD_ID, "free_zoom/scroll_wheel_zoom")
	CONFIG.loaded.scroll_wheel_reverse = dogma.mcm.bool(CONFIG.MOD_ID, "free_zoom/scroll_wheel_reverse")
	CONFIG.loaded.scroll_wheel_steps = dogma.mcm.uint(CONFIG.MOD_ID, "free_zoom/scroll_wheel_steps")
	CONFIG.loaded.scroll_wheel_max_gap_ms = dogma.mcm.uint(CONFIG.MOD_ID, "free_zoom/scroll_wheel_max_gap_ms")
	CONFIG.loaded.free_zoom = clamp(dogma.mcm.float(CONFIG.MOD_ID, "free_zoom/free_zoom"), 0, 40)
	CONFIG.loaded.move_speed = dogma.mcm.float(CONFIG.MOD_ID, "free_zoom/move_speed")
	CONFIG.loaded.free_dof = dogma.mcm.bool(CONFIG.MOD_ID, "free_zoom/dof")
	CONFIG.loaded.free_dof_intensity = clamp(dogma.mcm.float(CONFIG.MOD_ID, "free_zoom/dof_intensity"), 0, 1)

	CONFIG.loaded.ads_enabled = (_G.dogma_gameplay_ads_zoom_conf ~= nil)
	CONFIG.loaded.fov_zoom = clamp(dogma.mcm.int(ADS_MOD, "fov_zoom"), 0, ADS_FOV_MAX)
	CONFIG.loaded.wads = {
		irons = clamp(dogma.mcm.int(ADS_MOD, "wads_irons"), 0, ADS_MAX.irons),
		sight = clamp(dogma.mcm.int(ADS_MOD, "wads_sight"), 0, ADS_MAX.sight),
		scope = clamp(dogma.mcm.int(ADS_MOD, "wads_scope"), 0, ADS_MAX.scope),
	}
	CONFIG.loaded.ads_dof = {
		enabled = dogma.mcm.bool(ADS_MOD, "dof"),
		irons = clamp(dogma.mcm.float(ADS_MOD, "dof_irons"), 0, 1),
		sight = clamp(dogma.mcm.float(ADS_MOD, "dof_sight"), 0, 1),
		scope = clamp(dogma.mcm.float(ADS_MOD, "dof_scope"), 0, 1),
	}
	CONFIG.loaded.wads_inc_key = dogma.mcm.key(ADS_MOD, "wads_inc_key")
	CONFIG.loaded.wads_dec_key = dogma.mcm.key(ADS_MOD, "wads_dec_key")
	CONFIG.loaded.wads_reset_key = dogma.mcm.key(ADS_MOD, "wads_reset_key")
	CONFIG.loaded.wads_key_modifier = dogma.mcm.int(ADS_MOD, "wads_key_modifier")

	CONFIG.loaded.debug_log = dogma.dbg.logging()
	dogma.dbg.set_enabled(CONFIG.MOD_ID, CONFIG.loaded.debug_log)
	dogma.dbg.clear_source(CONFIG.MOD_ID)
end

local function reset_scroll_accum()
	scroll_accum = 0
	scroll_last_ms = 0
end

local function any_menu_open()
	for _, open in pairs(menus_open) do
		if open then
			return true
		end
	end
	return false
end

-- PDA lifted / fullscreen (info), or PDA / binoculars slot.
local function pda_blocking()
	if not (db and db.actor) then
		return true
	end
	if item_device.is_pda_active() then
		return true
	end
	local slot = db.actor:active_slot()
	return slot == 8 or slot == 14
end

local function refresh_wpn()
	if db and db.actor then
		wpn = db.actor:active_item()
	else
		wpn = nil
	end
end

local function active_item_id()
	if not wpn then
		return nil
	end
	local ok, id = pcall(function()
		return wpn:id()
	end)
	if ok then
		return id
	end
	return nil
end

local function active_item_sec()
	if not wpn then
		return nil
	end
	local ok, sec = pcall(function()
		return wpn:section()
	end)
	if ok then
		return sec
	end
	return nil
end

local function weapon_reloading()
	if not (wpn and wpn:cast_Weapon()) then
		return false
	end
	return wpn:get_state() == 7
end

-- Medkit / bandage / food / drink / sprint-lower / dialog lower, etc.
local function weapon_is_lowered()
	return game and game.actor_weapon_lowered and game.actor_weapon_lowered() or false
end

-- Any equipped optic (sight or scope) - not irons. Engine IsScopeAttached misses
-- some section-baked / DXR optics that utils_item still reports.
local function scope_attached()
	if not wpn then
		return false
	end
	if IsGrenade(wpn) or IsBolt(wpn) then
		return false
	end
	if wpn.cast_Weapon then
		local gun = wpn:cast_Weapon()
		if gun and gun.IsScopeAttached and gun:IsScopeAttached() then
			return true
		end
	end
	if utils_item then
		if utils_item.has_attached_scope and utils_item.has_attached_scope(wpn) then
			return true
		end
		if utils_item.get_attached_scope then
			local ok, scope = pcall(utils_item.get_attached_scope, wpn)
			if ok and type(scope) == "string" and scope ~= "" then
				return true
			end
		end
		if utils_item.has_scope then
			local sec = active_item_sec()
			if sec and utils_item.has_scope(sec) then
				return true
			end
		end
	end
	return false
end

-- 3DSS optical ADS: scopes / engine own FOV - we never write console FOV.
local function is_optical_ads()
	if not (wpn and wpn.cast_Weapon and z_3d_scopes) then
		return false
	end
	if IsGrenade(wpn) or IsBolt(wpn) then
		return false
	end
	local gun = wpn:cast_Weapon()
	if not (gun and gun.IsScopeAttached and gun:IsScopeAttached()) then
		return false
	end
	return gun:IsZoomed() and gun:GetZoomType() == 0
end

-- Irons / Sight / Scope (Scope = optical magnified path; same gate as is_optical_ads).
-- Any attached optic is never irons.
local function optic_class()
	if not scope_attached() then
		return "irons"
	end
	if is_optical_ads() then
		return "scope"
	end
	return "sight"
end

local function parent_section()
	local sec = active_item_sec()
	if not sec then
		return nil
	end
	if ini_sys and ini_sys.r_string_ex then
		return ini_sys:r_string_ex(sec, "parent_section") or sec
	end
	return sec
end

local function weapon_category()
	local parent = parent_section()
	if not parent or not (ini_sys and ini_sys.r_string_ex) then
		return "rifle"
	end
	local kind = ini_sys:r_string_ex(parent, "kind")
	return KIND_CAT[kind] or "rifle"
end

local function attached_scope_sec()
	if not wpn then
		return nil
	end
	if utils_item and utils_item.get_attached_scope then
		local ok, scope = pcall(utils_item.get_attached_scope, wpn)
		if ok and type(scope) == "string" and scope ~= "" then
			return scope
		end
	end
	if utils_item and utils_item.has_scope then
		local sec = active_item_sec()
		local baked = sec and utils_item.has_scope(sec)
		if type(baked) == "string" and baked ~= "" then
			return baked
		end
	end
	if wpn.cast_Weapon then
		local gun = wpn:cast_Weapon()
		if gun and gun.IsScopeAttached and gun:IsScopeAttached() and gun.GetScopeName then
			local ok, name = pcall(function()
				return gun:GetScopeName()
			end)
			if ok and type(name) == "string" and name ~= "" then
				return name
			end
		end
	end
	return nil
end

-- Safe engine/weapon snapshot for ADS crash diagnosis (all pcall'd).
-- Must sit below active_item_id / scope helpers so those names bind as locals.
zoom_diag = function(tag)
	local sformat = string.format
	local tostr = tostring
	local parts = { tag or "diag" }
	local function add(fmt, ...)
		parts[#parts + 1] = string.format(fmt, ...)
	end

	add("mode=%s free=%s ads=%s", mode_label(), tostr(free_on), tostr(ads_on))
	add(
		"fov hip=%.2f live=%s tgt=%s write=%s wrote=%s",
		hip_fov or -1,
		live_fov and sformat("%.2f", live_fov) or "nil",
		tgt_fov and sformat("%.2f", tgt_fov) or "nil",
		tostr(world_write),
		tostr(we_wrote_fov)
	)
	add(
		"hud hip=%.3f live=%s tgt=%s wrote=%s",
		hip_hud or -1,
		live_hud and sformat("%.3f", live_hud) or "nil",
		tgt_hud and sformat("%.3f", tgt_hud) or "nil",
		tostr(we_wrote_hud)
	)

	local ok_c, con_fov = pcall(function()
		return get_console_cmd(2, "fov")
	end)
	local ok_h, con_hud = pcall(function()
		return get_console_cmd(2, "hud_fov")
	end)
	add(
		"console fov=%s hud=%s",
		(ok_c and con_fov and sformat("%.2f", con_fov)) or "?",
		(ok_h and con_hud and sformat("%.3f", con_hud)) or "?"
	)

	local slot = "?"
	if db and db.actor then
		local ok_s, s = pcall(function()
			return db.actor:active_slot()
		end)
		if ok_s then
			slot = tostr(s)
		end
	end
	add("slot=%s wpn=%s id=%s", slot, wpn_label(), tostr(active_item_id()))

	local gun_bits = "no_gun"
	if wpn then
		local ok_g, bits = pcall(function()
			local tostr = tostring
			local gun = wpn.cast_Weapon and wpn:cast_Weapon()
			if not gun then
				return "not_weapon"
			end
			local zoomed = gun.IsZoomed and gun:IsZoomed()
			local ztype = gun.GetZoomType and gun:GetZoomType()
			local scoped = gun.IsScopeAttached and gun:IsScopeAttached()
			local state = wpn.get_state and wpn:get_state()
			return string.format(
				"zoomed=%s ztype=%s scope_eng=%s state=%s",
				tostr(zoomed),
				tostr(ztype),
				tostr(scoped),
				tostr(state)
			)
		end)
		gun_bits = (ok_g and bits) or ("gun_err:" .. tostr(bits))
	end
	add("%s", gun_bits)

	local ok_opt, optical = pcall(is_optical_ads)
	local ok_att, attached = pcall(scope_attached)
	local ok_cls, oclass = pcall(optic_class)
	local ok_scp, scp = pcall(attached_scope_sec)
	add(
		"optical=%s attached=%s class=%s scope_sec=%s 3dss=%s",
		ok_opt and tostr(optical) or "err",
		ok_att and tostr(attached) or "err",
		ok_cls and tostr(oclass) or "err",
		(ok_scp and scp) and tostr(scp) or "nil",
		tostr(z_3d_scopes ~= nil)
	)

	local menus = {}
	for name in pairs(menus_open) do
		menus[#menus + 1] = name
	end
	table.sort(menus)
	local ok_pda, pda = pcall(pda_blocking)
	local ok_low, lowered = pcall(weapon_is_lowered)
	add(
		"menus=%s pda=%s lowered=%s phase=%s",
		(#menus > 0) and table.concat(menus, ",") or "none",
		ok_pda and tostr(pda) or "err",
		ok_low and tostr(lowered) or "err",
		crash_phase
	)

	if actor_menu and actor_menu.last_mode ~= nil then
		add("actor_menu.last_mode=%s", tostr(actor_menu.last_mode))
	end

	return table.concat(parts, " | ")
end

local function optic_key()
	if not scope_attached() then
		return "irons"
	end
	return attached_scope_sec() or "scope"
end

local function override_key()
	local parent = parent_section()
	if not parent then
		return nil
	end
	return parent .. "|" .. optic_key()
end

local function ads_cap(optic)
	return ADS_MAX[optic or "irons"] or ADS_MAX.irons
end

local function resolve_ads()
	local cat = weapon_category()
	local optic = optic_class()
	local max = ads_cap(optic)
	local def = clamp((CONFIG.loaded.wads and CONFIG.loaded.wads[optic]) or 0, 0, max)
	local okey = override_key()
	local ov = okey and gun_scope_override[okey] or nil
	local pct = ov ~= nil and ov or def
	return clamp(pct, 0, max), cat, optic, def, ov, okey
end

local function actor_dead()
	return not (db and db.actor and db.actor:alive())
end

local function actor_sprinting()
	if not (db and db.actor) then
		return false
	end
	return IsMoveState("mcSprint")
end

-- True empty hands: holstered slot and no detector/scanner in hand.
local function hands_are_empty()
	if not (db and db.actor) then
		return false
	end
	if db.actor:active_slot() ~= 0 then
		return false
	end
	if db.actor.active_detector and db.actor:active_detector() then
		return false
	end
	return true
end

-- RF receiver drawn (detector_radio). NERFS uses Shift+wheel for ±10 frequency.
local function rf_receiver_out()
	if not (db and db.actor and db.actor.active_detector) then
		return false
	end
	local det = db.actor:active_detector()
	if not det then
		return false
	end
	local ok, sec = pcall(function()
		return det:section()
	end)
	return ok and sec == "detector_radio"
end

local function rf_shift_blocks_zoom()
	return rf_receiver_out() and dogma.input.is_shift_down()
end

local function get_context()
	if actor_dead() then
		return CTX.DEAD
	end
	if any_menu_open() then
		return CTX.GUI
	end
	-- F8 debug / options / sleep / any Register_UI - not in MENU_BLOCK whitelist.
	if actor_menu and actor_menu.is_hud_free and not actor_menu.is_hud_free() then
		return CTX.GUI
	end
	if pda_blocking() then
		return CTX.PDA
	end
	refresh_wpn()
	-- Consumables (eat/drink/meds) lower the weapon - block free zoom either mode.
	if weapon_is_lowered() then
		return CTX.LOWERED
	end
	if CONFIG.loaded.empty_hands_only then
		if not hands_are_empty() then
			return CTX.HANDS_FULL
		end
		if not CONFIG.loaded.allow_during_sprint and actor_sprinting() then
			return CTX.SPRINT
		end
		return CTX.OK
	end
	-- Any equipped slot (gun, knife, detector, empty hands). Not firearm-only.
	if weapon_reloading() then
		return CTX.RELOAD
	end
	if is_optical_ads() then
		return CTX.OPTICAL
	end
	if not CONFIG.loaded.allow_during_sprint and actor_sprinting() then
		return CTX.SPRINT
	end
	return CTX.OK
end

-- true = we own world FOV; false = optical owns it (do not write world fov).
local function we_own_fov()
	return not (ads_on and CONFIG.loaded.ads_enabled and is_optical_ads())
end

local function hold_zoom_active()
	return hold_zoom_latched
end

local function pct_to_fov(pct)
	pct = pct or 0
	if pct > 40 then
		pct = 40
	end
	if pct <= 0 then
		return hip_fov
	end
	return hip_fov * (1 - pct / 100)
end

-- World FOV shrink %: ADS FOV zoom (irons/sight) or free%. Optical scopes keep engine FOV.
local function compute_world_pct()
	local pct = 0
	if ads_on and CONFIG.loaded.ads_enabled and we_own_fov() then
		pct = CONFIG.loaded.fov_zoom or 0
	elseif free_on then
		pct = CONFIG.loaded.free_zoom
	end
	if pct > 40 then
		pct = 40
	end
	return pct
end

local function compute_fov()
	if not we_own_fov() then
		return nil
	end
	return pct_to_fov(compute_world_pct())
end

-- Publish each system's target FOV; clear when inactive so the other is not stuck.
-- Only numbers count as floors - missing / non-numeric globals = no effect (other mod absent).
local function read_fov_tgt(name)
	local v = rawget(_G, name)
	if type(v) == "number" and v > 0 then
		return v
	end
	return nil
end

local function publish_fov_targets()
	-- Free never floors FOV while ADS - ADS Zoom owns world FOV; free state is cleared on enter.
	if free_on and not ads_on and (CONFIG.loaded.free_zoom or 0) > 0 then
		_G.dogma_fov_tgt_free = pct_to_fov(CONFIG.loaded.free_zoom)
	else
		_G.dogma_fov_tgt_free = nil
	end

	if ads_on and CONFIG.loaded.ads_enabled and we_own_fov() then
		_G.dogma_fov_tgt_ads = pct_to_fov(CONFIG.loaded.fov_zoom or 0)
	else
		_G.dogma_fov_tgt_ads = nil
	end
end

local function clear_fov_targets()
	_G.dogma_fov_tgt_free = nil
	_G.dogma_fov_tgt_ads = nil
end

-- Clamp zoom-out so we never pass the other system's more-zoomed floor (lower FOV).
-- While ADS owns world FOV, do not let free pull us to a deeper zoom.
local function clamp_fov_target(target)
	if target == nil then
		return nil
	end
	if ads_on and CONFIG.loaded.ads_enabled and we_own_fov() then
		return target
	end
	local floor = target
	local other_free = read_fov_tgt("dogma_fov_tgt_free")
	local other_ads = read_fov_tgt("dogma_fov_tgt_ads")
	if other_free ~= nil and other_free < floor then
		floor = other_free
	end
	if other_ads ~= nil and other_ads < floor then
		floor = other_ads
	end
	return floor
end

local function set_zoom_move_speed(active)
	-- Prefer shared speed.script on GAMMA; else our vendored Teepo copy.
	-- (Do not name the local `speed` - that shadows the global on the RHS.)
	local speed_mod = (speed and speed.add_speed and speed) or zzzz_dogma_gameplay_free_zoom_speed
	-- speed.add_speed needs db.actor; skip during on_game_start / early boot.
	if not (db and db.actor and speed_mod and speed_mod.add_speed) then
		return
	end
	if active then
		-- move_speed is % of normal speed while free-zoomed (0-70).
		local run_mult = CONFIG.loaded.move_speed / 100
		-- Sprint slowdown is 1/8 of the run slowdown.
		local sprint_mult = 1 - (1 - run_mult) * 0.125
		speed_mod.add_speed("dogma_freezoom_speed_run", run_mult, false, true)
		speed_mod.add_speed("dogma_freezoom_speed_sprint", sprint_mult, true, true)
	else
		speed_mod.add_speed("dogma_freezoom_speed_run", 1, false, true)
		speed_mod.add_speed("dogma_freezoom_speed_sprint", 1, true, true)
	end
end

local function restore_hip_hud()
	tgt_hud = hip_hud
	live_hud = hip_hud
	exec_console_cmd("hud_fov " .. hip_hud)
	we_wrote_hud = false
end

local function ensure_live_fov()
	if live_fov == nil then
		live_fov = get_console_cmd(2, "fov") or hip_fov
	end
	if live_hud == nil then
		live_hud = get_console_cmd(2, "hud_fov") or hip_hud
	end
end

local function write_world_fov(fov)
	mark("write_world_fov", string.format("fov=%.3f sens=%.4f", fov, fov * sens_per_fov))
	exec_console_cmd("fov " .. fov)
	exec_console_cmd("mouse_sens " .. fov * sens_per_fov)
	live_fov = fov
	we_wrote_fov = true
	mark("write_world_fov_done", string.format("fov=%.3f", fov))
end

local function write_hud_fov(hud)
	mark("write_hud_fov", string.format("hud=%.4f", hud))
	exec_console_cmd("hud_fov " .. hud)
	live_hud = hud
	we_wrote_hud = math.abs(hud - hip_hud) > 0.0005
	mark("write_hud_fov_done", string.format("hud=%.4f wrote=%s", hud, tostring(we_wrote_hud)))
end

-- Peripheral edge DOF via SSFX uniforms. Snapshot prior values; restore only if still ours.
local function read_dof_1_status()
	local c = get_console and get_console()
	if c and c.get_string then
		return c:get_string("ssfx_wpn_dof_1")
	end
	return get_console_cmd(0, "ssfx_wpn_dof_1")
end

local function read_dof_2()
	return get_console_cmd(2, "ssfx_wpn_dof_2") or 0
end

local function parse_dof_1_w(status)
	if type(status) ~= "string" then
		return nil
	end
	local w = status:match("%([%-%d%.eE]+,%s*[%-%d%.eE]+,%s*[%-%d%.eE]+,%s*([%-%d%.eE]+)%)")
	return w and tonumber(w) or nil
end

local function dof_still_ours()
	local w = parse_dof_1_w(read_dof_1_status())
	local edge = read_dof_2()
	if w == nil or dof_ours_blur == nil or dof_ours_edge == nil then
		return false
	end
	return math.abs(w - dof_ours_blur) < 0.02 and math.abs(edge - dof_ours_edge) < 0.02
end

local function write_zoom_dof(blur, edge)
	exec_console_cmd(string.format("ssfx_wpn_dof_1 (0.000,0.000,0.000,%.3f)", blur))
	exec_console_cmd(string.format("ssfx_wpn_dof_2 %.3f", edge))
	dof_ours_blur = blur
	dof_ours_edge = edge
end

local function restore_saved_dof()
	if dof_saved_1 then
		exec_console_cmd("ssfx_wpn_dof_1 " .. dof_saved_1)
	end
	if dof_saved_2 ~= nil then
		exec_console_cmd(string.format("ssfx_wpn_dof_2 %.6f", dof_saved_2))
	end
	dof_saved_1 = nil
	dof_saved_2 = nil
	dof_ours_blur = nil
	dof_ours_edge = nil
end

local function apply_zoom_dof()
	local intensity = 0
	if free_on and not ads_on and CONFIG.loaded.free_dof then
		intensity = CONFIG.loaded.free_dof_intensity or 0
	elseif ads_on and CONFIG.loaded.ads_enabled then
		local dof = CONFIG.loaded.ads_dof
		if dof and dof.enabled then
			local optic = optic_class()
			intensity = dof[optic] or 0
		end
	end
	if intensity > 0 then
		local blur = intensity * DOF_BLUR_AT_FULL
		local edge = intensity * DOF_EDGE_AT_FULL
		if not dof_we_own then
			dof_saved_1 = read_dof_1_status()
			dof_saved_2 = read_dof_2()
			dof_we_own = true
		end
		write_zoom_dof(blur, edge)
		return
	end
	if dof_we_own then
		-- Only undo ourselves; if SSS/another mod already rewrote, leave their values.
		if dof_still_ours() then
			restore_saved_dof()
		else
			dof_saved_1 = nil
			dof_saved_2 = nil
			dof_ours_blur = nil
			dof_ours_edge = nil
		end
		dof_we_own = false
	end
end

-- Desired HUD value for current free/ADS state.
local function compute_hud()
	local pct = 0
	if ads_on and CONFIG.loaded.ads_enabled then
		pct = resolve_ads()
	elseif free_on then
		pct = CONFIG.loaded.free_zoom
	end
	if pct <= 0 then
		return hip_hud
	end
	return hip_hud * (1 - pct / 100)
end

-- Set FOV/HUD targets from current mode. snap=true writes immediately (disable/death).
local function apply_fov(snap)
	if diag_hot then
		mark("apply_fov", string.format("snap=%s %s", tostring(not not snap), zoom_diag("pre")))
	else
		mark("apply_fov", string.format("snap=%s", tostring(not not snap)))
	end
	ensure_live_fov()
	publish_fov_targets()
	local fov = compute_fov()
	tgt_hud = compute_hud()
	if fov ~= nil then
		world_write = true
		tgt_fov = fov
	else
		-- Optical ADS: ease to hip, then stop writing so the scope owns FOV.
		world_write = true
		tgt_fov = hip_fov
	end
	if snap then
		local effective = clamp_fov_target(tgt_fov) or tgt_fov
		write_world_fov(effective)
		write_hud_fov(tgt_hud)
		if fov == nil then
			we_wrote_fov = false
			world_write = false
		end
		last_smooth_ms = time_global() or 0
	end
	mark("apply_fov_dof", string.format("tgt_fov=%s tgt_hud=%.4f", tgt_fov and string.format("%.2f", tgt_fov) or "nil", tgt_hud or -1))
	apply_zoom_dof()
	if diag_hot then
		mark("apply_fov_done", zoom_diag("post"))
	else
		mark("apply_fov_done", nil)
	end
end

local function poll_fov_smooth()
	local sformat = string.format
	local mabs = math.abs
	publish_fov_targets()
	if tgt_fov == nil and tgt_hud == nil then
		return
	end
	ensure_live_fov()
	local now = time_global() or 0
	local dt = 0.016
	if last_smooth_ms then
		dt = (now - last_smooth_ms) / 1000
		if dt < 0.001 then
			dt = 0.001
		elseif dt > 0.05 then
			dt = 0.05
		end
	end
	last_smooth_ms = now
	local k = 1 - math.exp(-FOV_SMOOTH_RATE * dt)
	local wrote = false

	if world_write and tgt_fov ~= nil and live_fov ~= nil then
		local effective = clamp_fov_target(tgt_fov) or tgt_fov
		local next_fov = live_fov + (effective - live_fov) * k
		if mabs(effective - next_fov) < 0.04 then
			next_fov = effective
		end
		if mabs(next_fov - live_fov) >= 0.001 then
			write_world_fov(next_fov)
			wrote = true
		elseif next_fov == effective then
			live_fov = next_fov
		end
		if next_fov == effective and not we_own_fov() then
			we_wrote_fov = false
			world_write = false
		end
	end

	if tgt_hud ~= nil and live_hud ~= nil then
		local next_hud = live_hud + (tgt_hud - live_hud) * k
		if mabs(tgt_hud - next_hud) < 0.0008 then
			next_hud = tgt_hud
		end
		if mabs(next_hud - live_hud) >= 0.00005 then
			write_hud_fov(next_hud)
			wrote = true
		else
			live_hud = next_hud
			we_wrote_hud = mabs(live_hud - hip_hud) > 0.0005
		end
	end

	-- While ADS is settling, log smooth ticks even if we skipped a write.
	if ads_on and ads_post_frames > 0 and ads_post_frames <= ADS_POST_LOG_FRAMES and not wrote then
		mark(
			"smooth_idle",
			sformat(
				"frame=%d live_fov=%s tgt_fov=%s live_hud=%s tgt_hud=%s",
				ads_post_frames,
				live_fov and sformat("%.2f", live_fov) or "nil",
				tgt_fov and sformat("%.2f", tgt_fov) or "nil",
				live_hud and sformat("%.3f", live_hud) or "nil",
				tgt_hud and sformat("%.3f", tgt_hud) or "nil"
			)
		)
	end
end

-- Hip baseline from options (not live console, which may already be zoomed).
local function sync_hip_from_options()
	local fov = ui_options and ui_options.get("video/basic/fov")
	local sens = ui_options and ui_options.get("control/general/mouse_sens")
	local hud = ui_options and ui_options.get("video/basic/hud_fov")
	hip_fov = fov or get_console_cmd(2, "fov") or 75
	hip_sens = sens or get_console_cmd(2, "mouse_sens") or 0.5
	hip_hud = hud or get_console_cmd(2, "hud_fov") or 0.6
	if hip_fov <= 0 then
		hip_fov = 75
	end
	if not hip_hud or hip_hud <= 0 then
		hip_hud = 0.6
	end
	sens_per_fov = hip_sens / hip_fov
end

-- Full reset: hip FOV, clear speed.
local function reset_session(resync_options, reason)
	local prev = mode_label()
	local had_hud = we_wrote_hud
	set_zoom_move_speed(false)
	free_on = false
	ads_on = false
	hold_zoom_latched = false
	clear_fov_targets()
	reset_scroll_accum()
	if resync_options then
		sync_hip_from_options()
	end
	apply_fov(true)
	if had_hud and not we_wrote_hud then
		restore_hip_hud()
	end
	we_wrote_fov = false
	world_write = false
	logf(
		"reset: reason=%s prev=%s resync=%s fov=%.2f",
		tostring(reason or "?"),
		prev,
		tostring(resync_options and true or false),
		hip_fov
	)
end

-- RELOAD always clears free (and ADS via handle_context).
local function blocks_free(ctx)
	return CTX_BLOCK_FREE[ctx] == true
end

local function clear_free_zoom(reason, defer_apply)
	if not free_on then
		return
	end
	logf("auto-out: leaving FREE because %s mode=%s", tostring(reason), mode_label())
	free_on = false
	reset_scroll_accum()
	set_zoom_move_speed(false)
	-- defer_apply: caller will apply so we don't snap free → intermediate → next.
	if not defer_apply then
		apply_fov()
	end
end

local function handle_context(ctx)
	if last_ctx ~= ctx then
		logf("ctx: %s -> %s mode=%s wpn=%s", tostring(last_ctx), ctx, mode_label(), wpn_label())
		last_ctx = ctx
	end

	if ctx == CTX.DISABLED or ctx == CTX.DEAD then
		if free_on or ads_on or hold_zoom_active() then
			reset_session(true, ctx)
		end
		return ctx
	end

	-- No gun / weapon lowered (medkit etc.): drop free + ADS so we don't fight use anims.
	if (ctx == CTX.NO_GUN or ctx == CTX.LOWERED) and (free_on or ads_on or hold_zoom_active()) then
		reset_session(false, ctx)
		return ctx
	end

	-- Reload / leave ADS path: always drop ADS zoom.
	if ctx == CTX.RELOAD and ads_on then
		ads_on = false
		logf("ads out: reason=reload wpn=%s", wpn_label())
		apply_fov()
	end

	-- Sprint / reload / GUI / etc.: drop free zoom; hold DIKs stay so poll re-applies when ok.
	-- ADS enter clears free in set_ads_zoom (state only - ADS Zoom owns FOV).
	if free_on and blocks_free(ctx) then
		clear_free_zoom(ctx)
	end
	return ctx
end

local function set_free_zoom(want_free, source)
	source = source or "set_free_zoom"
	if not CONFIG.loaded.enabled then
		return false
	end
	want_free = not not want_free
	local ctx = get_context()
	handle_context(ctx)

	if want_free then
		if ads_on then
			logf("free denied: source=%s reason=ads mode=%s", source, mode_label())
			return false
		end
		ctx = get_context()
		if blocks_free(ctx) then
			logf("free denied: source=%s reason=ctx=%s mode=%s", source, ctx, mode_label())
			return false
		end
		if CONFIG.loaded.free_zoom <= 0 then
			logf("free denied: source=%s reason=free_zoom=0%% mode=%s", source, mode_label())
			return false
		end
		if free_on then
			return true
		end
		free_on = true
	else
		if not free_on then
			return false
		end
		free_on = false
		reset_scroll_accum()
	end

	set_zoom_move_speed(free_on)
	apply_fov()
	local fov = compute_fov()
	logf(
		"free: source=%s mode=%s fov=%s free=%d%% wpn=%s",
		source,
		mode_label(),
		fov and string.format("%.2f", fov) or "optical",
		CONFIG.loaded.free_zoom,
		wpn_label()
	)
	return true
end

-- ADS on/off. Clear free state on enter so we do not resume free zoom after ADS;
-- FOV/HUD are handed to ADS Zoom (free does not write its own %).
local function set_ads_zoom(want_ads, source)
	source = source or "set_ads_zoom"
	want_ads = not not want_ads

	if want_ads then
		if ads_on then
			return false
		end
		if not CONFIG.loaded.ads_enabled then
			logf("ads skipped: source=%s ads_zoom disabled wpn=%s", source, wpn_label())
			return false
		end
		diag_hot_begin("ads_enter:" .. tostring(source))
		mark("ads_enter_pre", zoom_diag("pre"), true)
		-- Drop free state without applying FOV - ADS apply below owns the transition.
		clear_free_zoom("ads", true)
		ads_on = true
		ads_enter_ms = (time_global and time_global()) or 0
		ads_post_frames = 0
		-- Optical: ease world FOV to hip, then stop writing (scope owns it).
		if is_optical_ads() then
			mark("ads_enter_optical", nil, true)
			apply_fov()
			local hud = resolve_ads()
			logf(
				"ads: source=%s mode=%s optical=true hud=%d%% wpn=%s",
				source,
				mode_label(),
				hud,
				wpn_label()
			)
			mark("ads_enter_done_optical", zoom_diag("post"), true)
			return true
		end
		mark("ads_enter_apply_fov", nil, true)
		apply_fov()
	else
		if not ads_on then
			return false
		end
		diag_hot_begin("ads_exit:" .. tostring(source))
		mark("ads_exit_pre", zoom_diag("pre"), true)
		ads_on = false
		apply_fov()
	end

	local fov = compute_fov()
	local hud = resolve_ads()
	logf(
		"ads: source=%s mode=%s fov=%s fov_zoom=%d%% hud=%d%% free_on=%s wpn=%s",
		source,
		mode_label(),
		fov and string.format("%.2f", fov) or "optical",
		CONFIG.loaded.fov_zoom or 0,
		hud,
		tostring(free_on),
		wpn_label()
	)
	mark(want_ads and "ads_enter_done" or "ads_exit_done", zoom_diag("post"), true)
	return true
end

-- Drop free + ADS and restore hip FOV (weapon lower / death / opts / etc.).
local function reset_zoom(reason)
	if not free_on and not ads_on then
		reset_scroll_accum()
		return
	end
	logf("zoom reset: reason=%s was=%s", tostring(reason), mode_label())
	reset_session(false, reason)
end

-- Weapon / detector / slot swaps: keep free zoom; ADS is gun-specific so drop it.
-- Draw/holster often snaps console FOV - resync live so smooth re-applies free zoom.
local function on_equipment_swap(reason)
	local had_ads = ads_on
	if ads_on then
		logf("ads out: reason=%s keep_free=%s wpn=%s", tostring(reason), tostring(free_on), wpn_label())
		ads_on = false
	end
	if free_on then
		live_fov = get_console_cmd(2, "fov") or live_fov
		live_hud = get_console_cmd(2, "hud_fov") or live_hud
		apply_fov()
	elseif had_ads then
		apply_fov()
	end
end

local function is_weapon_slot_bind(bind)
	if not bind or not key_bindings then
		return false
	end
	return bind == key_bindings.kWPN_1
		or bind == key_bindings.kWPN_2
		or bind == key_bindings.kWPN_3
		or bind == key_bindings.kWPN_4
		or bind == key_bindings.kWPN_5
		or bind == key_bindings.kWPN_6
end

-- Fires on the keypress itself - earliest hook for 1/2/3 slot swaps.
local function on_before_key_press(key, bind, dis, flags)
	if not CONFIG.loaded.enabled and not CONFIG.loaded.ads_enabled then
		return
	end
	if not bind then
		bind = dik_to_bind(key)
	end
	if is_weapon_slot_bind(bind) then
		on_equipment_swap("slot_key")
	end
end

-- Slot change from wheel / scripts / anything that bypasses our key hook.
-- Engine sometimes fires this during ADS / anims without a real item swap - ignore those.
local function actor_on_changed_slot(new_slot, new_obj, prev_slot, prev_obj)
	local tostr = tostring
	if not CONFIG.loaded.enabled and not CONFIG.loaded.ads_enabled then
		return
	end
	if new_slot == prev_slot then
		return
	end
	local function obj_id(obj)
		if not obj then
			return nil
		end
		local ok, id = pcall(function()
			return obj:id()
		end)
		if ok then
			return id
		end
		return nil
	end
	local new_id = obj_id(new_obj)
	local prev_id = obj_id(prev_obj)
	if new_id and prev_id and new_id == prev_id then
		logf(
			"changed_slot ignored: same item id=%s slot %s->%s",
			tostr(new_id),
			tostr(prev_slot),
			tostr(new_slot)
		)
		return
	end
	-- Still aiming / free-zoomed with the same tracked item: not a real swap.
	if (ads_on or free_on) and last_item_id then
		refresh_wpn()
		local cur = active_item_id()
		if cur and cur == last_item_id then
			logf(
				"changed_slot ignored: still holding id=%s slot %s->%s",
				tostr(cur),
				tostr(prev_slot),
				tostr(new_slot)
			)
			return
		end
	end
	on_equipment_swap("changed_slot")
end

local function on_active_item_changed(prev_id, new_id, prev_sec, new_sec)
	local tostr = tostring
	logf(
		"item change: id %s->%s sec %s->%s",
		tostr(prev_id),
		tostr(new_id),
		tostr(prev_sec),
		tostr(new_sec)
	)
	on_equipment_swap("item_change")
end

local function actor_on_weapon_lower(_wpn)
	if not CONFIG.loaded.enabled and not CONFIG.loaded.ads_enabled then
		return
	end
	reset_zoom("weapon_lower")
end

local function on_option_change()
	local tostr = tostring
	refresh_config()
	reset_scroll_accum()

	if not CONFIG.loaded.enabled and not CONFIG.loaded.ads_enabled then
		reset_session(true, "disabled")
		UnregisterScriptCallback("on_mouse_wheel", on_mouse_wheel)
		log("opts: free+ads disabled; hip FOV restored, scroll callback off")
		return
	end

	sync_hip_from_options()
	-- Leave free/ADS zoom whenever options change (ours or video FOV / sens).
	reset_session(false, "opts")

	UnregisterScriptCallback("on_mouse_wheel", on_mouse_wheel)
	if CONFIG.loaded.enabled and CONFIG.loaded.scroll_wheel_zoom then
		RegisterScriptCallback("on_mouse_wheel", on_mouse_wheel)
	end

	logf(
		"opts: free_en=%s free=%d%% free_dof=%s/%.2f ads_fov=%d%% ads_dof=%s/%.2f/%.2f/%.2f hud=%d/%d/%d speed=%d%% sprint=%s empty_hands=%s scroll=%s reverse=%s steps=%d gap=%dms mode=%s key=%s mod=%d km=%d rmb=%d mmb=%d",
		tostr(CONFIG.loaded.enabled),
		CONFIG.loaded.free_zoom,
		tostr(CONFIG.loaded.free_dof),
		CONFIG.loaded.free_dof_intensity or 0,
		CONFIG.loaded.fov_zoom,
		tostr(CONFIG.loaded.ads_dof and CONFIG.loaded.ads_dof.enabled),
		(CONFIG.loaded.ads_dof and CONFIG.loaded.ads_dof.irons) or 0,
		(CONFIG.loaded.ads_dof and CONFIG.loaded.ads_dof.sight) or 0,
		(CONFIG.loaded.ads_dof and CONFIG.loaded.ads_dof.scope) or 0,
		CONFIG.loaded.wads.irons,
		CONFIG.loaded.wads.sight,
		CONFIG.loaded.wads.scope,
		CONFIG.loaded.move_speed,
		tostr(CONFIG.loaded.allow_during_sprint),
		tostr(CONFIG.loaded.empty_hands_only),
		tostr(CONFIG.loaded.scroll_wheel_zoom),
		tostr(CONFIG.loaded.scroll_wheel_reverse),
		CONFIG.loaded.scroll_wheel_steps,
		CONFIG.loaded.scroll_wheel_max_gap_ms,
		mode_label(),
		tostr(CONFIG.loaded.zoom_key),
		CONFIG.loaded.zoom_key_modifier,
		CONFIG.loaded.zoom_key_mode,
		CONFIG.loaded.rmb_zoom,
		CONFIG.loaded.mmb_zoom
	)
end

local function actor_on_first_update()
	if not dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		log("first_update: DOGMA not ready yet")
		return
	end
	sync_hip_from_options()
	apply_fov()
	logf(
		"first_update: ready fov=%.2f sens=%.3f mode=%s",
		hip_fov,
		hip_sens,
		mode_label()
	)
end

local function wads_mod_ok()
	return dogma.input.is_mod_down(CONFIG.loaded.wads_key_modifier or 0)
end

local OPTIC_FEED = {
	irons = "Irons",
	sight = "Sights",
	scope = "Scopes",
}

-- Brief on-screen current HUD zoom % when ± / reset fires (not debug-gated).
local function show_wads_level()
	local pct, _, optic = resolve_ads()
	local label = OPTIC_FEED[optic] or tostring(optic)
	local msg = string.format("%s HUD: %d%%", label, pct)
	if actor_menu and actor_menu.set_msg then
		actor_menu.set_msg(1, msg, 1.5)
	elseif news_manager and news_manager.send_tip and db.actor then
		news_manager.send_tip(db.actor, msg, nil, nil, 1500)
	end
end

local function mutate_wads(delta_or_reset, source)
	if not (CONFIG.loaded.ads_enabled and ads_on) then
		return false
	end
	refresh_wpn()
	local okey = override_key()
	if not okey then
		logf("wads denied: source=%s no weapon", tostring(source))
		return false
	end
	local cur, cat, optic, def, ov = resolve_ads()
	if delta_or_reset == "reset" then
		if ov == nil then
			return false
		end
		gun_scope_override[okey] = nil
		logf("wads reset: key=%s cat=%s optic=%s def=%d%%", okey, cat, optic, def)
	else
		local base = ov ~= nil and ov or def
		local next_pct = clamp(base + delta_or_reset, 0, ads_cap(optic))
		if next_pct == ov then
			return false
		end
		-- Match MCM default → drop override so slider edits still apply.
		if next_pct == def then
			gun_scope_override[okey] = nil
		else
			gun_scope_override[okey] = next_pct
		end
		logf(
			"wads: source=%s key=%s %d%% -> %s (def=%d%% cat=%s optic=%s)",
			tostring(source),
			okey,
			cur,
			tostring(gun_scope_override[okey] or def),
			def,
			cat,
			optic
		)
	end
	apply_fov()
	show_wads_level()
	return true
end

-- Forward decl (defined with key handlers below).
local poll_zoom_input

local function actor_on_update()
	if not dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return
	end
	if not CONFIG.loaded.enabled and not CONFIG.loaded.ads_enabled then
		return
	end

	local hot = diag_hot_on_update()

	refresh_wpn()
	local id = active_item_id()
	if id ~= last_item_id then
		local prev_id = last_item_id
		local prev_sec = last_item_sec
		last_item_id = id
		last_item_sec = active_item_sec()
		on_active_item_changed(prev_id, id, prev_sec, last_item_sec)
	end

	if CONFIG.loaded.enabled or (CONFIG.loaded.ads_enabled and ads_on) then
		handle_context(get_context())
	end
	poll_zoom_input()
	if hot then
		mark("update_before_smooth", nil)
	end
	poll_fov_smooth()
	-- Re-assert zoom DOF each tick (SSS aim_in/out also writes ssfx_wpn_dof_*).
	if hot then
		mark("update_before_dof", nil)
	end
	apply_zoom_dof()
	if hot then
		mark("update_frame_done", nil)
	end
	diag_hot_end_if_due()
end

-- zoom_key_mode: 0=toggle, 2=hold (in on down, out on up).
-- modifier 0 = no extra modifier required (not "forbid Shift/Ctrl/Alt").
local function zoom_mod_ok()
	return dogma.input.is_mod_down(CONFIG.loaded.zoom_key_modifier or 0)
end

local function keys_blocked_ctx()
	local ctx = get_context()
	if ctx == CTX.DISABLED or ctx == CTX.DEAD or ctx == CTX.PDA then
		return ctx
	end
	return nil
end

local function key_ok(dik)
	return dik and dik >= 0
end

local function hold_source_down()
	if CONFIG.loaded.rmb_zoom == MOUSE_HOLD and dogma.input.is_key_down(DIK_RMB) then
		return true
	end
	if CONFIG.loaded.mmb_zoom == MOUSE_HOLD and dogma.input.is_key_down(DIK_MMB) then
		return true
	end
	local key = CONFIG.loaded.zoom_key
	if CONFIG.loaded.zoom_key_mode == MODE_HOLD and key_ok(key) and dogma.input.is_key_down(key) and zoom_mod_ok() then
		return true
	end
	return false
end

local function try_wads_keys()
	if not CONFIG.loaded.ads_enabled or not ads_on then
		return
	end
	if not wads_mod_ok() then
		return
	end
	local inc = CONFIG.loaded.wads_inc_key
	local dec = CONFIG.loaded.wads_dec_key
	local reset = CONFIG.loaded.wads_reset_key
	if key_ok(reset) and dogma.input.is_key_pressed(reset) then
		mutate_wads("reset", "wads_reset")
		return
	end
	if key_ok(inc) and dogma.input.is_key_pressed(inc) then
		mutate_wads(WADS_STEP, "wads_press")
		return
	end
	if key_ok(dec) and dogma.input.is_key_pressed(dec) then
		mutate_wads(-WADS_STEP, "wads_press")
	end
end

local function try_toggle_keys()
	if not CONFIG.loaded.enabled then
		return
	end
	local blocked = keys_blocked_ctx()

	if CONFIG.loaded.rmb_zoom == MOUSE_TOGGLE and dogma.input.is_key_pressed(DIK_RMB) then
		if blocked then
			logf("mouse ignored: key=%s ctx=%s mode=%s", tostring(DIK_RMB), blocked, mode_label())
		else
			logf("mouse: toggle key=%s mode=%s", tostring(DIK_RMB), mode_label())
			set_free_zoom(not free_on, "mouse_toggle")
		end
		return
	end
	if CONFIG.loaded.mmb_zoom == MOUSE_TOGGLE and dogma.input.is_key_pressed(DIK_MMB) then
		if blocked then
			logf("mouse ignored: key=%s ctx=%s mode=%s", tostring(DIK_MMB), blocked, mode_label())
		else
			logf("mouse: toggle key=%s mode=%s", tostring(DIK_MMB), mode_label())
			set_free_zoom(not free_on, "mouse_toggle")
		end
		return
	end

	local key = CONFIG.loaded.zoom_key
	if CONFIG.loaded.zoom_key_mode ~= MODE_HOLD and key_ok(key) and dogma.input.is_key_pressed(key) then
		if blocked then
			logf("key ignored: key=%s ctx=%s mode=%s", tostring(key), blocked, mode_label())
			return
		end
		if not zoom_mod_ok() then
			return
		end
		logf("key: toggle (mode=%s)", mode_label())
		set_free_zoom(not free_on, "key_toggle")
	end
end

local function poll_hold_zoom()
	if not CONFIG.loaded.enabled then
		hold_zoom_latched = false
		return
	end
	local down = hold_source_down()
	if down then
		hold_zoom_latched = true
		if not free_on then
			set_free_zoom(true, "hold")
		end
	elseif hold_zoom_latched then
		hold_zoom_latched = false
		set_free_zoom(false, "hold_release")
	end
end

poll_zoom_input = function()
	try_wads_keys()
	poll_hold_zoom()
	try_toggle_keys()
end

on_mouse_wheel = function(dir, _flags)
	if not CONFIG.loaded.enabled or not CONFIG.loaded.scroll_wheel_zoom then
		return
	end
	if not (db and db.actor) then
		return
	end

	-- Let RF (NERFS) own Shift+wheel for coarse tuning while the receiver is out.
	if rf_shift_blocks_zoom() then
		reset_scroll_accum()
		return
	end

	local ctx = get_context()
	if CTX_SCROLL_PASS[ctx] then
		reset_scroll_accum()
		return
	end

	-- Reload: always zoom out; do not steal the wheel.
	if ctx == CTX.RELOAD then
		reset_scroll_accum()
		return
	end

	local want_in = (dir == 1)
	if CONFIG.loaded.scroll_wheel_reverse then
		want_in = not want_in
	end

	local now = time_global() or 0
	if scroll_want_in ~= want_in or (scroll_last_ms > 0 and (now - scroll_last_ms) > CONFIG.loaded.scroll_wheel_max_gap_ms) then
		scroll_accum = 0
		scroll_want_in = want_in
	end
	scroll_accum = scroll_accum + 1
	scroll_last_ms = now

	if scroll_accum >= CONFIG.loaded.scroll_wheel_steps then
		reset_scroll_accum()
		logf("scroll: fire want_in=%s steps=%d mode=%s", tostring(want_in), CONFIG.loaded.scroll_wheel_steps, mode_label())
		if want_in then
			set_free_zoom(true, "scroll")
		else
			set_free_zoom(false, "scroll")
		end
	end
end

local function actor_on_weapon_zoom_in()
	if not CONFIG.loaded.ads_enabled then
		return
	end
	if ads_on then
		return
	end

	mark("cb_zoom_in_enter", nil, true)
	refresh_wpn()
	if not (wpn and wpn:cast_Weapon()) then
		logf("ADS in ignored: no weapon (wpn=%s mode=%s)", wpn_label(), mode_label())
		mark("cb_zoom_in_ignored", zoom_diag("no_wpn"), true)
		return
	end

	logf("ADS in: wpn=%s from_mode=%s", wpn_label(), mode_label())
	set_ads_zoom(true, "zoom_in")
	-- If the process dies after this line, the crash is in engine zoom_in after our callback.
	mark("cb_zoom_in_return_to_engine", zoom_diag("callback_done"), true)
end

local function actor_on_weapon_zoom_out()
	if not ads_on then
		return
	end
	mark("cb_zoom_out_enter", nil, true)
	refresh_wpn()
	logf("ADS out: wpn=%s mode=%s", wpn_label(), mode_label())
	set_ads_zoom(false, "zoom_out")
	mark("cb_zoom_out_return_to_engine", zoom_diag("callback_done"), true)
end

-- Optical <-> iron: re-assert ADS FOV ownership (free already cleared on ADS enter).
local function actor_on_weapon_zoom_type_changed()
	if not CONFIG.loaded.ads_enabled or not ads_on then
		return
	end
	diag_hot_begin("zoom_type_changed")
	mark("cb_zoom_type_enter", zoom_diag("pre"), true)
	refresh_wpn()
	apply_fov()
	if is_optical_ads() then
		logf("ADS type changed: optical=true wads=%d%% wpn=%s", resolve_ads(), wpn_label())
		mark("cb_zoom_type_done", zoom_diag("optical"), true)
		return
	end
	local fov = compute_fov()
	logf(
		"ADS type changed: optical=false mode=%s fov=%s wads=%d%% wpn=%s",
		mode_label(),
		fov and string.format("%.2f", fov) or "?",
		resolve_ads(),
		wpn_label()
	)
	mark("cb_zoom_type_done", zoom_diag("iron_sight"), true)
end

local function actor_on_weapon_reload()
	if not CONFIG.loaded.enabled then
		return
	end
	logf("reload: mode=%s wpn=%s", mode_label(), wpn_label())
	handle_context(CTX.RELOAD)
end

local function on_actor_menu_open(name)
	if not MENU_BLOCK[name] then
		return
	end
	menus_open[name] = true
	reset_scroll_accum()
	logf("gui open: %s mode=%s", name, mode_label())
	handle_context(get_context())
end

local function on_actor_menu_close(name)
	if not MENU_BLOCK[name] then
		return
	end
	menus_open[name] = false
	logf("gui close: %s", name)
end

local function actor_on_before_death()
	reset_session(true, "before_death")
end

local function actor_on_net_destroy()
	reset_session(true, "net_destroy")
	wpn = nil
	last_item_sec = nil
	last_item_id = nil
	last_ctx = nil
	menus_open = {}
end

local function on_save_state(m_data)
	if not m_data then
		return
	end
	if next(gun_scope_override) then
		local snap = {}
		for k, v in pairs(gun_scope_override) do
			snap[k] = v
		end
		m_data.dogma_free_zoom_wads = snap
	else
		m_data.dogma_free_zoom_wads = nil
	end
end

local function on_load_state(m_data)
	gun_scope_override = {}
	if not (m_data and m_data.dogma_free_zoom_wads) then
		return
	end
	for k, v in pairs(m_data.dogma_free_zoom_wads) do
		if type(k) == "string" and type(v) == "number" then
			gun_scope_override[k] = clamp(v, 0, 50)
		end
	end
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)

	-- Fill CONFIG.loaded before registering callbacks (empty until refresh_config).
	on_option_change()

	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("on_before_key_press", on_before_key_press)
	RegisterScriptCallback("actor_on_weapon_zoom_out", actor_on_weapon_zoom_out)
	RegisterScriptCallback("actor_on_weapon_zoom_in", actor_on_weapon_zoom_in)
	RegisterScriptCallback("actor_on_weapon_reload", actor_on_weapon_reload)
	RegisterScriptCallback("actor_on_weapon_zoom_type_changed", actor_on_weapon_zoom_type_changed)
	RegisterScriptCallback("actor_on_weapon_lower", actor_on_weapon_lower)
	RegisterScriptCallback("actor_on_changed_slot", actor_on_changed_slot)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_before_death", actor_on_before_death)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	RegisterScriptCallback("GUI_on_show", on_actor_menu_open)
	RegisterScriptCallback("GUI_on_hide", on_actor_menu_close)
	RegisterScriptCallback("save_state", on_save_state)
	RegisterScriptCallback("load_state", on_load_state)

	log("on_game_start: callbacks registered")
end
