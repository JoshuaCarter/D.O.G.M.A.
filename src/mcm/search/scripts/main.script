--[[
	Dorn's QoL — live MCM search.

	Empty search box by default; filters the left mod list as you type;
	keeps keyboard focus in the box after each rebuild.
]]

-- Debounce tree rebuilds while typing (Register_Tree is not free on big lists).
local SEARCH_DEBOUNCE_MS = 100

local HOOK_STATE = _G.__dorn_qol_mcm_search_hooks or {}
_G.__dorn_qol_mcm_search_hooks = HOOK_STATE

local function search_text(self)
	local t = self.mod_search and self.mod_search:GetText() or ""
	local placeholder = game.translate_string("ui_mcm_menu_search")
	if t == placeholder then
		return ""
	end
	return t
end

local function apply_search(self, keep_focus)
	local t = search_text(self)
	local filter = (t ~= "" and t) or nil
	if filter == self.search_filter then
		return
	end
	self.search_filter = filter
	-- Addon tree lives on the ui_mcm module (same file as the class).
	self:Register_Tree(1, "", ui_mcm.options, 1)
	if keep_focus and self.mod_search then
		self.mod_search:CaptureFocus(true)
	end
end

local function clear_search_box(self)
	if self.mod_search then
		self.mod_search:SetText("")
	end
	self.search_filter = nil
	self._dorn_qol_want = nil
	self._dorn_qol_due = nil
end

local function patch_mcm_search()
	if HOOK_STATE.patched then
		return true
	end
	-- MCM class is ui_mcm.UI_MCM (see ui_main_menu: ui_mcm.UI_MCM()).
	local cls = ui_mcm and ui_mcm.UI_MCM
	if not (cls and cls.InitControls and cls.Update and cls.OnSearch and cls.Open_to) then
		return false
	end

	local orig_init = cls.InitControls
	local orig_open = cls.Open_to
	local orig_search = cls.OnSearch
	local orig_update = cls.Update

	cls.InitControls = function(self)
		orig_init(self)
		clear_search_box(self)
	end

	cls.Open_to = function(self, path)
		orig_open(self, path)
		-- Stock Open_to already cleared the filter and rebuilt; only strip the placeholder.
		if self.mod_search then
			self.mod_search:SetText("")
			self._dorn_qol_want = nil
			self._dorn_qol_due = nil
		end
	end

	cls.OnSearch = function(self)
		apply_search(self, true)
	end

	cls.Update = function(self)
		orig_update(self)
		if not self.mod_search then
			return
		end

		local t = search_text(self)
		local want = (t ~= "" and t) or nil
		if want ~= self._dorn_qol_want then
			self._dorn_qol_want = want
			self._dorn_qol_due = time_continual() + SEARCH_DEBOUNCE_MS
		end

		if self._dorn_qol_due and time_continual() >= self._dorn_qol_due then
			self._dorn_qol_due = nil
			apply_search(self, true)
		end
	end

	HOOK_STATE.patched = true
	return true
end

function on_game_start()
	if not patch_mcm_search() then
		printf("[dorn_qol] ui_mcm.UI_MCM missing — MCM search patch skipped")
	end
end
