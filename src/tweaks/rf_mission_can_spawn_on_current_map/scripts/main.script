--[[
	RF Receiver packages (Tweaki_Breeki / Cookbook / GAMMA Economy):

	Stock picks the package map from tb_allmaps[current_level], which is only
	neighbouring maps - never the map you are standing on. Spot pick itself is
	already a flat random among tb_package_coords (no far-from-player filter).

	Add the current level into each map's pool (when it has coords) so a package
	can spawn on your map, including right next to you if the roll lands there.
]]

local function has_coords(map)
	local spots = tb_package_coords and tb_package_coords[map]
	return type(spots) == "table" and #spots > 0
end

local function list_has(list, map)
	for i = 1, #list do
		if list[i] == map then
			return true
		end
	end
	return false
end

local function allow_same_map_spawns()
	if type(tb_allmaps) ~= "table" then
		return false
	end
	for level_id, maps in pairs(tb_allmaps) do
		if level_id ~= "default" and type(maps) == "table" and has_coords(level_id) then
			if not list_has(maps, level_id) then
				maps[#maps + 1] = level_id
			end
		end
	end
	return true
end

local function log_same_map_spawn(source)
	if not (level and level.name and tb_package_in_level) then
		return
	end
	local here = level.name()
	if tb_package_in_level ~= here then
		return
	end
	dogma.console.say(string.format("RF package spawned on current map (%s, %s)", here, source or "spawn"), "blue")
end

local function hook_tb_spawn()
	if type(tb_radio_thing) ~= "function" or tb_radio_thing.__dogma_rf_same_map then
		return type(tb_radio_thing) == "function"
	end
	local orig_radio = tb_radio_thing
	function tb_radio_thing()
		local ok = orig_radio()
		if ok then
			log_same_map_spawn("tb_radio_thing")
		end
		return ok
	end
	tb_radio_thing.__dogma_rf_same_map = true

	if type(failsafepackagespawn) == "function" and not failsafepackagespawn.__dogma_rf_same_map then
		local orig_fail = failsafepackagespawn
		function failsafepackagespawn()
			local ok = orig_fail()
			if ok then
				log_same_map_spawn("failsafe")
			end
			return ok
		end
		failsafepackagespawn.__dogma_rf_same_map = true
	end
	return true
end

-- TB_RF_Receiver_Packages.script loads earlier (no zzzz_); patch once here.
allow_same_map_spawns()

function on_game_start()
	dogma.load("dogma/tweaks/rf_mission_can_spawn_on_current_map")
	local function refresh()
		allow_same_map_spawns()
		hook_tb_spawn()
	end
	refresh()
	RegisterScriptCallback("on_game_load", refresh)
	CreateTimeEvent("dogma_rf_receiver", "allow_same_map", 0.1, function()
		refresh()
		return true
	end)
end
