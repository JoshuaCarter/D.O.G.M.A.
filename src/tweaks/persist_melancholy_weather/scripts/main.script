--[[
	Persist Melancholy Weather

	Keep the saved cycle (sunny stays sunny) across save/load. Day/night and
	Melancholy's own later transitions are the engine/scheduler.

	Named failure: load a sunny save and the sky is overcast until the next hour.
	Call path: Melancholy apply_loaded_state uses set_weather(..., false).
	We set the saved preset once on first update, when the clock is live.
]]

local CONFIG = _G.dogma_tweaks_persist_melancholy_weather_conf
local PAGE = CONFIG.MCM_PAGE
local DEFS = CONFIG.DEFAULTS

local HOOK_STATE = _G.__dogma_tweaks_persist_melancholy_weather_hooks or {}
_G.__dogma_tweaks_persist_melancholy_weather_hooks = HOOK_STATE

local function log(fmt, ...)
	local msg = string.format(fmt, ...)
	if dogma and dogma.dbg then
		dogma.dbg.log(CONFIG.MOD_ID, msg)
	else
		printf("[dogma_tweaks_persist_melancholy_weather] %s", msg)
	end
end

local function persist_on()
	return dogma.mcm.bool(PAGE, "persist_melancholy_weather", DEFS.persist_melancholy_weather)
end

local function current_preset(self)
	return self.weather_file or self.preset or self.natural_preset
end

local function outdoor(self)
	return self.is_outdoor_weather and self:is_outdoor_weather()
end

local function wfx(self)
	if self.wfx_active then
		return self:wfx_active()
	end
	return level.is_wfx_playing and level.is_wfx_playing()
end

local function restore(self)
	if not persist_on() or not outdoor(self) or wfx(self) then
		return
	end
	if weather and weather.is_paused and weather.is_paused() then
		return
	end
	local preset = current_preset(self)
	if not preset then
		return
	end
	level.set_weather(preset, true)
	log("restore preset=%s", tostring(preset))
	if dogma.console and dogma.console.say then
		dogma.console.say("Melancholy weather restored: " .. tostring(preset), "blue")
	end
end

local function patch()
	if HOOK_STATE.patched then
		return true
	end
	local WM = level_weathers and level_weathers.WeatherManager
	if not (WM and WM.load_state) then
		return false
	end

	local orig_load = WM.load_state
	WM.load_state = function(self, m_data, ...)
		local ret = orig_load(self, m_data, ...)
		HOOK_STATE.pending_load = persist_on()
		return ret
	end

	HOOK_STATE.patched = true
	log("patched WeatherManager load_state")
	return true
end

local function on_first_update()
	if not HOOK_STATE.pending_load then
		return
	end
	HOOK_STATE.pending_load = false
	local mgr = level_weathers.get_weather_manager and level_weathers.get_weather_manager()
	if mgr then
		restore(mgr)
	end
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	HOOK_STATE.pending_load = false
	if not patch() then
		log("Melancholy WeatherManager missing - persist skipped")
		return
	end
	RegisterScriptCallback("actor_on_first_update", on_first_update)
end
