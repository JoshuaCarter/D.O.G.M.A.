		text = "Faster Skinning",
		gr = {
			{
				id = "main",
				sh = true,
				text = "Main",
				gr = dogma_mcm.with_header({
					{
						id = "enabled",
						type = "check",
						val = 1,
						def = D["main/enabled"],
						hint = "dogma_faster_skinning_enabled",
					},
					{
						id = "skin_speed_multiplier",
						type = "track",
						val = 2,
						min = 1,
						max = 2,
						step = 0.1,
						def = D["main/skin_speed_multiplier"],
						hint = "dogma_faster_skinning_skin_speed_multiplier",
					},
					{
						id = "auto_crouch",
						type = "check",
						val = 1,
						def = D["main/auto_crouch"],
						hint = "dogma_faster_skinning_auto_crouch",
					},
					{
						id = "look_at_mutant",
						type = "check",
						val = 1,
						def = D["main/look_at_mutant"],
						hint = "dogma_faster_skinning_look_at_mutant",
					},
					{
						id = "look_at_offset",
						type = "track",
						val = 2,
						min = 0,
						max = 1,
						step = 0.05,
						def = D["main/look_at_offset"],
						hint = "dogma_faster_skinning_look_at_offset",
					},
					{
						id = "slash_loot",
						type = "check",
						val = 1,
						def = D["main/slash_loot"],
						hint = "dogma_faster_skinning_slash_loot",
					},
				}),
			},
			{
				id = "development",
				sh = true,
				text = "Development",
				gr = dogma_mcm.with_header({
					{
						id = "debug_log",
						type = "check",
						val = 1,
						def = D["development/debug_log"],
						hint = "dogma_faster_skinning_debug_log",
					},
				}),
