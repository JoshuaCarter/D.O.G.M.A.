-- Pose Controls MCM
-- Crouch / prone / sprint / walk + Hold/Toggle live-read/write Options->Controls.

local CONFIG = _G.dogma_input_pose_controls_conf
local KM = __dogma_key_mirror_mcm

local WALK_MIRROR = nil
do
	local spec = CONFIG.BINDS and CONFIG.BINDS.walk
	if spec and KM then
		WALK_MIRROR = KM.mirror_spec(spec)
	end
end

local function curr_hold_toggle()
	return (get_console_cmd(1, "g_crouch_toggle") and 1) or 0
end

local function set_hold_toggle(mode)
	local word = (tonumber(mode) == 1) and "1" or "0"
	exec_console_cmd("g_crouch_toggle " .. word)
	exec_console_cmd("g_walk_toggle " .. word)
	exec_console_cmd("g_sprint_toggle " .. word)
	exec_console_cmd("cfg_save")
end

function on_mcm_load(options)
	local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
	local gr = {
		{
			id = "page_description",
			type = "desc",
			text = "ui_mcm_dogma_input_pose_controls_main_description",
		},
		{
			id = "hold_toggle",
			type = kb_mod,
			val = 2,
			def = 0,
			curr = { curr_hold_toggle },
			functor = { set_hold_toggle },
			hint = "dogma_input_pose_controls_hold_toggle",
			content = {
				{ 0, "hold" },
				{ 1, "toggle" },
			},
		},
		{ id = "line_keys", type = "line" },
		{
			id = "keys_desc",
			type = "desc",
			text = "ui_mcm_dogma_input_pose_controls_keys_desc",
		},
		dogma_mcm.mcm.key_mirror("sprint_toggle", function()
			return key_bindings and (key_bindings.kSPRINT_TOGGLE or key_bindings.kSPRINT)
		end):option("sprint_key", "dogma_input_pose_controls_sprint_key"),
	}
	if WALK_MIRROR then
		gr[#gr + 1] = WALK_MIRROR:option("walk_key", "dogma_input_pose_controls_walk_key")
	end
	gr[#gr + 1] = dogma_mcm.mcm.key_mirror("crouch", function()
		return key_bindings and key_bindings.kCROUCH
	end):option("crouch_key", "dogma_input_pose_controls_crouch_key")
	gr[#gr + 1] = dogma_mcm.mcm.key_mirror("accel", function()
		return key_bindings and key_bindings.kACCEL
	end):option("prone_key", "dogma_input_pose_controls_prone_key")

	dogma_mcm.mcm.attach(options, "input", "ui_mcm_menu_dogma_input", {
		id = "pose_controls",
		sh = true,
		text = "ui_mcm_menu_dogma_input_pose_controls",
		gr = dogma_mcm.mcm.with_header(gr),
	})
end
