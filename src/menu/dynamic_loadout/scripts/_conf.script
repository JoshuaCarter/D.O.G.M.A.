-- menu/dynamic_loadout conf (prepended into *mcm.script for main-menu load)

local defaults = {
	["enabled"] = true,
	["log_scores"] = true,
	["include_universal_armor"] = true,
	-- Per-category: supply items with pts < cap
	["max_pts_weapon"] = 900,
	["max_pts_armor"] = 550,
	["max_pts_helmet"] = 250,
	["max_pts_ammo"] = 80,
	["max_pts_sight"] = 200,
	-- Per-category: shop pts = weighted avg(0..1) × cost_mult_<cat>.
	["cost_mult_weapon"] = 1000,
	["cost_mult_armor"] = 1000,
	["cost_mult_helmet"] = 1000,
	["cost_mult_ammo"] = 1000,
	["cost_mult_sight"] = 1000,
	-- Weapon score weights (0-1). Final: avg(n01×w) / Σw, then × cost_mult_<cat>.
	-- DOGMA tooltip stats + table dmg. Base-GAMMA bars: mag + fire rate.
	-- Max TT torso dmg across all ammo_class rounds (cols Min→Mid+).
	["w_mut_dmg"] = 0.5, -- col 1 Min
	["w_lgt_dmg"] = 0.5, -- col 2 Lgt
	["w_mid_dmg"] = 0.5, -- col 3 Lgt+
	["w_hvy_dmg"] = 0.5, -- col 4 Mid
	["w_max_dmg"] = 0.5, -- col 5 Mid+
	["w_rpm"] = 0.5,
	["w_mag"] = 0.5,
	["w_burst"] = 0.5,
	["w_use_mag"] = 0.5, -- 1 mag-fed, 0 rounds-reload (tip)
	-- Spread ADS / hip (lower ° = better). Soft ceilings 1° and 10°.
	-- scope / silencer: always 0/1 mount capability.
	["w_spread_ads"] = 0.5,
	["w_spread_hip"] = 0.5,
	["w_scope"] = 0.5,
	["w_silencer"] = 0.5,
	["w_affordable"] = 0.5, -- gun: 1 at cost 0, 0 at MAX_COST.weapon
	-- armor / helmet — one weight per protection type
	["a_fire_wound"] = 0.5, -- ballistic / BR
	["a_strike"] = 0.5,
	["a_wound"] = 0.5,
	["a_explosion"] = 0.5,
	["a_shock"] = 0.5,
	["a_burn"] = 0.5,
	["a_chem"] = 0.5,
	["a_rad"] = 0.5,
	["a_psy"] = 0.5,
	["a_affordable"] = 0.5, -- outfit/helm: 1 at 0, 0 at MAX_COST
	-- ammo
	["ammo_dmg_ap"] = 0.5,
	["ammo_affordable"] = 0.5, -- 1 at 0, 0 at MAX_COST.ammo
	-- sight
	["sight_zoom"] = 0.5,
	["sight_affordable"] = 0.5, -- 1 at 0, 0 at MAX_COST.sight
}

-- Ordered MCM weight tracks (must match defaults keys used by scoring).
local WEIGHT_KEYS = {
	"w_mut_dmg", "w_lgt_dmg", "w_mid_dmg", "w_hvy_dmg", "w_max_dmg",
	"w_rpm", "w_mag", "w_burst", "w_use_mag",
	"w_spread_ads", "w_spread_hip",
	"w_scope", "w_silencer",
	"w_affordable",
	"a_fire_wound", "a_strike", "a_wound", "a_explosion",
	"a_shock", "a_burn", "a_chem", "a_rad", "a_psy",
	"a_affordable",
	"ammo_dmg_ap", "ammo_affordable",
	"sight_zoom", "sight_affordable",
}

-- Force every weight default to 0.5 (MCM reset + cfg fallback).
for i = 1, #WEIGHT_KEYS do
	defaults[WEIGHT_KEYS[i]] = 0.5
end
-- Kit addon ids (weapon rename suffix). Kit results = base .. "_" .. id.
local KIT_IDS = {
	"mod9", "pm_upgr_kit", "sr1upgr1", "226sig_kit", "pb_upgr_kit", "u2p2g0r",
	"pl15_scolaz", "lazup_pl15", "upg220", "silen98", "vitup", "kurtz", "gurza_up",
	"ots2_upgr_kit", "23_up", "kab_up", "spectre_tactical_kit", "sr2_upkit", "5c_tik",
	"admin", "mauser_kit", "sup", "infiltrator_tactical_kit", "bd", "vorkuta",
	"archangel", "magpul_pro", "mod_x_gen3", "shakal", "swamp", "kit_aus_tri",
	"kit_sa5x_spec", "kit_fal_leup", "cut_kit", "mono_kit", "m9_upgr_kit",
	"tt_upgr_kit", "tt_upgr",
}

