-- input/drop conf - shared loaded options for drop scripts.

local defaults = {
	["drop_safe_equipped"] = true,
	["key_drop"] = -1,
	["key_drop_mode"] = 2,
	["key_drop_modifier"] = 0,
}

_G.dogma_input_drop_conf = {
	MOD_ID = "dogma/input/drop",
	DEFAULTS = defaults,
	loaded = {
		drop_safe_equipped = defaults["drop_safe_equipped"],
	},
}

function _G.dogma_input_drop_conf:ensure_dogma()
	dogma.load(self.MOD_ID)
	return dogma
end
