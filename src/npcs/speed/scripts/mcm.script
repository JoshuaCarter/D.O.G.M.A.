function on_mcm_load(options)
	dogma_mcm.attach(options, "npcs", "ui_mcm_menu_dogma_npcs", {
		id = "speed",
		sh = true,
		text = "ui_mcm_menu_dogma_npcs_speed",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_npcs_speed_page_description",
			},
		}),
	})
end
