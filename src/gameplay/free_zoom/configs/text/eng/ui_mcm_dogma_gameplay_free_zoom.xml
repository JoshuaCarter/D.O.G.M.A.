	<string id="ui_mcm_dogma_free_zoom_scroll_wheel_zoom">
		<text>Scroll to zoom</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_scroll_wheel_zoom_desc">
		<text>Uses the mouse wheel for free zoom. Turn off Settings &gt; Modded Exes &gt; Control &gt; Mouse &gt; "Change weapons with mouse wheel".</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_scroll_wheel_reverse">
