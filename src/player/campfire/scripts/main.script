--[[
	Campfire heal (Body Health System + main HP).

	Each tick = exactly 1 point:
	  - Limb: +1 BHS point (temp or perm convert)
	  - Body: +0.01 actor health (1%)

	Each tick, one step in order:
	  1. Random limb: +1 temp until every limb total >= temp_fill% (slider 0–75).
	  2. Random limb: convert 1 temp→perm (perm up to 100%) until no temp left.
	  3. Body: +0.01 temp main HP until health >= temp_fill%.
	  4. Body: convert 0.01 body temp→perm until none left.

	temp_fill 0% → skip steps 1 and 3 (no auto temp); still run 2 and 4
	to convert any existing temp (medkits / leftover body temp).

	Disable other campfire heal mods to avoid stacking.
]]

local CONFIG = _G.dogma_player_campfire_conf
local DOGMA

local LIMBS = { "head", "torso", "rightarm", "leftarm", "rightleg", "leftleg" }
local RANGE_SQR = 10 * 10
-- 1 point per tick: BHS limbs use integer HP; actor.health is 0..1 so 1% = 0.01
local BODY_HEAL_PT = 0.01
local BODY_TEMP_KEY = "dogma.campfire.body_temp"

local next_tick = 0
local cached_interval_sec = 1
local cached_temp_fill_frac = 0.75

local function refresh_settings()
	local sec = 1
	local pct = 75
	if DOGMA and DOGMA.mcm then
		sec = DOGMA.mcm.number(CONFIG.MOD_ID, "interval", CONFIG.DEFAULTS.interval)
		pct = DOGMA.mcm.number(CONFIG.MOD_ID, "temp_fill", CONFIG.DEFAULTS.temp_fill)
	elseif CONFIG and CONFIG.DEFAULTS then
		sec = CONFIG.DEFAULTS.interval or 1
		pct = CONFIG.DEFAULTS.temp_fill or 75
	end
	sec = tonumber(sec) or 1
	pct = tonumber(pct) or 75
	if sec < 1 then
		sec = 1
	elseif sec > 30 then
		sec = 30
	end
	if pct < 0 then
		pct = 0
	elseif pct > 75 then
		pct = 75
	end
	cached_interval_sec = sec
	cached_temp_fill_frac = pct / 100
end

local function interval_ms()
	return math.floor(cached_interval_sec * 1000)
end

local function temp_fill_frac()
	return cached_temp_fill_frac
end

local function near_lit_campfire()
	if not (db.actor and bind_campfire and bind_campfire.campfires_all) then
		return false
	end
	local pos = db.actor:position()
	for _, binder in pairs(bind_campfire.campfires_all) do
		if binder and binder.campfire and binder.campfire:is_on() and binder.object then
			if pos:distance_to_sqr(binder.object:position()) <= RANGE_SQR then
				return true
			end
		end
	end
	return false
end

-- Integer limb points for auto-temp. 0% → 0 (no auto temp).
local function limb_temp_cap(max, frac)
	if frac <= 0 or max == nil or max <= 0 then
		return 0
	end
	return math.floor(max * frac)
end

local function save_limb(bhs, key)
	utils_obj.save_var(db.actor, "health." .. key, bhs.health[key])
	utils_obj.save_var(db.actor, "timedhp." .. key, bhs.timedhp[key])
end

local function load_body_temp()
	local v = utils_obj.load_var(db.actor, BODY_TEMP_KEY)
	if v == nil then
		return 0
	end
	return v
end

local function save_body_temp(v)
	utils_obj.save_var(db.actor, BODY_TEMP_KEY, v)
end

-- Clamp tracked body temp to current health (damage / other heals).
local function sync_body_temp()
	local actor = db.actor
	local body_temp = load_body_temp()
	local h = actor.health
	if body_temp > h then
		body_temp = h
		save_body_temp(body_temp)
	elseif body_temp < 0 then
		body_temp = 0
		save_body_temp(body_temp)
	end
	return body_temp
end

-- Note: hp/temp may be 0 (falsy) — only reject nil.
local function limb_needs_temp(bhs, key, frac)
	if frac <= 0 then
		return false
	end
	local hp = bhs.health[key]
	local max = bhs.maxhp[key]
	local temp = bhs.timedhp[key]
	if hp == nil or max == nil or temp == nil or max <= 0 then
		return false
	end
	return hp < limb_temp_cap(max, frac)
end

-- Convert any remaining temp up to full permanent (100%).
local function limb_needs_perm(bhs, key)
	local hp = bhs.health[key]
	local max = bhs.maxhp[key]
	local temp = bhs.timedhp[key]
	if hp == nil or max == nil or temp == nil or max <= 0 then
		return false
	end
	local perm = hp - temp
	return temp > 0 and perm < max
end

local function heal_limb_temp(bhs, key, frac)
	local hp = bhs.health[key]
	local max = bhs.maxhp[key]
	local temp = bhs.timedhp[key]
	if hp == nil or max == nil or temp == nil or max <= 0 then
		return false
	end
	local cap = limb_temp_cap(max, frac)
	if cap <= 0 or hp >= cap then
		return false
	end
	bhs.health[key] = hp + 1
	bhs.timedhp[key] = temp + 1
	return true
end

local function heal_limb_perm(bhs, key)
	local hp = bhs.health[key]
	local max = bhs.maxhp[key]
	local temp = bhs.timedhp[key]
	if hp == nil or max == nil or temp == nil or max <= 0 then
		return false
	end
	local perm = hp - temp
	if temp <= 0 or perm >= max then
		return false
	end
	bhs.timedhp[key] = temp - 1
	return true
end

local function body_needs_temp(frac)
	if frac <= 0 then
		return false
	end
	return db.actor and db.actor.health < frac
end

local function heal_body_temp(frac)
	local actor = db.actor
	if not actor or frac <= 0 or actor.health >= frac then
		return false
	end
	local amt = math.min(BODY_HEAL_PT, frac - actor.health)
	if amt <= 0 then
		return false
	end
	local body_temp = sync_body_temp()
	actor:change_health(amt)
	body_temp = body_temp + amt
	if body_temp > actor.health then
		body_temp = actor.health
	end
	save_body_temp(body_temp)
	return true
end

local function body_needs_perm()
	return sync_body_temp() > 0
end

local function heal_body_perm()
	local body_temp = sync_body_temp()
	if body_temp <= 0 then
		return false
	end
	local amt = math.min(BODY_HEAL_PT, body_temp)
	body_temp = body_temp - amt
	if body_temp < 0 then
		body_temp = 0
	end
	save_body_temp(body_temp)
	return true
end

local function pick(targets)
	if #targets == 0 then
		return nil
	end
	return targets[math.random(#targets)]
end

local function tick_heal()
	local frac = temp_fill_frac()
	local bhs = rawget(_G, "zzz_player_injuries")
	local has_bhs = bhs and bhs.health and bhs.timedhp and bhs.maxhp

	-- 1. Random limb temp until all limbs >= temp_fill%.
	if has_bhs and frac > 0 then
		local temp_targets = {}
		for i = 1, #LIMBS do
			local key = LIMBS[i]
			if limb_needs_temp(bhs, key, frac) then
				temp_targets[#temp_targets + 1] = key
			end
		end
		local temp_pick = pick(temp_targets)
		if temp_pick then
			if heal_limb_temp(bhs, temp_pick, frac) then
				save_limb(bhs, temp_pick)
			end
			return
		end
	end

	-- 2. Random limb perm (convert all temp, up to 100% permanent).
	if has_bhs then
		local perm_targets = {}
		for i = 1, #LIMBS do
			local key = LIMBS[i]
			if limb_needs_perm(bhs, key) then
				perm_targets[#perm_targets + 1] = key
			end
		end
		local perm_pick = pick(perm_targets)
		if perm_pick then
			if heal_limb_perm(bhs, perm_pick) then
				save_limb(bhs, perm_pick)
			end
			return
		end
	end

	-- 3. Body temp until health >= temp_fill%.
	if body_needs_temp(frac) then
		heal_body_temp(frac)
		return
	end

	-- 4. Body perm: convert tracked body temp until none left.
	if body_needs_perm() then
		heal_body_perm()
	end
end

local function actor_on_update()
	if not db.actor then
		return
	end
	local now = time_global()
	if now < next_tick then
		return
	end
	-- Arm timer before heal so a slow heal can't double-fire.
	next_tick = now + interval_ms()
	if near_lit_campfire() then
		tick_heal()
	end
end

local function on_option_change()
	refresh_settings()
end

function on_game_start()
	DOGMA = dogma_common.load(CONFIG.MOD_ID)
	refresh_settings()
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("on_option_change", on_option_change)
end
