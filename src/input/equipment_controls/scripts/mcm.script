-- input/equipment_controls conf
-- Stock detector/geiger/torch: MCM key_mirror ↔ Settings → Controls.
-- RF / Measurement / Glowstick: standalone MCM key_bind (DIK in axr_options, not engine customs).

_G.dogma_input_equipment_controls_conf = {
	MOD_ID = "dogma/input/equipment_controls",
	DEFAULTS = {
		auto_bolt_on_detector = true,
		key_radio = -1,
		key_anomaly = -1,
		key_glowstick = -1,
	},
	loaded = {
		enabled = true,
		key_radio = nil,
		key_anomaly = nil,
		key_glowstick = nil,
	},
}

-- Equipment Controls MCM
-- Detector / Geiger / Torch mirror Settings → Controls.
-- RF / Measurement / Glowstick are standalone MCM key_binds.

local CONFIG = _G.dogma_input_equipment_controls_conf

local function kb_bind(id, hint)
	return {
		id = id,
		type = "key_bind",
		val = 2,
		def = CONFIG.DEFAULTS[id],
		hint = hint,
	}
end

function on_mcm_load(options)
	dogma_mcm.mcm.attach(options, "input", "ui_mcm_menu_dogma_input", {
		id = "equipment_controls",
		sh = true,
		text = "ui_mcm_menu_dogma_input_equipment_controls",
		gr = dogma_mcm.mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_input_equipment_controls_page_description",
			},
			{
				id = "auto_bolt_on_detector",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.auto_bolt_on_detector,
				hint = "dogma_input_equipment_controls_auto_bolt_on_detector",
			},
			dogma_mcm.mcm.key_mirror("show_detector", function()
				return key_bindings and key_bindings.kDETECTOR
			end):option("key_detector", "dogma_input_equipment_controls_key_detector"),
			dogma_mcm.mcm.key_mirror("custom14", function()
				return key_bindings and key_bindings.kCUSTOM14
			end):option("key_geiger", "dogma_input_equipment_controls_key_geiger"),
			kb_bind("key_radio", "dogma_input_equipment_controls_key_radio"),
			kb_bind("key_anomaly", "dogma_input_equipment_controls_key_anomaly"),
			dogma_mcm.mcm.key_mirror("torch", function()
				return key_bindings and key_bindings.kTORCH
			end):option("key_torch", "dogma_input_equipment_controls_key_torch"),
			kb_bind("key_glowstick", "dogma_input_equipment_controls_key_glowstick"),
		}),
	})
end
