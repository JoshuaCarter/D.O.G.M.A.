-- tweaks/persist_melancholy_weather conf
-- Debug toggle: keep the saved Melancholy cycle across save/load.

_G.dogma_tweaks_persist_melancholy_weather_conf = {
	MOD_ID = "dogma/tweaks/persist_melancholy_weather",
	MCM_PAGE = "dogma/tweaks",
	DEFAULTS = {
		persist_melancholy_weather = true,
	},
}

function on_mcm_load(options)
	local CONFIG = _G.dogma_tweaks_persist_melancholy_weather_conf
	dogma_mcm.append(options, "tweaks", "ui_mcm_menu_dogma_tweaks", {
		{
			id = "persist_melancholy_weather_description",
			type = "desc",
			text = "ui_mcm_dogma_tweaks_persist_melancholy_weather_page_description",
		},
		{
			id = "persist_melancholy_weather",
			type = "check",
			val = 1,
			def = CONFIG.DEFAULTS.persist_melancholy_weather,
			hint = "dogma_tweaks_persist_melancholy_weather",
		},
	})
end
