; Native glowstick light params preserved for script MCM scaling.
; Point device light_section at a tiny stub so held D_FLALIT doesn't
; double-light with script_light. Shared glowstick_definition* left intact
; for thrown spawn / other mods; our script maps colors from dogma_gs_light_*.

[dogma_gs_light_green]
type									= 1
range									= 12
range_r2								= 12
color									= 0.0,0.8,0.6,0.8
color_r2								= 0.0,0.8,0.6,0.8
color_animator							= empty
volumetric								= false
volumetric_quality						= 0.5
volumetric_intensity					= 0.10
volumetric_distance						= 0.25

[dogma_gs_light_orange]:dogma_gs_light_green
color									= 0.8,0.4,0.0,0.8
color_r2								= 0.8,0.4,0.0,0.8
range									= 10
range_r2								= 10

[dogma_gs_light_red]:dogma_gs_light_green
color									= 0.4,0.1,0.0,0.8
color_r2								= 0.4,0.1,0.0,0.8
range									= 24
range_r2								= 24

[dogma_gs_light_blue]:dogma_gs_light_green
color									= 0.0,0.6,1.0,0.8
color_r2								= 0.0,0.6,1.0,0.8
range									= 8
range_r2								= 8

; Minimal valid light — never all-zero color.
[dogma_gs_light_held_off]
type									= 1
range									= 0.05
range_r2								= 0.05
color									= 0.01,0.01,0.01,0.01
color_r2								= 0.01,0.01,0.01,0.01
color_animator							= empty
volumetric								= false
omni_range								= 0.05
omni_range_r2							= 0.05
omni_color								= 0.01,0.01,0.01,0.01
omni_color_r2							= 0.01,0.01,0.01,0.01

![device_glowstick]
light_section							= dogma_gs_light_held_off

![device_glowstick_orange]
light_section							= dogma_gs_light_held_off

![device_glowstick_red]
light_section							= dogma_gs_light_held_off

![device_glowstick_blue]
light_section							= dogma_gs_light_held_off
