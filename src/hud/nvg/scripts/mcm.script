function on_mcm_load(options)
	local CONFIG = _G.dogma_hud_nvg_conf
	dogma_mcm.attach(options, "hud", "ui_mcm_menu_dogma_hud", {
		id = "nvg",
		sh = true,
		text = "ui_mcm_menu_dogma_hud_nvg",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_hud_nvg_page_description",
			},
		}),
	})
end
