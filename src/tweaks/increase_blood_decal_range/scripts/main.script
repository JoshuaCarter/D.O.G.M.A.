--[[
	Long Range Blood Decals

	Vanilla only places blood wallmarks at short range. Beyond MIN_DISTANCE,
	place skeleton wallmarks for firearm hits so distant kills still leave blood.

	Port of bvcx / INNIES Long Range Blood Decals:
	https://www.moddb.com/mods/stalker-anomaly/addons/long-range-blood-decals
]]

local CONFIG = _G.dogma_tweaks_increase_blood_decal_range_conf

local HIT_TYPES = {
	[hit.fire_wound] = true,
}

local function npc_on_before_hit(npc, s_hit, bone_id, flags)
	if not HIT_TYPES[s_hit.type] then
		return
	end

	local shooter = s_hit.draftsman
	if not (shooter and shooter.alive and shooter:alive() and IsStalker(shooter)) then
		return
	end

	local wpn = shooter:active_item()
	if not (wpn and IsWeapon(wpn)) or IsMelee(wpn) then
		return
	end

	-- Keep engine wallmarks at close range; only fill in past the cut-off.
	local dist = npc:position():distance_to(db.actor:position())
	if not (dist and dist >= CONFIG.MIN_DISTANCE) then
		return
	end

	local ammo_list = utils_item.get_ammo(nil, wpn:id())
	local ammo_idx = wpn:get_ammo_type() + 1
	local ammo_sec = ammo_list and ammo_idx and ammo_list[ammo_idx]
	local wm_size = ammo_sec and ini_sys:r_float_ex(ammo_sec, "wm_size")
	wm_size = wm_size and tonumber(wm_size) or 0.05

	local wpn_pos = vector():set(wpn:bone_position("wpn_body"))
	local bone_name = bone_id and npc:bone_name(bone_id)
	local pos_to = bone_name and vector():set(npc:bone_position(bone_name))
	local wm_dir = wpn_pos and pos_to
		and vec_sub(vector():set(pos_to), vector():set(wpn_pos)):normalize()
	if not wm_dir then
		return
	end

	local from_x = (wpn_pos.x - pos_to.x) * 0.02
	local from_y = (wpn_pos.y - pos_to.y) * 0.02
	local from_z = (wpn_pos.z - pos_to.z) * 0.02
	local pos_from = vector():set(pos_to.x + from_x, pos_to.y + from_y, pos_to.z + from_z)

	local picked_wm = "new_wm_blood_" .. math.random(1, 5)
	wallmarks_manager():place_skeleton(
		npc,
		picked_wm,
		vector():set(pos_from),
		vector():set(wm_dir),
		wm_size,
		CONFIG.WM_TTL
	)
end

function on_game_start()
	RegisterScriptCallback("npc_on_before_hit", npc_on_before_hit)
	RegisterScriptCallback("monster_on_before_hit", npc_on_before_hit)
end
