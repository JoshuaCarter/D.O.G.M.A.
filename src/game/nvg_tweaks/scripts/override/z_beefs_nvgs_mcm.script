--[[
	DOGMA override: Beef's NVG MCM (z_beefs_nvgs_mcm.script).

	Same options as stock Beef. Starting brightness lives on DOGMA NVG Tweaks.
]]

local defaults = {
	["nvg_gain_max_mcm"] = 2.0,
	["nvg_gain_min_mcm"] = 0.5,
	["nvg_gain_offset_mcm"] = 1.0,
	["nvg_washout_thresh_mcm"] = 0.1,
	["nvg_view_through_scope_mcm"] = false,
	["nvg_stays_pda_mcm"] = true,
	["shader_scope_compat"] = false,
	["nvg_gen1_tubes_mcm"] = 1.0,
	["nvg_gen2_tubes_mcm"] = 2.0,
	["nvg_gen3_tubes_mcm"] = 4.0,
	["nvg_gen1_mode_mcm"] = 3.0,
	["nvg_gen2_mode_mcm"] = 0.0,
	["nvg_gen3_mode_mcm"] = 0.0,
}

function get_config(key)
	if ui_mcm then
		local value = ui_mcm.get("beef_nvg/" .. key)
		if value ~= nil then
			return value
		end
	end
	return defaults[key]
end

function on_mcm_load()
	return {
		id = "beef_nvg",
		sh = true,
		gr = {
			{
				id = "title",
				type = "slide",
				link = "ui_options_slider_player",
				text = "ui_mcm_beef_nvg_title",
				size = { 512, 50 },
				spacing = 20,
			},
			{
				id = "nvg_gain_max_mcm",
				type = "track",
				val = 2,
				min = 1.0,
				max = 3.0,
				step = 0.1,
				def = defaults["nvg_gain_max_mcm"],
			},
			{
				id = "nvg_gain_min_mcm",
				type = "track",
				val = 2,
				min = 0.1,
				max = 0.9,
				step = 0.1,
				def = defaults["nvg_gain_min_mcm"],
			},
			{
				id = "nvg_gain_offset_mcm",
				type = "track",
				val = 2,
				min = 0.5,
				max = 3.0,
				step = 0.1,
				def = defaults["nvg_gain_offset_mcm"],
			},
			{
				id = "nvg_washout_thresh_mcm",
				type = "track",
				val = 2,
				min = 0.1,
				max = 0.9,
				step = 0.1,
				def = defaults["nvg_washout_thresh_mcm"],
			},
			-- Stock Beef MCM uses def=true here (defaults table still has view_through=false for get_config).
			{
				id = "nvg_view_through_scope_mcm",
				type = "check",
				val = 1,
				def = true,
			},
			{
				id = "nvg_stays_pda_mcm",
				type = "check",
				val = 1,
				def = true,
			},
			{
				id = "nvg_gen1_tubes_mcm",
				type = "list",
				val = 2,
				content = {
					{ 1.0, "single_centered" },
					{ 1.1, "single_left" },
					{ 1.2, "single_right" },
					{ 2.0, "dual_centered" },
					{ 4.0, "quad_centered" },
				},
				def = defaults["nvg_gen1_tubes_mcm"],
			},
			{
				id = "nvg_gen2_tubes_mcm",
				type = "list",
				val = 2,
				content = {
					{ 1.0, "single_centered" },
					{ 1.1, "single_left" },
					{ 1.2, "single_right" },
					{ 2.0, "dual_centered" },
					{ 4.0, "quad_centered" },
				},
				def = defaults["nvg_gen2_tubes_mcm"],
			},
			{
				id = "nvg_gen3_tubes_mcm",
				type = "list",
				val = 2,
				content = {
					{ 1.0, "single_centered" },
					{ 1.1, "single_left" },
					{ 1.2, "single_right" },
					{ 2.0, "dual_centered" },
					{ 4.0, "quad_centered" },
				},
				def = defaults["nvg_gen3_tubes_mcm"],
			},
			{
				id = "nvg_gen1_mode_mcm",
				type = "list",
				val = 2,
				content = {
					{ 0.0, "blurred_background" },
					{ 1.0, "black_background" },
					{ 2.0, "image_overlay" },
					{ 3.0, "clear_vision" },
				},
				def = defaults["nvg_gen1_mode_mcm"],
			},
			{
				id = "nvg_gen2_mode_mcm",
				type = "list",
				val = 2,
				content = {
					{ 0.0, "blurred_background" },
					{ 1.0, "black_background" },
					{ 2.0, "image_overlay" },
					{ 3.0, "clear_vision" },
				},
				def = defaults["nvg_gen2_mode_mcm"],
			},
			{
				id = "nvg_gen3_mode_mcm",
				type = "list",
				val = 2,
				content = {
					{ 0.0, "blurred_background" },
					{ 1.0, "black_background" },
					{ 2.0, "image_overlay" },
					{ 3.0, "clear_vision" },
				},
				def = defaults["nvg_gen3_mode_mcm"],
			},
			{
				id = "title",
				type = "slide",
				link = "ui_options_slider_player",
				text = "ui_mcm_beef_nvg_title_2",
				size = { 512, 50 },
				spacing = 20,
			},
			{
				id = "shader_scope_compat",
				type = "check",
				val = 1,
				def = defaults["shader_scope_compat"],
			},
		},
	}
end
