--[[
	Stalker ID - centered Faction Identification replacement.

	Soft aim: every 100ms, project nearby stalker neck/torso to screen and pick
	closest to center within aim_radius_px. Optional LOS recast toward the
	anchor (bushes pierce; walls block), walking screen-near candidates in
	distance order. Losing the target fades the HUD out over 2s.
]]

local CONFIG = _G.dogma_hud_stalker_id_conf

local UI_WIDTH = 1024
local UI_HEIGHT = 768
local UI_CENTER_X = UI_WIDTH * 0.5
local UI_CX, UI_CY = 512, 384
local ALIGN_CENTER = 2 -- CGameFont::alCenter
local UPDATE_DELAY = 100
local FADE_MS = 2000

local ANCHOR_BONES = { "bip01_neck", "bip01_spine2", "bip01_spine1", "bip01_head" }

-- LOS recast: pierce solid bushes; walls / other statics still block.
local LOOK_FLAGS = 3 -- rqtObject | rqtStatic
local LOOK_MAX_PIERCE = 16
local LOOK_BUSH_STEP = 0.2
local look_pick = nil
local LOOK_POS = vector()
local LOOK_DIR = vector()
local LOOK_SCRATCH = vector()
local W2U_SCRATCH = vector()

local LINE_THICK = 2
local LINE_HALO = 2
local LINE_A = 200
local FOV_ZOOM_RATIO = 0.7

local FACTION_KEYS = {
	"stalker", "bandit", "csky", "army", "freedom", "dolg", "ecolog",
	"killer", "monolith", "greh", "renegade", "isg",
}

local HUD = nil
local nametable = {}
local LastHitObject = nil
local line_target_id = nil
local trigger = 0
local grok_delay = 0

local fade_active = false
local fade_start_ms = 0
local fade_mul = 1
local shown_faction = nil

local zombified_text
local _fov_baseline = 60
local UI_KX = 1
local _ui_w = 0

local POS_VEC = vector2()
local SIZE_VEC = vector2()

local floor, sqrt, atan2 = math.floor, math.sqrt, math.atan2

local function clamp01(v)
	if v < 0 then
		return 0
	end
	if v > 1 then
		return 1
	end
	return v
end

local function pct_to_byte(pct, mul)
	return floor(255 * clamp01((tonumber(pct) or 0) / 100) * clamp01(mul) + 0.5)
end

local function on_option_change()
	local id = CONFIG.MOD_ID
	CONFIG.loaded.dead_id = dogma.mcm.bool(id, "dead_id")
	CONFIG.loaded.name_id = dogma.mcm.bool(id, "name_id")
	CONFIG.loaded.rank_id = dogma.mcm.bool(id, "rank_id")
	CONFIG.loaded.name_y = dogma.mcm.int(id, "name_y")
	CONFIG.loaded.rank_y = dogma.mcm.int(id, "rank_y")
	CONFIG.loaded.icon_y = dogma.mcm.int(id, "icon_y")
	CONFIG.loaded.name_a = dogma.mcm.uint(id, "name_a")
	CONFIG.loaded.rank_a = dogma.mcm.uint(id, "rank_a")
	CONFIG.loaded.icon_a = dogma.mcm.uint(id, "icon_a")
	CONFIG.loaded.max_range = dogma.mcm.uint(id, "max_range")
	CONFIG.loaded.aim_radius_px = dogma.mcm.uint(id, "aim_radius_px")
	CONFIG.loaded.require_visible = dogma.mcm.bool(id, "require_visible")
	CONFIG.loaded.always_show_line = dogma.mcm.bool(id, "always_show_line")
	CONFIG.loaded.always_show_line_binoc = dogma.mcm.bool(id, "always_show_line_binoc")
	CONFIG.loaded.line_keybind = dogma.mcm.key(id, "line_keybind")
end

local function hide_all_patches(hud)
	for i = 1, #FACTION_KEYS do
		local key = FACTION_KEYS[i]
		hud.factions[key]:Show(false)
		hud.factions[key .. "_dead"]:Show(false)
	end
end

local function clear_text(hud)
	hud.name:TextControl():SetText("")
	hud.rank:TextControl():SetText("")
	hud.zombified:TextControl():SetText("")
	hud.zombified:Show(false)
end

local function hide_line(hud)
	hud = hud or HUD
	if not hud then
		return
	end
	hud.line:Show(false)
	hud.line_sh:Show(false)
end

local function apply_alphas(mul)
	if not HUD then
		return
	end
	fade_mul = clamp01(mul)
	local cfg = CONFIG.loaded
	local name_a = pct_to_byte(cfg.name_a, fade_mul)
	local rank_a = pct_to_byte(cfg.rank_a, fade_mul)
	local icon_a = pct_to_byte(cfg.icon_a, fade_mul)

	HUD.name:TextControl():SetTextColor(GetARGB(name_a, 255, 255, 255))
	HUD.rank:TextControl():SetTextColor(GetARGB(rank_a, 200, 200, 200))
	HUD.zombified:TextControl():SetTextColor(GetARGB(icon_a, 255, 255, 255))

	if shown_faction and HUD.factions[shown_faction] then
		pcall(function()
			HUD.factions[shown_faction]:SetTextureColor(GetARGB(icon_a, 255, 255, 255))
		end)
	end
end

local function cancel_fade()
	fade_active = false
	fade_start_ms = 0
	fade_mul = 1
end

local function start_fade()
	fade_active = true
	fade_start_ms = time_global()
end

local function clear()
	cancel_fade()
	shown_faction = nil
	line_target_id = nil
	if HUD then
		HUD:Reset()
	end
end

class "UIStalkerIDHUD" (CUIScriptWnd)

function UIStalkerIDHUD:__init() super()
	local xml = CScriptXmlInit()
	xml:ParseFile("ui_dogma_stalker_id.xml")

	self.line_sh = xml:InitStatic("line_sh", self)
	self.line = xml:InitStatic("line", self)
	self.line_sh:EnableHeading(true)
	self.line:EnableHeading(true)
	self.line_sh:Show(false)
	self.line:Show(false)

	self.factions = {}
	for i = 1, #FACTION_KEYS do
		local key = FACTION_KEYS[i]
		self.factions[key] = xml:InitStatic("patch_" .. key, self)
		self.factions[key .. "_dead"] = xml:InitStatic("patch_dead_" .. key, self)
	end

	self.name = xml:InitStatic("name", self)
	self.rank = xml:InitStatic("rank", self)
	self.zombified = xml:InitStatic("zombified", self)

	pcall(function()
		self.name:TextControl():SetTextComplexMode(false)
		self.name:TextControl():SetTextAlignment(ALIGN_CENTER)
		self.rank:TextControl():SetTextComplexMode(false)
		self.rank:TextControl():SetTextAlignment(ALIGN_CENTER)
		self.zombified:TextControl():SetTextComplexMode(false)
		self.zombified:TextControl():SetTextAlignment(ALIGN_CENTER)
	end)

	hide_all_patches(self)
	clear_text(self)
end

function UIStalkerIDHUD:__finalize()
end

function UIStalkerIDHUD:Reset()
	hide_all_patches(self)
	clear_text(self)
	hide_line(self)
end

local function activate_hud()
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	if HUD == nil then
		HUD = UIStalkerIDHUD()
		get_hud():AddDialogToRender(HUD)
	end
end

local function deactivate_hud()
	if HUD ~= nil then
		get_hud():RemoveDialogToRender(HUD)
		HUD = nil
	end
	UnregisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
end

function on_screen_resolution_changed()
	deactivate_hud()
	activate_hud()
	_ui_w = 0
end

function actor_on_net_destroy()
	if HUD ~= nil then
		get_hud():RemoveDialogToRender(HUD)
		HUD = nil
	end
	line_target_id = nil
end

function actor_on_first_update()
	activate_hud()
end

local function is_zombied(community)
	return community == "zombied"
end

local function is_valid_community(community)
	if not community then
		return false
	end
	if is_zombied(community) then
		return true
	end
	return HUD and HUD.factions[community] ~= nil
end

local function display(faction, name, rank, zombified)
	if not HUD then
		return
	end

	local cfg = CONFIG.loaded
	cancel_fade()
	shown_faction = nil
	hide_all_patches(HUD)
	clear_text(HUD)

	HUD.name:SetWndPos(POS_VEC:set(0, cfg.name_y))
	HUD.rank:SetWndPos(POS_VEC:set(0, cfg.rank_y))

	if name then
		HUD.name:TextControl():SetText(name)
	end
	if rank then
		HUD.rank:TextControl():SetText(rank)
	end

	if zombified then
		HUD.zombified:SetWndPos(POS_VEC:set(0, cfg.icon_y))
		HUD.zombified:TextControl():SetText(zombified_text)
		HUD.zombified:Show(true)
		apply_alphas(1)
		return
	end

	if faction and HUD.factions[faction] then
		shown_faction = faction
		HUD.factions[faction]:SetWndPos(POS_VEC:set(UI_CENTER_X, cfg.icon_y))
		HUD.factions[faction]:Show(true)
	end
	apply_alphas(1)
end

local function display_faction(obj)
	if not obj then
		return
	end

	local cfg = CONFIG.loaded
	local fact = obj:character_community()
	local name = obj:character_name()
	local rank = game.translate_string("st_rank_" .. ranks.get_obj_rank_name(obj)) or ""

	if not cfg.rank_id then
		rank = nil
	end
	if not cfg.name_id then
		name = nil
	end

	if name == nil or name == "" then
		name = nil
	end
	if rank == nil or rank == "" then
		rank = nil
	end

	if is_zombied(fact) then
		display(nil, name, rank, true)
		return
	end

	if cfg.dead_id and obj.health <= 0 then
		fact = fact .. "_dead"
	end

	display(fact, name, rank, false)
end

local function is_bush_material(name)
	if type(name) ~= "string" then
		return false
	end
	return name:find("bush", 1, true) ~= nil
end

local function anchor_pos(obj)
	for i = 1, #ANCHOR_BONES do
		local ok, p = pcall(obj.bone_position, obj, ANCHOR_BONES[i])
		if ok and p then
			return p
		end
	end
	local p = obj:position()
	return LOOK_SCRATCH:set(p.x, p.y + 1.2, p.z)
end

local function project_world(pos)
	local w2u = (game and game.world2ui) or (level and level.world2ui)
	if not w2u then
		return nil
	end
	local ui = w2u(W2U_SCRATCH:set(pos), false, false)
	if not ui or ui.x < -9000 then
		return nil
	end
	return ui.x, ui.y
end

-- Bush-piercing ray from camera toward `to_pos`. True if the first non-bush
-- hit is `target_obj`.
local function ray_hits_object(target_obj, to_pos, max_range)
	local d = device()
	if not (ray_pick and d and d.cam_pos and target_obj and to_pos) then
		return false
	end

	if not look_pick then
		look_pick = ray_pick()
	end
	local pick = look_pick
	pick:set_flags(LOOK_FLAGS)

	local ox, oy, oz = d.cam_pos.x, d.cam_pos.y, d.cam_pos.z
	local dx = to_pos.x - ox
	local dy = to_pos.y - oy
	local dz = to_pos.z - oz
	local dist = sqrt(dx * dx + dy * dy + dz * dz)
	if dist < 0.05 then
		return true
	end
	dx, dy, dz = dx / dist, dy / dist, dz / dist
	LOOK_DIR:set(dx, dy, dz)

	local remaining = dist + 0.5
	if max_range and remaining > max_range then
		remaining = max_range
	end
	local pierces = 0
	local target_id = target_obj:id()

	while remaining > LOOK_BUSH_STEP and pierces <= LOOK_MAX_PIERCE do
		LOOK_POS:set(ox, oy, oz)
		pick:set_position(LOOK_POS)
		pick:set_direction(LOOK_DIR)
		pick:set_range(remaining)
		if db and db.actor then
			pick:set_ignore_object(db.actor)
		end

		local ok, hit = pcall(function()
			return pick:query()
		end)
		if not (ok and hit) then
			return false
		end

		local obj = pick:get_object()
		if obj then
			return obj:id() == target_id
		end

		local result = pick:get_result()
		local hit_dist = pick:get_distance()
		if not (result and hit_dist and hit_dist > 0 and is_bush_material(result.material_name)) then
			return false
		end

		local step = hit_dist + LOOK_BUSH_STEP
		ox = ox + dx * step
		oy = oy + dy * step
		oz = oz + dz * step
		remaining = remaining - step
		pierces = pierces + 1
	end

	return false
end

local function cand_screen_cmp(a, b)
	return a.sd < b.sd
end

local function find_id_target()
	local cfg = CONFIG.loaded
	local max_range = cfg.max_range or 0
	if max_range <= 0 or not (db and db.actor) or not level.iterate_nearest then
		return nil
	end
	if not HUD then
		return nil
	end

	local apos = db.actor:position()
	local actor_id = db.actor:id()
	local radius = cfg.aim_radius_px or 0
	local candidates = {}

	pcall(level.iterate_nearest, apos, max_range, function(obj)
		if not obj then
			return false
		end
		local id = obj:id()
		if id == 0 or id == actor_id then
			return false
		end
		if not IsStalker(obj) then
			return false
		end
		if not (obj.health > 0 or cfg.dead_id) then
			return false
		end
		if not is_valid_community(obj:character_community()) then
			return false
		end

		local anchor = anchor_pos(obj)
		if not anchor then
			return false
		end
		if apos:distance_to(anchor) > max_range then
			return false
		end

		local sx, sy = project_world(anchor)
		if not sx then
			return false
		end
		local dx, dy = sx - UI_CX, sy - UI_CY
		local sd = sqrt(dx * dx + dy * dy)
		if sd <= radius then
			candidates[#candidates + 1] = {
				obj = obj,
				ax = anchor.x,
				ay = anchor.y,
				az = anchor.z,
				sd = sd,
			}
		end
		return false
	end)

	if #candidates == 0 then
		return nil
	end
	table.sort(candidates, cand_screen_cmp)

	if not cfg.require_visible then
		return candidates[1].obj
	end

	for i = 1, #candidates do
		local c = candidates[i]
		LOOK_SCRATCH:set(c.ax, c.ay, c.az)
		if ray_hits_object(c.obj, LOOK_SCRATCH, max_range) then
			return c.obj
		end
	end
	return nil
end

local function is_binoc_held()
	if not db.actor then
		return false
	end
	local ok, item = pcall(db.actor.active_item, db.actor)
	if not ok or not item then
		return false
	end
	local ok2, sec = pcall(item.section, item)
	if not ok2 or not sec then
		return false
	end
	return sec == "wpn_binoc_inv" or sec:find("binoc") ~= nil
end

local function update_fov_baseline()
	if is_binoc_held() then
		return
	end
	local d = device and device()
	local fov = d and d.fov
	if fov and fov > _fov_baseline then
		_fov_baseline = fov
	end
end

local function is_binoc_active()
	local axr = axr_main
	if axr and axr.binoc_is_zoomed then
		return true
	end
	if not is_binoc_held() then
		return false
	end
	local d = device and device()
	local fov = d and d.fov
	if not fov or fov <= 0 then
		return true
	end
	return fov < _fov_baseline * FOV_ZOOM_RATIO
end

local function want_line()
	local cfg = CONFIG.loaded
	if cfg.always_show_line then
		return true
	end
	if cfg.always_show_line_binoc and is_binoc_active() then
		return true
	end
	local key = cfg.line_keybind
	if key and dogma.input and dogma.input.is_key_down(key) then
		return true
	end
	return false
end

local function refresh_ui_kx()
	local d = device and device()
	if not (d and d.width and d.width > 0) then
		return
	end
	if d.width == _ui_w then
		return
	end
	_ui_w = d.width
	UI_KX = (d.height / d.width) / (UI_HEIGHT / UI_WIDTH)
end

local function update_leader_line()
	-- Active ID or fading: line_target_id is kept through fade, cleared on clear().
	if not (HUD and line_target_id and want_line() and fade_mul > 0 and (LastHitObject or fade_active)) then
		hide_line()
		return
	end

	local obj = level.object_by_id and level.object_by_id(line_target_id)
	if not obj then
		hide_line()
		return
	end

	local anchor = anchor_pos(obj)
	local hx, hy = project_world(anchor)
	if not hx then
		hide_line()
		return
	end

	refresh_ui_kx()
	local cfg = CONFIG.loaded
	local ux, uy = UI_CENTER_X, cfg.icon_y or 60
	local dx = hx - ux
	local dy = hy - uy
	local dxk = dx / UI_KX
	local len = sqrt(dxk * dxk + dy * dy)
	if len < 1 then
		hide_line()
		return
	end

	local ang = atan2(-dy, dxk)
	local mx = (ux + hx) * 0.5
	local my = (uy + hy) * 0.5
	local a = floor(LINE_A * fade_mul + 0.5)
	if a < 1 then
		hide_line()
		return
	end

	local halo_t = LINE_THICK + LINE_HALO
	HUD.line_sh:SetWndSize(SIZE_VEC:set(len, halo_t))
	HUD.line_sh:SetWndPos(POS_VEC:set(mx - len * 0.5, my - halo_t * 0.5))
	HUD.line_sh:SetHeading(ang)
	HUD.line_sh:SetTextureColor(GetARGB(floor(a * 0.6), 0, 0, 0))
	HUD.line_sh:Show(true)

	HUD.line:SetWndSize(SIZE_VEC:set(len, LINE_THICK))
	HUD.line:SetWndPos(POS_VEC:set(mx - len * 0.5, my - LINE_THICK * 0.5))
	HUD.line:SetHeading(ang)
	HUD.line:SetTextureColor(GetARGB(a, 255, 255, 255))
	HUD.line:Show(true)
end

local function target_enter(obj)
	if not obj then
		return
	end
	line_target_id = obj:id()
	display_faction(obj)
end

local function target_lost()
	if not HUD then
		return
	end
	start_fade()
	apply_alphas(1)
end

local function update_fade()
	if not fade_active then
		return
	end
	local elapsed = time_global() - fade_start_ms
	if elapsed >= FADE_MS then
		clear()
		return
	end
	apply_alphas(1 - (elapsed / FADE_MS))
end

function actor_on_update()
	update_fov_baseline()
	update_fade()
	update_leader_line()

	local tg = time_global()
	local cfg = CONFIG.loaded

	if trigger == 0 then
		grok_delay = tg + UPDATE_DELAY
		trigger = 1
	end

	if not (trigger == 1 and tg > grok_delay) then
		return
	end
	trigger = 0

	local obj = find_id_target()
	local valid = HUD and obj ~= nil

	if valid then
		if LastHitObject then
			if obj:id() ~= LastHitObject:id() then
				target_enter(obj)
			elseif fade_active then
				target_enter(obj)
			end
		else
			target_enter(obj)
		end
		LastHitObject = obj
		line_target_id = obj:id()
		return
	end

	if LastHitObject then
		-- Keep line_target_id through fade so the leader line can track.
		LastHitObject = nil
		target_lost()
	end
end

function npc_on_death_callback(npc, who)
	if not LastHitObject then
		return
	end
	if npc:id() ~= LastHitObject:id() then
		return
	end

	if CONFIG.loaded.dead_id then
		cancel_fade()
		display_faction(npc)
	else
		LastHitObject = nil
		target_lost()
	end
end

function npc_on_net_destroy(npc)
	if line_target_id and npc:id() == line_target_id then
		line_target_id = nil
	end
	if not LastHitObject then
		return
	end
	if npc:id() == LastHitObject:id() then
		LastHitObject = nil
		clear()
	end
end

function GUI_on_show(gui, str2)
	if gui == "Dialog" then
		local obj = mob_trade.GetTalkingNpc()
		if obj and LastHitObject and LastHitObject:id() == obj:id() then
			nametable[obj:character_name()] = true
			display_faction(obj)
		end
		return
	end

	if gui == "UIInventory" then
		local obj = find_id_target()
		if not (obj and IsStalker(obj)) then
			return
		end
		if obj and obj.health <= 0 and LastHitObject and LastHitObject:id() == obj:id() then
			local mid = utils_obj.safe_bone_pos(LastHitObject, "bip01_spine")
			local pos = device().cam_pos
			if mid and pos and pos:distance_to_sqr(mid) < 4.9 then
				nametable[obj:character_name()] = true
				display_faction(obj)
			end
		end
	end
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	zombified_text = game.translate_string("ui_dogma_hud_stalker_id_zombified")
	on_option_change()

	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("on_screen_resolution_changed", on_screen_resolution_changed)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)
	RegisterScriptCallback("npc_on_net_destroy", npc_on_net_destroy)
	RegisterScriptCallback("GUI_on_show", GUI_on_show)
	RegisterScriptCallback("on_option_change", on_option_change)
end
