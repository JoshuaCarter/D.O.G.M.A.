	return {
		id = "faster_skinning",
		text = "Faster Skinning",
		gr = {
			{
				id = "main",
				sh = true,
				text = "Main",
				gr = MCM.with_header({
					{
						id = "enabled",
						type = "check",
						val = 1,
						def = true,
						hint = "dogma_faster_skinning_enabled",
					},
					{
						id = "skin_speed_multiplier",
						type = "track",
						val = 2,
						min = 1,
						max = 2,
						step = 0.1,
						def = 1.5,
						hint = "dogma_faster_skinning_skin_speed_multiplier",
					},
					{
						id = "auto_crouch",
						type = "check",
						val = 1,
						def = false,
						hint = "dogma_faster_skinning_auto_crouch",
					},
					{
						id = "look_at_mutant",
						type = "check",
						val = 1,
						def = false,
						hint = "dogma_faster_skinning_look_at_mutant",
					},
					{
						id = "look_at_offset",
						type = "track",
						val = 2,
						min = 0,
						max = 1,
						step = 0.05,
						def = 0.6,
