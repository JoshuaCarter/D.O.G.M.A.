function scale_hit_power_display(obj, sec, base_file, base_func, param)
	local base = _G[base_file][base_func](obj, sec, param)
	return math.floor(base * DAMAGE_SCALE)
end

local function dist_atten(air_res, dist)
	return 1 + dist / 200 * air_res * 0.5 / (1 - air_res + 0.1)
end

local function calc_range()
	return tonumber(CONFIG.loaded.calc_range_m) or REF_DIST_M
end

-- Barrel part condition 0..1. Missing parts data => 1.0.
local function raw_barrel_condition(obj)
	if not obj then
		return 1
	end
	local ok, parts = pcall(function()
		return se_load_var(obj:id(), obj:name(), "parts")
	end)
	if not ok or type(parts) ~= "table" then
		return 1
	end
	for k, v in pairs(parts) do
		if type(k) == "string" and string.find(k, "barrel", 1, true) then
			local n = tonumber(v)
			if n then
				return clamp(n / 100, 0, 1)
			end
		end
	end
	return 1
end

-- CQC corrected barrel mult (same curve for stalker and mutant). Cap at 1.
-- When use_condition is false, always 1.0 (100%).
local function barrel_mult(obj, use_condition)
	if not use_condition then
		return 1
	end
	local bc = raw_barrel_condition(obj)
	local corrected = (130 - (1.12 * bc)) * (bc * 1.12) / 100
	if corrected > 1 then
		return 1
	end
	return corrected
end

-- GAMMA character-creation difficulty (1-4). Falls back to engine gd index.
local function difficulty_mult()
	local ok, state = pcall(function()
		return alife_storage_manager.get_state()
	end)
	if ok and state and type(state.diff_game) == "table" then
		local t = tonumber(state.diff_game.type)
		if t and DIFFICULTY_MULT[t] then
			return DIFFICULTY_MULT[t]
		end
	end
	if level and level.get_game_difficulty then
		local gd = level.get_game_difficulty()
		-- Engine is 0-based; GAMMA diff_game type is 1-based.
		local t = (tonumber(gd) or 0) + 1
		if DIFFICULTY_MULT[t] then
			return DIFFICULTY_MULT[t]
		end
	end
	return 1.0
end

local function ap_display_color(ap, silencer)
	-- Display AP (k_ap x 1000) needed for CQC combat_ap to first penetrate 0.650 torso armor.
	local dist_mult = dist_atten(AP_COLOR_REF_AIR, calc_range())
	local k_ap_ltx = AP_COLOR_ARMOR * dist_mult
		/ (K_AP_COMBAT_SCALE * AP_COLOR_AP_SCALE * AP_TAIL * difficulty_mult() * (silencer or 1))
	local hi = math.max(math.ceil(k_ap_ltx * AP_SCALE), 1)
	local t = clamp((tonumber(ap) or 0) / hi, 0, 1)
	-- MCM color_scale_from -> white.
	local lo_rgb = scale_from_rgb()
	return GetARGB(255,
		math.floor(lerp(lo_rgb[1], 255, t)),
		math.floor(lerp(lo_rgb[2], 255, t)),
		math.floor(lerp(lo_rgb[3], 255, t)))
end

-- CQC NPC ammo_mult (only 7.62x25 P is special).
local function npc_ammo_mult(ammo_sec)
	if ammo_sec == "ammo_7.62x25_p" then
		return 1.75
	end
	return 1.0
end

-- CQC silencer_boost: 1.07 if attached silencer or integrated suppressor parent.
local function silencer_mult(obj, sec, enabled)
	if not enabled then
		return 1
	end
	if obj then
		local ok, has = pcall(function()
			return obj:weapon_is_silencer()
		end)
		if ok and has then
			return SILENCER_BOOST
		end
	end
	local parent = sec and (ini_sys:r_string_ex(sec, "parent_section") or sec) or nil
	if dogma.item_stats.has_integrated_silencer(sec, parent) then
		return SILENCER_BOOST
	end
	return 1
end

-- CQC sniper list: +0.05 on (ini k_ap * 10), before bone ap_scale / range / tail.
local function sniper_ap_bonus(sec)
	if not sec then
		return 0
	end
	local parent = ini_sys:r_string_ex(sec, "parent_section") or sec
	return dogma.item_stats.sniper_ap_bonus(sec, parent)
end

-- Display AP (ammo-card scale): ini k_ap x1000, plus +5 when sniper bonus applies.
local function display_ap(k_ap_ltx, sniper_bonus)
	local bonus = (sniper_bonus or 0) * (AP_SCALE / K_AP_COMBAT_SCALE)
	return math.floor((k_ap_ltx or 0) * AP_SCALE + bonus + 0.5)
end

-- CQC: (ini k_ap x10 + sniper) x ap_scale x barrel / range_factor x 0.80 x difficulty x silencer.
local function combat_ap(k_ap_ltx, air_res, dist, ap_scale, barrel, silencer, sniper_bonus)
	return (k_ap_ltx * K_AP_COMBAT_SCALE + (sniper_bonus or 0))
		* ap_scale * (barrel or 1)
		/ dist_atten(air_res, dist)
		* AP_TAIL
		* difficulty_mult()
		* (silencer or 1)
end

-- CQC NPC power, plus difficulty, optional barrel, NPC ammo_mult, and silencer.
local function base_power(hit_power, k_hit, air_res, dist, bone_mult, ap_scale, pellet_mult, barrel, ammo_sec, silencer)
	return hit_power / dist_atten(air_res, dist)
		* k_hit * bone_mult * ap_scale * BALLISTIC_BONUS * pellet_mult
		* difficulty_mult() * (barrel or 1)
		* npc_ammo_mult(ammo_sec)
		* (silencer or 1)
end

local function effective_dmg(hit_power, k_hit, k_ap_ltx, air_res, armor, ap_scale, hit_frac, bone_mult, dist, pellet_mult, barrel, ammo_sec, silencer, sniper_bonus)
	local ap = combat_ap(k_ap_ltx, air_res, dist, ap_scale, barrel, silencer, sniper_bonus)
	local power = base_power(hit_power, k_hit, air_res, dist, bone_mult, ap_scale, pellet_mult, barrel, ammo_sec, silencer)
	local dmg
	-- Armor 0 (bare head): always full power.
	if armor <= 0 or ap >= armor then
		dmg = power
	else
		-- Fresh armor chip: new_armor = armor - ap x 0.60. Soft-pen if ap > new_armor
		-- => ap > armor / (1 + 0.60). Else hard-fail residual (+ HP divisor when listed).
		local soft_pen_ap = armor / (1 + ARMOR_CHIP_FRAC)
		if ap > soft_pen_ap then
			dmg = power * hit_frac
		else
			local hp_ammo_mult = HP_AMMO_MULT[ammo_sec] or 1
			dmg = HARD_FAIL_SCALE * power * hit_frac / hp_ammo_mult
		end
	end
	return {
		dmg = dmg * DAMAGE_SCALE,
	}
end

local function fmt_tier_cells(vals, num_tiers)
	local out = {}
	for i = 1, num_tiers do
		local cell = vals[i]
		if cell then
			out[i] = {
				text = tostring(math.floor(cell.dmg + 0.5)),
				dmg = cell.dmg,
			}
		end
	end
	return out
end

-- Highest damage in a table section across every ammo row (torso or head).
local function section_dmg_max(rows, section)
	local hi = 1
	local n = (section == "head") and NUM_HEAD_TIERS or NUM_TORSO_TIERS
	for _, row in ipairs(rows) do
		local cells = section == "torso" and row.torso or row.head
		for i = 1, n do
			local c = cells[i]
			if c and c.dmg > hi then
				hi = c.dmg
			end
		end
	end
	return hi
end

local function calc_tier_damages(hit_power, k_hit, k_ap_ltx, air_res, tiers, headshot, dist, pellet_mult, barrel, ammo_sec, silencer, sniper_bonus)
	local bone_mult = headshot and BONE_DMG_HEAD or BONE_DMG_TORSO
	local out = {}
	for i, tier in ipairs(tiers) do
		out[i] = effective_dmg(
			hit_power, k_hit, k_ap_ltx, air_res, tier.armor,
			tier.ap_scale, tier.hit_frac, bone_mult,
			dist, pellet_mult, barrel, ammo_sec, silencer, sniper_bonus
		)
	end
	return out
end

-- Unique ammo rounds for a weapon (same order as the damage table).
-- ammo_order "damage": dmg desc, then AP asc. "ap": AP desc, then label.
-- "default": leave utils_item.get_ammo order (matches tooltip ammo icons).
-- class_only=true: always parse ammo_class (scoring / New Game). Live get_ammo
-- with nil obj often returns only the first round and must not drive scores.
local function collect_sorted_ammo_rounds(obj, sec, max_count, class_only)
	local ammo_class = SYS_GetParam(0, sec, "ammo_class", "")
	if not ammo_class or ammo_class == "" then
		log_item_once("no_ammo_class", sec, string.format("%s: no ammo_class", sec))
		return nil
	end

	local from_class = {}
	for part in string.gmatch(ammo_class, "([^,]+)") do
		local t = part:match("^%s*(.-)%s*$")
		if t and t ~= "" then
			from_class[#from_class + 1] = t
		end
	end

	local ammo_list = nil
	if not class_only and utils_item and utils_item.get_ammo then
		-- Live inventory ammo when available; New Game / nil-obj often returns
		-- only the first round - prefer the full ammo_class list whenever longer.
		ammo_list = utils_item.get_ammo(sec, safe_id(obj))
	end
	if not ammo_list or not ammo_list[1] then
		ammo_list = from_class
	elseif #from_class > #ammo_list then
		ammo_list = from_class
	end

	local sniper_ap = sniper_ap_bonus(sec)
	local rounds = {}
	local seen = {}

	for _, ammo_sec in ipairs(ammo_list) do
		if ammo_sec ~= BUCK_SELF and not seen[ammo_sec] and ini_sys:section_exist(ammo_sec)
			and not is_degraded_ammo(ammo_sec) then
			seen[ammo_sec] = true

			local k_hit = ini_sys:r_float_ex(ammo_sec, "k_hit") or 1
			local k_ap = ini_sys:r_float_ex(ammo_sec, "k_ap") or 0
			local air_res = ini_sys:r_float_ex(ammo_sec, "k_air_resistance") or 0.05
			-- Pellet count is per-round: a weapon's ammo_class can mix slugs
			-- (1 projectile) with buckshot (many), so each row must use its
			-- own round's pellet count, not the highest one seen across the
			-- whole ammo_class. MCM pellet_hit_pct scales multi-pellet rounds only.
			local pellets = ini_sys:r_float_ex(ammo_sec, "buck_shot") or 0
			pellets = (pellets > 1) and pellets or 1
			if pellets > 1 then
				pellets = pellets * ((tonumber(CONFIG.loaded.pellet_hit_pct) or 100) / 100)
				if pellets < 1 then
					pellets = 1
				end
			end

			rounds[#rounds + 1] = {
				sec = ammo_sec,
				label = ammo_display_label(ammo_sec),
				k_hit = k_hit,
				k_ap = k_ap,
				air_res = air_res,
				pellets = pellets,
				-- Includes sniper +5 when applicable (CQC +0.05 after k_ap x10).
				ap = display_ap(k_ap, sniper_ap),
				-- Weapon hit_power is constant per gun; sort by ammo damage contribution.
				dmg = k_hit * pellets,
			}
		end
	end

	if #rounds == 0 then
		log_item_once("no_valid_rounds", sec, string.format("%s: no usable ammo rounds (ammo_class=%s)", sec, ammo_class))
		return nil
	end

	if CONFIG.loaded.ammo_order ~= "default" then
		table.sort(rounds, function(a, b)
			if CONFIG.loaded.ammo_order == "ap" then
				if a.ap ~= b.ap then
					return a.ap > b.ap
				end
				return a.label < b.label
			end
			if a.dmg ~= b.dmg then
				return a.dmg > b.dmg
			end
			if a.ap ~= b.ap then
				return a.ap < b.ap
			end
			return a.label < b.label
		end)
	end

	if max_count and #rounds > max_count then
		local capped = {}
		for i = 1, max_count do
			capped[i] = rounds[i]
		end
		return capped
	end

	return rounds
end

local function build_ammo_damage_rows(obj, sec)
	dogma.perf.start("weapon_tooltips", "build_ammo_damage_rows")
	local all = collect_sorted_ammo_rounds(obj, sec, nil)
	if not all then
		dogma.perf.stop()
		return nil
	end

	local max_rows = #ROW_XML
	local more = 0
	local rounds = all
	if #all > max_rows then
		more = #all - max_rows
		rounds = {}
		for i = 1, max_rows do
			rounds[i] = all[i]
		end
	end

	local hit_power = gun_hit_power(obj, sec)
	if hit_power <= 0 then
		log_item_once("no_hit_power", sec, string.format("%s: hit_power<=0", sec))
		dogma.perf.stop()
		return nil
	end

	local dist = calc_range()
	local barrel = barrel_mult(obj, CONFIG.loaded.use_condition_table)
	local silencer = silencer_mult(obj, sec, CONFIG.loaded.apply_silencer_table)
	local sniper_ap = sniper_ap_bonus(sec)
	local rows = {}
	for _, r in ipairs(rounds) do
		local torso = fmt_tier_cells(calc_tier_damages(
			hit_power, r.k_hit, r.k_ap, r.air_res, TORSO_TIERS,
			false, dist, r.pellets, barrel, r.sec, silencer, sniper_ap
		), NUM_TORSO_TIERS)
		local head = fmt_tier_cells(calc_tier_damages(
			hit_power, r.k_hit, r.k_ap, r.air_res, HEAD_TIERS,
			true, dist, r.pellets, barrel, r.sec, silencer, sniper_ap
		), NUM_HEAD_TIERS)
		rows[#rows + 1] = {
			label = r.label,
			ap = r.ap,
			torso = torso,
			head = head,
		}
	end

	if #rows == 0 then
		dogma.perf.stop()
		return nil
	end

	-- Shared color scale per section: 1 (grey) .. max damage (bright green).
	local torso_hi = section_dmg_max(rows, "torso")
	local head_hi = section_dmg_max(rows, "head")
	local ordered = {}

	for _, row in ipairs(rows) do
		ordered[#ordered + 1] = {
			type = row.label,
			ap = tostring(row.ap),
			ap_val = row.ap,
			torso = row.torso,
			head = row.head,
			torso_lo = 1,
			torso_hi = torso_hi,
			head_lo = 1,
			head_hi = head_hi,
		}
	end

	dogma.perf.stop()
	return {
		rows = ordered,
		silencer = silencer,
		more = more,
	}
end

-- Mutant ammo_mult (default 0.85). Matches CQC monster hit rules; Pseudogiant-only
-- overrides are intentionally omitted (this row is generic flesh damage).
local MUTANT_BASE_MULT = 0.85
local MUTANT_AMMO_MULT_DEFAULT = 0.85
local MUTANT_AMMO_MULT = {
	["ammo_12x70_buck"] = 0.90,
	["ammo_20x70_buck"] = 0.90,
	["ammo_23x75_shrapnel"] = 1.00,
	["ammo_12x76_zhekan"] = 1.00,
	["ammo_23x75_barrikada"] = 1.00,
	["ammo_9x19_pbp"] = 1.00,
	["ammo_9x18_pmm"] = 1.00,
	["ammo_5.45x39_ep"] = 1.00,
	["ammo_5.56x45_ss190"] = 1.00,
	["ammo_7.62x25_ps"] = 1.00,
	["ammo_7.62x25_p"] = 1.75,
	["ammo_357_hp_mag"] = 1.00,
	["ammo_11.43x23_hydro"] = 1.00,
	["ammo_11.43x23_fmj"] = 1.00,
}

-- Per-ammo flesh damage vs a generic mutant (species mult 100%, no weak spot).
-- Same ammo order as the damage table. Returns { {sec=, label=, dmg=}, ... } or nil.
mutant_ammo_damage_items = function(obj, sec)
	local rounds = collect_sorted_ammo_rounds(obj, sec, nil)
	if not rounds then
		return nil
	end

	local hit_power = gun_hit_power(obj, sec)
	if hit_power <= 0 then
		return nil
	end

	local dist = calc_range()
	local barrel = barrel_mult(obj, CONFIG.loaded.use_condition_stats)
	local diff = difficulty_mult()
	local items = {}
	for _, r in ipairs(rounds) do
		local dmg = math.floor(
			hit_power / dist_atten(r.air_res, dist)
				* r.k_hit * r.pellets
				* MUTANT_BASE_MULT * (MUTANT_AMMO_MULT[r.sec] or MUTANT_AMMO_MULT_DEFAULT)
				* barrel * diff
				* DAMAGE_SCALE + 0.5
		)
		items[#items + 1] = { sec = r.sec, label = r.label, dmg = dmg }
	end
	if #items == 0 then
		return nil
	end
	return items
end

-- Per-ammo pre-armor stalker torso damage at calc_range() (CQC power, no AP/armor).
stalker_ammo_damage_items = function(obj, sec)
	local rounds = collect_sorted_ammo_rounds(obj, sec, nil)
	if not rounds then
		return nil
	end

	local hit_power = gun_hit_power(obj, sec)
	if hit_power <= 0 then
		return nil
	end

	local dist = calc_range()
	local barrel = barrel_mult(obj, CONFIG.loaded.use_condition_stats)
	local silencer = silencer_mult(obj, sec, CONFIG.loaded.apply_silencer_stats)
	local items = {}
	for _, r in ipairs(rounds) do
		local dmg = math.floor(
			base_power(hit_power, r.k_hit, r.air_res, dist, BONE_DMG_TORSO, 1.0, r.pellets, barrel, r.sec, silencer)
				* DAMAGE_SCALE + 0.5
		)
		items[#items + 1] = { sec = r.sec, label = r.label, dmg = dmg }
	end
	if #items == 0 then
		return nil
	end
	return items
end

_G.dogma_gui_weapon_tooltips = _G.dogma_gui_weapon_tooltips or {}
_G.dogma_gui_weapon_tooltips.ammo_display_label = ammo_display_label
-- Prefer stats.script implementation when present (same function name).
if not _G.dogma_gui_weapon_tooltips.weapon_use_mag then
	_G.dogma_gui_weapon_tooltips.weapon_use_mag = function(wpn_sec)
		local S = zzzz_dogma_gui_weapon_tooltips_stats
		if S and S.weapon_use_mag then
			return S.weapon_use_mag(wpn_sec)
		end
		return nil
	end
end
if not _G.dogma_gui_weapon_tooltips.weapon_reload_seconds then
	_G.dogma_gui_weapon_tooltips.weapon_reload_seconds = function(wpn_sec)
		local S = zzzz_dogma_gui_weapon_tooltips_stats
		if S and S.weapon_reload_seconds then
			return S.weapon_reload_seconds(wpn_sec)
		end
		return nil
	end
end

local function slash_from_damage_items(items)
	if not items then
		return nil
	end
	local parts = {}
	for _, it in ipairs(items) do
		parts[#parts + 1] = color_ammo_value(it.label, it.dmg)
	end
	-- Color codes wrap each value; separators stay default (not ammo-colored).
	return table.concat(parts, TYPE_CODE_DEFAULT .. " / ")
end

format_raw_ammo_damage_slash = function(obj, sec)
	return slash_from_damage_items(mutant_ammo_damage_items(obj, sec))
end

format_stalker_ammo_damage_slash = function(obj, sec)
	return slash_from_damage_items(stalker_ammo_damage_items(obj, sec))
end

local function apply_column_headers(fields)
	if not fields or not fields.col_labels then
		return
	end

	if fields.title then
		fields.title:SetTextColor(CLR.white)
	end
	if fields.grp_torso then
		fields.grp_torso:SetText("vs Torso Armor")
		fields.grp_torso:SetTextColor(CLR.white)
	end
	if fields.grp_head then
		fields.grp_head:SetText("vs Head Armor")
		fields.grp_head:SetTextColor(CLR.white)
	end

	for i, tier in ipairs(TORSO_TIERS) do
		local wnd = fields.col_labels.torso[i]
		if wnd then
			wnd:SetText(column_header_text(tier))
			wnd:SetTextColor(CLR.hdr)
		end
	end
	for i, tier in ipairs(HEAD_TIERS) do
		local wnd = fields.col_labels.head[i]
		if wnd then
			wnd:SetText(column_header_text(tier))
			wnd:SetTextColor(CLR.hdr)
		end
	end
end

local function set_damage_cell(wnd, cell, lo, hi)
	if not wnd then
		return
	end
	if cell then
		wnd:SetText(cell.text)
		wnd:SetTextColor(dmg_value_color(cell.dmg, lo, hi))
	else
		wnd:SetText("")
		wnd:SetTextColor(CLR.value)
	end
end

local function hide_damage_panel(info)
	if not info.dogma_wpn_damage then
		return
	end

	local fields = info.dogma_wpn_fields
	if fields then
		for _, row in ipairs(fields.rows) do
			row.base:Show(false)
		end
	end

	info.dogma_wpn_damage:Show(false)
end

-- Child fields are attached to their row's own base static, so their XML y is
-- relative to the row (not the panel). Otherwise every row would draw at the
-- same y and stack on top of each other. Only the dynamic number cells are kept
-- as refs; static text lives in the XML and just needs to exist.
local function init_row_fields(xml, dlg, row_path)
	local base = xml:InitStatic(row_path, dlg)
	local row = {
		base = base,
		type = xml:InitTextWnd(row_path .. ":type", base),
		ap = xml:InitTextWnd(row_path .. ":ap", base),
		torso = {},
		head = {},
	}
	for i = 1, NUM_TORSO_TIERS do
		row.torso[i] = xml:InitTextWnd(row_path .. ":t" .. i, base)
	end
	for i = 1, NUM_HEAD_TIERS do
		row.head[i] = xml:InitTextWnd(row_path .. ":h" .. i, base)
	end
	return row
end

local COL_HDR_2 = { "type", "ap" }
for i = 1, NUM_TORSO_TIERS do
	COL_HDR_2[#COL_HDR_2 + 1] = "t" .. i
end
for i = 1, NUM_HEAD_TIERS do
	COL_HDR_2[#COL_HDR_2 + 1] = "h" .. i
end

-- Read row pitch from the XML positions set at init (row_1/row_2). Panel height
-- ends flush with the last visible data row. Armor column start/step/gap come
-- from col_hdr_2 so packing keeps the authored spacing.
local function read_layout_metrics(fields)
	local row1 = fields.rows[1] and fields.rows[1].base
	local row2 = fields.rows[2] and fields.rows[2].base
	if not (row1 and row2) then
		return nil
	end

	local data_top_y = row1:GetWndPos().y
	local row_step = row2:GetWndPos().y - data_top_y
	local row_h = row1:GetHeight()

	local t1 = fields.col_labels.torso[1]
	local t2 = fields.col_labels.torso[2]
	local h1 = fields.col_labels.head[1]
	local torso_start = t1 and t1:GetWndPos().x or 58
	local col_step = (t1 and t2) and (t2:GetWndPos().x - t1:GetWndPos().x) or 18
	local head_xml_start = h1 and h1:GetWndPos().x or 230
	local section_gap = head_xml_start - (torso_start + NUM_TORSO_TIERS * col_step)

	return {
		data_top_y = data_top_y,
		row_step = row_step,
		row_h = row_h,
		torso_start = torso_start,
		col_step = col_step,
		section_gap = section_gap,
	}
end

-- Pack visible armor columns left; keep Type/AP fixed. Disabled cols leave extra
-- empty width on the right (panel width unchanged). Returns xs + which groups show.
-- ponytail: O(n) scan of fixed tier counts; upgrade only if tiers become dynamic.
local function pack_armor_columns(torso_on, head_on, torso_start, step, gap)
	local xs_torso, xs_head = {}, {}
	local x = torso_start
	local any_torso, any_head = false, false
	local torso_first_x, head_first_x

	for i = 1, #torso_on do
		if torso_on[i] then
			if not torso_first_x then
				torso_first_x = x
			end
			xs_torso[i] = x
			x = x + step
			any_torso = true
		end
	end
	for i = 1, #head_on do
		if head_on[i] then
			any_head = true
			break
		end
	end
	if any_torso and any_head then
		x = x + gap
	elseif any_head and not any_torso then
		x = torso_start
	end
	for i = 1, #head_on do
		if head_on[i] then
			if not head_first_x then
				head_first_x = x
			end
			xs_head[i] = x
			x = x + step
		end
	end

	return xs_torso, xs_head, any_torso, any_head, torso_first_x, head_first_x
end

local function set_wnd_x(wnd, x)
	if not wnd or x == nil then
		return
	end
	local p = wnd:GetWndPos()
	wnd:SetWndPos(vector2():set(x, p.y))
end

local function apply_armor_column_layout(fields)
	if not fields or not fields.layout or not fields.col_labels then
		return
	end

	local layout = fields.layout
	local torso_on, head_on = {}, {}
	for i = 1, NUM_TORSO_TIERS do
		torso_on[i] = CONFIG.loaded["show_torso_" .. i] ~= false
	end
	for i = 1, NUM_HEAD_TIERS do
		head_on[i] = CONFIG.loaded["show_head_" .. i] ~= false
	end

	local xs_t, xs_h, any_torso, any_head, torso_x, head_x = pack_armor_columns(
		torso_on, head_on, layout.torso_start, layout.col_step, layout.section_gap)

	if fields.grp_torso then
		if any_torso then
			fields.grp_torso:Show(true)
			fields.grp_torso:SetText("vs Torso Armor")
			set_wnd_x(fields.grp_torso, torso_x)
		else
			fields.grp_torso:Show(false)
		end
	end
	if fields.grp_head then
		if any_head then
			fields.grp_head:Show(true)
			fields.grp_head:SetText("vs Head Armor")
			set_wnd_x(fields.grp_head, head_x)
		else
			fields.grp_head:Show(false)
		end
	end

	for i = 1, NUM_TORSO_TIERS do
		local hdr = fields.col_labels.torso[i]
		if hdr then
			if torso_on[i] then
				set_wnd_x(hdr, xs_t[i])
				hdr:Show(true)
			else
				hdr:Show(false)
			end
		end
		for _, row in ipairs(fields.rows) do
			local cell = row.torso[i]
			if cell then
				if torso_on[i] then
					set_wnd_x(cell, xs_t[i])
					cell:Show(true)
				else
					cell:Show(false)
				end
			end
		end
	end
	for i = 1, NUM_HEAD_TIERS do
		local hdr = fields.col_labels.head[i]
		if hdr then
			if head_on[i] then
				set_wnd_x(hdr, xs_h[i])
				hdr:Show(true)
			else
				hdr:Show(false)
			end
		end
		for _, row in ipairs(fields.rows) do
			local cell = row.head[i]
			if cell then
				if head_on[i] then
					set_wnd_x(cell, xs_h[i])
					cell:Show(true)
				else
					cell:Show(false)
				end
			end
		end
	end
end

local function create_damage_fields(parent, panel_x)
	local ok, dlg = pcall(function()
		return DAMAGE_XML:InitStatic("panel", parent)
	end)
	if not ok or not dlg then
		log_once("panel_xml_fail", "create_damage_fields: ui_dogma_gui_weapon_tooltips.xml init failed")
		return nil, nil
	end

	if panel_x ~= nil then
		local pos = dlg:GetWndPos()
		dlg:SetWndPos(vector2():set(panel_x, pos.y))
	end

	local header = DAMAGE_XML:InitStatic("panel:header", dlg)
	local col_hdr_2 = DAMAGE_XML:InitStatic("panel:col_hdr_2", dlg)
	if not (header and col_hdr_2) then
		log_once("panel_hdr_fail", "create_damage_fields: header/col_hdr_2 init failed")
		return nil, nil
	end

	local title = DAMAGE_XML:InitTextWnd("panel:header:title", header)
	local grp_torso = DAMAGE_XML:InitTextWnd("panel:header:grp_torso", header)
	local grp_head = DAMAGE_XML:InitTextWnd("panel:header:grp_head", header)

	local col_labels = { torso = {}, head = {} }
	for _, name in ipairs(COL_HDR_2) do
		if name:match("^t%d") then
			col_labels.torso[tonumber(name:sub(2))] = DAMAGE_XML:InitTextWnd("panel:col_hdr_2:" .. name, col_hdr_2)
		elseif name:match("^h%d") then
			col_labels.head[tonumber(name:sub(2))] = DAMAGE_XML:InitTextWnd("panel:col_hdr_2:" .. name, col_hdr_2)
		else
			DAMAGE_XML:InitTextWnd("panel:col_hdr_2:" .. name, col_hdr_2)
		end
	end

	local fields = {
		dlg = dlg,
		header = header,
		title = title,
		col_hdr_2 = col_hdr_2,
		grp_torso = grp_torso,
		grp_head = grp_head,
		col_labels = col_labels,
		rows = {},
	}

	for i, row_path in ipairs(ROW_XML) do
		local row = init_row_fields(DAMAGE_XML, dlg, row_path)
		if not row.base then
			log_once("panel_row_fail", "create_damage_fields: row init failed: " .. tostring(row_path))
			return nil, nil
		end
		row.base:Show(false)
		fields.rows[i] = row
	end

	fields.layout = read_layout_metrics(fields)
	if not fields.layout then
		log_once("panel_layout_fail", "create_damage_fields: layout metrics missing")
		return nil, nil
	end
	apply_column_headers(fields)
	apply_armor_column_layout(fields)

	return dlg, fields
end

-- panel_width: optional fixed width (details scroll); default uses parent/desc width.
local function populate_damage_fields(fields, data, panel_width)
	if not fields or not fields.dlg or not data then
		return false
	end

	local layout = fields.layout
	if not layout then
		return false
	end

	apply_column_headers(fields)
	apply_armor_column_layout(fields)

	if fields.title then
		local more = tonumber(data.more) or 0
		if more > 0 then
			fields.title:SetText(string.format("DAMAGE (+%d)", more))
		else
			fields.title:SetText("DAMAGE")
		end
	end

	local row_pad = tonumber(CONFIG.loaded.table_row_pad) or 0
	if row_pad < 0 then
		row_pad = 0
	end
	local any_row = false
	local row_y = layout.data_top_y
	local last_row_y = layout.data_top_y
	for i, row in ipairs(fields.rows) do
		local rd = data.rows[i]
		if rd then
			row.type:SetText(rd.type or "")
			row.type:SetTextColor(ammo_type_color(rd.type))
			row.ap:SetText(rd.ap or "")
			row.ap:SetTextColor(ap_display_color(rd.ap_val or 0, data.silencer))
			for t = 1, NUM_TORSO_TIERS do
				set_damage_cell(row.torso[t], rd.torso and rd.torso[t], rd.torso_lo, rd.torso_hi)
			end
			for h = 1, NUM_HEAD_TIERS do
				set_damage_cell(row.head[h], rd.head and rd.head[h], rd.head_lo, rd.head_hi)
			end
			row.base:SetWndPos(vector2():set(0, row_y))
			row.base:Show(true)
			last_row_y = row_y
			row_y = row_y + layout.row_step + row_pad
			any_row = true
		else
			row.base:Show(false)
		end
	end

	if not any_row then
		fields.dlg:Show(false)
		return false
	end

	local w = panel_width or fields.dlg:GetWidth()
	local panel_h = last_row_y + layout.row_h
	fields.dlg:SetWndSize(vector2():set(w, panel_h))
	fields.dlg:Show(true)
	return true
end

local DETAILS_PANEL_WIDTH = 500

local function add_details_damage_section(sheet, obj)
	if not CONFIG.loaded.damage_table_details or not sheet or not sheet.scroll or not sheet.xml then
		return
	end

	local sec = safe_section(obj)
	if not sec then
		return
	end
	sec = ini_sys:r_string_ex(sec, "parent_section") or sec
	-- IsWeapon(sec) crashes on section strings; use ammo_class like GetType.
	if not ini_sys:r_string_ex(sec, "ammo_class") or IsItem("fake_ammo_wpn", sec) then
		return
	end

	local damage_data = build_ammo_damage_rows(obj, sec)
	if not damage_data then
		return
	end

	local xml = sheet.xml
	local _st = xml:InitStatic("itm_details:form", nil)
	local dlg, fields = create_damage_fields(_st, 3)
	if not dlg or not populate_damage_fields(fields, damage_data, DETAILS_PANEL_WIDTH) then
		log_item_once("details_fail", sec, string.format("%s: details damage section failed", sec))
		return
	end

	log_tooltip("details_ok", string.format("%s: details damage section shown (%d rows)", sec, #damage_data.rows))

	utils_xml.sync_size(dlg, _st, 0, 0)
	sheet.scroll:AddWindow(_st, true)
	_st:SetAutoDelete(true)
end

local function wnd_right(wnd)
	if not wnd then
		return 0
	end
	return wnd:GetWndPos().x + wnd:GetWidth()
end

local function wnd_bottom(wnd)
	if not wnd then
		return 0
	end
	return wnd:GetWndPos().y + wnd:GetHeight()
end

local function place_below(info, tail, wnd, gap)
	if not (wnd and wnd.IsShown and wnd:IsShown()) then
		return tail
	end
	if tail then
		info:Sync_Y(tail, wnd, gap)
	end
	return wnd
end

-- Parts beside stats (Raven vertical) or under ammo (horizontal).
-- Returns tail, plus the right edge so the frame can grow sideways.
local function sync_parts_layout(info, tail)
	if not info.parts or not info.parts:IsShown() then
		return tail, 0
	end

	local stats = info.stats_dialog
	local stats_x = stats and stats:GetWndPos().x or 0
	local parts_x = info.parts:GetWndPos().x
	local vertical = stats and parts_x > stats_x + 50

	if vertical then
		local stats_pos = stats:GetWndPos()
		local parts_pos = info.parts:GetWndPos()
		info.parts:SetWndPos(vector2():set(parts_pos.x, stats_pos.y))
		if info.SyncPartsText then
			info:SyncPartsText(true)
		end
		if wnd_bottom(info.parts) > wnd_bottom(tail) then
			tail = info.parts
		end
	else
		info:Sync_Y(tail, info.parts, SECTION_GAP)
		if info.SyncPartsText then
			info:SyncPartsText()
		end
		tail = info.parts
	end

	return tail, wnd_right(info.parts)
end

local function apply_description_visibility(info)
	if not info or not info.desc then
		return
	end
	info.desc:Show(true)
	pcall(function()
		info.desc:AdjustHeightToText()
	end)
end

local function pick_header_tail(info)
	if info.desc and info.desc:IsShown() then
		local h = 0
		pcall(function()
			h = info.desc:GetHeight()
		end)
		if h > 0 then
			return info.desc
		end
	end
	if info.note and info.note:IsShown() then
		return info.note
	end
	return info.weight
end

-- Show clamps self.dialog, not the frame. Sync_H only grows the frame.
local function fit_dialog_to_frame(info, parts_right)
	local frame = info.frame
	if not frame then
		return
	end
	local fw = frame:GetWidth()
	local fh = frame:GetHeight()
	if parts_right > 0 then
		local need_w = parts_right - frame:GetWndPos().x + SECTION_GAP
		if need_w > fw then
			fw = need_w
			frame:SetWndSize(vector2():set(fw, fh))
			fh = frame:GetHeight()
		end
	end
	local dialog = info.dialog
	if dialog then
		dialog:SetWndSize(vector2():set(math.max(dialog:GetWidth(), fw), fh))
	end
	-- Some Show paths clamp `self` rather than `dialog`.
	if info.SetWndSize then
		pcall(function()
			info:SetWndSize(vector2():set(math.max(info:GetWidth(), fw), fh))
		end)
	end
end

-- Cache stock header Ys once (Sota utils.xml: name 16, weight/cost 34, note 52, desc 70).
local function cache_header_ys(info)
	if info.dogma_hdr_ys or not info.name or not info.weight or not info.desc then
		return
	end
	info.dogma_hdr_ys = {
		name = info.name:GetWndPos().y,
		weight = info.weight:GetWndPos().y,
		value = info.value and info.value:GetWndPos().y or info.weight:GetWndPos().y,
		note = info.note and info.note:GetWndPos().y or info.desc:GetWndPos().y,
		desc = info.desc:GetWndPos().y,
	}
end

local function set_wnd_y(wnd, y)
	if not wnd then
		return
	end
	local p = wnd:GetWndPos()
	wnd:SetWndPos(vector2():set(p.x, y))
end

-- Weight just under the name; STATUS/desc sits 5px closer than a full SECTION_GAP.
local function apply_compact_header(info)
	if not info or not info.name or not info.weight or not info.desc then
		return
	end
	cache_header_ys(info)
	local ys = info.dogma_hdr_ys
	if not ys then
		return
	end

	if CONFIG.loaded.compact_header then
		local weight_y = ys.name + 10
		set_wnd_y(info.weight, weight_y)
		set_wnd_y(info.value, weight_y)
		if info.note and info.note:IsShown() then
			info:Sync_Y(info.weight, info.note, SECTION_GAP)
			info:Sync_Y(info.note, info.desc, SECTION_GAP - 5)
		else
			info:Sync_Y(info.weight, info.desc, SECTION_GAP - 5)
		end
	else
		set_wnd_y(info.weight, ys.weight)
		set_wnd_y(info.value, ys.value)
		set_wnd_y(info.note, ys.note)
		set_wnd_y(info.desc, ys.desc)
	end
	apply_description_visibility(info)
end

local function refresh_weapon_damage_panel(info, obj, sec)
	if not info then
		return
	end
	if not info.dogma_wpn_damage then
		log_once("no_panel", "tooltip missing damage panel (create_damage_fields failed at init?)")
		return
	end

	hide_damage_panel(info)

	if not CONFIG.loaded.damage_table_tooltips then
		log_once("table_disabled", "damage_table_tooltips is off in MCM")
		return
	end

	-- Fill even while Pass still hides the dialog. Positions stick; Show
	-- restacks again once heights are final. Skipping here left the table
	-- at XML y on top of stats until a later item change.
	sec = sec or safe_section(obj)
	if not sec or info:GetType(sec) ~= "weapon" then
		return
	end

	log_once("update_hook", "UIInfoItem Update hook reached for a weapon tooltip")

	local damage_data = build_ammo_damage_rows(obj, sec)
	if not damage_data then
		return
	end

	local fields = info.dogma_wpn_fields
	if fields then
		local w = info.desc and info.desc:GetWidth()
		if not populate_damage_fields(fields, damage_data, w) then
			log_item_once("populate_fail", sec, string.format("%s: populate_damage_fields failed", sec))
			info.dogma_wpn_damage:Show(false)
			return
		end
		log_tooltip("panel_ok", string.format("%s: hover damage panel shown (%d rows)", sec, #damage_data.rows))
	end
end

-- One stack: header → table → stats → ammo → parts → recipes → cooking →
-- size frame+dialog. Call only after content (table / custom stats) is filled.
function layout_tooltip(info)
	if not info or not info.frame or not info.Sync_Y or not info.Sync_H then
		return
	end

	apply_compact_header(info)

	local tail = pick_header_tail(info)
	if not tail then
		return
	end

	local after_table = info.dogma_wpn_damage and info.dogma_wpn_damage:IsShown()
	if after_table then
		tail = place_below(info, tail, info.dogma_wpn_damage, PANEL_TOP_OFFSET)
	end
	tail = place_below(info, tail, info.stats_dialog, after_table and BOTTOM_OFFSET or SECTION_GAP)
	tail = place_below(info, tail, info.ammo, SECTION_GAP)
	local parts_right
	tail, parts_right = sync_parts_layout(info, tail)
	tail = place_below(info, tail, info.recipes, SECTION_GAP)
	tail = place_below(info, tail, info.cooking, SECTION_GAP)

	info:Sync_H(tail, info.frame, SECTION_GAP)
	fit_dialog_to_frame(info, parts_right or 0)
end

-- Vanilla UIInfoItem:Show pins the dialog (cursor, then lift / top-of-screen
-- when taller than 768). Call the captured Show, not self:Show.
local function clamp_tooltip(info)
	if not info or not base_uiinfo_show then
		return
	end
	if not (info.IsShown and info:IsShown()) then
		return
	end
	base_uiinfo_show(info, true)
end

-- The details/workshop sheets build stats via utils_ui.get_stats_xml, which
-- paints the value grey (clr_list p1) and never exposes the created text window
-- for later recolor (unlike the hover tooltip's reused stat boxes). So for our
-- DOGMA rows we rebuild the box ourselves with white text; everything else
-- falls through to the stock implementation.
local base_get_stats_xml

local DOGMA_WHITE_STAT_NAMES = {
	["ui_dogma_gui_weapon_tooltips_hit_power"] = true,
	["ui_dogma_gui_weapon_tooltips_stalker_damage"] = true,
	["ui_dogma_gui_weapon_tooltips_ammo_torso"] = true,
	["ui_dogma_gui_weapon_tooltips_dispersion"] = true,
	["ui_dogma_gui_weapon_tooltips_spread"] = true,
	["ui_dogma_gui_weapon_tooltips_barrel_wear"] = true,
	["ui_dogma_gui_weapon_tooltips_burst_control"] = true,
	["ui_dogma_gui_weapon_tooltips_bullet_drop"] = true,
}

local function build_white_stat_xml(handler, obj, sec, gr, stat)
	local value, nclr

	if gr.name == "ui_dogma_gui_weapon_tooltips_ammo_torso" then
		value = format_raw_ammo_damage_slash(obj, sec)
		nclr = false
	elseif gr.name == "ui_dogma_gui_weapon_tooltips_stalker_damage" then
		value = format_stalker_ammo_damage_slash(obj, sec)
		nclr = false
	elseif gr.name == "ui_dogma_gui_weapon_tooltips_hit_power" then
		value, nclr = utils_ui.get_stats_string_value(obj, sec, gr, stat)
	elseif zzzz_dogma_gui_weapon_tooltips_stats and zzzz_dogma_gui_weapon_tooltips_stats.text_for_name then
		value = zzzz_dogma_gui_weapon_tooltips_stats.text_for_name(gr.name, obj, sec)
		nclr = false
	else
		value, nclr = utils_ui.get_stats_string_value(obj, sec, gr, stat)
	end

	if not value then
		return
	end

	local st = STAT_XML:InitStatic("item_info:stats_box", handler)

	local st_icon = STAT_XML:InitStatic("item_info:stats_box:icon", st)
	st_icon:InitTexture(gr.icon_p)

	-- Only the label is whitened; the value keeps the stock grey/red like every
	-- other stat on the sheet.
	local st_cap = STAT_XML:InitTextWnd("item_info:stats_box:cap", st)
	st_cap:SetText(game.translate_string(gr.name))
	st_cap:SetTextColor(CLR.white)

	local st_txt = STAT_XML:InitTextWnd("item_info:stats_box:prog_txt", st)
	if gr.name == "ui_dogma_gui_weapon_tooltips_ammo_torso" or gr.name == "ui_dogma_gui_weapon_tooltips_stalker_damage"
		or gr.name == "ui_dogma_gui_weapon_tooltips_bullet_drop" or gr.name == "ui_dogma_gui_weapon_tooltips_dispersion"
		or gr.name == "ui_dogma_gui_weapon_tooltips_spread"
		or gr.name == "ui_dogma_gui_weapon_tooltips_burst_control" or gr.name == "ui_dogma_gui_weapon_tooltips_barrel_wear" then
		st_txt:SetTextComplexMode(true)
	end
	st_txt:SetText(value)
	st_txt:SetTextColor(nclr and CLR.stat_neg or CLR.stat_pos)

	st:SetAutoDelete(true)
	return st
end

local function get_stats_xml_hook(handler, obj, sec, gr, stat)
	local grp = gr
	if type(grp) == "string" then
		grp = utils_ui.stats_table and utils_ui.stats_table[grp]
	end

	if CONFIG.loaded.custom_stats_details
		and grp and not grp.track and grp.name and DOGMA_WHITE_STAT_NAMES[grp.name]
	then
		local ok, st = pcall(build_white_stat_xml, handler, obj, sec, grp, stat)
		if ok and st then
			return st
		end
	end

	return base_get_stats_xml(handler, obj, sec, gr, stat)
end

local base_itm_details_reset
local base_itm_details_addtext

local function itm_details_addtext_hook(self, xml, path, offset, txt)
	local ele = base_itm_details_addtext(self, xml, path, offset, txt)

	-- Vanilla adds the item description as the first text_s_l row (after weight).
	if self.dogma_details_pending and path == "text_s_l" then
		local obj = self.dogma_details_pending
		self.dogma_details_pending = nil
		add_details_damage_section(self, obj)
	end

	return ele
end

local function itm_details_reset_hook(self, obj)
	dogma.perf.start("weapon_tooltips", "itm_details_reset")
	apply_weapon_stats(CONFIG.loaded.custom_stats_details)
	if obj and CONFIG.loaded.damage_table_details then
		local sec = safe_section(obj)
		if sec then
			sec = ini_sys:r_string_ex(sec, "parent_section") or sec
			if ini_sys:r_string_ex(sec, "ammo_class") and not IsItem("fake_ammo_wpn", sec) then
				self.dogma_details_pending = obj
			end
		end
	end

	if base_itm_details_reset then
		base_itm_details_reset(self, obj)
	end

	self.dogma_details_pending = nil
	dogma.perf.stop()
end

local details_hook_ok = false

-- Vanilla/Sota UIInfoItem only pre-creates 16 stat rows. Full DOGMA + Momopate
-- can exceed that (companions + damage rows); expand once at init.
local STAT_SLOT_TARGET = 24

local function ensure_stat_slots(info)
	if not info or not info.stats or not info.stats_dialog then
		return
	end
	local n = #info.stats
	if n >= STAT_SLOT_TARGET then
		return
	end
	for i = n + 1, STAT_SLOT_TARGET do
		local slot = {}
		slot.base = STAT_XML:InitStatic("item_info:stats_box", info.stats_dialog)
		if not slot.base then
			log_once("stat_slot_fail", "ensure_stat_slots: InitStatic failed at " .. tostring(i))
			return
		end
		slot.icon = STAT_XML:InitStatic("item_info:stats_box:icon", slot.base)
		slot.cap = STAT_XML:InitTextWnd("item_info:stats_box:cap", slot.base)
		slot.bar2 = STAT_XML:InitProgressBar("item_info:stats_box:prog_bar", slot.base)
		slot.bar1 = STAT_XML:InitProgressBar("item_info:stats_box:prog_bar", slot.base)
		slot.txt = STAT_XML:InitTextWnd("item_info:stats_box:prog_txt", slot.base)
		slot.comp = STAT_XML:InitTextWnd("item_info:stats_box:compare", slot.base)
		slot.base:Show(false)
		info.stats[i] = slot
	end
end

local function install_details_hook()
	if not ui_itm_details or not ui_itm_details.UIItemSheet then
		log_once("hooks_details_missing", "details hook skipped: ui_itm_details.UIItemSheet missing")
		return
	end

	if not base_itm_details_reset then
		base_itm_details_reset = ui_itm_details.UIItemSheet.Reset
		ui_itm_details.UIItemSheet.Reset = itm_details_reset_hook
	end

	if not base_itm_details_addtext then
		base_itm_details_addtext = ui_itm_details.UIItemSheet.AddText
		ui_itm_details.UIItemSheet.AddText = itm_details_addtext_hook
	end

	if not base_get_stats_xml and utils_ui.get_stats_xml then
		base_get_stats_xml = utils_ui.get_stats_xml
		utils_ui.get_stats_xml = get_stats_xml_hook
	end

	details_hook_ok = true
end

local function uiinfo_init_hook(self, owner, delay)
	base_uiinfo_init(self, owner, delay)

	tracked_infos[self] = true
	ensure_stat_slots(self)

	if self.dogma_wpn_damage then
		return
	end

	local dlg, fields = create_damage_fields(self.dialog)
	if dlg then
		self.dogma_wpn_damage = dlg
		self.dogma_wpn_fields = fields
		dlg:Show(false)
		log_once("panel_init", "damage panel widgets created on tooltip init")
	else
		log_once("panel_init_fail", "damage panel widgets failed to create on tooltip init")
	end
end

local function uiinfo_update_hook(self, obj, sec, flags)
	dogma.perf.start("weapon_tooltips", "uiinfo_update")
	apply_weapon_stats(CONFIG.loaded.custom_stats_tooltips)
	local oid = safe_id(obj)
	local same_item = (oid and self.id and oid == self.id)
		or (not obj and sec and self.section == sec)

	base_uiinfo_update(self, obj, sec, flags)

	-- Content first, then layout. Custom stat text after every vanilla fill
	-- (sentinel functors paint "1" until replaced). Toggles only skip extras.
	if not same_item then
		tooltip_logged = {}
		refresh_weapon_damage_panel(self, obj, sec)
	end
	apply_custom_stat_display(self, obj, sec)

	local shown = self.IsShown and self:IsShown()
	if not same_item then
		if shown then
			layout_tooltip(self)
			self.dogma_layout_dirty = false
			clamp_tooltip(self)
		else
			self.dogma_layout_dirty = true
		end
	elseif self.dogma_layout_dirty and shown then
		layout_tooltip(self)
		self.dogma_layout_dirty = false
		clamp_tooltip(self)
	end
	dogma.perf.stop()
end

local function uiinfo_show_hook(self, state)
	-- Always stack before vanilla Show so the clamp sees the final dialog size.
	if state then
		layout_tooltip(self)
		self.dogma_layout_dirty = false
	end
	if base_uiinfo_show then
		base_uiinfo_show(self, state)
	end
end

local ui_hooks_ok = false

local function install_ui_hooks()
	if not utils_ui or not utils_ui.UIInfoItem then
		log_once("hooks_ui_missing", "UI hook skipped: utils_ui.UIInfoItem missing")
		return false
	end

	if utils_ui.UIInfoItem.Update ~= uiinfo_update_hook then
		-- Capture the underlying Update exactly once per Lua VM. Re-capturing
		-- on a later re-install can grab a wrapper that itself chains back to
		-- this hook, creating infinite recursion = engine stack-overflow crash
		-- on the first tooltip.
		if not base_uiinfo_update then
			base_uiinfo_update = utils_ui.UIInfoItem.Update
		end
		utils_ui.UIInfoItem.Update = uiinfo_update_hook
	end

	if not base_uiinfo_init then
		base_uiinfo_init = utils_ui.UIInfoItem.__init
		utils_ui.UIInfoItem.__init = uiinfo_init_hook
	end

	-- Pass/hover calls Update while hidden, then Show(true). Restack after
	-- Show so desc/stats heights are the ones the player actually sees.
	if utils_ui.UIInfoItem.Show and utils_ui.UIInfoItem.Show ~= uiinfo_show_hook then
		if not base_uiinfo_show then
			base_uiinfo_show = utils_ui.UIInfoItem.Show
		end
		utils_ui.UIInfoItem.Show = uiinfo_show_hook
	end

	ui_hooks_ok = true
	return true
end

-- Public: put our Update/Show back outermost. Safe to call from the New Game
-- open path (Loadout never runs actor_on_update). Captures base only once.
function reclaim_ui_hooks()
	return install_ui_hooks()
end

local function on_console_execute(cmd)
	if cmd == "g_game_difficulty" then
		apply_standing_weapon_stats()
		for info in pairs(tracked_infos) do
			info.id = nil
			info.section = nil
		end
	end
end

-- ADV/Sota replace utils_ui.stats_table.weapon on difficulty change; re-apply
-- DOGMA rows whenever their override runs so companions/placement survive.
local function hook_stats_table_override()
	if not ish_item_stats or not ish_item_stats.override_stats_table then
		return
	end
	if ish_item_stats.dogma_gui_weapon_tooltips_wrapped then
		return
	end
	local prev = ish_item_stats.override_stats_table
	ish_item_stats.override_stats_table = function()
		prev()
		apply_standing_weapon_stats()
		for info in pairs(tracked_infos) do
			info.id = nil
			info.section = nil
		end
	end
	ish_item_stats.dogma_gui_weapon_tooltips_wrapped = true
end

-- Crosshair rangefinder (Development MCM). Casts along camera look; ignores actor.
-- Flags 3 = static + objects (same as cover-tilt / xcombat rqtBoth).
local RANGEFINDER_MAX_M = 2000
local rangefinder_pick = nil

local function crosshair_range_m()
	local d = device()
	if not d or not d.cam_pos or not d.cam_dir then
		return nil
	end
	if not rangefinder_pick then
		rangefinder_pick = ray_pick()
	end
	local pick = rangefinder_pick
	pick:set_flags(3)
	pick:set_position(vector():set(d.cam_pos))
	pick:set_direction(vector():set(d.cam_dir))
	pick:set_range(RANGEFINDER_MAX_M)
	if db and db.actor then
		pick:set_ignore_object(db.actor)
	end
	if not pick:query() then
		return nil
	end
	local dist = pick:get_distance()
	if not dist or dist <= 0 then
		return nil
	end
	return dist
end

local function on_actor_update()
	-- Reclaim if another mod re-wrapped Update/Show after us.
	if ui_hooks_ok and utils_ui and utils_ui.UIInfoItem
		and (utils_ui.UIInfoItem.Update ~= uiinfo_update_hook
			or (utils_ui.UIInfoItem.Show and utils_ui.UIInfoItem.Show ~= uiinfo_show_hook))
	then
		install_ui_hooks()
	end

	local actor = dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change)
	if not actor then
		return
	end

	if not CONFIG.loaded.debug_overlay then
		return
	end
	local dist = crosshair_range_m()
	local msg
	if dist then
		if dist < 10 then
			msg = string.format("Range  %.1fm", dist)
		else
			msg = string.format("Range  %.0fm", dist)
		end
	else
		msg = string.format("Range  >%dm", RANGEFINDER_MAX_M)
	end
	overlay(OVERLAY.RANGE, msg)
end

local callbacks_registered = false

-- Everything a fresh session needs before the first tooltip can render: MCM
-- values, the UIInfoItem/details-sheet hooks, and the ADV re-apply wrapper.
-- No db.actor / level dependency, so this is safe to call from main_menu_on_init
-- (main menu boot, no game loaded yet) as well as on_game_start(). Idempotent -
-- every install_* below no-ops if already installed; on_option_change() /
-- apply_standing_weapon_stats() are cheap to re-run and always safe to repeat.
-- Callback registration is guarded separately so calling this twice (menu boot,
-- then real on_game_start) never double-registers a callback.
function early_init()
	dogma.load(CONFIG.MOD_ID)
	on_option_change()
	install_ui_hooks()
	install_details_hook()
	hook_stats_table_override()

	if not callbacks_registered then
		callbacks_registered = true
		RegisterScriptCallback("on_console_execute", on_console_execute)
		RegisterScriptCallback("on_option_change", on_option_change)
		-- MCM's apply only sends on_option_change when level.present() - at the
		-- main menu (e.g. tweaking stats before the New Game Loadout screen) it
		-- skips it and only sends mcm_option_change (dispatched unconditionally,
		-- registered at ui_mcm top level). Listen to both; in-game both fire and
		-- on_option_change is idempotent, so the double run is harmless.
		RegisterScriptCallback("mcm_option_change", on_option_change)
		RegisterScriptCallback("actor_on_update", on_actor_update)
		RegisterScriptCallback("actor_on_first_update", function()
			install_ui_hooks()
		end)
	end
end

function on_game_start()
	local tostr = tostring

	-- Packing check: full layout matches XML (head @ 230); head-only packs to torso start.
	do
		local all_t = { true, true, true, true, true, true, true, true, true }
		local all_h = { true, true, true, true, true }
		local none_t = { false, false, false, false, false, false, false, false, false }
		local _, _, _, _, _, head_x = pack_armor_columns(all_t, all_h, 58, 18, 10)
		if head_x ~= 230 then
			log_once("pack_full", "armor pack: full head start expected 230 got " .. tostring(head_x))
		end
		local _, _, any_t, any_h, _, head_only_x = pack_armor_columns(none_t, all_h, 58, 18, 10)
		if not ((not any_t) and any_h and head_only_x == 58) then
			log_once("pack_head", string.format(
				"armor pack: head-only expected start 58 got any_t=%s any_h=%s x=%s",
				tostring(any_t), tostring(any_h), tostring(head_only_x)
			))
		end
	end

	early_init()

	log_once("startup", string.format(
		"loaded: dogma=%s, ui_hooks=%s, details_hook=%s, table=%s, hit=%s, mutant=%s, place=%s, stats_mod=%s",
		tostr(dogma ~= nil), tostr(ui_hooks_ok), tostr(details_hook_ok),
		tostr(CONFIG.loaded.damage_table_tooltips), tostr(CONFIG.loaded.show_hit_power),
		tostr(CONFIG.loaded.show_mutant_damage), tostr(CONFIG.loaded.stat_row_placement),
		tostr(zzzz_dogma_gui_weapon_tooltips_stats and zzzz_dogma_gui_weapon_tooltips_stats.NAME ~= nil)))
end
