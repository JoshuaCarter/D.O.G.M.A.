-- Equipment Controls MCM

local CONFIG = _G.dogma_controls_equipment_controls_conf
local KM = dogma_mcm.keys

local MIRROR = {}
do
	local order = { "rf_scanner", "glowstick" }
	for i = 1, #order do
		local name = order[i]
		local spec = CONFIG.BINDS and CONFIG.BINDS[name]
		if spec and KM then
			MIRROR[name] = KM.mirror_spec(spec)
		end
	end
end

function on_mcm_load(options)
	local gr = {
		{
			id = "page_description",
			type = "desc",
			text = "ui_mcm_dogma_controls_equipment_controls_page_description",
		},
		{
			id = "auto_bolt_on_detector",
			type = "check",
			val = 1,
			def = CONFIG.DEFAULTS["auto_bolt_on_detector"],
			hint = "dogma_controls_equipment_controls_auto_bolt_on_detector",
		},
		dogma_mcm.key_mirror("show_detector", function()
			return key_bindings and key_bindings.kDETECTOR
		end):option("key_detector", "dogma_controls_equipment_controls_key_detector"),
		dogma_mcm.key_mirror("custom14", function()
			return key_bindings and key_bindings.kCUSTOM14
		end):option("key_geiger", "dogma_controls_equipment_controls_key_geiger"),
	}
	if MIRROR.rf_scanner then
		gr[#gr + 1] = MIRROR.rf_scanner:option("key_radio", "dogma_controls_equipment_controls_key_radio")
	end
	gr[#gr + 1] = dogma_mcm.key_mirror("torch", function()
		return key_bindings and key_bindings.kTORCH
	end):option("key_torch", "dogma_controls_equipment_controls_key_torch")
	if MIRROR.glowstick then
		gr[#gr + 1] = MIRROR.glowstick:option("key_glowstick", "dogma_controls_equipment_controls_key_glowstick")
	end

	dogma_mcm.attach(options, "controls", "ui_mcm_menu_dogma_controls", {
		id = "equipment_controls",
		sh = true,
		text = "ui_mcm_menu_dogma_controls_equipment_controls",
		gr = dogma_mcm.with_header(gr),
	})
end
