	stalker = {255, 200, 60},
	bandit = {255, 170, 40},
	csky = {80, 190, 220},
	army = {70, 160, 70},
	freedom = {90, 200, 80},
	dolg = {220, 50, 50},
	ecolog = {180, 210, 70},
	killer = {90, 110, 200},
	monolith = {255, 140, 40},
	zombied = {140, 170, 70},
	renegade = {180, 70, 70},
	greh = {160, 40, 40},
	isg = {140, 140, 150},
	actor = {255, 255, 255},
}

local KIND_RGB = {
	stalker = {255, 196, 96},
	monster = {255, 118, 96},
	world = {150, 210, 230},
}

local TYPE_INFO = {
	bullet = { label = "Gun", rgb = {220, 190, 110} },
	tear = { label = "Claws", rgb = {220, 80, 70} },
	impact = { label = "Strike", rgb = {186, 186, 196} },
	burn = { label = "Fire", rgb = {255, 140, 40} },
	explosion = { label = "Explosion", rgb = {255, 200, 50} },
	radiation = { label = "Radiation", rgb = {80, 220, 90} },
	psy = { label = "Psy", rgb = {180, 100, 255} },
	chemical = { label = "Chemical", rgb = {80, 210, 160} },
	electric = { label = "Electric", rgb = {90, 170, 255} },
	bleed = { label = "Bleed", rgb = {190, 48, 56} },
	unknown = { label = "Melee", rgb = {170, 170, 170} },
}

-- Always pooled (never a hit line). World fire/chem/psy/shock ticks too.
local DOT_ALWAYS = {
	radiation = true,
	bleed = true,
}
local DOT_WORLD = {
	burn = true,
	chemical = true,
	psy = true,
	electric = true,
}
local DOT_ORDER = { "bleed", "radiation", "burn", "chemical", "psy", "electric" }

local COL = {
	title = "%c[255,255,214,140]",
	white = "%c[255,255,255,255]",
	red = "%c[255,255,72,72]",
	orange = "%c[255,255,160,48]",
	muted = "%c[255,180,180,180]",
	dim = "%c[255,110,110,110]",
}

-- Engine hit.type → TYPE_INFO key.
local TYPE_KEY = {}

local hits = {} -- newest at index 1
local dots = {} -- { t, key, amount } over-time ticks
local death_armed = false
local preview_on = false
local report_visible = false
local last_toggle_ms = 0
local frozen = nil -- { lines, footer, dot_header, dot_lines }
local adb_wrapped = false
local bhs_rd_wrapped = false
local pending_hit = nil
local pending_snap = nil
local last_limbs = {} -- BHS key → { perm, max }, lowest remaining seen
local pending_dot = nil
local last_rad = nil
local last_hp = nil
local last_bleed = nil
local BLEED_EPS = 0.01
local refresh_if_preview = function() end
local snapshot_limbs = function()
	return {}
end
local remember_limbs = function() end
local finish_pending = function() end

-- BHS limb keys → summary labels. Limb HP is points, not 0-1; percent needs maxhp.
local DIED_LIMBS = {
	{ key = "head", label = "Head" },
	{ key = "torso", label = "Torso" },
	{ key = "leftarm", label = "L Arm" },
	{ key = "rightarm", label = "R Arm" },
	{ key = "leftleg", label = "L Leg" },
	{ key = "rightleg", label = "R Leg" },
}

local function log(msg)
	if CONFIG.loaded.debug_log then
		dogma.log.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function clamp_ui(v, lo, hi, fallback)
	v = tonumber(v) or fallback
	if v < lo then
		return lo
	end
	if v > hi then
		return hi
	end
	return math.floor(v)
end

local function panel_width()
	return clamp_ui(CONFIG.loaded.panel_width, PANEL_W_MIN, PANEL_W_MAX, 410)
end

local function panel_top()
	return clamp_ui(CONFIG.loaded.panel_top, 0, PANEL_TOP_MAX, 90)
end

-- Prompt stays at the top. Panel cannot cover it.
local function report_panel_y()
	local min_y = PROMPT_Y + PROMPT_H + PROMPT_GAP
	local y = panel_top()
	if y < min_y then
		return min_y
	end
	return y
end

local function hit_cap()
	return clamp_ui(CONFIG.loaded.hit_cap, HIT_CAP_MIN, HIT_CAP_MAX, 10)
end

local function dot_seconds()
	return clamp_ui(CONFIG.loaded.dot_seconds, 0, 10, 5)
end

local function report_armed()
	return death_armed or preview_on
end

-- Atlas height from the live letterica16 .ini (1k/2k/4k packs change this, not the section name).
local cached_font_px

local try_sect_h = function(ini, sect)
	return ini:r_float(sect, "height")
end

local try_font_ini_height = function(fs, rel)
	return fs:exist("$game_textures$", rel)
end

local try_font_ini_height_2 = function(fs, rel)
	return fs:update_path("$game_textures$", rel)
end

local function font_ini_height()
	if cached_font_px then
		return cached_font_px
	end
	if not (getFS and ini_file) then
		return nil
	end
	local fs = getFS()
	local prefix = ""
	if ini_sys and ini_sys.r_string_ex then
		prefix = ini_sys:r_string_ex("string_table", "font_prefix") or ""
	end
	local rels = { FONT_INI_REL .. prefix .. ".ini", FONT_INI_REL .. ".ini" }
	for i = 1, #rels do
		local rel = rels[i]
		local ok_ex, exists = pcall(try_font_ini_height, fs, rel)
		if ok_ex and exists then
			local ok_path, full = pcall(try_font_ini_height_2, fs, rel)
			if ok_path and full then
				local ok_ini, ini = pcall(ini_file, full)
				if ok_ini and ini then
					local function sect_h(sect)
						local ok, h = pcall(try_sect_h, ini, sect)
						return (ok and tonumber(h)) or nil
					end
					local h = sect_h("symbol_coords")
						or sect_h("mb_symbol_coords")
						or sect_h("char widths")
						or sect_h("font_size")
					if h and h > 0 then
						cached_font_px = h
						return h
					end
				end
			end
		end
	end
	return nil
end

-- Same rule UILines uses: CurrentHeight_ / (screenH / 768).
local function auto_line_height()
	local font_px = font_ini_height() or LINE_H_FALLBACK
	local scr_h = device() and tonumber(device().height)
	if not scr_h or scr_h <= 0 then
		return font_px
	end
	return font_px * UI_H / scr_h
end

local function line_height()
	return auto_line_height()
end

local function rgb_code(rgb)
	return string.format("%%c[255,%d,%d,%d]", rgb[1], rgb[2], rgb[3])
end

local function comm_rgb(comm)
	if not comm or comm == "" then
		return KIND_RGB.stalker
	end
	if COMM_RGB[comm] then
		return COMM_RGB[comm]
	end
	local base = comm:match("^([^_]+)")
	return (base and COMM_RGB[base]) or KIND_RGB.stalker
end

local function actor_hp()
	local a = db and db.actor
	if not a then
		return nil
	end
	return tonumber(a.health)
end

-- Engine radiation hits add to this meter, not health.
local function actor_radiation()
	local a = db and db.actor
	if not a then
		return nil
	end
	return tonumber(a.radiation)
end

-- Wound bleed rate (conditions().BleedingSpeed). HP drain is applied in UpdateHealth.
local function actor_bleeding()
	local a = db and db.actor
	if not a then
		return nil
	end
	return tonumber(a.bleeding)
end

local function pct_num(frac)
	frac = tonumber(frac)
	if frac == nil then
		return nil
	end
	local pct = math.floor(frac * 100 + 0.5)
	if pct < 0 then
		return 0
	end
	if pct > 100 then
		return 100
	end
	return pct
end

local function pct_txt(pct)
	if pct == nil then
		return "?"
	end
	return tostring(pct) .. "%"
end

local function dmg_txt(pct)
	if pct == nil then
		return "?"
	end
	return string.format("-%d%%", pct)
end

local function pts_pct(cur, maxv)
	cur = tonumber(cur)
	maxv = tonumber(maxv)
	if cur == nil or not maxv or maxv <= 0 then
		return nil
	end
	local pct = math.floor((cur / maxv) * 100 + 0.5)
	if pct < 0 then
		return 0
	end
	if pct > 100 then
		return 100
	end
	return pct
end

local function init_type_keys()
	if next(TYPE_KEY) then
		return
	end
	if not hit then
		return
	end
	TYPE_KEY[hit.fire_wound] = "bullet"
	TYPE_KEY[hit.wound] = "tear"
	if hit.wound_2 then
		TYPE_KEY[hit.wound_2] = "tear"
	end
	TYPE_KEY[hit.strike] = "impact"
	TYPE_KEY[hit.explosion] = "explosion"
	TYPE_KEY[hit.burn] = "burn"
	if hit.light_burn then
		TYPE_KEY[hit.light_burn] = "burn"
	end
	TYPE_KEY[hit.shock] = "electric"
	TYPE_KEY[hit.chemical_burn] = "chemical"
	TYPE_KEY[hit.radiation] = "radiation"
	TYPE_KEY[hit.telepatic] = "psy"
end

local function type_key_of(hit_type)
	init_type_keys()
	return TYPE_KEY[hit_type] or "unknown"
end

local function type_info(key)
	return TYPE_INFO[key] or TYPE_INFO.unknown
end

local try_raw_bone_name = function(a, bone_id)
	return a:bone_name(bone_id)
end

local function raw_bone_name(bone_id)
	local a = db and db.actor
	if not a or bone_id == nil then
		return nil
	end
	local ok, name = pcall(try_raw_bone_name, a, bone_id)
	if ok and name and name ~= "" then
		return name
	end
	return nil
end

local function infer_limb_from_name(s)
	if not s or s == "" then
		return nil
	end
	s = s:lower()
	if s:find("head", 1, true) or s:find("neck", 1, true) or s:find("jaw", 1, true)
		or s:find("eye", 1, true) then
		return "head"
	end
	local left = s:match("^l_") or s:find("_l_", 1, true) or s:find("left", 1, true)
	local right = s:match("^r_") or s:find("_r_", 1, true) or s:find("right", 1, true)
	if s:find("thigh", 1, true) or s:find("calf", 1, true) or s:find("foot", 1, true)
		or s:find("toe", 1, true) or s:find("leg", 1, true) then
		if left then
			return "leftleg"
		end
		if right then
			return "rightleg"
		end
		return nil
	end
	if s:find("clav", 1, true) or s:find("arm", 1, true) or s:find("hand", 1, true)
		or s:find("finger", 1, true) or s:find("wrist", 1, true) then
		if left then
			return "leftarm"
		end
		if right then
			return "rightarm"
		end
	end
	if s:find("spine", 1, true) or s:find("pelvis", 1, true) or s:find("hip", 1, true) then
		return "torso"
	end
	return nil
end

-- Bone name (then HITBOX id) picks the limb. 0 / unmapped = BHS random.
local function resolve_bone(bone_id)
	if bone_id == 65535 then
		return "body", nil
	end
	if bone_id == 0 then
		return "unknown", nil
	end
	local raw = raw_bone_name(bone_id)
	local limb = infer_limb_from_name(raw) or HITBOX[bone_id]
	if not limb then
		return "unknown", raw
	end
	return limb, raw
end

local function tr(id)
	if not id or id == "" then
		return nil
	end
	local s = game.translate_string and game.translate_string(id)
	if s and s ~= "" and s ~= id then
		return s
	end
	return nil
end

local function looks_like_id(s)
	if not s or s == "" then
		return true
	end
	if s:find("_", 1, true) then
		return true
	end
	return s:match("^[a-z][a-z0-9]*$") ~= nil
end

local try_title_case_words = function(a, rest)
	return a:upper() .. rest:lower()
end

local function title_case_words(s)
	return (s:gsub("(%a)([%w]*)", try_title_case_words))
end

local RANK_WORD = "Weak|Normal|Strong|Veteran|Expert|Master|Novice|Experienced|Average|Special"

-- Drop leftover variant tokens: "Cat Weak B" / "Boar 2" / section tails _b _2.
local function clean_source_name(s)
	if not s or s == "" then
		return s
	end
	s = s:gsub("%s+[A-Za-z]$", "")
	s = s:gsub("%s+%d+$", "")
	s = s:gsub("%s+(" .. RANK_WORD .. ")$", "")
	return s
end

local function humanize_section(sec)
	local s = sec
	s = s:gsub("^zone_mine_", ""):gsub("^zone_", "")
	s = s:gsub("_[a-z]$", "")
	s = s:gsub("_%d+$", "")
	s = s:gsub("_(weak|normal|strong|veteran|expert|master|novice|experienced|average|special)$", "")
	s = s:gsub("_", " ")
	return clean_source_name(title_case_words(s))
end

local function section_nice_name(sec, fallback)
	if not sec or sec == "" then
		return nil
	end
	local row = dogma.db.get(sec)
	if row and row.name and row.name ~= "" and not looks_like_id(row.name) then
		return row.name
	end
	local named = tr(sec)
	if named then
		return named
	end
	if ui_item and ui_item.get_sec_name then
		local n = ui_item.get_sec_name(sec)
		if n and n ~= "" and n ~= sec and not looks_like_id(n) then
			return n
		end
	end
	if ini_sys and ini_sys.r_string_ex then
		named = tr(ini_sys:r_string_ex(sec, "character_name"))
		if named then
			return named
		end
	end
	if fallback then
		return humanize_section(sec)
	end
	return nil
end

local function community_label(comm)
	if not comm or comm == "" then
		return nil
	end
	return tr("ui_st_" .. comm) or tr("st_" .. comm) or tr(comm) or title_case_words(comm:gsub("_", " "))
end

local try_is_actor = function(obj)
	return obj:id()
end

local function is_actor(obj)
	if not (obj and db.actor) then
		return false
	end
	local ok, id = pcall(try_is_actor, obj)
	return ok and id == db.actor:id()
end

local try_object_section = function(obj)
	return obj:section()
end

local function object_section(obj)
	local ok, sec = pcall(try_object_section, obj)
	if ok and sec and sec ~= "" then
		return sec
	end
	return nil
end

local try_object_char_name = function(obj)
	return obj:character_name()
end

local function object_char_name(obj)
	local ok, name = pcall(try_object_char_name, obj)
	if ok and name and name ~= "" and not looks_like_id(name) then
		return name
	end
	return nil
end

local try_weapon_obj = function(obj)
	return obj:id()
end

local try_weapon_obj_2 = function(draftsman)
	return draftsman:id()
end

local function weapon_obj(shit, draftsman)
	local wid = shit and shit.weapon_id
	if not wid or wid == 0 then
		return nil
	end
	local obj = dogma.alife.obj(wid)
	if not obj then
		return nil
	end
	if is_actor(obj) then
		return nil
	end
	if draftsman then
		local ok_id, did = pcall(try_weapon_obj_2, draftsman)
		local ok_oid, oid = pcall(try_weapon_obj, obj)
		if ok_id and ok_oid and did == oid then
			return nil
		end
	end
	return obj
end

local function weapon_label(obj)
	if not obj then
		return nil
	end
	return section_nice_name(object_section(obj), false)
end

local try_ammo_list_for = function(obj, utils_item)
	return utils_item.get_ammo(nil, obj:id())
end

local function ammo_list_for(obj)
	if not obj then
		return nil
	end
	if utils_item and utils_item.get_ammo then
		local ok, list = pcall(try_ammo_list_for, obj, utils_item)
		if ok and list and list[1] then
			return list
		end
	end
	local sec = object_section(obj)
	if not (sec and ini_sys and ini_sys.r_string_ex) then
		return nil
	end
	local s = ini_sys:r_string_ex(sec, "ammo_class")
	if not s or s == "" then
		return nil
	end
	local list = {}
	for part in string.gmatch(s, "([^,]+)") do
		local t = part:match("^%s*(.-)%s*$")
		if t and t ~= "" then
			list[#list + 1] = t
		end
	end
	if not list[1] then
		return nil
	end
	return list
end

local try_ammo_label = function(obj)
	return obj:get_ammo_type()
end

local function ammo_label(obj)
	if not obj then
		return nil
	end
	if dogma.db.is_melee(obj:section()) then
		return nil
	end
	if not obj.get_ammo_type then
		return nil
	end
	local list = ammo_list_for(obj)
	if not list then
		return nil
	end
	local ok, idx = pcall(try_ammo_label, obj)
	if not (ok and idx ~= nil) then
		return nil
	end
	local sec = list[idx + 1]
	if not sec then
		return nil
	end
	return section_nice_name(sec, true)
end

local function mutant_weapon(type_key)
	local info = type_info(type_key)
	if info and info.label and info.label ~= "Gun" then
		return info.label
	end
	return "Melee"
end

local function world_source(type_key)
	if type_key == "impact" then
		return "Fall", "impact"
	end
	if type_key == "tear" then
		return "Bleed", "bleed"
	end
	local info = type_info(type_key)
	return info.label, type_key
end

local try_source_from_draftsman = function(IsStalker, draftsman)
	return IsStalker and IsStalker(draftsman)
end

local try_source_from_draftsman_2 = function(IsMonster, draftsman)
	return IsMonster and IsMonster(draftsman)
end

local try_source_from_draftsman_3 = function(IsAnomaly, draftsman)
	return IsAnomaly and IsAnomaly(draftsman)
end

local function source_from_draftsman(draftsman, type_key)
	if not draftsman or is_actor(draftsman) then
		local name, tkey = world_source(type_key)
		return { name = name, kind = "world", type_key = tkey }
	end

	local ok_stalker, is_stalker = pcall(try_source_from_draftsman, IsStalker, draftsman)
	if ok_stalker and is_stalker then
		local name = object_char_name(draftsman)
		local comm, comm_label
		local c = dogma.alife.community(draftsman)
		local ok_c = c ~= nil
		if ok_c then
			comm = c
			comm_label = community_label(c)
		end
		if not name then
			name = comm_label
		end
		if not name then
			local sec = object_section(draftsman)
			name = section_nice_name(sec, true)
		end
		return { name = name, faction = comm_label, comm = comm, kind = "stalker" }
	end

	local ok_mon, is_mon = pcall(try_source_from_draftsman_2, IsMonster, draftsman)
	if ok_mon and is_mon then
		local name = object_char_name(draftsman) or section_nice_name(object_section(draftsman), true)
		return { name = clean_source_name(name), kind = "monster" }
	end

	local ok_an, is_an = pcall(try_source_from_draftsman_3, IsAnomaly, draftsman)
	if ok_an and is_an then
		return {
			name = section_nice_name(object_section(draftsman), true),
			kind = "world",
		}
	end

	local name = object_char_name(draftsman) or section_nice_name(object_section(draftsman), true)
	if name then
		return { name = name, kind = "world" }
	end
	local wname, tkey = world_source(type_key)
	return { name = wname, kind = "world", type_key = tkey }
end

local function prune_hits(now)
	now = now or time_global()
	local kept = {}
	for i = 1, #hits do
		local e = hits[i]
		if e and (now - e.t) <= HIT_WINDOW_MS then
			kept[#kept + 1] = e
			if #kept >= hit_cap() then
				break
			end
		end
	end
	hits = kept
end

local function is_dot(tkey, kind)
	if DOT_ALWAYS[tkey] then
		return true
	end
	return kind == "world" and DOT_WORLD[tkey]
end

local function prune_dots(now)
	now = now or time_global()
	local win_ms = dot_seconds() * 1000
	if win_ms <= 0 then
		dots = {}
		return
	end
	local kept = {}
	for i = 1, #dots do
		local e = dots[i]
		if e and (now - e.t) <= win_ms then
			kept[#kept + 1] = e
		end
	end
	dots = kept
end

local function record_dot(tkey, amount)
	if not amount or amount <= 0 then
		return
	end
	if dot_seconds() <= 0 then
		return
	end
	dots[#dots + 1] = { t = time_global(), key = tkey, amount = amount }
	prune_dots()
end

local function format_dot_section()
	local sec = dot_seconds()
	if sec <= 0 then
		return nil, nil
	end
	prune_dots()
	local sums = {}
	for i = 1, #dots do
		local e = dots[i]
		sums[e.key] = (sums[e.key] or 0) + e.amount
	end
	local lines = {}
	for i = 1, #DOT_ORDER do
		local key = DOT_ORDER[i]
		local amt = sums[key]
		if amt and amt > 0 then
			local info = type_info(key)
			lines[#lines + 1] = rgb_code(info.rgb) .. info.label .. COL.white .. ": " .. tostring(pct_num(amt)) .. "%"
		end
	end
	if #lines == 0 then
		return nil, nil
	end
	local header = COL.muted .. "Other damage over last " .. tostring(sec) .. " seconds:"
	return header, lines
end

local function hp_rgb(pct)
	if pct == nil then
		return {110, 110, 110}
	end
	if pct <= 0 then
		return {180, 48, 48}
	end
	if pct <= 25 then
		return {255, 80, 80}
	end
	if pct <= 50 then
		return {255, 160, 48}
	end
	if pct <= 75 then
		return {255, 214, 96}
	end
	return {110, 200, 130}
end

local function body_after_and_dmg(e)
	local before = e.hp_before
	local after = e.hp_after
	if before == nil or after == nil then
		return after, nil
	end
	local dmg = before - after
	if dmg < 0 then
		dmg = 0
	end
	return after, dmg
end

local function format_hit_line(e)
	local hp_after, body_dmg = body_after_and_dmg(e)
	local hp_pct = pct_num(hp_after)
	local body_pct = pct_num(body_dmg)
	local limb = LIMB_DISPLAY[e.limb] or "?"
	local limb_left
	local limb_dmg
	if e.limb_after ~= nil and e.limb_max then
		limb_left = pts_pct(e.limb_after, e.limb_max)
	end
	if e.limb_before ~= nil and e.limb_after ~= nil and e.limb_max then
		local d = e.limb_before - e.limb_after
		if d < 0 then
			d = 0
		end
		limb_dmg = pts_pct(d, e.limb_max)
	end
	local bone
	if e.limb == "unknown" then
		bone = "random"
	elseif e.bone_name and e.bone_name ~= "" then
		bone = e.bone_name
	else
		bone = "?"
	end

	local fac_rgb
	if e.kind == "stalker" then
		fac_rgb = comm_rgb(e.comm)
	else
		fac_rgb = KIND_RGB[e.kind] or KIND_RGB.world
	end
	local fac = rgb_code(fac_rgb)

	local limb_paren
	if e.limb == "unknown" then
		limb_paren = pct_txt(limb_left) .. ", random"
	else
		limb_paren = pct_txt(limb_left) .. " " .. bone
	end

	local parts = {
		COL.white .. "Body " .. COL.red .. dmg_txt(body_pct) .. COL.white .. " (" .. pct_txt(hp_pct) .. ")",
		COL.white .. limb .. " " .. COL.orange .. dmg_txt(limb_dmg) .. COL.white .. " (" .. limb_paren .. ")",
		fac .. (e.name or "?"),
	}
	if e.faction and e.faction ~= "" then
		parts[#parts + 1] = fac .. "(" .. e.faction .. ")"
	end
	if e.weapon and e.weapon ~= "" then
		parts[#parts + 1] = COL.muted .. e.weapon
	end
	if e.ammo and e.ammo ~= "" then
		parts[#parts + 1] = COL.muted .. e.ammo
	end
	return table.concat(parts, " ")
end

local function push_hit(entry)
	prune_hits(entry.t)
	table.insert(hits, 1, entry)
	while #hits > hit_cap() do
		table.remove(hits)
	end
end

local function actor_already_dead()
	if death_armed then
		return true
	end
	local a = db and db.actor
	if not a then
		return true
	end
	if a.alive and not a:alive() then
		return true
	end
	local hp = tonumber(a.health)
	return hp ~= nil and hp <= 0
end

local function record_hit(shit, bone_id)
	if actor_already_dead() then
		return
	end
	if not shit then
		return
	end
	local hit_type = shit.type
	local tkey = type_key_of(hit_type)
	local src = source_from_draftsman(shit.draftsman, tkey)
	if src.kind == "world" and tkey == "tear" then
		tkey = "bleed"
	end
	if src.type_key then
		tkey = src.type_key
	end
	-- Radiation is the dose meter (polled), not a body-HP tick.
	if tkey == "radiation" then
		return
	end
	if is_dot(tkey, src.kind) then
		pending_dot = { t = time_global(), key = tkey, hp_before = actor_hp() }
		return
	end

	-- Do not attach an unfinished DoT tick to this hit's HP drop.
	pending_dot = nil
	pending_snap = snapshot_limbs()
	remember_limbs(pending_snap)
	local limb, bone_name = resolve_bone(bone_id)

	local wpn = weapon_obj(shit, shit.draftsman)
	local wpn_name = weapon_label(wpn)
	local ammo = ammo_label(wpn)
	if not wpn_name then
		if src.kind == "monster" then
			wpn_name = mutant_weapon(tkey)
		elseif src.kind == "stalker" and tkey ~= "bullet" then
			if tkey == "tear" or tkey == "impact" then
				wpn_name = "Melee"
			else
				wpn_name = mutant_weapon(tkey)
			end
		end
	end

	push_hit({
		t = time_global(),
		name = src.name,
		faction = src.faction,
		comm = src.comm,
		kind = src.kind,
		limb = limb,
		bone_name = bone_name,
		type_key = tkey,
		weapon = wpn_name,
		ammo = ammo,
		hp_before = actor_hp(),
	})
	pending_hit = hits[1]
end

local function wrap_adb_shit_booster()
	local adb = rawget(_G, "grok_actor_damage_balancer")
	if not (adb and type(adb.shit_booster) == "function") then
		return false
	end
	if adb.__dogma_death_report then
		adb_wrapped = true
		return true
	end

	local orig = adb.shit_booster
	adb.shit_booster = function(shit, bone_id, k_ap)
		if CONFIG.loaded.enabled and shit and (shit.power or 0) > 0 then
			record_hit(shit, bone_id)
		end
		local result = orig(shit, bone_id, k_ap)
		finish_pending()
		refresh_if_preview()
		return result
	end
	adb.__dogma_death_report = true
	adb_wrapped = true
	log("wrapped grok_actor_damage_balancer.shit_booster")
	return true
end

local function hud_wnd(name, create)
	local hud = get_hud and get_hud()
	if not hud then
		return nil
	end
	local cs = hud:GetCustomStatic(name)
	if not cs and create then
		hud:AddCustomStatic(name, true)
		cs = hud:GetCustomStatic(name)
	end
	if not cs then
		return nil
	end
	return cs:wnd()
end

local function remove_static(name)
	local hud = get_hud and get_hud()
	if not hud then
		return
	end
	if hud:GetCustomStatic(name) then
		hud:RemoveCustomStatic(name)
	end
end

local function clear_report_ui()
	remove_static(HIT_STATIC)
	remove_static(PANEL_STATIC)
end

local function clear_death_ui()
	clear_report_ui()
	remove_static(TAB_STATIC)
end

local try_set_text = function(font, wnd)
	wnd:SetFont(font)
end

local try_set_text_2 = function(font, tc)
	tc:SetFont(font)
end

local try_set_text_3 = function(wnd)
	wnd:SetTextComplexMode(true)
end

local try_set_text_4 = function(tc)
	tc:SetTextComplexMode(true)
end

local try_set_text_5 = function(h, vector2, w, wnd)
	wnd:SetWndSize(vector2():set(w, h))
end

local function set_text(name, text, x, y, w, h)
	local wnd = hud_wnd(name, true)
	if not wnd then
		return
	end
	wnd:SetWndPos(vector2():set(x, y))
	if w and h then
		pcall(try_set_text_5, h, vector2, w, wnd)
	end
	pcall(try_set_text_3, wnd)
	local font = GetFontLetterica16Russian and GetFontLetterica16Russian()
	if font then
		pcall(try_set_text, font, wnd)
	end
	local tc = wnd:TextControl()
	if tc then
		pcall(try_set_text_4, tc)
		if font then
			pcall(try_set_text_2, font, tc)
		end
		tc:SetText(text or "")
	end
end

local try_show_panel = function(PANEL_TEX, wnd)
	wnd:InitTexture(PANEL_TEX)
end

local try_show_panel_2 = function(wnd)
	wnd:SetStretchTexture(true)
end

local try_show_panel_3 = function(GetARGB, wnd)
	wnd:SetTextureColor(GetARGB(175, 8, 8, 10))
end

local function show_panel(x, y, w, h)
	local wnd = hud_wnd(PANEL_STATIC, true)
	if not wnd then
		return
	end
	wnd:SetWndPos(vector2():set(x, y))
	wnd:SetWndSize(vector2():set(w, h))
	pcall(try_show_panel, PANEL_TEX, wnd)
	pcall(try_show_panel_2, wnd)
	pcall(try_show_panel_3, GetARGB, wnd)
end

local try_show_hit_summary = function(tw)
	tw:AdjustHeightToText()
end

local function show_hit_summary()
	if not frozen then
		clear_report_ui()
		return
	end

	local hit_n = frozen.lines and #frozen.lines or 0
	local title = "DEATH REPORT"
	if preview_on and not death_armed then
		title = "DEATH REPORT (preview)"
	end
	local chunks = {
		COL.title .. title,
		BLANK,
		COL.muted .. "Last " .. tostring(hit_n) .. " hits:",
	}
	if hit_n == 0 then
		chunks[#chunks + 1] = COL.muted .. "No hits in the last 30 seconds."
	else
		for i = 1, hit_n do
			chunks[#chunks + 1] = frozen.lines[i].text
		end
	end
	if frozen.dot_header then
		chunks[#chunks + 1] = BLANK
		chunks[#chunks + 1] = frozen.dot_header
		local dots = frozen.dot_lines or {}
		for i = 1, #dots do
			chunks[#chunks + 1] = dots[i]
		end
	end
	if frozen.footer then
		chunks[#chunks + 1] = BLANK
		chunks[#chunks + 1] = COL.muted .. "Final Condition:"
		chunks[#chunks + 1] = frozen.footer
	end

	local panel_w = panel_width()
	local panel_x = 0
	local panel_y = report_panel_y()
	local text_x = PANEL_PAD
	local text_y = panel_y + PANEL_PAD
	local text_w = panel_w - PANEL_PAD * 2

	-- Background first, text once on top. Resize the same panel after measure.
	local est_h = math.floor(#chunks * line_height() + 0.5)
	remove_static(HIT_STATIC)
	show_panel(panel_x, panel_y, panel_w, est_h + PANEL_PAD * 2)
	set_text(HIT_STATIC, table.concat(chunks, "\\n"), text_x, text_y, text_w, UI_H)
	local tw = hud_wnd(HIT_STATIC)
	if tw then
		pcall(try_show_hit_summary, tw)
		local text_h = tonumber(tw.GetHeight and tw:GetHeight()) or 0
		if text_h >= 1 then
			local pw = hud_wnd(PANEL_STATIC)
			if pw then
				pw:SetWndSize(vector2():set(panel_w, text_h + PANEL_PAD * 2))
			end
		end
	end
end

local function hide_hit_summary()
	clear_report_ui()
end

local function show_tab_prompt()
	local msg
	if report_visible then
		msg = tr("ui_dogma_game_death_report_hide") or "TAB to close death report"
	else
		msg = tr("ui_dogma_game_death_report_prompt") or "TAB to open death report"
	end
	set_text(TAB_STATIC, COL.title .. msg, PANEL_PAD, PROMPT_Y, UI_W - PANEL_PAD * 2, PROMPT_H)
end

local function apply_report_visibility()
	if report_visible then
		refresh_if_preview()
		show_hit_summary()
	else
		hide_hit_summary()
	end
	show_tab_prompt()
end

local function tab_dik()
	return (DIK_keys and DIK_keys.DIK_TAB) or 15
end

local function try_toggle_report(dik)
	if not CONFIG.loaded.enabled or not report_armed() then
		return false
	end
	if dik ~= tab_dik() then
		return false
	end
	-- before_key_press, level_input wrap, and death poll can all see the same tap.
	local now = time_global()
	if (now - last_toggle_ms) < 200 then
		return true
	end
	last_toggle_ms = now
	report_visible = not report_visible
	apply_report_visibility()
	log(report_visible and "death report shown" or "death report hidden")
	return true
end

-- game_over captures input, so on_before_key_press does not run. Poll Tab instead.
local TAB_POLL = "tab_poll"
local last_tab_frame = nil

local function stop_tab_poll()
	RemoveTimeEvent(CONFIG.MOD_ID, TAB_POLL)
	last_tab_frame = nil
end

local function poll_tab()
	if not death_armed then
		return true
	end
	local d = device()
	local frame = d and d.frame
	if frame == last_tab_frame then
		return false
	end
	last_tab_frame = frame
	if dogma.input.is_key_pressed(tab_dik()) then
		try_toggle_report(tab_dik())
	end
	return false
end

local function start_tab_poll()
	stop_tab_poll()
	CreateTimeEvent(CONFIG.MOD_ID, TAB_POLL, 0, poll_tab)
end

local function arm_death_ui()
	if not CONFIG.loaded.enabled then
		return
	end
	death_armed = true
	report_visible = false
	show_tab_prompt()
	hide_hit_summary()
	start_tab_poll()
	log("death UI armed (report off)")
end

-- Return true = this key must not open inventory / death menu.
local function eat_tab_key(dik, bind)
	if not CONFIG.loaded.enabled or not report_armed() then
		return false
	end
	if dik == tab_dik() then
		try_toggle_report(dik)
		return true
	end
	-- Dead: inventory bind must not open a menu. Space / jump still reaches game_over.
	if death_armed and key_bindings and bind == key_bindings.kINVENTORY then
		return true
	end
	return false
end

local level_input_wrapped = false

local function wrap_level_input()
	if level_input_wrapped or not level_input or type(level_input.on_key_press) ~= "function" then
		return
	end
	local orig = level_input.on_key_press
	level_input.on_key_press = function(dik, bind, dis)
		if eat_tab_key(dik, bind) then
			return true
		end
		return orig(dik, bind, dis)
	end
	level_input_wrapped = true
	log("wrapped level_input.on_key_press")
end

-- Permanent limb points only. BHS health[] is perm + temp.
local function bhs_limb_perm(health, timedhp, maxhp, key)
	local hp = tonumber(health and health[key])
	local maxv = tonumber(maxhp and maxhp[key])
	if hp == nil or not timedhp or not maxv or maxv <= 0 then
		return nil, maxv
	end
	local temp = tonumber(timedhp[key]) or 0
	local perm = hp - temp
	if perm < 0 then
		perm = 0
	end
	if perm > maxv then
		perm = maxv
	end
	return perm, maxv
end

snapshot_limbs = function()
	local health, timedhp, maxhp = dogma.status.bhs()
	local out = {}
	if not (health and timedhp and maxhp) then
		return out
	end
	for i = 1, #DIED_LIMBS do
		local k = DIED_LIMBS[i].key
		local perm, maxv = bhs_limb_perm(health, timedhp, maxhp, k)
		if perm ~= nil and maxv then
			out[k] = { perm = perm, max = maxv }
		end
	end
	return out
end

-- Keep the most damaged reading. Death often resets live BHS to full.
remember_limbs = function(snap)
	if not snap then
		return
	end
	for k, v in pairs(snap) do
		if v.perm ~= nil and v.max then
			local prev = last_limbs[k]
			if not prev or v.perm < prev.perm then
				last_limbs[k] = { perm = v.perm, max = v.max }
			end
		end
	end
end

-- Known BHS key, or the limb that dropped most this hit (unknown / body).
local function limb_from_snap(before_snap, after_snap, key)
	if key and key ~= "unknown" and key ~= "body" then
		return before_snap and before_snap[key], after_snap and after_snap[key]
	end
	local best_b, best_a, best_d
	if not (before_snap and after_snap) then
		return nil, nil
	end
	for k, after in pairs(after_snap) do
		local before = before_snap[k]
		if before and after and before.perm and after.perm then
			local d = before.perm - after.perm
			if d > 0 and (not best_d or d > best_d) then
				best_b, best_a, best_d = before, after, d
			end
		end
	end
	return best_b, best_a
end

finish_pending = function()
	if pending_dot then
		local after = actor_hp()
		local before = pending_dot.hp_before
		if before ~= nil and after ~= nil and before > after then
			record_dot(pending_dot.key, before - after)
		end
		if after ~= nil then
			last_hp = after
		end
		pending_dot = nil
	end
	if not pending_hit then
		pending_snap = nil
		return
	end
	pending_hit.hp_after = actor_hp()
	if pending_hit.hp_after ~= nil then
		last_hp = pending_hit.hp_after
	end
	local after_all = snapshot_limbs()
	remember_limbs(after_all)
	local before, after = limb_from_snap(pending_snap, after_all, pending_hit.limb)
	if before and after then
		pending_hit.limb_before = before.perm
		pending_hit.limb_after = after.perm
		pending_hit.limb_max = after.max or before.max
	end
	pending_hit = nil
	pending_snap = nil
end

local function wrap_bhs_recieved_damage()
	local bhs = rawget(_G, "zzz_player_injuries")
	if not (bhs and type(bhs.recieved_damage) == "function") then
		return false
	end
	if bhs.__dogma_death_report_rd then
		bhs_rd_wrapped = true
		return true
	end
	local orig = bhs.recieved_damage
	bhs.recieved_damage = function(amount, bone_id)
		local result = orig(amount, bone_id)
		if not adb_wrapped then
			finish_pending()
			refresh_if_preview()
		end
		return result
	end
	bhs.__dogma_death_report_rd = true
	bhs_rd_wrapped = true
	log("wrapped zzz_player_injuries.recieved_damage")
	return true
end

-- Newest hit that stored a before/after for this limb. Live BHS is often
-- still full at death; the hit snapshots are the measured values.
local function last_limb_from_hits(list, key)
	if not list then
		return nil, nil
	end
	for i = 1, #list do
		local e = list[i]
		if e.limb == key and e.limb_after ~= nil then
			return e.limb_after, e.limb_max
		end
	end
	return nil, nil
end

local function format_condition_line(list)
	local health, timedhp, maxhp = dogma.status.bhs()
	local parts = {}
	for i = 1, #DIED_LIMBS do
		local spec = DIED_LIMBS[i]
		local live, live_max = bhs_limb_perm(health, timedhp, maxhp, spec.key)
		local saved = last_limbs[spec.key]
		local hit_cur, hit_max = last_limb_from_hits(list, spec.key)
		local cur, maxv
		if live ~= nil and live_max and live < live_max then
			cur, maxv = live, live_max
		elseif saved then
			cur, maxv = saved.perm, saved.max
		elseif hit_cur ~= nil then
			cur, maxv = hit_cur, hit_max or live_max
		else
			cur, maxv = live, live_max
		end
		local pct = pts_pct(cur, maxv)
		if i > 1 then
			parts[#parts + 1] = COL.dim .. "   "
		end
		parts[#parts + 1] = rgb_code(hp_rgb(pct)) .. spec.label .. " " .. pct_txt(pct)
	end
	return table.concat(parts)
end

-- Layout-only rows for the alive preview. Count follows Hits to remember.
local DUMMY_HITS = {
	{ hp_before = 0.94, hp_after = 0.81, limb = "torso", bone_name = "bip01_pelvis", limb_before = 4, limb_after = 3, limb_max = 4, name = "Yurik", faction = "Loners", comm = "stalker", kind = "stalker", weapon = "AKM", ammo = "7.62x39 mm" },
	{ hp_before = 0.81, hp_after = 0.68, limb = "head", bone_name = "bip01_head", limb_before = 4, limb_after = 3, limb_max = 4, name = "Wolf", faction = "Loners", comm = "stalker", kind = "stalker", weapon = "Fort-12", ammo = "9x18 mm" },
	{ hp_before = 0.68, hp_after = 0.52, limb = "leftarm", bone_name = "bip01_l_forearm", limb_before = 4, limb_after = 3, limb_max = 4, name = "Scar", faction = "Mercenaries", comm = "killer", kind = "stalker", weapon = "IL86", ammo = "5.56x45 mm" },
	{ hp_before = 0.52, hp_after = 0.41, limb = "torso", bone_name = "bip01_spine1", limb_before = 3, limb_after = 3, limb_max = 4, name = "Blind Dog", kind = "monster", weapon = "Claws" },
	{ hp_before = 0.41, hp_after = 0.33, limb = "rightleg", bone_name = "bip01_r_thigh", limb_before = 4, limb_after = 3, limb_max = 4, name = "Bloodsucker", kind = "monster", weapon = "Claws" },
	{ hp_before = 0.33, hp_after = 0.22, limb = "torso", bone_name = "bip01_spine2", limb_before = 3, limb_after = 2, limb_max = 4, name = "Petrenko", faction = "Duty", comm = "dolg", kind = "stalker", weapon = "AS Val", ammo = "9x39 mm" },
	{ hp_before = 0.22, hp_after = 0.14, limb = "unknown", name = "Fall", kind = "world" },
	{ hp_before = 0.14, hp_after = 0.02, limb = "torso", bone_name = "bip01_spine1", limb_before = 2, limb_after = 1, limb_max = 4, name = "Grenade", kind = "world", weapon = "Explosion" },
}

local function dummy_dot_section()
	local sec = dot_seconds()
	if sec <= 0 then
		return nil, nil
	end
	local header = COL.muted .. "Other damage over last " .. tostring(sec) .. " seconds:"
	local lines = {
		rgb_code(TYPE_INFO.bleed.rgb) .. "Bleed" .. COL.white .. ": 4%",
		rgb_code(TYPE_INFO.radiation.rgb) .. "Radiation" .. COL.white .. ": 2%",
		rgb_code(TYPE_INFO.burn.rgb) .. "Fire" .. COL.white .. ": 1%",
	}
	return header, lines
end

local function freeze_preview_lines()
	local lines = {}
	local dummy = {}
	local n = hit_cap()
	for i = 1, n do
		local e = DUMMY_HITS[((i - 1) % #DUMMY_HITS) + 1]
		dummy[i] = e
		lines[#lines + 1] = { text = format_hit_line(e) }
	end
	local dot_header, dot_lines = dummy_dot_section()
	frozen = {
		lines = lines,
		footer = format_condition_line(dummy),
		dot_header = dot_header,
		dot_lines = dot_lines,
	}
end

local function freeze_hit_lines()
	if preview_on and not death_armed then
		freeze_preview_lines()
		return
	end
	finish_pending()
	prune_hits()
	local lines = {}
	for i = 1, #hits do
		lines[#lines + 1] = { text = format_hit_line(hits[i]) }
	end
	local dot_header, dot_lines = format_dot_section()
	frozen = {
		lines = lines,
		footer = format_condition_line(hits),
		dot_header = dot_header,
		dot_lines = dot_lines,
	}
end

refresh_if_preview = function()
	if preview_on and report_visible and not death_armed then
		freeze_hit_lines()
		show_hit_summary()
	end
end

local function apply_preview()
	local want = CONFIG.loaded.enabled and CONFIG.loaded.preview
	if want and not death_armed then
		preview_on = true
		freeze_hit_lines()
		report_visible = true
		apply_report_visibility()
		return
	end
	if preview_on and not death_armed then
		preview_on = false
		report_visible = false
		frozen = nil
		clear_death_ui()
	end
end

local function reset_state()
	hits = {}
	dots = {}
	death_armed = false
	preview_on = false
	report_visible = false
	last_toggle_ms = 0
	frozen = nil
	pending_hit = nil
	pending_snap = nil
	last_limbs = {}
	pending_dot = nil
	last_rad = nil
	last_hp = nil
	last_bleed = nil
	stop_tab_poll()
	clear_death_ui()
end

local function on_option_change()
	CONFIG.loaded.enabled = dogma.mcm.bool(CONFIG.MOD_ID, "enabled")
	CONFIG.loaded.panel_width = dogma.mcm.uint(CONFIG.MOD_ID, "panel_width", 410)
	CONFIG.loaded.panel_top = dogma.mcm.uint(CONFIG.MOD_ID, "panel_top", 90)
	CONFIG.loaded.hit_cap = dogma.mcm.uint(CONFIG.MOD_ID, "hit_cap", 10)
	CONFIG.loaded.dot_seconds = dogma.mcm.uint(CONFIG.MOD_ID, "dot_seconds", 5)
	CONFIG.loaded.preview = dogma.mcm.bool(CONFIG.MOD_ID, "preview")
	CONFIG.loaded.debug_log = dogma.log.logging()
	if not death_armed then
		prune_hits()
		prune_dots()
	end
	if not CONFIG.loaded.enabled then
		clear_death_ui()
		death_armed = false
		preview_on = false
		report_visible = false
		stop_tab_poll()
	elseif death_armed then
		apply_report_visibility()
	else
		apply_preview()
	end
end

local function actor_on_before_hit(shit, bone_id, flags)
	if not CONFIG.loaded.enabled then
		return
	end
	if not shit or (shit.power or 0) <= 0 then
		return
	end

	-- When ADB is wrapped, hits (including world DoT) are recorded in
	-- shit_booster so we can snapshot HP after the same call.
	if adb_wrapped then
		return
	end

	record_hit(shit, bone_id)
end

local function flush_radiation()
	local now = actor_radiation()
	local gained = last_rad ~= nil and now ~= nil and now > last_rad
	if gained then
		record_dot("radiation", now - last_rad)
	end
	last_rad = now
	return gained
end

-- Body HP lost while bleeding. Hit callbacks set last_hp after their own drop.
local function flush_bleed()
	local hp = actor_hp()
	local bleed = actor_bleeding()
	local recorded = false
	if last_hp ~= nil and hp ~= nil and last_hp > hp
		and last_bleed ~= nil and last_bleed > BLEED_EPS
	then
		record_dot("bleed", last_hp - hp)
		recorded = true
	end
	last_hp = hp
	last_bleed = bleed
	return recorded
end

local function actor_on_update()
	if not CONFIG.loaded.enabled or death_armed then
		last_rad = actor_radiation()
		last_hp = actor_hp()
		last_bleed = actor_bleeding()
		return
	end
	local changed = flush_radiation()
	if flush_bleed() then
		changed = true
	end
	if changed then
		refresh_if_preview()
	end
end

local function actor_on_before_death(whoID, flags)
	if not CONFIG.loaded.enabled then
		return
	end

	flush_radiation()
	flush_bleed()
	freeze_hit_lines()
	arm_death_ui()
	log(string.format("before_death hits=%d", frozen and frozen.lines and #frozen.lines or 0))
end

local function GUI_on_show(gui, str2)
	if not CONFIG.loaded.enabled or not death_armed then
		return
	end
	local name = tostring(gui or "") .. " " .. tostring(str2 or "")
	if name:find("game_over", 1, true) or name:find("GameOver", 1, true) then
		apply_report_visibility()
	end
end

local function on_before_key_press(dik, bind, dis, flags)
	if eat_tab_key(dik, bind) and flags then
		flags.ret_value = false
	end
end

local function wrap_hooks()
	wrap_adb_shit_booster()
	wrap_bhs_recieved_damage()
	wrap_level_input()
end

local function on_game_load()
	reset_state()
	wrap_hooks()
end

local function actor_on_first_update()
	wrap_hooks()
	on_option_change()
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	init_type_keys()
	wrap_hooks()
	on_option_change()

	RegisterScriptCallback("actor_on_before_hit", actor_on_before_hit)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("actor_on_before_death", actor_on_before_death)
	RegisterScriptCallback("on_before_key_press", on_before_key_press)
	RegisterScriptCallback("GUI_on_show", GUI_on_show)
	RegisterScriptCallback("on_game_load", on_game_load)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("on_option_change", on_option_change)
	log("loaded")
end
