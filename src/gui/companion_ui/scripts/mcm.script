-- gui/companion_ui conf
-- Stock companion_list HUD: Show toggle + X/Y offset from the XML home pos.

_G.dogma_gui_companion_ui_conf = {
	MOD_ID = "dogma/gui/companion_ui",
	DEFAULTS = {
		enabled = false,
		pos_x = 0,
		pos_y = 0,
	},
	loaded = {},
}

function on_mcm_load(options)
	local CONFIG = _G.dogma_gui_companion_ui_conf
	dogma_mcm.attach(options, "gui", "ui_mcm_menu_dogma_gui", {
		id = "companion_ui",
		sh = true,
		text = "ui_mcm_menu_dogma_gui_companion_ui",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_gui_companion_ui_page_description",
			},
			{
				id = "enabled",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.enabled,
				hint = "dogma_gui_companion_ui_enabled",
			},
			{
				id = "pos_x",
				type = "track",
				val = 2,
				min = -512,
				max = 512,
				step = 1,
				def = CONFIG.DEFAULTS.pos_x,
				hint = "dogma_gui_companion_ui_pos_x",
			},
			{
				id = "pos_y",
				type = "track",
				val = 2,
				min = -384,
				max = 384,
				step = 1,
				def = CONFIG.DEFAULTS.pos_y,
				hint = "dogma_gui_companion_ui_pos_y",
			},
		}),
	})
end
