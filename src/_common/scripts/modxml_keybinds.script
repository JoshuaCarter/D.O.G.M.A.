-- Inject Controls rows registered via __dogma_keybinds; replace duplicate exe= rows.
-- Claiming an engine action replaces any other Controls row on that same exe=.

local fmt = string.format

local function set_string_text(xml_obj, id, text)
	local nodes = xml_obj:query(fmt("string[id=%s] > text", id))
	if nodes[1] then
		xml_obj:setText(nodes[1], text)
		return true
	end
	return false
end

local function ensure_string(xml_obj, id, text)
	if set_string_text(xml_obj, id, text) then
		return
	end
	local existing = xml_obj:query(fmt("string[id=%s]", id))
	if is_not_empty(existing) then
		xml_obj:insertFromXMLString(fmt(
			'<string id="%s">\n\t\t<text>%s</text>\n\t</string>',
			id,
			text
		))
		return
	end
	xml_obj:insertFromXMLString(fmt(
		'<string id="%s">\n\t\t<text>%s</text>\n\t</string>',
		id,
		text
	))
end

local function remove_other_rows_for_action(xml_obj, action, keep_id)
	local nodes = xml_obj:query(fmt("command[exe=%s]", action))
	if not is_not_empty(nodes) then
		return
	end
	local remove = {}
	for i = 1, #nodes do
		local el = nodes[i]
		local attr = xml_obj:getElementAttr(el)
		local id = attr and attr.id
		if id and id ~= keep_id then
			remove[#remove + 1] = el
		end
	end
	for i = 1, #remove do
		xml_obj:removeElement(remove[i])
	end
end

local function insert_command(xml_obj, group_name, anchor_id, new_id, exe, before)
	if is_not_empty(xml_obj:query(fmt("command[id=%s]", new_id))) then
		return
	end
	local anchor = xml_obj:query(fmt(
		"group[name=%s] > command[id=%s]",
		group_name,
		anchor_id
	))
	if not anchor[1] then
		return
	end
	local el = anchor[1]
	local pos = xml_obj:getElementPosition(el)
	if not pos then
		return
	end
	if not before then
		pos = pos + 1
	end
	xml_obj:insertFromXMLString(
		fmt('<command id="%s"\t\t\t\t\t\texe="%s"/>', new_id, exe),
		el.parent,
		pos
	)
end

local function each_control(fn)
	local kb = __dogma_keybinds
	local list = kb and kb.CONTROLS
	if not list then
		return
	end
	for i = 1, #list do
		fn(list[i])
	end
end

local function patch_keybinding_ui(xml_obj)
	each_control(function(e)
		if not (e.group and e.id and e.action) then
			return
		end
		if e.after then
			insert_command(xml_obj, e.group, e.after, e.id, e.action, false)
		elseif e.before then
			insert_command(xml_obj, e.group, e.before, e.id, e.action, true)
		end
		remove_other_rows_for_action(xml_obj, e.action, e.id)
	end)
end

local function patch_keybinding_strings(xml_obj)
	set_string_text(xml_obj, "kb_weapon1", "Weapon 1 (Melee)")
	set_string_text(xml_obj, "kb_weapon2", "Weapon 2 (Secondary)")
	set_string_text(xml_obj, "kb_weapon3", "Weapon 3 (Primary)")
	set_string_text(xml_obj, "kb_walk", "Prone")
	each_control(function(e)
		if e.id and e.label then
			ensure_string(xml_obj, e.id, e.label)
		end
	end)
end

function on_xml_read()
	RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)
		if xml_file_name == [[ui\ui_keybinding.xml]] then
			patch_keybinding_ui(xml_obj)
			return
		end
		if xml_file_name == [[text\eng\ui_st_keybinding.xml]]
			or xml_file_name == [[text\rus\ui_st_keybinding.xml]]
		then
			patch_keybinding_strings(xml_obj)
		end
	end)
end
