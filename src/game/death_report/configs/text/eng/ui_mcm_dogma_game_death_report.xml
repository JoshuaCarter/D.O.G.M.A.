<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_game">
		<text>Game</text>
	</string>
	<string id="ui_mcm_menu_dogma_game_death_report">
		<text>Death Report</text>
	</string>
	<string id="ui_mcm_dogma_game_death_report_page_description">
		<text>After death, press Tab to toggle a summary of recent hits and remaining body health. Camera / spectate are left alone.</text>
	</string>
	<string id="ui_mcm_dogma_game_death_report_enabled">
		<text>Enable death report</text>
	</string>
	<string id="ui_mcm_dogma_game_death_report_enabled_desc">
		<text>Track recent hits and let Tab toggle the death summary after you die.</text>
	</string>
	<string id="ui_mcm_dogma_game_death_report_panel_width">
		<text>Panel width (px)</text>
	</string>
	<string id="ui_mcm_dogma_game_death_report_panel_width_desc">
		<text>Width of the death-report background (200-1024 UI pixels). Default 410 is 40% of the 1024-wide HUD.</text>
	</string>
	<string id="ui_mcm_dogma_game_death_report_panel_top">
		<text>Panel top (px from top)</text>
	</string>
	<string id="ui_mcm_dogma_game_death_report_panel_top_desc">
		<text>How far down from the top of the screen the report sits (0-700 UI pixels). Default 270.</text>
	</string>
	<string id="ui_mcm_dogma_game_death_report_line_height">
		<text>Line height (px)</text>
	</string>
	<string id="ui_mcm_dogma_game_death_report_line_height_desc">
		<text>0 = auto from the loaded letterica16 font (1k/2k/4k packs included) and your resolution. Or set 10-28 to override.</text>
	</string>
	<string id="ui_mcm_dogma_game_death_report_hit_cap">
		<text>Hits to remember</text>
	</string>
	<string id="ui_mcm_dogma_game_death_report_hit_cap_desc">
		<text>How many recent hits to keep in the death report (1-20). Oldest beyond this are dropped.</text>
	</string>
	<string id="ui_dogma_game_death_report_prompt">
		<text>TAB to open death report</text>
	</string>
	<string id="ui_dogma_game_death_report_hide">
		<text>TAB to close death report</text>
	</string>
</string_table>
