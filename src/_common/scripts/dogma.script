--[[
	dogma.script - runtime API (full script load only).

	dogma.mcm / .keys / .log / .overlay / .sys / .input / .math / .rng / .perf / .status / .alife / .json / .db / .xlibs / .load / ...  game-time
	MCM gather scripts use dogma_mcm.* (cannot see this module).
]]

xlibs = __dogma_xlibs
mcm = __dogma_mcm
keys = __dogma_key_mirror_mcm
log = __dogma_log
overlay = __dogma_overlay
sys = __dogma_sys
input = __dogma_input
math = __dogma_math
rng = __dogma_rng
perf = __dogma_perf
status = __dogma_status
item_stats = __dogma_item_stats.exports
alife = __dogma_alife
json = __dogma_json
db = __dogma_db

function load(mod_id)
	sys.set_deps(mcm)
	if perf and perf.sync then
		perf.sync()
	end
	if mod_id then
		sys.reset_mod(mod_id)
		overlay.clear(mod_id)
	end
	return getfenv(1)
end
