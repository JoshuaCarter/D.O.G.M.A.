--[[
	Escort Tweaks - Fanatic stays in Cordon

	Training Day / Sid car-park help make Fanatic a companion. Stock training
	join does not set companion_cannot_teleport, so axr_companions teleports him
	off-map with the actor.

	- Never teleport Fanatic's squad with the actor.
	- After the actor arrives off Cordon while Fanatic is (or was) companion:
	  cancel Training Day (no goodwill hit, PDA news after load) and send him
	  back to the rookie village smart.
]]

local CONFIG = _G.dogma_game_escort_tweaks_conf
local xsquad = dogma.xlibs.xsquad
local xlevel = dogma.xlibs.xlevel

local CORDON = "l01_escape"
local FANAT_SQUAD = "esc_2_12_stalker_fanat_squad"
local VILLAGE_SMART = "esc_smart_terrain_2_12"
local TRAINING_TASKS = {
	"task_fanat_training_1",
	"task_fanat_training_2",
	"task_fanat_training_3",
}
local AFTER_LOAD_S = 2.0

local pending = false

local function log(msg)
	if dogma.log.logging() then
		dogma.log.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function fanatic_on()
	return dogma.mcm.bool(CONFIG.MOD_ID, "fanatic", CONFIG.DEFAULTS.fanatic)
end

local function is_fanat_squad(squad)
	return squad and get_object_story_id(squad.id) == FANAT_SQUAD
end

local function fanat_squad()
	return get_story_squad(FANAT_SQUAD)
end

local function fanat_is_companion()
	return xsquad.is_companion(fanat_squad())
end

local function actor_off_cordon()
	local actor_lid = xlevel.get_actor_level_id()
	local cordon_lid = xlevel.get_level_id_by_name(CORDON)
	return actor_lid and cordon_lid and actor_lid ~= cordon_lid
end

local function task_manager_inst()
	return task_manager and task_manager.get_task_manager and task_manager.get_task_manager()
end

local function has_training_task()
	local tm = task_manager_inst()
	if not (tm and tm.task_info) then
		return false
	end
	for i = 1, #TRAINING_TASKS do
		if tm.task_info[TRAINING_TASKS[i]] then
			return true
		end
	end
	return false
end

-- Actor-cancel: fail news, no on_fail goodwill.
local function cancel_training_tasks()
	local tm = task_manager_inst()
	if not (tm and tm.task_info) then
		return
	end
	local cancel = tm.set_task_cancelled or tm.set_task_failed
	if not cancel then
		return
	end
	for i = 1, #TRAINING_TASKS do
		local id = TRAINING_TASKS[i]
		if tm.task_info[id] then
			cancel(tm, id)
			log("cancelled " .. id)
		end
	end
end

-- Stock remove_task_companion runs execute_script_on_squad -> get_object_squad,
-- which is whoever Fanatic is grouped with. Only strip HIS story squad.
local function strip_companion_npc(id)
	if not id then
		return
	end
	local npc = db.storage[id] and db.storage[id].object
	if npc then
		npc:disable_info_portion("npcx_is_companion")
		npc:disable_info_portion("npcx_beh_cannot_dismiss")
		if xr_logic and xr_logic.restore_scheme_and_logic then
			xr_logic.restore_scheme_and_logic(npc)
		end
	end
	local se = alife_object(id)
	if se then
		se_save_var(se.id, se:name(), "companion", nil)
		se_save_var(se.id, se:name(), "companion_cannot_dismiss", nil)
		se_save_var(se.id, se:name(), "companion_cannot_teleport", nil)
	end
	if axr_companions and axr_companions.non_task_companions then
		axr_companions.non_task_companions[id] = nil
	end
end

local function dismiss_fanat()
	local squad = fanat_squad()
	if not squad then
		return
	end
	if axr_companions and axr_companions.companion_squads then
		axr_companions.companion_squads[squad.id] = nil
	end
	squad.scripted_target = nil
	for k in squad:squad_members() do
		strip_companion_npc(k.id)
	end
	log("dismissed " .. FANAT_SQUAD)
end

local function send_fanat_to_village()
	local squad = fanat_squad()
	local smart = SIMBOARD and SIMBOARD.smarts_by_names and SIMBOARD.smarts_by_names[VILLAGE_SMART]
	if not (squad and smart and smart.id and SIMBOARD.assign_squad_to_smart) then
		return
	end
	SIMBOARD:assign_squad_to_smart(squad, smart.id)
	squad.assigned_target_id = smart.id
	squad.current_action = nil
	log("assigned to " .. VILLAGE_SMART)
end

local function abandon_if_needed()
	if not fanatic_on() then
		pending = false
		return
	end
	if not actor_off_cordon() then
		pending = false
		return
	end
	local companion = fanat_is_companion()
	if not (pending or companion or has_training_task()) then
		return
	end
	log("actor off Cordon - cancel Training Day")
	cancel_training_tasks()
	if companion then
		dismiss_fanat()
	end
	send_fanat_to_village()
	pending = false
end

local function try_schedule_abandon()
	local d = device()
	if d and d.precache_frame and d.precache_frame > 1 then
		return false
	end
	abandon_if_needed()
	return true
end

local function schedule_abandon()
	if not CreateTimeEvent then
		abandon_if_needed()
		return
	end
	CreateTimeEvent(CONFIG.MOD_ID, "abandon", AFTER_LOAD_S, try_schedule_abandon)
end

local function on_level_changing()
	if fanatic_on() and fanat_is_companion() then
		pending = true
	end
end

local function patch_no_teleport()
	if not (axr_companions and axr_companions.companion_squad_can_teleport) then
		return false
	end
	if axr_companions.__dogma_game_escort_tweaks_fanatic then
		return true
	end
	local orig = axr_companions.companion_squad_can_teleport
	axr_companions.companion_squad_can_teleport = function(squad)
		if fanatic_on() and is_fanat_squad(squad) then
			return false
		end
		return orig(squad)
	end
	axr_companions.__dogma_game_escort_tweaks_fanatic = true
	log("patched companion_squad_can_teleport")
	return true
end

local function on_actor_on_first_update()
	patch_no_teleport()
	schedule_abandon()
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	patch_no_teleport()
	RegisterScriptCallback("on_game_load", patch_no_teleport)
	RegisterScriptCallback("on_level_changing", on_level_changing)
	RegisterScriptCallback("actor_on_first_update", on_actor_on_first_update)
	log("fanatic ready")
end
