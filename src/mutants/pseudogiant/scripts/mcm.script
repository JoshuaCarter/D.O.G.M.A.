function on_mcm_load()
	local CONF = _G.dogma_giant_jump_conf
	local D = CONF.defaults
	return {
		id = "giant_jump",
		text = "ui_mcm_menu_dogma_giant_jump",
		gr = {
			{
				id = "main",
				sh = true,
				text = "Main",
				gr = dogma_mcm.with_header({
					{
						id = "main_description",
						type = "desc",
						text = "ui_mcm_dogma_giant_jump_main_description",
					},
					{
						id = "enabled",
						type = "check",
						val = 1,
						def = D["main/enabled"],
						hint = "dogma_giant_jump_enabled",
					},
				}),
			},
			{
				id = "development",
				sh = true,
				text = "ui_mcm_dogma_giant_jump_development_section",
				gr = dogma_mcm.with_header({
					{
						id = "debug_log",
						type = "check",
						val = 1,
						def = D["development/debug_log"],
						hint = "dogma_giant_jump_debug_log",
					},
				}),
			},
		},
	}, "dogma"
end
