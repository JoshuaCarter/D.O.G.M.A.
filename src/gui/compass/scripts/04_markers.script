-- Tactical Compass -- marker registry.
-- Author: explorerbee
-- Owns which PDA spots are tracked. zzzz_dogma_gui_compass_05_hud owns how they are drawn, but the ui
-- handles live on the entry so the draw path needs one table lookup, not three.

local CONFIG = _G.dogma_gui_compass_conf
local defs = zzzz_dogma_gui_compass_02_defs
local utils = zzzz_dogma_gui_compass_03_utils
local pcall = pcall

list = {} -- [object id] = { [spot type] = entry }

local CAMPFIRE_LIT = "campfire_lit"
local CAMPFIRE_UNLIT = "campfire_unlit"
local COMPANION_SPOT = "companion_squad"
local TURNIN_SPOT = "quest_turnin"
local cf_ids = {}
local cf_seen = {}
local cmp_seen = {}
local turnin_seen = {}

local function make_entry(id, spot, category)
	local group = defs.category_groups[category]
	if not group then return nil end

	return {
		id = id,
		spot = spot,
		category = category,
		group = group,

		-- world state, refreshed on the slow tick
		wpos = vector(),
		distance = -1,
		distance_str = "",
		alpha = 0,
		show_distance = false,
		y = 0,
		x_off = 0,

		-- ui handles and last applied state, written only by zzzz_dogma_gui_compass_05_hud
		ui = nil,
		arrow_x = 0,
		shadow = nil,
		half_width = 0,
		edge = 0,
		x = nil,
		shown = false,
		applied_alpha = -1,
		applied_arrow = 0,
		applied_text = "",
	}
end

function add(id, spot, category)
	if not (id and spot) then return end

	category = category or defs.spot_categories[spot] or defs.transition_types[spot]
	if not category then return end

	if defs.category_groups[category] == "squads" and utils.is_player_companion(id) then
		category = "squad_companion"
	end

	local spots = list[id]
	if not spots then
			spots = {}
			list[id] = spots
	end

	if spots[spot] then return end

	local entry = make_entry(id, spot, category)
	if entry then
		spots[spot] = entry
		if spot == CAMPFIRE_LIT or spot == CAMPFIRE_UNLIT then
			cf_seen[id] = true
		end
	end
end

function remove(id, spot)
	local spots = list[id]
	if not spots then return end

	local entry = spots[spot]
	if entry then
		if zzzz_dogma_gui_compass_05_hud.HUD then zzzz_dogma_gui_compass_05_hud.HUD:ReleaseMarker(entry) end
		spots[spot] = nil
	end

	if next(spots) == nil then list[id] = nil end
end

function clear(id)
	local spots = list[id]
	if not spots then return end

	if zzzz_dogma_gui_compass_05_hud.HUD then
		for _, entry in pairs(spots) do
			zzzz_dogma_gui_compass_05_hud.HUD:ReleaseMarker(entry)
		end
	end

	list[id] = nil
end

function reset()
	list = {}
	cf_seen = {}
	cmp_seen = {}
	turnin_seen = {}
end

local function probe_transitions(id)
	local found = false

	for spot, category in pairs(defs.transition_types) do
		if level.map_has_object_spot(id, spot) ~= 0 then
			add(id, spot, category)
			found = true
		end
	end

	return found
end

local scanned_levels = {}

function collect_transitions()
	local sim = alife()
	if not sim then return end

	local lvl = level.name()

	if scanned_levels[lvl] then return end
	scanned_levels[lvl] = true

	for i = 1, 65534 do
		if sim:object(i) then probe_transitions(i) end
	end

	dogma.log.log(CONFIG.MOD_ID, "scanned transitions on " .. tostring(lvl))
end

function drop_stale_spots()
	for id, spots in pairs(list) do
		for spot in pairs(spots) do
			-- Lit/unlit is owned by sync_campfires. Map spots lag the live fire.
			if spot ~= CAMPFIRE_LIT and spot ~= CAMPFIRE_UNLIT and spot ~= COMPANION_SPOT and spot ~= TURNIN_SPOT then
				if level.map_has_object_spot(id, spot) == 0 then
					remove(id, spot)
				end
			end
		end
	end
end

local function try_get_campfire(obj)
	return obj:get_campfire()
end

local function try_campfire_on(cf)
	return cf:is_on()
end

local function campfire_want_spot(id)
	local stor = db.storage[id]
	local obj = stor and stor.object
	if not obj then
		obj = level.object_by_id(id)
	end
	if obj and obj.get_campfire then
		local ok_cf, cf = pcall(try_get_campfire, obj)
		if ok_cf and cf then
			local ok_on, on = pcall(try_campfire_on, cf)
			if ok_on then
				if on then
					return CAMPFIRE_LIT
				end
				return CAMPFIRE_UNLIT
			end
		end
	end

	if level.map_has_object_spot(id, CAMPFIRE_LIT) ~= 0 then
		return CAMPFIRE_LIT
	end
	if level.map_has_object_spot(id, CAMPFIRE_UNLIT) ~= 0 then
		return CAMPFIRE_UNLIT
	end
	return nil
end

-- Map spots often lag until PDA/menu. Read the live fire and swap the icon.
function sync_campfires()
	for id, spots in pairs(list) do
		if spots[CAMPFIRE_LIT] or spots[CAMPFIRE_UNLIT] then
			cf_seen[id] = true
		end
	end

	local n = 0
	for id in pairs(cf_seen) do
		n = n + 1
		cf_ids[n] = id
	end

	for i = 1, n do
		local id = cf_ids[i]
		local want = campfire_want_spot(id)
		if not want then
			cf_seen[id] = nil
			-- remove may nil list[id] after the last spot
			remove(id, CAMPFIRE_LIT)
			remove(id, CAMPFIRE_UNLIT)
			dogma.log.log(CONFIG.MOD_ID, "campfire " .. tostring(id) .. " gone")
		else
			local drop = (want == CAMPFIRE_LIT) and CAMPFIRE_UNLIT or CAMPFIRE_LIT
			remove(id, drop)
			if not (list[id] and list[id][want]) then
				add(id, want)
				dogma.log.log(CONFIG.MOD_ID, "campfire " .. tostring(id) .. " -> " .. want)
			end
		end
	end
end

function sync_companions()
	local xs = dogma.xlibs and dogma.xlibs.xsquad
	local axr = rawget(_G, "axr_companions")
	if not (xs and axr and axr.companion_squads) then
		return
	end

	for id in pairs(cmp_seen) do
		cmp_seen[id] = false
	end

	for squad_id in pairs(axr.companion_squads) do
		local squad = alife_object(squad_id)
		if squad then
			for member_id in xs.iter_member_ids(squad) do
				cmp_seen[member_id] = true
				if not list[member_id] then
					add(member_id, COMPANION_SPOT)
					dogma.log.log(CONFIG.MOD_ID, "companion " .. tostring(member_id) .. " add")
				end
			end
		end
	end

	for id, keep in pairs(cmp_seen) do
		if not keep then
			cmp_seen[id] = nil
			remove(id, COMPANION_SPOT)
			dogma.log.log(CONFIG.MOD_ID, "companion " .. tostring(id) .. " gone")
		end
	end
end

local function giver_owns_target(gid, target)
	if gid == target then return true end

	local se = alife_object(gid)
	if not (se and se.clsid and se:clsid() == clsid.online_offline_group_s) then
		return false
	end

	local xs = dogma.xlibs and dogma.xlibs.xsquad
	if not xs then return false end

	for member_id in xs.iter_member_ids(se) do
		if member_id == target then return true end
	end

	return false
end

local function set_category(entry, category)
	if not category or entry.category == category then return end

	if zzzz_dogma_gui_compass_05_hud.HUD then
		zzzz_dogma_gui_compass_05_hud.HUD:ReleaseMarker(entry)
	end

	entry.category = category
	entry.group = defs.category_groups[category] or entry.group
	dogma.log.log(CONFIG.MOD_ID, "cat " .. tostring(entry.id) .. " " .. tostring(entry.spot) .. " -> " .. category)
end

-- Side-quest return NPCs. Minimap tints the white diamond green; no unique spot type.
function sync_turnins()
	local pairs_ = pairs
	local tm = task_manager and task_manager.get_task_manager()
	if not (tm and tm.task_info) then return end

	for id in pairs_(turnin_seen) do
		turnin_seen[id] = false
	end

	for _, tsk in pairs_(tm.task_info) do
		local ct = tsk.current_target
		local gid = tsk.task_giver_id
		if ct and gid and not tsk.storyline and tsk.status ~= "fail" and tsk.status ~= "completed" then
			if giver_owns_target(gid, ct) then
				turnin_seen[ct] = true
			end
		end
	end

	for id, keep in pairs_(turnin_seen) do
		if keep then
			local spots = list[id]
			local has_real = false
			if spots then
				for spot, entry in pairs_(spots) do
					if spot ~= TURNIN_SPOT then
						local cat = defs.spot_categories[spot]
						if cat == "primary" or cat == "secondary" or entry.category == "turnin" then
							set_category(entry, "turnin")
							has_real = true
						end
					end
				end
			end

			if has_real then
				if spots and spots[TURNIN_SPOT] then
					remove(id, TURNIN_SPOT)
				end
			elseif not (spots and spots[TURNIN_SPOT]) then
				add(id, TURNIN_SPOT)
				dogma.log.log(CONFIG.MOD_ID, "turnin " .. tostring(id) .. " add")
			end
		else
			turnin_seen[id] = nil
			remove(id, TURNIN_SPOT)
			local spots = list[id]
			if spots then
				for spot, entry in pairs_(spots) do
					if entry.category == "turnin" then
						set_category(entry, defs.spot_categories[spot])
					end
				end
			end
			dogma.log.log(CONFIG.MOD_ID, "turnin " .. tostring(id) .. " gone")
		end
	end
end

function on_map_location_added(binder, spot, id)
		if defs.blacklisted_spots[spot] then return end

		add(id, spot)
end

-- Entries hold vectors and ui handles, so only plain data may be written out
function save_state(m_data)
	local saved = {}

	for id, spots in pairs(list) do
		local out

		for spot, entry in pairs(spots) do
			if spot ~= COMPANION_SPOT and spot ~= TURNIN_SPOT then
				out = out or {}
				out[spot] = entry.category
			end
		end

		if out then saved[id] = out end
	end

	m_data.dogma_gui_compass_markers = saved
	m_data.tc_markers = nil
	m_data.init_markers = nil
end

function load_state(m_data)
	list = {}
	cf_seen = {}
	cmp_seen = {}
	turnin_seen = {}

	local saved = m_data.dogma_gui_compass_markers or m_data.tc_markers or m_data.init_markers
	if not saved then return end

	for id, spots in pairs(saved) do
		for spot, data in pairs(spots) do
			add(id, spot, type(data) == "table" and data.category or data)
		end
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", collect_transitions)
	RegisterScriptCallback("actor_map_location_added", on_map_location_added)

	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
end
