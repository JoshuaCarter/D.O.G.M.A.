--[[
	Dialogue

	Engine talk UI (CUITalkWnd) only closes on Use/Quit binds. While Dialog
	owns input, on_before_key_press is suppressed — poll the MCM close key
	via dogma.input and stop_talk() instead.
]]

local CONFIG = _G.dogma_input_dialogue_conf

local POLL = "poll"
local dialog_open = false

local function close_dik()
	return CONFIG.loaded.close_key
end

local function stop_poll()
	dialog_open = false
	RemoveTimeEvent(CONFIG.MOD_ID, POLL)
end

local function poll()
	if not dialog_open then
		return true
	end
	local dik = close_dik()
	if dik and dogma.input.is_key_pressed(dik) then
		local actor = db.actor
		if actor and actor.is_talking and actor:is_talking() then
			actor:stop_talk()
		end
	end
	return false
end

local function start_poll()
	local dik = close_dik()
	if not dik then
		stop_poll()
		return
	end
	dialog_open = true
	-- Prime dogma.input tracking (only tracks DIKs after first query).
	dogma.input.is_key_down(dik)
	RemoveTimeEvent(CONFIG.MOD_ID, POLL)
	CreateTimeEvent(CONFIG.MOD_ID, POLL, 0, poll)
end

local function on_gui_show(gui)
	if gui ~= "Dialog" then
		return
	end
	start_poll()
end

local function on_gui_hide(gui)
	if gui == "Dialog" then
		stop_poll()
	end
end

function on_option_change()
	CONFIG.loaded.close_key = dogma.mcm.key(CONFIG.MOD_ID, "close_key")
	if dialog_open then
		start_poll()
	end
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	on_option_change()
	RegisterScriptCallback("GUI_on_show", on_gui_show)
	RegisterScriptCallback("GUI_on_hide", on_gui_hide)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("on_game_load", stop_poll)
	RegisterScriptCallback("actor_on_net_destroy", stop_poll)
end
