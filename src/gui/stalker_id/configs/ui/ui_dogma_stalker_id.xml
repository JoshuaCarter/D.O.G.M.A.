	</patch_dead_army>
	<patch_dead_freedom x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_freedom_inactive</texture>
	</patch_dead_freedom>
	<patch_dead_dolg x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
