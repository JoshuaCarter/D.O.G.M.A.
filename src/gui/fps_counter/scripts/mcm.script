-- gui/fps_counter conf

_G.dogma_gui_fps_counter_conf = {
    MOD_ID = "dogma/gui/fps_counter",
    DEFAULTS = {
        ["colors/graph_border_a"] = 200,
        ["colors/graph_border_b"] = 150,
        ["colors/graph_border_g"] = 150,
        ["colors/graph_border_r"] = 150,
        ["colors/graph_line_a"] = 150,
        ["colors/graph_line_b"] = 0,
        ["colors/graph_line_g"] = 255,
        ["colors/graph_line_r"] = 255,
        ["colors/text_a"] = 200,
        ["colors/text_b"] = 255,
        ["colors/text_g"] = 255,
        ["colors/text_r"] = 255,
        display = 0,
        enabled_default = true,
        max_fps = 144,
        minmax_window = 5,
        pos_anchor = 2,
        pos_x = 2,
        pos_y = 0,
        refresh_rate = 3,
        sample_window = 0.5,
        toggle_key = -1,
        -- 0 = toggle, 1 = hold (show while held)
        key_mode = 0,
        vertical_spacing = 0,
    },
    loaded = {
        display_mode = 0,
        font = nil, -- set from FONTS in main after display mode loads
        text_r = 255,
        text_g = 255,
        text_b = 255,
        text_a = 200,
        graph_line_r = 255,
        graph_line_g = 255,
        graph_line_b = 0,
        graph_line_a = 150,
        graph_border_r = 150,
        graph_border_g = 150,
        graph_border_b = 150,
        graph_border_a = 200,
        debug_log = true,
        long_frame_threshold_ms = 0,
    },
}

function on_mcm_load(options)
    local CONFIG = _G.dogma_gui_fps_counter_conf
dogma_mcm.attach(options, "gui", "ui_mcm_menu_dogma_gui", {
        id = "fps_counter",
        sh = true,
        text = "ui_mcm_menu_dogma_gui_fps_counter",
        gr = dogma_mcm.with_header({
            {
                id = "page_description",
                type = "desc",
                text = "ui_mcm_dogma_gui_fps_counter_page_description",
            },
                    {
                        id = "enabled_default",
                        type = "check",
                        val = 1,
                        def = CONFIG.DEFAULTS.enabled_default,
                        hint = "dogma_gui_fps_counter_enabled_default",
                    },
                    {
                        id = "toggle_key",
                        type = "key_bind",
                        val = 2,
                        def = CONFIG.DEFAULTS.toggle_key,
                        hint = "dogma_gui_fps_counter_toggle_key",
                    },
                    {
                        id = "key_mode",
                        type = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h",
                        val = 2,
                        def = CONFIG.DEFAULTS.key_mode,
                        hint = "dogma_gui_fps_counter_key_mode",
                        content = {
                            { 0, "toggle" },
                            { 1, "hold" },
                        },
                    },
                    {
                        id = "display",
                        type = "list",
                        val = 2,
                        def = CONFIG.DEFAULTS.display,
                        hint = "dogma_gui_fps_counter_display",
                        content = {
                            { 0, "simple_small" },
                            { 1, "simple_large" },
                            { 2, "detailed_small" },
                            { 3, "detailed_large" },
                            { 4, "graph_small" },
                            { 5, "graph_large" },
                        },
                    },
                    {
                        id = "sample_window",
                        type = "track",
                        val = 2,
                        min = 0.1,
                        max = 3,
                        step = 0.1,
                        def = CONFIG.DEFAULTS.sample_window,
                        hint = "dogma_gui_fps_counter_sample_window",
                    },
                    {
                        id = "max_fps",
                        type = "track",
                        val = 2,
                        min = 60,
                        max = 500,
                        step = 1,
                        def = CONFIG.DEFAULTS.max_fps,
                        hint = "dogma_gui_fps_counter_max_fps",
                    },
                    {
                        id = "minmax_window",
                        type = "track",
                        val = 2,
                        min = 1,
                        max = 10,
                        step = 1,
