<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_gui">
		<text>GUI</text>
	</string>
	<string id="ui_mcm_menu_dogma_gui_fx_bleed">
		<text>Bleed</text>
	</string>
	<string id="ui_mcm_dogma_gui_fx_bleed_page_description">
		<text>Corner blood overlays from 1024^2 atlases. Each wound tier adds one random corner (max 4). Disable Anomaly "Bleeding effect" so they don't stack.</text>
	</string>
	<string id="ui_mcm_dogma_gui_fx_bleed_enable">
		<text>Enable</text>
	</string>
	<string id="ui_mcm_dogma_gui_fx_bleed_enable_desc">
		<text>When off, bleed screen overlays are completely disabled.</text>
	</string>
	<string id="ui_mcm_dogma_gui_fx_bleed_style">
		<text>Style</text>
	</string>
	<string id="ui_mcm_dogma_gui_fx_bleed_style_desc">
		<text>Which hud_blood atlas to use (0-2).</text>
	</string>
	<string id="dogma_gui_fx_bleed_style_lst_style_0">
		<text>Style 1</text>
	</string>
	<string id="dogma_gui_fx_bleed_style_lst_style_1">
		<text>Style 2</text>
	</string>
	<string id="dogma_gui_fx_bleed_style_lst_style_2">
		<text>Style 3</text>
	</string>
	<string id="ui_mcm_dogma_gui_fx_bleed_style_preview">
		<text>Style preview (1 - 2 - 3)</text>
	</string>
	<string id="ui_mcm_dogma_gui_fx_bleed_scale">
		<text>Scale</text>
	</string>
	<string id="ui_mcm_dogma_gui_fx_bleed_scale_desc">
		<text>Corner overlay size as a fraction of the 512 UI-unit base (128 / 256 / 512).</text>
	</string>
	<string id="dogma_gui_fx_bleed_scale_lst_scale_25">
		<text>25%</text>
	</string>
	<string id="dogma_gui_fx_bleed_scale_lst_scale_50">
		<text>50%</text>
	</string>
	<string id="dogma_gui_fx_bleed_scale_lst_scale_100">
		<text>100%</text>
	</string>
	<string id="ui_mcm_dogma_gui_fx_bleed_max_alpha">
		<text>Max alpha</text>
	</string>
	<string id="ui_mcm_dogma_gui_fx_bleed_max_alpha_desc">
		<text>Peak opacity for corner overlays. Fades in over 100 ms on new wounds and out over 1000 ms when a wound clears.</text>
	</string>
