<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_fieldstrip_all_keybind">
		<text>Strip Everything</text>
	</string>
	<string id="ui_mcm_dogma_fieldstrip_all_keybind_main_section">
		<text>Main</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_main_drop_description">
		<text>Drop hovered inventory items. Hold mode sweeps across cells (and the stack popup). Disable Drop_Disassemble_on_press if you use these binds. Shift as the key can also trigger Fast Transfer in loot.</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_key_drop">
		<text>Drop (1 stack)</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_key_drop_all">
		<text>Drop (all stacks)</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_drop_safe_equipped">
		<text>No dropping equipped items</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_drop_safe_equipped_desc">
		<text>Skip items in equipment slots.</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_main_disa_description">
		<text>Disassemble hovered items. Hold mode sweeps across cells (and the stack popup). Same Shift caveat as Drop.</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_key_disa">
		<text>Disassemble (1 stack)</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_key_disa_all">
		<text>Disassemble (all stacks)</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_disa_safe_equipped">
		<text>No disassembling equipped items</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_disa_safe_equipped_desc">
		<text>Skip items in equipment slots.</text>
	</string>
	<string id="ui_mcm_dogma_fieldstrip_all_keybind_main_description">
		<text>Hover a weapon and use these binds to remove all attachments and parts. Hold mode strips each newly hovered weapon. Works in the stack popup.</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_key">
		<text>Strip all (1 stack)</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_key_all">
		<text>Strip all (all stacks)</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_intercept_disassemble">
		<text>Strip all on disassemble</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_intercept_disassemble_desc">
		<text>Strip all first when you disassemble a weapon with unstripped attachments or parts, press again to disassemble normally.</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_keep_parts_with_weapon">
		<text>Keep parts with weapon</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_keep_parts_with_weapon_desc">
		<text>Move stripped attachments and parts back to the weapon's inventory.</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_pda_stash_on_disassemble">
		<text>Strip PDA stash coords</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_pda_stash_on_disassemble_desc">
		<text>Grant unread stash coords when disassembling PDAs. Double tool wear if a coord is found, triple if PDA was encrypted. Shows a lock icon on encrypted PDAs.</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_companion_loot_description">
		<text>Moving equipped items into a companion inventory (PDA, NVG, etc.) can make them vanish. Loose bag items still move normally.</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_block_companion_special_items">
		<text>Block items to companions</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_block_companion_special_items_desc">
		<text>Prevent moving equipped items into a companion inventory (some items can vanish).</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_attachments_section">
		<text>Weapons: Attachment Disassembly</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_attachments_description">
		<text>Disassemble weapon attachments for scrap metal, plastic, lenses, etc.</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_attachments_enabled">
		<text>Allow attachment disassembly</text>
	</string>
	<string id="ui_mcm_dogma_fieldstrip_all_keybind_development_section">
		<text>Development</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_debug_log">
		<text>Strip all debug log</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_debug_log_desc">
		<text>Write field-strip actions to the game log.</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_drop_disa_debug_log">
		<text>Drop/disassemble key debug log</text>
	</string>
	<string id="ui_mcm_dogma_strip_everything_dis_weap_attach_debug_log">
		<text>Attachment dis debug log</text>
	</string>
</string_table>
