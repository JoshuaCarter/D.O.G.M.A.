-- Prove VFS pair files + engine-identical 3D play of the pair OGGs.
-- LTX keys are not m_steps_map. lua s2d is not CStepManager.

local LOG = "[dogma_tweaks_fix_footsteps_sfx]"

local function log_step_line(params, key)
	local ini = system_ini()
	if not ini:section_exist(params) then
		printf("%s missing section %s", LOG, params)
		return
	end
	if not ini:line_exist(params, key) then
		printf("%s %s has no %s", LOG, params, key)
		return
	end
	printf("%s %s %s = %s", LOG, params, key, ini:r_string(params, key))
end

local function engine_play_step(obj, path)
	local fs = getFS()
	if fs:exist("$game_sounds$", path .. ".ogg") == nil then
		printf("%s missing ogg %s", LOG, path)
		return
	end
	local snd2d = sound_object(path)
	local snd3d = sound_object(path)
	if not snd2d or not snd3d then
		printf("%s sound_object fail %s", LOG, path)
		return
	end
	-- s2d first: if this is silent the file is dead. Then same call as play_next.
	snd2d:play_no_feedback(db.actor, sound_object.s2d, 0, vector():set(0, 0, 0), 1.0, 1.0)
	local pos = obj:position()
	pos.y = pos.y + 0.5
	snd3d:play_no_feedback(obj, sound_object.s3d, 0, pos, 1.0, 1.0)
	printf("%s engine-play 2d+3d %s at %s", LOG, path, obj:section())
end

local function log_near_monster(obj)
	if not IsMonster(obj) then
		return
	end
	local sec = obj:section()
	local ini = system_ini()
	local mat = "?"
	local params = "?"
	if ini:line_exist(sec, "material") then
		mat = ini:r_string(sec, "material")
	end
	if ini:line_exist(sec, "step_params") then
		params = ini:r_string(sec, "step_params")
	end
	printf("%s near %s mat=%s step_params=%s", LOG, sec, mat, params)
	if params ~= "?" then
		log_step_line(params, "stand_run_0")
		log_step_line(params, "stand_run_fwd_0")
	end
	if mat == "creatures\\hoof" then
		engine_play_step(obj, "test_steps\\hoof_ground_1")
	elseif mat == "creatures\\fast" then
		engine_play_step(obj, "test_steps\\step_fast-01")
	end
end

function actor_on_first_update()
	local names = dogma.xlibs.xfs.files("$game_data$", "materials\\", ".ltx")
	local i = 1
	while names[i] do
		local n = names[i]
		if string.find(n, "material_pairs", 1, true) then
			printf("%s vfs materials/%s.ltx", LOG, n)
		end
		i = i + 1
	end
	log_step_line("m_snork_step_params", "stand_run_0")
	log_step_line("m_boar_step_params", "stand_run_fwd_0")
	level.iterate_nearest(db.actor:position(), 40, log_near_monster)
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
end
