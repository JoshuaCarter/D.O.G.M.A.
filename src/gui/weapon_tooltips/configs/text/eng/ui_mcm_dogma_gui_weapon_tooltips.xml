	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_show_reliability_desc">
		<text>Vanilla GAMMA row.</text>
	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_show_barrel_wear">
		<text>Show Barrel Wear Stat</text>
	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_show_barrel_wear_desc">
		<text>Per-shot chance the barrel itself loses 1% (e.g. 1.2% @ -1%). Separate from other-part dings. Silencers do not change this.</text>
	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_show_recoil">
		<text>Show Recoil Control Stat</text>
	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_show_recoil_desc">
		<text>Vanilla GAMMA row.</text>
	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_show_burst_control">
		<text>Show Burst Size Stat</text>
	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_show_burst_control_desc">
