-- tweaks/opaque_bushes conf (info-only MCM; opaque bushes + cover nudge always on)

_G.dogma_tweaks_opaque_bushes_conf = {
	MOD_ID = "dogma/tweaks/opaque_bushes",
}

function on_mcm_load(options)
	dogma_mcm.append(options, "tweaks", "ui_mcm_menu_dogma_tweaks", {
