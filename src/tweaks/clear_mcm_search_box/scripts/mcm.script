--[[
	QoL - live MCM search.

	Keeps the search box empty (no "Search..." hint) and live-filters while
	typing. Does not touch OnKeyboard / keybind handling.

	Lives in *mcm.script so it loads when main-menu MCM gathers options
	(zzzz_* body scripts are not loaded until a game session).
]]

local SEARCH_DEBOUNCE_MS = 100
-- Ignore live-filter for a beat after stock builds/rebuilds the tree.
local SEARCH_SETTLE_MS = 250

local HOOK_STATE = _G.__dogma_tweaks_clear_mcm_search_box_hooks or {}
_G.__dogma_tweaks_clear_mcm_search_box_hooks = HOOK_STATE

local function placeholder()
	return game.translate_string("ui_mcm_menu_search")
end

local function norm_filter(t)
	if not t or t == "" or t == placeholder() then
		return nil
	end
	return t
end

local function search_text(self)
	return self.mod_search and self.mod_search:GetText() or ""
end

local function clear_hint(self)
	if self.mod_search then
		self.mod_search:SetText("")
	end
end

local function mcm_options()
	local opts = ui_mcm and ui_mcm.options
	if type(opts) == "table" and #opts > 0 then
		return opts
	end
	-- Stock OnSearch uses bare `options` from the ui_mcm chunk env.
	opts = rawget(_G, "options")
	if type(opts) == "table" and #opts > 0 then
		return opts
	end
	return nil
end

local function suspended()
	return (HOOK_STATE.suspend or 0) > 0 or HOOK_STATE.rebuilding
end

local function begin_suspend()
	HOOK_STATE.suspend = (HOOK_STATE.suspend or 0) + 1
end

local function end_suspend(self)
	HOOK_STATE.suspend = math.max(0, (HOOK_STATE.suspend or 0) - 1)
	if self then
		self._dogma_qol_ready_at = time_continual() + SEARCH_SETTLE_MS
	end
end

local function clear_debounce(self)
	self._dogma_qol_want = nil
	self._dogma_qol_due = nil
end

local function apply_search(self, keep_focus)
	if suspended() or self.k_binder then
		return
	end

	local filter = norm_filter(search_text(self))
	-- Stock OnSearch can leave search_filter as "" (truthy); treat as nil.
	local current = norm_filter(self.search_filter)
	if filter == current then
		self.search_filter = filter
		return
	end

	local opts = mcm_options()
	if not opts then
		return
	end

	self.search_filter = filter
	HOOK_STATE.rebuilding = true
	local ok, err = pcall(function()
		self:Register_Tree(1, "", opts, 1)
	end)
	HOOK_STATE.rebuilding = false
	if not ok then
		printf("![dogma_tweaks_clear_mcm_search_box] Register_Tree failed: %s", tostring(err))
		return
	end

	if keep_focus and filter and self.mod_search then
		self.mod_search:CaptureFocus(true)
	end
end

local function patch_mcm_search()
	if HOOK_STATE.patched then
		return true
	end
	local cls = ui_mcm and ui_mcm.UI_MCM
	if not (cls and cls.InitControls and cls.Update and cls.OnSearch and cls.Open_to and cls.Reset) then
		return false
	end

	local orig_init = cls.InitControls
	local orig_open = cls.Open_to
	local orig_reset = cls.Reset
	local orig_update = cls.Update

	cls.InitControls = function(self)
		begin_suspend()
		orig_init(self)
		clear_hint(self)
		self.search_filter = nil
		clear_debounce(self)
		end_suspend(self)
	end

	-- Stock Reset builds the left tree and auto-opens the first page. A nested
	-- Register_Tree here (e.g. EDIT_TEXT_COMMIT from clearing the hint) re-enters
	-- Reset_opt and has been observed to ACCESS_VIOLATION.
	cls.Reset = function(self)
		begin_suspend()
		orig_reset(self)
		clear_hint(self)
		self.search_filter = nil
		clear_debounce(self)
		end_suspend(self)
	end

	cls.Open_to = function(self, path)
		begin_suspend()
		orig_open(self, path)
		-- Stock Open_to restores the hint; strip it again.
		clear_hint(self)
		self.search_filter = nil
		clear_debounce(self)
		end_suspend(self)
	end

	cls.OnSearch = function(self)
		if suspended() then
			return
		end
		apply_search(self, norm_filter(search_text(self)) ~= nil)
	end

	cls.Update = function(self)
		orig_update(self)
		if not self.mod_search or self.k_binder or suspended() then
			return
		end
		if self._dogma_qol_ready_at and time_continual() < self._dogma_qol_ready_at then
			return
		end

		-- Stock Open_to / OnSearch may re-apply the hint; keep the box empty.
		if self.mod_search:GetText() == placeholder() then
			clear_hint(self)
		end

		local want = norm_filter(search_text(self))
		if want ~= self._dogma_qol_want then
			self._dogma_qol_want = want
			self._dogma_qol_due = time_continual() + SEARCH_DEBOUNCE_MS
		end

		if self._dogma_qol_due and time_continual() >= self._dogma_qol_due then
			self._dogma_qol_due = nil
			apply_search(self, want ~= nil)
		end
	end

	HOOK_STATE.patched = true
	printf("[dogma_tweaks_clear_mcm_search_box] patched ui_mcm.UI_MCM search")
	return true
end

-- MCM gather loads this file at main menu - patch immediately.
patch_mcm_search()

function on_mcm_load(options)
	-- Re-try if ui_mcm was not ready during top-level load.
	patch_mcm_search()

	dogma_mcm.append(options, "tweaks", "ui_mcm_menu_dogma_tweaks", {
		{
			id = "clear_mcm_search_box_description",
			type = "desc",
			text = "ui_mcm_dogma_tweaks_clear_mcm_search_box_page_description",
		},
		{
			id = "search_info",
			type = "desc",
			text = "ui_mcm_dogma_tweaks_clear_mcm_search_box_info",
		},
	})
end

function on_game_start()
	if not patch_mcm_search() then
		printf("[dogma_tweaks_clear_mcm_search_box] ui_mcm.UI_MCM missing - MCM search patch skipped")
	end
end
