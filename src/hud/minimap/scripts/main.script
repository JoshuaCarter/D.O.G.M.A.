--[[
	Minimap

	Keybind show/hide for the HUD minimap (video/hud/show_minimap + UIZoneMap).
	Toggle: flip visibility. Hold: visible only while the key is down.
	Based on RavenAscendant Mini Map Toggle, with hold-to-show.

	Hold polls key_state each frame so a dialog that steals focus (e.g. item
	wheel) cannot leave the map stuck on/off. HUD hide while the wheel is open
	is controlled by tweaks/qaw_hud_toggle.

	While the user wants the map on, we re-assert every update: option flag,
	UIZoneMap.disabled, motion icon, and level.show_indicators() so dialogs /
	Hide HUD / other scripts cannot leave it stuck off. Option disk writes only
	happen when the stored value actually changes.

	show_delay_ms: wait after wanting show before enabling (hide is immediate).
]]

local CONFIG = _G.dogma_hud_minimap_conf
local DOGMA

local MODE_TOGGLE = 0
local MODE_HOLD = 2

-- Hold: key is down (map may still be waiting on show_delay_ms).
local holding = false
-- Continual-ms when the current show request started (hold down / toggle-on).
local show_request_at = nil
-- Toggle mode: waiting to show after delay.
local pending_toggle_show = false
-- Source of truth: user wants the map visible (independent of option / UI).
local desired_show = false

local function log(msg)
	if not (DOGMA and DOGMA.dbg) then
		return
	end
	if DOGMA.dbg.logging and DOGMA.dbg.logging() then
		DOGMA.dbg.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function now_ms()
	return time_continual and time_continual() or 0
end

local function mod_ok()
	local modifier = CONFIG.loaded.modifier
	if not modifier or modifier == 0 then
		return true
	end
	if not (ui_mcm and ui_mcm.get_mod_key) then
		return true
	end
	return ui_mcm.get_mod_key(modifier)
end

local function maingame()
	return ActorMenu and ActorMenu.get_maingame and ActorMenu.get_maingame()
end

local function option_shown()
	if ui_options and ui_options.get then
		return ui_options.get("video/hud/show_minimap") and true or false
	end
	return false
end

-- Live widget state (what actually gates Render), not the options file.
local function ui_minimap_enabled()
	local ui = maingame()
	if ui and ui.UIZoneMap then
		return not ui.UIZoneMap.disabled
	end
	return option_shown()
end

local function delay_ms()
	local d = CONFIG.loaded.show_delay_ms
	if type(d) ~= "number" or d < 0 then
		return 0
	end
	return d
end

local function delay_elapsed()
	if not show_request_at then
		return true
	end
	local d = delay_ms()
	if d <= 0 then
		return true
	end
	return (now_ms() - show_request_at) >= d
end

-- Apply desired visibility. Cheap UI writes every call; option disk write only
-- on change. When showing, also punch through ShowGameIndicators(false).
local function set_minimap(want_show)
	want_show = not not want_show

	if ui_options and ui_options.set and ui_options.get then
		if option_shown() ~= want_show then
			ui_options.set("video/hud/show_minimap", want_show)
		end
	elseif ui_options and ui_options.set then
		ui_options.set("video/hud/show_minimap", want_show)
	end

	local ui = maingame()
	if ui and ui.UIZoneMap then
		ui.UIZoneMap.disabled = not want_show
		if ui.UIMotionIcon and ui.UIMotionIcon.Show then
			ui.UIMotionIcon:Show(want_show)
		end
	end

	-- Indicators gate the whole MainIngameWnd draw (minimap included).
	if want_show and level and level.show_indicators then
		level.show_indicators()
	end
end

-- Keep live UI matching desired_show (other scripts re-hide every frame).
local function enforce_desired(source)
	if not desired_show then
		return
	end
	if not delay_elapsed() then
		return
	end
	-- Always re-apply widget + indicators while wanted; option write is gated.
	set_minimap(true)
	if source and source ~= "tick" then
		log(string.format("enforce show (%s)", source))
	end
end

local function begin_show_request(source)
	desired_show = true
	show_request_at = now_ms()
	if delay_elapsed() then
		set_minimap(true)
		log(string.format("show (%s)", source or "now"))
		return true
	end
	log(string.format("show pending %dms (%s)", delay_ms(), source or "delay"))
	return false
end

local function cancel_show_request()
	show_request_at = nil
	pending_toggle_show = false
end

local function hide_minimap(source)
	desired_show = false
	cancel_show_request()
	set_minimap(false)
	log(string.format("hide (%s)", source or "hide"))
end

local function toggle_minimap(source)
	if pending_toggle_show then
		hide_minimap(source or "cancel pending")
		return
	end
	if desired_show or ui_minimap_enabled() then
		hide_minimap(source or "toggle")
		return
	end
	pending_toggle_show = true
	if begin_show_request(source or "toggle") then
		pending_toggle_show = false
	end
end

local function tick_pending_toggle()
	if not pending_toggle_show then
		return
	end
	if delay_elapsed() then
		pending_toggle_show = false
		desired_show = true
		set_minimap(true)
		log("show (toggle delay)")
	end
end

-- Hold owns visibility via key_state (press/release can be missed when a
-- dialog takes focus).
local function sync_hold_visibility(source)
	if not (CONFIG.loaded.enabled and CONFIG.loaded.mode == MODE_HOLD) then
		return
	end
	local key = CONFIG.loaded.keybind
	local down = key and key > 0 and key_state and (key_state(key) or 0) ~= 0
	local want = down and mod_ok()
	if want then
		if not holding then
			holding = true
			begin_show_request(source or "hold")
		else
			enforce_desired(source or "hold")
		end
	else
		if holding or desired_show then
			holding = false
			hide_minimap(source or "hold")
		elseif source ~= "tick" then
			-- Ensure hidden when not holding (e.g. mode/opts change).
			desired_show = false
			set_minimap(false)
		end
	end
end

local function on_option_change()
	local tostr = tostring
	if not DOGMA then
		return
	end
	local prev_mode = CONFIG.loaded.mode
	CONFIG.loaded.enabled = true
	CONFIG.loaded.keybind = DOGMA.mcm.key(CONFIG.MOD_ID, "keybind")
	CONFIG.loaded.modifier = DOGMA.mcm.number(CONFIG.MOD_ID, "modifier")
	CONFIG.loaded.mode = DOGMA.mcm.number(CONFIG.MOD_ID, "mode")
	CONFIG.loaded.show_delay_ms = DOGMA.mcm.number(CONFIG.MOD_ID, "show_delay_ms")
	if CONFIG.loaded.mode ~= MODE_HOLD then
		CONFIG.loaded.mode = MODE_TOGGLE
	end

	cancel_show_request()
	if CONFIG.loaded.enabled and CONFIG.loaded.mode == MODE_HOLD then
		holding = false
		desired_show = false
		sync_hold_visibility("opts")
	elseif holding then
		holding = false
	end

	log(string.format(
		"opts: en=%s key=%s mod=%s mode=%s delay=%s (was %s)",
		tostr(CONFIG.loaded.enabled),
		tostr(CONFIG.loaded.keybind),
		tostr(CONFIG.loaded.modifier),
		tostr(CONFIG.loaded.mode),
		tostr(CONFIG.loaded.show_delay_ms),
		tostr(prev_mode)
	))
end

local function on_key_press(key)
	if not DOGMA or not DOGMA.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return
	end
	if not CONFIG.loaded.enabled then
		return
	end
	if not CONFIG.loaded.keybind or key ~= CONFIG.loaded.keybind then
		return
	end

	local km = CONFIG.loaded.mode
	if km == MODE_HOLD then
		sync_hold_visibility("press")
		return
	end

	if not mod_ok() then
		return
	end

	toggle_minimap("toggle")
end

local function on_key_release(key)
	if not CONFIG.loaded.enabled then
		return
	end
	if not CONFIG.loaded.keybind or key ~= CONFIG.loaded.keybind then
		return
	end
	if CONFIG.loaded.mode == MODE_HOLD then
		sync_hold_visibility("release")
	end
end

local function actor_on_first_update()
	if not DOGMA or not DOGMA.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return
	end
	sync_hold_visibility("start")
end

local function actor_on_update()
	if not DOGMA or not DOGMA.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return
	end
	if CONFIG.loaded.mode == MODE_HOLD then
		sync_hold_visibility("tick")
	else
		tick_pending_toggle()
		enforce_desired("tick")
	end
end

function on_game_start()
	DOGMA = dogma_common.load(CONFIG.MOD_ID)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("on_key_press", on_key_press)
	RegisterScriptCallback("on_key_release", on_key_release)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	log("on_game_start: callbacks registered")
end
