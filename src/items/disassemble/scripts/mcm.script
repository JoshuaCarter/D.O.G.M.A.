function on_mcm_load(options)
	local CONFIG = _G.dogma_items_disassemble_conf
	local function kb_bind(id, hint)
		return {
			id = id,
			type = "key_bind",
			val = 2,
			def = CONFIG.DEFAULTS[id],
			hint = hint,
		}
	end

	local function kb_modifier(id)
		local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
		return {
			id = id,
			type = kb_mod,
			val = 2,
			def = CONFIG.DEFAULTS[id],
			hint = "mcm_kb_modifier",
			content = {
				{ 0, "mcm_kb_mod_none" },
				{ 1, "mcm_kb_mod_shift" },
				{ 2, "mcm_kb_mod_ctrl" },
				{ 3, "mcm_kb_mod_alt" },
			},
		}
	end

	local function kb_mode(id)
		local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
		return {
			id = id,
			type = kb_mod,
			val = 2,
			def = CONFIG.DEFAULTS[id],
			hint = "mcm_kb_mode",
			content = {
				{ 0, "mcm_kb_mode_press" },
				{ 2, "mcm_kb_mode_hold" },
			},
		}
	end

	dogma_mcm.attach(options, "items", "ui_mcm_menu_dogma_items", {
		id = "disassemble",
		sh = true,
		text = "ui_mcm_menu_dogma_items_disassemble",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_disassemble_page_description",
			},
			kb_bind("key_disa", "dogma_disassemble_key_disa"),
			kb_modifier("key_disa_modifier"),
			kb_mode("key_disa_mode"),
			{
				id = "disa_safe_equipped",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["disa_safe_equipped"],
				hint = "dogma_disassemble_disa_safe_equipped",
			},
			{
				id = "pda_grants_stash_coords",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["pda_grants_stash_coords"],
				hint = "dogma_disassemble_pda_grants_stash_coords",
			},
			{
				id = "tools_enabled",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["tools_enabled"],
				hint = "dogma_disassemble_tools_enabled",
			},
			{
				id = "attachments_enabled",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["attachments_enabled"],
				hint = "dogma_disassemble_attachments_enabled",
			},
		}),
	})
end
