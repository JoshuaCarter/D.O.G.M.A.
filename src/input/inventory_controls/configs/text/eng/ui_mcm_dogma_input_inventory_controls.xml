<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_input">
		<text>Input</text>
	</string>
	<string id="ui_mcm_menu_dogma_input_inventory_controls">
		<text>Inventory Controls</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_page_description">
		<text>Hold to paint items. Stack does the whole cell. Item does the hovered row.</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_section_transfer">
		<text>Transfer</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_transfer">
		<text>Transfer stack</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_transfer_desc">
		<text>Hold to transfer the whole stack under the cursor.</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_transfer_one">
		<text>Transfer item</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_transfer_one_desc">
		<text>Hold to transfer only the hovered item.</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_section_disassemble">
		<text>Disassemble</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_disa">
		<text>Disassemble stack</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_disa_desc">
		<text>Hold to disassemble the whole stack. Skips equipped items.</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_disa_one">
		<text>Disassemble item</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_disa_one_desc">
		<text>Hold to disassemble only the hovered item.</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_pda_grants_stash_coords">
		<text>PDA grants stash coords</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_pda_grants_stash_coords_desc">
		<text>Grant unread stash coords when disassembling PDAs. Encrypted PDAs cost more tool wear.</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_tools_enabled">
		<text>Use optimal tool</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_tools_enabled_desc">
		<text>Use the most worn tool that will still survive.</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_section_drop">
		<text>Drop</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_drop">
		<text>Drop stack</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_drop_desc">
		<text>Hold to drop the whole stack. Skips equipped and quest items.</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_drop_one">
		<text>Drop item</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_drop_one_desc">
		<text>Hold to drop only the hovered item.</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_section_stripping">
		<text>Stripping</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_strip">
		<text>Strip stack</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_strip_desc">
		<text>Hold to strip every weapon in the stack. Parts stay on the weapon.</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_strip_one">
		<text>Strip weapon</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_key_strip_one_desc">
		<text>Hold to strip only the hovered weapon.</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_intercept_disassemble">
		<text>Strip instead of disassemble</text>
	</string>
	<string id="ui_mcm_dogma_input_inventory_controls_intercept_disassemble_desc">
		<text>If you disassemble a weapon that still has parts, strip those first.</text>
	</string>
</string_table>
