	<string id="ui_mcm_menu_dogma_gameplay_weapons_ban">
		<text>Weapons Ban</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_weapons_ban_page_description">
		<text>Traders won't buy your guns, ammo, or attachments - you must find them in stashes and corpses. Ammo amounts are RU budgets converted by box price (corpses by rank, stash ammo rolls by tier→rank, start by RU per gun). Stash attach extras use price bands below.</text>
	</string>

	<string id="ui_mcm_dogma_gameplay_weapons_ban_extra_start_ammo_ru">
		<text>Start ammo (RU per weapon)</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_weapons_ban_extra_start_ammo_ru_desc">
		<text>RU budget granted for each owned start weapon, converted to rounds via that ammo's box cost. 0 disables. Default 10000.</text>
	</string>

