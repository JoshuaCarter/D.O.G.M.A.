	<string id="ui_mcm_dogma_free_gameplay_free_zoom">
		<text>Free zoom</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_defaults_header">
		<text>ADS zoom</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_fov_zoom">
		<text>FOV zoom</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_fov_zoom_desc">
		<text>World FOV while ADS (irons and non-magnified sights). Cap 15%. 0 = off. Magnified scopes keep their own world FOV.</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_irons">
		<text>Irons</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_irons_desc">
		<text>HUD FOV for iron sights. Cap 15%. 0 = off.</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_sight">
		<text>Sights</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_sight_desc">
		<text>HUD FOV for non-magnified sights. Cap 25%. 0 = off.</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_scope">
		<text>Scopes</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_scope_desc">
		<text>HUD FOV for magnified scopes. Cap 35%. 0 = off. World FOV stays with the scope.</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_move_speed">
		<text>Move speed while zoomed</text>
	</string>
