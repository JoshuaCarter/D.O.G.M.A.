--[[
	Curated spawn / strip lists. Scan still fills gaps.
	Ignore = no spawn, no strip, no scan log.
	Loaded before 02_tiers.
]]

local STRIP = {}
local KIND = {}
local IGNORE = {}
local BY_TIER = {
	sight = { {}, {}, {}, {}, {} },
	kit = { {}, {}, {}, {}, {} },
	suppressor = { {}, {}, {}, {}, {} },
}
local COST = {
	ammo = {},
	parts = {},
}

local function add(cat, tier, ids)
	local bucket = BY_TIER[cat][tier]
	for i = 1, #ids do
		local sec = ids[i]
		STRIP[sec] = true
		KIND[sec] = cat
		bucket[#bucket + 1] = sec
	end
end

local function add_cost(cat, ids)
	local bucket = COST[cat]
	for i = 1, #ids do
		local sec = ids[i]
		STRIP[sec] = true
		KIND[sec] = cat
		bucket[#bucket + 1] = sec
	end
end

local function add_strip_only(ids)
	for i = 1, #ids do
		STRIP[ids[i]] = true
	end
end

local function add_ignore(ids)
	for i = 1, #ids do
		IGNORE[ids[i]] = true
	end
end

