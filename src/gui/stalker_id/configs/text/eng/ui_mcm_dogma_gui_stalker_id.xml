<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_gui">
		<text>GUI</text>
	</string>
	<string id="ui_mcm_menu_dogma_gui_stalker_id">
		<text>Stalker ID</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_page_description">
		<text>Centered name, rank, and faction icon when looking near stalkers. Always tries an exact camera look-ray first, then soft aim within the aim radius (optional LOS). Bush pierce applies to both. Hipfire: both 100m. Binoculars: both 200m. Other ADS/zoom: exact 200m, soft still 100m. Living hostile and zombified names are red; dead names are grey. Leader line: living non-hostiles normally, all living stalkers in binoculars — never on corpses. Losing target fades out over the fade-out time (0 = instant). Show always acquires regardless of the other show-when options. If it is off, a new target is acquired only while one of those conditions is met (release / leaving the condition fades the current one).</text>
	</string>

	<string id="ui_mcm_dogma_gui_stalker_id_enabled">
		<text>Enabled</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_show_always">
		<text>Show always</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_show_always_desc">
		<text>On: ID works whenever you look at a stalker. The other Show when options are ignored. Off: acquire only while Show when pressed / ADS / free zoomed / binoculars is met.</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_show_keybind">
		<text>Show when pressed</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_show_keybind_desc">
		<text>Used when Show always is off. Hold to acquire a new target. Unbound: this condition is unused. Releasing does not hide the current target — it fades out as if you looked away.</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_show_when_ads">
		<text>Show when ADS</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_show_when_ads_desc">
		<text>Used when Show always is off. Acquire targets while aiming down sights (not binoculars or free zoom).</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_show_when_free_zoom">
		<text>Show when free zoomed</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_show_when_free_zoom_desc">
		<text>Used when Show always is off. Acquire targets while free zoom is active.</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_show_when_binoc">
		<text>Show when binoculars</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_show_when_binoc_desc">
		<text>Used when Show always is off. Acquire targets while looking through binoculars.</text>
	</string>

	<string id="ui_mcm_dogma_gui_stalker_id_dead_id">
		<text>Identify dead stalkers</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_name_id">
		<text>Show stalker names</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_rank_id">
		<text>Show stalker rank</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_hide_on_death">
		<text>Hide ID when you die</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_fade_out_ms">
		<text>Fade out time (ms)</text>
	</string>
	<string id="ui_mcm_dogma_gui_stalker_id_fade_out_ms_desc">
		<text>How long name, rank, icon, and leader line take to fade after you lose the target. 0 hides immediately.</text>
	</string>

	<string id="ui_mcm_dogma_gui_stalker_id_aim_section">
