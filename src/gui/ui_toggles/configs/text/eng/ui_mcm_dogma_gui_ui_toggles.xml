<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_gui">
		<text>GUI</text>
	</string>
	<string id="ui_mcm_menu_dogma_gui_ui_toggles">
		<text>UI Toggles</text>
	</string>
	<string id="ui_mcm_dogma_gui_ui_toggles_page_description">
		<text>Minimap and companion bars stay hidden unless you hold or toggle their key. Same idea as Reactive BHS. No keys bound by default.</text>
	</string>
	<string id="ui_mcm_dogma_gui_ui_toggles_minimap_section">
		<text>Minimap</text>
	</string>
	<string id="ui_mcm_dogma_gui_ui_toggles_minimap_key">
		<text>Show minimap</text>
	</string>
	<string id="ui_mcm_dogma_gui_ui_toggles_minimap_key_desc">
		<text>Toggle flips the minimap; Hold shows it while held. Optional modifier below can reduce conflicts.</text>
	</string>
	<string id="ui_mcm_dogma_gui_ui_toggles_minimap_mode">
		<text>Minimap key mode</text>
	</string>
	<string id="ui_mcm_dogma_gui_ui_toggles_minimap_mode_desc">
		<text>Toggle: flip on press. Hold: show only while the key is held (starts hidden in Hold).</text>
	</string>
	<string id="dogma_gui_ui_toggles_minimap_mode_lst_toggle">
		<text>Toggle</text>
	</string>
	<string id="dogma_gui_ui_toggles_minimap_mode_lst_hold">
		<text>Hold</text>
	</string>
	<string id="ui_mcm_dogma_gui_ui_toggles_minimap_delay_ms">
		<text>Minimap show delay (ms)</text>
	</string>
	<string id="ui_mcm_dogma_gui_ui_toggles_minimap_delay_ms_desc">
		<text>Wait this long after press/hold before showing. Hide is immediate. Use 0 unless you share the key with the item wheel.</text>
	</string>
	<string id="ui_mcm_dogma_gui_ui_toggles_companion_section">
		<text>Companion bars</text>
	</string>
	<string id="ui_mcm_dogma_gui_ui_toggles_companion_key">
		<text>Show companion bars</text>
	</string>
	<string id="ui_mcm_dogma_gui_ui_toggles_companion_key_desc">
		<text>Toggle flips the companion list; Hold shows it while held. Companions still work when hidden.</text>
	</string>
	<string id="ui_mcm_dogma_gui_ui_toggles_companion_mode">
		<text>Companion key mode</text>
	</string>
	<string id="ui_mcm_dogma_gui_ui_toggles_companion_mode_desc">
		<text>Toggle: flip on press. Hold: show only while the key is held (starts hidden in Hold).</text>
	</string>
	<string id="dogma_gui_ui_toggles_companion_mode_lst_toggle">
		<text>Toggle</text>
	</string>
	<string id="dogma_gui_ui_toggles_companion_mode_lst_hold">
		<text>Hold</text>
	</string>
</string_table>
