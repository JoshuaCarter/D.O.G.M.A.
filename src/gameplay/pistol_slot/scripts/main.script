--[[
	Pistol Slot

	Engine slot 15 + ui_inventory cell_15 as the only pistol holster.
	Vanilla Action_Equip / drag-drop use slot_cell[type] → move_to_slot(cell).
	Pistols are LTX slot 1 → type key 2; binoculars stay type key 5 → cell 5.
	Settings → Controls "Weapon 4 (Pistol)" (custom25) draws / holsters slot 15.
]]

local CONFIG = _G.dogma_gameplay_pistol_slot_conf
local MOD_ID = CONFIG.MOD_ID
local PISTOL_SLOT = CONFIG.PISTOL_SLOT
local PISTOL_CELL = CONFIG.PISTOL_CELL
local PISTOL_TYPE_KEY = CONFIG.PISTOL_TYPE_KEY

local function is_sidearm(obj)
	if not obj or IsMelee(obj) or not IsWeapon(obj) then
		return false
	end
	local sec = obj:section()
	if not (sec and ini_sys) then
		return false
	end
	local s = ini_sys:r_float_ex(sec, "slot")
	return s ~= nil and tonumber(s) == 1
end

local function block(flags)
	if flags then
		flags.ret_value = false
	end
end

local function can_use_keys()
	local actor = db.actor
	if not (actor and actor:alive()) then
		return false
	end
	if actor_menu and actor_menu.inventory_opened and actor_menu.inventory_opened() then
		return false
	end
	return true
end

-- Draw sidearm from holster slot 15; re-press while active lowers it.
local function toggle_pistol_holster()
	local actor = db.actor
	if not actor then
		return
	end
	local holstered = actor:item_in_slot(PISTOL_SLOT)
	if not (holstered and is_sidearm(holstered)) then
		return
	end
	if actor:active_slot() == PISTOL_SLOT then
		actor:activate_slot(0)
		return
	end
	actor:activate_slot(PISTOL_SLOT)
end

local function on_before_key_press(_key, bind, _dis, flags)
	if not dogma.sys.ready(MOD_ID, db) then
		return
	end
	if not can_use_keys() or not key_bindings then
		return
	end
	local draw_bind = CONFIG.BINDS and dogma.keys.bind_kb(CONFIG.BINDS.draw.kb)
	if draw_bind and bind == draw_bind then
		block(flags)
		toggle_pistol_holster()
	end
end

local function sync_holster_cell(cc)
	local item = db.actor:item_in_slot(PISTOL_SLOT)
	if item and not is_sidearm(item) then
		db.actor:move_to_ruck(item)
		item = nil
	end
	if item then
		cc:AddItemManual(item, nil, PISTOL_CELL)
	else
		cc:RemoveItemManual(PISTOL_CELL)
	end
end

-- Re-applied every inventory open: GAMMA "Knife Pistol in Binocular Slot" replaces
-- the whole slot_cell table on GUI_on_show (knife→{1,5}, pistol→{2,1,3,5}).
local function apply_slot_routing(gui)
	gui.slot_cell[1] = { 1 } -- knife → knife only
	gui.slot_cell[PISTOL_TYPE_KEY] = { PISTOL_CELL } -- pistol → holster 15 only
	gui.slot_cell[3] = { 3 } -- rifle → primary only
	gui.slot_cell[5] = { 5 } -- vision / binocs → cell 5 only
end

local function patch_inventory_gui(gui)
	local cc = gui.CC and gui.CC["actor_equ"]
	if not cc then
		return
	end

	apply_slot_routing(gui)

	if gui._dogma_pistol_slot_patched then
		return
	end
	gui._dogma_pistol_slot_patched = true

	-- Vanilla only creates cells 1..13. Create 14 (offscreen) + 15 so #cell is dense.
	if not cc.cell[14] then
		cc:AddItemManual(nil, nil, 14)
	end
	if not cc.cell[PISTOL_CELL] then
		cc:AddItemManual(nil, nil, PISTOL_CELL)
	end

	local orig_update = gui.UpdateSlots
	gui.UpdateSlots = function(self, ...)
		-- Vanilla maps engine slot i → slot_cell[i][1]. With [2]={15} that would
		-- draw engine slot 2 into cell 15 and clear our holster. Temporarily restore
		-- identity mapping for type 2 so the stock loop leaves cell 15 alone.
		apply_slot_routing(self)
		local saved = self.slot_cell[PISTOL_TYPE_KEY]
		self.slot_cell[PISTOL_TYPE_KEY] = { 2 }
		orig_update(self, ...)
		self.slot_cell[PISTOL_TYPE_KEY] = saved

		local equ = self.CC and self.CC["actor_equ"]
		if equ then
			sync_holster_cell(equ)
		end
	end
end

local function on_gui_show(name)
	if name ~= "UIInventory" then
		return
	end
	local gui = ui_inventory and ui_inventory.GUI
	if not gui then
		return
	end
	patch_inventory_gui(gui)
	-- Run again next tick so we win over GAMMA binoc_pistol_knife (also GUI_on_show).
	CreateTimeEvent(MOD_ID, "slot_route", 0, function()
		local g = ui_inventory and ui_inventory.GUI
		if g and g.slot_cell then
			apply_slot_routing(g)
		end
		return true
	end)
end

function on_game_start()
	dogma.load(MOD_ID)
	if _G.SCANNED_SLOTS then
		_G.SCANNED_SLOTS[PISTOL_SLOT] = true
	end
	RegisterScriptCallback("GUI_on_show", on_gui_show)
	RegisterScriptCallback("on_before_key_press", on_before_key_press)
end
