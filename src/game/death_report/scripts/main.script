--[[
	Death Report

	Snapshot known values before a hit, snapshot again after it applies,
	store that delta + who/what caused it. Display only those readings.
	Missing readings print "?". No estimated damage, no merged trackers.
	On death: Tab toggles the summary (off by default). MCM preview while
	alive. No camera / spectate.
]]

local CONFIG = _G.dogma_game_death_report_conf

local HIT_WINDOW_MS = 30000
local HIT_CAP_MIN = 1
local HIT_CAP_MAX = 20
local UI_W = 1024
local UI_H = 768
local LINE_H_FALLBACK = 18
local FONT_INI_REL = "ui\\ui_font_letterica16_russian"
local PANEL_PAD = 12
local PANEL_W_MIN = 200
local PANEL_W_MAX = 1024
local PANEL_TOP_MAX = 700
local PROMPT_H = 28
local PROMPT_GAP = 4
local PROMPT_Y = 50
-- Engine ProcessNewLines drops empty remainders after \\n, so a space keeps the gap.
local BLANK = " "
local PANEL_TEX = "ui_inGame2_white_rect"

local HIT_STATIC = "dogma_death_report_summary"
local TAB_STATIC = "dogma_death_report_prompt"
local PANEL_STATIC = "dogma_death_report_panel"

-- Faithful bone → BHS limb (same ids as damage_location_fix / ADB).
local HITBOX = {
	[1] = "torso", -- bip01
	[2] = "torso", -- bip01_pelvis
	[11] = "torso", [12] = "torso", [13] = "torso", -- spine / spine1 / spine2
	[14] = "head", -- bip01_neck
	[15] = "head", -- bip01_head
	[16] = "head", [17] = "head", -- eyes
	[18] = "head", [19] = "head", -- eyelid / jaw
	[20] = "leftarm", -- bip01_l_clavicle
	[21] = "leftarm", [22] = "leftarm", [23] = "leftarm", -- upperarm / forearm / hand
	[24] = "leftarm", [25] = "leftarm", [26] = "leftarm",
	[27] = "leftarm", [28] = "leftarm", [29] = "leftarm",
	[30] = "leftarm", [31] = "leftarm", [32] = "leftarm", -- fingers
	[33] = "rightarm", -- bip01_r_clavicle
	[34] = "rightarm", [35] = "rightarm", [36] = "rightarm", -- upperarm / forearm / hand
	[37] = "rightarm", [38] = "rightarm", [39] = "rightarm",
	[40] = "rightarm", [41] = "rightarm", [42] = "rightarm",
	[43] = "rightarm", [44] = "rightarm", [45] = "rightarm", -- fingers
	[3] = "leftleg", [4] = "leftleg", [5] = "leftleg", [6] = "leftleg", -- thigh / calf / foot / toe
	[7] = "rightleg", [8] = "rightleg", [9] = "rightleg", [10] = "rightleg",
}

local LIMB_DISPLAY = {
	["head"] = "Head",
	["torso"] = "Torso",
	["leftarm"] = "L Arm",
	["rightarm"] = "R Arm",
	["leftleg"] = "L Leg",
	["rightleg"] = "R Leg",
	["body"] = "Body",
	["unknown"] = "Limb",
}

-- Anomaly community colors (same keys as stalker_id / PDA factions).
