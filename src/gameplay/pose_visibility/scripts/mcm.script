function on_mcm_load(options)
	local CONFIG = _G.dogma_gameplay_pose_visibility_conf
	local function cap(id, def_key)
		return {
			id = id,
			type = "track",
			val = 2,
			min = 0,
			max = 1,
			step = 0.05,
			def = CONFIG.DEFAULTS[def_key],
			hint = "dogma_gameplay_pose_visibility_" .. id,
		}
	end

	dogma_mcm.attach(options, "gameplay", "ui_mcm_menu_dogma_gameplay", {
		id = "pose_visibility",
		sh = true,
		text = "ui_mcm_menu_dogma_gameplay_pose_visibility",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_gameplay_pose_visibility_page_description",
			},
			cap("cap_stand", "cap_stand"),
			cap("cap_crouch", "cap_crouch"),
			cap("cap_prone", "cap_prone"),
		}),
	})
end
