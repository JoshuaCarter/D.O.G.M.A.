-- game/campfire_healing conf
-- Lit campfire within range_m (0–5, def 2): convert existing limb temp→perm, heal body.
-- body_sec / limb_sec: seconds for a 20% step (body 30–100 def 30; limbs 20–100 def 20).
-- pause_in_combat: optional; default off (heal even if something still has you as best_enemy).
-- fx_enable / fx_intensity: orange PPE while body HP < 100% and a heal is running.

_G.dogma_game_campfire_healing_conf = {
	MOD_ID = "dogma/game/campfire_healing",
	DEFAULTS = {
		range_m = 3,
		body_sec = 30,
		limb_sec = 15,
		pause_in_combat = true,
		fx_enable = true,
		fx_intensity = 0.1,
	},
	PPE = {
		name = "dogma_campfire_heal.ppe",
		id = 2041,
	},
}

function on_mcm_load(options)
	local CONFIG = _G.dogma_game_campfire_healing_conf
	dogma_mcm.attach(options, "game", "ui_mcm_menu_dogma_game", {
		id = "campfire_healing",
		sh = true,
		text = "ui_mcm_menu_dogma_game_campfire_healing",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_game_campfire_healing_page_description",
			},
			{
				id = "range_m",
				type = "track",
				val = 2,
				min = 0,
				max = 5,
				step = 0.1,
				def = CONFIG.DEFAULTS.range_m,
				hint = "dogma_game_campfire_healing_range_m",
			},
			{
				id = "pause_in_combat",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.pause_in_combat,
				hint = "dogma_game_campfire_healing_pause_in_combat",
			},
			{
				id = "body_sec",
				type = "track",
				val = 2,
				min = 30,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS.body_sec,
				hint = "dogma_game_campfire_healing_body_sec",
			},
			{
				id = "limb_sec",
				type = "track",
				val = 2,
				min = 15,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS.limb_sec,
				hint = "dogma_game_campfire_healing_limb_sec",
			},
			{
				id = "fx_enable",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.fx_enable,
				hint = "dogma_game_campfire_healing_fx_enable",
			},
			{
				id = "fx_intensity",
				type = "track",
				val = 2,
				min = 0,
				max = 0.3,
				step = 0.01,
				def = CONFIG.DEFAULTS.fx_intensity,
				hint = "dogma_game_campfire_healing_fx_intensity",
			},
		}),
	})
end
