-- VFS dump on first_update. Beeps after load-screen dismiss (timer was firing during intro).

local LOG = "[dogma_tweaks_fix_footsteps_sfx]"
local BEEP = "mutant_steps\\hoof_ground_1"
local MUTANT = "mutant_steps\\hoof_ground_1"

local started = false
local frames = 0
local need_dismiss = false
local prev_dismissed = nil
local prev_prompt = nil

local function log_step_line(params, key)
	local ini = system_ini()
	if not ini:section_exist(params) then
		printf("%s missing section %s", LOG, params)
		return
	end
	if not ini:line_exist(params, key) then
		printf("%s %s has no %s", LOG, params, key)
		return
	end
	printf("%s %s %s = %s", LOG, params, key, ini:r_string(params, key))
end

local function log_near_monster(obj)
	if not IsMonster(obj) then
		return
	end
	local sec = obj:section()
	local ini = system_ini()
	local mat = "?"
	local params = "?"
	if ini:line_exist(sec, "material") then
		mat = ini:r_string(sec, "material")
	end
	if ini:line_exist(sec, "step_params") then
		params = ini:r_string(sec, "step_params")
	end
	printf("%s near %s mat=%s step_params=%s", LOG, sec, mat, params)
	if params ~= "?" then
		log_step_line(params, "stand_run_0")
		log_step_line(params, "stand_run_fwd_0")
	end
end

local function log_beep_files()
	local tostr = tostring
	local names = dogma.xlibs.xfs.files("$game_sounds$", "mutant_steps\\", ".ogg")
	local i = 1
	local n = 0
	while names[i] do
		n = n + 1
		i = i + 1
	end
	local xs = dogma.xlibs.xsound
	printf("%s vfs mutant_steps n=%s beep_ms=%s tinnitus_ms=%s mutant_ms=%s", LOG, tostr(n), tostr(xs.length(BEEP)), tostr(xs.length("affects\\tinnitus3a")), tostr(xs.length(MUTANT)))
end

function start_beeps()
	if started then
		return
	end
	started = true
	log_beep_files()
	local xs = dogma.xlibs.xsound
	local h_m = xs.play_at(MUTANT, { s2d = true, volume = 1.0 })
	local h_b = xs.play_at(BEEP, { s2d = true, volume = 1.0 })
	printf("%s held 2d mutant h=%s beep h=%s", LOG, tostring(h_m), tostring(h_b))
end

function on_load_dismissed()
	if prev_dismissed then
		prev_dismissed()
	end
	printf("%s load dismissed", LOG)
	start_beeps()
end

function on_load_prompt()
	if prev_prompt then
		prev_prompt()
	end
	need_dismiss = true
	printf("%s load prompt, wait dismiss", LOG)
end

function hook_load_screen()
	local d = rawget(_G, "OnLoadingScreenDismissed")
	if d ~= on_load_dismissed then
		prev_dismissed = d
		rawset(_G, "OnLoadingScreenDismissed", on_load_dismissed)
	end
	local p = rawget(_G, "OnLoadingScreenKeyPrompt")
	if p ~= on_load_prompt then
		prev_prompt = p
		rawset(_G, "OnLoadingScreenKeyPrompt", on_load_prompt)
	end
end

function actor_on_update()
	if started then
		return
	end
	if need_dismiss then
		return
	end
	frames = frames + 1
	if frames < 180 then
		return
	end
	printf("%s fallback no load prompt", LOG)
	start_beeps()
end

function actor_on_first_update()
	hook_load_screen()
	local names = dogma.xlibs.xfs.files("$game_data$", "materials\\", ".ltx")
	local i = 1
	while names[i] do
		local n = names[i]
		if string.find(n, "material_pairs", 1, true) then
			printf("%s vfs materials/%s.ltx", LOG, n)
		end
		i = i + 1
	end
	log_step_line("m_snork_step_params", "stand_run_0")
	log_step_line("m_boar_step_params", "stand_run_fwd_0")
	level.iterate_nearest(db.actor:position(), 40, log_near_monster)
end

function on_game_start()
	hook_load_screen()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
end
