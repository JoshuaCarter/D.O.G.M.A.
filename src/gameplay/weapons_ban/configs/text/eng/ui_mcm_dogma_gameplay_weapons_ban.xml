	<string id="ui_mcm_menu_dogma_gameplay_weapons_ban">
		<text>Weapons Ban</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_weapons_ban_page_description">
		<text>Traders won't buy your guns, ammo, or attachments - you must find them in stashes and corpses. New games get extra ammo for owned weapons (same types as stock), scaled by caliber power. Stash loot uses price bands (RU cost cutoffs below) per category. Parts use part_prices values.</text>
	</string>

	<string id="ui_mcm_dogma_gameplay_weapons_ban_extra_start_ammo_max">
		<text>Start ammo stacks (lightest)</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_weapons_ban_extra_start_ammo_max_desc">
		<text>Extra 15-round stacks granted for the lightest calibers (lowest damage+AP). Heavier calibers scale down toward the heavy slider. Both 0 disables. Default 8.</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_weapons_ban_extra_start_ammo_min">
		<text>Start ammo stacks (heaviest)</text>
	</string>
	<string id="ui_mcm_dogma_gameplay_weapons_ban_extra_start_ammo_min_desc">
		<text>Extra 15-round stacks granted for the heaviest calibers (highest damage+AP). Default 2.</text>
	</string>

