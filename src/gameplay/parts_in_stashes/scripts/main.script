--[[
	Parts in Stashes

	Requires RNG Attach. Chains after its set_random_stash wrap, then rolls
	weapon parts into the box when RNG added loot. Mechanics always stripped
	of prt_w*.

	Edit roll_parts() below - that is the single place for spawn math.
]]

local CONFIG = _G.dogma_gameplay_parts_in_stashes_conf
local MOD_ID = CONFIG.MOD_ID
local DOGMA

-- Rep tier → inventory condition % band (cond_r uses 0–100).
local COND_BANDS = {
	[1] = { 60, 70 },
	[2] = { 70, 80 },
	[3] = { 80, 90 },
	[4] = { 90, 100 },
	[5] = { 99, 100 },
}

-- Same north set as RNG Attach (map name → true).
local NORTH_MAPS = {
	["l10_limansk"] = true,
	["l10_radar"] = true,
	["l10_red_forest"] = true,
	["l11_hospital"] = true,
	["l11_pripyat"] = true,
	["l12_stancia"] = true,
	["l12_stancia_2"] = true,
	["l13_generators"] = true,
	["zaton"] = true,
	["jupiter"] = true,
	["pripyat"] = true,
}

local REP_FACTIONS = {
	"dolg", "freedom", "stalker", "killer", "army", "csky",
	"ecolog", "bandit", "monolith", "isg", "renegade", "greh",
}

-- parts_by_tier[1..5] = { section, ... } from part_prices + item LTX tier
local parts_by_tier = { {}, {}, {}, {}, {} }
local parts_built = false

local original_set_random_stash
local original_trader_update
local hooked_stash = false
local hooked_trader = false

local function log(msg)
	if DOGMA and DOGMA.dbg and DOGMA.dbg.logging() then
		DOGMA.dbg.log(MOD_ID, tostring(msg))
	end
end

local function ensure_parts_list()
	if parts_built then
		return
	end
	parts_built = true
	local prices = ini_file("items\\settings\\part_prices.ltx")
	if not (prices and prices:section_exist("wpo_part_prices")) then
		log("WARN: part_prices.ltx / wpo_part_prices missing")
		return
	end
	local n = prices:line_count("wpo_part_prices")
	for i = 0, n - 1 do
		local _ok, sec = prices:r_line("wpo_part_prices", i, "", "")
		if sec ~= "" and string.find(sec, "prt_w", 1, true) then
			local t = math.floor(ini_sys:r_float_ex(sec, "tier") or 1)
			t = math.max(1, math.min(5, t))
			parts_by_tier[t][#parts_by_tier[t] + 1] = sec
		end
	end
end

local function on_option_change()
	local L = CONFIG.loaded
	L.parts_chance = DOGMA.mcm.number(MOD_ID, "parts_chance", 50)
	L.max_parts = DOGMA.mcm.number(MOD_ID, "max_parts", 3)
	ensure_parts_list()
end

local function reputation_mode_on()
	if not (rng_attachments_mcm and rng_attachments_mcm.get_config) then
		return true
	end
	return rng_attachments_mcm.get_config("reputation_mode") ~= false
end

-- Same breakpoints as RNG Attach get_highest_tier().
local function get_rep_tier()
	if not reputation_mode_on() then
		return 5
	end
	local max_rep = 0
	for i = 1, #REP_FACTIONS do
		local rep = relation_registry.community_goodwill(REP_FACTIONS[i], 0) or 0
		if rep > max_rep then
			max_rep = rep
		end
	end
	if max_rep >= 2000 then
		return 5
	elseif max_rep >= 1500 then
		return 4
	elseif max_rep >= 1000 then
		return 3
	elseif max_rep >= 500 then
		return 2
	end
	return 1
end

local function map_name_for_stash(id)
	local se_box = id and alife_object(id)
	if not (se_box and se_box.m_game_vertex_id) then
		return nil
	end
	local ok, name = pcall(function()
		return alife():level_name(game_graph():vertex(se_box.m_game_vertex_id):level_id())
	end)
	if ok then
		return name
	end
	return nil
end

-- Pool of sections with Anomaly item tier <= part_tier (spring=1 … barrel=5).
local function pool_for_part_tier(part_tier)
	local pool = {}
	for t = 1, part_tier do
		local bucket = parts_by_tier[t]
		for i = 1, #bucket do
			pool[#pool + 1] = bucket[i]
		end
	end
	return pool
end

--------------------------------------------------------------------------------
-- EDIT HERE: single roll entry point
--
-- bonus_items : sections RNG appended this call (must be non-empty)
-- rep_tier    : 1–5 from goodwill / RNG reputation_mode
-- part_tier   : max component tier to allow (1 spring … 5 barrel)
-- map_tier    : 0 = south, 1 = north
--
-- Returns { { section=, cond_lo=, cond_hi= }, ... } for the wrap to spawn.
--------------------------------------------------------------------------------
local function roll_parts(bonus_items, rep_tier, part_tier, map_tier)
	if #bonus_items == 0 then
		return {}
	end

	local L = CONFIG.loaded
	if math.random(1, 100) > L.parts_chance then
		return {}
	end

	local pool = pool_for_part_tier(part_tier)
	if #pool == 0 then
		return {}
	end

	local band = COND_BANDS[rep_tier] or COND_BANDS[1]
	local out = {}
	local count = math.random(1, L.max_parts)
	for _ = 1, count do
		out[#out + 1] = {
			section = pool[math.random(#pool)],
			cond_lo = band[1],
			cond_hi = band[2],
		}
	end
	return out
end

local function spawn_rolled(id, rolled)
	if #rolled == 0 then
		return
	end
	local box = id and alife_object(id)
	if not box then
		return
	end
	for i = 1, #rolled do
		local p = rolled[i]
		alife_create_item(p.section, box, {
			cond_r = { p.cond_lo, p.cond_hi },
			cond_ct = "part",
			cond_cr = { 0.5, 0.75, 1 },
		})
		log(string.format("spawn %s cond %s-%s", p.section, p.cond_lo, p.cond_hi))
	end
end

local function patched_set_random_stash(no_spot, hint, bonus_items, id, dbg)
	bonus_items = bonus_items or {}
	local n_before = #bonus_items
	local result = original_set_random_stash(no_spot, hint, bonus_items, id, dbg)

	if not (DOGMA and DOGMA.sys and DOGMA.sys.ready(MOD_ID, db, on_option_change)) then
		return result
	end
	if not id then
		return result
	end

	local rng_bonus = {}
	for i = n_before + 1, #bonus_items do
		rng_bonus[#rng_bonus + 1] = bonus_items[i]
	end

	local rep_tier = get_rep_tier()
	local is_north = NORTH_MAPS[map_name_for_stash(id)] or false
	if not reputation_mode_on() then
		is_north = true
	end
	local map_tier = is_north and 1 or 0
	local part_tier = is_north and math.min(5, rep_tier + 1) or rep_tier

	spawn_rolled(id, roll_parts(rng_bonus, rep_tier, part_tier, map_tier))
	return result
end

local function patched_trader_update(npc)
	original_trader_update(npc)
	if not (DOGMA and DOGMA.sys and DOGMA.sys.ready(MOD_ID, db, on_option_change)) then
		return
	end
	if not (trader_autoinject and trader_autoinject.get_trader_type and npc) then
		return
	end
	if trader_autoinject.get_trader_type(npc) == trader_autoinject.MECHANIC then
		npc:iterate_inventory(function(_temp, item)
			if item and string.find(item:section(), "prt_w", 1, true) then
				alife_release_id(item:id())
			end
		end)
	end
end

local function try_hook_stash()
	if hooked_stash then
		return
	end
	if not (treasure_manager and treasure_manager.set_random_stash) then
		return
	end
	original_set_random_stash = treasure_manager.set_random_stash
	treasure_manager.set_random_stash = patched_set_random_stash
	hooked_stash = true
	log("hooked treasure_manager.set_random_stash")
end

local function try_hook_trader()
	if hooked_trader then
		return
	end
	if not (trader_autoinject and trader_autoinject.update) then
		return
	end
	original_trader_update = trader_autoinject.update
	trader_autoinject.update = patched_trader_update
	hooked_trader = true
	log("hooked trader_autoinject.update")
end

local function try_hooks()
	try_hook_stash()
	try_hook_trader()
end

function on_game_start()
	DOGMA = dogma_common.load(MOD_ID)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_first_update", try_hooks)
	on_option_change()
	try_hooks()
	log("parts_in_stashes ready")
end
