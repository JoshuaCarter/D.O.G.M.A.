	</string>
	<string id="ui_mcm_dogma_stalker_id_time_id">
		<text>Delay identification by distance</text>
	</string>
	<string id="ui_mcm_dogma_stalker_id_time_id_desc">
		<text>If enabled, identification requires looking at a stalker for a period based on distance.</text>
	</string>
	<string id="ui_mcm_dogma_stalker_id_rank_id">
