--[[
	DOGMA Rules

	Applies dogma_rules.ltx on game start. MCM rows for present target
	mods are greyed at gather (see mcm.script). Absent mods are skipped.
]]

local CONFIG = _G.dogma_game_dogma_rules_conf

local function ensure_gathered()
	if not (ui_mcm and ui_mcm.get) then
		return
	end
	if ui_mcm.is_gathering and ui_mcm.is_gathering() then
		return
	end
	pcall(ui_mcm.get, "mcm/mcm_log/enable")
end

local function apply_launch()
	if not (CONFIG and CONFIG.apply) then
		return
	end
	ensure_gathered()
	CONFIG.apply({ commands = true, notify = true })
end

local function apply_mcm()
	if not (CONFIG and CONFIG.apply) then
		return
	end
	CONFIG.apply({ commands = false, notify = false })
end

function on_game_start()
	if not CONFIG then
		return
	end
	dogma.load(CONFIG.MOD_ID)
	apply_launch()
	RegisterScriptCallback("mcm_option_change", apply_mcm)
end
