-- game/badwill conf
-- Witness hits/kills and steal-loot share one personal agro decay.

_G.dogma_game_badwill_conf = {
	MOD_ID = "dogma/game/badwill",
	DEFAULTS = {
		enabled = true,
		steal_enabled = true,
		steal_key = -1,
		steal_timer = 30,
		steal_nearby_faction = false,
	},
}

function on_mcm_load(options)
	local CONFIG = _G.dogma_game_badwill_conf
	dogma_mcm.attach(options, "game", "ui_mcm_menu_dogma_game", {
		id = "badwill",
		sh = true,
		text = "ui_mcm_menu_dogma_game_badwill",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_game_badwill_page_description",
			},
			{
				id = "witness_header",
				type = "title",
				text = "ui_mcm_dogma_game_badwill_witness_header",
			},
			{
				id = "enabled",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.enabled,
				hint = "dogma_game_badwill_enabled",
			},
			{ id = "line_steal", type = "line" },
			{
				id = "steal_header",
				type = "title",
				text = "ui_mcm_dogma_game_badwill_steal_header",
			},
			{
				id = "steal_enabled",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.steal_enabled,
				hint = "dogma_game_badwill_steal_enabled",
			},
			{
				id = "steal_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS.steal_key,
				hint = "dogma_game_badwill_steal_key",
			},
			{
				id = "steal_timer",
				type = "track",
				val = 2,
				min = 5,
				max = 120,
				step = 5,
				def = CONFIG.DEFAULTS.steal_timer,
				hint = "dogma_game_badwill_steal_timer",
			},
			{
				id = "steal_nearby_faction",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.steal_nearby_faction,
				hint = "dogma_game_badwill_steal_nearby_faction",
			},
		}),
	})
end
