--[[
	SortingPlus favourite / junk keys + cross-game persistence.

	Replaces SortingPlus's hardcoded K / J with MCM binds (injected into
	SortingPlus's page). Favourites are mirrored into axr_options so new games
	keep your list. Context-menu Mark Favorite / Junk still work.
]]

local CONFIG = _G.dogma_items_favourites_conf
local MOD_ID = CONFIG.MOD_ID
local SECTION = "dogma_item_favourites"
local DOGMA

local STATE = _G.__dogma_items_favourites or {}
_G.__dogma_items_favourites = STATE

local function log(msg)
	if DOGMA and DOGMA.dbg and DOGMA.dbg.logging() then
		DOGMA.dbg.log(MOD_ID, tostring(msg))
	end
end

local function sp()
	return zzz_rax_sortingplus_mcm
end

local function cfg()
	return axr_main and axr_main.config
end

local function profile_set(sec, on)
	local c = cfg()
	if not (c and sec) then
		return
	end
	c:w_value(SECTION, sec, on and "favorites" or nil)
	c:save()
end

local function profile_list()
	local c = cfg()
	if not c then
		return {}
	end
	local t = c:collect_section(SECTION) or {}
	local out = {}
	for sec, val in pairs(t) do
		if val and val ~= "" then
			out[sec] = true
		end
	end
	return out
end

local function profile_replace(favs)
	local c = cfg()
	if not c then
		return
	end
	local prev = c:collect_section(SECTION) or {}
	for sec, _ in pairs(prev) do
		c:w_value(SECTION, sec, nil)
	end
	if favs then
		for sec, _ in pairs(favs) do
			c:w_value(SECTION, sec, "favorites")
		end
	end
	c:save()
end

local function refresh_icons()
	if rax_icon_layers and rax_icon_layers.refresh then
		rax_icon_layers.refresh(1)
	end
end

local function mcm_dik(path, fallback)
	local v = ui_mcm and tonumber(ui_mcm.get(path))
	if v == nil then
		return fallback
	end
	if v == -1 then
		return nil
	end
	return v
end

local function key_favorite()
	return mcm_dik("SortingPlus/key_favorite", DIK_keys and DIK_keys.DIK_K or nil)
end

local function key_junk()
	return mcm_dik("SortingPlus/key_junk", DIK_keys and DIK_keys.DIK_J or nil)
end

-- Replace SortingPlus UICellContainer fav/junk keys with MCM binds.
local function patch_sortingplus_keys()
	if STATE.keys_patched then
		return
	end
	local cell = utils_ui and utils_ui.UICellContainer
	if not (cell and cell.OnKeyboard) then
		return
	end

	local tg_wait = 0
	local m = sp()

	function cell:OnKeyboard(dik, keyboard_action)
		local fav = key_favorite()
		local junk = key_junk()
		local tg = time_global and time_global() or 0

		if (dik == fav or dik == junk) and fav ~= junk and tg > tg_wait and self.hover and self.hover.idx then
			tg_wait = tg + 500
			local indx = self.hover.idx
			if self.cell and self.cell[indx] and self.cell[indx].section then
				local sec = self.cell[indx].section
				if dik == fav and m and m.set_favorite and m.is_favorite then
					m.set_favorite(sec, not m.is_favorite(sec))
					refresh_icons()
				elseif dik == junk and m and m.set_junk and m.is_junk then
					m.set_junk(sec, not m.is_junk(sec))
					refresh_icons()
				end
			end
		end

		if self.OnKeyboardBase then
			return self:OnKeyboardBase(dik, keyboard_action)
		end
	end

	STATE.keys_patched = true
end

local function patch_sortingplus()
	if STATE.patched then
		return true
	end
	local m = sp()
	if not (m and m.set_favorite and m.set_junk and m.is_favorite) then
		return false
	end

	local base_fav = m.set_favorite
	local base_junk = m.set_junk
	STATE.base_fav = base_fav

	m.set_favorite = function(sec, state)
		base_fav(sec, state)
		profile_set(sec, state and true or false)
	end

	m.set_junk = function(sec, state)
		base_junk(sec, state)
		if state then
			profile_set(sec, false)
		end
	end

	patch_sortingplus_keys()
	STATE.patched = true
	return true
end

local function apply_profile()
	local base = STATE.base_fav
	if not base then
		return
	end
	local n = 0
	for sec, _ in pairs(profile_list()) do
		base(sec, true)
		n = n + 1
	end
	if n > 0 then
		refresh_icons()
		log(string.format("applied %d profile favourites", n))
	end
end

function on_game_start()
	DOGMA = dogma_common.load(MOD_ID)

	if not patch_sortingplus() then
		printf("[dogma_items_favourites] SortingPlus API missing — fav keys / persistence skipped")
		return
	end

	RegisterScriptCallback("load_state", function(mdata)
		if mdata and mdata.rax_favorite_itms then
			local merged = profile_list()
			local dirty = false
			for sec, _ in pairs(mdata.rax_favorite_itms) do
				if not merged[sec] then
					merged[sec] = true
					dirty = true
				end
			end
			if dirty then
				profile_replace(merged)
			end
		end
	end)

	RegisterScriptCallback("save_state", function(mdata)
		if mdata and mdata.rax_favorite_itms then
			profile_replace(mdata.rax_favorite_itms)
		end
	end)

	RegisterScriptCallback("actor_on_first_update", function()
		apply_profile()
	end)

	log("SortingPlus fav/junk keys + persistence ready")
end
