-- gui/fx_bleed conf
--
-- Corner blood HUD overlays from 1024² atlases (512² quadrant per screen corner).
-- One visible corner per wound tier, in order: tl, tr, bl, br (max 4).

_G.dogma_gui_fx_bleed_conf = {
	MOD_ID = "dogma/gui/fx_bleed",
	MAX_LAYERS = 4,
	APPEARANCES = 3,
	UI_W = 1024,
	UI_H = 768,
	BASE_SIZE = 512,
	FADE_IN_MS = 100,
	FADE_OUT_MS = 1000,
	SCALES = { 0.25, 0.5, 1.0 },
	-- MCM only: one short-wide DDS (512x64 source), all 3 styles left-to-right. Not hud_blood_*.
	MCM_STYLE_PREVIEW = "dogma_gui_fx_bleed_mcm_preview",
	MCM_STYLE_PREVIEW_SIZE = { 512, 50 },
	CORNERS = { "tl", "tr", "bl", "br" },
	CORNER_LAYOUT = {
		tl = { tx = 0, ty = 0 },
		tr = { tx = 512, ty = 0 },
		bl = { tx = 0, ty = 512 },
		br = { tx = 512, ty = 512 },
	},
	DEFAULTS = {
		enable = true,
		max_alpha = 0.7,
		style = 0,
		scale = 2,
	},
	WOUND_TIERS = {
		{ min = 1.5, layers = 4 },
		{ min = 1.0, layers = 3 },
		{ min = 0.5, layers = 2 },
		{ min = 0.01, layers = 1 },
	},
	loaded = {},
}

function on_mcm_load(options)
	local CONFIG = _G.dogma_gui_fx_bleed_conf
	dogma_mcm.attach(options, "gui", "ui_mcm_menu_dogma_gui", {
		id = "fx_bleed",
		sh = true,
		text = "ui_mcm_menu_dogma_gui_fx_bleed",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_gui_fx_bleed_page_description",
			},
			{
				id = "style_preview",
				type = "slide",
				link = CONFIG.MCM_STYLE_PREVIEW,
				text = "ui_mcm_dogma_gui_fx_bleed_style_preview",
				size = CONFIG.MCM_STYLE_PREVIEW_SIZE,
				stretch = true,
				spacing = 12,
			},
			{
				id = "enable",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.enable,
				hint = "dogma_gui_fx_bleed_enable",
			},
			{
				id = "style",
				type = "list",
				val = 2,
				def = CONFIG.DEFAULTS.style,
				hint = "dogma_gui_fx_bleed_style",
				content = {
					{ 0, "style_0" },
					{ 1, "style_1" },
					{ 2, "style_2" },
				},
			},
			{
				id = "scale",
				type = "list",
				val = 2,
				def = CONFIG.DEFAULTS.scale,
				hint = "dogma_gui_fx_bleed_scale",
				content = {
					{ 0, "scale_25" },
					{ 1, "scale_50" },
					{ 2, "scale_100" },
				},
			},
			{
				id = "max_alpha",
				type = "track",
				val = 2,
				min = 0,
				max = 1,
				step = 0.05,
				def = CONFIG.DEFAULTS.max_alpha,
				hint = "dogma_gui_fx_bleed_max_alpha",
			},
		}),
	})
end
