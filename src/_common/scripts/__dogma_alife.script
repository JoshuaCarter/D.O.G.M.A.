--[[
    Live objects: client by id, SE id to map name.
    ray(): engine RayPick, optional bush / see-through recast.
    Online stalker queries: FOV, LOS, nearby, in-combat.
]]

local xobject = dogma.xlibs.xobject
local xlevel = dogma.xlibs.xlevel
local xcreature = dogma.xlibs.xcreature

local DEFAULT_FOV_DEG = 100
local DEFAULT_COMBAT_M = 100
local LOOK_FLAGS = 3 -- rqtObject | rqtStatic
local LOOK_BUSH_STEP = 0.2
local BUSH_PIERCE = 1
local BONES_CHEST = { "bip01_spine2", "bip01_spine1", "bip01_neck" }
local BONES_HEAD = { "bip01_head" }
local COS_CACHE = {}

local pick = nil
local pick_ignore_id = nil
local RAY_POS = vector()
local RAY_DIR = vector()

local function obj_id(obj)
    if not obj then
        return nil
    end
    local ok, id = pcall(obj.id, obj)
    if ok then
        return id
    end
    return nil
end

local function cos_deg(deg)
    local c = COS_CACHE[deg]
    if c then
        return c
    end
    c = math.cos(deg * math.pi / 180)
    COS_CACHE[deg] = c
    return c
end

local function fov_deg(fov)
    if fov == true then
        return DEFAULT_FOV_DEG
    end
    if type(fov) == "number" then
        return fov
    end
    return nil
end

local function bone_pos(obj, bones)
    if not (obj and bones) then
        return nil
    end
    for i = 1, #bones do
        local ok, p = pcall(obj.bone_position, obj, bones[i])
        if ok and p then
            return p
        end
    end
    local ok, p = pcall(obj.position, obj)
    if ok then
        return p
    end
    return nil
end

local function is_bush_material(name)
    return type(name) == "string" and name:find("bush", 1, true) ~= nil
end

-- Actor inventory first, else level.object_by_id.
function obj(id)
    if not id then
        return nil
    end
    local o = db and db.actor and db.actor.object_id and db.actor:object_id(id)
    if o then
        return o
    end
    if level and level.object_by_id then
        return level.object_by_id(id)
    end
    return nil
end

-- Map the SE lives on (l01_escape etc). Not the actor's current map.
function level_name(id)
    local se = id and xobject.se(id)
    local lid = se and xlevel.get_level_id(se)
    if not lid then
        return nil
    end
    local sim = alife()
    if not sim then
        return nil
    end
    local ok, name = pcall(sim.level_name, sim, lid)
    if ok then
        return name
    end
    return nil
end

function community(npc)
    if not npc then
        return nil
    end
    if xcreature and xcreature.community then
        local se = alife() and alife():object(npc:id())
        if se then
            local ok, c = pcall(xcreature.community, se)
            if ok and type(c) == "string" and c ~= "" then
                return c
            end
        end
    end
    if character_community then
        local ok, c = pcall(character_community, npc)
        if ok and type(c) == "string" and c ~= "" then
            return c
        end
    end
    local ok, c = pcall(npc.character_community, npc)
    if ok and type(c) == "string" and c ~= "" then
        return c
    end
    return nil
end

function npc_has_fov_pos(npc, pos, fov)
    if not (npc and pos) then
        return false
    end
    local deg = fov_deg(fov)
    if not deg then
        deg = DEFAULT_FOV_DEG
    end
    local ok_dir, dir = pcall(npc.direction, npc)
    local head = bone_pos(npc, BONES_HEAD)
    if not (ok_dir and dir and head) then
        return false
    end
    local dx = pos.x - head.x
    local dy = pos.y - head.y
    local dz = pos.z - head.z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
    if dist < 0.05 then
        return true
    end
    local inv = 1 / dist
    local dot = (dir.x * dx + dir.y * dy + dir.z * dz) * inv
    return dot >= cos_deg(deg)
end

function npc_has_fov_stalker(npc, stalker, fov)
    return npc_has_fov_pos(npc, bone_pos(stalker, BONES_CHEST), fov)
end

-- Engine RayPick. Reuses one pick + scratch vectors.
-- bush_pierce 0/nil = one ray (bush = wall). N = recast through N bushes.
-- pierce_see (10th, default false): also recast shoot-through / vis-transparent
-- when material_name is a non-empty string. Empty/missing material never pierces
-- (script_rq_result defaults shoot_factor to 0).
-- Hits beyond remaining are rejected (range).
-- returns: object, dist | false, dist (static) | nil (clear / fail)
function ray(ox, oy, oz, dx, dy, dz, range, ignore, bush_pierce, pierce_see)
    if not ray_pick or not range or range <= 0 then
        return nil
    end
    -- set_ignore_object only appends. New pick when ignore id changes.
    -- game_object has no __eq; compare ids.
    local ignore_id = obj_id(ignore)
    if not pick or ignore_id ~= pick_ignore_id then
        pick = ray_pick()
        pick_ignore_id = ignore_id
        if ignore then
            pick:set_ignore_object(ignore)
        end
    end
    local max_pierce = tonumber(bush_pierce) or 0
    if max_pierce < 0 then
        max_pierce = 0
    end
    pick:set_flags(LOOK_FLAGS)
    RAY_DIR:set(dx, dy, dz)
    local pierces = 0
    local remaining = range
    while remaining > 0 and pierces <= max_pierce do
        RAY_POS:set(ox, oy, oz)
        pick:set_position(RAY_POS)
        pick:set_direction(RAY_DIR)
        pick:set_range(remaining)
        local ok, hit = pcall(pick.query, pick)
        if not (ok and hit) then
            return nil
        end
        local hit_dist = pick:get_distance()
        if not hit_dist or hit_dist <= 0 or hit_dist > remaining then
            return nil
        end
        local obj = pick:get_object()
        if obj then
            return obj, hit_dist
        end
        local result = pick:get_result()
        local name = result and result.material_name
        local named = type(name) == "string" and name ~= ""
        local bush = named and is_bush_material(name)
        local see = false
        if pierce_see and named then
            local shoot = result.material_shoot_factor
            local vis = result.material_vis_transparency_factor
            if type(shoot) == "number" and shoot <= 0.001 then
                see = true
            elseif type(vis) == "number" and vis > 0.01 then
                see = true
            end
        end
        if not (bush or see) then
            return false, hit_dist
        end
        local step = hit_dist + LOOK_BUSH_STEP
        ox = ox + dx * step
        oy = oy + dy * step
        oz = oz + dz * step
        remaining = remaining - step
        pierces = pierces + 1
    end
    return false, 0
end

function npc_has_los_to_pos(npc, pos, fov)
    if not (npc and pos) then
        return false
    end
    if fov and not npc_has_fov_pos(npc, pos, fov) then
        return false
    end
    local head = bone_pos(npc, BONES_HEAD)
    if not head then
        return false
    end
    local dx = pos.x - head.x
    local dy = pos.y - head.y
    local dz = pos.z - head.z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
    if dist < 0.05 then
        return true
    end
    local inv = 1 / dist
    dx, dy, dz = dx * inv, dy * inv, dz * inv
    local block, hit_dist = ray(head.x, head.y, head.z, dx, dy, dz, dist, npc, BUSH_PIERCE)
    if block == nil then
        return true
    end
    if block == false then
        return hit_dist and hit_dist >= dist - 0.05
    end
    return false
end

function npc_has_los_to_stalker(npc, stalker, fov)
    if not (npc and stalker) then
        return false
    end
    local chest = bone_pos(stalker, BONES_CHEST)
    if not chest then
        return false
    end
    if fov and not npc_has_fov_pos(npc, chest, fov) then
        return false
    end
    local head = bone_pos(npc, BONES_HEAD)
    if not head then
        return false
    end
    local dx = chest.x - head.x
    local dy = chest.y - head.y
    local dz = chest.z - head.z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
    if dist < 0.05 then
        return true
    end
    local inv = 1 / dist
    dx, dy, dz = dx * inv, dy * inv, dz * inv
    local block, hit_dist = ray(head.x, head.y, head.z, dx, dy, dz, dist + 0.35, npc, BUSH_PIERCE)
    if block == nil then
        return true
    end
    if block == false then
        return hit_dist and hit_dist >= dist - 0.05
    end
    local ok, bid = pcall(block.id, block)
    local ok2, tid = pcall(stalker.id, stalker)
    return ok and ok2 and bid == tid
end

-- Clear path, static at the object, or hit on the object. Other object / short wall = false.
function has_los_to_object(from, obj, ignore)
    if not (from and obj) then
        return false
    end
    local ok_p, pos = pcall(obj.position, obj)
    if not (ok_p and pos) then
        return false
    end
    local dx = pos.x - from.x
    local dy = pos.y - from.y
    local dz = pos.z - from.z
    local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
    if dist < 0.05 then
        return true
    end
    local inv = 1 / dist
    dx, dy, dz = dx * inv, dy * inv, dz * inv
    local block, hit_dist = ray(from.x, from.y, from.z, dx, dy, dz, dist + 0.15, ignore, BUSH_PIERCE)
    if block == nil then
        return true
    end
    if block == false then
        return hit_dist and hit_dist >= dist - 0.05
    end
    local ok, bid = pcall(block.id, block)
    local ok2, tid = pcall(obj.id, obj)
    return ok and ok2 and bid == tid
end

local function dist_to_pos(npc, pos)
    return npc:position():distance_to(pos)
end

local function dist_between(a, b)
    return a:position():distance_to(b:position())
end

function get_stalkers_near_point(pos, range, faction)
    local out = {}
    if not (pos and range and db and db.storage) then
        return out
    end
    local actor_id = db.actor and db.actor:id()
    for id, st in pairs(db.storage) do
        local npc = st and st.object
        if npc and id ~= actor_id and IsStalker and IsStalker(npc) then
            local ok_alive, alive = pcall(npc.alive, npc)
            if ok_alive and alive then
                local ok_d, d = pcall(dist_to_pos, npc, pos)
                if ok_d and d <= range then
                    if not faction or community(npc) == faction then
                        out[#out + 1] = npc
                    end
                end
            end
        end
    end
    return out
end

function npc_is_in_combat(npc, range)
    if not npc then
        return false
    end
    range = range or DEFAULT_COMBAT_M
    local ok, enemy = pcall(npc.best_enemy, npc)
    if not (ok and enemy) then
        return false
    end
    local ok_alive, alive = pcall(enemy.alive, enemy)
    if not (ok_alive and alive) then
        return false
    end
    local ok_d, d = pcall(dist_between, npc, enemy)
    return ok_d and d <= range
end

-- GetAttitude sum. Combat / name color / leader line must all use this.
function npc_general_goodwill(npc, who)
    who = who or (db and db.actor)
    if not (npc and who) then
        return nil
    end
    local ok, gw = pcall(npc.general_goodwill, npc, who)
    if ok and type(gw) == "number" then
        return gw
    end
    return nil
end

-- Engine GetRelationType bands: < -150 enemy, < 400 neutral, else friend.
function npc_relation_band(npc, who)
    local gw = npc_general_goodwill(npc, who)
    if gw == nil then
        return nil
    end
    if gw < -150 then
        return "enemy"
    end
    if gw >= 400 then
        return "friend"
    end
    return "neutral"
end
