-- Live combat math follows CQC grok_bo (higher load order than GBOOBS):
-- combat AP = (ini k_ap x10 + sniper 0.05) x ap_scale x barrel / range_factor
--   x 0.80 x difficulty x silencer (1.07 when equipped / integrated, if MCM on).
-- Bone mults from CQC stalker_damage. Difficulty from CQC/GAMMA diff_game type.
-- Mutant path has no silencer in CQC; species/weak-spot mults are rule-of-thumb only.
local BONE_DMG_TORSO = 0.9    -- bip01_spine
local BONE_DMG_HEAD  = 3.65   -- bip01_head
local BALLISTIC_BONUS = 1.1
local K_AP_COMBAT_SCALE = 10  -- CQC: ini k_ap * 10 for combat
local AP_TAIL = 0.80          -- CQC post-grouping AP adjustment
local SILENCER_BOOST = 1.07
-- CQC: added to (ini k_ap * 10), not to raw LTX. Display AP column = k_ap*1000 + 5.
local SNIPER_AP_BONUS = 0.05
-- CQC: armor chips by combat_ap x 0.60; soft-pen if ap still beats chipped armor.
local ARMOR_CHIP_FRAC = 0.60
-- CQC residual (hard fail): 0.0025 x power x hit_frac x random(25,100) / hp_ammo_mult.
-- Tooltip uses the mid random (62.5).
local HARD_FAIL_SCALE = 0.0025 * 62.5
-- CQC hp_rounds table (named hp_ammo_mult here): divisor on hard-fail residual.
