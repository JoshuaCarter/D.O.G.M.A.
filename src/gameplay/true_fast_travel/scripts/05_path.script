-- True Fast Travel MVP: ground snap + game-graph helpers for destination resolve.
-- Pathfinding is tft_nav_mesh_build_path (11_coarse_nav). No ambush / preview / dots.

local tft = _G.tft

local function valid_lvid(lvid)
	return lvid and lvid ~= tft_invalid_lvid and lvid ~= -1
end

local function horizontal_dist(a, b)
	if not (a and b) then return nil end
	local dx = a.x - b.x
	local dz = a.z - b.z
	return math.sqrt(dx * dx + dz * dz)
end

local function lvid_accessible(lvid)
	if not valid_lvid(lvid) then return false end
	if level.is_accessible_vertex_id then
		local ok, acc = pcall(function() return level.is_accessible_vertex_id(lvid) end)
		if ok and not acc then return false end
	end
	return true
end

local function lvid_ground_pos(lvid)
	if not (valid_lvid(lvid) and level and level.vertex_position) then return nil, nil end
	if not lvid_accessible(lvid) then return nil, nil end
	local ok, snapped = pcall(function() return level.vertex_position(lvid) end)
	if not (ok and snapped and snapped.x) then return nil, nil end
	return vector():set(snapped.x, snapped.y + 0.15, snapped.z), lvid
end

local DFT_RAY_DOWN = vector():set(0, -1, 0)

local function raycast_down_y(x, origin_y, z, range)
	if not (ray_pick and rq_target and x and origin_y and z and range and range > 0) then
		return nil
	end
	local flags = bit.bor(rq_target.rqtStatic or 2, rq_target.rqtObstacle or 8)
	local origin = vector():set(x, origin_y, z)
	local ok, dist = pcall(function()
		local pick = ray_pick(origin, DFT_RAY_DOWN, range, flags, nil)
		if not pick then return nil end
		pick:query()
		local d = pick:get_distance()
		if not d or d <= 0.05 or d >= range * 0.999 then return nil end
		return d
	end)
	if not ok or not dist then return nil end
	return origin_y - dist
end

local function ray_snap_ground_pos(pos, opts)
	opts = opts or {}
	if not (pos and pos.x and pos.z) then return nil, nil end
	local anchor = opts.anchor or pos
	local max_drift_m = opts.max_drift_m
	local ref_y = pos.y or anchor.y or 0
	local x, z = pos.x, pos.z
	local ground_y = raycast_down_y(x, ref_y + (opts.head_m or 1.0), z, opts.head_range_m or 100.0)
	if not ground_y then
		ground_y = raycast_down_y(x, ref_y + (opts.high_m or 100.0), z, opts.high_range_m or 100.0)
	end
	if not ground_y then return nil, nil end
	local result = vector():set(x, ground_y + 0.15, z)
	if anchor and max_drift_m then
		local drift = horizontal_dist(result, anchor)
		if drift and drift > max_drift_m then return nil, nil end
	end
	local lvid = nil
	if level and level.vertex_id then
		local ok, v = pcall(function() return level.vertex_id(result) end)
		if ok and valid_lvid(v) then lvid = v end
	end
	return result, lvid
end

local function find_ground_pos(pos, lvid, gvid, opts)
	opts = opts or {}
	local anchor = opts.anchor or pos
	local max_drift_m = opts.max_drift_m

	local function finish(result_pos, result_lvid)
		if not (result_pos and anchor and max_drift_m) then
			return result_pos, result_lvid
		end
		local drift = (_G.tft_pos_drift and _G.tft_pos_drift(result_pos, anchor))
			or result_pos:distance_to(anchor)
		if drift > max_drift_m then
			return vector():set(anchor.x, anchor.y, anchor.z), result_lvid
		end
		return result_pos, result_lvid
	end

	if not pos then
		if db and db.actor then return db.actor:position(), nil end
		return nil, nil
	end
	if not level then return finish(vector():set(pos.x, pos.y, pos.z), lvid) end

	if (opts.ray_first or opts.local_only) and ray_pick and rq_target then
		local ray_pos, ray_lvid = ray_snap_ground_pos(pos, opts)
		if ray_pos then return finish(ray_pos, ray_lvid or lvid) end
	end

	if lvid then
		local p, lv = lvid_ground_pos(lvid)
		if p then return finish(p, lv) end
	end

	if gvid and tft_graph_vertex_target then
		local graph = tft_graph_vertex_target(gvid)
		if graph and graph.lvid then
			local p, lv = lvid_ground_pos(graph.lvid)
			if p then return finish(p, lv) end
		end
	end

	local ok_vid, vid = pcall(function() return level.vertex_id(pos) end)
	if ok_vid and valid_lvid(vid) then
		local p, lv = lvid_ground_pos(vid)
		if p then return finish(p, lv) end
	end

	local ref_y = pos.y
	local test = vector():set(pos.x, ref_y, pos.z)
	local xz_offsets = {
		{ 0, 0 }, { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 },
		{ 2, 0 }, { -2, 0 }, { 0, 2 }, { 0, -2 },
	}
	for i = 0, 12 do
		local y = ref_y + (i % 2 == 0 and i or -i) * 0.5
		for o = 1, #xz_offsets do
			test:set(pos.x + xz_offsets[o][1], y, pos.z + xz_offsets[o][2])
			local ok, v = pcall(function() return level.vertex_id(test) end)
			if ok and valid_lvid(v) then
				local p, lv = lvid_ground_pos(v)
				if p then return finish(p, lv) end
			end
		end
	end

	return finish(vector():set(pos.x, pos.y, pos.z), lvid)
end

local function ensure_level_graph_cache()
	local lvl_id = tft_actor_level_id and tft_actor_level_id()
	local lvl_name = (level and level.name) and level.name() or nil
	if tft.graph_cache and tft.graph_cache_level == lvl_id and tft.graph_cache_name == lvl_name then
		return
	end

	tft.graph_cache = {}
	tft.graph_lvid_map = {}
	tft.graph_cache_level = lvl_id
	tft.graph_cache_name = lvl_name

	if not (lvl_id and game_graph) then return end
	local gg = game_graph()
	if not (gg and gg.valid_vertex_id and gg.vertex) then return end

	for gvid = 0, 65534 do
		if gg:valid_vertex_id(gvid) then
			local ok, gv = pcall(function() return gg:vertex(gvid) end)
			if ok and gv then
				local ok_l, lid = pcall(function() return gv:level_id() end)
				if ok_l and lid == lvl_id then
					local ok_p, gpos = pcall(function() return gv:level_point() end)
					local ok_lv, lv = pcall(function() return gv:level_vertex_id() end)
					if ok_p and gpos and gpos.x and ok_lv and lv and lv ~= tft_invalid_lvid then
						tft.graph_cache[#tft.graph_cache + 1] = {
							gvid = gvid,
							lvid = lv,
							pos = vector():set(gpos.x, gpos.y, gpos.z),
						}
						tft.graph_lvid_map[lv] = gvid
					end
				end
			end
		end
	end
end

local function graph_nearest_gvid(pos, max_m)
	if not pos then return nil end
	ensure_level_graph_cache()
	max_m = max_m or 999999
	local best_gvid, best_off = nil, max_m + 1
	for i = 1, #(tft.graph_cache or {}) do
		local node = tft.graph_cache[i]
		local off = horizontal_dist(pos, node.pos) or pos:distance_to(node.pos)
		if off < best_off then
			best_off = off
			best_gvid = node.gvid
		end
	end
	if best_gvid and best_off <= max_m then return best_gvid end
	return nil
end

local function graph_gvid_from_lvid(lvid)
	if not lvid or lvid == tft_invalid_lvid then return nil end
	ensure_level_graph_cache()
	return tft.graph_lvid_map and tft.graph_lvid_map[lvid]
end

local function report_map_click(map_table, hint)
	if not map_table then return end
	if map_table.pos and map_table.pos.x then
		tft.last_map_click_pos = vector():set(map_table.pos.x, map_table.pos.y or 0, map_table.pos.z)
	end
end

local function lerp_pos(p1, p2, ratio, out)
	if not (p1 and p2 and out) then return end
	out:set(
		p1.x + (p2.x - p1.x) * ratio,
		p1.y + (p2.y - p1.y) * ratio,
		p1.z + (p2.z - p1.z) * ratio
	)
	return out
end

local function remove_path_spots(obj_id)
	if not obj_id then return end
	pcall(function()
		local spots = (tft_path and tft_path.dots) or {}
		for i = 1, #spots do
			local spot = spots[i]
			if level.map_has_object_spot(obj_id, spot) ~= 0 then
				level.map_remove_object_spot(obj_id, spot)
			end
		end
	end)
end

local function cleanup_dots()
	for _, id in pairs(tft.dot_ids or {}) do
		remove_path_spots(id)
		pcall(function()
			if level.map_has_object_spot(id, "primary_object") ~= 0 then
				level.map_remove_object_spot(id, "primary_object")
			end
			if level.map_has_object_spot(id, "green_location") ~= 0 then
				level.map_remove_object_spot(id, "green_location")
			end
		end)
		local obj = xobject.se(id)
		if obj then xobject.release(obj) end
	end
	tft.dot_ids = {}
	tft.dot_done = {}
	tft.dot_path_ratio = {}
	tft.dot_positions = {}
	tft.dot_count = 0
end

local function freeze_buried_dot(obj_id, attempts_left)
	attempts_left = attempts_left or 8
	local obj = xobject.go(obj_id)
	if obj then
		pcall(function()
			local shell = obj:get_physics_shell()
			if shell then
				shell:set_active(false)
				shell:set_ignore_gravity(true)
			end
		end)
		return
	end
	if attempts_left <= 0 then return end
	CreateTimeEvent("tft", "freeze_dot_" .. tostring(obj_id), 0.2, function()
		freeze_buried_dot(obj_id, attempts_left - 1)
		return true
	end)
end

local function ensure_path_dot(index, as_pending, spot_override)
	if tft.dot_ids[index] then return end
	local dp = tft.dot_positions[index]
	if not (dp and db.actor) then return end
	local lvid = level.vertex_id(dp)
	if not lvid or lvid == tft_invalid_lvid or lvid == -1 then
		lvid = db.actor:level_vertex_id()
	end
	local buried = vector():set(dp.x, dp.y - ((tft_path and tft_path.dot_underground_offset_m) or 1000), dp.z)
	local se = alife_create("device_pda", buried, lvid, db.actor:game_vertex_id())
	if not se then return end
	tft.dot_ids[index] = se.id
	local spot = spot_override
		or (as_pending and tft_path.dot_spot_pending or tft_path.dot_spot)
	pcall(level.map_add_object_spot_ser, se.id, spot, "")
	freeze_buried_dot(se.id)
end

local function build_preview_markers(chain, raw_chain)
	local markers = {}
	if not chain or #chain < 2 then return markers end
	local edge_sp = (tft_path and tft_path.preview_edge_spacing_m) or 5
	local max_count = (tft_path and tft_path.dot_max_count) or 1000
	for seg = 1, #chain - 1 do
		local a, b = chain[seg], chain[seg + 1]
		local seg_len = (tft_distance_pda and tft_distance_pda(a, b)) or a:distance_to(b)
		if seg_len > 0.5 then
			local along = edge_sp
			while along < seg_len and #markers < max_count do
				local interp = vector()
				lerp_pos(a, b, along / seg_len, interp)
				markers[#markers + 1] = {
					pos = vector():set(interp.x, interp.y + 0.1, interp.z),
					spot = tft_path.dot_spot_debug_edge,
				}
				along = along + edge_sp
			end
		end
	end
	if raw_chain and #raw_chain > 2 then
		for i = 2, #raw_chain - 1 do
			if #markers < max_count then
				local p = raw_chain[i]
				markers[#markers + 1] = {
					pos = vector():set(p.x, p.y + 0.1, p.z),
					spot = tft_path.dot_spot_debug_vertex,
				}
			end
		end
	end
	return markers
end

local function path_preview_enabled()
	local cfg = _G.tft_config
	return cfg and cfg.path_preview == true
end

local function clear_path_preview()
	if not (tft.is_path_preview or next(tft.dot_ids or {})) then return end
	cleanup_dots()
	tft.is_path_preview = false
	tft.path_preview_id = nil
end

local function preview_eligible(id, se_obj, ln)
	if tft_is_pda_transition and tft_is_pda_transition(id, se_obj) then
		return tft_object_on_loaded_level and tft_object_on_loaded_level(se_obj), true
	end
	if tft_is_campfire and tft_is_campfire(id, se_obj) and not (tft_is_cross_zone_destination and tft_is_cross_zone_destination(se_obj, ln)) then
		return true, false
	end
	if tft_is_base and tft_is_base(id, se_obj) and not (tft_is_cross_zone_destination and tft_is_cross_zone_destination(se_obj, ln)) then
		return true, false
	end
	return false, false
end

local function build_path_preview(id, is_lc)
	if tft.is_traveling then return end
	if not path_preview_enabled() then return end
	if not (db.actor and id) then return end

	cleanup_dots()
	tft.is_path_preview = true
	tft.path_preview_id = id

	local target = tft_resolve_travel_target(id, tft.last_menu_target_ln, tft.last_map_click_pos)
	if not target or not target.pos then
		tft.is_path_preview = false
		tft.path_preview_id = nil
		return
	end

	local start = db.actor:position()
	local dest = target.pos
	local dest_key = _G.tft_nav_mesh_dest_anchor_key and _G.tft_nav_mesh_dest_anchor_key(id) or nil
	local dist = (tft_distance_pda and tft_distance_pda(start, dest)) or start:distance_to(dest)
	if dist < 40 and not is_lc then
		tft_log("path preview: too close (%.0fm)", dist)
		tft.is_path_preview = false
		tft.path_preview_id = nil
		return
	end

	if not _G.tft_nav_mesh_build_path then
		tft.is_path_preview = false
		tft.path_preview_id = nil
		return
	end

	local ok, chain, is_vertex, path_len, meta = pcall(_G.tft_nav_mesh_build_path, start, dest, dest_key)
	if not ok or not chain or #chain < 2 then
		tft_log("path preview: nav mesh path failed (%.0fm straight)", dist)
		dogma.console.say(string.format("true fast travel: path failed (%.0fm straight)", dist), "yellow")
		tft.is_path_preview = false
		tft.path_preview_id = nil
		return
	end

	if tft.menu_open_seq then
		tft.menu_path_cache = {
			seq = tft.menu_open_seq,
			id = id,
			chain = chain,
			is_vertex = is_vertex,
			path_len = path_len,
			raw_chain = chain,
			meta = meta,
		}
	end

	local markers = build_preview_markers(chain, chain)
	tft.dot_positions = {}
	for i, m in ipairs(markers) do
		tft.dot_positions[i] = m.pos
	end
	tft.dot_count = #markers
	tft_log("path preview: %d waypoints, %d markers (path %.0fm, straight %.0fm)",
		#chain, #markers, path_len or dist, dist)
	dogma.console.say(string.format(
		"true fast travel: path found %d pts %.0fm (straight %.0fm)",
		#chain, path_len or dist, dist
	), "blue")

	for i = 1, tft.dot_count do
		local spot = markers[i] and markers[i].spot or tft_path.dot_spot_debug_edge
		ensure_path_dot(i, true, spot)
	end
end

do
	_G.tft_find_ground_pos = find_ground_pos
	_G.tft_horizontal_dist = horizontal_dist
	_G.tft_graph_nearest_gvid = graph_nearest_gvid
	_G.tft_graph_gvid_from_lvid = graph_gvid_from_lvid
	_G.tft_report_map_click = report_map_click
	_G.tft_cleanup_dots = cleanup_dots
	_G.tft_remove_path_spots = remove_path_spots
	_G.tft_ensure_path_dot = ensure_path_dot
	_G.tft_clear_path_preview = clear_path_preview
	_G.tft_build_path_preview = build_path_preview
	_G.tft_preview_eligible = preview_eligible
	_G.tft_purge_stuck_dot_pdas = function() end
	_G.tft_clear_ambush_range_circle = function() end
	_G.tft_is_registry_transition_door = function() return false end
	_G.tft_resolve_menu_spot_from_click = function(id, ln) return id, ln end
	printf("[dogma_gameplay_true_fast_travel] MVP path helpers loaded")
end
