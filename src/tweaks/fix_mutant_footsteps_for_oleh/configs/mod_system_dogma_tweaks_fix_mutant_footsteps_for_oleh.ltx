; Restore Oleh Misc mutant material wiring after Dark Signal clobbers
; configs/mod_system_mutant_sounds_oleh.ltx (same filename, vocals-only).
; Banks/pairs/sounds still come from Oleh Misc (and optionally Oleh NPC Footsteps).
; Dark Signal keeps covering vanilla medium / hoof / large for anything left unmapped.

; --- rodent (silent steps in Oleh pairs) ---
![m_rat_e]
material                = creatures\rodent

![m_tushkano_e]
material                = creatures\rodent

; --- small ---
![m_dog_e]
material				= creatures\small

![m_pseudodog_e]
material				= creatures\small

![cat_test]
material				= creatures\small

![m_karlik_e]
material				= creatures\small
radiation_sound         = $no_sound

; --- fast ---
![m_snork_e]
material                = creatures\fast
radiation_max_distance  = 0
radiation_sound         = $no_sound

![m_lurker_e]
material                = creatures\fast

![m_bloodsucker_e]
material                = creatures\fast

![fracture_normal]
material                = creatures\fast

; --- chimera ---
![m_chimera_e]
material                = creatures\chimera

![chimera_strong4]
radiation_max_distance  = 0

![zombie_blind]
radiation_sound         = $no_sound
radiation_max_distance  = 0

![m_controller_e]
radiation_sound         = $no_sound
radiation_max_distance  = 0

![m_burer_e]
material                = creatures\chimera ;creatures\medium
psy_sound               = $no_sound
radiation_max_distance  = 0
radiation_sound         = $no_sound

![m_poltergeist_e]
radiation_sound         = $no_sound

![m_poltergeist_normal_flame]
radiation_sound         = $no_sound

![m_gigant_e]
radiation_sound         = $no_sound
sound_threaten_hit		= monsters\giant\giant_slam

![gigant_jumper]
radiation_sound         = $no_sound
sound_threaten_hit		= monsters\giant\giant_slam

; Chimera: fewer step triggers so the chimera bank does not machine-gun.
![m_chimera_step_params]
stand_walk_fwd_0 		=   1,    0.53,    1.0,    0.01,    0.7,   0.53,    0.7,    0.01,    1.0
stand_walk_fwd_dmg_0 	=   1,    0.63,    1.0,    0.96,    0.7,   0.36,    0.7,    0.97,    0.5
stand_run_fwd_0	 		=   2,    0.15,    1.0,    0.25,    0.6,   0.01,    0.6,    0.90,    1.0
stand_run_dmg_0	 		=   2,    0.15,    1.0,    0.40,    0.6,   0.01,    0.6,    0.01,    0.0
