-- dorn_mcm_banner:begin (managed by sync-dorn-common.sh)
local DORN_COMMON_VERSION = "dorn_common"
local function dorn_mcm()
	return _G.dorn_mcm
end
-- dorn_mcm_banner:end

local function wads_track(id, hint)
	return {
		id = id,
		type = "track",
		val = 2,
		min = 0,
		max = 50,
		step = 5,
		def = 0,
		hint = hint,
	}
end

local function category_wads(cat)
	return {
		{ id = "line_wads_" .. cat, type = "line" },
		{
			id = "wads_" .. cat .. "_title",
			type = "title",
			text = "ui_mcm_dorn_free_zoom_wads_" .. cat .. "_title",
		},
		wads_track("wads_" .. cat .. "_irons", "dorn_free_zoom_wads_" .. cat .. "_irons"),
		wads_track("wads_" .. cat .. "_sight", "dorn_free_zoom_wads_" .. cat .. "_sight"),
		wads_track("wads_" .. cat .. "_scope", "dorn_free_zoom_wads_" .. cat .. "_scope"),
	}
end

function on_mcm_load()
	local MCM = dorn_mcm()
	local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
	local ads_gr = {
		{
			id = "ads_description",
			type = "desc",
			text = "ui_mcm_dorn_free_zoom_ads_description",
		},
		{
			id = "enabled",
			type = "check",
			val = 1,
			def = true,
			hint = "dorn_free_zoom_ads_enabled",
		},
		{ id = "line_ads_world", type = "line" },
		{
			id = "ads_world_header",
			type = "title",
			text = "ui_mcm_dorn_free_zoom_ads_world_header",
		},
		{
			id = "ads_zoom",
			type = "track",
			val = 2,
			min = 0,
			max = 50,
			step = 1,
			def = 15,
			hint = "dorn_free_zoom_ads_zoom",
		},
		{
			id = "exit_ads_clears_free",
			type = "check",
			val = 1,
			def = true,
			hint = "dorn_free_zoom_exit_ads_clears_free",
		},
		{
			id = "reload_clears_free",
			type = "check",
			val = 1,
			def = true,
			hint = "dorn_free_zoom_reload_clears_free",
		},
		{ id = "line_wads_keys", type = "line" },
