--[[
    Vendored xlibs (Damian Sirbu). Use via dogma.xlibs.xobject, not xobject.

    Copies still write xconst / xobject. We do not keep those on _G.
    Some copies (xcombat) put the API on an inner table named after
    the stock module. Export that. Do not stamp a script's own name
    onto itself or that inner table is gone.
]]

local M = getfenv(1)
local saved = {}
local scripts = {}

local function api_of(script, name)
    if type(script) ~= "table" then
        return script
    end
    local inner = rawget(script, name)
    if type(inner) == "table" then
        return inner
    end
    return script
end

local function take(name, script)
    if saved[name] == nil then
        saved[name] = { rawget(_G, name) }
    end
    local api = api_of(script, name)
    rawset(_G, name, api)
    M[name] = api
    scripts[name] = script
end

take("xconst", __dogma_xconst)
take("xstring", __dogma_xstring)
take("xtable", __dogma_xtable)
take("xmath", __dogma_xmath)
take("xfs", __dogma_xfs)
take("xltx", __dogma_xltx)
take("xtime", __dogma_xtime)
take("xslice", __dogma_xslice)
take("xtrace", __dogma_xtrace)
take("xttltable", __dogma_xttltable)
take("xlog", __dogma_xlog)
take("xevent", __dogma_xevent)
take("xbus", __dogma_xbus)
take("xpp", __dogma_xpp)
take("xprofiler", __dogma_xprofiler)
take("xinspect", __dogma_xinspect)
take("xprops", __dogma_xprops)
take("xchange", __dogma_xchange)
take("xmcm", __dogma_xmcm)
take("xobject", __dogma_xobject)
take("xlevel", __dogma_xlevel)
take("xinventory", __dogma_xinventory)
take("xcreature", __dogma_xcreature)
take("xactor", __dogma_xactor)
take("xdata", __dogma_xdata)
take("xsquad", __dogma_xsquad)
take("xsmart", __dogma_xsmart)
take("xsmart_spawn", __dogma_xsmart_spawn)
take("xstash", __dogma_xstash)
take("xpda", __dogma_xpda)
take("xsound", __dogma_xsound)
take("xcombat", __dogma_xcombat)

for name, script in pairs(scripts) do
    if type(script) == "table" then
        for other, api in pairs(M) do
            if other ~= name and type(api) == "table" and type(other) == "string" and other:sub(1, 1) == "x" then
                rawset(script, other, api)
            end
        end
    end
end

for name, slot in pairs(saved) do
    rawset(_G, name, slot[1])
end
