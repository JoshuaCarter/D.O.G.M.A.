--[[
	_dogma.script - common index (wires __dogma_* private impls).

	Call sites use dogma.* via dogma.script (re-exports this module).
	MCM gather only loads *mcm.script, so __dogma_mcm / __dogma_key_mirror_mcm
	still seed dogma.mcm / dogma.keys for that path.
]]

mcm = __dogma_mcm
dbg = __dogma_dbg
sys = __dogma_sys
keys = __dogma_key_mirror_mcm
input = __dogma_input
xlibs = __dogma_xlibs
console_once = __dogma_console_once
sfx_prefetch = __dogma_sfx_prefetch
item_stats = __dogma_item_stats.exports

--- Wire sys→mcm/dbg; optionally reset per-mod debug state.
function load(mod_id)
	sys.set_deps(mcm, dbg)
	if mod_id then
		sys.reset_mod(mod_id)
		dbg.clear_source(mod_id)
	end
	return getfenv(1)
end
