--[[
	Campfire heal (Body Health System + main HP).

	Within 2m of a lit campfire. Optional combat pause (MCM, default off):
	if on, no heal while a stalker/monster has the actor as best_enemy.
	Does NOT apply temporary limb HP (medkits etc. still do).
	No heal caps.

	Two independent rates (MCM, seconds for a 20% step):
	  Body: 20% / body_sec  → applied as +1% every (body_sec/20) seconds.
	  Limbs: 20% / limb_sec → every limb_sec, convert 1 BHS point temp→perm
	         on whichever limb currently has the lowest permanent HP and still
	         has temp (re-picked every tick; never sticky).

	Body and limb timers run asynchronously.
	Optional orange PPE while body HP < 100% and a heal is running.
	Disable other campfire heal mods to avoid stacking.
]]

local CONFIG = _G.dogma_game_campfire_healing_conf

local LIMBS = { "head", "torso", "rightarm", "leftarm", "rightleg", "leftleg" }
local RANGE_SQR = 2 * 2
local BODY_HEAL_PT = 0.01 -- 1% of body bar
local RATE_PCT = 20 -- sliders mean "this % every X seconds"

local next_body_tick = 0
local next_limb_tick = 0
local next_state_tick = 0
local cached_body_sec = 30
local cached_limb_sec = 20
local cached_pause_in_combat = false
local cached_fx_enable = true
local cached_fx_intensity = 0.5
local can_heal = false
local ppe_target = 0
local ppe_factor = 0
local ppe_active = false
local last_ppe_ms = 0
local combat_cache_until = 0
local combat_cache_value = false
local COMBAT_CACHE_MS = 500
local STATE_MS = 250
local PPE_FADE_MS = 500

-- Cached live BHS tables (same refs Medik reads).
local bhs_health = nil
local bhs_timedhp = nil
local bhs_maxhp = nil

local function clamp_sec(sec, min_sec, max_sec, fallback)
	sec = tonumber(sec) or fallback
	if sec < min_sec then
		sec = min_sec
	elseif sec > max_sec then
		sec = max_sec
	end
	return sec
end

local function refresh_settings()
	local body_sec = dogma.mcm.int(CONFIG.MOD_ID, "body_sec", CONFIG.DEFAULTS.body_sec)
	local limb_sec = dogma.mcm.int(CONFIG.MOD_ID, "limb_sec", CONFIG.DEFAULTS.limb_sec)
	cached_body_sec = clamp_sec(body_sec, 30, 100, 30)
	cached_limb_sec = clamp_sec(limb_sec, 20, 100, 20)
	cached_pause_in_combat = dogma.mcm.bool(CONFIG.MOD_ID, "pause_in_combat", CONFIG.DEFAULTS.pause_in_combat)
	cached_fx_enable = dogma.mcm.bool(CONFIG.MOD_ID, "fx_enable", CONFIG.DEFAULTS.fx_enable)
	local fx_intensity = dogma.mcm.float(CONFIG.MOD_ID, "fx_intensity", CONFIG.DEFAULTS.fx_intensity)
	cached_fx_intensity = dogma.math.clamp01(tonumber(fx_intensity) or CONFIG.DEFAULTS.fx_intensity)
	if not cached_fx_enable then
		ppe_target = 0
	end
end

-- 20% every body_sec → 1% every body_sec/20.
local function body_interval_ms()
	return math.floor((cached_body_sec / RATE_PCT) * 1000 + 1e-6)
end

-- 20% every limb_sec → one BHS point (~20% on arms/legs) every limb_sec.
local function limb_interval_ms()
	return math.floor(cached_limb_sec * 1000 + 1e-6)
end

local function near_lit_campfire()
	if not (db.actor and bind_campfire and bind_campfire.campfires_all) then
		return false
	end
	local pos = db.actor:position()
	for _, binder in pairs(bind_campfire.campfires_all) do
		if binder and binder.campfire and binder.campfire:is_on() and binder.object then
			if pos:distance_to_sqr(binder.object:position()) <= RANGE_SQR then
				return true
			end
		end
	end
	return false
end

-- True when any online stalker/monster has the actor as best_enemy (actively engaging).
-- Cached briefly: full db.storage scan is expensive and only needed while camping.
local function in_combat()
	local actor = db.actor
	if not (actor and db.storage) then
		return false
	end
	local now = time_global()
	if now < combat_cache_until then
		return combat_cache_value
	end
	dogma.perf.start("campfire_healing", "in_combat")
	local actor_id = actor:id()
	local engaged = false
	for id, _ in pairs(db.storage) do
		if id ~= actor_id then
			local npc = level.object_by_id(id)
			if npc then
				local is_creature = false
				pcall(function()
					is_creature = IsStalker(npc) or IsMonster(npc)
				end)
				if is_creature then
					local ok_alive, alive = pcall(function()
						return npc:alive()
					end)
					if ok_alive and alive then
						local ok_e, enemy = pcall(function()
							return npc:best_enemy()
						end)
						if ok_e and enemy then
							local ok_id, eid = pcall(function()
								return enemy:id()
							end)
							if ok_id and eid == actor_id then
								engaged = true
								break
							end
						end
					end
				end
			end
		end
	end
	dogma.perf.stop()
	combat_cache_value = engaged
	combat_cache_until = now + COMBAT_CACHE_MS
	return engaged
end

local function tables_are_bhs(health, timedhp, maxhp)
	return type(health) == "table"
		and type(timedhp) == "table"
		and type(maxhp) == "table"
		and health.head ~= nil
		and timedhp.head ~= nil
		and maxhp.head ~= nil
		and tonumber(maxhp.head) ~= nil
end

local function dig_bhs_from_fn(fn, depth)
	if depth > 5 or type(fn) ~= "function" then
		return nil
	end
	if debug.getfenv then
		local env = debug.getfenv(fn)
		if tables_are_bhs(env.health, env.timedhp, env.maxhp) then
			return env.health, env.timedhp, env.maxhp
		end
	end
	local i = 1
	while true do
		local name, val = debug.getupvalue(fn, i)
		if not name then
			break
		end
		if type(val) == "function" then
			local h, t, m = dig_bhs_from_fn(val, depth + 1)
			if h then
				return h, t, m
			end
		elseif name == "health" and type(val) == "table" and val.head ~= nil then
			local timedhp, maxhp
			local j = 1
			while true do
				local n2, v2 = debug.getupvalue(fn, j)
				if not n2 then
					break
				end
				if n2 == "timedhp" then
					timedhp = v2
				elseif n2 == "maxhp" then
					maxhp = v2
				end
				j = j + 1
			end
			if tables_are_bhs(val, timedhp, maxhp) then
				return val, timedhp, maxhp
			end
		end
		i = i + 1
	end
	return nil
end

local function resolve_bhs_tables()
	if tables_are_bhs(bhs_health, bhs_timedhp, bhs_maxhp) then
		return bhs_health, bhs_timedhp, bhs_maxhp
	end

	local mod = _G["zzz_player_injuries"] or zzz_player_injuries
	if type(mod) == "table" then
		if tables_are_bhs(mod.health, mod.timedhp, mod.maxhp) then
			bhs_health, bhs_timedhp, bhs_maxhp = mod.health, mod.timedhp, mod.maxhp
			return bhs_health, bhs_timedhp, bhs_maxhp
		end
		if type(mod.actor_on_update) == "function" then
			local h, t, m = dig_bhs_from_fn(mod.actor_on_update, 0)
			if h then
				bhs_health, bhs_timedhp, bhs_maxhp = h, t, m
				mod.health = h
				mod.timedhp = t
				mod.maxhp = m
				return h, t, m
			end
		end
	end
	return nil
end

local function save_limb(key, health, timedhp)
	utils_obj.save_var(db.actor, "health." .. key, health[key])
	utils_obj.save_var(db.actor, "timedhp." .. key, timedhp[key])
end

local function limb_can_convert(health, timedhp, maxhp, key)
	local hp = tonumber(health[key])
	local max = tonumber(maxhp[key])
	local temp = tonumber(timedhp[key])
	if hp == nil or max == nil or temp == nil or max <= 0 then
		return false
	end
	local perm = hp - temp
	return temp > 0 and perm < max
end

local function heal_limb_perm(health, timedhp, maxhp, key)
	local hp = tonumber(health[key])
	local max = tonumber(maxhp[key])
	local temp = tonumber(timedhp[key])
	if hp == nil or max == nil or temp == nil or max <= 0 then
		return false
	end
	local perm = hp - temp
	if temp <= 0 or perm >= max then
		return false
	end
	timedhp[key] = temp - 1
	return true
end

-- Re-scan every limb tick (no sticky target): lowest permanent HP among
-- limbs that still have convertible temp.
local function pick_lowest_temp_limb(health, timedhp, maxhp)
	local best_key = nil
	local best_perm = nil
	for i = 1, #LIMBS do
		local key = LIMBS[i]
		if limb_can_convert(health, timedhp, maxhp, key) then
			local hp = tonumber(health[key])
			local temp = tonumber(timedhp[key])
			local perm = hp - temp
			if best_key == nil or perm < best_perm then
				best_key = key
				best_perm = perm
			end
		end
	end
	return best_key
end

local function heal_body_one_pct()
	local actor = db.actor
	if not actor or actor.health >= 1 then
		return false
	end
	local amt = math.min(BODY_HEAL_PT, 1 - actor.health)
	if amt <= 0 then
		return false
	end
	actor:change_health(amt)
	return true
end

local function tick_body()
	heal_body_one_pct()
end

local function tick_limb()
	local health, timedhp, maxhp = resolve_bhs_tables()
	if not health then
		return
	end
	local key = pick_lowest_temp_limb(health, timedhp, maxhp)
	if not key then
		return
	end
	if heal_limb_perm(health, timedhp, maxhp, key) then
		save_limb(key, health, timedhp)
		dogma.console.say(string.format("campfire: limb %s temp->perm +1", key), "blue")
	end
end

local function set_ppe(factor)
	local spec = CONFIG.PPE
	if not (spec and level) then
		return false
	end
	if factor <= 0 then
		if ppe_active then
			level.remove_pp_effector(spec.id)
		end
		return false
	end
	if not ppe_active then
		level.add_pp_effector(spec.name, spec.id, true)
	end
	level.set_pp_effector_factor(spec.id, factor)
	return true
end

local function clear_ppe()
	if level and CONFIG.PPE then
		level.remove_pp_effector(CONFIG.PPE.id)
	end
	ppe_active = false
	ppe_factor = 0
	ppe_target = 0
	last_ppe_ms = 0
end

local function approach(cur, dest, dt_ms, fade_ms)
	local max_delta = dt_ms / fade_ms
	local diff = dest - cur
	if diff > max_delta then
		return cur + max_delta
	end
	if diff < -max_delta then
		return cur - max_delta
	end
	return dest
end

local function refresh_heal_state()
	can_heal = false
	ppe_target = 0
	if not db.actor then
		return
	end
	if not near_lit_campfire() then
		return
	end
	if cached_pause_in_combat and in_combat() then
		return
	end
	can_heal = true
	if cached_fx_enable and db.actor.health < 1 then
		ppe_target = cached_fx_intensity
	end
end

local function tick_ppe(now)
	if last_ppe_ms <= 0 then
		last_ppe_ms = now
	end
	local dt = now - last_ppe_ms
	last_ppe_ms = now
	if dt < 0 then
		dt = 0
	end
	ppe_factor = approach(ppe_factor, ppe_target, dt, PPE_FADE_MS)
	if ppe_factor <= 0 and ppe_target <= 0 then
		if ppe_active then
			ppe_active = set_ppe(0)
		end
		return
	end
	ppe_active = set_ppe(ppe_factor)
end

local function actor_on_update()
	if not db.actor then
		clear_ppe()
		return
	end

	local now = time_global()
	if now >= next_state_tick then
		next_state_tick = now + STATE_MS
		refresh_heal_state()
	end
	tick_ppe(now)

	if not can_heal then
		return
	end

	dogma.perf.start("campfire_healing", "actor_on_update")

	if now >= next_body_tick then
		next_body_tick = now + body_interval_ms()
		tick_body()
	end

	if now >= next_limb_tick then
		next_limb_tick = now + limb_interval_ms()
		tick_limb()
	end
	dogma.perf.stop()
end

local function on_option_change()
	refresh_settings()
	if not cached_fx_enable then
		clear_ppe()
	end
end

local function on_game_load()
	can_heal = false
	next_state_tick = 0
	clear_ppe()
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	refresh_settings()
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("on_game_load", on_game_load)
end
