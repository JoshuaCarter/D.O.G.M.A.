--[[
	New Game loadout (UINewGame) uses the same UIInfoItem as inventory.
	GAMMA numeric stats are owned by dogma_ensure_gamma_stats (weapons zzzz_*).

	This feature only:
	- patches get_sec_desc → build_desc_footer (section-only descriptions)
	- calls ensure from zzzz_dogma_tooltips_loadout_main / UINewGame.Main_Controls

	Do NOT call ish_item_stats.override_stats_table from this *mcm.script file
	load or on_mcm_load: ui_mcm.get() is forbidden during MCM gather and breaks
	surge_manager.
]]

local STATE = _G.__dogma_tooltips_loadout or {}
_G.__dogma_tooltips_loadout = STATE

local function patch_sec_desc()
	if STATE.desc_ok or not (ui_item and ui_item.build_desc_footer) then
		return
	end
	-- Same shape as stock ui_item.get_sec_desc: footer only (header needs obj).
	ui_item.get_sec_desc = function(sec)
		if not sec then
			return ""
		end
		local raw = ini_sys:r_string_ex(sec, "description")
		local str = (raw and game.translate_string(raw)) or ""
		return ui_item.build_desc_footer(nil, sec, str)
	end
	STATE.desc_ok = true
end

local function apply_gamma_loadout_tooltips(force)
	patch_sec_desc()
	if _G.dogma_ensure_gamma_stats then
		return _G.dogma_ensure_gamma_stats(force == true) == true
	end
	return false
end

_G.dogma_tooltips_loadout_apply = apply_gamma_loadout_tooltips

-- Safe at MCM gather time (no ADV / ui_mcm.get).
patch_sec_desc()

function on_mcm_load(options)
	-- Tree only — never override_stats_table here.
	dogma_mcm.attach(options, "tooltips", "ui_mcm_menu_dogma_tooltips", {
		id = "loadout",
		sh = true,
		text = "ui_mcm_menu_dogma_tooltips_loadout",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_tooltips_loadout_page_description",
			},
		}),
	})
end

function on_game_start()
	apply_gamma_loadout_tooltips(true)
end
