--[[
	PDA Name Highlight

	Yellow-highlights PDA / news tips that mention the player's character name.
	Always on while installed.

	Port of Eroktics QoL "Highlight Player Name in News".
]]

local original_send_tip = nil
local original_news_send_tip = nil
local original_xpda_send = nil
local logged_highlight = false

local YELLOW = "%c[255,255,255,0]"

local function highlight_msg_if_needed(msg)
	if not msg or not db.actor then
		return msg
	end
	local p_name = db.actor:character_name()
	if not p_name or p_name == "" then
		return msg
	end

	local translated_msg = game.translate_string(msg)
	local lower_msg = string.lower(translated_msg)
	local lower_name = string.lower(p_name)

	if string.find(lower_msg, lower_name, 1, true) then
		if not logged_highlight then
			logged_highlight = true
			dogma.console.say("PDA name highlighted in tip", "blue")
		end
		return YELLOW .. translated_msg
	end
	return msg
end

local function send_tip_hacked(msg, header, timeout, showtime, sender, sound, icon_by)
	msg = highlight_msg_if_needed(msg)
	if original_send_tip then
		return original_send_tip(msg, header, timeout, showtime, sender, sound, icon_by)
	end
end

local function news_send_tip_hacked(actor, msg, timeout, sender, showtime, sender_id)
	msg = highlight_msg_if_needed(msg)
	if original_news_send_tip then
		return original_news_send_tip(actor, msg, timeout, sender, showtime, sender_id)
	end
end

local function xpda_send_hacked(sender, msg, icon)
	msg = highlight_msg_if_needed(msg)
	if original_xpda_send then
		return original_xpda_send(sender, msg, icon)
	end
end

function on_game_start()
	if dynamic_news_helper and dynamic_news_helper.send_tip then
		original_send_tip = dynamic_news_helper.send_tip
		dynamic_news_helper.send_tip = send_tip_hacked
	end
	if news_manager and news_manager.send_tip then
		original_news_send_tip = news_manager.send_tip
		news_manager.send_tip = news_send_tip_hacked
	end
	if xpda and xpda.send then
		original_xpda_send = xpda.send
		xpda.send = xpda_send_hacked
	end
end
