-- dorn_mcm_banner:begin (managed by sync-dorn-common.sh)
local DORN_COMMON_VERSION = "dorn_common"
local function dorn_mcm()
	return _G.dorn_mcm
end
-- dorn_mcm_banner:end

local function kb_bind(id, hint)
	return {
		id = id,
		type = "key_bind",
		val = 2,
		def = -1,
		hint = hint,
	}
end

local function kb_modifier(id)
	local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
	return {
		id = id,
		type = kb_mod,
		val = 2,
		def = 0,
		hint = "mcm_kb_modifier",
		content = {
			{ 0, "mcm_kb_mod_none" },
			{ 1, "mcm_kb_mod_shift" },
			{ 2, "mcm_kb_mod_ctrl" },
			{ 3, "mcm_kb_mod_alt" },
		},
	}
end

local function kb_mode(id)
	local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
	return {
		id = id,
		type = kb_mod,
		val = 2,
		def = 0,
		hint = "mcm_kb_mode",
		content = {
			{ 0, "mcm_kb_mode_press" },
			{ 1, "mcm_kb_mode_dtap" },
			{ 2, "mcm_kb_mode_hold" },
		},
	}
end

