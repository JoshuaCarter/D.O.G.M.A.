--[[
	DOGMA common loader (vendored - stable, no commit hash).

	Ships as _dogma_common.script (leading _ = early load, before feature
	dogma_*_conf / zzzz_*). Aliases _G.dogma_common. Same pattern for
	_dogma_mcm / _dogma_dbg / _dogma_sys / _dogma_key_mirror_mcm /
	_dogma_input (alias dogma_input) / _dogma_xlibs. Key mirrors:
	_dogma_key_mirror_mcm (re-exported on dogma_mcm). Input: DOGMA.input.
	Features claim Controls rows via claim_control / mirror_spec; modxml_keybinds injects them.
	Feature body scripts are zzzz_*, so these globals exist before any feature
	on_game_start(). Feature _conf.script builds to dogma_{cat}_{feat}_conf.script
	(also no zzzz_) and publishes MOD_ID + defaults on _G.dogma_<feature>_conf.

	xlibs (Damian Sirbu) is a separate MO2 mod. Use dogma_xlibs.xconst / .xlevel / …
	(or DOGMA.xlibs after load). First access binds; do not call raw xconst / xsquad.

	Usage:

		local CONFIG = _G.dogma_feature_conf
		local DOGMA

		function on_game_start()
			DOGMA = dogma_common.load(CONFIG.MOD_ID)
			-- CONFIG.DEFAULTS = MCM defs; live values live in CONFIG.loaded
			-- CONFIG.loaded.x = DOGMA.mcm.bool(CONFIG.MOD_ID, "x")
			-- debug: DOGMA.dbg.logging() / DOGMA.dbg.overlay_enabled()
			-- input: DOGMA.input.is_key_down(dik) / DOGMA.input.is_key_held(dik, ms)
			-- xlibs: DOGMA.xlibs.xconst.INVALID_LEVEL_VERTEX_ID
		end
]]

function load(mod_id)
	local mcm = _G.dogma_mcm
	local dbg = _G.dogma_dbg
	local sys = _G.dogma_sys
	local keys = _G.dogma_key_mirror_mcm
	local input = _G.dogma_input or _G._dogma_input
	sys.set_deps(mcm, dbg)
	if mod_id then
		sys.reset_mod(mod_id)
		dbg.clear_source(mod_id)
	end
	return {
		mcm = mcm,
		dbg = dbg,
		sys = sys,
		keys = keys,
		input = input,
		xlibs = dogma_xlibs,
	}
end

_G.dogma_common = _G._dogma_common
