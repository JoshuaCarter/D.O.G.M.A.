--[[
	DotMarks near/far scan radius: MCM `input` edit boxes → `track` sliders.

	Those text boxes (and keybind focus nearby) have been crashing MCM OnKeyboard.
	Sliders keep the same option ids so existing saves still apply.

	  near_scan_radius  → track 0–10, def 4
	  early_scan_radius → track 0–10, def 3  ("far scan" in DotMarks UI)
]]

local STATE = _G.__dogma_misc_dotmarks_sliders or {}
_G.__dogma_misc_dotmarks_sliders = STATE

local PATCH = {
	near_scan_radius = {
		type = "track",
		val = 2,
		min = 0,
		max = 10,
		step = 0.5,
		def = 4,
	},
	early_scan_radius = {
		type = "track",
		val = 2,
		min = 0,
		max = 10,
		step = 0.5,
		def = 3,
	},
}

local function patch_node(node)
	if type(node) ~= "table" then
		return 0
	end

	local n = 0
	local spec = node.id and PATCH[node.id]
	if spec and node.type == "input" then
		node.type = spec.type
		node.val = spec.val
		node.min = spec.min
		node.max = spec.max
		node.step = spec.step
		node.def = spec.def
		n = n + 1
	end

	local gr = node.gr
	if type(gr) == "table" then
		for i = 1, #gr do
			n = n + patch_node(gr[i])
		end
	end

	return n
end

local function patch_options(opts)
	if type(opts) ~= "table" then
		return
	end
	local n = 0
	for i = 1, #opts do
		n = n + patch_node(opts[i])
	end
	if n > 0 and not STATE.logged then
		printf("[dogma_dotmarks_sliders] converted %d DotMarks radius input(s) to tracks", n)
		STATE.logged = true
	end
end

local function install_hook()
	if not (ui_mcm and ui_mcm.gather_options) then
		return false
	end
	if STATE.wrapped then
		return true
	end

	local orig = ui_mcm.gather_options
	ui_mcm.gather_options = function(...)
		orig(...)
		patch_options(rawget(ui_mcm, "options"))
	end
	STATE.wrapped = true
	return true
end

install_hook()

function on_mcm_load(options)
	install_hook()
	-- If gather already finished (or we run after DotMarks mid-gather), patch now.
	patch_options(options)

	dogma_mcm.attach(options, "misc", "ui_mcm_menu_dogma_misc", {
		id = "dotmarks_sliders",
		sh = true,
		text = "ui_mcm_menu_dogma_misc_dotmarks_sliders",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_misc_dotmarks_sliders_page_description",
			},
		}),
	})
end
