-- input/equipment_controls conf
-- Stock detector/geiger/torch: MCM key_mirror ↔ Settings → Controls.
-- RF / Glowstick: standalone MCM key_bind (DIK in axr_options, not engine customs).

local defaults = {
	["auto_bolt_on_detector"] = true,
	["key_radio"] = -1,
	["key_glowstick"] = -1,
}

_G.dogma_input_equipment_controls_conf = {
	MOD_ID = "dogma/input/equipment_controls",
	DEFAULTS = defaults,
	loaded = {
		enabled = true,
		auto_bolt_on_detector = defaults["auto_bolt_on_detector"],
		key_radio = nil,
		key_glowstick = nil,
	},
}
