local function format_msg(fmt, ...)
	local arg = { ... }
	if #arg == 0 then return tostring(fmt) end
	local ok, res = pcall(string.format, fmt, ...)
	return ok and res or (tostring(fmt) .. " (format error)")
end

local function log(fmt, ...)
	local cfg = _G.tft_config
	if not (cfg and cfg.debug_log) then return end
	dogma.dbg.log("dogma/gameplay/true_fast_travel", format_msg(fmt, ...))
end

local function path_road_log(fmt, ...)
	log("[path-road] " .. fmt, ...)
end

local function log_error(fmt, ...)
	dogma.dbg.log("dogma/gameplay/true_fast_travel", "[ERROR] " .. format_msg(fmt, ...))
end

local function str(id)
	local s = game.translate_string(id)
	if s and s ~= "" and s ~= id then return s end
	return id
end

local function set_fft_trip_in_progress(active)
	_G.game_fast_travel = _G.game_fast_travel or {}
	_G.game_fast_travel.trip_in_progress = active and true or false
end

local function destination_on_other_level(obj)
	if not obj then return false end
	local actor_lid = xlevel.get_actor_level_id()
	local dest_lid = xlevel.get_level_id(obj)
	return actor_lid ~= nil and dest_lid ~= nil and actor_lid ~= dest_lid
end

local function object_on_loaded_level(se_obj)
	if not se_obj then return true end
	local actor_lid = xlevel.get_actor_level_id()
	local obj_lid = xlevel.get_level_id(se_obj)
	if not (actor_lid and obj_lid) then
		-- Transition / invalid graph: treat as "not on loaded level" only when we
		-- can prove a cross-level mismatch; otherwise allow.
		return not destination_on_other_level(se_obj)
	end
	return actor_lid == obj_lid
end

-- GAMMA / modpack level names disagree (e.g. Meadow: meadow, y04_pole, pole, field).
-- Canonical keys match tft_door_keywords / door_registry / packaged aimaps.
local LEVEL_PLAIN = {
	["garbage"] = "l02_garbage",
	["escape"] = "l01_escape",
	["cordon"] = "l01_escape",
	["agroprom"] = "l03_agroprom",
	["darkvalley"] = "l04_darkvalley",
	["dark_valley"] = "l04_darkvalley",
	["bar"] = "l05_bar",
	["rostok"] = "l06_rostok",
	["wild_territory"] = "l06_rostok",
	["military"] = "l07_military",
	["army_warehouses"] = "l07_military",
	["army_warehouse"] = "l07_military",
	["yantar"] = "l08_yantar",
	["deadcity"] = "l09_deadcity",
	["dead_city"] = "l09_deadcity",
	["radar"] = "l10_radar",
	["redforest"] = "l10_red_forest",
	["red_forest"] = "l10_red_forest",
	["marsh"] = "k00_marsh",
	["swamp"] = "k00_marsh",
	["darkscape"] = "k01_darkscape",
	["trucks_cemetery"] = "k02_trucks_cemetery",
	["truck_cemetery"] = "k02_trucks_cemetery",
	["hospital"] = "l11_hospital",
	["generators"] = "l13_generators",
	["outskirts"] = "pripyat",
	["stancia"] = "l12_stancia",
	["stancia_2"] = "l12_stancia_2",
	["limansk"] = "limansk",
	["jupiter"] = "jupiter",
	["zaton"] = "zaton",
	["meadow"] = "meadow",
	["field"] = "meadow",
	["pole"] = "meadow",
	["y04_pole"] = "meadow",
}

local function canonicalize_level_name(name)
	if name == nil then return nil end
	if type(name) == "number" then
		if _G.tft_resolve_level_name then
			return _G.tft_resolve_level_name(name)
		end
		return nil
	end
	local n = string.lower(tostring(name))
	n = n:gsub("_%d+$", "")
	local sgsub = string.gsub
	n = sgsub(n, "dark_valley", "l04_darkvalley")
	n = sgsub(n, "truck_cemetery", "k02_trucks_cemetery")
	n = sgsub(n, "army_warehouses", "l07_military")
	n = sgsub(n, "army_warehouse", "l07_military")
	n = sgsub(n, "swamp", "k00_marsh")
	n = sgsub(n, "y04_pole", "meadow")
	n = sgsub(n, "l10_limansk", "limansk")
	local kws = _G.tft_door_keywords
	if kws then
		if kws[n] then return n end
		for canon, aliases in pairs(kws) do
			for i = 1, #aliases do
				if aliases[i] == n then return canon end
			end
		end
	end
	return LEVEL_PLAIN[n] or n
end

local function levels_same(a, b)
	if not a or not b then return false end
	if a == b then return true end
	return canonicalize_level_name(a) == canonicalize_level_name(b)
end

-- Names to try for VFS aimap / door_registry lookups (raw + canonical + aliases).
local function level_name_load_candidates(name)
	local raw = name
	if raw == nil and level and level.name then
		raw = level.name()
	end
	if not raw then return {} end
	local out, seen = {}, {}
	local function add(n)
		if n and n ~= "" and not seen[n] then
			seen[n] = true
			out[#out + 1] = n
		end
	end
	add(tostring(raw))
	local canon = canonicalize_level_name(raw)
	add(canon)
	local kws = _G.tft_door_keywords and canon and _G.tft_door_keywords[canon]
	if kws then
		for i = 1, #kws do
			add(kws[i])
		end
	end
	return out
end

local function is_cross_zone_destination(se_obj, ln)
	local cur_lvl = (level and level.name) and level.name() or nil
	if ln and cur_lvl and not levels_same(ln, cur_lvl) then return true end
	if se_obj then return destination_on_other_level(se_obj) end
	return false
end

local function is_trader_restrictor(name)
	if not name then return false end
	local low_name = string.lower(name)
	local sfind = string.find
	return sfind(low_name, "trader", 1, true) ~= nil
		or sfind(low_name, "merchant", 1, true) ~= nil
		or sfind(low_name, "barman", 1, true) ~= nil
		or sfind(low_name, "sidorovich", 1, true) ~= nil
		or sfind(low_name, "saharov", 1, true) ~= nil
		or sfind(low_name, "forester", 1, true) ~= nil
end

msg = function(text, style)
	if not (db.actor and db.actor:alive()) then return end
	if not text or text == "" then return end
	local cfg = tft.active_config or {}
	local duration = tonumber(cfg.screen_msg_duration) or 4
	if duration <= 0 then return end
	if actor_menu and actor_menu.set_msg then
		actor_menu.set_msg(1, text, duration)
	end
end

do
	_G.tft_config = _G.tft_config or {}
	_G.tft_log = log
	_G.tft_path_road_log_enabled = function()
		local cfg = _G.tft_config
		return cfg and cfg.debug_log
	end
	_G.tft_path_road_log = path_road_log
	_G.tft_log_error = log_error
	_G.tft_str = str
	_G.tft_destination_on_other_level = destination_on_other_level
	_G.tft_object_on_loaded_level = object_on_loaded_level
	_G.tft_canonicalize_level_name = canonicalize_level_name
	_G.tft_levels_same = levels_same
	_G.tft_level_name_load_candidates = level_name_load_candidates
	_G.tft_is_cross_zone_destination = is_cross_zone_destination
	_G.tft_is_trader_restrictor = is_trader_restrictor
	_G.tft_msg = msg
	_G.tft_set_fft_trip_in_progress = set_fft_trip_in_progress
	printf("[dogma_gameplay_true_fast_travel] MVP core loaded")
end
