function on_mcm_load(options)
	local CONFIG = _G.dogma_weapons_quick_fire_conf
	dogma_mcm.attach(options, "weapons", "ui_mcm_menu_dogma_weapons", {
		id = "quick_fire",
		sh = true,
		text = "ui_mcm_menu_dogma_weapons_quick_fire",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_quick_fire_page_description",
			},
		}),
	})
end
