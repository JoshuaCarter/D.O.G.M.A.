--[[
	Keybinds Fix - in-session re-apply + ui_options patch.
]]

local CONFIG = _G.dogma_fixes_fix_system_keybinds_not_sticking_conf

local function patch_ui()
	if CONFIG.patch_ui_options then
		CONFIG.patch_ui_options()
	end
end

local function repair()
	patch_ui()
	if CONFIG.repair_keybinds then
		CONFIG.repair_keybinds()
	end
end

local function repair_boot()
	patch_ui()
	if CONFIG.repair_keybinds_boot then
		CONFIG.repair_keybinds_boot()
	elseif CONFIG.repair_keybinds then
		CONFIG.repair_keybinds()
	end
end

function on_game_start()
	repair_boot()
	RegisterScriptCallback("on_game_load", repair_boot)
	RegisterScriptCallback("on_option_change", repair)
end
