-- controls/extra_equip_slots conf
-- POC: dedicated engine slot 15 for pistols + three MCM keybinds.

local defaults = {
	["key_holster"] = -1, -- scan + move pistol into slot 15
	["key_draw"] = -1, -- raise / lower slot 15
	["key_unequip"] = -1, -- move slot 15 item back to ruck
}

_G.dogma_controls_extra_equip_slots_conf = {
	MOD_ID = "dogma/controls/extra_equip_slots",
	DEFAULTS = defaults,
	PISTOL_SLOT = 15,
	loaded = {
		enabled = true,
		key_holster = nil,
		key_draw = nil,
		key_unequip = nil,
	},
}
