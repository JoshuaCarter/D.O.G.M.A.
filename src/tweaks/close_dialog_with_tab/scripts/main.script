--[[
	Close Dialog With Tab

	Engine talk UI (CUITalkWnd) only closes on Use/Quit binds. While Dialog owns
	input, on_before_key_press is suppressed — poll Tab via dogma.input and
	stop_talk() instead.
]]

local CONFIG = _G.dogma_tweaks_close_dialog_with_tab_conf

local POLL = "poll"
local dialog_open = false

local function tab_dik()
	return (DIK_keys and DIK_keys.DIK_TAB) or 15
end

local function stop_poll()
	dialog_open = false
	RemoveTimeEvent(CONFIG.MOD_ID, POLL)
end

local function poll()
	if not dialog_open then
		return true
	end
	if dogma.input.is_key_pressed(tab_dik()) then
		local actor = db.actor
		if actor and actor.is_talking and actor:is_talking() then
			actor:stop_talk()
		end
	end
	return false
end

local function on_gui_show(gui)
	if gui ~= "Dialog" then
		return
	end
	dialog_open = true
	-- Prime dogma.input tracking for Tab (only tracks DIKs after first query).
	dogma.input.is_key_down(tab_dik())
	RemoveTimeEvent(CONFIG.MOD_ID, POLL)
	CreateTimeEvent(CONFIG.MOD_ID, POLL, 0, poll)
end

local function on_gui_hide(gui)
	if gui == "Dialog" then
		stop_poll()
	end
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	RegisterScriptCallback("GUI_on_show", on_gui_show)
	RegisterScriptCallback("GUI_on_hide", on_gui_hide)
	RegisterScriptCallback("on_game_load", stop_poll)
	RegisterScriptCallback("actor_on_net_destroy", stop_poll)
end
