-- game/weapons_ban conf - per-category price→tier cost cutoffs.

local defaults = {
	-- New-game extra ammo: boxes per owned start weapon (on top of loadout).
	["extra_start_ammo_boxes"] = 5,
	["sight_tier_cost_2"] = 5000,
	["sight_tier_cost_3"] = 10000,
	["sight_tier_cost_4"] = 25000,
	["sight_tier_cost_5"] = 50000,
	["kit_tier_cost_2"] = 9000,
	["kit_tier_cost_3"] = 16000,
	["kit_tier_cost_4"] = 28000,
	["kit_tier_cost_5"] = 45000,
	["suppressor_tier_cost_2"] = 2000,
	["suppressor_tier_cost_3"] = 4000,
	["suppressor_tier_cost_4"] = 8000,
	["suppressor_tier_cost_5"] = 12000,
	["ammo_tier_cost_2"] = 800,
	["ammo_tier_cost_3"] = 1600,
	["ammo_tier_cost_4"] = 3000,
	["ammo_tier_cost_5"] = 6000,
	["parts_tier_cost_2"] = 3000,
	["parts_tier_cost_3"] = 4500,
	["parts_tier_cost_4"] = 5500,
	["parts_tier_cost_5"] = 7000,
}

local loaded = {}
for k, v in pairs(defaults) do
	loaded[k] = v
end

_G.dogma_game_weapons_ban_conf = {
	MOD_ID = "dogma/game/weapons_ban",
	DEFAULTS = defaults,
	loaded = loaded,
	CATS = { "sight", "kit", "suppressor", "ammo", "parts" },
}

function _G.dogma_game_weapons_ban_conf:ensure_dogma()
	dogma.load(self.MOD_ID)
	return dogma
end

function on_mcm_load(options)
	local CONFIG = _G.dogma_game_weapons_ban_conf
	local D = CONFIG.DEFAULTS

	local function track(cat, n, min_v, max_v, step_v)
		local id = cat .. "_tier_cost_" .. n
		return {
			id = id,
			type = "track",
			val = 2,
			min = min_v,
			max = max_v,
			step = step_v,
			def = D[id],
			hint = "dogma_game_weapons_ban_" .. id,
		}
	end

	local function cat_header(cat)
		return {
			id = cat .. "_header",
			type = "desc",
			text = "ui_mcm_dogma_game_weapons_ban_" .. cat .. "_header",
		}
	end

	dogma_mcm.attach(options, "game", "ui_mcm_menu_dogma_game", {
		id = "weapons_ban",
		sh = true,
		text = "ui_mcm_menu_dogma_game_weapons_ban",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_game_weapons_ban_page_description",
			},
			{
				id = "extra_start_ammo_boxes",
				type = "track",
				val = 2,
				min = 0,
				max = 5,
				step = 1,
				def = D["extra_start_ammo_boxes"],
				hint = "dogma_game_weapons_ban_extra_start_ammo_boxes",
			},
			cat_header("sight"),
			track("sight", 2, 0, 150000, 500),
			track("sight", 3, 0, 150000, 500),
			track("sight", 4, 0, 150000, 500),
			track("sight", 5, 0, 150000, 500),
			cat_header("kit"),
			track("kit", 2, 0, 100000, 500),
			track("kit", 3, 0, 100000, 500),
			track("kit", 4, 0, 100000, 500),
			track("kit", 5, 0, 100000, 500),
			cat_header("suppressor"),
			track("suppressor", 2, 0, 25000, 250),
			track("suppressor", 3, 0, 25000, 250),
			track("suppressor", 4, 0, 25000, 250),
			track("suppressor", 5, 0, 25000, 250),
			cat_header("ammo"),
			track("ammo", 2, 0, 15000, 100),
			track("ammo", 3, 0, 15000, 100),
			track("ammo", 4, 0, 15000, 100),
			track("ammo", 5, 0, 15000, 100),
			cat_header("parts"),
			track("parts", 2, 0, 10000, 125),
			track("parts", 3, 0, 10000, 125),
			track("parts", 4, 0, 10000, 125),
			track("parts", 5, 0, 10000, 125),
		}),
	})
end
