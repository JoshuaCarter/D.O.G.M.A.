--[[
	New Game - in-session re-patch.

	Primary patch is in mcm.script (loaded at main menu). This file only runs
	after a game session starts; re-apply wraps if the New Game class was
	restored.
]]

local CONFIG = _G.dogma_gui_newgame_conf

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	CONFIG.patch_new_game()
end
