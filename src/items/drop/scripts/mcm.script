function on_mcm_load(options)
	local CONFIG = _G.dogma_items_drop_conf
	local function kb_bind(id, hint)
		return {
			id = id,
			type = "key_bind",
			val = 2,
			def = CONFIG.DEFAULTS[id],
			hint = hint,
		}
	end

	local function kb_modifier(id)
		local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
		return {
			id = id,
			type = kb_mod,
			val = 2,
			def = CONFIG.DEFAULTS[id],
			hint = "mcm_kb_modifier",
			content = {
				{ 0, "mcm_kb_mod_none" },
				{ 1, "mcm_kb_mod_shift" },
				{ 2, "mcm_kb_mod_ctrl" },
				{ 3, "mcm_kb_mod_alt" },
			},
		}
	end

	local function kb_mode(id)
		local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
		return {
			id = id,
			type = kb_mod,
			val = 2,
			def = CONFIG.DEFAULTS[id],
			hint = "mcm_kb_mode",
			content = {
				{ 0, "mcm_kb_mode_press" },
				{ 2, "mcm_kb_mode_hold" },
			},
		}
	end

	dogma_mcm.mcm.attach(options, "items", "ui_mcm_menu_dogma_items", {
		id = "drop",
		sh = true,
		text = "ui_mcm_menu_dogma_items_drop",
		gr = dogma_mcm.mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_items_drop_page_description",
			},
			kb_bind("key_drop", "dogma_items_drop_key_drop"),
			kb_modifier("key_drop_modifier"),
			kb_mode("key_drop_mode"),
			{
				id = "drop_safe_equipped",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["drop_safe_equipped"],
				hint = "dogma_items_drop_drop_safe_equipped",
			},
		}),
	})
end
