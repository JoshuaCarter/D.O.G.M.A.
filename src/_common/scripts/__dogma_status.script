--[[
    Shared actor status. Costly tests run once; cheap / event-driven
    flags are read live.

    is_in_combat()  — 1s cache: a collected hunter (best_enemy = actor) is within COMBAT_M
    is_inv_open()   — talking, or engine ActorMenu:IsShown() (same as world-input / tutorials)
    is_eating()     — food use, latched 3s
    is_drinking()   — drink use, latched 3s
    is_weapon_lowered() — game.actor_weapon_lowered() (eat/meds/sprint/dialog/…)
    is_sprinting()  — IsMoveState("mcSprint")
    is_talking()    — actor:is_talking()
    health()        — actor.health, 0–1
    psy_health()    — actor.psy_health, 0–1
    stamina()       — actor.power, 0–1
    stamina_max()   — conditions().GetMaxPower(), 0–1 (cap shrinks with time/weight)
    limbs()         — { head = {perm, temp}, torso, leftarm, rightarm, leftleg, rightleg } as 0–1
    bhs()           — live BHS tables: health, timedhp, maxhp (or nil)
]]

local INTERVAL_MS = 1000
local TICK_SEC = 1
local CONSUME_MS = 3000
local COMBAT_M = 150

local LIMBS = { "head", "torso", "leftarm", "rightarm", "leftleg", "rightleg" }
local LIMB_MAX = {
    head = 8,
    torso = 10,
    leftarm = 4,
    rightarm = 4,
    leftleg = 4,
    rightleg = 4,
}

local in_combat = false
local next_at = 0
local eating_until = 0
local drinking_until = 0
local bhs_health = nil
local bhs_timedhp = nil
local bhs_maxhp = nil

local function npc_hunting_actor(npc, actor_id)
    if not ((IsStalker and IsStalker(npc)) or (IsMonster and IsMonster(npc))) then
        return false
    end
    if not npc:alive() then
        return false
    end
    local enemy = npc:best_enemy()
    if enemy then
        return enemy and enemy:id() == actor_id
    end
end

local function dist_to(npc, origin)
    return npc:position():distance_to(origin)
end

-- st.object can outlive the GO (save / net_destroy). clsid on that wrapper logs.
local function live_go(id)
    if not (id and level and level.object_by_id) then
        return
    end
    return level.object_by_id(id)
end

-- st.object skips offline / unbound storage. best_enemy is the engine hunt target.
local function scan_combat()
    local actor = db and db.actor
    if not (actor and db.storage) then
        return false
    end
    local actor_id = actor:id()
    local hunters = {}
    for id, st in pairs(db.storage) do
        if st and id ~= actor_id then
            local npc = live_go(id)
            if npc then
                local ok, hit = pcall(npc_hunting_actor, npc, actor_id)
                if ok and hit then
                    hunters[#hunters + 1] = npc
                end
            end
        end
    end
    local origin = actor:position()
    for i = 1, #hunters do
        local ok, dist = pcall(dist_to, hunters[i], origin)
        if ok and dist <= COMBAT_M then
            return true
        end
    end
    return false
end

local function perf_start(method)
    local perf = rawget(_G, "__dogma_perf")
    if perf then
        perf.start("dogma", method)
    end
end

local function perf_stop()
    local perf = rawget(_G, "__dogma_perf")
    if perf then
        perf.stop()
    end
end

local function refresh()
    perf_start("status.in_combat")
    local ok, engaged = pcall(scan_combat)
    perf_stop()
    if ok then
        in_combat = engaged
    end
end

local function tick()
    local now = time_global()
    if now >= next_at then
        next_at = now + INTERVAL_MS
        refresh()
    end
    return false
end

local function ensure_tick()
    if not CreateTimeEvent then
        return
    end
    if RemoveTimeEvent then
        pcall(RemoveTimeEvent, "dogma_status", "tick")
    end
    CreateTimeEvent("dogma_status", "tick", TICK_SEC, tick)
end

local function item_section(item)
    if type(item) == "string" and item ~= "" then
        return item
    end
    if not item then
        return nil
    end
    local ok, sec = pcall(item.section, item)
    if ok and type(sec) == "string" and sec ~= "" then
        return sec
    end
    return nil
end

local function item_kind(sec)
    if not (sec and ini_sys and ini_sys.r_string_ex) then
        return nil
    end
    return ini_sys:r_string_ex(sec, "kind")
end

local function is_drink_sec(sec)
    if IsItem and IsItem("drink", sec) then
        return true
    end
    return item_kind(sec) == "i_drink"
end

local function is_food_sec(sec)
    if IsItem and IsItem("food", sec) then
        return true
    end
    return item_kind(sec) == "i_food"
end

-- actor_on_item_use(item, section). Drink before food so a listed drink is not a meal.
local function on_item_use(item, sec)
    sec = item_section(sec) or item_section(item)
    if not sec then
        return
    end
    local until_ms = time_global() + CONSUME_MS
    if is_drink_sec(sec) then
        drinking_until = until_ms
        return
    end
    if is_food_sec(sec) then
        eating_until = until_ms
    end
end

-- BHS health is 0-max (arms/legs 4, head 8, torso 10). Fraction vs that limb's max.
local function limb_frac(hp, max, key)
    hp = tonumber(hp)
    if not hp then
        return 0
    end
    max = tonumber(max)
    if not max or max <= 0 then
        max = LIMB_MAX[key] or 4
    end
    local f = hp / max
    if f < 0 then
        return 0
    end
    if f > 1 then
        return 1
    end
    return f
end

local function tables_are_bhs(health, timedhp, maxhp)
    return type(health) == "table"
        and type(timedhp) == "table"
        and type(maxhp) == "table"
        and health.head ~= nil
        and timedhp.head ~= nil
        and tonumber(maxhp.head) ~= nil
end

local function dig_bhs_from_fn(fn, depth)
    if depth > 5 or type(fn) ~= "function" then
        return nil
    end
    if debug.getfenv then
        local env = debug.getfenv(fn)
        if tables_are_bhs(env.health, env.timedhp, env.maxhp) then
            return env.health, env.timedhp, env.maxhp
        end
    end
    local i = 1
    while true do
        local name, val = debug.getupvalue(fn, i)
        if not name then
            break
        end
        if type(val) == "function" then
            local h, t, m = dig_bhs_from_fn(val, depth + 1)
            if h then
                return h, t, m
            end
        elseif name == "health" and type(val) == "table" and val.head ~= nil then
            local timedhp, maxhp
            local j = 1
            while true do
                local n2, v2 = debug.getupvalue(fn, j)
                if not n2 then
                    break
                end
                if n2 == "timedhp" then
                    timedhp = v2
                elseif n2 == "maxhp" then
                    maxhp = v2
                end
                j = j + 1
            end
            if tables_are_bhs(val, timedhp, maxhp) then
                return val, timedhp, maxhp
            end
        end
        i = i + 1
    end
    return nil
end

local function resolve_bhs()
    if tables_are_bhs(bhs_health, bhs_timedhp, bhs_maxhp) then
        return bhs_health, bhs_timedhp, bhs_maxhp
    end
    -- Miss: module fields or upvalue dig. Cached hits stay untimed.
    perf_start("status.bhs_resolve")
    local h, t, m
    local mod = rawget(_G, "zzz_player_injuries") or zzz_player_injuries
    if type(mod) == "table" then
        if tables_are_bhs(mod.health, mod.timedhp, mod.maxhp) then
            h, t, m = mod.health, mod.timedhp, mod.maxhp
        elseif type(mod.actor_on_update) == "function" then
            h, t, m = dig_bhs_from_fn(mod.actor_on_update, 0)
            if h then
                mod.health = h
                mod.timedhp = t
                mod.maxhp = m
            end
        end
    end
    if h then
        bhs_health, bhs_timedhp, bhs_maxhp = h, t, m
    end
    perf_stop()
    return h, t, m
end

local function reset()
    in_combat = false
    next_at = 0
    eating_until = 0
    drinking_until = 0
    bhs_health = nil
    bhs_timedhp = nil
    bhs_maxhp = nil
end

local game_load_cb = function()
    reset()
    ensure_tick()
end

function on_game_start()
    ensure_tick()
    RegisterScriptCallback("actor_on_item_use", on_item_use)
    RegisterScriptCallback("on_game_load", game_load_cb)
    RegisterScriptCallback("main_menu_on_init", reset)
    RegisterScriptCallback("main_menu_on_quit", reset)
    RegisterScriptCallback("actor_on_net_destroy", reset)
end

function is_in_combat()
    return in_combat
end

-- Engine: CurrentGameUI()->GetActorMenu().IsShown(). Tutorials and
-- Level_input use that. Lua ui_inventory.GUI:IsShown() sticks after Close.
-- get_hud() is CurrentGameUI() and may be nil. ActorMenu.get_actor_menu
-- native-crashes if HUD is missing — only call after get_hud().
local try_actor_menu_shown = function(ActorMenu)
    local menu = ActorMenu.get_actor_menu()
    return menu and menu:IsShown()
end

function is_inv_open()
    if is_talking() then
        return true
    end
    if not (get_hud and get_hud()) then
        return false
    end
    if ActorMenu and ActorMenu.get_actor_menu then
        local ok, shown = pcall(try_actor_menu_shown, ActorMenu)
        if ok then
            return shown == true
        end
    end
    return actor_menu and actor_menu.last_mode and actor_menu.last_mode ~= 0
end

function is_eating()
    return time_global() < eating_until
end

function is_drinking()
    return time_global() < drinking_until
end

function is_weapon_lowered()
    if not (game and game.actor_weapon_lowered) then
        return false
    end
    local ok, lowered = pcall(game.actor_weapon_lowered)
    return ok and lowered == true
end

function is_sprinting()
    if not IsMoveState then
        return false
    end
    local ok, sprint = pcall(IsMoveState, "mcSprint")
    return ok and sprint == true
end

function is_talking()
    local actor = db and db.actor
    if not (actor and actor.is_talking) then
        return false
    end
    local ok, talking = pcall(actor.is_talking, actor)
    return ok and talking == true
end

local function clamp01(v)
    if type(v) ~= "number" then
        return 0
    end
    if v < 0 then
        return 0
    end
    if v > 1 then
        return 1
    end
    return v
end

function health()
    local actor = db and db.actor
    return clamp01(actor and actor.health)
end

function psy_health()
    local actor = db and db.actor
    return clamp01(actor and actor.psy_health)
end

function stamina()
    local actor = db and db.actor
    return clamp01(actor and actor.power)
end

local function actor_max_power(actor)
    return actor:cast_Actor():conditions():GetMaxPower()
end

function stamina_max()
    local actor = db and db.actor
    if not actor then
        return 1
    end
    local ok, m = pcall(actor_max_power, actor)
    if not (ok and type(m) == "number") then
        return 1
    end
    return clamp01(m)
end

function bhs()
    return resolve_bhs()
end

-- Reused. Read now; do not stash across calls.
local LIMB_OUT = {}
for i = 1, #LIMBS do
    LIMB_OUT[LIMBS[i]] = { perm = 0, temp = 0 }
end

-- BHS health[] is perm + temp. Permanent is health - timedhp.
function limbs()
    local health, timedhp, maxhp = resolve_bhs()
    for i = 1, #LIMBS do
        local key = LIMBS[i]
        local slot = LIMB_OUT[key]
        local hp = tonumber(health and health[key])
        local temp = tonumber(timedhp and timedhp[key]) or 0
        local max = maxhp and maxhp[key]
        local perm = hp and (hp - temp) or nil
        slot.perm = limb_frac(perm, max, key)
        slot.temp = limb_frac(temp, max, key)
    end
    return LIMB_OUT
end
