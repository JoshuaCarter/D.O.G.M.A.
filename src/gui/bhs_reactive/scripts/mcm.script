-- gui/bhs_reactive conf
-- Park BHS / psy / SidHUD rad per piece; status icons gated separately.

_G.dogma_gui_bhs_reactive_conf = {
	MOD_ID = "dogma/gui/bhs_reactive",
	DEFAULTS = {
		hide_body = true,
		key_bhs = -1,
		key_bhs_modifier = 0,
		show_on_damage = true,
		sec = 30,
		full_heal_clamp_sec = 10,
		hide_hp = true,
		hp_show_below_pct = 99,
		hide_stam = true,
		stam_show_below_pct = 99,
		hide_psy = true,
		psy_show_below_pct = 99,
		hide_rad = true,
		rad_show_above_pct = 1,
		hide_status_icons = true,
		key_icons = -1,
		key_icons_modifier = 0,
		icons_radiation = true,
		icons_bleed = true,
		icons_hunger = true,
		icons_thirst = true,
		icons_sleep = true,
		grey_hide_after_sec = 3,
		thirst_blur_yellow = true,
	},
	loaded = {},
}

function on_mcm_load(options)
	local CONFIG = _G.dogma_gui_bhs_reactive_conf
	local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
	local mod_content = {
		{ 0, "mcm_kb_mod_none" },
		{ 1, "mcm_kb_mod_shift" },
		{ 2, "mcm_kb_mod_ctrl" },
		{ 3, "mcm_kb_mod_alt" },
	}

	dogma_mcm.attach(options, "gui", "ui_mcm_menu_dogma_gui", {
		id = "bhs_reactive",
		sh = true,
		text = "ui_mcm_menu_dogma_gui_bhs_reactive",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_gui_bhs_reactive_page_description",
			},
			{
				id = "hide_body",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.hide_body,
				hint = "dogma_gui_bhs_reactive_hide_body",
			},
			{
				id = "key_bhs",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS.key_bhs,
				hint = "dogma_gui_bhs_reactive_key_bhs",
			},
			{
				id = "key_bhs_modifier",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS.key_bhs_modifier,
				hint = "mcm_kb_modifier",
				content = mod_content,
			},
			{
				id = "show_on_damage",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.show_on_damage,
				hint = "dogma_gui_bhs_reactive_show_on_damage",
			},
			{
				id = "sec",
				type = "track",
				val = 2,
				min = 0,
				max = 60,
				step = 1,
				def = CONFIG.DEFAULTS.sec,
				hint = "dogma_gui_bhs_reactive_sec",
			},
			{
				id = "full_heal_clamp_sec",
				type = "track",
				val = 2,
				min = 0,
				max = 60,
				step = 1,
				def = CONFIG.DEFAULTS.full_heal_clamp_sec,
				hint = "dogma_gui_bhs_reactive_full_heal_clamp_sec",
			},
			{ id = "section_hp", type = "line" },
			{
				id = "hide_hp",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.hide_hp,
				hint = "dogma_gui_bhs_reactive_hide_hp",
			},
			{
				id = "hp_show_below_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS.hp_show_below_pct,
				hint = "dogma_gui_bhs_reactive_hp_show_below_pct",
			},
			{ id = "section_stam", type = "line" },
			{
				id = "hide_stam",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.hide_stam,
				hint = "dogma_gui_bhs_reactive_hide_stam",
			},
			{
				id = "stam_show_below_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS.stam_show_below_pct,
				hint = "dogma_gui_bhs_reactive_stam_show_below_pct",
			},
			{ id = "section_psy", type = "line" },
			{
				id = "hide_psy",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.hide_psy,
				hint = "dogma_gui_bhs_reactive_hide_psy",
			},
			{
				id = "psy_show_below_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS.psy_show_below_pct,
				hint = "dogma_gui_bhs_reactive_psy_show_below_pct",
			},
			{ id = "section_rad", type = "line" },
			{
				id = "hide_rad",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.hide_rad,
				hint = "dogma_gui_bhs_reactive_hide_rad",
			},
			{
				id = "rad_show_above_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS.rad_show_above_pct,
				hint = "dogma_gui_bhs_reactive_rad_show_above_pct",
			},
			{ id = "section_icons", type = "line" },
			{
				id = "hide_status_icons",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.hide_status_icons,
				hint = "dogma_gui_bhs_reactive_hide_status_icons",
			},
			{
				id = "key_icons",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS.key_icons,
				hint = "dogma_gui_bhs_reactive_key_icons",
			},
			{
				id = "key_icons_modifier",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS.key_icons_modifier,
				hint = "mcm_kb_modifier",
				content = mod_content,
			},
			{
				id = "icons_radiation",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.icons_radiation,
				hint = "dogma_gui_bhs_reactive_icons_radiation",
			},
			{
				id = "icons_bleed",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.icons_bleed,
				hint = "dogma_gui_bhs_reactive_icons_bleed",
			},
			{
				id = "icons_hunger",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.icons_hunger,
				hint = "dogma_gui_bhs_reactive_icons_hunger",
			},
			{
				id = "icons_thirst",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.icons_thirst,
				hint = "dogma_gui_bhs_reactive_icons_thirst",
			},
			{
				id = "icons_sleep",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.icons_sleep,
				hint = "dogma_gui_bhs_reactive_icons_sleep",
			},
			{
				id = "grey_hide_after_sec",
				type = "track",
				val = 2,
				min = 0,
				max = 10,
				step = 1,
				def = CONFIG.DEFAULTS.grey_hide_after_sec,
				hint = "dogma_gui_bhs_reactive_grey_hide_after_sec",
			},
			{ id = "section_thirst_ppe", type = "line" },
			{
				id = "thirst_blur_yellow",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.thirst_blur_yellow,
				hint = "dogma_gui_bhs_reactive_thirst_blur_yellow",
			},
		}),
	})
end
