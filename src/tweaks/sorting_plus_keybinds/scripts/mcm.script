-- tweaks/sorting_plus_keybinds - MCM keybinds + remember fav/junk across new games.

_G.dogma_tweaks_sorting_plus_keybinds_conf = {
	MOD_ID = "dogma/tweaks/sorting_plus_keybinds",
	DEFAULTS = {
		key_favorite = -1,
		key_junk = -1,
		persist_favorites = true,
		persist_junk = true,
	},
}

function on_mcm_load(options)
	dogma_mcm.attach(options, "tweaks", "ui_mcm_menu_dogma_tweaks", {
		id = "sorting_plus_keybinds",
		sh = true,
		text = "ui_mcm_menu_dogma_tweaks_sorting_plus_keybinds",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_tweaks_sorting_plus_keybinds_page_description",
			},
			{
				id = "key_favorite",
				type = "key_bind",
				val = 2,
				def = -1,
				hint = "SortingPlus_key_favorite",
			},
			{
				id = "key_junk",
				type = "key_bind",
				val = 2,
				def = -1,
				hint = "SortingPlus_key_junk",
			},
			{
				id = "persist_favorites",
				type = "check",
				val = 1,
				def = true,
				hint = "SortingPlus_persist_favorites",
			},
			{
				id = "persist_junk",
				type = "check",
				val = 1,
				def = true,
				hint = "SortingPlus_persist_junk",
			},
		}),
	})
end
