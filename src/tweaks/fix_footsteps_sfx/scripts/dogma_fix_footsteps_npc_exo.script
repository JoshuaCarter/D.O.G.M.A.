-- dogma fix_footsteps_sfx: NPC exo servo on footstep
-- wraps xr_motivator so other motivator patches still run

local MOD_ID = "dogma/tweaks/fix_footsteps_sfx"
local string_find = string.find

local orig_net_spawn
local orig_net_destroy
local wrapped = false

local sound_table = {}
local visuals = {}
local logged_first = false

local function log(msg)
	dogma.log.log(MOD_ID, tostring(msg))
end

function npc_on_foot_step(binder, obj, power, b_play, b_on_ground, b_hud_view)
	local visual = obj:get_visual_name()
	local outfit_tbl = death_manager.get_outfit_by_npc_visual(visual)
	local outfit = outfit_tbl and outfit_tbl[1]
	if not outfit then
		return
	end
	local kind = string_find(outfit, "proto", 1, true) and "light" or SYS_GetParam(0, outfit, "repair_type") == "outfit_exo" and "heavy" or nil
	if not kind then
		return
	end
	local id = obj:id()
	if not sound_table[id] or visuals[id] ~= visual then
		sound_table[id] = sound_object("dogma_steps\\exo\\" .. kind .. "_servo_exo_walk" .. math.random(2))
		visuals[id] = visual
		if not logged_first then
			logged_first = true
			log("exo servo first play id=" .. tostring(id) .. " kind=" .. kind)
		end
	end
	sound_table[id]:play_at_pos(obj, obj:position(), 0, sound_object.s3d)
	sound_table[id].volume = power
end

function dogma_exo_net_spawn(self, se_abstract)
	local ok = orig_net_spawn(self, se_abstract)
	if not ok then
		return false
	end
	local npc = self.object
	if npc and npc:alive() then
		npc:set_callback(callback.on_foot_step, npc_on_foot_step, self)
	end
	return true
end

function dogma_exo_net_destroy(self)
	if self.object then
		local id = self.object:id()
		sound_table[id] = nil
		visuals[id] = nil
	end
	return orig_net_destroy(self)
end

function on_game_start()
	if wrapped then
		return
	end
	orig_net_spawn = xr_motivator.motivator_binder.net_spawn
	orig_net_destroy = xr_motivator.motivator_binder.net_destroy
	xr_motivator.motivator_binder.net_spawn = dogma_exo_net_spawn
	xr_motivator.motivator_binder.net_destroy = dogma_exo_net_destroy
	wrapped = true
	log("exo wrap ready")
end
