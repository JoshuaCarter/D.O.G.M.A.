--[[
	Weapons Ban — ammo craft 1:1

	LoadRecipes overwrites GAMMA slots for ammo recipes in dogma.db.craft.
	Casing/bullet 1 per round. Powder n from the dump, per round.
	Cost = per-round × dogma.db box. Other recipes stay GAMMA.
]]

local CONFIG = _G.dogma_game_weapons_ban_conf
local TAG = (CONFIG and CONFIG.MOD_ID or "dogma/game/weapons_ban"):gsub("/", "_")
local HOOK = "_dogma_wb_ammo_craft"

local function recipe_sec(r)
	if not r then
		return nil
	end
	local s = r.sec or r.section or r.id
	if type(s) == "string" and s ~= "" then
		return s
	end
	return nil
end

local function recipe_override(sec)
	local parts = dogma.db.craft(sec)
	if not parts then
		return nil
	end
	local casing, powder, bullet, p_n, other = nil, nil, nil, 0, 0
	for i = 1, #parts do
		local s = parts[i][1]
		local n = parts[i][2]
		if dogma.db.is_ammo_casing(s) then
			casing = s
		elseif dogma.db.is_ammo_powder(s) then
			powder = s
			p_n = n
		elseif dogma.db.is_ammo_bullet(s) then
			bullet = s
		else
			other = other + 1
		end
	end
	if casing and powder and bullet and other == 0 and p_n > 0 then
		return { casing, powder, p_n, bullet }
	end
	return nil
end

local function part_per_round(spec, sec)
	if dogma.db.is_ammo_powder(sec) then
		return spec[3]
	end
	return 1
end

-- After GAMMA LoadRecipes: overwrite slots for 3-part ammo dump recipes.
local function apply_recipes(self)
	if not (self and self.recipes) then
		return
	end
	for _, list in pairs(self.recipes) do
		if type(list) == "table" then
			for i = 1, #list do
				local r = list[i]
				local spec = r and recipe_override(recipe_sec(r))
				if spec then
					r[1] = { spec[1], 1 }
					r[2] = { spec[2], spec[3] }
					r[3] = { spec[4], 1 }
					r[4] = nil
				end
			end
		end
	end
end

local function selected_recipe(self)
	local t = self.last_type
	local idx = self.selected_index
	if t and idx and self.recipes and self.recipes[t] then
		return self.recipes[t][idx]
	end
	return nil
end

local function selected_out(self)
	local out = recipe_sec(selected_recipe(self))
	if out then
		return out
	end
	local cr = self.craft_item_r
	if type(cr) == "table" and type(cr[1]) == "string" and cr[1] ~= "" then
		return cr[1]
	end
	return nil
end

local function craft_cls()
	local mod = rawget(_G, "ui_workshop") or ui_workshop
	if mod and mod.UIWorkshopCraft then
		return mod.UIWorkshopCraft
	end
	return rawget(_G, "UIWorkshopCraft")
end

local function spend_ammo_rounds(npc, section, need)
	if not (npc and section and need and need > 0) then
		return true
	end
	local stacks = utils_item.collect_amount(npc, section)
	local remain = need
	for id, cnt in pairs(stacks) do
		if remain <= 0 then
			break
		end
		local obj = dogma.alife.obj(id)
		if obj and cnt and cnt > 0 then
			if cnt <= remain then
				alife_release_id(id)
				remain = remain - cnt
			else
				obj:ammo_set_count(cnt - remain)
				remain = 0
			end
		end
	end
	return remain <= 0
end

local function update_round_ingredient(self, n, sec, amount, out_box)
	local need = amount * out_box
	local have = utils_item.get_amount(db.actor, sec) or 0
	local part = dogma.db.get(sec)
	local name = (part and part.name ~= "" and part.name) or sec

	self.craft_item[n] = {}
	self.craft_item_remain[n] = {}
	self.craft_allow[n] = false
	self._dogma_round_spend = self._dogma_round_spend or {}
	self._dogma_round_spend[n] = { sec = sec, need = need }

	self.itm_name[n]:SetText(name)
	self.itm_num[n]:SetText(tostring(have) .. "/" .. tostring(need))
	if have >= need then
		self.itm_num[n]:SetTextColor(GetARGB(200, 50, 255, 50))
		self.craft_allow[n] = true
	else
		self.itm_num[n]:SetTextColor(GetARGB(250, 255, 50, 50))
	end
	utils_xml.set_icon(sec, (not self.craft_allow[n]), self.itm_ico_temp[n], self.itm_ico[n])
end

local function patch()
	local cls = craft_cls()
	if not cls then
		return false
	end

	local wrapped_update = cls._dogma_wb_ammo_craft_update
	local wrapped_craft = cls._dogma_wb_ammo_craft_craft
	local wrapped_load = cls._dogma_wb_ammo_craft_load
	if cls[HOOK] and cls.UpdateItem == wrapped_update and cls.Craft == wrapped_craft
		and cls.LoadRecipes == wrapped_load
	then
		return true
	end

	-- Chain current handlers (vanilla or Fixed Crafting / etc.).
	local orig_update = cls.UpdateItem
	local orig_craft = cls.Craft
	local orig_load = cls.LoadRecipes
	if type(orig_update) ~= "function" or type(orig_craft) ~= "function"
		or type(orig_load) ~= "function"
	then
		return false
	end

	local function update_hook(self, n, sec, amount, result, toolkit_idx, toolkit_sec)
		-- Recipe select always fills slot 1 first; drop any prior round-spend.
		if n == 1 then
			self._dogma_round_spend = {}
		elseif n and self._dogma_round_spend then
			self._dogma_round_spend[n] = nil
		end

		if result or not n or not sec then
			return orig_update(self, n, sec, amount, result, toolkit_idx, toolkit_sec)
		end

		local out = selected_out(self)
		local spec = recipe_override(out)
		if not spec then
			return orig_update(self, n, sec, amount, result, toolkit_idx, toolkit_sec)
		end

		local part_sec, per = sec, 1
		if dogma.db.is_ammo_part(sec) then
			per = part_per_round(spec, sec)
		elseif n == 1 then
			part_sec, per = spec[1], 1
		elseif n == 2 then
			part_sec, per = spec[2], spec[3]
		elseif n == 3 then
			part_sec, per = spec[4], 1
		else
			return orig_update(self, n, sec, amount, result, toolkit_idx, toolkit_sec)
		end

		local row = dogma.db.get(out)
		local out_box = row and row.box or 0
		if not (out_box > 0 and per > 0) then
			return orig_update(self, n, sec, amount, result, toolkit_idx, toolkit_sec)
		end

		update_round_ingredient(self, n, part_sec, per, out_box)
	end

	local function craft_hook(self)
		if not self.craft_allow_r then
			return
		end

		local spend = self._dogma_round_spend
		local did_round = spend and next(spend) ~= nil
		if did_round then
			for _, entry in pairs(spend) do
				if entry and entry.sec and entry.need then
					spend_ammo_rounds(db.actor, entry.sec, entry.need)
				end
			end
			self._dogma_round_spend = {}

			-- Parts already spent as rounds; don't let orig release full boxes.
			if self.craft_item then
				for i = 1, 4 do
					self.craft_item[i] = {}
					self.craft_item_remain[i] = {}
				end
			end
		end

		return orig_craft(self)
	end

	local function load_hook(self, ...)
		orig_load(self, ...)
		apply_recipes(self)
	end

	cls.UpdateItem = update_hook
	cls.Craft = craft_hook
	cls.LoadRecipes = load_hook
	cls._dogma_wb_ammo_craft_update = update_hook
	cls._dogma_wb_ammo_craft_craft = craft_hook
	cls._dogma_wb_ammo_craft_load = load_hook
	cls[HOOK] = true
	printf("[%s] patched UIWorkshopCraft ammo recipes + round-spend", TAG)
	return true
end

function on_game_start()
	if patch() then
		return
	end
	RegisterScriptCallback("actor_on_first_update", patch)
	if not CreateTimeEvent then
		return
	end
	local tries = 0
	CreateTimeEvent("dogma_wb_ammo", "patch", 1, function()
		if patch() then
			return true
		end
		tries = tries + 1
		return tries >= 30
	end)
end
