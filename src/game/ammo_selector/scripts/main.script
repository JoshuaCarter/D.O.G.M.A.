--[[
	Ammo Selector

	Toggle: vanilla. Hold: dogma.input opens after delay, closes on release
	(optional hover-select). Gates start_ammo_wheel so vanilla release-open
	cannot fight us; stubs SwitchNextAmmo so release does not cycle ammo.
	Hold key: swallow that dik on keydown (whatever Settings bound it to).
	Release before hold_delay_ms = pulse that same dik (same path as a real
	press, so unjam scripts see it). Past delay = wheel, no reload.
]]

local CONFIG = _G.dogma_game_ammo_selector_conf
local MODE_HOLD = 2

local allow_open = false
local holding = false
local swallowed = false
local committed = false
local was_down = false
local pulsing = false

local function pulse_reload(dik)
	pulsing = true
	level.press_action(dik)
	if level.release_action then
		level.release_action(dik)
	end
	pulsing = false
end

local function clear_press()
	holding = false
	swallowed = false
	committed = false
	was_down = false
end

local function log(msg)
	if dogma.log.logging() then
		dogma.log.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function on_option_change()
	CONFIG.loaded.enabled = dogma.mcm.bool(CONFIG.MOD_ID, "enabled")
	local mode = dogma.mcm.int(CONFIG.MOD_ID, "mode")
	CONFIG.loaded.mode = (mode == MODE_HOLD) and MODE_HOLD or 0
	CONFIG.loaded.ammo_key = dogma.mcm.key(CONFIG.MOD_ID, "ammo_key")
	CONFIG.loaded.hold_delay_ms = dogma.mcm.uint(CONFIG.MOD_ID, "hold_delay_ms")
	CONFIG.loaded.select_on_release = dogma.mcm.bool(CONFIG.MOD_ID, "select_on_release")
	if not CONFIG.loaded.enabled or CONFIG.loaded.mode ~= MODE_HOLD then
		clear_press()
	end
	log(string.format(
		"opts hold=%s ammo=%s delay=%s",
		tostring(CONFIG.loaded.mode == MODE_HOLD),
		tostring(CONFIG.loaded.ammo_key),
		tostring(CONFIG.loaded.hold_delay_ms)
	))
end

local function hold_active()
	return CONFIG.loaded.enabled and CONFIG.loaded.mode == MODE_HOLD
end

-- ammo_key is a dik. bind is the engine action on that dik (often not Reload).
local function on_before_key_press(dik, bind, _dis, flags)
	if not dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return
	end
	if pulsing or not hold_active() then
		return
	end
	local ammo = CONFIG.loaded.ammo_key
	if not (ammo and ammo > 0 and dik == ammo) then
		return
	end
	if flags then
		flags.ret_value = false
	end
	swallowed = true
	log(string.format("press dik=%s bind=%s swallow", tostring(dik), tostring(bind)))
end

local function shown(gui)
	return gui and gui.IsShown and gui:IsShown()
end

local function active_gui()
	local qaw = rawget(_G, "haru_quick_action_wheel_mcm")
	if shown(qaw and qaw.GUI) then
		return qaw.GUI, "qaw"
	end
	local iw = rawget(_G, "item_weapon")
	if shown(iw and iw.GUI) then
		return iw.GUI, "iw"
	end
end

local function open()
	local iw = rawget(_G, "item_weapon")
	if not (iw and iw.start_ammo_wheel) then
		return
	end
	allow_open = true
	pcall(iw.start_ammo_wheel)
	allow_open = false
end

local function select_or_close()
	local gui, kind = active_gui()
	if not gui then
		return
	end
	if CONFIG.loaded.select_on_release then
		if kind == "qaw" and gui.hovered_idx and gui.hovered_idx ~= 0 and gui.OnButtonClick then
			gui:OnButtonClick(gui.hovered_idx)
			return
		end
		if kind == "iw" and gui.box_btn and gui.OnAmmo then
			for i = 1, (gui.ammo_max or #gui.box_btn) do
				local btn = gui.box_btn[i]
				local box = gui.box and gui.box[i]
				if btn and box and box:IsShown() and btn:IsCursorOverWindow() then
					gui:OnAmmo(i)
					return
				end
			end
		end
	end
	if gui.Close then
		gui:Close()
	end
end

local function gate(fn)
	return function(...)
		if hold_active() and not allow_open then
			return
		end
		return fn(...)
	end
end

local function ensure_gate(owner, field)
	if not owner or type(owner[field]) ~= "function" then
		return
	end
	if owner._dogma_as_wrap == owner[field] then
		return
	end
	local wrapped = gate(owner[field])
	owner[field] = wrapped
	owner._dogma_as_wrap = wrapped
end

local function ensure_no_cycle(cls)
	if not cls or type(cls.SwitchNextAmmo) ~= "function" or cls._dogma_as_cycle then
		return
	end
	local orig = cls.SwitchNextAmmo
	cls.SwitchNextAmmo = function(self, ...)
		if hold_active() then
			return
		end
		return orig(self, ...)
	end
	cls._dogma_as_cycle = true
end

local function patch()
	local rawget_ = rawget
	ensure_gate(rawget_(_G, "item_weapon"), "start_ammo_wheel")
	ensure_gate(rawget_(_G, "haru_quick_action_wheel_mcm"), "_start_ammo_wheel")
	ensure_no_cycle(rawget_(_G, "UIWheelAmmo"))
	ensure_no_cycle(rawget_(_G, "UIWheelAmmoWuut"))
end

local function tap_reload()
	if not (level and level.press_action) then
		log("tap skip: no press_action")
		return
	end
	local tap = CONFIG.loaded.ammo_key
	if not (tap and tap > 0) then
		log("tap skip: no ammo_key")
		return
	end
	local ok, err = pcall(pulse_reload, tap)
	pulsing = false
	if ok then
		log("tap key dik=" .. tostring(tap))
	else
		log("tap fail: " .. tostring(err))
	end
end

local function on_release()
	if holding then
		log("release wheel")
		select_or_close()
	elseif swallowed and not committed then
		tap_reload()
	end
	holding = false
	swallowed = false
	committed = false
end

local function actor_on_update()
	if not dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		clear_press()
		return
	end
	if not hold_active() then
		clear_press()
		return
	end
	patch()

	local dik = CONFIG.loaded.ammo_key
	if not (dik and dik > 0) then
		return
	end

	local down = dogma.input.is_key_down(dik)
	if down then
		was_down = true
		if holding then
			if not active_gui() then
				holding = false
			end
		elseif active_gui() then
			holding = true
		elseif dogma.input.is_key_held(dik, CONFIG.loaded.hold_delay_ms or 0) then
			if not committed then
				log("hold open")
			end
			committed = true
			open()
			holding = active_gui() ~= nil
		end
	elseif was_down then
		was_down = false
		on_release()
	end
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_first_update", patch)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("on_before_key_press", on_before_key_press)
end
