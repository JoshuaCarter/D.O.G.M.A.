	<string id="ui_mcm_dogma_player_campfire_page_description">
		<text>Near a lit campfire, each tick first adds temporary health on a random limb still below 80%. Only when every limb is at 80% total does it convert temporary into permanent (up to 80%) or heal main health (up to 80%).</text>
	</string>
	<string id="ui_mcm_dogma_player_campfire_enabled">
		<text>Enable</text>
	</string>
	<string id="ui_mcm_dogma_player_campfire_enabled_desc">
		<text>Heal near a lit campfire.</text>
	</string>
	<string id="ui_mcm_dogma_player_campfire_interval">
		<text>Heal interval (sec)</text>
	</string>
	<string id="ui_mcm_dogma_player_campfire_interval_desc">
		<text>Seconds between each heal tick (1–30). Lower = faster.</text>
	</string>
