function on_mcm_load(options)
	local CONFIG = _G.dogma_game_true_fast_travel_conf
	dogma_mcm.attach(options, "game", "ui_mcm_menu_dogma_game", {
		id = "true_fast_travel",
		sh = true,
		text = "ui_mcm_menu_dogma_game_true_fast_travel",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_game_true_fast_travel_page_description",
			},
			{
				id = "block_travel_when_unfit",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["block_travel_when_unfit"],
				hint = "dogma_game_true_fast_travel_block_travel_when_unfit",
			},
			{
				id = "time_factor_travel",
				type = "track",
				val = 2,
				min = 0,
				max = 1,
				step = 0.05,
				def = CONFIG.DEFAULTS["time_factor_travel"],
				hint = "dogma_game_true_fast_travel_time_factor_travel",
			},
			{
				id = "time_factor_backslide",
				type = "track",
				val = 2,
				min = 0,
				max = 1,
				step = 0.01,
				def = CONFIG.DEFAULTS["time_factor_backslide"],
				hint = "dogma_game_true_fast_travel_time_factor_backslide",
			},
			{
				id = "cam_speed_mult",
				type = "track",
				val = 2,
				min = 1,
				max = 3,
				step = 0.1,
				def = CONFIG.DEFAULTS["cam_speed_mult"],
				hint = "dogma_game_true_fast_travel_cam_speed_mult",
			},
			{
				id = "backslide_clear_m",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS["backslide_clear_m"],
				hint = "dogma_game_true_fast_travel_backslide_clear_m",
			},
			{
				id = "pause_on_stop",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["pause_on_stop"],
				hint = "dogma_game_true_fast_travel_pause_on_stop",
			},
			{
				id = "pause_on_done",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["pause_on_done"],
				hint = "dogma_game_true_fast_travel_pause_on_done",
			},
			{
				id = "show_hud_during_travel",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["show_hud_during_travel"],
				hint = "dogma_game_true_fast_travel_show_hud_during_travel",
			},
			{
				id = "screen_msg_duration",
				type = "track",
				val = 2,
				min = 0,
				max = 20,
				step = 1,
				def = CONFIG.DEFAULTS["screen_msg_duration"],
				hint = "dogma_game_true_fast_travel_screen_msg_duration",
			},
			{
				id = "path_preview",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["path_preview"],
				hint = "dogma_game_true_fast_travel_path_preview",
			},
			{
				id = "block_transition_in_combat",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["block_transition_in_combat"],
				hint = "dogma_game_true_fast_travel_block_transition_in_combat",
			},
			{
				id = "companion_teleport_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["companion_teleport_key"],
				hint = "dogma_game_true_fast_travel_companion_teleport_key",
			},
		}),
	})
end
