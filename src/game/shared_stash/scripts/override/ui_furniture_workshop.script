-- DOGMA Workshop Shared Stash
-- Based on Workshop Shared Stash v1.2 / Serious Workshop ui_furniture_workshop.
-- All portable workshops open ONE shared hidden box.

local CONFIG = _G.dogma_game_shared_stash_conf
local xobject = dogma.xlibs.xobject
local xinventory = dogma.xlibs.xinventory
local SHARED_SECTION = (CONFIG and CONFIG.SHARED_SECTION) or "dogma_game_shared_stash"
local PDA_STASH_KEY = (CONFIG and CONFIG.PDA_STASH_KEY) or "dogma_game_shared_stash"

local function pr(...)
	printf("[dogma_game_shared_stash] " .. string.format(...))
end

local function register_pda_shim(m_data, shared_id)
	if not (m_data and shared_id) then
		return
	end
	if not m_data.workshop_stashes then
		m_data.workshop_stashes = {}
	end
	m_data.workshop_stashes[PDA_STASH_KEY] = shared_id
end

local function cleanup_private_stash(workshop_id, shared_id)
	local tostr = tostring
	local m_data = alife_storage_manager.get_state()
	if not (m_data and m_data.workshop_stashes and workshop_id) then
		return
	end
	local old_id = m_data.workshop_stashes[workshop_id]
	if not old_id or old_id == shared_id then
		return
	end

	local shared_box = shared_id and xobject.go(shared_id)
	local old_box = xobject.go(old_id)
	if not old_box then
		pr("private stash %s is offline; deferring cleanup", tostr(old_id))
		return
	end

	local has_content = false
	old_box:iterate_inventory_box(function(temp, obj)
		has_content = true
		return true
	end, old_box)

	if has_content and not shared_box then
		pr("private stash %s has content; shared stash is offline, skipping cleanup", tostr(old_id))
		return
	end

	if has_content then
		old_box:iterate_inventory_box(function(temp, obj)
			xinventory.transfer_item(old_box, obj, shared_box)
		end, old_box)
	end

	local still_has_items = false
	old_box:iterate_inventory_box(function(temp, obj)
		still_has_items = true
		return true
	end, old_box)
	if still_has_items then
		pr("private stash %s still has items after migration; keeping it", tostr(old_id))
		return
	end

	xinventory.release_item_id(old_id)
	m_data.workshop_stashes[workshop_id] = nil
	pr("private stash %s released after safe cleanup", tostr(old_id))
end

local function ensure_shared_near_workshop(workshop_id)
	local tostr = tostring
	local workshop = workshop_id and xobject.go(workshop_id)
	if not workshop then
		pr("ensure: no workshop go id=%s", tostr(workshop_id))
		return nil
	end

	local m_data = alife_storage_manager.get_state()
	if not m_data then
		pr("ensure: no m_data")
		return nil
	end
	local shared_id = m_data.dogma_game_shared_stash
	local se = shared_id and xobject.se(shared_id)

	if not (se and IsInvbox(nil, se:clsid())) then
		local pos = (CONFIG.dest_at and CONFIG.dest_at(workshop)) or vec_set(workshop:position())
		se = alife_create(SHARED_SECTION, pos, workshop:level_vertex_id(), workshop:game_vertex_id())
		if not se then
			pr("ensure: alife_create failed")
			return nil
		end
		m_data.dogma_game_shared_stash = se.id
		shared_id = se.id
		alife():set_switch_online(shared_id, true)
		alife():set_switch_offline(shared_id, false)
		pr("ensure: created stash %s", tostr(shared_id))
	else
		local box = xobject.go(shared_id)
		pr("ensure: existing stash=%s online=%s", tostr(shared_id), tostr(box ~= nil))
		if not box then
			pr("ensure: stash offline, plant at workshop %s", tostr(workshop_id))
			if CONFIG and CONFIG.plant_shared then
				CONFIG.plant_shared(workshop_id)
			end
		end
	end

	register_pda_shim(m_data, shared_id)

	cleanup_private_stash(workshop_id, shared_id)

	return shared_id
end

-- Workshop Logic
function UseWorkshop(id)
	local stash_id = GetStash(id)
	CreateTimeEvent("hf_workshop", "open_workshop_" .. id, 0.1, OpenWorkshop, stash_id)
end

function CreateStash(id)
	local stash_id = ensure_shared_near_workshop(id)
	return stash_id and xobject.se(stash_id) or nil
end

function GetStash(id)
	return ensure_shared_near_workshop(id)
end

local function UseStash(workshop_id)
	local stash_id = ensure_shared_near_workshop(workshop_id)
	local box = stash_id and xobject.go(stash_id)
	if not box then
		pr("use: waiting go workshop=%s stash=%s", tostring(workshop_id), tostring(stash_id))
		return false
	end
	pr("use: opening stash %s", tostring(stash_id))
	hide_hud_inventory()
	box:use(db.actor)
	return true
end

function GiveStashItemsToActor(workshop_id, stash_id)
	local items = {}

	if stash_id then
		local stash_obj = xobject.go(stash_id)
		if not stash_obj then
			return false
		end
		stash_obj:iterate_inventory_box(function(temp, obj)
			items[#items + 1] = obj:id()
			xinventory.transfer_item(stash_obj, obj, db.actor)
		end, stash_obj)
	end

	if zzz_workshop_return_items then
		zzz_workshop_return_items.item_ids = items
		zzz_workshop_return_items.stash_id = stash_id
	end
	return true
end

function OpenWorkshop(stashId)
	if stashId and not xobject.go(stashId) then
		pr("open workshop: waiting stash go %s", tostring(stashId))
		return false
	end
	if not (ui_workshop and ui_workshop.get_workshop_ui) then
		return true
	end

	workshop_ui_ref = ui_workshop.get_workshop_ui(nil, nil, { false, false, false, false, false }, false, stashId)
	if workshop_ui_ref then
		workshop_ui_ref:ShowDialog(true)
		workshop_ui_ref.dlg_craft.stashId = stashId
		workshop_ui_ref.dlg_upgrade.stashId = stashId
		workshop_ui_ref.dlg_state.stashId = stashId
		workshop_ui_ref.dlg_repair.stashId = stashId
		workshop_ui_ref.stashId = stashId
	end
	return true
end

-- UI
local ratio = utils_xml.screen_ratio()
GUI = nil

class "UIFurnitureWorkshop" (CUIScriptWnd)

function UIFurnitureWorkshop:__init() super()
	self:InitControls()
	self:InitCallbacks()
end

function UIFurnitureWorkshop:__finalize()
	GUI = nil
end

function UIFurnitureWorkshop:InitControls()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self.wide = (device().width / device().height) > (1024 / 768 + 0.01)

	self:SetAutoDelete(true)

	local xml = CScriptXmlInit()
	xml:ParseFile("ui_furniture_workshop_dialog.xml")

	self.back = xml:InitFrame("background", self)

	self.icon = xml:InitStatic("icon", self.back)
	self.icon:SetWndSize(vector2():set(self.icon:GetWidth(), self.icon:GetWidth() / ratio))

	self.btn_pickup = xml:Init3tButton("btn_pickup", self.back)
	self:Register(self.btn_pickup, "btn_pickup")

	self.btn_close = xml:Init3tButton("btn_close", self.back)
	self:Register(self.btn_close, "btn_close")

	self.btn_access_stash = xml:Init3tButton("btn_access_stash", self.back)
	self:Register(self.btn_access_stash, "btn_access_stash")

	self.btn_use_workshop = xml:Init3tButton("btn_use_workshop", self.back)
	self:Register(self.btn_use_workshop, "btn_use_workshop")
end

function UIFurnitureWorkshop:UseWorkshop()
	UseWorkshop(self.obj_id)
	self:Close()
end

function UIFurnitureWorkshop:AccessStash()
	local tostr = tostring
	pr("access click workshop=%s", tostr(self.obj_id))
	local stash_id = GetStash(self.obj_id)
	if not stash_id then
		pr("access abort: GetStash nil")
		return
	end
	self:Close()
	pr("access queued open_stash workshop=%s stash=%s", tostr(self.obj_id), tostr(stash_id))
	CreateTimeEvent("hf_workshop", "open_stash_" .. tostr(self.obj_id), 0.1, UseStash, self.obj_id)
end

function UIFurnitureWorkshop:Pickup()
	local obj = self.obj_id and xobject.go(self.obj_id)
	if not obj then
		self:Close()
		return
	end
	local binder = obj:binded_object()
	local wrapper = binder and binder.wrapper
	if wrapper and wrapper.pickup then
		wrapper:pickup()
	end
	self:Close()
end

function UIFurnitureWorkshop:InitCallbacks()
	self:AddCallback("btn_access_stash", ui_events.BUTTON_CLICKED, self.AccessStash, self)
	self:AddCallback("btn_pickup", ui_events.BUTTON_CLICKED, self.Pickup, self)
	self:AddCallback("btn_use_workshop", ui_events.BUTTON_CLICKED, self.UseWorkshop, self)
	self:AddCallback("btn_close", ui_events.BUTTON_CLICKED, self.Close, self)
end

function UIFurnitureWorkshop:TestAndShow(obj_id)
	self.obj_id = obj_id
	self:ShowDialog(true)
	Register_UI("UIFurnitureWorkshop", "ui_hf_workshop")
end

function UIFurnitureWorkshop:Update()
	CUIScriptWnd.Update(self)
end

function UIFurnitureWorkshop:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if res == false then
		if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
			if dik == DIK_keys.DIK_ESCAPE then
				self:Close()
			end
		end
	end
	return res
end

function UIFurnitureWorkshop:Close()
	if self:IsShown() then
		self:HideDialog()
	end
	Unregister_UI("UIFurnitureWorkshop")
end

function start_dialog(obj_id)
	if GUI == nil then
		GUI = UIFurnitureWorkshop()
	end
	GUI:TestAndShow(obj_id)
end
