		<text>Stat row placement</text>
	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_stat_row_placement_desc">
		<text>Where new stats list rows go. Hit Power / Dmg vs Stalkers / Dmg vs Mutants always lead unless End of list.</text>
	</string>
