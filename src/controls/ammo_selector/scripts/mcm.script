-- Ammo Selector MCM — Hold mode key + Toggle / Hold mode.

local CONFIG = _G.dogma_controls_ammo_selector_conf

function on_mcm_load(options)
	local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
	dogma_mcm.attach(options, "controls", "ui_mcm_menu_dogma_controls", {
		id = "ammo_selector",
		sh = true,
		text = "ui_mcm_menu_dogma_controls_ammo_selector",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_controls_ammo_selector_page_description",
			},
			{
				id = "ammo_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["ammo_key"],
				hint = "dogma_controls_ammo_selector_ammo_key",
			},
			{
				id = "mode",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS["mode"],
				hint = "dogma_controls_ammo_selector_mode",
				content = {
					{ 0, "toggle" },
					{ 2, "hold" },
				},
			},
			{
				id = "hold_delay_ms",
				type = "track",
				val = 2,
				min = 0,
				max = 1000,
				step = 25,
				def = CONFIG.DEFAULTS["hold_delay_ms"],
				hint = "dogma_controls_ammo_selector_hold_delay_ms",
			},
			{
				id = "select_on_release",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["select_on_release"],
				hint = "dogma_controls_ammo_selector_select_on_release",
			},
		}),
	})
end
