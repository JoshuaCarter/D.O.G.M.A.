--[[
	Solo Guides & Escorts

	Guide jobs + friend/paid hire: only the speaker joins.
	- Offline squad mates are removed (they would pop in on accept).
	- Online squad mates are moved to leftover squads (not deleted).
	Hostage join and story/special companions (full story squads included) are untouched.
	Actor squad size limits stay with stock companion systems.

	Note: become_actor_companion is usually attached to NPC reply phrases, so the
	engine passes (npc, actor). Always resolve with dialogs.who_is_npc first —
	gating on is_non_story(second_arg) before that skips the strip and the whole
	squad joins.
]]

local CONFIG = _G.dogma_tweaks_escorts_have_no_friends_conf

local function log(msg)
	if dogma.dbg.logging() then
		dogma.dbg.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function is_hostage(actor, npc)
	local d = dialogs_axr_companion
	return d and d.is_hostage_task_giver and d.is_hostage_task_giver(actor, npc)
end

-- Story / special / unclassified → leave stock behaviour (full squads ok).
-- `npc` must already be the real NPC (who_is_npc), not a raw dialog speaker.
local function is_hire_or_guide(mod, actor, npc)
	if not (mod and mod.is_non_story) then
		return false
	end
	-- is_non_story only inspects the second arg's squad.
	if not mod.is_non_story(actor, npc) then
		return false
	end
	return not is_hostage(actor, npc)
end

local function member_online(id)
	local se = xobject.se(id)
	if se and se.online then
		return true
	end
	local client = xobject.go(id)
	return client and client:alive() and true or false
end

local function remove_members(squad, ids)
	for i = 1, #ids do
		if squad.remove_npc then
			squad:remove_npc(ids[i], true)
		end
	end
end

-- Useful Idiots pattern: alife_create(section) makes an empty squad container
-- (NPCs spawn only via create_npc). Move one leftover into it.
-- Note: xsquad.create_squad spawns a full roster — not used here.
local function rehome_one(squad, id)
	local se = xobject.se(id)
	local section = squad:section_name()
	if not (se and section) then
		return false
	end
	local pos = se.position
	local lvid = se.m_level_vertex_id
	local gvid = se.m_game_vertex_id
	local new_squad = alife_create(section, pos, lvid, gvid)
	if not new_squad then
		return false
	end
	squad:unregister_member(id)
	new_squad:register_member(id)
	if SIMBOARD and SIMBOARD.setup_squad_and_group then
		SIMBOARD:setup_squad_and_group(se)
	end
	if new_squad.refresh then
		new_squad:refresh()
	end
	local smart = xsmart.get_actor_smart()
	if smart then
		xsmart.assign_squad_to_smart(new_squad, smart.id)
	end
	return true
end

-- Offline mates: remove (prevent pop-in). Online mates: rehome, don't delete.
-- Always verify the speaker squad is solo afterward.
local function strip_to_speaker(npc)
	local squad = xsquad.get_squad_by_member(npc:id())
	if not squad then
		return
	end
	local keep_id = npc:id()
	local offline = {}
	local online = {}
	for mid in xsquad.iter_member_ids(squad) do
		if mid and mid ~= keep_id then
			if member_online(mid) then
				online[#online + 1] = mid
			else
				offline[#offline + 1] = mid
			end
		end
	end
	if #offline + #online == 0 then
		return
	end
	log(string.format("strip id=%s offline=%d online=%d", tostring(keep_id), #offline, #online))
	remove_members(squad, offline)
	for i = 1, #online do
		if not rehome_one(squad, online[i]) then
			remove_members(squad, { online[i] })
		end
	end
	if squad.refresh then
		squad:refresh()
	end
	-- Solo guarantee: anything still attached gets force-removed.
	local still = {}
	for mid in xsquad.iter_member_ids(squad) do
		if mid and mid ~= keep_id then
			still[#still + 1] = mid
		end
	end
	if #still > 0 then
		log(string.format("strip fallback remove %d still attached", #still))
		remove_members(squad, still)
	end
end

local function become_solo_hire_or_guide(first, second, orig)
	local npc = dialogs.who_is_npc(first, second)
	strip_to_speaker(npc)
	orig(first, second)
end

-- Stock is_room uses joining squad size; after strip only the speaker joins.
local function room_for_solo(actor, npc, orig_room)
	if not (axr_companions and axr_companions.get_companion_count and axr_companions.max_actor_squad_size) then
		return orig_room(actor, npc)
	end
	local max_size = axr_companions.max_actor_squad_size
		+ (game_achievements and game_achievements.has_achievement and game_achievements.has_achievement("patriarch") and 2 or 0)
	return axr_companions.get_companion_count() + 1 <= max_size
end

local function patch_module(mod)
	if not mod or mod.__dogma_tweaks_escorts_have_no_friends then
		return
	end

	local orig_become = mod.become_actor_companion
	if orig_become then
		mod.become_actor_companion = function(first, second)
			local npc = dialogs.who_is_npc(first, second)
			-- Story squads usually use add_special_squad; if they hit this path,
			-- is_non_story is false when the squad has a story id - leave intact.
			if not is_hire_or_guide(mod, db.actor or first, npc) then
				return orig_become(first, second)
			end
			return become_solo_hire_or_guide(first, second, orig_become)
		end
	end

	local orig_room = mod.is_room_in_actor_squad
	if orig_room then
		mod.is_room_in_actor_squad = function(first, second)
			local npc = dialogs.who_is_npc(first, second)
			if not is_hire_or_guide(mod, db.actor or first, npc) then
				return orig_room(first, second)
			end
			return room_for_solo(first, second, orig_room)
		end
	end

	mod.__dogma_tweaks_escorts_have_no_friends = true
	log("patched " .. tostring(mod))
end

local function patch_all()
	patch_module(dialogs_axr_companion)
	if rawget(_G, "dialogs_axr_companion2") then
		patch_module(dialogs_axr_companion2)
	end
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	patch_all()
	RegisterScriptCallback("on_game_load", patch_all)
	log("solo companions ready")
end
