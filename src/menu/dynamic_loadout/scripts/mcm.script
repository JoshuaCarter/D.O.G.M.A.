--[[
	Dynamic Loadout - main-menu scan/score + New Game LoadLoadout fill.

	Must live in *mcm.script so it loads at the New Game screen.
	_conf.script is prepended by the build.

	Hooks LoadLoadout only: fills the inventory panel with scored free supply.
	Also hooks UINewGame.OnQuit (clear cached dlg) + main_menu.ShowFactionUI so
	re-opening New Game rescans. Does not touch OnRandomize.
]]

local CONFIG = _G.dogma_menu_dynamic_loadout_conf
local MOD_ID = CONFIG.MOD_ID
local STATE = _G.__dogma_menu_dynamic_loadout or {}
_G.__dogma_menu_dynamic_loadout = STATE

-- While MCM preview is open: live track-bar values (pending, not axr save).
local LIVE_CFG = nil

--------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------

local function cfg(key)
	if LIVE_CFG and LIVE_CFG[key] ~= nil then
		return LIVE_CFG[key]
	end
	local def = CONFIG.DEFAULTS[key]
	if ui_mcm then
		local ok, value = pcall(ui_mcm.get, MOD_ID .. "/" .. key)
		if ok and value ~= nil then
			return value
		end
	end
	return def
end

local function cfg_bool(key)
	local v = cfg(key)
	return v == true or v == 1
end

local function cfg_num(key)
	return tonumber(cfg(key)) or tonumber(CONFIG.DEFAULTS[key]) or 0
end

local function dlog(msg)
	if not cfg_bool("log_scores") then
		return
	end
	printf("[dogma_menu_dynamic_loadout] %s", tostring(msg))
end

-- Full term-by-term CALC dumps: weapons only for now (ammo/armor/helm later).
local function is_debug_score_sec(sec)
	if not sec or string.sub(sec, 1, 4) ~= "wpn_" then
		return false
	end
	local map = CONFIG.DEBUG_SCORE_SECS
	return map and map[sec] == true
end

local function explode_csv(s)
	local out = {}
	if not s or s == "" then
		return out
	end
	for part in string.gmatch(s, "([^,]+)") do
		local t = part:match("^%s*(.-)%s*$")
		if t and t ~= "" then
			out[#out + 1] = t
		end
	end
	return out
end

local function ini_float(sec, key, default)
	local v = ini_sys:r_float_ex(sec, key)
	if v == nil then
		return default
	end
	return v
end

local function ini_str(sec, key, default)
	return ini_sys:r_string_ex(sec, key) or default
end

local function is_ap_ammo(sec)
	local s = string.lower(sec or "")
	if string.find(s, "_ap", 1, true) then
		return true
	end
	return false
end

-- GL / RPG rounds (VOG, M209, OG-7B, …). Flag is set on the ammo section.
local function is_explosive_ammo(sec)
	if not sec or sec == "" then
		return false
	end
	local g = ini_str(sec, "grenade_ammo", nil)
	if g and string.lower(tostring(g)) == "true" then
		return true
	end
	local ex = ini_str(sec, "explosive", nil)
	if ex and string.lower(tostring(ex)) == "true" then
		return true
	end
	return false
end

-- Conditioned / degraded boxes (..._bad, ..._verybad).
local function is_bad_ammo(sec)
	local s = string.lower(sec or "")
	if string.find(s, "_verybad", 1, true) then
		return true
	end
	if string.find(s, "_bad", 1, true) then
		return true
	end
	return false
end

local function has_installed_upgrades(sec)
	local v = ini_str(sec, "installed_upgrades", "")
	if not v or v == "" then
		return false
	end
	return string.match(v, "%S") ~= nil
end

local function is_excluded_misc(sec)
	local s = string.lower(sec or "")
	if string.find(s, "dynamo", 1, true) then
		return true
	end
	if string.find(s, "upgrade", 1, true) then
		return true
	end
	if has_installed_upgrades(sec) then
		return true
	end
	return false
end

-- Multiplayer / sim / world props - same icons as real wpn_* and should never be shop gear.
local function is_junk_gear_sec(sec)
	local s = string.lower(sec or "")
	if string.sub(s, 1, 3) == "mp_" then
		return true
	end
	if string.sub(s, 1, 8) == "up_sect_" then
		return true
	end
	if string.find(s, "simulation_", 1, true) then
		return true
	end
	if string.find(s, "helicopter", 1, true) then
		return true
	end
	if string.find(s, "mounted_weapon", 1, true) or s == "mounted_weapon" then
		return true
	end
	if string.find(s, "stationary", 1, true) then
		return true
	end
	if string.find(s, "deployable", 1, true) then
		return true
	end
	if string.find(s, "new_tasks_", 1, true) then
		return true
	end
	return false
end

-- Skin / quest clones (wpn_pm_actor, wpn_ak74_custom) when the base section exists.
local VARIANT_SUFFIXES = { "_actor", "_custom", "_nimble", "_quest", "_unique" }

local function is_named_variant(sec)
	for i = 1, #VARIANT_SUFFIXES do
		local suf = VARIANT_SUFFIXES[i]
		if #sec > #suf and string.sub(sec, -#suf) == suf then
			local base = string.sub(sec, 1, #sec - #suf)
			if base ~= "" and ini_sys:section_exist(base) then
				return true
			end
		end
	end
	return false
end

local function is_backpack(sec)
	local s = string.lower(sec or "")
	return string.find(s, "backpack", 1, true) ~= nil
end

--------------------------------------------------------------------------
-- Kit / special exclusions
--------------------------------------------------------------------------

local KIT_SET = {}
for _, id in ipairs(CONFIG.KIT_IDS) do
	KIT_SET[id] = true
end

local function is_kit_result(sec)
	for kit, _ in pairs(KIT_SET) do
		if sec ~= kit and string.find(sec, "_" .. kit, 1, true) then
			return true
		end
	end
	return false
end

-- Scope-mounted child sections (wpn_ak74_acog): parent differs from self.
local function is_scope_child(sec)
	local parent = ini_str(sec, "parent_section", sec)
	return parent ~= sec
end

local function is_special_sight(sec)
	local sfind = string.find
	local visual = string.lower(ini_str(sec, "visual", ""))
	local name = string.lower(sec)
	if sfind(visual, "nvg", 1, true) or sfind(name, "nvg", 1, true) then
		return true
	end
	if sfind(visual, "thermal", 1, true) or sfind(name, "thermal", 1, true) then
		return true
	end
	if sfind(name, "pnv", 1, true) or sfind(name, "night", 1, true) then
		return true
	end
	-- Dual / secondary reflex style names
	if sfind(name, "dual", 1, true) or sfind(name, "2nd", 1, true) then
		return true
	end
	if ini_float(sec, "scope_nightvision", 0) > 0 then
		return true
	end
	return false
end

--------------------------------------------------------------------------
-- Ammo bloc (NATO / WP)
--------------------------------------------------------------------------

local function ammo_bloc(ammo_sec)
	local sfind = string.find
	if not ammo_sec then
		return "unknown"
	end
	local s = string.lower(ammo_sec)
	if sfind(s, "5.56", 1, true) or sfind(s, "7.62x51", 1, true)
		or sfind(s, "9x19", 1, true) or sfind(s, "5.7", 1, true)
		or sfind(s, "11.43", 1, true) or sfind(s, "338", 1, true)
		or sfind(s, "7.92", 1, true) or sfind(s, "357", 1, true)
		or sfind(s, "nato", 1, true) then
		return "nato"
	end
	if sfind(s, "5.45", 1, true) or sfind(s, "7.62x39", 1, true)
		or sfind(s, "7.62x54", 1, true) or sfind(s, "9x39", 1, true)
		or sfind(s, "9x18", 1, true) or sfind(s, "7.62x25", 1, true)
		or sfind(s, "23x75", 1, true) or sfind(s, "12.7", 1, true)
		or sfind(s, "9x21", 1, true) then
		return "wp"
	end
	-- Shotgun / shared
	if sfind(s, "12x70", 1, true) or sfind(s, "12x76", 1, true)
		or sfind(s, "20x70", 1, true) then
		return "both"
	end
	return "unknown"
end

local function weapon_bloc(sec)
	local ammo_class = ini_str(sec, "ammo_class", "")
	local ammos = explode_csv(ammo_class)
	local seen = {}
	for _, a in ipairs(ammos) do
		local b = ammo_bloc(a)
		if b ~= "unknown" then
			seen[b] = true
		end
	end
	if seen.nato and seen.wp then
		return "both"
	end
	if seen.nato then
		return "nato"
	end
	if seen.wp then
		return "wp"
	end
	if seen.both then
		return "both"
	end
	return "unknown"
end

local function bloc_ok(item_bloc, faction_bloc)
	if faction_bloc == "both" or item_bloc == "both" or item_bloc == "unknown" then
		return true
	end
	return item_bloc == faction_bloc
end

--------------------------------------------------------------------------
-- Simplified combat score (prefer dogma_ballistics / tooltips table math)
--------------------------------------------------------------------------

local function ballistics()
	return _G.dogma_ballistics or _G.dogma_tooltips_weapons_ballistics
end

--------------------------------------------------------------------------
-- Scan
--------------------------------------------------------------------------

local function is_weapon_sec(sec)
	if is_excluded_misc(sec) or is_junk_gear_sec(sec) then
		return false
	end
	if is_named_variant(sec) then
		return false
	end
	local ammo = ini_str(sec, "ammo_class", nil)
	if not ammo or ammo == "" then
		return false
	end
	if IsItem and IsItem("fake_ammo_wpn", sec) then
		return false
	end
	local kind = ini_str(sec, "kind", "")
	if kind == "w_misc" or kind == "w_explosive" then
		return false
	end
	-- Knives / binocs / tools that look like guns
	if sec == "wpn_knife" or string.find(sec, "binoc", 1, true) then
		return false
	end
	if is_kit_result(sec) then
		return false
	end
	if is_scope_child(sec) then
		return false
	end
	return true
end

-- Gear we replace in the New Game shop: weapon / ammo / outfit / helmet only.
local function gear_kind(sec)
	if not sec or sec == "" or not ini_sys:section_exist(sec) then
		return nil
	end
	if is_excluded_misc(sec) or is_junk_gear_sec(sec) then
		return nil
	end
	if IsItem and IsItem("ammo", sec) then
		return "ammo"
	end
	if IsItem and IsItem("outfit", sec) then
		return "outfit"
	end
	if IsItem and IsItem("helmet", sec) then
		return "helmet"
	end
	local cls = ini_str(sec, "class", "")
	local kind = ini_str(sec, "kind", "")
	if cls == "AMMO" then
		return "ammo"
	end
	if kind == "o_light" or kind == "o_medium" or kind == "o_heavy" then
		return "outfit"
	end
	if is_weapon_sec(sec) then
		return "weapon"
	end
	return nil
end

-- Pre-exclude + cheapness soft ceiling (hardcoded, not MCM).
local MAX_COST = {
	weapon = 30000,
	armor = 100000,
	helmet = 20000,
	ammo = 10000,
	sight = 7000,
}

local function scan_all()
	local pairs_ = pairs
	local weapons, armors, helmets, ammos, sights = {}, {}, {}, {}, {}
	local skipped_cost = { weapon = 0, armor = 0, helmet = 0, ammo = 0 }

	local function under_max_cost(sec, max_cost)
		if not max_cost or max_cost <= 0 then
			return true
		end
		local c = ini_float(sec, "cost", 0)
		return c <= max_cost
	end

	local function push_weapon(sec)
		if not under_max_cost(sec, MAX_COST.weapon) then
			skipped_cost.weapon = skipped_cost.weapon + 1
			return
		end
		weapons[#weapons + 1] = sec
	end
	local function push_ammo(sec)
		if is_ap_ammo(sec) or is_explosive_ammo(sec) or is_bad_ammo(sec) or is_excluded_misc(sec) or is_junk_gear_sec(sec) then
			return
		end
		if not under_max_cost(sec, MAX_COST.ammo) then
			skipped_cost.ammo = skipped_cost.ammo + 1
			return
		end
		ammos[#ammos + 1] = sec
	end
	local function push_armor(sec)
		if is_excluded_misc(sec) or is_junk_gear_sec(sec) then
			return
		end
		if not under_max_cost(sec, MAX_COST.armor) then
			skipped_cost.armor = skipped_cost.armor + 1
			return
		end
		armors[#armors + 1] = sec
	end
	local function push_helm(sec)
		if is_excluded_misc(sec) or is_junk_gear_sec(sec) then
			return
		end
		if not under_max_cost(sec, MAX_COST.helmet) then
			skipped_cost.helmet = skipped_cost.helmet + 1
			return
		end
		helmets[#helmets + 1] = sec
	end
	local function push_sight(sec)
		-- Sights are not part of the shop supply (weapon/ammo/outfit/helmet only).
	end

	if GetItemList then
		local list = GetItemList("ammo")
		if list then
			for sec, _ in pairs_(list) do
				push_ammo(sec)
			end
		end
		list = GetItemList("outfit")
		if list then
			for sec, _ in pairs_(list) do
				push_armor(sec)
			end
		end
		list = GetItemList("helmet")
		if list then
			for sec, _ in pairs_(list) do
				push_helm(sec)
			end
		end
		list = GetItemList("scope")
		if list then
			for sec, _ in pairs_(list) do
				push_sight(sec)
			end
		end
	end

	ini_sys:section_for_each(function(sec)
		if is_weapon_sec(sec) then
			push_weapon(sec)
		elseif not GetItemList then
			local cls = ini_str(sec, "class", "")
			local kind = ini_str(sec, "kind", "")
			if cls == "AMMO" or (IsItem and IsItem("ammo", sec)) then
				push_ammo(sec)
			elseif kind == "o_light" or kind == "o_medium" or kind == "o_heavy"
				or (IsItem and IsItem("outfit", sec)) then
				push_armor(sec)
			elseif IsItem and IsItem("helmet", sec) then
				push_helm(sec)
			elseif cls == "WP_SCOPE" or (IsItem and IsItem("scope", sec)) then
				push_sight(sec)
			end
		end
		return false
	end)

	dlog(string.format(
		"scan: weapons=%d armors=%d helmets=%d ammos=%d sights=%d",
		#weapons, #armors, #helmets, #ammos, #sights
	))
	dlog(string.format(
		"scan cost-prefilter skipped: weapons=%d (>%d) armors=%d (>%d) helmets=%d (>%d) ammos=%d (>%d)",
		skipped_cost.weapon, MAX_COST.weapon,
		skipped_cost.armor, MAX_COST.armor,
		skipped_cost.helmet, MAX_COST.helmet,
		skipped_cost.ammo, MAX_COST.ammo
	))

	return {
		weapons = weapons,
		armors = armors,
		helmets = helmets,
		ammos = ammos,
		sights = sights,
	}
end

--------------------------------------------------------------------------
-- Score
--------------------------------------------------------------------------

-- Ammo cost range scan removed: price uses hardcoded MAX_COST.ammo only.
local function item_cost(sec)
	return ini_float(sec, "cost", 0)
end

-- Section-only weapon handling stats (mirrors tooltips/stats math, no live obj).
local BURST_KICK_DEG = 3

local function wpn_burst_shots(sec)
	local zoom_disp = ini_float(sec, "zoom_cam_dispersion", 0)
	local hip_disp = ini_float(sec, "cam_dispersion", 0)
	local use_zoom = zoom_disp > 0
	local disp = use_zoom and zoom_disp or hip_disp
	local max_shots = 200
	if disp <= 0 then
		return max_shots
	end
	local inc = ini_float(sec, "zoom_cam_dispersion_inc", 0)
	if inc == 0 then
		inc = ini_float(sec, "cam_dispersion_inc", 0)
	end
	local return_on = true
	if ini_sys:line_exist(sec, "cam_return") then
		return_on = ini_float(sec, "cam_return", 1) ~= 0
	end
	local relax = 0
	local dt = 0
	if return_on then
		relax = ini_float(sec, "zoom_cam_relax_speed", 0)
		if relax <= 0 then
			relax = ini_float(sec, "cam_relax_speed", 0)
		end
		local rpm = ini_float(sec, "rpm", 0)
		if rpm > 0 then
			dt = 60 / rpm
		end
	end
	local angle = 0
	local thr = BURST_KICK_DEG
	for n = 1, max_shots do
		local kick = disp + inc * (n - 1)
		if kick < 0 then
			kick = 0
		end
		local prev = angle
		angle = angle + kick
		if angle >= thr then
			local shots = n
			if kick > 0 and prev < thr then
				shots = (n - 1) + (thr - prev) / kick
			end
			if shots < 1 then
				shots = 1
			end
			return shots
		end
		if return_on and relax > 0 and dt > 0 then
			angle = angle - relax * dt
			if angle < 0 then
				angle = 0
			end
		end
	end
	return max_shots
end

-- Clamp to [0,1].
local function clamp01(t)
	if t < 0 then
		return 0
	end
	if t > 1 then
		return 1
	end
	return t
end

-- Per-category pts scale (shop pts = avg01 * cost_mult_<kind>).
local function cost_mult_for(kind)
	local key = "cost_mult_" .. tostring(kind or "weapon")
	local v = cfg_num(key)
	if v and v > 0 then
		return v
	end
	-- Legacy single slider if still present in saved MCM.
	local legacy = tonumber(cfg("cost_mult"))
	if legacy and legacy > 0 then
		return legacy
	end
	return 1000
end

local function score_to_points(avg01, kind)
	local scale = cost_mult_for(kind)
	local pts = math.floor((avg01 or 0) * scale + 0.5)
	if pts < 1 then
		pts = 1
	end
	return pts
end

-- Weighted average of 0..1 stats: sum(n01*w) / sum_w (weights <=0 skipped).
local function avg_state_new()
	return { sum_nw = 0, sum_w = 0, n = 0, lines = {} }
end

local function avg_add(st, label, raw_stat, n01, wkey, debug)
	local w = cfg_num(wkey)
	if not w or w <= 0 then
		if debug then
			st.lines[#st.lines + 1] = string.format(
				"  %s: %.4g * 0 = skip",
				label, raw_stat or 0
			)
		end
		return
	end
	local n = clamp01(n01 or 0)
	local final = n * w
	st.sum_nw = st.sum_nw + final
	st.sum_w = st.sum_w + w
	st.n = st.n + 1
	if debug then
		-- raw * weight = contribution (n01*w). No intermediate "base" step.
		st.lines[#st.lines + 1] = string.format(
			"  %s: %.4g * %.2f = %.4f",
			label, raw_stat or 0, w, final
		)
	end
end

local function avg_finish(st)
	if not st or st.sum_w <= 0 then
		return 0
	end
	return st.sum_nw / st.sum_w
end

-- Flat linear map raw -> 0..1 using a soft ceiling (outliers clamp to 1).
local function norm01(raw, max_v)
	if not raw or raw ~= raw then
		return 0
	end
	if not max_v or max_v <= 0 then
		return 0
	end
	return clamp01(raw / max_v)
end

-- Soft ceilings for weapon stats (ignore gauss-tier outliers).
local NORM = {
	dps = 800,       -- sustained dps soft ceiling per armor column
	burst = 10,      -- shots to ~3 deg climb (0-10 -> 0-1)
	spread_ads = 1,  -- ADS/base  deg (lower better -> inv scale)
	spread_hip = 10, -- hip-run  deg (lower better -> inv scale)
	zoom = 10,       -- scope_zoom_factor
	ammo_ratio = 200, -- k_hit / k_ap
}

-- Dump-mag sustained DPS: all hits, max RoF, full mag, then empty→full reload.
-- dps = (dmg × mag) / (mag×60/rpm + reload_s)
local function sustained_dps(dmg, rpm, mag, reload_s)
	dmg = dmg or 0
	rpm = rpm or 0
	mag = mag or 0
	reload_s = reload_s or 0
	if dmg <= 0 or mag <= 0 or rpm <= 0 then
		return 0
	end
	local fire_s = mag * 60 / rpm
	local cycle = fire_s + math.max(0, reload_s)
	if cycle <= 0 then
		return 0
	end
	return dmg * mag / cycle
end

-- Tip motion-length reload; fallback if nil (main-menu / missing anims).
local function reload_seconds_for(sec, mag, use_mag)
	local tip = _G.dogma_tooltips_weapons
	if tip and tip.weapon_reload_seconds then
		local ok, t = pcall(tip.weapon_reload_seconds, sec)
		if ok and type(t) == "number" and t > 0 then
			return t
		end
	end
	local S = rawget(_G, "zzzz_dogma_tooltips_weapons_stats")
	if S and S.weapon_reload_seconds then
		local ok, t = pcall(S.weapon_reload_seconds, sec)
		if ok and type(t) == "number" and t > 0 then
			return t
		end
	end
	mag = mag or 1
	if use_mag == 0 then
		-- Rough tube/break empty→full: open/close + per-round.
		return 1.2 + 0.7 * math.max(mag, 1)
	end
	return 2.5
end

-- Lower-is-better linear map: 0 -> 1, max_v -> 0.
local function inv_norm01(raw, max_v)
	if not raw or raw ~= raw then
		return 1
	end
	if not max_v or max_v <= 0 then
		return 0
	end
	return clamp01(1 - raw / max_v)
end

local function score_ammo(sec)
	local k_hit = ini_float(sec, "k_hit", 1)
	local k_ap = ini_float(sec, "k_ap", 0.001)
	if k_ap <= 0 then
		k_ap = 0.001
	end
	local ratio = k_hit / k_ap
	local cost = item_cost(sec)
	local ratio_n = norm01(ratio, NORM.ammo_ratio)
	local price_n = inv_norm01(cost, MAX_COST.ammo)
	local st = avg_state_new()
	avg_add(st, "dmg/ap_ratio", ratio, ratio_n, "ammo_dmg_ap", false)
	avg_add(st, "price", cost, price_n, "ammo_price", false)
	local avg = avg_finish(st)
	local detail = string.format(
		"hit=%.3f ap=%.4f ratio=%.3f->%.3f cost=%.0f price=%.3f",
		k_hit, k_ap, ratio, ratio_n, cost, price_n
	)
	return avg, detail
end

local function score_armor(sec)
	local parts = {}
	local st = avg_state_new()
	local keys = CONFIG.PROT_KEYS or {}
	for i = 1, #keys do
		local entry = keys[i]
		local v = ini_float(sec, entry.key, 0)
		local n = clamp01(v) -- protections are already ~0..1
		avg_add(st, entry.cfg, v, n, entry.cfg, false)
		if v > 0 then
			parts[#parts + 1] = string.format("%s=%.3f->%.3f", entry.cfg, v, n)
		end
	end
	-- Price: 1 at cost 0, 0 at MAX_COST (armor/helm).
	local cost = item_cost(sec) or 0
	local is_helm = (IsItem and IsItem("helmet", sec))
		or (string.find(sec, "helm", 1, true) ~= nil)
	local soft = is_helm and MAX_COST.helmet or MAX_COST.armor
	local cost_n = inv_norm01(cost, soft)
	avg_add(st, "price", cost, cost_n, "a_price", false)
	parts[#parts + 1] = string.format("price=%.0f->%.3f", cost, cost_n)
	local avg = avg_finish(st)
	return avg, table.concat(parts, ",")
end

local function score_sight(sec)
	local zoom = ini_float(sec, "scope_zoom_factor", 1)
	if zoom < 1 then
		zoom = 1
	end
	local zoom_n = norm01(zoom, NORM.zoom)
	local st = avg_state_new()
	avg_add(st, "zoom", zoom, zoom_n, "sight_zoom", false)
	local cost = item_cost(sec) or 0
	local price_n = inv_norm01(cost, MAX_COST.sight)
	avg_add(st, "price", cost, price_n, "sight_price", false)
	return avg_finish(st), string.format("zoom=%.2f->%.3f cost=%.0f price=%.3f", zoom, zoom_n, cost or 0, price_n)
end

local function score_weapon(sec)
	local debug = is_debug_score_sec(sec)
	local B = ballistics()
	local rpm = ini_float(sec, "rpm", 0)
	local mag = ini_float(sec, "ammo_mag_size", 0)
	local scope_status = ini_float(sec, "scope_status", 0)
	local sil_status = ini_float(sec, "silencer_status", 0)
	local burst = wpn_burst_shots(sec)

	local spread_ads, spread_hip = 0, 0
	if B and B.weapon_spread_pair then
		spread_ads, spread_hip = B.weapon_spread_pair(sec)
	else
		spread_ads = ini_float(sec, "fire_dispersion_base", 0)
		spread_hip = spread_ads
	end
	local ads_n = inv_norm01(spread_ads, NORM.spread_ads)
	local hip_n = inv_norm01(spread_hip, NORM.spread_hip)

	local col_dmg = {
		{ key = "mut_dps", w = "w_mut_dps", v = 0, src = nil },
		{ key = "lgt_dps", w = "w_lgt_dps", v = 0, src = nil },
		{ key = "mid_dps", w = "w_mid_dps", v = 0, src = nil },
		{ key = "hvy_dps", w = "w_hvy_dps", v = 0, src = nil },
		{ key = "max_dps", w = "w_max_dps", v = 0, src = nil },
	}
	local rounds_n = 0
	local ammo_str = ini_str(sec, "ammo_class", "-") or "-"
	-- Shorten header: drop ammo_ prefix on each class token.
	do
		local parts = explode_csv(ammo_str)
		for i = 1, #parts do
			parts[i] = string.gsub(parts[i], "^ammo_", "")
		end
		if #parts > 0 then
			ammo_str = table.concat(parts, "/")
		end
	end

	if B and B.weapon_table_damage_stats then
		local st_dmg = B.weapon_table_damage_stats(sec, B.DEFAULT_DIST or 30)
		rounds_n = st_dmg.rounds_n or 0
		-- Table returns mut_dmg/lgt_dmg/...; map into DPS column slots.
		local dmg_keys = { "mut_dmg", "lgt_dmg", "mid_dmg", "hvy_dmg", "max_dmg" }
		for i = 1, #col_dmg do
			local c = col_dmg[i]
			local dk = dmg_keys[i]
			c.v = st_dmg[dk] or ((st_dmg.col_max and st_dmg.col_max[i]) or 0)
			c.src = st_dmg.col_src and st_dmg.col_src[i] or nil
		end
	else
		dlog("WARN: dogma_ballistics missing - weapon " .. tostring(sec) .. " scored without table dmg")
	end

	-- Magazine vs rounds-reload (for reload fallback only; not a score term).
	local use_mag = nil
	local tip = _G.dogma_tooltips_weapons
	if tip and tip.weapon_use_mag then
		local ok_m, t = pcall(tip.weapon_use_mag, sec)
		if ok_m and (t == 0 or t == 1) then
			use_mag = t
		end
	end
	if use_mag == nil and B and B.weapon_use_mag then
		local ok_m, t = pcall(B.weapon_use_mag, sec)
		if ok_m and (t == 0 or t == 1) then
			use_mag = t
		end
	end
	if use_mag == nil then
		use_mag = 1
	end

	local reload_s = reload_seconds_for(sec, mag, use_mag)
	local fire_s = 0
	if rpm > 0 and mag > 0 then
		fire_s = mag * 60 / rpm
	end

	local st = avg_state_new()

	-- Sustained DPS per armor column (dmg folded with rpm/mag/reload).
	for i = 1, #col_dmg do
		local c = col_dmg[i]
		c.dps = sustained_dps(c.v, rpm, mag, reload_s)
		avg_add(st, c.key, c.dps, norm01(c.dps, NORM.dps), c.w, debug)
	end
	avg_add(st, "burst", burst, norm01(burst, NORM.burst), "w_burst", debug)
	avg_add(st, "spread_ads", spread_ads, ads_n, "w_spread_ads", debug)
	avg_add(st, "spread_hip", spread_hip, hip_n, "w_spread_hip", debug)

	-- Mount capability: always 0 or 1 (scope_status / silencer_status > 0).
	local scope_ok = (scope_status and scope_status > 0) and 1 or 0
	local sil_ok = (sil_status and sil_status > 0) and 1 or 0
	avg_add(st, "scope", scope_ok, scope_ok, "w_scope", debug)
	avg_add(st, "silencer", sil_ok, sil_ok, "w_silencer", debug)

	-- Price: 1 at cost 0, 0 at MAX_COST.weapon.
	local cost = item_cost(sec) or 0
	local price_n = inv_norm01(cost, MAX_COST.weapon)
	avg_add(st, "price", cost, price_n, "w_price", debug)

	local avg = avg_finish(st)
	local pts = score_to_points(avg, "weapon")

	if debug then
		-- Weapons only, compact: header + term lines (raw * weight = contribution).
		dlog(string.format(
			"%s (%d, %.0f, %s) rpm=%.0f mag=%.0f fire=%.2fs reload=%.2fs use_mag=%d:",
			sec, pts, cost, ammo_str, rpm, mag, fire_s, reload_s, use_mag
		))
		for i = 1, #st.lines do
			dlog(st.lines[i])
		end
	end

	local detail = string.format(
		"mut/lgt/mid/hvy/max_dps=%.0f/%.0f/%.0f/%.0f/%.0f ammoN=%d rpm=%.0f mag=%.0f reload=%.2f burst=%.1f ads=%.3f->%.2f hip=%.3f->%.2f cost=%.0f price=%.2f",
		col_dmg[1].dps or 0, col_dmg[2].dps or 0, col_dmg[3].dps or 0,
		col_dmg[4].dps or 0, col_dmg[5].dps or 0,
		rounds_n, rpm, mag, reload_s, burst, spread_ads, ads_n, spread_hip, hip_n,
		cost or 0, price_n
	)
	return avg, detail
end

local function build_scored(pool, kind)
	local scored = {}
	local scorer = score_weapon
	local max_cost = nil
	if kind == "weapon" then
		max_cost = MAX_COST.weapon
	elseif kind == "armor" then
		max_cost = MAX_COST.armor
		scorer = score_armor
	elseif kind == "helmet" then
		max_cost = MAX_COST.helmet
		scorer = score_armor
	elseif kind == "ammo" then
		max_cost = MAX_COST.ammo
		scorer = score_ammo
	elseif kind == "sight" then
		scorer = score_sight
	end
	for _, sec in ipairs(pool) do
		-- Belt-and-braces: never score over-cost items (scan should already drop them).
		if max_cost and max_cost > 0 and ini_float(sec, "cost", 0) > max_cost then
			-- skip - no tip/ballistics/avg work
		else
			local raw, detail
			local ok, err = pcall(function()
				raw, detail = scorer(sec)
			end)
			if ok and type(raw) == "number" then
				local pts = score_to_points(raw, kind)
				local bloc = nil
				if kind == "weapon" then
					bloc = weapon_bloc(sec)
				elseif kind == "ammo" then
					bloc = ammo_bloc(sec)
				end
				scored[#scored + 1] = {
					sec = sec,
					score = raw,
					pts = pts,
					detail = detail or "",
					bloc = bloc,
					community = (kind == "armor") and ini_str(sec, "community", "") or nil,
				}
			else
				dlog(string.format("%s %s SCORE_FAIL %s", kind, sec, tostring(err or raw)))
			end
		end
	end

	table.sort(scored, function(a, b)
		return a.score > b.score
	end)
	return scored
end

--------------------------------------------------------------------------
-- Basics from merged loadouts LTX
--------------------------------------------------------------------------

local function parse_loadout_line(value)
	-- "false,1,0" or "true,1,50" or "true,1,50,1"
	local parts = explode_csv(value)
	local pickable = parts[1] == "true"
	local qty = tonumber(parts[2]) or 1
	local pts = tonumber(parts[3]) or 0
	return pickable, qty, pts
end

local function read_basics(faction)
	local items = {}
	local ini = ini_file("items\\settings\\new_game_loadouts.ltx")
	if not ini then
		dlog("WARN: could not open new_game_loadouts.ltx - using fallback basics")
		return {
			"cash", "device_pda_1", "bandage", "bandage", "bandage",
			"jgut", "batteries_dead", "batteries_dead", "flask", "vodka",
			"tushonka", "box_matches", "swiss_knife", "grooming",
			"itm_actor_backpack", "itm_backpack", "detector_simple",
			"detector_radio", "wpn_knife", "bolts_pack", "bolts_pack",
			"picture_woman", "bolt",
		}
	end

	local function collect_false(section)
		if not ini:section_exist(section) then
			return
		end
		local n = ini:line_count(section)
		for i = 0, n - 1 do
			local _, key, value = ini:r_line(section, i, "", "")
			if key and key ~= "" and value and value ~= "" then
				local pickable, qty = parse_loadout_line(value)
				if not pickable then
					for _ = 1, qty do
						items[#items + 1] = key
					end
				end
			end
		end
	end

	-- shared inherits custom; faction inherits shared - read both to catch overrides
	collect_false("shared")
	if faction and faction ~= "" then
		collect_false(faction .. "_loadout")
	end

	dlog(string.format("basics(%s): %d tokens", tostring(faction), #items))
	return items
end

--------------------------------------------------------------------------
-- Compatible sights for a weapon
--------------------------------------------------------------------------

local function weapon_compatible_sights(wpn_sec, sight_scored)
	local out = {}
	local scopes_sect = ini_str(wpn_sec, "scopes_sect", nil)
	local allowed = {}
	if scopes_sect and ini_sys:section_exist(scopes_sect) then
		local n = ini_sys:line_count(scopes_sect)
		for i = 0, n - 1 do
			local _, key, value = ini_sys:r_line(scopes_sect, i, "", "")
			local addon = value
			if key == "scope_name" or string.find(key or "", "scope", 1, true) then
				if addon and addon ~= "" then
					allowed[addon] = true
				end
			elseif value and string.find(value, "wpn_addon", 1, true) then
				allowed[value] = true
			end
			if key and string.find(key, "wpn_addon", 1, true) then
				allowed[key] = true
			end
		end
	end
	local scopes_csv = ini_str(wpn_sec, "scopes", "")
	for _, tok in ipairs(explode_csv(scopes_csv)) do
		if not KIT_SET[tok] then
			allowed[tok] = true
		end
	end

	local scope_status = ini_float(wpn_sec, "scope_status", 0)
	if not scope_status or scope_status <= 0 then
		return out
	end

	if next(allowed) == nil then
		return out
	end
	for _, entry in ipairs(sight_scored) do
		if allowed[entry.sec] then
			out[#out + 1] = entry
		end
	end
	return out
end

--------------------------------------------------------------------------
-- Supply (all eligible items - no chance rolls)
--------------------------------------------------------------------------

-- Strictly pts < max (not <=).
local function filter_by_pts(scored, max_pts)
	local out = {}
	for _, e in ipairs(scored) do
		if e.pts < max_pts then
			out[#out + 1] = e
		end
	end
	return out
end

-- Exact-section dedupe (scan / filters should not emit dupes; belt-and-braces for shop UI).
local function dedupe_scored(scored)
	local seen = {}
	local out = {}
	for _, e in ipairs(scored or {}) do
		local sec = e.sec
		if sec and not seen[sec] then
			seen[sec] = true
			out[#out + 1] = e
		end
	end
	return out
end

local function dedupe_sec_list(list)
	local seen = {}
	local out = {}
	for _, sec in ipairs(list or {}) do
		if sec and not seen[sec] then
			seen[sec] = true
			out[#out + 1] = sec
		end
	end
	return out
end

local function filter_weapons(scored, faction, max_pts)
	local bloc = CONFIG.FACTION_BLOC[faction] or "both"
	local out = {}
	local seen = {}
	for _, e in ipairs(scored) do
		if e.pts < max_pts and bloc_ok(e.bloc, bloc) and not seen[e.sec] then
			seen[e.sec] = true
			out[#out + 1] = e
		end
	end
	return out
end

local function filter_armors(scored, faction, max_pts)
	local want = CONFIG.FACTION_COMMUNITY[faction] or faction
	local allow_univ = cfg_bool("include_universal_armor")
	local out = {}
	for _, e in ipairs(scored) do
		if e.pts < max_pts then
			local c = e.community or ""
			if c == want then
				out[#out + 1] = e
			elseif allow_univ and (c == "" or c == "actor") then
				out[#out + 1] = e
			end
		end
	end
	if #out == 0 then
		return filter_by_pts(scored, max_pts)
	end
	return out
end

local function append_secs(items, entries, label)
	for _, e in ipairs(entries) do
		items[#items + 1] = e.sec
	end
end

-- Union of plain sights under max_pts that fit at least one supplied weapon.
local function sights_for_weapons(weapons, sight_scored, max_pts)
	local seen = {}
	local out = {}
	local under = filter_by_pts(sight_scored, max_pts)
	for _, wpn in ipairs(weapons) do
		local compat = weapon_compatible_sights(wpn.sec, under)
		for _, s in ipairs(compat) do
			if not seen[s.sec] then
				seen[s.sec] = true
				out[#out + 1] = s
			end
		end
	end
	return out
end

-- Non-AP ammo types used by supplied guns; two stacks each.
-- Respects max_pts_ammo when a scored entry exists.
local function ammo_stacks_for_weapons(weapons, ammo_scored)
	local max_ammo = cfg_num("max_pts_ammo")
	local pts_by_sec = {}
	for _, e in ipairs(ammo_scored or {}) do
		pts_by_sec[e.sec] = e.pts
	end
	local seen = {}
	local ordered = {}
	for _, wpn in ipairs(weapons) do
		for _, ammo in ipairs(explode_csv(ini_str(wpn.sec, "ammo_class", ""))) do
			if not seen[ammo] and ini_sys:section_exist(ammo)
				and not is_ap_ammo(ammo) and not is_explosive_ammo(ammo) and not is_bad_ammo(ammo)
				and ini_float(ammo, "cost", 0) <= MAX_COST.ammo then
				local pts = pts_by_sec[ammo]
				if pts == nil or pts < max_ammo then
					seen[ammo] = true
					ordered[#ordered + 1] = ammo
				end
			end
		end
	end
	return ordered
end

-- Entries for the purchase (loadout) panel: { sec=, pts= }
local function build_shop_entries(faction)
	local sformat = string.format
	STATE.pools = nil
	STATE.ammo_secs = nil

	dlog(string.format(
		"=== dynamic loadout shop faction=%s cost_mult w/a/h/ammo/sight=%d/%d/%d/%d/%d ===",
		tostring(faction),
		cost_mult_for("weapon"), cost_mult_for("armor"), cost_mult_for("helmet"),
		cost_mult_for("ammo"), cost_mult_for("sight")
	))
	local pools = scan_all()
	local scored = {
		weapons = build_scored(pools.weapons, "weapon"),
		armors = build_scored(pools.armors, "armor"),
		helmets = build_scored(pools.helmets, "helmet"),
		ammos = build_scored(pools.ammos, "ammo"),
	}

	local weapons = filter_weapons(scored.weapons, faction, cfg_num("max_pts_weapon"))
	local armors = dedupe_scored(filter_armors(scored.armors, faction, cfg_num("max_pts_armor")))
	local helmets = dedupe_scored(filter_by_pts(scored.helmets, cfg_num("max_pts_helmet")))
	local ammo_secs = dedupe_sec_list(ammo_stacks_for_weapons(weapons, scored.ammos))

	local pts_by_ammo = {}
	for _, e in ipairs(scored.ammos) do
		pts_by_ammo[e.sec] = e.pts
	end

	local entries = {}
	local seen_entry = {}
	local function add_entry(sec, pts, label)
		if not sec or seen_entry[sec] then
			return
		end
		seen_entry[sec] = true
		entries[#entries + 1] = { sec = sec, pts = pts or 1 }
	end

	for _, e in ipairs(armors) do
		add_entry(e.sec, e.pts, "outfit")
	end
	for _, e in ipairs(helmets) do
		add_entry(e.sec, e.pts, "helmet")
	end
	for _, e in ipairs(weapons) do
		add_entry(e.sec, e.pts, "weapon")
	end
	for _, ammo in ipairs(ammo_secs) do
		add_entry(ammo, pts_by_ammo[ammo] or 1, "ammo")
	end

	-- Shop ammo list only - do NOT use for post-spawn trim (that uses purchased weapons).
	STATE.ammo_secs = nil

	dlog(sformat(
		"shop counts: outfit=%d helmet=%d weapon=%d ammo=%d entries=%d",
		#armors, #helmets, #weapons, #ammo_secs, #entries
	))
	return entries
end

local function refresh_cell_values(cc)
	for _, ci in pairs(cc.cell) do
		if ci:IsShown() then
			local val = ci.flags.info or 0
			ci.flags.value = val
			ci.flags.value_str = game.translate_string("st_mm_new_game_points") .. ": " .. val
		end
	end
end

-- Draw pts on the icon (G.A.M.M.A. UI utils_ui UICellItem:Add_CustomText -
-- same hook workshop/parts-in-tooltip use for condition text). Font: GetFontSmall.
local function paint_pts_on_cells(cc)
	if not (cc and cc.cell) then
		return
	end
	local fnt = GetFontSmall and GetFontSmall() or nil
	local clr = GetARGB and GetARGB(255, 180, 180, 180) or nil
	-- utils_ui: align_h 0=left, 2=center, 4=right; align_v 0=top
	local align_l, align_top = 0, 0
	for _, ci in pairs(cc.cell) do
		if ci:IsShown() and ci.Add_CustomText then
			local pts = ci.flags.info or ci.flags.value or 0
			ci:Add_CustomText(tostring(pts), align_l, align_top, clr, fnt)
		end
	end
end

local function paint_pts_both(self)
	if self.CC then
		paint_pts_on_cells(self.CC["inventory"])
		paint_pts_on_cells(self.CC["loadout"])
	end
end

-- Keep non-gear stock rows; strip weapon/ammo/outfit/helmet; dedupe backpacks.
local function keep_non_gear_from_cc(cc)
	local secs = {}
	local pts = {}
	local seen_sec = {}
	local have_backpack = false
	if not (cc and cc.cell) then
		return secs, pts
	end
	for _, ci in pairs(cc.cell) do
		local sec = ci.section
		if sec and sec ~= "" and ci:IsShown() then
			if is_excluded_misc(sec) or gear_kind(sec) then
				-- drop dynamo / upgraded / stock weapon/ammo/outfit/helmet
			elseif seen_sec[sec] then
				-- exact section dupes
			elseif is_backpack(sec) and have_backpack then
				dlog("dedupe backpack skip " .. sec)
			else
				seen_sec[sec] = true
				if is_backpack(sec) then
					have_backpack = true
				end
				secs[#secs + 1] = sec
				pts[#pts + 1] = ci.flags.info or 0
			end
		end
	end
	return secs, pts
end

local function apply_shop_to_ui(self, shop_entries)
	local inv_secs, inv_pts = keep_non_gear_from_cc(self.CC["inventory"])
	local load_secs, load_pts = keep_non_gear_from_cc(self.CC["loadout"])

	local seen = {}
	for _, sec in ipairs(load_secs) do
		seen[sec] = true
	end
	for _, e in ipairs(shop_entries or {}) do
		local sec = e.sec
		if sec and not seen[sec] then
			seen[sec] = true
			load_secs[#load_secs + 1] = sec
			load_pts[#load_pts + 1] = e.pts or 0
		end
	end

	self.CC["inventory"]:Reinit(inv_secs, inv_pts)
	refresh_cell_values(self.CC["inventory"])

	self.CC["loadout"]:Reinit(load_secs, load_pts)
	refresh_cell_values(self.CC["loadout"])

	paint_pts_both(self)

	-- Recalc spent points from inventory (purchases already transferred).
	local used = 0
	for _, ci in pairs(self.CC["inventory"].cell) do
		if ci:IsShown() then
			used = used + (ci.flags.value or 0) * ((ci:CountChilds() or 0) + 1)
		end
	end
	self.points_used = used
	-- points_left was set by stock LoadLoadout from economy total; restore remaining.
	local eco_idxs = "1"
	if self.selected_economy then
		eco_idxs = tostring(self.selected_economy):gsub("st_econ_", "") or "1"
	end
	local total = 1000
	if ini_itm then
		total = ini_itm:r_float_ex("points", "total_points_eco_" .. eco_idxs) or total
	end
	self.points_left = total - used
	if self.points_left < 0 then
		self.points_left = 0
	end
	if self.text_points_used then
		self.text_points_used:SetText(tostring(self.points_used))
	end
	if self.text_points_left then
		self.text_points_left:SetText(tostring(self.points_left))
	end
end

--------------------------------------------------------------------------
-- UINewGame patch - LoadLoadout only (never touches OnRandomize)
--------------------------------------------------------------------------

local function slog(msg)
	printf("[dogma_menu_dynamic_loadout] %s", tostring(msg))
end

local function wrap_load_loadout(cls)
	if STATE.wrap_load and cls.LoadLoadout == STATE.wrap_load then
		return true
	end
	local base = cls.LoadLoadout
	if not base then
		return false
	end

	local function wrapped(self, rand)
		if not cfg_bool("enabled") then
			return base(self, rand)
		end

		-- Stock LoadLoadout first, then strip gear and inject scored shop options.
		base(self, false)

		local faction = self.selected_faction or "stalker"
		slog("LoadLoadout: building shop for faction=" .. tostring(faction))

		local entries
		local ok, err = pcall(function()
			entries = build_shop_entries(faction)
		end)
		if not ok then
			slog("build_shop_entries FAILED: " .. tostring(err))
			return
		end

		apply_shop_to_ui(self, entries or {})
		slog(string.format("LoadLoadout: shop entries=%d", entries and #entries or 0))
	end

	cls.LoadLoadout = wrapped
	STATE.wrap_load = wrapped
	STATE.base_load = base
	return true
end

local function wrap_on_cc_mouse1(cls)
	if STATE.wrap_mouse1 and cls.On_CC_Mouse1 == STATE.wrap_mouse1 then
		return true
	end
	local base = cls.On_CC_Mouse1
	if not base then
		return false
	end

	local function wrapped(self, cont, idx)
		base(self, cont, idx)
		if cfg_bool("enabled") then
			-- Transfer rebuilds cells; restore pts labels on icons.
			paint_pts_both(self)
		end
	end

	cls.On_CC_Mouse1 = wrapped
	STATE.wrap_mouse1 = wrapped
	return true
end

-- Persist ammo-trim list when Start writes character_creation.
-- Keep-list = non-AP ammo for weapons actually in the inventory panel
-- (purchased), NOT the full shop supply. Empty purchase -> trim all, keep none.
local function inventory_weapon_secs(self)
	local out = {}
	local cc = self.CC and self.CC["inventory"]
	if not (cc and cc.cell) then
		return out
	end
	for _, ci in pairs(cc.cell) do
		local sec = ci.section
		if sec and sec ~= "" and ci:IsShown() and gear_kind(sec) == "weapon" then
			out[#out + 1] = sec
		end
	end
	return out
end

local function ammo_secs_for_weapon_list(weapon_secs)
	local seen = {}
	local ordered = {}
	for _, wpn in ipairs(weapon_secs or {}) do
		for _, ammo in ipairs(explode_csv(ini_str(wpn, "ammo_class", ""))) do
			if not seen[ammo] and ini_sys:section_exist(ammo)
				and not is_ap_ammo(ammo) and not is_explosive_ammo(ammo) and not is_bad_ammo(ammo) then
				seen[ammo] = true
				ordered[#ordered + 1] = ammo
			end
		end
	end
	return ordered
end

local function wrap_on_start_game(cls)
	if STATE.wrap_start and cls.OnStartGame == STATE.wrap_start then
		return true
	end
	local base = cls.OnStartGame
	if not base then
		return false
	end

	local function wrapped(self)
		if cfg_bool("enabled") and axr_main and axr_main.config then
			local wpns = inventory_weapon_secs(self)
			local ammos = ammo_secs_for_weapon_list(wpns)
			axr_main.config:w_value("character_creation", "dogma_dl_active", "1")
			axr_main.config:w_value(
				"character_creation",
				"dogma_dl_ammo",
				table.concat(ammos, ",")
			)
			slog(string.format(
				"OnStartGame: inventory weapons=%d ammo_keep=%d (%s)",
				#wpns, #ammos, table.concat(ammos, ",")
			))
		end
		return base(self)
	end

	cls.OnStartGame = wrapped
	STATE.wrap_start = wrapped
	return true
end

-- Re-apply wraps when New Game UI builds (other *mcm injectors may overwrite methods).
local function wrap_on_quit(cls)
	if STATE.wrap_quit and cls.OnQuit == STATE.wrap_quit then
		return true
	end
	local base = cls.OnQuit
	if not base then
		return false
	end
	local function wrapped(self)
		local owner = self.owner
		base(self)
		-- Main menu caches UINewGame; clear so next New Game fully rebuilds + rescans.
		if owner then
			owner.new_game_dlg = nil
			slog("OnQuit: cleared cached new_game_dlg (next open will rescan)")
		end
	end
	cls.OnQuit = wrapped
	STATE.wrap_quit = wrapped
	return true
end

-- Wrap main_menu.ShowFactionUI on the live owner instance (class wrap often unavailable
-- at *mcm load time - log showed ShowFactionUI=false).
local function wrap_owner_show_faction(owner)
	if not owner or not owner.ShowFactionUI then
		return false
	end
	if STATE.show_wrap_owner == owner and owner.ShowFactionUI == STATE.wrap_show_inst then
		return true
	end
	local base = owner.ShowFactionUI
	local function wrapped(self)
		local existed = self.new_game_dlg ~= nil
		base(self)
		if not cfg_bool("enabled") then
			return
		end
		local dlg = self.new_game_dlg
		if existed and dlg and dlg.LoadLoadout then
			local uicls = ui_mm_faction_select and ui_mm_faction_select.UINewGame
			if uicls then
				wrap_load_loadout(uicls)
				wrap_on_cc_mouse1(uicls)
			end
			slog("ShowFactionUI: re-open - rescanning shop")
			dlg:LoadLoadout(false)
		end
	end
	owner.ShowFactionUI = wrapped
	STATE.wrap_show_inst = wrapped
	STATE.show_wrap_owner = owner
	slog("ShowFactionUI: wrapped on main_menu instance")
	return true
end

local function wrap_main_controls(cls)
	if STATE.wrap_controls and cls.Main_Controls == STATE.wrap_controls then
		return true
	end
	local base = cls.Main_Controls
	if not base then
		return false
	end

	local function wrapped(self, ...)
		wrap_load_loadout(cls)
		wrap_on_cc_mouse1(cls)
		wrap_on_start_game(cls)
		wrap_on_quit(cls)
		wrap_owner_show_faction(self.owner)
		return base(self, ...)
	end

	cls.Main_Controls = wrapped
	STATE.wrap_controls = wrapped
	return true
end

local function wrap_show_faction_ui()
	-- Prefer class wrap when available; instance wrap is applied from Main_Controls.
	local ok, cls_mm = pcall(function()
		return main_menu
	end)
	if not ok or not cls_mm or not cls_mm.ShowFactionUI then
		return false
	end
	if STATE.wrap_show and cls_mm.ShowFactionUI == STATE.wrap_show then
		return true
	end
	local base = cls_mm.ShowFactionUI
	local function wrapped(self)
		local existed = self.new_game_dlg ~= nil
		base(self)
		if not cfg_bool("enabled") then
			return
		end
		local dlg = self.new_game_dlg
		if existed and dlg and dlg.LoadLoadout then
			local uicls = ui_mm_faction_select and ui_mm_faction_select.UINewGame
			if uicls then
				wrap_load_loadout(uicls)
				wrap_on_cc_mouse1(uicls)
			end
			slog("ShowFactionUI(class): re-open - rescanning shop")
			dlg:LoadLoadout(false)
		end
	end
	cls_mm.ShowFactionUI = wrapped
	STATE.wrap_show = wrapped
	return true
end

local function patch_new_game()
	local cls = ui_mm_faction_select and ui_mm_faction_select.UINewGame
	if not cls then
		slog("patch: ui_mm_faction_select.UINewGame not ready")
		return false
	end
	local ok_ctrl = wrap_main_controls(cls)
	local ok_load = wrap_load_loadout(cls)
	local ok_mouse = wrap_on_cc_mouse1(cls)
	local ok_start = wrap_on_start_game(cls)
	local ok_quit = wrap_on_quit(cls)
	local ok_show = wrap_show_faction_ui()
	slog(string.format(
		"patch: controls=%s LoadLoadout=%s mouse1=%s OnStartGame=%s OnQuit=%s ShowFactionUI=%s",
		tostring(ok_ctrl), tostring(ok_load), tostring(ok_mouse), tostring(ok_start),
		tostring(ok_quit), tostring(ok_show)
	))
	return ok_ctrl and ok_load and ok_mouse and ok_start and ok_quit
end

slog("mcm script loaded")
patch_new_game()

