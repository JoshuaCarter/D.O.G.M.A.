--[[
    Weapons Ban — corpse ammo.

    Vanilla death ammo stays except leftover _bad/_verybad boxes.
    Those get stripped here if they are still on the corpse after vanilla
    spawn. Fresh stacks (already converted) are left alone. Then one rank
    RU/min/max roll split across kept guns.
    Each gun's ammo types are buckets. Every round (min and extras) is one
    uniform pick among those types. Subtract that round's RU. After min,
    leftover RU still buys the rolled round (even if it costs more), then
    extras stop. Cap at `max`. Grenade ammo (OG-7B / VOG / M209) is skipped
    for min; leftover RU can still buy it. Grenade-only guns skip min.
]]

local CONFIG = _G.dogma_game_weapons_ban_conf
local MOD_ID = CONFIG.MOD_ID

local Tiers
local original_try_spawn_ammo
local hooked_ammo = false
local PENDING_ROLLS_KEY = "dogma_wb_pending_rolls"
local pending_rolls = {}

local function log(msg, color)
    dogma.log.log(MOD_ID, tostring(msg), color)
end

local function roll_id(id)
    return tonumber(id) or id
end

local function queue_roll(id, msg, color)
    id = roll_id(id)
    if not id then
        return
    end
    local list = pending_rolls[id]
    if not list then
        list = {}
        pending_rolls[id] = list
    end
    list[#list + 1] = { tostring(msg), color }
end

local function flush_roll(id)
    id = roll_id(id)
    if not id then
        return
    end
    local list = pending_rolls[id] or pending_rolls[tostring(id)]
    if not list then
        return
    end
    pending_rolls[id] = nil
    pending_rolls[tostring(id)] = nil
    for i = 1, #list do
        local row = list[i]
        log(row[1], row[2])
    end
end

_G.dogma_wb_queue_roll = queue_roll
_G.dogma_wb_flush_roll = flush_roll

local function queue_stripped(id, stripped)
    if not stripped then
        return
    end
    for sec, n in pairs(stripped) do
        queue_roll(id, string.format("  - %s x%s", sec, n), "gray")
    end
end

local function npc_label(npc)
    if not npc then
        return "?"
    end
    local name = npc.name and npc:name()
    if name and name ~= "" then
        return name
    end
    return (npc.section and npc:section()) or "?"
end

local function pick_ammo(ammo_list)
    if not ammo_list then
        return nil
    end
    local ok = {}
    for i = 1, #ammo_list do
        local s = ammo_list[i]
        if dogma.db.is_craft_ammo(s) then
            ok[#ok + 1] = s
        end
    end
    if #ok > 0 then
        return ok[math.random(1, #ok)]
    end
    return nil
end

local function release_inventory_ids(ids)
    for i = 1, #ids do
        local id = ids[i]
        if id and alife_object(id) then
            alife_release_id(id)
        end
    end
end

-- Old / damaged boxes only. Dump ammo cat is fresh ids; _bad is not
-- in dogma.db.is_ammo. Suffix is the real mark. Skip if already fresh.
-- Collect ids first so we never release during iterate.
local function is_degraded_ammo(sec)
    return sec and (sec:sub(-8) == "_verybad" or sec:sub(-4) == "_bad")
end

local function strip_degraded_ammo(npc)
    local to_release = {}
    local counts = {}
    if not (npc and npc.iterate_inventory) then
        return counts
    end
    npc:iterate_inventory(function(_temp, item)
        if not item then
            return
        end
        local sec = item:section()
        local id = item:id()
        if not (id and alife_object(id)) then
            return
        end
        if not is_degraded_ammo(sec) then
            return
        end
        to_release[#to_release + 1] = id
        local n = (item.ammo_get_count and item:ammo_get_count()) or 1
        counts[sec] = (counts[sec] or 0) + n
    end)
    if #to_release == 0 then
        return counts
    end
    release_inventory_ids(to_release)
    return counts
end

local function npc_rank_name(npc)
    if not (npc and ranks and ranks.get_obj_rank_name) then
        return nil
    end
    local ok, name = pcall(ranks.get_obj_rank_name, npc)
    if ok and name and name ~= "" then
        return name
    end
    return nil
end

-- Ammo sections currently loose on the corpse (db boxes only).
local function collect_inventory_ammo_secs(npc)
    local found = {}
    if not (npc and npc.iterate_inventory) then
        return found
    end
    npc:iterate_inventory(function(_temp, item)
        if not item then
            return
        end
        local sec = item:section()
        if dogma.db.is_ammo(sec) then
            found[sec] = true
        end
    end)
    return found
end

-- Ammo types this gun should drop: loaded type + matching inventory ammo.
-- Craftable db ammo only. Falls back to a random ammo_class entry if nothing matched.
local try_ammo_types_for_gun = function(wpn)
    return wpn:get_ammo_type()
end

local function ammo_types_for_gun(wpn, inv_ammo)
    if not wpn then
        return nil
    end
    local wpn_sec = wpn:section()
    local ammo_list
    if utils_item and utils_item.get_ammo then
        ammo_list = utils_item.get_ammo(wpn_sec, wpn:id())
    end
    if not (ammo_list and #ammo_list > 0) then
        ammo_list = parse_list(ini_sys, wpn_sec, "ammo_class")
    end
    if not (ammo_list and #ammo_list > 0) then
        return nil
    end

    local allowed = {}
    for i = 1, #ammo_list do
        local s = ammo_list[i]
        if dogma.db.is_craft_ammo(s) then
            allowed[s] = true
        elseif dogma.db.is_ammo(s) then
            log("skip ammo " .. s .. " (no craft)")
        end
    end

    local matched = {}
    if wpn.get_ammo_type then
        local ok, idx = pcall(try_ammo_types_for_gun, wpn)
        if ok and idx ~= nil then
            local loaded = ammo_list[idx + 1]
            if loaded and allowed[loaded] then
                matched[loaded] = true
            end
        end
    end
    if inv_ammo then
        for sec, _ in pairs(inv_ammo) do
            if allowed[sec] then
                matched[sec] = true
            end
        end
    end

    local list = {}
    for sec, _ in pairs(matched) do
        list[#list + 1] = sec
    end
    if #list == 0 then
        local fallback = pick_ammo(ammo_list)
        if fallback then
            list[1] = fallback
        end
    end
    if #list == 0 then
        return nil
    end
    return list
end

-- RU per round. Same units as rounds_for_ru (cost / box).
local function round_cost(sec)
    local cost = dogma.db.cost(sec)
    if not cost or cost <= 0 then
        return nil
    end
    local row = dogma.db.get(sec)
    local box = (row and row.box) or 1
    if box <= 0 then
        box = 1
    end
    return cost / box
end

local function split_int(total, n, i)
    local base = math.floor(total / n)
    local rem = total - base * n
    if i <= rem then
        return base + 1
    end
    return base
end

-- Fill this gun: at least min_r rounds, never more than max_r.
-- Every round is a uniform pick, then subtract that cost. Min picks skip
-- grenade ammo. After min, leftover RU still grants the rolled round, then stop.
local function allocate_gun_ammo(types, ru_budget, min_r, max_r)
    local counts = {}
    local k = #types
    if k < 1 or max_r <= 0 then
        return counts
    end
    if min_r > max_r then
        min_r = max_r
    end
    local costs = {}
    local min_idx = {}
    local any_c = false
    for i = 1, k do
        local sec = types[i]
        local c = round_cost(sec)
        costs[i] = c
        if c then
            any_c = true
        end
        if not dogma.db.is_grenade_ammo(sec) then
            min_idx[#min_idx + 1] = i
        end
    end
    local min_k = #min_idx
    if min_k < 1 then
        min_r = 0
    end
    local ru = ru_budget
    for n = 1, max_r do
        local extra = n > min_r
        if extra and (not any_c or ru <= 0) then
            break
        end
        local i
        if extra then
            i = math.random(k)
        else
            i = min_idx[math.random(min_k)]
        end
        local sec = types[i]
        counts[sec] = (counts[sec] or 0) + 1
        local c = costs[i]
        if c then
            if extra and c > ru then
                break
            end
            ru = ru - c
            if ru < 0 then
                ru = 0
            end
        end
    end
    return counts
end

local function inject_corpse_ammo(npc, inv_ammo)
    local rank = npc_rank_name(npc)
    local gun_ammo = {}
    npc:iterate_inventory(function(_temp, itm)
        if not itm then
            return
        end
        if not dogma.db.is_weapon(itm:section()) then
            return
        end
        if npc.marked_dropped and npc:marked_dropped(itm) then
            return
        end
        if dogma.db.is_melee(itm:section()) then
            return
        end
        local types = ammo_types_for_gun(itm, inv_ammo)
        if types then
            gun_ammo[#gun_ammo + 1] = types
        end
    end)
    if #gun_ammo == 0 then
        return { skip = "no guns", rank = rank }
    end
    local total_ru, min_rounds, max_rounds = Tiers.roll_ru_for_rank(rank)
    if total_ru <= 0 then
        return { skip = "ru 0", rank = rank, guns = #gun_ammo }
    end
    local n_guns = #gun_ammo
    local pooled = {}
    for i = 1, n_guns do
        local types = gun_ammo[i]
        local counts = allocate_gun_ammo(
            types,
            total_ru / n_guns,
            split_int(min_rounds, n_guns, i),
            split_int(max_rounds, n_guns, i)
        )
        for sec, n in pairs(counts) do
            pooled[sec] = (pooled[sec] or 0) + n
        end
    end
    local drops = {}
    for sec, rounds in pairs(pooled) do
        if rounds > 0 then
            alife_create_item(sec, npc, { ammo = rounds })
            drops[#drops + 1] = string.format("%s x%s", sec, rounds)
        end
    end
    return {
        rank = rank,
        guns = n_guns,
        ru = total_ru,
        min = min_rounds,
        max = max_rounds,
        drops = drops,
    }
end

local function log_corpse_roll(npc, result)
    local id = npc.id and npc:id()
    local who = npc_label(npc)
    local stripped = result.stripped
    if result.skip then
        if result.skip == "no guns" and not result.rank and not (stripped and next(stripped)) then
            return
        end
        queue_roll(id, string.format(
            "corpse %s skip %s rank=%s guns=%s",
            who,
            result.skip,
            result.rank or "?",
            result.guns or 0
        ), "gray")
    else
        queue_roll(id, string.format(
            "corpse %s rank=%s guns=%s ru=%s min=%s max=%s",
            who,
            result.rank or "?",
            result.guns,
            result.ru,
            result.min or 0,
            result.max or 0
        ), "green")
    end
    queue_stripped(id, stripped)
    if result.skip then
        return
    end
    if #result.drops == 0 then
        queue_roll(id, "  none", "gray")
        return
    end
    for i = 1, #result.drops do
        queue_roll(id, "  + " .. result.drops[i], "green")
    end
end

local try_patched_try_spawn_ammo = function() CONFIG:load_mcm() end

local function patched_try_spawn_ammo(npc)
    original_try_spawn_ammo(npc)
    if not dogma.sys.ready(MOD_ID, db, try_patched_try_spawn_ammo) then
        return
    end
    if not npc then
        return
    end
    dogma.perf.start("weapons_ban", "try_spawn_ammo")
    -- Snapshot matching ammo so we inject the same types.
    local inv_ammo = collect_inventory_ammo_secs(npc)
    local stripped = strip_degraded_ammo(npc)
    local result = inject_corpse_ammo(npc, inv_ammo) or { skip = "no result" }
    result.stripped = stripped
    log_corpse_roll(npc, result)
    dogma.perf.stop()
end

local function try_hook_ammo()
    if hooked_ammo then
        return
    end
    if not (death_manager and death_manager.try_spawn_ammo) then
        return
    end
    original_try_spawn_ammo = death_manager.try_spawn_ammo
    death_manager.try_spawn_ammo = patched_try_spawn_ammo
    hooked_ammo = true
    log("hooked death_manager.try_spawn_ammo")
end

-- Same UI staleness stashes.script works around with schedule_stash_ui_refresh:
-- the loot list can already be built from the pre-strip inventory, so a
-- released _bad/_verybad stack still shows until the corpse is closed and
-- reopened. Force a re-read once the release above has actually applied.
local function refresh_open_corpse_ui(partner_id)
    local gui = ui_inventory and ui_inventory.GUI
    if not (gui and gui.mode == "loot") then
        return
    end
    local partner = gui.GetPartner and gui:GetPartner()
    if not (partner and partner.id and partner:id() == partner_id) then
        return
    end
    if gui.LMode_ResetNPCInventory then
        gui:LMode_ResetNPCInventory()
    elseif gui.LMode_ResetInventories then
        gui:LMode_ResetInventories()
    end
end

local function schedule_corpse_ui_refresh(partner_id)
    if CreateTimeEvent then
        -- timer=0 is "next tick", not "now": CreateTimeEvent stamps
        -- time_global()+0, and the pump only fires once tg is STRICTLY
        -- greater than that stamp (_g_patches.script ProcessEventQueue), so
        -- this still waits for the strip above to land, just for one frame
        -- instead of 100ms of stale UI.
        CreateTimeEvent("dogma_wb_corpse", "ui_" .. partner_id, 0, function()
            refresh_open_corpse_ui(partner_id)
            return true
        end)
    else
        refresh_open_corpse_ui(partner_id)
    end
end

local function flush_open_loot()
    local gui = ui_inventory and ui_inventory.GUI
    if not (gui and gui.mode == "loot") then
        return
    end
    local partner = gui.GetPartner and gui:GetPartner()
    if not (partner and partner.id) then
        return
    end
    local id = partner:id()
    -- Death spawn can land after try_spawn_ammo. Catch leftovers here
    -- before the loot UI builds.
    local stripped = strip_degraded_ammo(partner)
    queue_stripped(id, stripped)
    flush_roll(id)
    if next(stripped) then
        schedule_corpse_ui_refresh(id)
    end
end

local function on_save_state(m_data)
    m_data[PENDING_ROLLS_KEY] = pending_rolls
end

local function on_load_state(m_data)
    pending_rolls = m_data[PENDING_ROLLS_KEY] or {}
end

local on_actor_menu_on_before_init_mode = function(mode)
    if mode == "loot" then
        flush_open_loot()
    end
end

function on_game_start()
    Tiers = _G.dogma_game_weapons_ban_tiers
    CONFIG:ensure_dogma()
    RegisterScriptCallback("actor_on_first_update", try_hook_ammo)
    RegisterScriptCallback("ActorMenu_on_mode_changed", flush_open_loot)
    RegisterScriptCallback("ActorMenu_on_before_init_mode", on_actor_menu_on_before_init_mode)
    RegisterScriptCallback("save_state", on_save_state)
    RegisterScriptCallback("load_state", on_load_state)
    try_hook_ammo()
    log("corpse ammo: loaded")
end
