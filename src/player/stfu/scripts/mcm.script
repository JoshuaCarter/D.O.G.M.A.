function on_mcm_load(options)
	dogma_mcm.attach(options, "player", "ui_mcm_menu_dogma_player", {
		id = "stfu",
		sh = true,
		text = "ui_mcm_menu_dogma_player_stfu",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_player_stfu_page_description",
			},
		}),
	})
end
