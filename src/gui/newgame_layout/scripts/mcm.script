-- gui/newgame_layout conf
--
-- Patch lives in this *mcm.script so main.script (in-session) can share one
-- wrap via _G. New Game UI is not loaded until MCM gather on a cold boot.

local MOD_ID = "dogma/gui/newgame_layout"
local HARD_INDEX = 3

-- Location ids from plugins/new_game_start_locations.ltx (story-mode bases).
local FACTION_DEFAULT_MAP = {
	stalker = "rookie_village", -- Cordon
	freedom = "military_base", -- Army Warehouses
	dolg = "makeshift_barracks", -- Rostok / Bar
	army = "research_institute", -- Agroprom
	bandit = "northern_factory", -- Dark Valley
	csky = "hidden_base", -- Swamps
	ecolog = "sakharovs_bunker", -- Yantar
	killer = "sports_center", -- Dead City
	monolith = "cultural_center", -- Pripyat
	greh = "red_forest_old_mine", -- Red Forest
	-- isg: leave stock Random (no clear main base)
	renegade = "tuzla_outpost", -- Swamps
}

local STATE = _G.__dogma_gui_newgame_layout or {}
_G.__dogma_gui_newgame_layout = STATE

local function opt(key)
	if dogma_mcm and dogma_mcm.bool then
		return dogma_mcm.bool(MOD_ID, key)
	end
	return true
end

local function force_hard_pick(self, list, table_key, selected_key)
	if not opt("default_hard") then
		return
	end
	local t = self[table_key]
	if not (self[list] and t) then
		return
	end
	local pick = t[HARD_INDEX] or t[1]
	if not pick then
		return
	end
	self[list]:SetText(game.translate_string(pick))
	self[selected_key] = pick
end

local function force_map_pick(self)
	if not opt("default_spawn") then
		return
	end
	local want = FACTION_DEFAULT_MAP[self.selected_faction]
	local t = self.table_map
	-- Unlisted factions (e.g. ISG) keep stock Random.
	if not want or not (self.list_map and t and #t > 0) then
		return
	end

	local idx
	for i = 1, #t do
		if t[i] == want then
			idx = i
			break
		end
	end
	if not idx then
		for i = 1, #t do
			if t[i] ~= "random_location" then
				idx = i
				break
			end
		end
	end
	if not idx then
		return
	end

	local pick = t[idx]
	if self.list_map.SetCurrentID then
		self.list_map:SetCurrentID(idx)
	end
	self.list_map:SetText(game.translate_string("ui_st_" .. pick))
	self.selected_map = pick
	if self.UpdateMap then
		self:UpdateMap()
	end
end

local function wrap_loader(cls, method, list, table_key, selected_key, state_key)
	if STATE[state_key] and cls[method] == STATE[state_key] then
		return true
	end
	local base = cls[method]
	if not base then
		return false
	end

	local function wrapped(self, rand)
		base(self, false)
		force_hard_pick(self, list, table_key, selected_key)
	end

	cls[method] = wrapped
	STATE[state_key] = wrapped
	return true
end

local function wrap_load_map(cls)
	if STATE.wrap_map and cls.LoadMap == STATE.wrap_map then
		return true
	end
	local base = cls.LoadMap
	if not base then
		return false
	end

	local function wrapped(self, rand)
		base(self, false)
		force_map_pick(self)
	end

	cls.LoadMap = wrapped
	STATE.wrap_map = wrapped
	return true
end

-- Main-menu New Game click sits over the loadout; eat purchases until LMB is up.
local function mouse1_down()
	local dik = DIK_keys and DIK_keys.MOUSE_1
	return dik and key_state and key_state(dik) ~= 0
end

local function wrap_on_cc_mouse1(cls)
	if STATE.wrap_mouse1 and cls.On_CC_Mouse1 == STATE.wrap_mouse1 then
		return true
	end
	local base = cls.On_CC_Mouse1
	if not base then
		return false
	end

	local function wrapped(self, cont, idx)
		if STATE.eat_click then
			return
		end
		return base(self, cont, idx)
	end

	cls.On_CC_Mouse1 = wrapped
	STATE.wrap_mouse1 = wrapped
	return true
end

local function wrap_update(cls)
	if STATE.wrap_update and cls.Update == STATE.wrap_update then
		return true
	end
	local base = cls.Update

	local function wrapped(self, ...)
		if base then
			base(self, ...)
		end
		if STATE.eat_click and not mouse1_down() then
			STATE.eat_click = nil
		end
	end

	cls.Update = wrapped
	STATE.wrap_update = wrapped
	return true
end

local function wrap_main_controls(cls)
	if STATE.wrap_controls and cls.Main_Controls == STATE.wrap_controls then
		return true
	end
	local base = cls.Main_Controls
	if not base then
		return false
	end

	local function wrapped(self, ...)
		STATE.eat_click = mouse1_down() or nil
		local r = base(self, ...)
		wrap_on_cc_mouse1(cls)
		wrap_update(cls)
		return r
	end

	cls.Main_Controls = wrapped
	STATE.wrap_controls = wrapped
	return true
end

local function patch_new_game()
	local cls = ui_mm_faction_select and ui_mm_faction_select.UINewGame
	if not cls then
		return false
	end

	local ok_diff = wrap_loader(
		cls, "LoadDifficulty", "list_difficulty", "table_difficulty", "selected_difficulty", "wrap_difficulty"
	)
	local ok_eco = wrap_loader(
		cls, "LoadEconomy", "list_economy", "table_economy", "selected_economy", "wrap_economy"
	)
	local ok_map = wrap_load_map(cls)
	wrap_on_cc_mouse1(cls)
	wrap_update(cls)
	wrap_main_controls(cls)
	return ok_diff and ok_eco and ok_map
end

_G.dogma_gui_newgame_layout_conf = {
	MOD_ID = MOD_ID,
	DEFAULTS = {
		default_hard = true,
		default_spawn = true,
	},
	loaded = {},
	patch_new_game = patch_new_game,
}

--[[
	New Game Layout - MCM + main-menu patch.

	Must live in *mcm.script: MCM loads those at the main menu.
	zzzz_* body scripts are not loaded until a game session, so a main.script
	patch never sees New Game on a cold boot.

	Wraps LoadDifficulty / LoadEconomy / LoadMap so first open and Randomize
	can pick Veteran + Survivalist + each faction's main base. Manual combo
	changes still work (OnSelect*). MCM toggles gate those defaults.

	Soulslike checkbox: we replace their injector
	(scripts/override/souslike_gamemode_injector_mcm.script).
]]

local CONFIG = _G.dogma_gui_newgame_layout_conf

-- Top-level: runs when MCM gathers *mcm.script at main menu.
CONFIG.patch_new_game()

function on_mcm_load(options)
	CONFIG.patch_new_game()

	dogma_mcm.attach(options, "gui", "ui_mcm_menu_dogma_gui", {
		id = "newgame_layout",
		sh = true,
		text = "ui_mcm_menu_dogma_gui_newgame_layout",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_gui_newgame_layout_page_description",
			},
			{
				id = "default_hard",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.default_hard,
				hint = "dogma_gui_newgame_layout_default_hard",
			},
			{
				id = "default_spawn",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.default_spawn,
				hint = "dogma_gui_newgame_layout_default_spawn",
			},
		}),
	})
end
