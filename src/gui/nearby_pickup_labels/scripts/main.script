--[[
	Nearby Pickup Labels

	Auto-show hold-Use style item name labels for pickable world items within
	MCM range (0 = off, max 10 m). Hidden while Use is held so vanilla labels win.
]]

local CONFIG = _G.dogma_gui_nearby_pickup_labels_conf

local UI_XML = "ui_dogma_gui_nearby_pickup_labels.xml"
local LABEL_W = 256
local LABEL_H = 18
local LABEL_HALF_W = LABEL_W * 0.5
local LABEL_HALF_H = LABEL_H * 0.5
local MAX_LABELS = 32
local ALIGN_CENTER = 2 -- CGameFont::alCenter

local HUD = nil
local POS_VEC = vector2()
local name_cache = {}
local label_color = nil

-- vanilla PICKUP_INFO_COLOR 0xFFDDDDDD
local function pickup_color()
	if not label_color then
		label_color = GetARGB(255, 221, 221, 221)
	end
	return label_color
end

local function on_option_change()
	CONFIG.loaded.range = dogma.mcm.float(CONFIG.MOD_ID, "range")
end

local function use_held()
	if not (bind_to_dik and key_bindings and key_bindings.kUSE) then
		return false
	end
	for i = 0, 1 do
		local ok, dik = pcall(bind_to_dik, key_bindings.kUSE, i)
		if ok and dik and dik > 0 and dogma.input.is_key_down(dik) then
			return true
		end
	end
	local dik = bind_to_dik(key_bindings.kUSE)
	return dik and dik > 0 and dogma.input.is_key_down(dik)
end

local function pda_shown()
	if not (ActorMenu and ActorMenu.get_pda_menu) then
		return false
	end
	local pda = ActorMenu.get_pda_menu()
	return pda and pda.IsShown and pda:IsShown()
end

local function item_name(sec)
	local cached = name_cache[sec]
	if cached then
		return cached
	end
	local name = nil
	if ui_item and ui_item.get_sec_name then
		name = ui_item.get_sec_name(sec)
	end
	if (not name or name == "") and ini_sys and ini_sys.r_string_ex then
		local id = ini_sys:r_string_ex(sec, "inv_name")
		if id and id ~= "" and game and game.translate_string then
			name = game.translate_string(id)
		end
	end
	if not name or name == "" then
		name = sec
	end
	name_cache[sec] = name
	return name
end

local function can_pickup(obj)
	if not (obj and obj.is_inventory_item and obj:is_inventory_item()) then
		return false
	end
	if obj.parent and obj:parent() then
		return false
	end
	local sec = obj.section and obj:section()
	if not sec or sec == "" then
		return false
	end
	if ini_sys and ini_sys.r_bool_ex then
		local take = ini_sys:r_bool_ex(sec, "can_take", true)
		if take == false then
			return false
		end
	end
	return true
end

class "UINearbyPickupLabels" (CUIScriptWnd)

function UINearbyPickupLabels:__init() super()
	self.xml = CScriptXmlInit()
	self.xml:ParseFile(UI_XML)
	self.labels = {}
	self:EnsureLabels(1)
end

function UINearbyPickupLabels:__finalize()
end

function UINearbyPickupLabels:EnsureLabels(n)
	if n > MAX_LABELS then
		n = MAX_LABELS
	end
	while #self.labels < n do
		local st = self.xml:InitStatic("label", self)
		local tc = st:TextControl()
		pcall(function()
			tc:SetTextComplexMode(false)
			tc:SetTextAlignment(ALIGN_CENTER)
			tc:SetTextColor(pickup_color())
		end)
		st:Show(false)
		self.labels[#self.labels + 1] = st
	end
end

function UINearbyPickupLabels:HideAll()
	for i = 1, #self.labels do
		self.labels[i]:Show(false)
	end
end

function UINearbyPickupLabels:ShowAt(i, x, y, text)
	local st = self.labels[i]
	if not st then
		return
	end
	st:SetWndPos(POS_VEC:set(x - LABEL_HALF_W, y - LABEL_HALF_H))
	st:TextControl():SetText(text)
	st:Show(true)
end

local function activate_hud()
	if HUD == nil then
		HUD = UINearbyPickupLabels()
		get_hud():AddDialogToRender(HUD)
	end
end

local function deactivate_hud()
	if HUD ~= nil then
		get_hud():RemoveDialogToRender(HUD)
		HUD = nil
	end
end

local function hide_labels()
	if HUD then
		HUD:HideAll()
	end
end

local function update_labels(actor, radius)
	activate_hud()
	local shown = 0
	level.iterate_nearest(actor:position(), radius, function(obj)
		if shown >= MAX_LABELS then
			return true
		end
		if not can_pickup(obj) then
			return
		end
		local pos = obj:position()
		local ui = game.world2ui(pos)
		if not ui or ui.x <= -9990 then
			return
		end
		shown = shown + 1
		HUD:EnsureLabels(shown)
		HUD:ShowAt(shown, ui.x, ui.y, item_name(obj:section()))
	end)
	for i = shown + 1, #HUD.labels do
		HUD.labels[i]:Show(false)
	end
end

function actor_on_net_destroy()
	deactivate_hud()
end

function on_screen_resolution_changed()
	deactivate_hud()
end

local function on_actor_on_update()
	local actor = dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change)
	if not actor then
		return
	end

	local radius = CONFIG.loaded.range
	if type(radius) ~= "number" or radius <= 0 then
		hide_labels()
		return
	end
	if not actor:alive() or use_held() or pda_shown() then
		hide_labels()
		return
	end

	update_labels(actor, radius)
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	RegisterScriptCallback("actor_on_update", on_actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	RegisterScriptCallback("on_screen_resolution_changed", on_screen_resolution_changed)
	RegisterScriptCallback("on_option_change", on_option_change)
end
