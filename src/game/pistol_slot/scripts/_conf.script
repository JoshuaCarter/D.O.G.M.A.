-- game/pistol_slot conf
-- Controls row only (custom25) — not an MCM mirror; bind via Settings → Controls.

local BINDS = {
	draw = {
		action = "custom25",
		kb = "kCUSTOM25",
		control = {
			id = "kb_pistol_holster",
			label = "Weapon 4 (Pistol)",
			group = "kb_grp_weapons",
			after = "kb_weapon3",
		},
	},
}

_G.dogma_game_pistol_slot_conf = {
	MOD_ID = "dogma/game/pistol_slot",
	BINDS = BINDS,
	PISTOL_SLOT = 16,
	PISTOL_CELL = 16,
	PISTOL_TYPE_KEY = 2, -- LTX slot 1 (pistol) + 1 → ui_inventory slot_cell key
}

do
	local KM = __dogma_key_mirror_mcm
	local c = BINDS.draw.control
	if KM and c then
		KM.claim_control({
			action = BINDS.draw.action,
			id = c.id,
			label = c.label,
			group = c.group,
			after = c.after,
		})
	end
end
