<stalker_id>

	<!-- Leader line (rotated strip; drawn under ID text/icon). -->
	<line_sh width="64" height="2" stretch="1">
		<texture r="0" g="0" b="0" a="255">ui_dogma_stalker_id_white</texture>
	</line_sh>
	<line width="64" height="2" stretch="1">
		<texture r="255" g="255" b="255" a="200">ui_dogma_stalker_id_white</texture>
	</line>

	<dbg_dot x="0" y="0" width="4" height="4" stretch="1">
		<texture>ui_dogma_stalker_id_white</texture>
	</dbg_dot>
	<dbg_seg x="0" y="0" width="8" height="1" stretch="1">
		<texture>ui_dogma_stalker_id_white</texture>
	</dbg_seg>

	<!-- alive -->
	<patch_stalker x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_stalker</texture>
	</patch_stalker>
	<patch_bandit x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_bandit</texture>
	</patch_bandit>
	<patch_csky x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_csky</texture>
	</patch_csky>
	<patch_army x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_army</texture>
	</patch_army>
	<patch_freedom x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_freedom</texture>
	</patch_freedom>
	<patch_dolg x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_dolg</texture>
	</patch_dolg>
	<patch_ecolog x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_ecolog</texture>
	</patch_ecolog>
	<patch_killer x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_killer</texture>
	</patch_killer>
	<patch_monolith x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_monolith</texture>
	</patch_monolith>
	<patch_greh x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_greh</texture>
	</patch_greh>
	<patch_renegade x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_renegade</texture>
	</patch_renegade>
	<patch_isg x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_isg</texture>
	</patch_isg>

	<!-- dead -->
	<patch_dead_stalker x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
		<texture>ui_mm_faction_stalker_inactive</texture>
	</patch_dead_stalker>
	<patch_dead_bandit x="512" y="60" width="18" height="24" alignment="c" scale="1" scale_min="1" scale_max="1" stretch="1">
