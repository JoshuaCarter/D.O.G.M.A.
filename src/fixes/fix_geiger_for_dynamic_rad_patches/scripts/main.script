--[[
	Geiger

	GAMMA Dynamic Radiation Areas spawn zone_radioactive_very_weak /
	below_average / above_average (etc.) that stock all_zone_detector
	never lists. The equippable geiger's env readout uses
	level.get_env_rads() from that list - so patch levels stayed at 0.
	LTX registers the missing sections. This script defaults the
	dosimeter to environment mode so the held device shows patch power
	(Shift+Geiger still toggles body / environment).
]]

local CONFIG = _G.dogma_fixes_fix_geiger_for_dynamic_rad_patches_conf

local on_actor_on_first_update = function()
	if not dogma.mcm.bool(CONFIG.MOD_ID, "env_mode", true) then
		return
	end
	if item_device then
		item_device.dosimeter_env_rads_mode = true
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", on_actor_on_first_update)
end
