<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_menu">
		<text>Menu</text>
	</string>
	<string id="ui_mcm_menu_dogma_menu_dynamic_loadout">
		<text>Dynamic Loadout</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_page_description">
		<text>Scores weapons/armor/helmets/ammo/sights at New Game Randomize, filters by faction and point caps, then forces the starting loadout. Temporary MCM knobs for tuning — check the game log for score dumps.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_caps_section">
		<text>Point caps (tuning)</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_enabled">
		<text>Enabled</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_enabled_desc">
		<text>When on, Randomize builds a scored loadout and starts the game.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_log_scores">
		<text>Log scores</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_log_scores_desc">
		<text>Dump every scored item to the game log ([dogma_menu_dynamic_loadout]).</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_include_universal_armor">
		<text>Include universal armor</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_include_universal_armor_desc">
		<text>Also allow outfits with empty/actor community alongside faction suits.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_sight_chance">
		<text>Sight chance %</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_sight_chance_desc">
		<text>Chance to add a compatible plain optic (no NVG/thermal).</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_weapon">
		<text>Max weapon pts</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_weapon_desc">
		<text>Only weapons with score-derived points at or below this are eligible.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_armor">
		<text>Max armor pts</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_armor_desc">
		<text>Only outfits at or below this point cost are eligible.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_helmet">
		<text>Max helmet pts</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_helmet_desc">
		<text>Only helmets at or below this point cost are eligible.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_ammo">
		<text>Max ammo pts</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_ammo_desc">
		<text>Only ammo types at or below this point cost are eligible.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_sight">
		<text>Max sight pts</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_max_pts_sight_desc">
		<text>Only sights at or below this point cost are eligible.</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_score_scale">
		<text>Score → pts scale</text>
	</string>
	<string id="ui_mcm_dogma_menu_dynamic_loadout_score_scale_desc">
		<text>Multiplies raw score into point cost (pts = floor(score * scale)).</text>
	</string>
</string_table>
