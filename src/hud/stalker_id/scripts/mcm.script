function on_mcm_load(options)
	local CONFIG = _G.dogma_hud_stalker_id_conf
	dogma_mcm.attach(options, "hud", "ui_mcm_menu_dogma_hud", {
		id = "stalker_id",
		sh = true,
		text = "ui_mcm_menu_dogma_hud_stalker_id",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_stalker_id_page_description",
			},
			{
				id = "dead_id",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["dead_id"],
				hint = "dogma_stalker_id_dead_id",
			},
			{
				id = "name_id",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["name_id"],
				hint = "dogma_stalker_id_name_id",
			},
			{
				id = "rank_id",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["rank_id"],
				hint = "dogma_stalker_id_rank_id",
			},
			{ id = "line_pos", type = "line" },
			{
				id = "hdr_pos",
				type = "desc",
				text = "ui_mcm_dogma_stalker_id_pos_section",
			},
			{
				id = "name_y",
				type = "track",
				val = 2,
				min = 0,
				max = 768,
				step = 1,
				def = CONFIG.DEFAULTS["name_y"],
				hint = "dogma_stalker_id_name_y",
			},
			{
				id = "rank_y",
				type = "track",
				val = 2,
				min = 0,
				max = 768,
				step = 1,
				def = CONFIG.DEFAULTS["rank_y"],
				hint = "dogma_stalker_id_rank_y",
			},
			{
				id = "icon_y",
				type = "track",
				val = 2,
				min = 0,
				max = 768,
				step = 1,
				def = CONFIG.DEFAULTS["icon_y"],
				hint = "dogma_stalker_id_icon_y",
			},
			{ id = "line_alpha", type = "line" },
			{
				id = "hdr_alpha",
				type = "desc",
				text = "ui_mcm_dogma_stalker_id_alpha_section",
			},
			{
				id = "name_a",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS["name_a"],
				hint = "dogma_stalker_id_name_a",
			},
			{
				id = "rank_a",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS["rank_a"],
				hint = "dogma_stalker_id_rank_a",
			},
			{
				id = "icon_a",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS["icon_a"],
				hint = "dogma_stalker_id_icon_a",
			},
		}),
	})
end
