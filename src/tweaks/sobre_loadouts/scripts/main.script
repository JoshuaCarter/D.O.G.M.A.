--[[
	Strip free junk binoculars on new game.

	- anim_binoc: attachable dummy (same name/icon as real binocs, unusable)
	- wpn_binoc: Gunslinger NPC/ruck section (shop sells wpn_binoc_inv)

	Also DLTX release_on_first_update on both (stock itms_manager).
	Script polls during the new-game window as backup.
]]

local JUNK = {
	anim_binoc = true,
	wpn_binoc = true,
}

local polling = false
local deadline = 0

local function strip_once()
	local actor = db and db.actor
	if not (actor and actor.iterate_inventory) then
		return 0
	end
	local ids = {}
	actor:iterate_inventory(function(_, itm)
		if itm and JUNK[itm:section()] then
			ids[#ids + 1] = itm:id()
		end
	end)
	for i = 1, #ids do
		alife_release_id(ids[i])
	end
	return #ids
end

local function actor_on_update()
	if not polling then
		return
	end
	strip_once()
	if time_global() >= deadline then
		polling = false
	end
end

local function actor_on_first_update()
	if has_alife_info and has_alife_info("start_equippment_handled") then
		return
	end
	strip_once()
	-- Cover ChangeLevel + delayed start equip (~4s).
	polling = true
	deadline = time_global() + 8000
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
end
