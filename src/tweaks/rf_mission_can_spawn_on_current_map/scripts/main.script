--[[
	RF Receiver packages (Tweaki_Breeki / Cookbook / GAMMA Economy):

	Stock picks the package map from tb_allmaps[current_level], which is only
	neighbouring maps. Spot pick is a flat random among tb_package_coords.

	Put the current level in that pool (when it has coords) so a package can
	land on the map you are standing on.
]]

local CONFIG = _G.dogma_tweaks_rf_mission_can_spawn_on_current_map_conf
local MOD_ID = CONFIG and CONFIG.MOD_ID or "dogma/tweaks/rf_mission_can_spawn_on_current_map"

local function log(msg)
	if dogma.dbg.logging() then
		dogma.dbg.log(MOD_ID, tostring(msg))
	end
end

local function has_coords(map)
	local spots = tb_package_coords and tb_package_coords[map]
	if type(spots) ~= "table" then
		return false
	end
	return (#spots > 0) or (next(spots) ~= nil)
end

local function list_has(list, map)
	for i = 1, #list do
		if list[i] == map then
			return true
		end
	end
	return false
end

local function add_map(list, map)
	if type(list) == "table" and map and has_coords(map) and not list_has(list, map) then
		list[#list + 1] = map
		return true
	end
	return false
end

local function allow_same_map_spawns()
	if type(tb_allmaps) ~= "table" then
		return false
	end
	for level_id, maps in pairs(tb_allmaps) do
		if type(maps) == "table" then
			if level_id == "default" then
				local here = level and level.name and level.name()
				add_map(maps, here)
			elseif level_id and has_coords(level_id) then
				add_map(maps, level_id)
			end
		end
	end
	return true
end

local function log_spawn(here)
	local there = tb_package_in_level
	local pool = here and tb_allmaps and tb_allmaps[here]
	local n = (type(pool) == "table" and #pool) or 0
	log(string.format("spawn here=%s there=%s pool=%s", tostring(here), tostring(there), tostring(n)))
	if here and there == here then
		dogma.console.say(string.format("RF package spawned on current map (%s)", here), "blue")
	end
end

local function hook_tb_spawn()
	if type(tb_radio_thing) ~= "function" or tb_radio_thing.__dogma_rf_same_map then
		return type(tb_radio_thing) == "function"
	end
	local orig_radio = tb_radio_thing
	function tb_radio_thing()
		allow_same_map_spawns()
		local here = level and level.name and level.name()
		local ok = orig_radio()
		if ok then
			log_spawn(here)
		end
		return ok
	end
	tb_radio_thing.__dogma_rf_same_map = true

	if type(failsafepackagespawn) == "function" and not failsafepackagespawn.__dogma_rf_same_map then
		local orig_fail = failsafepackagespawn
		function failsafepackagespawn()
			allow_same_map_spawns()
			local here = level and level.name and level.name()
			local ok = orig_fail()
			if ok then
				log_spawn(here)
			end
			return ok
		end
		failsafepackagespawn.__dogma_rf_same_map = true
	end
	return true
end

allow_same_map_spawns()

function on_game_start()
	dogma.load(MOD_ID)
	local function refresh()
		allow_same_map_spawns()
		hook_tb_spawn()
	end
	refresh()
	RegisterScriptCallback("on_game_load", refresh)
	CreateTimeEvent("dogma_rf_receiver", "allow_same_map", 0.1, function()
		refresh()
		return true
	end)
end
