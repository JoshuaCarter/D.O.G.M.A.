--[[
	Shared hold+hover for inventory keybinds.
	Press+hold over a cell fires that cell. All-stacks binds expand
	childs. One-stack binds do only the hovered row. Picker rows are
	already one stack: both binds stay on that row. Moving to a new
	cell fires that cell too.

	Race: fire and freeze used to start the same tick, after that
	frame's UpdateInventories. SortingPlus/Seamless Reinit then packs
	the next item into the hole under the cursor with a new idx, and
	On_Hover treats that as a new cell. Same-idx lock cannot catch it.

	Hold: tick 1 only freezes (still + Reinit/Reset/On_Sort blocked).
	Tick 2 fires. After that, idx changes without mouse move are
	layout, not paint. Key release runs the normal refresh.
]]

local MOD_ID = "dogma/input/inventory_controls"

local actions = {}
local in_action = false
local still_was = false
local log_seq = 0
local original_on_hover = nil
local hover_wrapper = nil
local original_update_inventories = nil
local update_inventories_wrapper = nil
local original_reinit = nil
local reinit_wrapper = nil
local original_cc_reset = nil
local cc_reset_wrapper = nil
local original_on_sort = nil
local on_sort_wrapper = nil

local function log(msg)
	if dogma.log.logging() then
		log_seq = log_seq + 1
		dogma.log.log(MOD_ID, string.format("#%d t=%d %s", log_seq, time_global(), tostring(msg)))
	end
end

local function cell_obj(gui, bag, idx)
	local cc = gui and gui.CC and gui.CC[bag]
	return cc and cc:GetObj(idx)
end

local function cell_desc(gui, bag, idx)
	local obj = cell_obj(gui, bag, idx)
	if not obj then
		return string.format("%s[%s]=empty", tostring(bag), tostring(idx))
	end
	return string.format("%s[%s]=%s#%s", tostring(bag), tostring(idx), obj:section(), tostring(obj:id()))
end

local function cursor_xy()
	local p = GetCursorPosition()
	return p.x, p.y
end

local function mark_cursor(hold)
	local x, y = cursor_xy()
	hold.mx = x
	hold.my = y
end

local function mouse_moved(hold)
	if not (hold and hold.mx) then
		return true
	end
	local x, y = cursor_xy()
	return math.abs(x - hold.mx) >= 2 or math.abs(y - hold.my) >= 2
end

local function owner_cell(gui, obj, bag)
	if not (gui and gui.CC and obj) then
		return nil
	end
	if bag == "picker" then
		-- Children are not in the parent bag index. Use the opened cell.
		local p = gui.CC.picker and gui.CC.picker.parent
		local cc = p and p.bag and gui.CC[p.bag]
		return cc and p.idx and cc.cell and cc.cell[p.idx]
	end
	local cc = gui.CC[bag]
	return cc and cc.GetCell_ID and cc:GetCell_ID(obj:id())
end

-- Vanilla Action_Move ignores bag=="picker". Use the opened parent bag.
-- Snapshot this before the picker hides and clears parent.
local function source_bag(gui, bag)
	if bag ~= "picker" then
		return bag
	end
	local p = gui and gui.CC and gui.CC.picker and gui.CC.picker.parent
	return p and p.bag or nil
end

-- whole: parent + childs. Picker rows are already one stack.
-- otherwise just the hovered object. IDs snapshotted first.
local function stack_items(gui, obj, bag, whole)
	if not obj then
		return {}
	end
	if not whole or bag == "picker" then
		return { obj }
	end
	local ci = owner_cell(gui, obj, bag)
	if not ci then
		return { obj }
	end
	local seen = {}
	local items = {}
	local function add(id)
		if not id or seen[id] then
			return
		end
		seen[id] = true
		local item = level.object_by_id(id)
		if item then
			items[#items + 1] = item
		end
	end
	add(ci.ID)
	if ci.childs then
		for id, _ in pairs(ci.childs) do
			add(id)
		end
	end
	return items
end

-- While the stack popup is under the cursor, use its row, not the parent cell.
local function hover_cell(gui)
	local pcc = gui and gui.CC and gui.CC.picker
	if pcc and pcc.IsShown and pcc:IsShown() and pcc.IsCursorOverWindow and pcc:IsCursorOverWindow() then
		local idx = pcc.hover and pcc.hover.idx
		if idx then
			return "picker", idx
		end
	end
	local hover = gui and gui.hover
	if hover then
		return hover.bag, hover.idx
	end
end

local function still_active()
	for i = 1, #actions do
		local act = actions[i]
		if act.still and act.down_prev then
			return true
		end
	end
	return false
end

local function fire_cell(act, obj, bag, idx, gui)
	in_action = true
	act.hold = { bag = bag, idx = idx, locked = true }
	mark_cursor(act.hold)
	log(string.format("fire still=%s %s", tostring(still_active()), cell_desc(gui, bag, idx)))
	act.fire(gui, obj, bag, idx)
	in_action = false
end

local function on_cell(act, bag, idx, gui)
	if not (bag and act.bags[bag]) then
		return
	end
	local hold = act.hold
	if hold and hold.bag == bag and hold.idx == idx then
		if hold.locked or not cell_obj(gui, bag, idx) then
			hold.locked = true
		end
		return
	end
	local obj = cell_obj(gui, bag, idx)
	if obj then
		fire_cell(act, obj, bag, idx, gui)
	else
		act.hold = { bag = bag, idx = idx, locked = true }
		mark_cursor(act.hold)
		log("empty " .. cell_desc(gui, bag, idx))
	end
end

local function arm_hold(act, bag, idx)
	act.hold = { bag = bag, idx = idx, armed = true, locked = true }
	mark_cursor(act.hold)
	log(string.format("arm still=%s active=%s %s[%s]", tostring(act.still), tostring(still_active()), tostring(bag), tostring(idx)))
end

-- Layout can change idx under a still cursor. Only paint when the mouse moved.
local function layout_hold(act, bag, idx, gui)
	local hold = act.hold
	if hold.bag ~= bag or hold.idx ~= idx then
		log(string.format("skip layout %s -> %s", cell_desc(gui, hold.bag, hold.idx), cell_desc(gui, bag, idx)))
	end
	hold.bag = bag
	hold.idx = idx
	hold.locked = true
end

local function poll_action(act, gui)
	if not act.mode_ok(gui) then
		act.hold = nil
		act.down_prev = false
		return
	end
	local down = act.key_down()
	local pressed = down and not act.down_prev
	act.down_prev = down
	if not down then
		if act.hold then
			log("key up")
		end
		act.hold = nil
		return
	end

	local bag, idx = hover_cell(gui)
	if not bag then
		if act.hold then
			act.hold.locked = true
		end
		return
	end

	-- First tick of a hold: freeze only. Fire next tick.
	if pressed or not act.hold then
		arm_hold(act, bag, idx)
		return
	end

	if act.hold.armed then
		act.hold.armed = false
		on_cell(act, bag, idx, gui)
		return
	end

	if not mouse_moved(act.hold) then
		layout_hold(act, bag, idx, gui)
		return
	end

	if act.hold.bag ~= bag or act.hold.idx ~= idx then
		on_cell(act, bag, idx, gui)
	elseif not cell_obj(gui, bag, idx) or act.hold.locked then
		act.hold.locked = true
	end
end

-- Vanilla RefreshInventories: add missing, remove gone. Leaves holes.
-- SortingPlus/Seamless replace that with a full re-sort.
local function refresh_bag(cc, inv)
	if not (cc and inv and cc.indx_id) then
		return
	end
	local list = cc.indx_id
	local bag = cc.ID
	for id, obj in pairs(inv) do
		if not list[id] then
			log(string.format("still add %s#%s -> %s", obj:section(), tostring(id), tostring(bag)))
			cc:AddItem(obj, obj:section())
		end
	end
	local gone = {}
	for id, _ in pairs(list) do
		if not inv[id] then
			gone[#gone + 1] = id
		end
	end
	for i = 1, #gone do
		log(string.format("still rem #%s from %s", tostring(gone[i]), tostring(bag)))
		cc:RemoveItem_byID(gone[i])
	end
end

local function still_refresh(gui)
	if not (gui and gui.CC and gui.ParseInventory) then
		return
	end
	local mode = gui.mode
	if mode == "inventory" or mode == "repair" then
		if db.actor then
			refresh_bag(gui.CC.actor_bag, gui:ParseInventory(db.actor, nil, true))
		end
	elseif mode == "loot" then
		if db.actor then
			refresh_bag(gui.CC.actor_bag, gui:ParseInventory(db.actor, nil, true))
		end
		local npc = gui.GetPartner and gui:GetPartner()
		if npc then
			local inv
			if gui.npc_is_companion and gui.ParseInventory_Companion then
				inv = gui:ParseInventory_Companion(npc, true)
			else
				local is_box = IsInvbox and IsInvbox(npc)
				local all = (not is_box) and npc.alive and (not npc:alive())
				inv = gui:ParseInventory(npc, all, true)
			end
			refresh_bag(gui.CC.npc_bag, inv)
		end
	end
end

local function settle(gui)
	gui = gui or (ui_inventory and ui_inventory.GUI)
	if gui and gui.On_Item_Update then
		log("settle")
		gui:On_Item_Update()
	end
end

local function poll_all(gui)
	local was = still_was
	for i = 1, #actions do
		local act = actions[i]
		if act.tick then
			act.tick(gui)
		end
		poll_action(act, gui)
	end
	local now = still_active()
	if was and not now then
		settle(gui)
	end
	still_was = now
end

local function call_base_hover(self, idx)
	if original_on_hover then
		return original_on_hover(self, idx)
	end
end

local function paint_blocked(act)
	local hold = act.hold
	if not hold then
		return false
	end
	if hold.armed then
		return true
	end
	return hold.locked and not mouse_moved(hold)
end

local function paint_on_hover(self, idx)
	if in_action or not idx then
		return call_base_hover(self, idx)
	end
	local bag = self.ID
	local gui = ui_inventory and ui_inventory.GUI
	for i = 1, #actions do
		local act = actions[i]
		if act.down_prev and act.mode_ok(gui) and not paint_blocked(act) then
			on_cell(act, bag, idx, gui)
		end
	end
	return call_base_hover(self, idx)
end

local function still_block_cc(self)
	return still_active() and self.ID ~= "picker"
end

local update_inventories_wrapper_anon_1 = function(self)
	if still_active() then
		still_refresh(self)
		return
	end
	return original_update_inventories(self)
end

local reinit_wrapper_anon_1 = function(self, t, tf)
	if still_block_cc(self) then
		log("Reinit blocked " .. tostring(self.ID))
		return
	end
	return original_reinit(self, t, tf)
end

local cc_reset_wrapper_anon_1 = function(self, ...)
	if still_block_cc(self) then
		log("Reset blocked " .. tostring(self.ID))
		return
	end
	return original_cc_reset(self, ...)
end

local on_sort_wrapper_anon_1 = function(self, ii, ignore)
	if still_active() then
		log("On_Sort blocked")
		return
	end
	return original_on_sort(self, ii, ignore)
end

local function reapply_still_patches()
	local cls = ui_inventory and ui_inventory.UIInventory
	if cls then
		if cls.UpdateInventories and cls.UpdateInventories ~= update_inventories_wrapper then
			original_update_inventories = cls.UpdateInventories
			update_inventories_wrapper = update_inventories_wrapper_anon_1
			cls.UpdateInventories = update_inventories_wrapper
			log("UpdateInventories patched")
		end
		if cls.On_Sort and cls.On_Sort ~= on_sort_wrapper then
			original_on_sort = cls.On_Sort
			on_sort_wrapper = on_sort_wrapper_anon_1
			cls.On_Sort = on_sort_wrapper
			log("On_Sort patched")
		end
	end
	local cc_class = utils_ui and utils_ui.UICellContainer
	if cc_class then
		if cc_class.Reinit and cc_class.Reinit ~= reinit_wrapper then
			original_reinit = cc_class.Reinit
			reinit_wrapper = reinit_wrapper_anon_1
			cc_class.Reinit = reinit_wrapper
			log("Reinit patched")
		end
		if cc_class.Reset and cc_class.Reset ~= cc_reset_wrapper then
			original_cc_reset = cc_class.Reset
			cc_reset_wrapper = cc_reset_wrapper_anon_1
			cc_class.Reset = cc_reset_wrapper
			log("Reset patched")
		end
	end
end

local hover_wrapper_anon_1 = function(self, idx)
	return paint_on_hover(self, idx)
end

local function reapply_on_hover_patch()
	local cc_class = utils_ui and utils_ui.UICellContainer
	if not (cc_class and cc_class.On_Hover) then
		return
	end
	if cc_class.On_Hover == hover_wrapper then
		return
	end
	original_on_hover = cc_class.On_Hover
	hover_wrapper = hover_wrapper_anon_1
	cc_class.On_Hover = hover_wrapper
	log("On_Hover patched")
end

local function register(spec)
	spec.down_prev = false
	spec.hold = nil
	actions[#actions + 1] = spec
	return spec
end

local function reset(spec)
	if spec then
		spec.down_prev = false
		spec.hold = nil
	end
end

_G.dogma_inv_hover = {
	stack_items = stack_items,
	source_bag = source_bag,
	register = register,
	reset = reset,
}

local original_on_update = ui_inventory and ui_inventory.UIInventory and ui_inventory.UIInventory.Update
if original_on_update then
	function ui_inventory.UIInventory:Update()
		original_on_update(self)
		if dogma.sys.ready(MOD_ID, db) then
			poll_all(self)
		end
	end
end

local on_game_start_anon_1 = function()
	reapply_on_hover_patch()
	reapply_still_patches()
end

function on_game_start()
	dogma.load(MOD_ID)
	RegisterScriptCallback("actor_on_first_update", on_game_start_anon_1)
	reapply_on_hover_patch()
	reapply_still_patches()
	log("hover ready")
end
