--[[
	Melancholy Night Ambient x2

	Named failure: Melancholy nights crush shade; Visual → Night brightness is unused.
	Call path: Environment::OnFrame lerps CurrentEnv, then actor_on_update.

	Double ambient_color and hemisphere_color for hours 21–4. Lerp resets the
	mix each frame, so this is always 2× the LTX value, not a running multiply.
]]

local CONFIG = _G.dogma_tweaks_melancholy_night_ambient_x2_conf

local function melancholy()
	local WM = level_weathers and level_weathers.WeatherManager
	return WM and WM.apply_weather
end

local function night()
	local hour = level.get_time_hours()
	return hour >= 21 or hour <= 4
end

local function scale(name, w)
	local c = weather.get_value_vector(name)
	if not c then
		return
	end
	if w then
		weather.set_value_vector(name, c.x * 2, c.y * 2, c.z * 2, w)
	else
		weather.set_value_vector(name, c.x * 2, c.y * 2, c.z * 2)
	end
end

local function apply()
	if not (weather and weather.get_value_vector and weather.set_value_vector) then
		return
	end
	if not melancholy() or not night() then
		return
	end
	scale("ambient_color")
	scale("hemisphere_color", 1)
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	RegisterScriptCallback("actor_on_update", apply)
end
