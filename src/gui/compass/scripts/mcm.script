-- gui/compass conf

local MARKER_GROUPS = {
    { name = "quest" },
    { name = "turnin" },
    { name = "unique" },
    { name = "companions" },
    { name = "friendly", show_hint = "show_icon_friendly" },
    { name = "hostile", show_hint = "show_icon_hostile" },
    { name = "sleep" },
    { name = "stashes" },
    { name = "transitions" },
    { name = "corpses", show_hint = "show_icon_corpses" },
    { name = "campf", show_hint = "show_icon_campf" },
    { name = "pump", show_hint = "show_icon_pump" },
}

_G.dogma_gui_compass_conf = {
    MOD_ID = "dogma/gui/compass",
    POS_MIN = 0,
    POS_MAX = 768,
    DEFAULTS = {
        enabled = true,
        compass_a = 255,
        marker_a = 255,
        compass_w = 25,
        show_line = true,
        show_cardinals = true,
        show_ticks = true,
        show_center = true,
        compass_y = 747,
        shown = 1,
        keybind = -1,
        -- 0 = toggle, 1 = hold (show while held)
        keybind_mode = 0,
        quest_always = true,
        quest_highlight = true,
        show_quest = true,
        show_quest_dist = 200,
        is_quest_dist = true,
        show_turnin = true,
        show_turnin_dist = 100,
        is_turnin_dist = true,
        show_unique = true,
        show_unique_dist = 30,
        is_unique_dist = true,
        show_companions = true,
        show_companions_dist = 100,
        is_companions_dist = true,
        show_sleep = true,
        show_sleep_dist = 10,
        is_sleep_dist = true,
        show_stashes = true,
        show_stashes_dist = 50,
        is_stashes_dist = true,
        show_transitions = true,
        show_transitions_dist = 50,
        is_transitions_dist = true,
        show_friendly = true,
        show_friendly_dist = 100,
        is_friendly_dist = true,
        show_hostile = true,
        show_hostile_dist = 100,
        is_hostile_dist = true,
        show_corpses = true,
        show_corpses_dist = 20,
        is_corpses_dist = true,
        show_campf = true,
        show_campf_dist = 30,
        is_campf_dist = true,
        show_pump = true,
        show_pump_dist = 30,
        is_pump_dist = true,
    },
    loaded = {
        scale = 1,
        style = nil,
        marker_set = nil,
        groups = {},
    },
}

local CONFIG = _G.dogma_gui_compass_conf

-- HUD is authored for 16:9. Wider screens stretch X, so shrink width to match.
local function aspect_scale()
    local d = device()
    local w = d and d.width
    local h = d and d.height
    if not (w and h and w > 0 and h > 0) then
        return 1
    end

    local k = (16 / 9) / (w / h)
    if k > 1 then
        k = 1
    elseif k < 0.5 then
        k = 0.5
    end

    return k
end

function reload()
    local tostr = tostring
    local L = CONFIG.loaded
    local V = zzzz_dogma_gui_compass_01_variables
    local id = CONFIG.MOD_ID

    L.enabled = dogma.mcm.bool(id, "enabled")
    L.scale = aspect_scale()
    L.keybind = dogma.mcm.key(id, "keybind")
    L.keybind_mode = dogma.mcm.int(id, "keybind_mode")
    if L.keybind_mode == 2 then
        L.keybind_mode = 1
        if ui_mcm then
            ui_mcm.set(id .. "/keybind_mode", 1)
        end
    elseif L.keybind_mode ~= 1 then
        L.keybind_mode = 0
    end
    if L.shown == nil then
        L.shown = CONFIG.DEFAULTS.shown ~= 0
    end
    L.style = V.STYLE
    L.marker_set = V.MARKER_SET
    L.compass_y = dogma.mcm.int(id, "compass_y")
    L.compass_a = dogma.mcm.uint(id, "compass_a")
    L.marker_a = dogma.mcm.uint(id, "marker_a")
    local w = dogma.mcm.uint(id, "compass_w", CONFIG.DEFAULTS.compass_w)
    if w < 1 then
        w = 1
    elseif w > 100 then
        w = 100
    end
    L.compass_w = w
    L.show_line = dogma.mcm.bool(id, "show_line")
    L.show_cardinals = dogma.mcm.bool(id, "show_cardinals")
    L.show_ticks = dogma.mcm.bool(id, "show_ticks")
    L.show_center = dogma.mcm.bool(id, "show_center")
    L.quest_always = dogma.mcm.bool(id, "quest_always")
    L.quest_highlight = dogma.mcm.bool(id, "quest_highlight")

    local groups = L.groups
    for i = 1, #MARKER_GROUPS do
        local name = MARKER_GROUPS[i].name
        local group = groups[name]
        if not group then
            group = {}
            groups[name] = group
        end
        group.enabled = dogma.mcm.bool(id, "show_" .. name)
        group.show_distance = dogma.mcm.bool(id, "is_" .. name .. "_dist")
        group.distance = dogma.mcm.float(id, "show_" .. name .. "_dist")
    end

    local d = device()
    dogma.log.log(id, string.format(
        "reload enabled=%s y=%s a=%s marker_a=%s w=%s line=%s card=%s ticks=%s center=%s scale=%.2f res=%sx%s key=%s mode=%s shown=%s quest_always=%s friend=%s host=%s",
        tostr(L.enabled),
        tostr(L.compass_y),
        tostr(L.compass_a),
        tostr(L.marker_a),
        tostr(L.compass_w),
        tostr(L.show_line),
        tostr(L.show_cardinals),
        tostr(L.show_ticks),
        tostr(L.show_center),
        L.scale,
        tostr(d and d.width),
        tostr(d and d.height),
        tostr(L.keybind),
        tostr(L.keybind_mode),
        tostr(L.shown),
        tostr(L.quest_always),
        tostr(L.groups.friendly and L.groups.friendly.enabled),
        tostr(L.groups.hostile and L.groups.hostile.enabled)
    ))
end

function write_shown(on)
    CONFIG.loaded.shown = on and true or false
    dogma.log.log(CONFIG.MOD_ID, "shown=" .. tostring(CONFIG.loaded.shown))
end

local function hint(id)
    return "dogma_gui_compass_" .. id
end

-- MCM: precondition {fn} -> fn(). False = skip widget. Track still in opt_val.
local function hidden()
    return false
end

local function in_level()
    return level and level.present and level.present()
end

local function not_in_level()
    return not in_level()
end

-- MCM: functor_ui {fn} -> fn(UI_MCM). zzzz_ not safe to index at gather.
local function start_layout(gui)
    local pos = rawget(_G, "zzzz_dogma_gui_compass_06_position")
    if pos and pos.start then
        pos.start(gui)
        return
    end
    dogma.log.log(CONFIG.MOD_ID, "layout button: no position script")
end

local function marker_block(list, group)
    local D = CONFIG.DEFAULTS
    local name = group.name

    list[#list + 1] = {
        id = "hdr_" .. name,
        type = "desc",
        text = "ui_mcm_dogma_gui_compass_hdr_" .. name,
    }
    list[#list + 1] = {
        id = "show_" .. name,
        type = "check",
        val = 1,
        def = D["show_" .. name],
        hint = hint(group.show_hint or "show_icon"),
    }
    if name == "quest" then
        list[#list + 1] = {
            id = "quest_always",
            type = "check",
            val = 1,
            def = D.quest_always,
            hint = hint("quest_always"),
        }
        list[#list + 1] = {
            id = "quest_highlight",
            type = "check",
            val = 1,
            def = D.quest_highlight,
            hint = hint("quest_highlight"),
        }
    end
    list[#list + 1] = {
        id = "is_" .. name .. "_dist",
        type = "check",
        val = 1,
        def = D["is_" .. name .. "_dist"],
        hint = hint("show_distance"),
    }
    list[#list + 1] = {
        id = "show_" .. name .. "_dist",
        type = "track",
        val = 2,
        min = 0,
        max = 500,
        step = 5,
        def = D["show_" .. name .. "_dist"],
        hint = hint("within_range"),
    }
end

function on_mcm_load(options)
    local D = CONFIG.DEFAULTS

    local gr = {
        {
            id = "page_description",
            type = "desc",
            text = "ui_mcm_dogma_gui_compass_page_description",
        },
        {
            id = "compass_y",
            type = "track",
            val = 2,
            def = D.compass_y,
            min = CONFIG.POS_MIN,
            max = CONFIG.POS_MAX,
            step = 1,
            precondition = { hidden },
        },
        {
            id = "enabled",
            type = "check",
            val = 1,
            def = D.enabled,
            hint = hint("enabled"),
        },
        {
            id = "position",
            type = "button",
            functor_ui = { start_layout },
            precondition = { in_level },
        },
        {
            id = "position_need_game",
            type = "desc",
            text = "ui_mcm_dogma_gui_compass_position_need_game",
            clr = { 255, 255, 220, 0 },
            precondition = { not_in_level },
        },
        {
            id = "compass_w",
            type = "track",
            val = 2,
            min = 1,
            max = 100,
            step = 1,
            def = D.compass_w,
            hint = hint("compass_w"),
        },
        {
            id = "show_line",
            type = "check",
            val = 1,
            def = D.show_line,
            hint = hint("show_line"),
        },
        {
            id = "show_cardinals",
            type = "check",
            val = 1,
            def = D.show_cardinals,
            hint = hint("show_cardinals"),
        },
        {
            id = "show_ticks",
            type = "check",
            val = 1,
            def = D.show_ticks,
            hint = hint("show_ticks"),
        },
        {
            id = "show_center",
            type = "check",
            val = 1,
            def = D.show_center,
            hint = hint("show_center"),
        },
        {
            id = "compass_a",
            type = "track",
            val = 2,
            min = 0,
            max = 255,
            step = 1,
            def = D.compass_a,
            hint = hint("compass_a"),
        },
        {
            id = "marker_a",
            type = "track",
            val = 2,
            min = 0,
            max = 255,
            step = 1,
            def = D.marker_a,
            hint = hint("marker_a"),
        },
        { id = "line_key", type = "line" },
        {
            id = "keybind",
            type = "key_bind",
            val = 2,
            def = D.keybind,
            hint = hint("keybind"),
        },
        {
            id = "keybind_mode",
            type = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h",
            val = 2,
            def = D.keybind_mode,
            hint = hint("keybind_mode"),
            content = {
                { 0, "toggle" },
                { 1, "hold" },
            },
        },
        { id = "line_groups", type = "line" },
    }

    for i = 1, #MARKER_GROUPS do
        marker_block(gr, MARKER_GROUPS[i])
    end

    dogma_mcm.attach(options, "gui", "ui_mcm_menu_dogma_gui", {
        id = "compass",
        sh = true,
        text = "ui_mcm_menu_dogma_gui_compass",
        gr = dogma_mcm.with_header(gr),
    })
end
