--[[
    Weapons Ban — attachment scrap.

    Detached scopes / silencers / GLs / tac kits → craft parts.
    Kind + size + optics → formula. Bands: CONSTS.SCRAP_TIER_COST (not STASH_TIER_COST).

    Wraps item_parts.menu_disassembly / disassembly_item (drag-tool or any bind).
    Re-patch on actor_on_first_update so later scripts do not steal the wrap.
]]

local CONFIG = _G.dogma_game_weapons_ban_conf
local CONSTS = _G.dogma_game_weapons_ban_consts
local TIERS = _G.dogma_game_weapons_ban_tiers

local patched_menu_disassembly = false
local patched_disassembly_item = false
local menu_disassembly_wrapper = nil
local disassembly_item_wrapper = nil

local function log(msg)
    if CONFIG.loaded.attach_debug_log then
        dogma.dbg.log(CONFIG.MOD_ID, tostring(msg))
    end
end

local function grid_area(sec)
    local w = dogma.math.clamp(math.floor(ini_sys:r_float_ex(sec, "inv_grid_width") or 1), 1, 6)
    local h = dogma.math.clamp(math.floor(ini_sys:r_float_ex(sec, "inv_grid_height") or 1), 1, 6)
    return dogma.math.clamp(w * h, 1, 12)
end

local function attach_kind(sec)
    if dogma.db.is_upgrade_kit(sec) then
        return "kit"
    end
    if dogma.db.is_silencer(sec) then
        return "silencer"
    end
    if dogma.db.is_gl(sec) then
        return "gl"
    end
    if dogma.db.is_scope(sec) then
        return "scope"
    end
    return nil
end

local function attach_size(kind, area)
    if kind == "kit" then
        if area > 4 then
            return 3
        end
        if area >= 3 then
            return 2
        end
        return 1
    end
    if kind == "scope" and area >= 2 then
        return 2
    end
    return 1
end

local function scope_optics(sec)
    if ini_sys:r_bool_ex(sec, "scope_nightvision") then
        return "nv"
    end
    local img_type = math.floor(ini_sys:r_float_ex(sec, "s3ds_image_type") or 0)
    if img_type == 1 then
        return "nv"
    end
    if img_type == 2 or img_type == 3 then
        return "thermal"
    end
    return "normal"
end

local function is_vanilla_disassemblable(sec)
    local ini_parts = itms_manager and itms_manager.ini_parts
    if not ini_parts then
        return false
    end
    return ini_parts:r_string_ex("nor_parts_list", sec)
        or ini_parts:r_string_ex("con_parts_list", sec)
end

local function classify_attachment(sec)
    local kind = attach_kind(sec)
    if not kind then
        return nil
    end
    local area = grid_area(sec)
    local cost = dogma.db.cost(sec)
    return {
        kind = kind,
        optics = kind == "scope" and scope_optics(sec) or nil,
        size = attach_size(kind, area),
        tier = TIERS.cost_to_tier(cost, CONSTS.SCRAP_TIER_COST[kind]),
        cost = cost,
        area = area,
    }
end

local function classify_obj(obj)
    if not obj then
        return nil
    end
    local sec = obj:section()
    if dogma.db.is_weapon(sec) or dogma.db.is_outfit(sec) or dogma.db.is_helmet(sec) then
        return nil
    end
    if is_vanilla_disassemblable(sec) then
        return nil
    end
    return classify_attachment(sec)
end

local function append(parts, sec, n)
    n = math.floor(n or 0)
    if not sec or n <= 0 then
        return
    end
    for _ = 1, n do
        parts[#parts + 1] = sec
    end
end

local function append_electronics(parts, n)
    local pool = CONSTS.SCRAP_ELECTRONICS
    n = math.floor(n or 0)
    for _ = 1, n do
        append(parts, pool[math.random(#pool)], 1)
    end
end

local function append_upgr(parts, upgr_tier, n)
    local types = CONSTS.SCRAP_KIT_KINDS
    n = math.floor(n or 0)
    for _ = 1, n do
        parts[#parts + 1] = "upgr_w_" .. upgr_tier .. "_" .. types[math.random(#types)]
    end
end

local function scrap_parts(info)
    local parts = {}
    local kind = info.kind
    local size = info.size
    local tier = info.tier
    local optics = info.optics
    local half = math.ceil(tier / 2)
    local map = CONSTS.SCRAP_PARTS

    local scrap
    if kind == "gl" then
        scrap = dogma.math.clamp(tier, 2, 3)
    elseif kind == "kit" then
        scrap = size + 1
        if size == 3 and tier == 5 then
            scrap = scrap + 1
        end
    else
        scrap = half
    end

    local fasteners = scrap
    if kind == "silencer" and tier == 1 then
        fasteners = 0
    end

    append(parts, map.scrap, scrap)
    append(parts, map.fasteners, fasteners)
    if kind == "kit" then
        append(parts, map.plastic, scrap)
    end

    local glass = 0
    if (kind == "scope" and size >= 2) or (kind == "kit" and size >= 2) then
        if kind == "kit" and size == 3 then
            glass = 2
        elseif tier >= 3 then
            glass = 2
        else
            glass = 1
        end
    end
    append(parts, map.glass, glass)

    local electronics = 0
    local battery = 0
    if optics == "nv" or optics == "thermal" then
        electronics = half + (size - 1)
        if optics == "thermal" and size == 1 then
            electronics = math.max(electronics, 2)
        end
        battery = 1
    elseif kind == "kit" and tier >= 3 then
        if size == 3 and tier == 5 then
            electronics = 5
        else
            electronics = size
        end
        if tier >= 4 then
            battery = (size == 3 and tier == 5) and 2 or 1
        end
    end
    append_electronics(parts, electronics)
    append(parts, map.battery, battery)

    if kind == "kit" then
        if size == 1 then
            if tier >= 2 and tier <= 3 then
                append_upgr(parts, 1, 1)
            elseif tier == 4 then
                append_upgr(parts, 2, 1)
            elseif tier == 5 then
                append_upgr(parts, 3, 1)
            end
        elseif size == 2 then
            if tier == 3 then
                append_upgr(parts, 2, 1)
            elseif tier == 4 then
                append_upgr(parts, 3, 1)
            elseif tier == 5 then
                append_upgr(parts, 1, 1)
                append_upgr(parts, 3, 1)
            end
        elseif tier == 4 then
            append_upgr(parts, 1, 1)
            append_upgr(parts, 2, 1)
            append_upgr(parts, 3, 1)
        elseif tier >= 5 then
            append_upgr(parts, 2, 1)
            append_upgr(parts, 3, 2)
        end
    end

    return parts
end

local function call_orig_disassembly(orig, obj, obj_d)
    if not orig then
        return
    end
    if CONFIG.loaded.pda_parts_tip then
        return orig(obj, obj_d)
    end
    local news = actor_menu and actor_menu.set_item_news
    if news then
        actor_menu.set_item_news = function() end
    end
    orig(obj, obj_d)
    if news then
        actor_menu.set_item_news = news
    end
end

local function timer_give_parts(npc_id, parts_tbl, name)
    local npc = npc_id and xobject.go(npc_id)
    if not npc then
        return true
    end

    if CONFIG.loaded.pda_parts_tip then
        local parts_text = item_parts.create_disassemble_list(parts_tbl)
        actor_menu.set_item_news(
            "success",
            "weapon_ammo",
            "st_dis_text_11",
            name,
            game.translate_string("st_dis_text_9"),
            parts_text
        )
    end

    for i = 1, #parts_tbl do
        local part_sec = parts_tbl[i]
        if ini_sys:section_exist(part_sec) then
            xinventory.create_item(part_sec, npc:id())
        else
            log(string.format("disassembly_item: unknown section %s", part_sec))
        end
    end
    return true
end

local function perform_attachment_disassembly(obj, obj_d, info, orig_disassembly_item)
    local tostr = tostring
    local sec = obj:section()
    local id = obj:id()
    local delay = actor_effects.is_animations_on() and 3 or 0
    local name = ui_item.get_sec_name(sec)
    local npc = obj:parent()
    if not npc then
        log(string.format("disassembly_item: no owner for %s id=%s", sec, tostr(id)))
        return
    end

    local parts_tbl = scrap_parts(info)
    if #parts_tbl == 0 then
        log(string.format("disassembly_item: empty drops for %s (%s/%s/T%s)", sec, info.kind, tostr(info.optics), tostr(info.tier)))
        call_orig_disassembly(orig_disassembly_item, obj, obj_d)
        return
    end

    log(string.format(
        "disassembly_item: %s id=%s kind=%s optics=%s size=%s area=%s tier=%s cost=%s parts=%s tool=%s",
        sec,
        tostr(id),
        info.kind,
        tostr(info.optics),
        tostr(info.size),
        tostr(info.area),
        tostr(info.tier),
        tostr(math.floor(info.cost)),
        tostr(#parts_tbl),
        obj_d and obj_d:section() or "nil"
    ))

    local itms_disassemble = GetItemList("disassemble")
    local degr_val = obj_d and itms_disassemble and itms_disassemble[obj_d:section()]
    if obj_d and degr_val then
        utils_item.degrade(obj_d, degr_val)
    end

    utils_item.discharge(obj)
    game_statistics.increment_statistic("items_disassembled")
    actor_effects.play_item_fx("disassemble_metal_fast")

    CreateTimeEvent(0, "dogma_wb_attach_" .. id, delay, timer_give_parts, npc:id(), parts_tbl, name)
end

local function make_menu_disassembly_wrapper(orig)
    return function(obj)
        if CONFIG.loaded.attachments_enabled then
            if classify_obj(obj) then
                return game.translate_string("st_awr_disassembly_cloth")
            end
        end
        return orig(obj)
    end
end

local function make_disassembly_item_wrapper(orig)
    return function(obj, obj_d)
        if CONFIG.loaded.attachments_enabled then
            local info = classify_obj(obj)
            if info then
                perform_attachment_disassembly(obj, obj_d, info, orig)
                return
            end
        end
        return call_orig_disassembly(orig, obj, obj_d)
    end
end

local function reapply_menu_disassembly_patch()
    if not (item_parts and item_parts.menu_disassembly) then
        return
    end
    if item_parts.menu_disassembly == menu_disassembly_wrapper then
        return
    end
    menu_disassembly_wrapper = make_menu_disassembly_wrapper(item_parts.menu_disassembly)
    item_parts.menu_disassembly = menu_disassembly_wrapper
    patched_menu_disassembly = true
    log("reapplied menu_disassembly patch")
end

local function reapply_disassembly_item_patch()
    if not (item_parts and item_parts.disassembly_item) then
        return
    end
    if item_parts.disassembly_item == disassembly_item_wrapper then
        return
    end
    disassembly_item_wrapper = make_disassembly_item_wrapper(item_parts.disassembly_item)
    item_parts.disassembly_item = disassembly_item_wrapper
    patched_disassembly_item = true
    log("reapplied disassembly_item patch")
end

local function apply_patches()
    reapply_menu_disassembly_patch()
    reapply_disassembly_item_patch()
end

local function on_option_change()
    CONFIG:load_mcm()
    log(string.format(
        "attachments: enabled=%s menu_patched=%s item_patched=%s",
        tostring(CONFIG.loaded.attachments_enabled),
        tostring(patched_menu_disassembly),
        tostring(patched_disassembly_item)
    ))
end

function on_game_start()
    CONFIG:ensure_dogma()
    on_option_change()
    apply_patches()

    RegisterScriptCallback("on_option_change", on_option_change)
    RegisterScriptCallback("actor_on_first_update", apply_patches)
    log("attachments: loaded")
end
