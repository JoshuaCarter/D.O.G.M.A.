; Default / object water steps only. Creature water lives in each pair file.
; step_sounds only: do not touch collide.

@[default@materials\water]
step_sounds = dogma_steps\water\water_small_1,dogma_steps\water\water_small_2
@[materials\water@default]:default@materials\water

@[default_object@materials\water]
step_sounds = dogma_steps\water\water_small_1,dogma_steps\water\water_small_2
@[materials\water@default_object]:default_object@materials\water

@[default@materials\water_radiation]
step_sounds = dogma_steps\water\water_small_1,dogma_steps\water\water_small_2
@[materials\water_radiation@default]:default@materials\water_radiation

@[default_object@materials\water_radiation]
step_sounds = dogma_steps\water\water_small_1,dogma_steps\water\water_small_2
@[materials\water_radiation@default_object]:default_object@materials\water_radiation
