--[[
	DOGMA perf timing (namespace module, no globals).

	Private impl; features use dogma.perf (wired by dogma.script).

	Prefer start/stop (no callback). time() is a thin wrapper for rare cases.

	start(label[, threshold_ms]) - push a timing frame (no-op if perf_log off)
	stop()                       - pop; warn if slow; return elapsed_ms (or nil)
	time(label, threshold_ms, fn)- start/fn/stop; returns fn's returns

	Warnings require MCM dogma/debug perf_log. Threshold: call arg →
	perf_warn_threshold_ms → ≤0 = no warn. Outputs: printf + console.say +
	$app_data_root$/dogma_perf.log (not gated by debug_log).
]]

local DEBUG_MOD = "dogma/debug"
local LOG_NAME = "dogma_perf.log"
local stack = {}
local log_path = nil
local log_path_tried = false
-- Cached so hot start()/stop() paths avoid MCM lookups every call.
local logging_on = false

local function now_ms()
	if time_global then
		return time_global()
	end
	return 0
end

local function resolve_log_path()
	if log_path_tried then
		return log_path
	end
	log_path_tried = true
	if not (getFS and getFS().update_path) then
		return nil
	end
	local ok, path = pcall(function()
		return getFS():update_path("$app_data_root$", LOG_NAME)
	end)
	if ok and path and path ~= "" then
		log_path = path
	end
	return log_path
end

local function append_log(line)
	local path = resolve_log_path()
	if not path then
		return
	end
	local ok, f = pcall(io.open, path, "a")
	if not (ok and f) then
		return
	end
	f:write(line)
	f:write("\n")
	f:close()
end

local function read_logging_enabled()
	local mcm = rawget(_G, "__dogma_mcm")
	if mcm and mcm.bool then
		return mcm.bool(DEBUG_MOD, "perf_log", false)
	end
	return false
end

function sync()
	logging_on = read_logging_enabled()
	return logging_on
end

local function default_threshold()
	local mcm = rawget(_G, "__dogma_mcm")
	if mcm and mcm.uint then
		return mcm.uint(DEBUG_MOD, "perf_warn_threshold_ms", 0)
	end
	return 0
end

local function effective_threshold(override_ms)
	if override_ms ~= nil then
		local n = tonumber(override_ms)
		if n ~= nil then
			return math.max(0, math.floor(n + 0.5))
		end
	end
	return default_threshold()
end

local function warn_slow(label, elapsed_ms, threshold_ms)
	if not logging_on then
		return
	end
	if threshold_ms <= 0 or elapsed_ms < threshold_ms then
		return
	end
	local msg = string.format(
		"[dogma_perf] SLOW %s took %dms (threshold %dms)",
		tostring(label or "?"),
		elapsed_ms,
		threshold_ms
	)
	printf("%s", msg)
	local console = rawget(_G, "__dogma_console")
	if console and console.say then
		console.say(msg, "yellow")
	end
	-- Game-time stamp keeps lines sortable without depending on OS clock APIs.
	append_log(string.format("%d %s", now_ms(), msg))
end

function start(label, threshold_ms)
	if not logging_on then
		return
	end
	stack[#stack + 1] = {
		label = label,
		t0 = now_ms(),
		threshold = threshold_ms,
	}
end

function stop()
	local n = #stack
	if n < 1 then
		return nil
	end
	local frame = stack[n]
	stack[n] = nil
	local elapsed = now_ms() - (frame.t0 or 0)
	warn_slow(frame.label, elapsed, effective_threshold(frame.threshold))
	return elapsed
end

function time(label, threshold_ms, fn)
	if not logging_on then
		return fn()
	end
	start(label, threshold_ms)
	-- Preserve all returns (Lua 5.1 `{ fn() }` only keeps the first).
	return (function(...)
		stop()
		return ...
	end)(fn())
end

-- Keep cache in sync with MCM.
if RegisterScriptCallback then
	RegisterScriptCallback("on_option_change", sync)
	RegisterScriptCallback("on_game_load", sync)
	RegisterScriptCallback("actor_on_first_update", sync)
end
