--[[
	Geiger Counter HUD

	Hides the dosimeter tip ("N mSv") that item_device shows on the Geiger key.
]]

local ORIG
local rad_unit

local function is_msv_toast(text)
	if type(text) ~= "string" then
		return false
	end
	if not rad_unit then
		rad_unit = (game and game.translate_string and game.translate_string("st_msv")) or "mSv"
	end
	-- item_device: tostring(rads) .. " " .. rad_unit  →  "0 mSv"
	return text:match("^%-?%d+ " .. rad_unit .. "$") ~= nil
end

local actor_menu_set_msg = function(slot, text, ...)
	if is_msv_toast(text) then
		return
	end
	return ORIG(slot, text, ...)
end

local function patch()
	if not (actor_menu and actor_menu.set_msg) then
		return
	end
	if not ORIG then
		ORIG = actor_menu.set_msg
	end
	actor_menu.set_msg = actor_menu_set_msg
end

function on_game_start()
	patch()
	RegisterScriptCallback("actor_on_first_update", patch)
end
