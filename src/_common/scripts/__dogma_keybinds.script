--[[
	Settings → Controls keybind rows only (no MCM).

	Load order (build output names; lazy unless referenced):
	  1. __dogma_keybinds.script     — this module; CONTROLS registry
	  2. dogma.script                — dogma.keybinds = __dogma_keybinds
	  3. dogma_{path}_conf.script    — _G conf + claim_bind at top level
	  4. dogma_{path}_mcm.script     — _conf prepended by build; also runs at
	                                   main-menu MCM gather (see below)
	  5. modxml_keybinds.script      — on_xml_read → inject CONTROLS rows
	  6. zzzz_dogma_{path}_main.script — body; lazy until game session

	Main menu vs game session (Anomaly lazy scripts):
	  gather_options() loads every *mcm.script (top-level + on_mcm_load).
	  zzzz_* body scripts stay unloaded until on_game_start or an explicit
	  global reference. claim_bind belongs in _conf; build ships it standalone
	  (for game session) and prepends it into *mcm.script when that file exists
	  (so Controls rows exist before the first New Game / Options visit).
	  A feature with Controls keys but no MCM page still needs an empty mcm.script
	  so build prepends _conf for main-menu gather.

	Registration (feature _conf.script):
	  __dogma_keybinds.claim_bind(BINDS.entry)

	Runtime handlers (feature zzzz main, in callbacks only):
	  dogma.keybinds.bind_kb("kCUSTOM25")  → key_bindings entry
]]

local tostr = tostring

-- Ordered: { action, id, label, group, after?, before? }
CONTROLS = {}

local function has_anchor(spec)
	return spec.after ~= nil or spec.before ~= nil
end

function claim(spec)
	if not (spec and spec.action and spec.id and spec.group and has_anchor(spec)) then
		return
	end
	if spec.after and spec.before then
		return
	end
	local id = tostr(spec.id)
	for i = 1, #CONTROLS do
		if CONTROLS[i].id == id then
			return
		end
	end
	local row = {
		action = tostr(spec.action),
		id = id,
		label = spec.label and tostr(spec.label) or nil,
		group = tostr(spec.group),
	}
	if spec.after then
		row.after = tostr(spec.after)
	end
	if spec.before then
		row.before = tostr(spec.before)
	end
	CONTROLS[#CONTROLS + 1] = row
end

-- Feature BIND entry: { action, kb, control = { id, label, group, after/before } }
function claim_bind(entry)
	if not (entry and entry.action and entry.control) then
		return
	end
	local c = entry.control
	claim({
		action = entry.action,
		id = c.id,
		label = c.label,
		group = c.group,
		after = c.after,
		before = c.before,
	})
end

function bind_kb(kb)
	if not (kb and key_bindings) then
		return nil
	end
	return key_bindings[kb]
end
