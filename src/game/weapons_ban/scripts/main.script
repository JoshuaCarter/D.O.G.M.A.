--[[
    Weapons Ban — new-game extras.

    N extra boxes per owned start weapon (on top of loadout);
    optional 59% parts on those guns.

    Trade: traders.script
    Stashes: stashes.script
    Corpses: corpses.script
    Attach scrap: attach_disassemble.script
    Ammo Maker: ammo_craft.script
]]

local CONFIG = _G.dogma_game_weapons_ban_conf
local MOD_ID = CONFIG.MOD_ID
local CONSTS = _G.dogma_game_weapons_ban_consts

-- Persist so we never double-grant within the new-game window before
-- start_equippment_handled is given (~4s).
local EXTRA_AMMO_SAVE_KEY = "dogma_wb_extra_start_ammo"
local START_PARTS_SAVE_KEY = "dogma_wb_start_parts"
local PARTS_COND = CONSTS.START_PARTS_COND
local ini_loadouts

local function log(msg)
    if dogma.log.logging() then
        dogma.log.log(MOD_ID, tostring(msg))
    end
end

local function on_option_change()
    CONFIG:load_mcm()
end

--------------------------------------------------------------------------------
-- New-game extra ammo (same types as stock UINewGame owned-weapon grant)
--------------------------------------------------------------------------------
local function is_start_weapon_sec(sec)
    return dogma.db.is_weapon(sec) and not dogma.db.is_melee(sec)
end

local function ammo_sec_for_weapon(wpn_sec)
    local ammo_class = ini_sys:r_string_ex(wpn_sec, "ammo_class")
    if not ammo_class then
        return nil
    end
    local ammo_tbl = str_explode(ammo_class, ",")
    if not (ammo_tbl and ammo_tbl[1]) then
        return nil
    end
    if not ini_loadouts then
        ini_loadouts = ini_file("items\\settings\\new_game_loadouts.ltx")
    end
    if ini_loadouts then
        local ammo_type = ini_loadouts:r_string_ex("ammo_type_per_wpn", wpn_sec)
        if dogma.db.is_ammo(ammo_type) then
            return ammo_type
        end
    end
    for i = 1, #ammo_tbl do
        if dogma.db.is_ammo(ammo_tbl[i]) then
            return ammo_tbl[i]
        end
    end
    return nil
end

local function give_extra_start_ammo()
    if not dogma.sys.ready(MOD_ID, db, on_option_change) then
        return
    end
    local boxes = math.floor((CONFIG.loaded.extra_start_ammo_boxes or 0) + 0.5)
    if boxes <= 0 then
        return
    end
    -- New game only: stock sets this after the delayed equipment pass.
    if has_alife_info and has_alife_info("start_equippment_handled") then
        return
    end
    if not (db and db.actor and db.actor.iterate_inventory) then
        return
    end

    local ok, m_data = pcall(function()
        return alife_storage_manager.get_state()
    end)
    if not (ok and m_data) then
        return
    end
    if m_data[EXTRA_AMMO_SAVE_KEY] then
        return
    end
    m_data[EXTRA_AMMO_SAVE_KEY] = true

    local ammo_to_spawn = {}
    db.actor:iterate_inventory(function(_temp, itm)
        if not itm then
            return
        end
        local wpn_sec = itm:section()
        if not is_start_weapon_sec(wpn_sec) then
            return
        end
        local sec_ammo = ammo_sec_for_weapon(wpn_sec)
        if not sec_ammo then
            return
        end
        local row = dogma.db.get(sec_ammo)
        local box = (row and row.box) or 1
        if box <= 0 then
            box = 1
        end
        local add = math.floor(box * boxes)
        if add <= 0 then
            return
        end
        ammo_to_spawn[sec_ammo] = (ammo_to_spawn[sec_ammo] or 0) + add
    end)

    local parts = {}
    for sec, cnt in pairs(ammo_to_spawn) do
        alife_create_item(sec, db.actor, { ammo = cnt })
        parts[#parts + 1] = string.format("%s x%s", sec, cnt)
    end
    if #parts > 0 then
        local msg = "new game ammo " .. table.concat(parts, ", ")
        log(msg)
        dogma.overlay.set(MOD_ID, 3, msg, "blue")
    end
end

--------------------------------------------------------------------------------
-- New-game start-weapon parts
--------------------------------------------------------------------------------
local function apply_parts(id)
    local obj = dogma.alife.obj(id)
    if not (obj and item_parts and item_parts.get_parts_con and item_parts.set_parts_con) then
        return false
    end
    local parts = item_parts.get_parts_con(obj, nil, true)
    if type(parts) ~= "table" then
        return false
    end
    local any = false
    for k, _ in pairs(parts) do
        parts[k] = PARTS_COND
        any = true
    end
    if not any then
        return false
    end
    item_parts.set_parts_con(obj:id(), parts)
    return true
end

local function later(name, id, fn)
    if fn(id) or not CreateTimeEvent then
        return
    end
    local n = 0
    CreateTimeEvent(MOD_ID, name .. tostring(id), 0.1, function()
        n = n + 1
        return fn(id) or n >= 10
    end)
end

local function apply_start_weapon_parts()
    if not dogma.sys.ready(MOD_ID, db, on_option_change) then
        return
    end
    if not CONFIG.loaded.start_weapons_59_parts then
        return
    end
    -- New game only: stock sets this after the delayed equipment pass.
    if has_alife_info and has_alife_info("start_equippment_handled") then
        return
    end
    if not (db and db.actor and db.actor.iterate_inventory) then
        return
    end

    local ok, m_data = pcall(function()
        return alife_storage_manager.get_state()
    end)
    if not (ok and m_data) then
        return
    end
    if m_data[START_PARTS_SAVE_KEY] then
        return
    end
    m_data[START_PARTS_SAVE_KEY] = true

    db.actor:iterate_inventory(function(_temp, itm)
        if not itm then
            return
        end
        if not is_start_weapon_sec(itm:section()) then
            return
        end
        later("parts_", itm:id(), apply_parts)
        log(string.format("new game parts %s -> %s%%", itm:section(), PARTS_COND))
    end)
end

local function actor_on_first_update()
    give_extra_start_ammo()
    apply_start_weapon_parts()
end

function on_game_start()
    dogma.load(MOD_ID)
    RegisterScriptCallback("on_option_change", on_option_change)
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    on_option_change()
    log("weapons_ban ready")
end
