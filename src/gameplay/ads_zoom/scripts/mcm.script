function on_mcm_load(options)
	local CONFIG = _G.dogma_gameplay_ads_zoom_conf
	local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"

	local function ads_track(id, max, hint)
		return {
			id = id,
			type = "track",
			val = 2,
			min = 0,
			max = max,
			step = 1,
			def = CONFIG.DEFAULTS[id],
			hint = hint,
		}
	end

	dogma_mcm.mcm.attach(options, "gameplay", "ui_mcm_menu_dogma_gameplay", {
		id = "ads_zoom",
		sh = true,
		text = "ui_mcm_menu_dogma_gameplay_ads_zoom",
		gr = dogma_mcm.mcm.with_header({
			{
				id = "ads_description",
				type = "desc",
				text = "ui_mcm_dogma_gameplay_ads_zoom_ads_description",
			},
			{
				id = "wads_defaults_header",
				type = "title",
				text = "ui_mcm_dogma_gameplay_ads_zoom_wads_defaults_header",
			},
			ads_track("fov_zoom", 15, "dogma_gameplay_ads_zoom_fov_zoom"),
			ads_track("wads_irons", 15, "dogma_gameplay_ads_zoom_wads_irons"),
			ads_track("wads_sight", 25, "dogma_gameplay_ads_zoom_wads_sight"),
			ads_track("wads_scope", 35, "dogma_gameplay_ads_zoom_wads_scope"),
			{
				id = "dof",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["dof"],
				hint = "dogma_gameplay_ads_zoom_dof",
			},
			{
				id = "dof_irons",
				type = "track",
				val = 2,
				min = 0,
				max = 1,
				step = 0.05,
				def = CONFIG.DEFAULTS["dof_irons"],
				hint = "dogma_gameplay_ads_zoom_dof_irons",
			},
			{
				id = "dof_sight",
				type = "track",
				val = 2,
				min = 0,
				max = 1,
				step = 0.05,
				def = CONFIG.DEFAULTS["dof_sight"],
				hint = "dogma_gameplay_ads_zoom_dof_sight",
			},
			{
				id = "dof_scope",
				type = "track",
				val = 2,
				min = 0,
				max = 1,
				step = 0.05,
				def = CONFIG.DEFAULTS["dof_scope"],
				hint = "dogma_gameplay_ads_zoom_dof_scope",
			},
			{ id = "line_wads_keys", type = "line" },
			{
				id = "wads_keys_header",
				type = "title",
				text = "ui_mcm_dogma_gameplay_ads_zoom_wads_keys_header",
			},
			{
				id = "wads_inc_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["wads_inc_key"],
				hint = "dogma_gameplay_ads_zoom_wads_inc_key",
			},
			{
				id = "wads_dec_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["wads_dec_key"],
				hint = "dogma_gameplay_ads_zoom_wads_dec_key",
			},
			{
				id = "wads_reset_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["wads_reset_key"],
				hint = "dogma_gameplay_ads_zoom_wads_reset_key",
			},
			{
				id = "wads_key_modifier",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS["wads_key_modifier"],
				hint = "mcm_kb_modifier",
				content = {
					{ 0, "mcm_kb_mod_none" },
					{ 1, "mcm_kb_mod_shift" },
					{ 2, "mcm_kb_mod_ctrl" },
					{ 3, "mcm_kb_mod_alt" },
				},
			},
		}),
	})
end
