-- hud/quick_action_wheel conf
-- Patches HarukaSai QAW / G.A.M.M.A. Balance / QAW Overhaul ShowDialog HUD hide.

local defaults = {
	-- Stock QAW uses ShowDialog(true) and hides game indicators.
	-- Default off so HUD (minimap, etc.) stays visible while the wheel is open.
	["hide_hud"] = false,
}

_G.dogma_hud_quick_action_wheel_conf = {
	MOD_ID = "dogma/hud/quick_action_wheel",
	DEFAULTS = defaults,
	loaded = {
		hide_hud = defaults["hide_hud"],
	},
}
