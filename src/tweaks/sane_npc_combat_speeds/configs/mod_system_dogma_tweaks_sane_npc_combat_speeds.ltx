; NPC Move Speed
; Source of truth: Anomaly 1.5.3
;   stalker:  C:\Anomaly\tools\_unpacked\configs\creatures\m_stalker.ltx
;   shambler: C:\Anomaly\tools\_unpacked\configs\creatures\m_zombie.ltx
; free / panic = Anomaly defaults
; danger (combat) = Anomaly x1.20
; shambler linear + turn = Anomaly x0.70 (30% slower). Not zombied stalkers.
; ISG danger = Anomaly x1.50 (wired via isg_movement_speeds)
;
; Other mods that touch these tables (overridden by this DLTX when DOGMA is later):
;   - G.A.M.M.A. NPCs Faster Reactions (also disabled in manifest)
;   - 45- Stealth Overhaul - xcvb (same boosted danger table; DLTX wins when DOGMA is later)
;   - 209- Death Animations (ships stock Anomaly speeds in its m_stalker.ltx copy)

![stalker_movement_speeds]
    ; danger - Anomaly x1.20
    ;; crouch
    ;;; walk
    danger_crouch_walk_forward  = 1.56 ; 1.3
    danger_crouch_walk_backward = 1.20 ; 1.0
    danger_crouch_walk_left     = 1.44 ; 1.2
    danger_crouch_walk_right    = 1.44 ; 1.2
    ;;; run
    danger_crouch_run_forward   = 3.00 ; 2.5
    danger_crouch_run_backward  = 2.04 ; 1.7
    danger_crouch_run_left      = 2.40 ; 2.0
    danger_crouch_run_right     = 2.40 ; 2.0
    ;; stand
    ;;; walk
    danger_stand_walk_forward   = 3.00 ; 2.5
    danger_stand_walk_backward  = 2.04 ; 1.7
    danger_stand_walk_left      = 2.40 ; 2.0
    danger_stand_walk_right     = 2.40 ; 2.0
    ;;; run
    danger_stand_run_forward    = 5.40 ; 4.5
    danger_stand_run_backward   = 2.40 ; 2.0
    danger_stand_run_left       = 2.40 ; 2.0
    danger_stand_run_right      = 2.40 ; 2.0
    ; free - Anomaly
    free_stand_walk_forward     = 1.1
    free_stand_run_forward      = 3.0
    ; panic - Anomaly
    panic_stand_run_forward     = 6.0

; Shamblers (mutant zombies). zombie_weak copies these so both sections need the edit.
; linear | angular_real | angular_path | min | max
; linear + both angular = Anomaly x0.70. min/max unchanged.
![m_zombie_e]
    ; Anomaly 0, 1.4, 1.4, 1, 1
    Velocity_Stand          = 0,        0.98,       0.98,   1,  1
    ; Anomaly 0.9, 0.6, 0.6, 0.02, 2.0
    Velocity_WalkFwdNormal  = 0.63,     0.42,       0.42,   0.02,   2.0
    ; Anomaly 1.7, 3.0, 3.0, 0.4, 1
    Velocity_RunFwdNormal   = 1.19,     2.1,        2.1,    0.4,    1
    ; Anomaly 0.7, 3.0, 0.8, 0.2, 2.0
    Velocity_WalkFwdDamaged = 0.49,     2.1,        0.56,   0.2,    2.0
    ; Anomaly 1.5, 3.0, 3.0, 0.2, 1
    Velocity_RunFwdDamaged  = 1.05,     2.1,        2.1,    0.2,    1

![zombie_weak]
    ; Anomaly 0, 1.4, 1.4, 1, 1
    Velocity_Stand          = 0,        0.98,       0.98,   1,  1
    ; Anomaly 0.9, 0.6, 0.6, 0.02, 2.0
    Velocity_WalkFwdNormal  = 0.63,     0.42,       0.42,   0.02,   2.0
    ; Anomaly 1.7, 3.0, 3.0, 0.4, 1
    Velocity_RunFwdNormal   = 1.19,     2.1,        2.1,    0.4,    1
    ; Anomaly 0.7, 3.0, 0.8, 0.2, 2.0
    Velocity_WalkFwdDamaged = 0.49,     2.1,        0.56,   0.2,    2.0
    ; Anomaly 1.5, 3.0, 3.0, 0.2, 1
    Velocity_RunFwdDamaged  = 1.05,     2.1,        2.1,    0.2,    1

; ISG: Anomaly has no separate bank (they use stalker_movement_speeds).
; Create one so combat can be +50% while free/panic stay Anomaly.
[isg_movement_speeds]
    ; danger - Anomaly x1.50
    ;; crouch
    ;;; walk
    danger_crouch_walk_forward  = 1.95 ; 1.3
    danger_crouch_walk_backward = 1.50 ; 1.0
    danger_crouch_walk_left     = 1.80 ; 1.2
    danger_crouch_walk_right    = 1.80 ; 1.2
    ;;; run
    danger_crouch_run_forward   = 3.75 ; 2.5
    danger_crouch_run_backward  = 2.55 ; 1.7
    danger_crouch_run_left      = 3.00 ; 2.0
    danger_crouch_run_right     = 3.00 ; 2.0
    ;; stand
    ;;; walk
    danger_stand_walk_forward   = 3.75 ; 2.5
    danger_stand_walk_backward  = 2.55 ; 1.7
    danger_stand_walk_left      = 3.00 ; 2.0
    danger_stand_walk_right     = 3.00 ; 2.0
    ;;; run
    danger_stand_run_forward    = 6.75 ; 4.5
    danger_stand_run_backward   = 3.00 ; 2.0
    danger_stand_run_left       = 3.00 ; 2.0
    danger_stand_run_right      = 3.00 ; 2.0
    ; free - Anomaly
    free_stand_walk_forward     = 1.1
    free_stand_run_forward      = 3.0
    ; panic - Anomaly
    panic_stand_run_forward     = 6.0

![sim_default_isg_0]
movement_speeds                 = isg_movement_speeds

