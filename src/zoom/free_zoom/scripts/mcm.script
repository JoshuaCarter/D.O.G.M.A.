						type = "track",
						val = 2,
						min = 0,
						max = 50,
						step = 1,
						def = 50,
						hint = "dorn_free_zoom_free_zoom",
					},
					{
						id = "move_speed",
						type = "track",
						val = 2,
						min = 0,
						max = 70,
						step = 1,
						def = 70,
						hint = "dorn_free_zoom_move_speed",
					},
					{
						id = "empty_hands_only",
						type = "check",
						val = 1,
						def = false,
						hint = "dorn_free_zoom_empty_hands_only",
					},
					{ id = "line_keybind", type = "line" },
					{
						id = "keybind_header",
						type = "title",
						text = "ui_mcm_dorn_free_zoom_keybind_header",
					},
					{
						id = "zoom_key",
						type = "key_bind",
						val = 2,
						def = -1,
						hint = "dorn_free_zoom_zoom_key",
					},
					{
						id = "zoom_key_mode",
						type = kb_mod,
						val = 2,
						def = 0,
						hint = "dorn_free_zoom_zoom_key_mode",
						content = {
							{ 0, "dorn_free_zoom_mode_single" },
							{ 1, "dorn_free_zoom_mode_double" },
							{ 2, "dorn_free_zoom_mode_long" },
							{ 3, "dorn_free_zoom_mode_hold" },
						},
					},
					{
						id = "zoom_key_modifier",
						type = kb_mod,
						val = 2,
						def = 0,
						hint = "mcm_kb_modifier",
						content = {
							{ 0, "mcm_kb_mod_none" },
							{ 1, "mcm_kb_mod_shift" },
							{ 2, "mcm_kb_mod_ctrl" },
							{ 3, "mcm_kb_mod_alt" },
						},
					},
					{ id = "line_mouse_wheel", type = "line" },
					{
						id = "mouse_wheel_header",
						type = "title",
						text = "ui_mcm_dorn_free_zoom_mouse_wheel_header",
					},
					{
						id = "rmb_zoom",
						type = kb_mod,
						val = 2,
						def = 0,
						hint = "dorn_free_zoom_rmb_zoom",
						content = {
							{ 0, "dorn_free_zoom_mouse_mode_no" },
							{ 1, "dorn_free_zoom_mouse_mode_toggle" },
							{ 2, "dorn_free_zoom_mouse_mode_hold" },
						},
					},
					{
						id = "mmb_zoom",
						type = kb_mod,
						val = 2,
						def = 0,
						hint = "dorn_free_zoom_mmb_zoom",
						content = {
							{ 0, "dorn_free_zoom_mouse_mode_no" },
							{ 1, "dorn_free_zoom_mouse_mode_toggle" },
							{ 2, "dorn_free_zoom_mouse_mode_hold" },
						},
					},
					{
						id = "scroll_wheel_weapon_warning",
						type = "desc",
						text = "ui_mcm_dorn_free_zoom_scroll_wheel_weapon_warning",
						clr = { 255, 220, 160, 40 },
					},
					{
						id = "scroll_wheel_zoom",
						type = "check",
						val = 1,
						def = false,
						hint = "dorn_free_zoom_scroll_wheel_zoom",
					},
					{
						id = "scroll_wheel_reverse",
						type = "check",
						val = 1,
						def = false,
						hint = "dorn_free_zoom_scroll_wheel_reverse",
					},
					{
						id = "scroll_wheel_steps",
						type = "track",
						val = 2,
						min = 1,
						max = 5,
						step = 1,
						def = 1,
						hint = "dorn_free_zoom_scroll_wheel_steps",
					},
					{
						id = "scroll_wheel_max_gap_ms",
						type = "track",
						val = 2,
						min = 50,
						max = 500,
						step = 25,
						def = 200,
						hint = "dorn_free_zoom_scroll_wheel_max_gap_ms",
					},
				}),
			},
			{
				id = "ads_zoom",
				sh = true,
				text = "ui_mcm_dorn_free_zoom_ads_zoom_section",
				gr = MCM.with_header(ads_gr),
