	</string>
	<string id="ui_mcm_dogma_free_zoom_scroll_wheel_steps">
		<text>Scrolls needed</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_scroll_wheel_steps_desc">
		<text>Raise if the wheel is twitchy.</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_scroll_wheel_max_gap_ms">
		<text>Scroll timeout (ms)</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_scroll_wheel_max_gap_ms_desc">
		<text>Resets the scroll count after this gap.</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_keys_header">
		<text>This weapon</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_inc_key">
		<text>Increase ADS zoom</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_inc_key_desc">
		<text>Press: +5% HUD zoom for this weapon and irons/sight/scope. Only while ADS.</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_dec_key">
		<text>Decrease ADS zoom</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_dec_key_desc">
		<text>Press: -5% HUD zoom for this weapon and irons/sight/scope. Only while ADS.</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_reset_key">
		<text>Reset ADS zoom</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_wads_reset_key_desc">
		<text>Clears the HUD override for this weapon and irons/sight/scope. Uses the Irons/Sights/Scopes default again.</text>
	</string>
