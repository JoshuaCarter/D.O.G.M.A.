--[[
	Inventory drop keybinds.
	Press: one stack. Hold: one stack then step-timed repeats while held;
	hovered item id change resets the streak and fires again.
	Input via dogma.input (polled from inventory Update).
]]

local CONFIG = _G.dogma_items_drop_conf
local MOD_ID = CONFIG.MOD_ID

local MODE_PRESS = 0
local MODE_HOLD = 2

local ALLOWED_BAGS = {
	actor_bag = true,
	actor_equ = true,
	actor_belt = true,
	npc_bag = true,
	picker = true,
}

local BINDS = {}
local hold_state = {} -- [dik] = { bind, t0, fire_count, last_id }
local down_prev = {} -- [dik] = bool, edge detect across inventory Update ticks

local function log(msg)
	if dogma.dbg and dogma.dbg.logging() then
		dogma.dbg.log(MOD_ID, tostring(msg))
	end
end

local function on_option_change()
	CONFIG.loaded.drop_safe_equipped = dogma.mcm.bool(MOD_ID, "drop_safe_equipped")
	BINDS = {}
	hold_state = {}
	down_prev = {}
	local key = dogma.mcm.key(MOD_ID, "key_drop")
	if key then
		local mode = math.floor(dogma.mcm.number(MOD_ID, "key_drop_mode", 0) + 0.5)
		-- Old dtap (1) acts as press; hold stays 2.
		if mode ~= MODE_HOLD then
			mode = MODE_PRESS
		end
		BINDS[1] = {
			id = "drop",
			key = key,
			modifier = math.floor(dogma.mcm.number(MOD_ID, "key_drop_modifier", 0) + 0.5),
			mode = mode,
		}
	end
end

local function inp()
	return dogma.input
end

local function mod_ok(modifier)
	local i = inp()
	if not i then
		return false
	end
	return i.is_mod_down(modifier or 0)
end

local function inv_mode_ok(gui)
	local mode = gui and gui.mode
	return mode == "inventory" or mode == "loot"
end

local function bag_allowed(bag)
	return bag and ALLOWED_BAGS[bag]
end

local function get_hover(gui)
	gui = gui or (ui_inventory and ui_inventory.GUI)
	if not (gui and gui.hover) then
		return nil
	end
	local bag, idx = gui.hover.bag, gui.hover.idx
	if not (bag_allowed(bag) and idx) then
		return nil
	end
	local cc = gui.CC and gui.CC[bag]
	local obj = cc and cc:GetObj(idx)
	if not obj then
		return nil
	end
	return obj, bag, idx, gui
end

local function is_equipped(obj)
	if not (obj and db.actor and _G.SCANNED_SLOTS) then
		return false
	end
	local id = obj:id()
	local n = 0
	for _ in pairs(_G.SCANNED_SLOTS) do
		n = n + 1
	end
	for i = 0, n + 1 do
		local slot_obj = db.actor:item_in_slot(i)
		if slot_obj and slot_obj:id() == id then
			return true
		end
	end
	return false
end

local function is_quest(gui, obj, bag)
	if not (gui and gui.Cond_NotQuest and obj) then
		return false
	end
	return not gui:Cond_NotQuest(obj, bag)
end

local function do_drop(gui, obj, bag)
	if CONFIG.loaded.drop_safe_equipped and is_equipped(obj) then
		return
	end
	if is_quest(gui, obj, bag) then
		return
	end
	if gui.Action_Drop then
		gui:Action_Drop(obj, bag)
	else
		db.actor:drop_item(obj)
	end
end

local function repeat_delay_ms(fire_count)
	if fire_count <= 0 then
		return 0
	end
	if fire_count == 1 then
		return 1000
	end
	if fire_count == 2 then
		return 1500
	end
	if fire_count == 3 then
		return 2000
	end
	return 2250 + (fire_count - 4) * 250
end

local function fire_bind()
	local obj, bag, idx, gui = get_hover()
	if not obj then
		return false
	end
	do_drop(gui, obj, bag)
	return true, obj:id()
end

local function start_hold(bind, dik)
	local now = time_continual()
	local hs = { bind = bind, t0 = now, fire_count = 0, last_id = nil }
	hold_state[dik] = hs
	local ok, id = fire_bind()
	if ok then
		hs.last_id = id
		hs.fire_count = 1
		hs.t0 = now
	end
end

local function poll_binds(gui)
	local i = inp()
	if not (i and inv_mode_ok(gui)) then
		return
	end
	local now = time_continual()

	for b = 1, #BINDS do
		local bind = BINDS[b]
		local dik = bind.key
		if not (dik and dik >= 0) then
			-- skip
		else
			-- Local edge: inventory Update can run more than once per actor tick.
			local down = i.is_key_down(dik)
			local pressed = down and not down_prev[dik]
			down_prev[dik] = down

			if not mod_ok(bind.modifier) then
				hold_state[dik] = nil
			elseif bind.mode == MODE_HOLD then
				if pressed then
					start_hold(bind, dik)
				elseif hold_state[dik] then
					if not down then
						hold_state[dik] = nil
					else
						local hs = hold_state[dik]
						local obj, bag, idx, g = get_hover()
						local id = obj and obj:id() or nil
						if not id then
							hs.last_id = nil
							hs.fire_count = 0
							hs.t0 = now
						elseif id ~= hs.last_id then
							hs.last_id = id
							hs.fire_count = 0
							hs.t0 = now
							do_drop(g, obj, bag)
							hs.fire_count = 1
						elseif (now - hs.t0) >= repeat_delay_ms(hs.fire_count) then
							do_drop(g, obj, bag)
							hs.fire_count = hs.fire_count + 1
							hs.t0 = now
						end
					end
				end
			elseif pressed then
				fire_bind()
			end
		end
	end
end

local original_on_update = ui_inventory and ui_inventory.UIInventory and ui_inventory.UIInventory.Update
if original_on_update then
	function ui_inventory.UIInventory:Update()
		original_on_update(self)
		if dogma.sys and dogma.sys.ready(MOD_ID, db, on_option_change) then
			poll_binds(self)
		end
	end
end

function on_game_start()
	dogma.load(MOD_ID)
	RegisterScriptCallback("on_option_change", on_option_change)
	on_option_change()
	log("drop keys ready")
end
