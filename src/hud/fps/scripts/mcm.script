				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_fps_page_description",
			},
					{
						id = "enabled_default",
						type = "check",
						val = 1,
						def = CONFIG.DEFAULTS["enabled_default"],
						hint = "dogma_fps_enabled_default",
					},
					{
						id = "toggle_key",
