-- Pose Controls MCM
-- Crouch / prone / sprint keybinds and Hold/Toggle live-read/write Options→Controls
-- via dogma_mcm.key_mirror / curr+functor. Walk key is MCM-only.

local CONFIG = _G.dogma_player_pose_controls_conf

local function curr_hold_toggle()
	return (get_console_cmd(1, "g_crouch_toggle") and 1) or 0
end

local function set_hold_toggle(mode)
	local word = (tonumber(mode) == 1) and "1" or "0"
	exec_console_cmd("g_crouch_toggle " .. word)
	exec_console_cmd("g_walk_toggle " .. word)
	exec_console_cmd("g_sprint_toggle " .. word)
	exec_console_cmd("cfg_save")
end

function on_mcm_load(options)
	local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
	dogma_mcm.attach(options, "player", "ui_mcm_menu_dogma_player", {
		id = "pose_controls",
		sh = true,
		text = "ui_mcm_menu_dogma_player_pose_controls",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_pose_controls_main_description",
			},
			{
				id = "hold_toggle",
				type = kb_mod,
				val = 2,
				def = 0,
				curr = { curr_hold_toggle },
				functor = { set_hold_toggle },
				hint = "dogma_pose_controls_hold_toggle",
				content = {
					{ 0, "hold" },
					{ 1, "toggle" },
				},
			},
			{ id = "line_keys", type = "line" },
			{
				id = "keys_desc",
				type = "desc",
				text = "ui_mcm_dogma_pose_controls_keys_desc",
			},
			dogma_mcm.key_mirror("sprint_toggle", function()
				return key_bindings and (key_bindings.kSPRINT_TOGGLE or key_bindings.kSPRINT)
			end):option("sprint_key", "dogma_pose_controls_sprint_key"),
			{
				id = "walk_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["walk_key"],
				hint = "dogma_pose_controls_walk_key",
			},
			dogma_mcm.key_mirror("crouch", function()
				return key_bindings and key_bindings.kCROUCH
			end):option("crouch_key", "dogma_pose_controls_crouch_key"),
			dogma_mcm.key_mirror("accel", function()
				return key_bindings and key_bindings.kACCEL
			end):option("prone_key", "dogma_pose_controls_prone_key"),
		}),
	})
end
