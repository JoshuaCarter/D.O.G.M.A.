--[[
	Dynamic Loadout — in-game post-spawn optic attach.

	Menu writes character_creation/dogma_dl_weapon + dogma_dl_sight.
	Stock on_game_load already spawns sections from new_game_loadout.
]]

local CONFIG = _G.dogma_menu_dynamic_loadout_conf
local MOD_ID = CONFIG and CONFIG.MOD_ID or "dogma/menu/dynamic_loadout"
local DOGMA
local attached_once = false

local function dlog(msg)
	if DOGMA and DOGMA.dbg then
		DOGMA.dbg.log(MOD_ID, msg)
	else
		printf("[dogma_menu_dynamic_loadout] %s", tostring(msg))
	end
end

local function try_attach_sight()
	if attached_once then
		return
	end
	if not (axr_main and axr_main.config) then
		return
	end

	local wpn_sec = axr_main.config:r_value("character_creation", "dogma_dl_weapon", 3)
	local sight_sec = axr_main.config:r_value("character_creation", "dogma_dl_sight", 3)
	axr_main.config:w_value("character_creation", "dogma_dl_weapon", "")
	axr_main.config:w_value("character_creation", "dogma_dl_sight", "")

	if not wpn_sec or wpn_sec == "" or not sight_sec or sight_sec == "" then
		attached_once = true
		return
	end

	if not db.actor then
		return
	end

	local wpn = db.actor:object(wpn_sec)
	local sight = db.actor:object(sight_sec)
	if not (wpn and sight) then
		dlog(string.format("attach skip: missing objects wpn=%s sight=%s",
			tostring(wpn ~= nil), tostring(sight ~= nil)))
		attached_once = true
		return
	end

	if utils_item and utils_item.can_attach_scope and utils_item.attach_addon then
		if utils_item.can_attach_scope(wpn, sight) then
			utils_item.attach_addon(wpn, sight, "scope", true)
			dlog(string.format("attached %s -> %s", sight_sec, wpn_sec))
		else
			dlog(string.format("can_attach_scope false for %s on %s", sight_sec, wpn_sec))
		end
	else
		dlog("utils_item attach API missing")
	end

	attached_once = true
end

function on_game_start()
	DOGMA = dogma_common.load(MOD_ID)
	attached_once = false
	RegisterScriptCallback("actor_on_first_update", try_attach_sight)
end
