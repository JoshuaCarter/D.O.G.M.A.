--[[
    Stalker ID - centered Faction Identification replacement.

    Look-ray to ID range first (fade in immediately). Else outer cone
    and min size, closest to farthest: own size circle, first fit wins
    after a 250ms hold. Fade in 250ms, fade out 500ms. Line only when
    fully faded in. Range is min_size_px (pinhole, 1.8m).
    Leader line: living non-hostiles normally, all living stalkers in binocs;
    never corpses. Hidden on PDA. Goodwill color (MCM): living names red /
    yellow / green from general_goodwill bands; zombified red. Off: white.
    Dead names are grey. Appear / look-away use MCM fade-in / fade-out.
    Show always acquires and ignores the other show-when options. Otherwise
    need ADS / RMB hold / free zoom / binoculars (if those toggles are on) or a bound
    hold key. Unbound key is not a condition. Leaving a condition fades.
]]

local CONFIG = _G.dogma_gui_stalker_id_conf

local UI_WIDTH = 1024
local UI_HEIGHT = 768
local UI_CENTER_X = UI_WIDTH * 0.5
local UI_CX, UI_CY = 512, 384
local ALIGN_CENTER = 2 -- CGameFont::alCenter
local NAME_HOSTILE_RGB = { 255, 48, 48 }
local NAME_FRIEND_RGB = { 48, 200, 48 }
local NAME_NEUTRAL_RGB = { 255, 200, 48 }
local NAME_DEAD_RGB = { 160, 160, 160 }
local RANK_RGB = { 200, 200, 200 }
local RANK_DEAD_RGB = { 100, 100, 100 }

-- Only two bones: lower-back (outer + pick + LOS) and neck (pick + LOS + line).
local BONE_NECK = "bip01_neck"
local BONE_MID = "bip01_spine1"
local BONES_BODY = { BONE_NECK, BONE_MID }

local W2U_SCRATCH = vector()

-- Line thickness: 1 real px (halo +1), converted to virtual UI space.
local LINE_HALO_REAL_PX = 1
local PATCH_H = 24 -- faction patch / zombified row height in ui xml
local PATCH_W = 18
local LINE_START_BELOW_PX = 5 -- below bottom of patch (or zombified text)
local LINE_HEAD_LIFT = 0.2 -- of on-screen stalker height, above neck
local FOV_ZOOM_RATIO = 0.7
local STALKER_H = 1.8 -- metres; standing height for pinhole size
local OUTER_R = 1 -- circle height = screen height
local SIZE_RY_MIN = 1 -- 2x2 px
local SIZE_RY_MAX = UI_CY -- full screen height
local FADE_IN_MS = 250
local FADE_OUT_MS = 500
local CIRCLE_HOLD_MS = 250
local DEG2RAD = math.pi / 180
local SEARCH_WHEN_OFF = 2000 -- iterate_nearest needs a radius when min_size is 0
local DIK_RMB = (DIK_keys and DIK_keys.MOUSE_2) or 338
local FACTION_KEYS = {
    "stalker", "bandit", "csky", "army", "freedom", "dolg", "ecolog",
    "killer", "monolith", "greh", "renegade", "isg",
}

force_preview = false

local HUD = nil
local nametable = {}
local seen_comm = {}
local LastHitObject = nil
local line_target_id = nil
local next_pick = 0
local cond_was = false
local ov_at = 0
local hold_id = nil
local hold_at = 0
local dbg_reset = function() end
local apply_layout = function() end

local fade_active = false
local fade_mode = "out"
local fade_start_ms = 0
local fade_mul = 1
local shown_faction = nil
local name_r, name_g, name_b = 255, 255, 255
local rank_r, rank_g, rank_b = RANK_RGB[1], RANK_RGB[2], RANK_RGB[3]

local zombified_text
local UI_KX = 1
local _ui_w = 0

local POS_VEC = vector2()
local SIZE_VEC = vector2()

local floor, sqrt, atan2, abs, tan, cos, sin = math.floor, math.sqrt, math.atan2, math.abs, math.tan, math.cos, math.sin

local function clamp01(v)
    return dogma.math.clamp01(v)
end

local function log(msg)
    if dogma.log and dogma.log.logging() then
        dogma.log.log(CONFIG.MOD_ID, tostring(msg))
    end
end

local function alpha_byte(a, mul)
    local v = tonumber(a) or 0
    if v < 0 then
        v = 0
    elseif v > 255 then
        v = 255
    end
    return floor(v * clamp01(mul) + 0.5)
end

local function on_option_change()
    local tostr = tostring
    local id = CONFIG.MOD_ID
    CONFIG.loaded.enabled = dogma.mcm.bool(id, "enabled")
    CONFIG.loaded.show_always = dogma.mcm.bool(id, "show_always")
    CONFIG.loaded.show_keybind = dogma.mcm.key(id, "show_keybind")
    CONFIG.loaded.show_when_ads = dogma.mcm.bool(id, "show_when_ads")
    CONFIG.loaded.show_when_rmb = dogma.mcm.bool(id, "show_when_rmb")
    CONFIG.loaded.show_when_free_zoom = dogma.mcm.bool(id, "show_when_free_zoom")
    CONFIG.loaded.show_when_binoc = dogma.mcm.bool(id, "show_when_binoc")
    CONFIG.loaded.dead_id = dogma.mcm.bool(id, "dead_id")
    CONFIG.loaded.zombie_id = dogma.mcm.bool(id, "zombie_id")
    CONFIG.loaded.name_id = dogma.mcm.bool(id, "name_id")
    CONFIG.loaded.goodwill_color = dogma.mcm.bool(id, "goodwill_color")
    CONFIG.loaded.rank_id = dogma.mcm.bool(id, "rank_id")
    CONFIG.loaded.name_y = dogma.mcm.int(id, "name_y")
    CONFIG.loaded.rank_y = dogma.mcm.int(id, "rank_y")
    CONFIG.loaded.icon_y = dogma.mcm.int(id, "icon_y")
    CONFIG.loaded.icon_scale = dogma.mcm.uint(id, "icon_scale")
    CONFIG.loaded.name_a = dogma.mcm.uint(id, "name_a")
    CONFIG.loaded.rank_a = dogma.mcm.uint(id, "rank_a")
    CONFIG.loaded.icon_a = dogma.mcm.uint(id, "icon_a")
    CONFIG.loaded.min_size_px = dogma.mcm.uint(id, "min_size_px")
    CONFIG.loaded.circle_size = dogma.mcm.uint(id, "circle_size")
    CONFIG.loaded.hide_on_death = dogma.mcm.bool(id, "hide_on_death")
    CONFIG.loaded.always_show_line = dogma.mcm.bool(id, "always_show_line")
    CONFIG.loaded.always_show_line_binoc = dogma.mcm.bool(id, "always_show_line_binoc")
    CONFIG.loaded.line_a = dogma.mcm.uint(id, "line_a")
    CONFIG.loaded.debug_overlay = dogma.overlay.enabled()
    if not CONFIG.loaded.enabled or not CONFIG.loaded.debug_overlay then
        dogma.overlay.clear(id)
    end
    log("opts min_size_px=" .. tostr(CONFIG.loaded.min_size_px)
        .. " circle_size=" .. tostr(CONFIG.loaded.circle_size)
        .. " icon_scale=" .. tostr(CONFIG.loaded.icon_scale))
    if HUD then
        apply_layout()
    end
end

local function hide_all_patches(hud)
    for i = 1, #FACTION_KEYS do
        local key = FACTION_KEYS[i]
        hud.factions[key]:Show(false)
        hud.factions[key .. "_dead"]:Show(false)
    end
end

local function clear_text(hud)
    hud.name:TextControl():SetText("")
    hud.rank:TextControl():SetText("")
    hud.zombified:TextControl():SetText("")
    hud.zombified:Show(false)
end

local function hide_line(hud)
    hud = hud or HUD
    if not hud then
        return
    end
    hud.line:Show(false)
    hud.line_sh:Show(false)
end

local function apply_alphas(mul)
    if not HUD then
        return
    end
    fade_mul = clamp01(mul)
    local cfg = CONFIG.loaded
    local name_a = alpha_byte(cfg.name_a, fade_mul)
    local rank_a = alpha_byte(cfg.rank_a, fade_mul)
    local icon_a = alpha_byte(cfg.icon_a, fade_mul)

    HUD.name:TextControl():SetTextColor(GetARGB(name_a, name_r, name_g, name_b))
    HUD.rank:TextControl():SetTextColor(GetARGB(rank_a, rank_r, rank_g, rank_b))
    HUD.zombified:TextControl():SetTextColor(GetARGB(icon_a, 255, 255, 255))

    if shown_faction and HUD.factions[shown_faction] then
        local st = HUD.factions[shown_faction]
        pcall(st.SetTextureColor, st, GetARGB(icon_a, 255, 255, 255))
    end
end

local function cancel_fade()
    fade_active = false
    fade_mode = "out"
    fade_start_ms = 0
    fade_mul = 1
end

local function start_fade_in()
    if fade_active and fade_mode == "in" then
        return
    end
    local from = 0
    if fade_active and fade_mode == "out" then
        from = clamp01(fade_mul)
    end
    fade_active = true
    fade_mode = "in"
    fade_start_ms = time_global() - floor(from * FADE_IN_MS + 0.5)
    apply_alphas(from)
    log("fade_in start from=" .. tostring(from))
end

local function start_fade()
    local from = clamp01(fade_mul)
    fade_active = true
    fade_mode = "out"
    fade_start_ms = time_global() - floor((1 - from) * FADE_OUT_MS + 0.5)
    apply_alphas(from)
    log("fade_out start from=" .. tostring(from))
end

local function reset_hold()
    hold_id = nil
    hold_at = 0
end

local function clear()
    reset_hold()
    cancel_fade()
    shown_faction = nil
    line_target_id = nil
    name_r, name_g, name_b = 255, 255, 255
    rank_r, rank_g, rank_b = RANK_RGB[1], RANK_RGB[2], RANK_RGB[3]
    if HUD then
        HUD:Reset()
    end
end

local function init_id_text(st)
    local tc = st:TextControl()
    tc:SetTextComplexMode(false)
    tc:SetTextAlignment(ALIGN_CENTER)
end

local function scale_pct(v)
    v = tonumber(v) or 100
    if v < 50 then
        return 50
    end
    if v > 200 then
        return 200
    end
    return v
end

apply_layout = function()
    if not HUD then
        return
    end
    local cfg = CONFIG.loaded
    local isc = scale_pct(cfg.icon_scale) / 100

    HUD.name:SetWndPos(POS_VEC:set(0, cfg.name_y or 20))
    HUD.rank:SetWndPos(POS_VEC:set(0, cfg.rank_y or 32))
    HUD.zombified:SetWndSize(SIZE_VEC:set(UI_WIDTH, PATCH_H * isc))
    HUD.zombified:SetWndPos(POS_VEC:set(0, cfg.icon_y or 60))

    local iw, ih = PATCH_W * isc, PATCH_H * isc
    for i = 1, #FACTION_KEYS do
        local key = FACTION_KEYS[i]
        local live = HUD.factions[key]
        local dead = HUD.factions[key .. "_dead"]
        if live then
            live:SetWndSize(SIZE_VEC:set(iw, ih))
            live:SetWndPos(POS_VEC:set(UI_CENTER_X, cfg.icon_y or 60))
        end
        if dead then
            dead:SetWndSize(SIZE_VEC:set(iw, ih))
            dead:SetWndPos(POS_VEC:set(UI_CENTER_X, cfg.icon_y or 60))
        end
    end
end

class "UIStalkerIDHUD" (CUIScriptWnd)

function UIStalkerIDHUD:__init() super()
    self:SetWndRect(Frect():set(0, 0, UI_WIDTH, UI_HEIGHT))
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_dogma_stalker_id.xml")

    self.line_sh = xml:InitStatic("line_sh", self)
    self.line = xml:InitStatic("line", self)
    self.line_sh:EnableHeading(true)
    self.line:EnableHeading(true)
    self.line_sh:Show(false)
    self.line:Show(false)

    self.factions = {}
    for i = 1, #FACTION_KEYS do
        local key = FACTION_KEYS[i]
        self.factions[key] = xml:InitStatic("patch_" .. key, self)
        self.factions[key .. "_dead"] = xml:InitStatic("patch_dead_" .. key, self)
    end

    self.name = xml:InitStatic("name", self)
    self.rank = xml:InitStatic("rank", self)
    self.zombified = xml:InitStatic("zombified", self)

    pcall(init_id_text, self.name)
    pcall(init_id_text, self.rank)
    pcall(init_id_text, self.zombified)

    hide_all_patches(self)
    clear_text(self)
end

function UIStalkerIDHUD:__finalize()
end

function UIStalkerIDHUD:Reset()
    hide_all_patches(self)
    clear_text(self)
    hide_line(self)
end

local function activate_hud()
    RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
    if HUD == nil then
        HUD = UIStalkerIDHUD()
        get_hud():AddDialogToRender(HUD)
    end
end

local function deactivate_hud()
    dbg_reset()
    if HUD ~= nil then
        get_hud():RemoveDialogToRender(HUD)
        HUD = nil
    end
    UnregisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
end

function on_screen_resolution_changed()
    deactivate_hud()
    activate_hud()
    _ui_w = 0
end

function actor_on_net_destroy()
    dbg_reset()
    if HUD ~= nil then
        get_hud():RemoveDialogToRender(HUD)
        HUD = nil
    end
    line_target_id = nil
end

function actor_on_first_update()
    activate_hud()
end

local function is_zombied(community)
    return community == "zombied"
end

-- Patch list is display-only. Traders / uniques use communities like "trader".
local function is_valid_community(community)
    if is_zombied(community) then
        return CONFIG.loaded.zombie_id
    end
    return true
end

local function is_hostile(obj)
    return dogma.alife.npc_relation_band(obj) == "enemy"
end

local function set_name_color_for(obj)
    local alive = obj and obj.health and obj.health > 0
    if not alive then
        name_r, name_g, name_b = NAME_DEAD_RGB[1], NAME_DEAD_RGB[2], NAME_DEAD_RGB[3]
        rank_r, rank_g, rank_b = RANK_DEAD_RGB[1], RANK_DEAD_RGB[2], RANK_DEAD_RGB[3]
        return
    end
    rank_r, rank_g, rank_b = RANK_RGB[1], RANK_RGB[2], RANK_RGB[3]
    name_r, name_g, name_b = 255, 255, 255
    if not CONFIG.loaded.goodwill_color then
        return
    end
    if is_zombied(dogma.alife.community(obj)) then
        name_r, name_g, name_b = NAME_HOSTILE_RGB[1], NAME_HOSTILE_RGB[2], NAME_HOSTILE_RGB[3]
        return
    end
    local band = dogma.alife.npc_relation_band(obj)
    if band == "enemy" then
        name_r, name_g, name_b = NAME_HOSTILE_RGB[1], NAME_HOSTILE_RGB[2], NAME_HOSTILE_RGB[3]
    elseif band == "friend" then
        name_r, name_g, name_b = NAME_FRIEND_RGB[1], NAME_FRIEND_RGB[2], NAME_FRIEND_RGB[3]
    elseif band == "neutral" then
        name_r, name_g, name_b = NAME_NEUTRAL_RGB[1], NAME_NEUTRAL_RGB[2], NAME_NEUTRAL_RGB[3]
    end
end

local function display(faction, name, rank, zombified)
    if not HUD then
        return
    end

    shown_faction = nil
    hide_all_patches(HUD)
    clear_text(HUD)

    apply_layout()

    if name then
        HUD.name:TextControl():SetText(name)
    end
    if rank then
        HUD.rank:TextControl():SetText(rank)
    end

    if zombified then
        HUD.zombified:TextControl():SetText(zombified_text)
        HUD.zombified:Show(true)
        return
    end

    if faction and HUD.factions[faction] then
        shown_faction = faction
        HUD.factions[faction]:Show(true)
    end
end

function show_preview()
    if not HUD then
        return
    end
    local cfg = CONFIG.loaded
    local name = cfg.name_id and "Stalker" or nil
    local rank
    if cfg.rank_id then
        rank = game.translate_string("st_rank_experienced")
    end
    name_r, name_g, name_b = 255, 255, 255
    rank_r, rank_g, rank_b = RANK_RGB[1], RANK_RGB[2], RANK_RGB[3]
    display("stalker", name, rank, false)
    apply_alphas(1)
end

local function display_faction(obj)
    if not obj then
        return
    end

    local cfg = CONFIG.loaded
    local fact = dogma.alife.community(obj)
    local name = obj:character_name()
    local rank = game.translate_string("st_rank_" .. ranks.get_obj_rank_name(obj)) or ""

    if not cfg.rank_id then
        rank = nil
    end
    if not cfg.name_id then
        name = nil
    end

    if name == nil or name == "" then
        name = nil
    end
    if rank == nil or rank == "" then
        rank = nil
    end

    set_name_color_for(obj)

    if is_zombied(fact) then
        display(nil, name, rank, true)
        return
    end

    if fact and HUD and not HUD.factions[fact] and not seen_comm[fact] then
        seen_comm[fact] = true
        log("id no-patch community=" .. tostring(fact))
    end

    if fact and cfg.dead_id and obj.health <= 0 then
        fact = fact .. "_dead"
    end

    display(fact, name, rank, false)
end

function refresh_layout()
    if LastHitObject then
        display_faction(LastHitObject)
        apply_alphas(1)
        return
    end
    show_preview()
end

local function get_bone(obj, name)
    local ok, p = pcall(obj.bone_position, obj, name)
    if ok then
        return p
    end
    return nil
end

local function project_world(pos)
    local w2u = (game and game.world2ui) or (level and level.world2ui)
    if not w2u then
        return nil
    end
    local ui = w2u(W2U_SCRATCH:set(pos), false, false)
    if not ui or ui.x < -9000 then
        return nil
    end
    return ui.x, ui.y
end

-- First non-bush / see-through object (nil if wall / miss). Pierce budget 1.
local function query_look_object(ox, oy, oz, dx, dy, dz, remaining)
    local hit = dogma.alife.ray(
        ox, oy, oz, dx, dy, dz, remaining,
        db and db.actor,
        1,
        true
    )
    if hit then
        return hit
    end
    return nil
end

local function cam_dist(pos)
    local d = device and device()
    if not (d and d.cam_pos and pos) then
        return nil
    end
    return d.cam_pos:distance_to(pos)
end

local function in_id_range(pos, max_range)
    local dist = cam_dist(pos)
    return dist and max_range and dist <= max_range
end

local function is_binoc_held()
    if not db.actor then
        return false
    end
    local ok, item = pcall(db.actor.active_item, db.actor)
    if not ok or not item then
        return false
    end
    local ok2, sec = pcall(item.section, item)
    if not ok2 or not sec then
        return false
    end
    return sec == "wpn_binoc_inv" or sec:find("binoc") ~= nil
end

-- Video options FOV (not live console; free zoom writes that).
local function settings_fov()
    local fov = ui_options and ui_options.get("video/basic/fov")
    if type(fov) == "number" and fov > 0 then
        return fov
    end
    return 75
end

local function is_binoc_active()
    local axr = axr_main
    if axr and axr.binoc_is_zoomed then
        return true
    end
    if not is_binoc_held() then
        return false
    end
    local d = device and device()
    local fov = d and d.fov
    if not fov or fov <= 0 then
        return true
    end
    return fov < settings_fov() * FOV_ZOOM_RATIO
end

local function using_binocs()
    return is_binoc_held() or (axr_main and axr_main.binoc_is_zoomed)
end

-- Weapon ADS only (not binocs, not free zoom).
local function is_weapon_ads()
    if using_binocs() then
        return false
    end
    local axr = axr_main
    if axr and axr.weapon_is_zoomed then
        return true
    end
    local tgt = rawget(_G, "dogma_fov_tgt_ads")
    return type(tgt) == "number" and tgt > 0
end

local function is_free_zoomed()
    if using_binocs() then
        return false
    end
    local tgt = rawget(_G, "dogma_fov_tgt_free")
    return type(tgt) == "number" and tgt > 0
end

-- Pinhole, screen center. device.fov is vertical degrees.
-- h_px = STALKER_H * (UI_HEIGHT/2) / (dist * tan(fov/2))
local _focal = 0
local _focal_fov = -1
local function live_fov()
    local d = device and device()
    local fov = d and d.fov
    if fov and fov > 0 and fov < 180 then
        return fov
    end
    return settings_fov()
end

local function focal_px()
    local fov = live_fov()
    if fov ~= _focal_fov then
        _focal_fov = fov
        local half = tan(fov * DEG2RAD * 0.5)
        if half > 0 then
            _focal = (UI_HEIGHT * 0.5) / half
        else
            _focal = 0
            log("focal skip fov=" .. tostring(fov))
        end
    end
    return _focal
end

local function screen_h_px(dist)
    if not (dist and dist > 0.05) then
        return UI_HEIGHT
    end
    return STALKER_H * focal_px() / dist
end

local _logged_range = -1
local function approx_max_range()
    local tostr = tostring
    local min_px = CONFIG.loaded.min_size_px or 0
    local r
    if min_px <= 0 then
        r = SEARCH_WHEN_OFF
    else
        r = STALKER_H * focal_px() / min_px
        if r < 0 then
            r = 0
        end
    end
    if r - _logged_range > 5 or _logged_range - r > 5 then
        _logged_range = r
        log("range=" .. tostr(floor(r + 0.5))
            .. " fov=" .. tostr(_focal_fov)
            .. " min_px=" .. tostr(min_px)
            .. " focal=" .. tostr(floor(_focal + 0.5)))
    end
    return r
end

-- Outer: full-screen circle vs live FOV. Inner: per-target pinhole size.
local cam_ox, cam_oy, cam_oz = 0, 0, 0
local cam_dx, cam_dy, cam_dz = 0, 0, 1
local cam_outer_cos2 = 0
local cam_outer_ry = UI_CY
local cam_cone_ok = false

local function refresh_cam_cone()
    cam_cone_ok = false
    local d = device and device()
    if not (d and d.cam_pos and d.cam_dir) then
        return
    end
    local p = d.cam_pos
    local dir = d.cam_dir
    cam_ox, cam_oy, cam_oz = p.x, p.y, p.z
    cam_dx, cam_dy, cam_dz = dir.x, dir.y, dir.z
    local live_half = tan(live_fov() * DEG2RAD * 0.5)
    if live_half <= 0 then
        return
    end
    local outer_t = live_half * OUTER_R
    cam_outer_cos2 = 1 / (1 + outer_t * outer_t)
    cam_outer_ry = UI_CY * OUTER_R
    cam_cone_ok = true
end

local function in_cone(pos, cos2)
    if not (cam_cone_ok and pos) then
        return true
    end
    local tx = pos.x - cam_ox
    local ty = pos.y - cam_oy
    local tz = pos.z - cam_oz
    local d2 = tx * tx + ty * ty + tz * tz
    if d2 < 0.0025 then
        return true
    end
    local along = cam_dx * tx + cam_dy * ty + cam_dz * tz
    if along <= 0 then
        return false
    end
    return along * along >= cos2 * d2
end

local function in_outer_cone(pos)
    return in_cone(pos, cam_outer_cos2)
end

local function in_ui_circle(sx, sy, ry)
    if not (sx and ry and ry > 0) then
        return false
    end
    local dx = (sx - UI_CX) / UI_KX
    local dy = sy - UI_CY
    return dx * dx + dy * dy <= ry * ry
end

-- Circle radius = half the 1.8m pinhole height (far small, close large).
local function size_ry(pos)
    local dist = cam_dist(pos)
    if not dist then
        return 0
    end
    local scale = (CONFIG.loaded.circle_size or 100) / 100
    local ry = screen_h_px(dist) * 0.5 * scale
    if ry < SIZE_RY_MIN then
        ry = SIZE_RY_MIN
    elseif ry > SIZE_RY_MAX then
        ry = SIZE_RY_MAX
    end
    return ry
end

-- Optional gates used only when Show always is off. Nil keybind is not a gate.
local function show_cond()
    local cfg = CONFIG.loaded
    if cfg.show_when_ads and is_weapon_ads() then
        return true
    end
    -- Raw RMB: key_state, not weapon ADS. Works fists / empty hands.
    if cfg.show_when_rmb and dogma.input and dogma.input.is_key_down(DIK_RMB) then
        return true
    end
    if cfg.show_when_free_zoom and is_free_zoomed() then
        return true
    end
    if cfg.show_when_binoc and is_binoc_active() then
        return true
    end
    local key = cfg.show_keybind
    if key and dogma.input and dogma.input.is_key_down(key) then
        return true
    end
    return false
end

-- Show always short-circuits so the other options are not even checked.
local function want_acquire()
    return CONFIG.loaded.show_always or show_cond()
end

local function is_id_candidate(obj)
    local cfg = CONFIG.loaded
    if not obj then
        return false
    end
    if not IsStalker(obj) then
        if not (IsTrader and IsTrader(obj)) then
            return false
        end
    end
    if db.actor and obj:id() == db.actor:id() then
        return false
    end
    if not (obj.health > 0 or cfg.dead_id) then
        return false
    end
    return is_valid_community(dogma.alife.community(obj))
end

local pick_obj, pick_sd, pick_max, pick_actor_id, pick_dist
local pick_ry, pick_sx, pick_sy = 0, nil, nil
local SCAN = {}
local scan_n = 0

local function scan_dist_cmp(a, b)
    return a.dist < b.dist
end

local function pick_iter(obj)
    if not obj then
        return false
    end
    if obj:id() == 0 or obj:id() == pick_actor_id then
        return false
    end
    if not is_id_candidate(obj) then
        return false
    end
    local mid = get_bone(obj, BONE_MID)
    if not (mid and in_outer_cone(mid) and in_id_range(mid, pick_max)) then
        return false
    end
    local dist = cam_dist(mid)
    if not dist then
        return false
    end
    local best_sd, best_sx, best_sy = -1, nil, nil
    for i = 1, #BONES_BODY do
        local p = get_bone(obj, BONES_BODY[i])
        if p then
            local sx, sy = project_world(p)
            if sx then
                local dx = (sx - UI_CX) / UI_KX
                local dy = sy - UI_CY
                local sd = dx * dx + dy * dy
                if best_sd < 0 or sd < best_sd then
                    best_sd, best_sx, best_sy = sd, sx, sy
                end
            end
        end
    end
    if best_sd < 0 then
        return false
    end
    scan_n = scan_n + 1
    local e = SCAN[scan_n]
    if not e then
        e = { obj = obj, sd = 0, ry = 0, sx = 0, sy = 0, dist = 0 }
        SCAN[scan_n] = e
    end
    e.obj = obj
    e.sd = best_sd
    e.ry = size_ry(mid)
    e.sx = best_sx
    e.sy = best_sy
    e.dist = dist
    return false
end

local function scan_center()
    pick_obj = nil
    pick_sd = 0
    pick_dist = 0
    pick_ry, pick_sx, pick_sy = 0, nil, nil
    scan_n = 0
    pick_max = approx_max_range()
    if pick_max <= 0 or not (db and db.actor) or not level.iterate_nearest then
        return
    end
    pick_actor_id = db.actor:id()
    refresh_cam_cone()
    pcall(level.iterate_nearest, db.actor:position(), pick_max + 5, pick_iter)
    if scan_n == 0 then
        return
    end
    for i = #SCAN, scan_n + 1, -1 do
        SCAN[i] = nil
    end
    table.sort(SCAN, scan_dist_cmp)
    for i = 1, scan_n do
        local e = SCAN[i]
        if in_ui_circle(e.sx, e.sy, e.ry) then
            pick_obj = e.obj
            pick_sd = e.sd
            pick_ry = e.ry
            pick_sx, pick_sy = e.sx, e.sy
            pick_dist = e.dist
            return
        end
    end
end

local PDA_SLOT = 8

local function pda_in_hands()
    local actor = db and db.actor
    return actor and actor:active_slot() == PDA_SLOT
end

local function want_line()
    if pda_in_hands() then
        return false
    end
    local cfg = CONFIG.loaded
    if cfg.always_show_line then
        return true
    end
    if cfg.always_show_line_binoc and is_binoc_active() then
        return true
    end
    return false
end

local function allow_line_for(obj)
    -- Living only: non-hostiles anytime the line is wanted; hostiles only in binocs.
    if not obj or not (obj.health and obj.health > 0) then
        return false
    end
    if is_binoc_active() then
        return true
    end
    return not is_hostile(obj)
end

local function refresh_ui_kx()
    local d = device and device()
    if not (d and d.width and d.width > 0) then
        return
    end
    if d.width == _ui_w then
        return
    end
    _ui_w = d.width
    UI_KX = (d.height / d.width) / (UI_HEIGHT / UI_WIDTH)
end

-- Virtual-UI thickness for a given real-pixel width (UI is always 1024x768).
local function line_thick_ui(real_px)
    local d = device and device()
    local h = (d and d.height and d.height > 0) and d.height or UI_HEIGHT
    local t = (real_px or 1) * UI_HEIGHT / h
    if t < 0.35 then
        t = 0.35
    end
    return t
end

-- Leader-line start: centered under the faction patch (or zombified row), +5px.
local function line_start_ui()
    local icon_y = CONFIG.loaded.icon_y or 60
    local icon_h = PATCH_H * (scale_pct(CONFIG.loaded.icon_scale) / 100)
    local uy
    if shown_faction then
        -- Patch uses alignment="c"; icon_y is the vertical centre.
        uy = icon_y + icon_h * 0.5 + LINE_START_BELOW_PX
    else
        -- Zombified text static is top-aligned at icon_y.
        uy = icon_y + icon_h + LINE_START_BELOW_PX
    end
    return UI_CENTER_X, uy
end

local function update_leader_line()
    -- Active ID or fading: line_target_id is kept through fade, cleared on clear().
    if not (HUD and line_target_id and want_line() and fade_mul >= 1 and not fade_active) then
        hide_line()
        return
    end

    dogma.perf.start("stalker_id", "leader_line")
    repeat
        local obj = level.object_by_id and level.object_by_id(line_target_id)
        if not obj then
            hide_line()
            break
        end
        if not allow_line_for(obj) then
            hide_line()
            break
        end

        local tip = get_bone(obj, BONE_NECK)
        local hx, hy = project_world(tip)
        if not hx then
            hide_line()
            break
        end
        local dist = cam_dist(tip)
        if dist then
            hy = hy - screen_h_px(dist) * LINE_HEAD_LIFT
        end

        refresh_ui_kx()
        local ux, uy = line_start_ui()
        local dx = hx - ux
        local dy = hy - uy
        local screen_len = sqrt(dx * dx + dy * dy)
        if screen_len < 1 then
            hide_line()
            break
        end

        local dxk = dx / UI_KX
        local len = sqrt(dxk * dxk + dy * dy)
        if len < 1 then
            hide_line()
            break
        end

        local ang = atan2(-dy, dxk)
        local mx = (ux + hx) * 0.5
        local my = (uy + hy) * 0.5
        local cfg = CONFIG.loaded
        local a = floor((cfg.line_a or 80) * fade_mul + 0.5)
        if a < 1 then
            hide_line()
            break
        end
        if a > 255 then
            a = 255
        end

        local thick = line_thick_ui(1)
        local halo_t = thick + line_thick_ui(LINE_HALO_REAL_PX)
        HUD.line_sh:SetWndSize(SIZE_VEC:set(len, halo_t))
        HUD.line_sh:SetWndPos(POS_VEC:set(mx - len * 0.5, my - halo_t * 0.5))
        HUD.line_sh:SetHeading(ang)
        HUD.line_sh:SetTextureColor(GetARGB(floor(a * 0.6), 0, 0, 0))
        HUD.line_sh:Show(true)

        HUD.line:SetWndSize(SIZE_VEC:set(len, thick))
        HUD.line:SetWndPos(POS_VEC:set(mx - len * 0.5, my - thick * 0.5))
        HUD.line:SetHeading(ang)
        HUD.line:SetTextureColor(GetARGB(a, 255, 255, 255))
        HUD.line:Show(true)
    until true
    dogma.perf.stop()
end

local function target_enter(obj)
    if not obj then
        return
    end
    line_target_id = obj:id()
    display_faction(obj)
    start_fade_in()
end

local function target_lost()
    if not HUD then
        return
    end
    start_fade()
end

local function set_id_target(obj)
    if not HUD then
        return
    end
    if obj then
        if LastHitObject then
            if obj:id() ~= LastHitObject:id() then
                target_enter(obj)
            elseif fade_active and fade_mode == "out" then
                target_enter(obj)
            end
        else
            target_enter(obj)
        end
        LastHitObject = obj
        line_target_id = obj:id()
        return
    end
    if LastHitObject then
        LastHitObject = nil
        target_lost()
    end
end

local function cam_look_id(max_range)
    local d = device and device()
    if not (ray_pick and d and d.cam_pos and d.cam_dir and max_range and max_range > 0) then
        return nil
    end
    local obj = query_look_object(
        d.cam_pos.x, d.cam_pos.y, d.cam_pos.z,
        d.cam_dir.x, d.cam_dir.y, d.cam_dir.z,
        max_range)
    if obj and is_id_candidate(obj) then
        return obj
    end
    return nil
end

local function miss_target()
    reset_hold()
    set_id_target(nil)
end

local function try_pick()
    local tostr = tostring
    if not HUD then
        miss_target()
        return
    end
    local look = cam_look_id(approx_max_range())
    if look then
        reset_hold()
        if not LastHitObject or LastHitObject:id() ~= look:id() then
            log("pick ray id=" .. tostr(look:id()))
        end
        set_id_target(look)
        return
    end
    scan_center()
    if not pick_obj then
        if LastHitObject then
            log("pick none")
        end
        miss_target()
        return
    end
    local id = pick_obj:id()
    local showing = LastHitObject and LastHitObject:id() == id
    local fading_out = fade_active and fade_mode == "out"
    if showing and not fading_out then
        set_id_target(pick_obj)
        return
    end
    local now = time_global()
    if hold_id ~= id then
        hold_id = id
        hold_at = now
        log("circle hold id=" .. tostr(id))
    end
    if now - hold_at < CIRCLE_HOLD_MS then
        if LastHitObject and LastHitObject:id() ~= id then
            set_id_target(nil)
        end
        return
    end
    log("circle hold done id=" .. tostr(id)
        .. " dist=" .. tostr(floor(pick_dist + 0.5))
        .. " ry=" .. tostr(floor(pick_ry + 0.5)))
    set_id_target(pick_obj)
end

local function update_fade()
    if not fade_active then
        return
    end
    local elapsed = time_global() - fade_start_ms
    if fade_mode == "in" then
        if elapsed >= FADE_IN_MS then
            fade_active = false
            fade_mode = "out"
            apply_alphas(1)
            log("fade_in done")
            return
        end
        apply_alphas(elapsed / FADE_IN_MS)
        return
    end
    if elapsed >= FADE_OUT_MS then
        clear()
        return
    end
    apply_alphas(1 - (elapsed / FADE_OUT_MS))
end

local DBG_BONES = {
    { BONE_MID, 255, 200, 48 },
    { BONE_NECK, 48, 200, 255 },
}
local DBG_DOT_N = #DBG_BONES
local DBG_CIRCLE_N = 32
local DBG_DOT_SZ = 2
local TWO_PI = math.pi * 2

local dbg_dots = {}
local dbg_outer = {}
local dbg_inner = {}
local dbg_ready = false
local dbg_shown = false

dbg_reset = function()
    dbg_ready = false
    dbg_shown = false
    dbg_dots = {}
    dbg_outer = {}
    dbg_inner = {}
end

local function dbg_hide()
    if not dbg_shown then
        return
    end
    for i = 1, #dbg_dots do
        dbg_dots[i]:Show(false)
    end
    for i = 1, #dbg_outer do
        dbg_outer[i]:Show(false)
    end
    for i = 1, #dbg_inner do
        dbg_inner[i]:Show(false)
    end
    dbg_shown = false
end

local function dbg_ensure()
    if dbg_ready then
        return true
    end
    if not HUD then
        return false
    end
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_dogma_stalker_id.xml")
    for i = 1, DBG_DOT_N do
        local st = xml:InitStatic("dbg_dot", HUD)
        st:Show(false)
        dbg_dots[i] = st
    end
    for i = 1, DBG_CIRCLE_N do
        local st = xml:InitStatic("dbg_seg", HUD)
        st:EnableHeading(true)
        st:Show(false)
        dbg_outer[i] = st
    end
    for i = 1, DBG_CIRCLE_N do
        local st = xml:InitStatic("dbg_seg", HUD)
        st:EnableHeading(true)
        st:Show(false)
        dbg_inner[i] = st
    end
    dbg_ready = true
    log("dbg hud dots=" .. tostring(DBG_DOT_N) .. " circle=" .. tostring(DBG_CIRCLE_N))
    return true
end

local function dbg_seg_line(st, x0, y0, x1, y1, thick, r, g, b)
    local dx, dy = x1 - x0, y1 - y0
    local dxk = dx / UI_KX
    local len = sqrt(dxk * dxk + dy * dy)
    if len < 1 then
        st:Show(false)
        return
    end
    local mx = (x0 + x1) * 0.5
    local my = (y0 + y1) * 0.5
    st:SetWndSize(SIZE_VEC:set(len, thick))
    st:SetWndPos(POS_VEC:set(mx - len * 0.5, my - thick * 0.5))
    st:SetHeading(atan2(-dy, dxk))
    st:SetTextureColor(GetARGB(200, r, g, b))
    st:Show(true)
end

local function dbg_draw_circle(segs, ry, thick, r, g, b)
    local rx = ry * UI_KX
    local step = TWO_PI / DBG_CIRCLE_N
    local x1 = UI_CX + rx
    local y1 = UI_CY
    for i = 1, DBG_CIRCLE_N do
        local a = i * step
        local x2 = UI_CX + rx * cos(a)
        local y2 = UI_CY + ry * sin(a)
        dbg_seg_line(segs[i], x1, y1, x2, y2, thick, r, g, b)
        x1, y1 = x2, y2
    end
end

local function dbg_hide_circle(segs)
    for i = 1, #segs do
        segs[i]:Show(false)
    end
end

local function update_dbg()
    if not CONFIG.loaded.debug_overlay then
        dbg_hide()
        return
    end
    if not dbg_ensure() then
        return
    end
    dbg_shown = true
    refresh_ui_kx()
    scan_center()

    local thick = line_thick_ui(1)
    dbg_draw_circle(dbg_outer, cam_outer_ry, thick, 180, 180, 180)
    if pick_obj and pick_ry > 1 then
        dbg_draw_circle(dbg_inner, pick_ry, thick, 48, 220, 255)
    else
        dbg_hide_circle(dbg_inner)
    end

    local half = DBG_DOT_SZ * 0.5
    for bi = 1, #DBG_BONES do
        local st = dbg_dots[bi]
        local sx, sy = nil, nil
        local p = nil
        if pick_obj then
            p = get_bone(pick_obj, DBG_BONES[bi][1])
            if p then
                sx, sy = project_world(p)
            end
        end
        if sx then
            local r, g, b
            if in_ui_circle(sx, sy, pick_ry) then
                r, g, b = 48, 255, 48
            else
                r, g, b = DBG_BONES[bi][2], DBG_BONES[bi][3], DBG_BONES[bi][4]
            end
            st:SetWndSize(SIZE_VEC:set(DBG_DOT_SZ, DBG_DOT_SZ))
            st:SetWndPos(POS_VEC:set(sx - half, sy - half))
            st:SetTextureColor(GetARGB(220, r, g, b))
            st:Show(true)
        else
            st:Show(false)
        end
    end
end

local function update_overlay()
    local sformat = string.format
    if not CONFIG.loaded.debug_overlay then
        return
    end
    local now = time_global()
    if now - ov_at < 100 then
        return
    end
    ov_at = now
    local d = device and device()
    local fov_now = (d and d.fov) or 0
    local range = approx_max_range()
    local min_px = CONFIG.loaded.min_size_px or 0
    local tgt = "-"
    local sz = "-"
    if LastHitObject then
        local mid = get_bone(LastHitObject, BONE_MID)
        local dist = cam_dist(mid)
        if dist then
            tgt = sformat("%.0f", dist)
            sz = sformat("%.0f", screen_h_px(dist))
        end
    end
    dogma.overlay.set(CONFIG.MOD_ID, 0,
        sformat("fov %.1f -> %.1f ry %.0f", settings_fov(), fov_now, pick_ry), "cyan")
    dogma.overlay.set(CONFIG.MOD_ID, 1,
        sformat("size %s/%s rng %.0f tgt %s", sz, tostring(min_px), range, tgt), "yellow")
end

function actor_on_update()
    if not CONFIG.loaded.enabled then
        cond_was = false
        dbg_hide()
        if LastHitObject or fade_active or line_target_id then
            LastHitObject = nil
            clear()
        end
        return
    end
    if CONFIG.loaded.hide_on_death and db.actor and not db.actor:alive() then
        dbg_hide()
        return
    end

    update_dbg()
    update_overlay()
    update_fade()
    update_leader_line()

    local tg = time_global()
    -- Every frame: always-on, or a condition just became true (incl. first key down).
    local always = CONFIG.loaded.show_always
    local want = want_acquire()
    local force_tick = not always and want and not cond_was
    cond_was = not always and want

    if not want then
        if force_preview then
            LastHitObject = nil
            cancel_fade()
            show_preview()
            return
        end
        reset_hold()
        set_id_target(nil)
        next_pick = 0
        return
    end

    if force_preview and not LastHitObject then
        cancel_fade()
        show_preview()
    end

    if not (force_tick or tg >= next_pick) then
        return
    end
    next_pick = tg + 50
    dogma.perf.start("stalker_id", "find_target")
    try_pick()
    dogma.perf.stop()
    if force_preview and not LastHitObject then
        cancel_fade()
        show_preview()
    end
end

function actor_on_before_death()
    if not CONFIG.loaded.hide_on_death then
        return
    end
    LastHitObject = nil
    clear()
end

function npc_on_death_callback(npc, who)
    if not LastHitObject then
        return
    end
    if npc:id() ~= LastHitObject:id() then
        return
    end

    if CONFIG.loaded.dead_id then
        cancel_fade()
        display_faction(npc)
        apply_alphas(1)
    else
        LastHitObject = nil
        target_lost()
    end
end

function npc_on_net_destroy(npc)
    if line_target_id and npc:id() == line_target_id then
        line_target_id = nil
    end
    if not LastHitObject then
        return
    end
    if npc:id() == LastHitObject:id() then
        LastHitObject = nil
        clear()
    end
end

function GUI_on_show(gui, str2)
    if not CONFIG.loaded.enabled or not want_acquire() then
        return
    end
    if gui == "Dialog" then
        local obj = mob_trade.GetTalkingNpc()
        if obj and LastHitObject and LastHitObject:id() == obj:id() then
            nametable[obj:character_name()] = true
            display_faction(obj)
            apply_alphas(fade_mul)
        end
        return
    end

    if gui == "UIInventory" then
        local obj = LastHitObject
        if not is_id_candidate(obj) then
            return
        end
        if obj and obj.health <= 0 and LastHitObject and LastHitObject:id() == obj:id() then
            local mid = get_bone(LastHitObject, BONE_MID)
            local pos = device().cam_pos
            if mid and pos and pos:distance_to_sqr(mid) < 4.9 then
                nametable[obj:character_name()] = true
                display_faction(obj)
                apply_alphas(fade_mul)
            end
        end
    end
end

function on_game_start()
    dogma.load(CONFIG.MOD_ID)
    zombified_text = game.translate_string("ui_dogma_gui_stalker_id_zombified")
    on_option_change()

    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("on_screen_resolution_changed", on_screen_resolution_changed)
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("actor_on_before_death", actor_on_before_death)
    RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)
    RegisterScriptCallback("npc_on_net_destroy", npc_on_net_destroy)
    RegisterScriptCallback("GUI_on_show", GUI_on_show)
    RegisterScriptCallback("on_option_change", on_option_change)
end
