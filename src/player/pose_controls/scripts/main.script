--[[
	Pose Controls

	Maps movement pose keys directly instead of cycling:
	- Crouch bind -> crouch only (mcCrouch, never mcAccel)
	- Walk/Low Crouch bind -> prone only (mcCrouch + mcAccel)
	- Sprint bind -> vanilla stand + sprint
	- MCM walk key -> walk only (mcAccel without mcCrouch)

	MCM Hold/Toggle and crouch/prone/sprint keys mirror into Options→Controls
	(g_*_toggle + bind crouch/accel/sprint_toggle). First load seeds Hold/Toggle
	from g_crouch_toggle, then forces crouch/walk/sprint modes to match.

	FDDA body search / Faster Skinning briefly flip g_crouch_toggle to pulse
	crouch. We cache the player's real preference so that trick does not yank us
	into toggle handling, and we pass those scripted pulses straight through.

	Engine move states remain the source of truth so prone_fix and other
	mods can read pose via IsMoveState("mcCrouch") / IsMoveState("mcAccel").
]]

local CONF = _G.dogma_player_pose_controls_conf
local MOD_ID = CONF.MOD_ID
local D = CONF.defaults
local DOGMA

local POSE = {
	STAND = "stand",
	CROUCH = "crouch",
	PRONE = "prone",
	WALK = "walk",
}

local BLOCKED_MOVE_STATES = {
	mcJump = true,
	mcFall = true,
	mcClimb = true,
}

local LOG = {
	POSE = { order = 1, color = "yellow" },
	KEY = { order = 2, color = "cyan" },
}

local CONFIG = {
	enabled = D["enabled"],
	walk_key = D["walk_key"],
	crouch_key = nil,
	prone_key = nil,
	sprint_key = nil,
	-- true = toggle, false = hold (after sync)
	toggle_mode = false,
	debug_log = true,
	debug_overlay = false,
}

local applying_pose = false
local pending_goal = nil
-- Player preference from MCM sync. Not the live console value —
-- other mods temporarily flip g_crouch_toggle for scripted crouch pulses.
local cached_crouch_toggle = false

-- DIK -> console bind token (kLCONTROL / mouse1). Built once from DIK_keys.
local dik_token = {}
local dik_token_ready = false

local ENGINE_BINDS = {
	crouch = { action = "crouch", bind = function() return key_bindings.kCROUCH end, mcm = "crouch_key" },
	prone = { action = "accel", bind = function() return key_bindings.kACCEL end, mcm = "prone_key" },
	sprint = {
		action = "sprint_toggle",
		bind = function() return key_bindings.kSPRINT_TOGGLE or key_bindings.kSPRINT end,
		mcm = "sprint_key",
	},
}

local TOGGLE_CMDS = { "g_crouch_toggle", "g_walk_toggle", "g_sprint_toggle" }

local function log(msg)
	if not DOGMA.dbg then
		return
	end
	if CONFIG.debug_log then
		DOGMA.dbg.log(MOD_ID, tostring(msg))
	end
end

local function overlay(log_type, msg)
	if not DOGMA.dbg then
		return
	end
	if CONFIG.debug_overlay then
		local slot = log_type or LOG.POSE
		DOGMA.dbg.overlay(MOD_ID, slot.order, tostring(msg), slot.color)
	end
end

local function get_pose()
	if IsMoveState("mcCrouch") then
		if IsMoveState("mcAccel") then
			return POSE.PRONE
		end
		return POSE.CROUCH
	end
	if IsMoveState("mcAccel") then
		return POSE.WALK
	end
	return POSE.STAND
end

local function use_hold_mode()
	return not cached_crouch_toggle
end

local function mod_active()
	return CONFIG.enabled
end

-- Let FDDA / skinning crouch pulses hit the engine instead of our key remap.
local function passthrough_scripted_pose_pulse()
	-- Those mods only force-enable toggle for a press/release; never force-disable.
	local live_crouch_toggle = get_console_cmd(1, "g_crouch_toggle") or false
	if live_crouch_toggle and not cached_crouch_toggle then
		return true
	end
	if _G.lam2 and lam2.get_current_action then
		local action = lam2.get_current_action()
		if action and action.tag == "body_search" then
			return true
		end
	end
	return false
end

local function mcm_opt(key)
	return MOD_ID .. "/" .. key
end

local function mcm_store(key, value)
	if ui_mcm and ui_mcm.set then
		ui_mcm.set(mcm_opt(key), value)
	end
end

local function mcm_raw(key)
	if not ui_mcm or not ui_mcm.get then
		return nil
	end
	return ui_mcm.get(mcm_opt(key))
end

local function ensure_dik_tokens()
	if dik_token_ready then
		return
	end
	if not DIK_keys then
		return
	end
	for name, code in pairs(DIK_keys) do
		if type(name) == "string" and type(code) == "number" then
			if string.sub(name, 1, 4) == "DIK_" then
				dik_token[code] = "k" .. string.sub(name, 5)
			elseif string.sub(name, 1, 6) == "MOUSE_" then
				dik_token[code] = "mouse" .. string.sub(name, 7)
			end
		end
	end
	dik_token_ready = true
	-- ponytail: O(n) DIK table scan once; assert pack matches console bind tokens
	if DIK_keys.DIK_LCONTROL and dik_token[DIK_keys.DIK_LCONTROL] ~= "kLCONTROL" then
		log("dik token pack failed for DIK_LCONTROL")
	end
end

local function dik_to_bind_token(dik)
	dik = tonumber(dik)
	if not dik or dik < 0 then
		return nil
	end
	ensure_dik_tokens()
	return dik_token[dik]
end

local function engine_bind_dik(kb)
	local bind = kb.bind()
	if not bind then
		return
	end
	local dik = bind_to_dik(bind)
	if dik and dik ~= 0 then
		return dik
	end
end

local function set_engine_bind(action, dik)
	local token = dik_to_bind_token(dik)
	if not token then
		log(string.format("bind skip %s: no token for dik=%s", action, tostring(dik)))
		return false
	end
	exec_console_cmd(string.format("bind %s %s", action, token))
	log(string.format("bind %s %s", action, token))
	return true
end

local function set_engine_toggle(toggle_on)
	local word = toggle_on and "1" or "0"
	for _, cmd in ipairs(TOGGLE_CMDS) do
		exec_console_cmd(cmd .. " " .. word)
	end
	log(string.format("toggle modes -> %s", word))
end

-- Seed MCM from engine when unset; always push MCM -> Controls so they match.
local function sync_mirrored_controls()
	local mode = mcm_raw("hold_toggle")
	if mode == nil or tonumber(mode) == -1 then
		local crouch_toggle = get_console_cmd(1, "g_crouch_toggle") or false
		mode = crouch_toggle and 1 or 0
		mcm_store("hold_toggle", mode)
		log(string.format("seeded hold_toggle from g_crouch_toggle -> %s", tostring(mode)))
	end
	mode = tonumber(mode) or 0
	if mode ~= 0 and mode ~= 1 then
		mode = 0
		mcm_store("hold_toggle", mode)
	end
	CONFIG.toggle_mode = (mode == 1)
	cached_crouch_toggle = CONFIG.toggle_mode
	set_engine_toggle(CONFIG.toggle_mode)

	for _, kb in pairs(ENGINE_BINDS) do
		local dik = DOGMA.mcm.key(MOD_ID, kb.mcm)
		if not dik then
			dik = engine_bind_dik(kb)
			if dik then
				mcm_store(kb.mcm, dik)
				log(string.format("seeded %s from engine dik=%s", kb.mcm, tostring(dik)))
			end
		end
		if dik then
			set_engine_bind(kb.action, dik)
			CONFIG[kb.mcm] = dik
		else
			CONFIG[kb.mcm] = nil
		end
	end
end

local function on_option_change()
	CONFIG.enabled = DOGMA.mcm.bool(MOD_ID, "enabled")
	CONFIG.walk_key = DOGMA.mcm.key(MOD_ID, "walk_key")
	CONFIG.debug_log = DOGMA.dbg.logging()
	CONFIG.debug_overlay = DOGMA.dbg.overlay_enabled()
	DOGMA.dbg.set_enabled(MOD_ID, DOGMA.dbg.overlay_enabled())
	-- Only push binds/toggles into the engine while Pose Controls is on.
	-- on_option_change fires for every MCM page; syncing while disabled
	-- would clobber Controls whenever any DOGMA option changes.
	if CONFIG.enabled then
		sync_mirrored_controls()
	end
end

-- Keys need a free HUD. Pending pose steps may finish during loot UI.
local function actor_can_change_pose()
	if not DOGMA.sys.ready(MOD_ID, db, on_option_change) then
		return false
	end
	if device():is_paused() then
		return false
	end
	for state in pairs(BLOCKED_MOVE_STATES) do
		if IsMoveState(state) then
			return false
		end
	end
	return true
end

local function input_allowed()
	return actor_can_change_pose() and actor_menu.is_hud_free()
end

local function is_walk_key(key)
	return CONFIG.walk_key and key == CONFIG.walk_key
end

local function bind_dik(bind)
	local dik = bind_to_dik(bind)
	if dik and dik ~= 0 then
		return dik
	end
end

local function block(flags)
	if flags then
		flags.ret_value = false
	end
end

local function with_synthetic_input(fn)
	applying_pose = true
	fn()
	applying_pose = false
end

local function pulse_bind(bind)
	local dik = bind_dik(bind)
	if not dik then
		return
	end
	level.press_action(dik)
	level.release_action(dik)
end

local function set_bind_down(bind, down)
	local dik = bind_dik(bind)
	if not dik then
		return
	end
	if down then
		level.press_action(dik)
	else
		level.release_action(dik)
	end
end

local function hold_bind(bind)
	local dik = bind_dik(bind)
	if dik then
		level.hold_action(dik)
	end
end

-- Toggle: one XOR pulse per step.
local function step_toward(goal)
	local pose = get_pose()
	if pose == goal then
		return true
	end

	if goal == POSE.STAND then
		if pose == POSE.PRONE then
			pulse_bind(key_bindings.kACCEL)
		elseif pose == POSE.CROUCH then
			pulse_bind(key_bindings.kCROUCH)
		elseif pose == POSE.WALK then
			pulse_bind(key_bindings.kACCEL)
		end
	elseif goal == POSE.CROUCH then
		if pose == POSE.PRONE then
			pulse_bind(key_bindings.kACCEL)
		elseif pose == POSE.WALK then
			pulse_bind(key_bindings.kACCEL)
		elseif pose == POSE.STAND then
			pulse_bind(key_bindings.kCROUCH)
		end
	elseif goal == POSE.PRONE then
		if pose == POSE.WALK then
			pulse_bind(key_bindings.kACCEL)
		elseif pose == POSE.STAND then
			pulse_bind(key_bindings.kCROUCH)
		elseif pose == POSE.CROUCH then
			pulse_bind(key_bindings.kACCEL)
		end
	elseif goal == POSE.WALK then
		if pose == POSE.PRONE then
			pulse_bind(key_bindings.kACCEL)
		elseif pose == POSE.CROUCH then
			pulse_bind(key_bindings.kCROUCH)
		elseif pose == POSE.STAND then
			pulse_bind(key_bindings.kACCEL)
		end
	end

	return get_pose() == goal
end

local function run_transition(goal)
	pending_goal = goal
	with_synthetic_input(function()
		if step_toward(goal) then
			pending_goal = nil
		end
	end)
	log(string.format("transition -> %s (engine: %s)", goal, get_pose()))
end

local function on_before_key_press(key, bind, _dis, flags)
	if applying_pose or not mod_active() or not input_allowed() then
		return
	end

	if is_walk_key(key) then
		if use_hold_mode() then
			block(flags)
		else
			block(flags)
			if get_pose() == POSE.WALK then
				run_transition(POSE.STAND)
			else
				run_transition(POSE.WALK)
			end
			overlay(LOG.KEY, "walk key")
		end
		return
	end

	-- Scripted crouch pulses (FDDA body search, Faster Skinning) — leave alone.
	if passthrough_scripted_pose_pulse() then
		return
	end

	if bind == key_bindings.kCROUCH then
		if not use_hold_mode() then
			block(flags)
			if get_pose() == POSE.CROUCH then
				run_transition(POSE.STAND)
			else
				run_transition(POSE.CROUCH)
			end
			overlay(LOG.KEY, "crouch key")
		end
	elseif bind == key_bindings.kACCEL and not use_hold_mode() then
		block(flags)
		if get_pose() == POSE.PRONE then
			run_transition(POSE.STAND)
		else
			run_transition(POSE.PRONE)
		end
		overlay(LOG.KEY, "prone key")
	end
end

local function on_before_key_hold(key, bind, _dis, flags)
	if applying_pose or not mod_active() or not input_allowed() then
		return
	end

	if not use_hold_mode() then
		return
	end

	if passthrough_scripted_pose_pulse() then
		return
	end

	if is_walk_key(key) then
		block(flags)
		with_synthetic_input(function()
			if IsMoveState("mcCrouch") then
				set_bind_down(key_bindings.kCROUCH, false)
			end
			hold_bind(key_bindings.kACCEL)
		end)
		return
	end

	if bind == key_bindings.kCROUCH then
		block(flags)
		with_synthetic_input(function()
			if IsMoveState("mcAccel") then
				set_bind_down(key_bindings.kACCEL, false)
			end
			hold_bind(key_bindings.kCROUCH)
		end)
	elseif bind == key_bindings.kACCEL then
		block(flags)
		with_synthetic_input(function()
			hold_bind(key_bindings.kCROUCH)
			hold_bind(key_bindings.kACCEL)
		end)
	end
end

local function on_before_key_release(key, bind, _dis, flags)
	if applying_pose or not mod_active() or not input_allowed() then
		return
	end

	if passthrough_scripted_pose_pulse() then
		return
	end

	if use_hold_mode() then
		if is_walk_key(key) and get_pose() == POSE.WALK then
			with_synthetic_input(function()
				set_bind_down(key_bindings.kACCEL, false)
			end)
			pending_goal = nil
			log(string.format("walk key release -> %s", get_pose()))
		end
		return
	end

	if bind == key_bindings.kCROUCH or bind == key_bindings.kACCEL then
		block(flags)
	end
end

local function on_actor_on_first_update()
	DOGMA.sys.ready(MOD_ID, db, on_option_change)
end

local function on_actor_on_update()
	if not DOGMA.sys.ready(MOD_ID, db, on_option_change) then
		return
	end

	-- Finish in-progress transitions even while loot UI is open (FDDA body search).
	if pending_goal and mod_active() and actor_can_change_pose() and not use_hold_mode() then
		with_synthetic_input(function()
			if step_toward(pending_goal) then
				pending_goal = nil
			end
		end)
	end

	overlay(LOG.POSE, "pose: " .. get_pose())
end

function on_game_start()
	DOGMA = dogma_common.load(MOD_ID)

	RegisterScriptCallback("on_before_key_press", on_before_key_press)
	RegisterScriptCallback("on_before_key_hold", on_before_key_hold)
	RegisterScriptCallback("on_before_key_release", on_before_key_release)
	RegisterScriptCallback("actor_on_first_update", on_actor_on_first_update)
	RegisterScriptCallback("actor_on_update", on_actor_on_update)
	RegisterScriptCallback("on_option_change", on_option_change)
	log("loaded")
end
