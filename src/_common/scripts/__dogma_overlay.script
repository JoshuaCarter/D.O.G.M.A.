--[[
	DOGMA debug overlay (namespace module, no globals).

	Features use dogma.overlay (wired by dogma.script).

	set(source, order, msg, color) - HUD slot
	clear(source)                  - wipe that source
	enabled()                      - D.O.G.M.A. -> Debug -> debug overlay

	Drawn via AddDialogToRender so it sits above ZoomTexture (binoc mask).
	CustomStatic is under that mask. Do not call get_hud before first update.
]]

local DEBUG_MOD = "dogma/debug"
local UI_XML = "ui_dogma_debug_overlay.xml"
local PANEL_TEX = "ui_inGame2_white_rect"
local ORIGIN_X = 10
local ORIGIN_Y = 50
local PANEL_PAD = 8
local PANEL_W = 200
local LINE_H = 16
local UI_WIDTH = 1024
local UI_HEIGHT = 768

local POS_VEC
local SIZE_VEC

local sources = {}
local HUD = nil
local hud_ready = false
local overlay_on = false
local overlay_synced = false
local OVERLAY_PATH = DEBUG_MOD .. "/debug_overlay"

local function log(msg)
	__dogma_log.log(DEBUG_MOD, tostring(msg))
end

local function hud_code(color)
	local lg = rawget(_G, "__dogma_log")
	if lg and lg.hud_color then
		return lg.hud_color(color)
	end
	return "%c[255,255,255,255]"
end

local function tag(mod_id)
	local lg = rawget(_G, "__dogma_log")
	if lg and lg.tag then
		return lg.tag(mod_id)
	end
	return tostring(mod_id or "dogma"):gsub("/", "_")
end

local function get_source(source)
	source = source or "default"
	if not sources[source] then
		sources[source] = { slots = {} }
	end
	return sources[source]
end

local function any_content()
	for _, s in pairs(sources) do
		if next(s.slots) then
			return true
		end
	end
	return false
end

local function read_overlay_on()
	if ui_mcm then
		local value = ui_mcm.get(OVERLAY_PATH)
		if value ~= nil then
			return value == true or value == 1
		end
	end
	local conf = _G.dogma_debug_conf
	local defaults = conf and conf.DEFAULTS
	if defaults and defaults.debug_overlay ~= nil then
		return defaults.debug_overlay == true or defaults.debug_overlay == 1
	end
	return false
end

function enabled()
	if not overlay_synced then
		overlay_on = read_overlay_on()
		overlay_synced = true
	end
	return overlay_on
end

class "UIDogmaOverlayHUD" (CUIScriptWnd)

function UIDogmaOverlayHUD:__init() super()
	self:SetWndRect(Frect():set(0, 0, UI_WIDTH, UI_HEIGHT))
	self:SetAutoDelete(true)
	local xml = CScriptXmlInit()
	xml:ParseFile(UI_XML)
	self.panel = xml:InitStatic("panel", self)
	self.text = xml:InitStatic("text", self)
	self.panel:Show(false)
	self.text:Show(false)
end

function UIDogmaOverlayHUD:__finalize()
end

local try_panel_tex = function(tex, wnd)
	wnd:InitTexture(tex)
end

local try_panel_stretch = function(wnd)
	wnd:SetStretchTexture(true)
end

local try_panel_color = function(GetARGB, wnd)
	wnd:SetTextureColor(GetARGB(76, 8, 8, 10))
end

local try_font_wnd = function(font, wnd)
	wnd:SetFont(font)
end

local try_font_tc = function(font, tc)
	tc:SetFont(font)
end

local try_adjust = function(wnd)
	wnd:AdjustHeightToText()
end

local try_complex_wnd = function(wnd)
	wnd:SetTextComplexMode(true)
end

local try_complex_tc = function(tc)
	tc:SetTextComplexMode(true)
end

local function ensure_vecs()
	if POS_VEC then
		return
	end
	POS_VEC = vector2()
	SIZE_VEC = vector2()
end

local function detach()
	if not HUD then
		return
	end
	if hud_ready then
		local hud = get_hud()
		if hud then
			hud:RemoveDialogToRender(HUD)
		end
	end
	HUD = nil
	log("overlay dialog detached")
end

local function attach()
	if HUD then
		return HUD
	end
	if not hud_ready then
		return nil
	end
	local hud = get_hud()
	if not hud then
		log("overlay attach skipped: no hud")
		return nil
	end
	ensure_vecs()
	HUD = UIDogmaOverlayHUD()
	hud:AddDialogToRender(HUD)
	log("overlay dialog attached")
	return HUD
end

local function hide()
	detach()
end

local function show_panel(x, y, w, h)
	local wnd = HUD and HUD.panel
	if not wnd then
		return
	end
	wnd:SetWndPos(POS_VEC:set(x, y))
	wnd:SetWndSize(SIZE_VEC:set(w, h))
	pcall(try_panel_tex, PANEL_TEX, wnd)
	pcall(try_panel_stretch, wnd)
	pcall(try_panel_color, GetARGB, wnd)
	wnd:Show(true)
end

local function render()
	if not enabled() or not any_content() then
		hide()
		return
	end
	local dlg = attach()
	if not dlg then
		return
	end

	local wnd = dlg.text
	if not wnd then
		return
	end
	local text_x = ORIGIN_X + PANEL_PAD
	local text_y = ORIGIN_Y + PANEL_PAD
	local text_w = PANEL_W - PANEL_PAD * 2
	wnd:SetWndPos(POS_VEC:set(text_x, text_y))
	wnd:SetWndSize(SIZE_VEC:set(text_w, UI_HEIGHT))
	pcall(try_complex_wnd, wnd)
	local font = GetFontLetterica16Russian and GetFontLetterica16Russian()
	if font then
		pcall(try_font_wnd, font, wnd)
	end

	local names = {}
	for name, s in pairs(sources) do
		if next(s.slots) then
			names[#names + 1] = name
		end
	end
	table.sort(names)

	local white = hud_code("white")
	local lines = {}
	for _, name in ipairs(names) do
		local slots = sources[name].slots
		if #lines > 0 then
			lines[#lines + 1] = ""
		end
		lines[#lines + 1] = white .. "[" .. tag(name) .. "]"
		local max_order = -1
		for order in pairs(slots) do
			if order > max_order then
				max_order = order
			end
		end
		for order = 0, max_order do
			local slot = slots[order]
			if slot then
				lines[#lines + 1] = hud_code(slot.color) .. slot.msg
			else
				lines[#lines + 1] = ""
			end
		end
	end

	if #lines == 0 then
		hide()
		return
	end

	local est_h = math.floor(#lines * LINE_H + 0.5)
	show_panel(ORIGIN_X, ORIGIN_Y, PANEL_W, est_h + PANEL_PAD * 2)
	local tc = wnd:TextControl()
	if tc then
		pcall(try_complex_tc, tc)
		if font then
			pcall(try_font_tc, font, tc)
		end
		tc:SetText(table.concat(lines, "\\n"))
	end
	pcall(try_adjust, wnd)
	wnd:Show(true)
	local text_h = tonumber(wnd.GetHeight and wnd:GetHeight()) or 0
	if text_h >= 1 then
		local pw = dlg.panel
		if pw then
			pw:SetWndSize(SIZE_VEC:set(PANEL_W, text_h + PANEL_PAD * 2))
		end
	end
end

function set(source, order, msg, color)
	if not enabled() then
		return
	end
	local s = get_source(source)
	s.slots[order or 0] = { msg = tostring(msg), color = color }
	render()
end

function clear(source)
	if not source then
		return
	end
	local s = sources[source]
	if not s then
		return
	end
	s.slots = {}
	render()
end

local function on_option_change()
	overlay_on = read_overlay_on()
	overlay_synced = true
	render()
end

local function on_first_update()
	hud_ready = true
	render()
end

-- In-game ESC: GameUI is alive. Window stays in m_dialogsToRender until we
-- RemoveDialogToRender. Nil-only lets SetAutoDelete GC the C++ wnd while
-- OnFrame still Update/Draws it. MCM init allocs, GC runs, native crash.
local function on_main_menu()
	if HUD and hud_ready then
		local hud = get_hud()
		if hud then
			hud:RemoveDialogToRender(HUD)
			log("overlay dialog detached (menu)")
		end
	end
	HUD = nil
end

-- Game UI is dying. Do not call get_hud.
local function on_hud_gone()
	HUD = nil
	hud_ready = false
end

function on_game_start()
	RegisterScriptCallback("on_option_change", on_option_change)
	RegisterScriptCallback("actor_on_first_update", on_first_update)
	RegisterScriptCallback("actor_on_net_destroy", on_hud_gone)
	RegisterScriptCallback("main_menu_on_init", on_main_menu)
	RegisterScriptCallback("main_menu_on_quit", render)
end
