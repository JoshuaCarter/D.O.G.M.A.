	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_pellet_hit_pct_desc">
		<text>Buckshot / multi-pellet ammo only. Slugs stay at 1 pellet; effective count never drops below 1.</text>
	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_drop_range">
		<text>Dispersion/drop range (m)</text>
	</string>
	<string id="ui_mcm_dogma_weapon_tooltip_drop_range_desc">
