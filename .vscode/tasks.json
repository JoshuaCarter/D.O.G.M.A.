{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "DOGMA: Build",
			"type": "shell",
			"command": "bash tools/build.sh",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"DOGMA_DEPLOY": "C:/GAMMA/mods/DOGMA"
				}
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"problemMatcher": []
		}
	]
}
