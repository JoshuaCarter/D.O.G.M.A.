-- hud/medik conf
-- Remaps Medik's booster icon+digit row to rad/bleed vitals (6 slots, 2x3).

_G.dogma_hud_medik_conf = {
	MOD_ID = "dogma/hud/medik",
	DEFAULTS = {},

	-- Visible slots (2x3). `icon` = texture id from dogma_medik_slots.dds (32x32 L→R).
	-- `tint`: nil = white; "rad"/"bleed" = white→green/red by value.
	SLOTS = {
		-- row 1
		{ id = "rad_dose", icon = "dogma_medik_rad", fmt = "int", tint = "rad", tint_max = 999 },
		{ id = "rad_restore", icon = "dogma_medik_rad_res", fmt = "int" },
		{ id = "rad_protect", icon = "dogma_medik_rad_prot", fmt = "pct" },
		-- row 2
		{ id = "bleed", icon = "dogma_medik_bleed", fmt = "int", tint = "bleed", tint_max = 999 },
		{ id = "bleed_restore", icon = "dogma_medik_bleed_res", fmt = "int" },
		{ id = "bleed_protect", icon = "dogma_medik_bleed_prot", fmt = "pct" },
	},

	-- HUD rad-icon mSv scale (G_FLAT Msv Above Radiation Icon / item_device tip).
	MSV_K = 10000 * 0.387,

	-- Medik layout constants (medik_ui UIMedik:__init)
	LAYOUT = {
		BO_X0 = 0.02270,
		BO_COLW = 0.011185,
		ICON_WH = 0.009,
		DIG_W = 0.0022,
		DIG_H = 0.0032,
		ICON_Y0 = 0.04438,
		ROW_PITCH = 0.0130,
		DIG_GAP = 0.0006,
		COLS = 3,
	},
}
