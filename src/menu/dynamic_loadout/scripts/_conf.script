-- Armor/helmet ini keys -> MCM weight id (order for scoring/logs)
local PROT_KEYS = {
	{ key = "fire_wound_protection", cfg = "a_fire_wound" },
	{ key = "strike_protection", cfg = "a_strike" },
	{ key = "wound_protection", cfg = "a_wound" },
	{ key = "explosion_protection", cfg = "a_explosion" },
	{ key = "shock_protection", cfg = "a_shock" },
	{ key = "burn_protection", cfg = "a_burn" },
	{ key = "chemical_burn_protection", cfg = "a_chem" },
	{ key = "radiation_protection", cfg = "a_rad" },
	{ key = "telepathy_protection", cfg = "a_psy" },
}

-- When log_scores is on: only these sections get full term-by-term calc dumps
-- (avoids flooding the log). Weapons only for now; ammo/armor/helm later.
local DEBUG_SCORE_SECS = {
	["wpn_pm"] = true,
	["wpn_kiparis"] = true,
	["wpn_ak74"] = true,
	["wpn_ak"] = true,       -- AK-47
	["wpn_ak47"] = true,     -- alias if present
	["wpn_ppsh41"] = true,   -- PPSh-41
	["wpn_bm16"] = true,     -- TOZ-66 sawn-off
	["wpn_bm16_full"] = true, -- TOZ-66
}

_G.dogma_menu_dynamic_loadout_conf = {
	MOD_ID = "dogma/menu/dynamic_loadout",
	DEFAULTS = defaults,
	WEIGHT_KEYS = WEIGHT_KEYS,
	KIT_IDS = KIT_IDS,
	FACTION_BLOC = FACTION_BLOC,
	FACTION_COMMUNITY = FACTION_COMMUNITY,
	PROT_KEYS = PROT_KEYS,
	DEBUG_SCORE_SECS = DEBUG_SCORE_SECS,
}
