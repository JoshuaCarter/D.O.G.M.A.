--[[
	Sole owner of neutral weapon/armor scoring math (dmg columns, DPS, burst, spread).

	Callers gather inputs (LTX fields + reload_s from motions), then call:
	  dogma_item_stats.weapon_calculate(input)
	  dogma_item_stats.armor_calculate(input)

	SALE (lupa) and any in-game scorer must use these — do not reimplement.
	Weapon tooltips keep a richer live damage table (barrel/silencer/condition/diff);
	that UI path is display-only and is not the loadout scorer.

	reload_s is an input (OMF/motions offline, tip.weapon_reload_seconds in-game).
	weapon_input_from_ini / armor_input_from_ini need ini_sys (game only).
]]

local TORSO_TIERS = {
	{ armor = 0.011, ap_scale = 0.8889, hit_frac = 0.8500, name = "Min" },
	{ armor = 0.075, ap_scale = 0.8562, hit_frac = 0.6250, name = "Lgt" },
	{ armor = 0.100, ap_scale = 0.7955, hit_frac = 0.5000, name = "Lgt+" },
	{ armor = 0.150, ap_scale = 0.8117, hit_frac = 0.4783, name = "Mid" },
	{ armor = 0.200, ap_scale = 0.7412, hit_frac = 0.3618, name = "Mid+" },
	{ armor = 0.250, ap_scale = 0.7400, hit_frac = 0.3050, name = "Hvy" },
	{ armor = 0.400, ap_scale = 0.7500, hit_frac = 0.2000, name = "Hvy+" },
	{ armor = 0.550, ap_scale = 0.7000, hit_frac = 0.1500, name = "Exo" },
	{ armor = 0.650, ap_scale = 0.7000, hit_frac = 0.1500, name = "Max" },
}

local SCORE_COLS = #TORSO_TIERS -- Min .. Max (all torso armor tiers)
local BONE_DMG_TORSO = 0.9
local BALLISTIC_BONUS = 1.1
local K_AP_COMBAT_SCALE = 10
local AP_TAIL = 0.80
local ARMOR_CHIP_FRAC = 0.60
local HARD_FAIL_SCALE = 0.0025 * 62.5
local DAMAGE_SCALE = 100
local DEFAULT_DIST = 30
local MUTANT_BASE_MULT = 0.85
local MUTANT_AMMO_MULT_DEFAULT = 0.85

local HP_AMMO_MULT = {
	["ammo_357_hp_mag"] = 2,
	["ammo_9x18_pmm"] = 2,
	["ammo_9x19_pbp"] = 2,
	["ammo_7.62x25_p"] = 1.75,
	["ammo_11.43x23_hydro"] = 2.7,
	["ammo_5.45x39_ep"] = 1.45,
	["ammo_5.56x45_ss190"] = 1.33,
	["ammo_12x76_zhekan"] = 3.5,
	["ammo_12x76_dart"] = 1.5,
	["ammo_12x70_buck"] = 3,
	["ammo_23x75_shrapnel"] = 2,
	["ammo_23x75_barrikada"] = 3.5,
	["ammo_20x70_buck"] = 2,
	["ammo_338_federal"] = 10,
}

local MUTANT_AMMO_MULT = {
	["ammo_12x70_buck"] = 0.90,
	["ammo_20x70_buck"] = 0.90,
	["ammo_23x75_shrapnel"] = 1.00,
	["ammo_12x76_zhekan"] = 1.00,
	["ammo_23x75_barrikada"] = 1.00,
	["ammo_9x19_pbp"] = 1.00,
	["ammo_9x18_pmm"] = 1.00,
	["ammo_5.45x39_ep"] = 1.00,
	["ammo_5.56x45_ss190"] = 1.00,
	["ammo_7.62x25_ps"] = 1.00,
	["ammo_7.62x25_p"] = 1.75,
	["ammo_357_hp_mag"] = 1.00,
	["ammo_11.43x23_hydro"] = 1.00,
	["ammo_11.43x23_fmj"] = 1.00,
}

local ACTOR_DISP_BASE = 1.5
local ACTOR_DISP_VEL = 2.5
local VEL_MAX = 10
local SPEED_RUN = 5.0
local BURST_KICK_DEG = 3

-- CQC snipers (parent_section keys). +0.05 to raw k_ap before combat scale.
local SNIPER_AP_BONUS = 0.05
local SNIPERS = {
	["wpn_dvl10_m1"] = true,
	["wpn_dvl10"] = true,
	["wpn_l96a1"] = true,
	["wpn_l96a1m"] = true,
	["wpn_m98b"] = true,
	["wpn_m24"] = true,
	["wpn_remington700"] = true,
	["wpn_remington700_archangel"] = true,
	["wpn_remington700_lapua700"] = true,
	["wpn_remington700_magpul_pro"] = true,
	["wpn_remington700_mod_x_gen3"] = true,
	["wpn_steyr_scout_big"] = true,
	["wpn_sv98"] = true,
	["wpn_sv98_custom"] = true,
	["wpn_k98_mod"] = true,
	["wpn_wa2000"] = true,
	["wpn_trg"] = true,
	["wpn_mosin"] = true,
}

-- Integrally suppressed (parent_section keys). Score silencer=1 even if LTX status is 0.
local INTEGRATED_SILENCER = {
	["wpn_dvl10_m1"] = true,
	["wpn_vssk"] = true,
	["wpn_val_tac"] = true,
	["wpn_vintorez"] = true,
	["wpn_val"] = true,
	["wpn_val_modern"] = true,
	["wpn_vintorez_m1"] = true,
	["wpn_vintorez_m2"] = true,
	["wpn_vintorez_isg"] = true,
	["wpn_mp5sd"] = true,
	["wpn_mp5sd_custom"] = true,
	["wpn_mp5sd_new"] = true,
}

local PROT_KEYS = {
	"fire_wound_protection",
	"strike_protection",
	"wound_protection",
	"explosion_protection",
	"shock_protection",
	"burn_protection",
	"chemical_burn_protection",
	"radiation_protection",
	"telepathy_protection",
}

local function dist_atten(air_res, dist)
	local k = air_res or 0.05
	return 1 + ((dist or DEFAULT_DIST) / 200) * k * 0.5 / (1 - k + 0.1)
end

-- parent_section preferred when known (variants inherit sniper status from parent).
local function sniper_ap_bonus(sec, parent_section)
	local parent = parent_section or sec
	if parent and SNIPERS[parent] then
		return SNIPER_AP_BONUS
	end
	return 0
end

local function has_integrated_silencer(sec, parent_section)
	local parent = parent_section or sec
	if parent and INTEGRATED_SILENCER[parent] then
		return true
	end
	if sec and INTEGRATED_SILENCER[sec] then
		return true
	end
	return false
end

local function combat_ap(k_ap_ltx, air_res, dist, ap_scale, barrel, silencer, sniper_bonus)
	return ((k_ap_ltx or 0) * K_AP_COMBAT_SCALE + (sniper_bonus or 0))
		* (ap_scale or 1) * (barrel or 1)
		/ dist_atten(air_res, dist)
		* AP_TAIL
		* (silencer or 1)
end

local function base_power(hit_power, k_hit, air_res, dist, bone_mult, ap_scale, pellet_mult, barrel, silencer)
	return (hit_power or 0.5) / dist_atten(air_res, dist)
		* (k_hit or 1) * (bone_mult or BONE_DMG_TORSO) * (ap_scale or 1) * BALLISTIC_BONUS
		* (pellet_mult or 1) * (barrel or 1) * (silencer or 1)
end

local function effective_dmg(hit_power, k_hit, k_ap_ltx, air_res, armor, ap_scale, hit_frac, bone_mult, dist, pellet_mult, barrel, ammo_sec, silencer, sniper_bonus)
	local ap = combat_ap(k_ap_ltx, air_res, dist, ap_scale, barrel, silencer, sniper_bonus)
	local power = base_power(hit_power, k_hit, air_res, dist, bone_mult, ap_scale, pellet_mult, barrel, silencer)
	local dmg
	if (armor or 0) <= 0 or ap >= armor then
		dmg = power
	else
		local soft_pen_ap = armor / (1 + ARMOR_CHIP_FRAC)
		if ap > soft_pen_ap then
			dmg = power * (hit_frac or 1)
		else
			local hp_mult = HP_AMMO_MULT[ammo_sec] or 1
			dmg = HARD_FAIL_SCALE * power * (hit_frac or 1) / hp_mult
		end
	end
	return dmg * DAMAGE_SCALE
end

local function sustained_dps(dmg, rpm, mag, reload_s)
	dmg = dmg or 0
	rpm = rpm or 0
	mag = mag or 0
	reload_s = reload_s or 0
	if dmg <= 0 or mag <= 0 or rpm <= 0 then
		return 0
	end
	local fire_s = mag * 60 / rpm
	local cycle = fire_s + math.max(0, reload_s)
	if cycle <= 0 then
		return 0
	end
	return dmg * mag / cycle
end

local function burst_shots(inp)
	if type(inp.burst_shots) == "number" and inp.burst_shots > 0 then
		return inp.burst_shots
	end
	local zoom_disp = inp.zoom_cam_dispersion or 0
	local hip_disp = inp.cam_dispersion or 0
	local disp = (zoom_disp > 0) and zoom_disp or hip_disp
	local max_shots = 200
	if not disp or disp <= 0 then
		return max_shots
	end
	local inc = inp.zoom_cam_dispersion_inc or 0
	if inc == 0 then
		inc = inp.cam_dispersion_inc or 0
	end
	local return_on = inp.cam_return
	if return_on == nil then
		return_on = true
	end
	local relax = 0
	if return_on then
		relax = inp.zoom_cam_relax_speed or 0
		if relax <= 0 then
			relax = inp.cam_relax_speed or 0
		end
	end
	local rpm = inp.rpm or 0
	local dt = (rpm > 0) and (60 / rpm) or 0
	local climb = 0
	for n = 1, max_shots do
		climb = climb + disp + (n - 1) * inc
		if return_on and relax > 0 and dt > 0 then
			climb = math.max(0, climb - relax * dt)
		end
		if climb >= BURST_KICK_DEG then
			return n
		end
	end
	return max_shots
end

local function spread_pair(inp)
	local fire_disp = inp.fire_dispersion_base or 0
	if fire_disp <= 0 then
		return 0, 0
	end
	local pdm_base = inp.PDM_disp_base or 1
	local pdm_vel = inp.PDM_disp_vel_factor or 1
	local actor = ACTOR_DISP_BASE * pdm_base
		* (1 + (SPEED_RUN / VEL_MAX) * ACTOR_DISP_VEL * pdm_vel)
	return fire_disp, fire_disp + actor
end

--[[
	input = {
	  hit_power, rpm, ammo_mag_size, reload_s, use_mag,
	  scope_status, silencer_status, sniper_ap_bonus,
	  fire_dispersion_base, PDM_disp_base, PDM_disp_vel_factor,
	  cam_dispersion, zoom_cam_dispersion, cam_dispersion_inc, zoom_cam_dispersion_inc,
	  cam_relax_speed, zoom_cam_relax_speed, cam_return, burst_shots,
	  cost, dist,
	  rounds = { { sec, k_hit, k_ap, air_resistance, pellets }, ... },
	}
]]
local function weapon_calculate(input)
	input = input or {}
	local dist = input.dist or DEFAULT_DIST
	local hit_power = input.hit_power or 0
	local rpm = input.rpm or 0
	local mag = input.ammo_mag_size or 0
	local reload_s = input.reload_s
	if not reload_s or reload_s <= 0 then
		if (input.use_mag or 1) == 0 then
			reload_s = 1.2 + 0.7 * math.max(mag, 1)
		else
			reload_s = 2.5
		end
	end
	local sniper_ap = input.sniper_ap_bonus or 0
	local rounds = input.rounds or {}

	local col_max = {}
	local col_src = {}
	for i = 1, SCORE_COLS do
		col_max[i] = 0
	end
	for _, r in ipairs(rounds) do
		local k_hit = r.k_hit or 1
		local k_ap = r.k_ap or 0
		local air = r.air_resistance or 0.05
		local pellets = r.pellets or 1
		local sec = r.sec or ""
		for i = 1, SCORE_COLS do
			local tier = TORSO_TIERS[i]
			local dmg = effective_dmg(
				hit_power, k_hit, k_ap, air,
				tier.armor, tier.ap_scale, tier.hit_frac, BONE_DMG_TORSO,
				dist, pellets, 1, sec, 1, sniper_ap
			)
			if dmg > (col_max[i] or 0) then
				col_max[i] = dmg
				col_src[i] = sec
			end
		end
	end

	-- Mutant-row override for column 1 (same as tip score table).
	local mut_max = 0
	local mut_src = nil
	for _, r in ipairs(rounds) do
		local air = r.air_resistance or 0.05
		local k_hit = r.k_hit or 1
		local pellets = r.pellets or 1
		local sec = r.sec or ""
		local dmg = math.floor(
			hit_power / dist_atten(air, dist)
				* k_hit * pellets
				* MUTANT_BASE_MULT * (MUTANT_AMMO_MULT[sec] or MUTANT_AMMO_MULT_DEFAULT)
				* DAMAGE_SCALE + 0.5
		)
		if dmg > mut_max then
			mut_max = dmg
			mut_src = sec
		end
	end
	if mut_max > (col_max[1] or 0) then
		col_max[1] = mut_max
		col_src[1] = mut_src
	end

	local ads, hip = spread_pair(input)
	local burst = burst_shots(input)
	local scope_ok = ((input.scope_status or 0) > 0) and 1 or 0
	local sil_ok = ((input.silencer_status or 0) > 0) and 1 or 0
	if sil_ok == 0 and (
		input.integrated_silencer
		or has_integrated_silencer(input.sec, input.parent_section)
	) then
		sil_ok = 1
	end

	-- Keys match tooltip torso columns Min .. Max.
	return {
		hit_power = hit_power,
		min_dmg = col_max[1] or 0,
		lgt_dmg = col_max[2] or 0,
		lgtp_dmg = col_max[3] or 0,
		mid_dmg = col_max[4] or 0,
		midp_dmg = col_max[5] or 0,
		hvy_dmg = col_max[6] or 0,
		hvyp_dmg = col_max[7] or 0,
		exo_dmg = col_max[8] or 0,
		max_dmg = col_max[9] or 0,
		min_dps = sustained_dps(col_max[1], rpm, mag, reload_s),
		lgt_dps = sustained_dps(col_max[2], rpm, mag, reload_s),
		lgtp_dps = sustained_dps(col_max[3], rpm, mag, reload_s),
		mid_dps = sustained_dps(col_max[4], rpm, mag, reload_s),
		midp_dps = sustained_dps(col_max[5], rpm, mag, reload_s),
		hvy_dps = sustained_dps(col_max[6], rpm, mag, reload_s),
		hvyp_dps = sustained_dps(col_max[7], rpm, mag, reload_s),
		exo_dps = sustained_dps(col_max[8], rpm, mag, reload_s),
		max_dps = sustained_dps(col_max[9], rpm, mag, reload_s),
		burst = burst,
		spread_ads = ads,
		spread_hip = hip,
		scope = scope_ok,
		silencer = sil_ok,
		reload_s = reload_s,
		rpm = rpm,
		mag = mag,
		cost = input.cost or 0,
		col_src = col_src,
	}
end

--[[
	input = {
	  protections = { fire_wound_protection=…, … }  -- or flat keys on input
	  cost, is_helmet
	}
]]
local function armor_calculate(input)
	input = input or {}
	local prots = input.protections or input
	local out = { cost = input.cost or 0 }
	for i = 1, #PROT_KEYS do
		local k = PROT_KEYS[i]
		out[k] = tonumber(prots[k]) or 0
	end
	return out
end

-- Game helper: build weapon input from ini_sys (not used by lupa).
local function weapon_input_from_ini(wpn_sec, dist)
	if not wpn_sec or not ini_sys then
		return nil
	end
	local function f(key, def)
		local v = ini_sys:r_float_ex(wpn_sec, key)
		if v == nil then
			return def
		end
		return v
	end
	local function s(key, def)
		return ini_sys:r_string_ex(wpn_sec, key) or def
	end
	local hp = f("hit_power", nil)
	if hp == nil then
		local hp_s = s("hit_power", nil)
		if hp_s then
			hp = tonumber((hp_s:match("([^,]+)") or ""):match("^%s*(.-)%s*$")) or 0.5
		else
			hp = 0.5
		end
	end
	local rounds = {}
	local ammo_class = s("ammo_class", "") or ""
	for part in string.gmatch(ammo_class, "([^,]+)") do
		local sec = part:match("^%s*(.-)%s*$")
		if sec and sec ~= "" and ini_sys:section_exist(sec) then
			-- buck_shot=0 on grenade/rocket ammo = "not shotgun", not zero pellets
			-- (same clamp as weapon_tooltips: only >1 is multi-pellet).
			local pellets = ini_sys:r_float_ex(sec, "buck_shot") or 1
			if pellets <= 1 then
				pellets = 1
			end
			rounds[#rounds + 1] = {
				sec = sec,
				k_hit = ini_sys:r_float_ex(sec, "k_hit") or 1,
				k_ap = ini_sys:r_float_ex(sec, "k_ap") or 0,
				air_resistance = ini_sys:r_float_ex(sec, "k_air_resistance")
					or ini_sys:r_float_ex(sec, "air_resistance") or 0.05,
				pellets = pellets,
			}
		end
	end
	local return_on = true
	if ini_sys:line_exist(wpn_sec, "cam_return") then
		return_on = f("cam_return", 1) ~= 0
	end
	local parent = s("parent_section", wpn_sec)
	local sil_status = f("silencer_status", 0)
	local integrated = has_integrated_silencer(wpn_sec, parent)
	if integrated and (not sil_status or sil_status <= 0) then
		sil_status = 1
	end
	return {
		hit_power = hp,
		rpm = f("rpm", 0),
		ammo_mag_size = f("ammo_mag_size", 0),
		scope_status = f("scope_status", 0),
		silencer_status = sil_status,
		integrated_silencer = integrated,
		sec = wpn_sec,
		parent_section = parent,
		fire_dispersion_base = f("fire_dispersion_base", 0),
		PDM_disp_base = f("PDM_disp_base", 1),
		PDM_disp_vel_factor = f("PDM_disp_vel_factor", 1),
		cam_dispersion = f("cam_dispersion", 0),
		zoom_cam_dispersion = f("zoom_cam_dispersion", 0),
		cam_dispersion_inc = f("cam_dispersion_inc", 0),
		zoom_cam_dispersion_inc = f("zoom_cam_dispersion_inc", 0),
		cam_relax_speed = f("cam_relax_speed", 0),
		zoom_cam_relax_speed = f("zoom_cam_relax_speed", 0),
		cam_return = return_on,
		sniper_ap_bonus = sniper_ap_bonus(wpn_sec, parent),
		cost = f("cost", 0),
		dist = dist or DEFAULT_DIST,
		rounds = rounds,
	}
end

local function armor_input_from_ini(sec)
	if not sec or not ini_sys then
		return nil
	end
	local prots = {}
	for i = 1, #PROT_KEYS do
		local k = PROT_KEYS[i]
		prots[k] = ini_sys:r_float_ex(sec, k) or 0
	end
	-- Engine LTX typo — psy lives on telepatic_protection.
	if (prots.telepathy_protection or 0) == 0 then
		prots.telepathy_protection = ini_sys:r_float_ex(sec, "telepatic_protection") or 0
	end
	local is_helm = (IsItem and IsItem("helmet", sec))
		or (string.find(sec, "helm", 1, true) ~= nil)
	-- FireWound (ballistic) is bone armor (utils_item.get_outfit_protection).
	local bones = ini_sys:r_string_ex(sec, "bones_koeff_protection")
	if bones and bones ~= "" and parse_list then
		if is_helm then
			local bone_values = parse_list(ini_sys, bones, "bip01_head")
			local br = bone_values and tonumber(bone_values[2])
			if br then
				prots.fire_wound_protection = br
			end
		else
			local bone_values = parse_list(ini_sys, bones, "bip01_spine")
			local br = bone_values and tonumber(bone_values[2])
			if br then
				prots.fire_wound_protection = br
			end
			local helm_ok = ini_sys:r_bool_ex(sec, "helmet_avaliable")
			if not helm_ok then
				local head_values = parse_list(ini_sys, bones, "bip01_head")
				local head = head_values and tonumber(head_values[2])
				if head then
					prots.fire_wound_protection = (prots.fire_wound_protection or 0) + head
				end
			end
		end
	end
	return {
		protections = prots,
		cost = ini_sys:r_float_ex(sec, "cost") or 0,
		is_helmet = is_helm,
	}
end

_G.dogma_item_stats = {
	TORSO_TIERS = TORSO_TIERS,
	PROT_KEYS = PROT_KEYS,
	DEFAULT_DIST = DEFAULT_DIST,
	DAMAGE_SCALE = DAMAGE_SCALE,
	SNIPER_AP_BONUS = SNIPER_AP_BONUS,
	INTEGRATED_SILENCER = INTEGRATED_SILENCER,
	sustained_dps = sustained_dps,
	sniper_ap_bonus = sniper_ap_bonus,
	has_integrated_silencer = has_integrated_silencer,
	weapon_calculate = weapon_calculate,
	armor_calculate = armor_calculate,
	weapon_input_from_ini = weapon_input_from_ini,
	armor_input_from_ini = armor_input_from_ini,
}
