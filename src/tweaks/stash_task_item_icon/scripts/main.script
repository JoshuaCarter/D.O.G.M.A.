--[[
	Stash Task Item Icon

	Utjan's fetch-item icon matches bring-X tasks by section (`task_id.."_fetch"`).
	New Tasks Addon stash jobs spawn a unique PDA/docs instance and track it by
	id, so that icon never fires.

	Same secondary-mission overlay, keyed off NTA's `nta_stash_task_data.target_id`.
]]

local CONFIG = _G.dogma_tweaks_stash_task_item_icon_conf

local HOOK_STATE = _G.__dogma_stash_task_item_icon or {}
_G.__dogma_stash_task_item_icon = HOOK_STATE

local function nta_stash_data()
	local mdata = alife_storage_manager.get_state()
	return mdata and mdata.nta_stash_task_data
end

local function bind_nta_state()
	local nta = rawget(_G, "tasks_nta_stash")
	local mdata = alife_storage_manager.get_state()
	if nta and nta.save_state and mdata then
		nta.save_state(mdata)
	end
end

local function is_stash_task_item(cell)
	local id = cell and cell.ID
	if not id then
		return false
	end
	local stash = nta_stash_data()
	if not stash then
		return false
	end
	for _, v in pairs(stash) do
		if v and v.target_id == id then
			return true
		end
	end
	return false
end

local function stash_task_item_icon(cell, obj, sec)
	if not (sec and is_stash_task_item(cell)) then
		return
	end
	local axis = utils_xml.get_item_axis(sec)
	return {
		texture = "ui_inGame2_PDA_icon_Secondary_mission",
		x = (axis.w - 13),
		y = 1,
		w = 12,
		h = 12,
	}
end

local function wrap_nta_spawn()
	if HOOK_STATE.spawn_wrapped then
		return
	end
	local orig = xr_effects and xr_effects.spawn_stash_and_quest_item
	if type(orig) ~= "function" then
		return
	end
	xr_effects.spawn_stash_and_quest_item = function(actor, npc, p)
		orig(actor, npc, p)
		-- NTA keeps target ids in a file-local table; save_state aliases it
		-- onto alife storage so the icon can read it before the first save.
		bind_nta_state()
	end
	HOOK_STATE.spawn_wrapped = true
end

local function register_icon()
	if HOOK_STATE.icon_registered then
		return
	end
	if not (rax_icon_layers and rax_icon_layers.register) then
		return
	end
	rax_icon_layers.register("dogma_stash_task_item_icon", stash_task_item_icon)
	HOOK_STATE.icon_registered = true
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	wrap_nta_spawn()
	register_icon()
end
