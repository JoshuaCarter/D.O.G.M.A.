function on_mcm_load(options)
	local CONFIG = _G.dogma_gui_bhs_reactive_conf
	local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"
	local mod_content = {
		{ 0, "mcm_kb_mod_none" },
		{ 1, "mcm_kb_mod_shift" },
		{ 2, "mcm_kb_mod_ctrl" },
		{ 3, "mcm_kb_mod_alt" },
	}

	dogma_mcm.attach(options, "gui", "ui_mcm_menu_dogma_gui", {
		id = "bhs_reactive",
		sh = true,
		text = "ui_mcm_menu_dogma_gui_bhs_reactive",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_gui_bhs_reactive_page_description",
			},
			{
				id = "hide_body",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["hide_body"],
				hint = "dogma_gui_bhs_reactive_hide_body",
			},
			{
				id = "key_bhs",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["key_bhs"],
				hint = "dogma_gui_bhs_reactive_key_bhs",
			},
			{
				id = "key_bhs_modifier",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS["key_bhs_modifier"],
				hint = "mcm_kb_modifier",
				content = mod_content,
			},
			{
				id = "show_on_damage",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["show_on_damage"],
				hint = "dogma_gui_bhs_reactive_show_on_damage",
			},
			{
				id = "sec",
				type = "track",
				val = 2,
				min = 0,
				max = 60,
				step = 1,
				def = CONFIG.DEFAULTS["sec"],
				hint = "dogma_gui_bhs_reactive_sec",
			},
			{
				id = "full_heal_clamp_sec",
				type = "track",
				val = 2,
				min = 0,
				max = 60,
				step = 1,
				def = CONFIG.DEFAULTS["full_heal_clamp_sec"],
				hint = "dogma_gui_bhs_reactive_full_heal_clamp_sec",
			},
			{ id = "section_hp", type = "line" },
			{
				id = "hide_hp",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["hide_hp"],
				hint = "dogma_gui_bhs_reactive_hide_hp",
			},
			{
				id = "hp_show_below_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS["hp_show_below_pct"],
				hint = "dogma_gui_bhs_reactive_hp_show_below_pct",
			},
			{ id = "section_stam", type = "line" },
			{
				id = "hide_stam",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["hide_stam"],
				hint = "dogma_gui_bhs_reactive_hide_stam",
			},
			{
				id = "stam_show_below_pct",
				type = "track",
				val = 2,
				min = 0,
				max = 100,
				step = 1,
				def = CONFIG.DEFAULTS["stam_show_below_pct"],
				hint = "dogma_gui_bhs_reactive_stam_show_below_pct",
			},
			{ id = "section_psy", type = "line" },
