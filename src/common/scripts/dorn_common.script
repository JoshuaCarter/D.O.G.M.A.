--[[
	Dorn common loader (vendored into DOGMA — stable, no commit hash).

	Ships alongside dorn_mcm / dorn_dbg / dorn_sys as dorn_common.script.
	X-Ray auto-loads every .script file in gamedata/scripts at boot, so this
	and its 3 siblings are already loaded globals by the time any mod's
	on_game_start() runs — no process_file() call needed.

	Usage from a feature _main.script:

		local MOD_ID = "dogma"
		local DORN_COMMON_VERSION = "dorn_common"

		local DORN

		function on_game_start()
			DORN = _G[DORN_COMMON_VERSION].load(MOD_ID)
			-- ...
		end

	Resolve via _G[DORN_COMMON_VERSION] and call load() inside on_game_start()
	only — never at the top level of the script, since load order across
	auto-loaded files isn't guaranteed there.
]]

local SUFFIX = ""

function load(mod_id)
	local mcm = _G["dorn_mcm" .. SUFFIX]
	local dbg = _G["dorn_dbg" .. SUFFIX]
	local sys = _G["dorn_sys" .. SUFFIX]
	sys.set_deps(mcm, dbg)
	if mod_id then
		sys.reset_mod(mod_id)
		dbg.clear_source(mod_id)
	end
	printf("[DORN] %s: common loaded (vendored)", tostring(mod_id))
	return { mcm = mcm, dbg = dbg, sys = sys }
end
