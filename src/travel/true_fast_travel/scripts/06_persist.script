-- True Fast Travel: Journey save/load and clear.
-- Loaded automatically before main.script (zzzz_dogma_travel_true_fast_travel_main.script)

-- ============================================================
-- 1. Persistence Logic
-- ============================================================
-- Shared dft globals (Anomaly isolates zzz_* script environments)
local tft = _G.tft
local function save(pos, lvid, gvid, final_gvid)
    local actor = db.actor
    if not actor then return end
    save_var(actor, tft_save_vars.traveling,  true)
    save_var(actor, tft_save_vars.dest_x,     pos.x)
    save_var(actor, tft_save_vars.dest_y,     pos.y)
    save_var(actor, tft_save_vars.dest_z,     pos.z)
    if tft.dest_raw_pos then
        save_var(actor, tft_save_vars.dest_raw_x, tft.dest_raw_pos.x)
        save_var(actor, tft_save_vars.dest_raw_y, tft.dest_raw_pos.y)
        save_var(actor, tft_save_vars.dest_raw_z, tft.dest_raw_pos.z)
    end
    save_var(actor, tft_save_vars.dest_lvid,  lvid)
    save_var(actor, tft_save_vars.dest_gvid,  gvid)
    save_var(actor, tft_save_vars.final_gvid, final_gvid or false)
    save_var(actor, tft_save_vars.cost,       tft.journey_cost or 0)
    save_var(actor, tft_save_vars.dot_count,  tft.dot_count or 12)
    save_var(actor, tft_save_vars.stats_amb,  tft.stats_ambushes or 0)
    local progress_ratio = 0
    if tft.travel_dist and tft.travel_dist > 0 then
        progress_ratio = math.max(0, math.min((tft.current_dist or 0) / tft.travel_dist, 1.0))
    end
    save_var(actor, tft_save_vars.progress_ratio, progress_ratio)
    if tft.final_pos then
        save_var(actor, tft_save_vars.final_x, tft.final_pos.x)
        save_var(actor, tft_save_vars.final_y, tft.final_pos.y)
        save_var(actor, tft_save_vars.final_z, tft.final_pos.z)
        save_var(actor, tft_save_vars.final_lvid, tft.final_lvid or 0)
    end
end

local function clear()
  local actor = db.actor
    if not actor then return end

    -- v2.0.8: Reset runtime travel flag (closes double-click race window)
    tft.is_traveling = false
    tft_set_fft_trip_in_progress(false)
    tft.ambush_pending = false
    tft.ambush_stop_ratio = nil
    tft.ambush_kind = nil
    tft.journey_start_health = nil
    if tft_clear_ambush_range_circle then tft_clear_ambush_range_circle() end
    if _G.tft_coarse_nav_clear_display then pcall(_G.tft_coarse_nav_clear_display) end
    -- Keep ambush dir minimap pin alive across clear(); its own timer removes it.
    -- NOTE: target_stamina deliberately survives clear() - it needs to keep holding
    -- through the post-arrival safety window (up to ~90s after the journey itself ends).
    -- It only resets at the start of the next journey (tft_start_travel_sequence).

    save_var(actor, tft_save_vars.traveling,  false)
    save_var(actor, tft_save_vars.final_gvid, false)
    save_var(actor, tft_save_vars.cost,       0)
    save_var(actor, tft_save_vars.dot_count,  12)
    save_var(actor, tft_save_vars.stats_amb,  0)
    save_var(actor, "tlra_ig", nil)  -- legacy guided-journey key
    tft.stats_ambushes = 0
    save_var(actor, tft_save_vars.final_x, nil)
    save_var(actor, tft_save_vars.final_y, nil)
    save_var(actor, tft_save_vars.final_z, nil)
    save_var(actor, tft_save_vars.final_lvid, nil)
    save_var(actor, "tlra_nx", nil)  -- legacy next-hop keys
    save_var(actor, "tlra_ny", nil)
    save_var(actor, "tlra_nz", nil)
    save_var(actor, "tlra_nl", nil)
    save_var(actor, "tlra_ng", nil)
    save_var(actor, "tlra_n_dx", nil)
    save_var(actor, "tlra_n_dy", nil)
    save_var(actor, "tlra_n_dz", nil)
    save_var(actor, tft_save_vars.dest_raw_x, nil)
    save_var(actor, tft_save_vars.dest_raw_y, nil)
    save_var(actor, tft_save_vars.dest_raw_z, nil)
    save_var(actor, tft_save_vars.progress_ratio, nil)

    tft.start_pos = nil
    tft.dest_pos = nil
    tft.dest_lvid = nil
    tft.dest_gvid = nil
    tft.final_gvid = nil
    tft.final_pos = nil
    tft.final_lvid = nil
    tft.travel_dist = 0
    tft.current_dist = 0
    tft.start_game_time = nil
    tft.expected_duration = nil
    tft.encumbrance_time_mult = 1.0
    tft.encumbrance_speed_mult = 1.0
    tft.is_transition = false
    tft.journey_cost = 0
    tft.travel_mode = "normal"
    tft.encounters_avoided = 0
    tft.arrival_forced_ambushes = 0
    tft.arrival_short_m = 0
    tft.ambush_targets = nil
    tft.arrival_ambush_targets = nil
    tft.emission_interrupt_ratio = nil
    tft.emission_time_jump_secs = nil
    tft.emission_interrupt_pending = false
    tft.dot_count = 0
    pcall(tft_cleanup_dots)  -- prevent alife dot leaks
    tft.path_chain = nil
    tft.path_chain_is_vertex = nil
    tft.path_chain_meta = nil
    tft.dot_positions = {}
    tft.dot_ids = {}
    tft.dot_done = {}
    tft.dot_path_ratio = {}
    tft.pending_dot_cleanup = nil
    tft.is_path_preview = false
    tft.path_preview_id = nil
    tft.last_encounter_check = 0
    tft.dest_raw_pos = nil
end

local function load()
  local actor = db.actor
    if not actor then return nil end
    if not load_var(actor, tft_save_vars.traveling, false) then return nil end

    tft.journey_cost = load_var(actor, tft_save_vars.cost, 0)
    tft.dot_count = load_var(actor, tft_save_vars.dot_count, 12)
    tft.stats_ambushes = load_var(actor, tft_save_vars.stats_amb, 0)

    if load_var(actor, tft_save_vars.dest_raw_x) then
        tft.dest_raw_pos = vector():set(
            load_var(actor, tft_save_vars.dest_raw_x, 0),
            load_var(actor, tft_save_vars.dest_raw_y, 0),
            load_var(actor, tft_save_vars.dest_raw_z, 0)
        )
    else
        tft.dest_raw_pos = nil
    end

    local pos = vector():set(
        load_var(actor, tft_save_vars.dest_x, 0),
        load_var(actor, tft_save_vars.dest_y, 0),
        load_var(actor, tft_save_vars.dest_z, 0)
    )
    local f_pos = nil
    if load_var(actor, tft_save_vars.final_x) then
        f_pos = vector():set(
            load_var(actor, tft_save_vars.final_x, 0),
            load_var(actor, tft_save_vars.final_y, 0),
            load_var(actor, tft_save_vars.final_z, 0)
        )
    end
    return pos,
           load_var(actor, tft_save_vars.dest_lvid,  0),
           load_var(actor, tft_save_vars.dest_gvid,  0),
           load_var(actor, tft_save_vars.final_gvid, false),
           f_pos,
           load_var(actor, tft_save_vars.final_lvid, 0),
           load_var(actor, tft_save_vars.progress_ratio, 0)
end

-- Snapshot whatever journey/preview dot PDA IDs are live at save time (engine saves the
-- alife objects regardless; tft.dot_ids is memory-only and empties on load).
-- Ephemeral carriers (coarse mesh overlay, ambush range ring) are released here so they
-- never enter the save — orphan sweep still catches any that slip through.
local function persist_dots(m_data)
    if _G.tft_coarse_nav_clear_display then
        pcall(_G.tft_coarse_nav_clear_display)
    end
    if _G.tft_clear_ambush_range_circle then
        pcall(_G.tft_clear_ambush_range_circle)
    end
    if not (tft.dot_ids and next(tft.dot_ids)) then return end
    local snapshot = {}
    for k, v in pairs(tft.dot_ids) do snapshot[k] = v end
    m_data.tft_pending_dot_ids = snapshot
end

-- Stashes the snapshot for actor_on_first_update's orphan sweep to release once level/alife
-- APIs are actually ready - load_state fires too early in the load sequence to safely touch
-- map spots or alife_release.
local function restore_dots(m_data)
    if m_data and m_data.tft_pending_dot_ids and next(m_data.tft_pending_dot_ids) then
        tft.pending_dot_cleanup = m_data.tft_pending_dot_ids
    end
end

-- tft_publish_to_global
do
    _G.tft_save = save
    _G.tft_clear = clear
    _G.tft_load = load
    _G.tft_persist_dots = persist_dots
    _G.tft_restore_dots = restore_dots
end
