--[[
	Death Report

	Tracks recent hits while alive. On death: Tab toggles a styled hit summary
	(off by default). No camera / spectate.
]]

local CONFIG = _G.dogma_game_death_report_conf

local HIT_WINDOW_MS = 30000
local HIT_CAP_MIN = 1
local HIT_CAP_MAX = 20
local UI_W = 1024
local UI_H = 768
local LINE_H = 18 -- letterica16
local PANEL_PAD = 12
local PANEL_W_MIN = 200
local PANEL_W_MAX = 1024
local PANEL_TOP_MAX = 700
local TAB_PROMPT_Y = math.floor(UI_H * 0.5) + 50
local TITLE_LINES = 2 -- title + blank
local PANEL_TEX = "ui_inGame2_white_rect"
local BHS_DAMAGESCALE = 0.85

local HIT_STATIC = "dogma_death_report_summary"
local TAB_STATIC = "dogma_death_report_prompt"
local PANEL_STATIC = "dogma_death_report_panel"

-- Faithful bone → BHS limb (same ids as damage_location_fix / ADB).
local HITBOX = {
	[14] = "head", [15] = "head", [16] = "head", [17] = "head",
	[18] = "head", [19] = "head",
	[2] = "torso", [11] = "torso", [12] = "torso", [13] = "torso",
	[20] = "leftarm", [21] = "leftarm", [22] = "leftarm", [23] = "leftarm",
	[24] = "leftarm", [25] = "leftarm", [26] = "leftarm", [27] = "leftarm",
	[28] = "leftarm", [29] = "leftarm", [30] = "leftarm", [31] = "leftarm",
	[32] = "leftarm",
	[33] = "rightarm", [34] = "rightarm", [35] = "rightarm", [36] = "rightarm",
	[3] = "leftleg", [4] = "leftleg", [5] = "leftleg", [6] = "leftleg",
	[7] = "rightleg", [8] = "rightleg", [9] = "rightleg", [10] = "rightleg",
}

-- ADB body-part multipliers (used only when estimating via get_protection).
local HITBOX_MULT = {
	["head"] = 0.8,
	["torso"] = 0.9,
	["leftarm"] = 0.85,
	["rightarm"] = 0.85,
	["leftleg"] = 0.85,
	["rightleg"] = 0.85,
}

local LIMB_DISPLAY = {
	["head"] = "Head",
	["torso"] = "Torso",
	["leftarm"] = "Left Arm",
	["rightarm"] = "Right Arm",
	["leftleg"] = "Left Leg",
	["rightleg"] = "Right Leg",
	["body"] = "Body",
	["legs"] = "Legs",
}

-- Anomaly community colors (same keys as stalker_id / PDA factions).
local COMM_RGB = {
	stalker = {255, 200, 60},
	bandit = {255, 170, 40},
	csky = {80, 190, 220},
	army = {70, 160, 70},
	freedom = {90, 200, 80},
	dolg = {220, 50, 50},
	ecolog = {180, 210, 70},
	killer = {90, 110, 200},
	monolith = {255, 140, 40},
	zombied = {140, 170, 70},
	renegade = {180, 70, 70},
	greh = {160, 40, 40},
	isg = {140, 140, 150},
	actor = {255, 255, 255},
}

local KIND_RGB = {
	stalker = {255, 196, 96},
	monster = {255, 118, 96},
	world = {150, 210, 230},
}

local TYPE_INFO = {
	bullet = { label = "Gun", rgb = {220, 190, 110} },
	tear = { label = "Claws", rgb = {220, 80, 70} },
	impact = { label = "Strike", rgb = {186, 186, 196} },
	burn = { label = "Fire", rgb = {255, 140, 40} },
	explosion = { label = "Explosion", rgb = {255, 200, 50} },
	radiation = { label = "Radiation", rgb = {80, 220, 90} },
	psy = { label = "Psy", rgb = {180, 100, 255} },
	chemical = { label = "Chemical", rgb = {80, 210, 160} },
	electric = { label = "Electric", rgb = {90, 170, 255} },
	bleed = { label = "Bleed", rgb = {190, 48, 56} },
	unknown = { label = "Melee", rgb = {170, 170, 170} },
}

local COL = {
	title = "%c[255,255,214,140]",
	white = "%c[255,255,255,255]",
	red = "%c[255,255,72,72]",
	orange = "%c[255,255,160,48]",
	muted = "%c[255,180,180,180]",
	dim = "%c[255,110,110,110]",
}

-- Engine hit.type → TYPE_INFO key.
local TYPE_KEY = {}

local hits = {} -- newest at index 1
local death_armed = false
local report_visible = false
local last_toggle_ms = 0
local frozen = nil -- { lines, footer }
local adb_wrapped = false
local bhs_rd_wrapped = false

-- BHS limb keys → summary labels. Limb HP is points, not 0-1; percent needs maxhp.
local DIED_LIMBS = {
	{ key = "head", label = "Head" },
	{ key = "torso", label = "Torso" },
	{ key = "leftarm", label = "L Arm" },
	{ key = "rightarm", label = "R Arm" },
	{ key = "leftleg", label = "L Leg" },
	{ key = "rightleg", label = "R Leg" },
}

-- Cached live BHS tables (same refs Medik / campfire use).
local bhs_health, bhs_timedhp, bhs_maxhp
-- Running limb points from recorded hits (BHS tables are often still full at death).
local limb_pts = {}
local limb_max_pts = {}

local function log(msg)
	if CONFIG.loaded.debug_log then
		dogma.dbg.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function clamp_ui(v, lo, hi, fallback)
	v = tonumber(v) or fallback
	if v < lo then
		return lo
	end
	if v > hi then
		return hi
	end
	return math.floor(v)
end

local function panel_width()
	return clamp_ui(CONFIG.loaded.panel_width, PANEL_W_MIN, PANEL_W_MAX, 410)
end

local function panel_top()
	return clamp_ui(CONFIG.loaded.panel_top, 0, PANEL_TOP_MAX, 270)
end

local function hit_cap()
	return clamp_ui(CONFIG.loaded.hit_cap, HIT_CAP_MIN, HIT_CAP_MAX, 10)
end

local function rgb_code(rgb)
	return string.format("%%c[255,%d,%d,%d]", rgb[1], rgb[2], rgb[3])
end

local function comm_rgb(comm)
	if not comm or comm == "" then
		return KIND_RGB.stalker
	end
	if COMM_RGB[comm] then
		return COMM_RGB[comm]
	end
	local base = comm:match("^([^_]+)")
	return (base and COMM_RGB[base]) or KIND_RGB.stalker
end

local function actor_hp()
	local a = db and db.actor
	if not a then
		return nil
	end
	return tonumber(a.health)
end

local function pct_num(frac)
	if not frac then
		return 0
	end
	local pct = math.floor(frac * 100 + 0.5)
	if pct < 0 then
		return 0
	end
	if pct > 100 then
		return 100
	end
	return pct
end

local function dmg_txt(pct)
	if not pct or pct < 1 then
		return "-<1%"
	end
	return string.format("-%d%%", pct)
end

local function pts_pct(cur, maxv)
	cur = tonumber(cur)
	maxv = tonumber(maxv)
	if not cur or not maxv or maxv <= 0 then
		return 0
	end
	local pct = math.floor((cur / maxv) * 100 + 0.5)
	if pct < 0 then
		return 0
	end
	if pct > 100 then
		return 100
	end
	return pct
end

-- BHS limb points (same formula as damage_location_fix).
local function bhs_limb_points(amount, limb, damagescale)
	damagescale = damagescale or BHS_DAMAGESCALE
	local d = math.ceil((amount * 100) / 11 * damagescale)
	if limb == "head" then
		d = math.ceil((amount * 2 * 100) / 11 * damagescale)
		if d >= 8 then
			d = 7
		end
		return d
	end
	if limb == "torso" and d >= 8 then
		d = 7
	end
	if
		(limb == "leftarm" or limb == "rightarm" or limb == "leftleg" or limb == "rightleg")
		and d >= 4
	then
		d = 3
	end
	return d
end

local function init_type_keys()
	if next(TYPE_KEY) then
		return
	end
	if not hit then
		return
	end
	TYPE_KEY[hit.fire_wound] = "bullet"
	TYPE_KEY[hit.wound] = "tear"
	if hit.wound_2 then
		TYPE_KEY[hit.wound_2] = "tear"
	end
	TYPE_KEY[hit.strike] = "impact"
	TYPE_KEY[hit.explosion] = "explosion"
	TYPE_KEY[hit.burn] = "burn"
	if hit.light_burn then
		TYPE_KEY[hit.light_burn] = "burn"
	end
	TYPE_KEY[hit.shock] = "electric"
	TYPE_KEY[hit.chemical_burn] = "chemical"
	TYPE_KEY[hit.radiation] = "radiation"
	TYPE_KEY[hit.telepatic] = "psy"
end

local function type_key_of(hit_type)
	init_type_keys()
	return TYPE_KEY[hit_type] or "unknown"
end

local function type_info(key)
	return TYPE_INFO[key] or TYPE_INFO.unknown
end

local function limb_key(bone_id)
	if bone_id == 65535 then
		return "body"
	end
	if bone_id == 0 then
		return "legs"
	end
	return HITBOX[bone_id] or "body"
end

local function limb_key_for_mult(bone_id)
	local label = HITBOX[bone_id]
	if not label then
		return "torso"
	end
	return label
end

local function tr(id)
	if not id or id == "" then
		return nil
	end
	local s = game.translate_string and game.translate_string(id)
	if s and s ~= "" and s ~= id then
		return s
	end
	return nil
end

local function looks_like_id(s)
	if not s or s == "" then
		return true
	end
	if s:find("_", 1, true) then
		return true
	end
	return s:match("^[a-z][a-z0-9]*$") ~= nil
end

local function title_case_words(s)
	return (s:gsub("(%a)([%w]*)", function(a, rest)
		return a:upper() .. rest:lower()
	end))
end

local function humanize_section(sec)
	local s = sec
	s = s:gsub("^zone_mine_", ""):gsub("^zone_", "")
	s = s:gsub("_(weak|normal|strong|veteran|expert|master|novice|experienced|average|special)$", "")
	s = s:gsub("_", " ")
	return title_case_words(s)
end

local function section_nice_name(sec, fallback)
	if not sec or sec == "" then
		return nil
	end
	local named = tr(sec)
	if named then
		return named
	end
	if ui_item and ui_item.get_sec_name then
		local n = ui_item.get_sec_name(sec)
		if n and n ~= "" and n ~= sec and not looks_like_id(n) then
			return n
		end
	end
	if ini_sys and ini_sys.r_string_ex then
		local inv = ini_sys:r_string_ex(sec, "inv_name") or ini_sys:r_string_ex(sec, "inv_name_short")
		named = tr(inv)
		if named then
			return named
		end
		named = tr(ini_sys:r_string_ex(sec, "character_name"))
		if named then
			return named
		end
	end
	if fallback then
		return humanize_section(sec)
	end
	return nil
end

local function community_label(comm)
	if not comm or comm == "" then
		return nil
	end
	return tr("ui_st_" .. comm) or tr("st_" .. comm) or tr(comm) or title_case_words(comm:gsub("_", " "))
end

local function is_actor(obj)
	if not (obj and db.actor) then
		return false
	end
	local ok, id = pcall(function()
		return obj:id()
	end)
	return ok and id == db.actor:id()
end

local function object_section(obj)
	local ok, sec = pcall(function()
		return obj:section()
	end)
	if ok and sec and sec ~= "" then
		return sec
	end
	return nil
end

local function object_char_name(obj)
	local ok, name = pcall(function()
		return obj:character_name()
	end)
	if ok and name and name ~= "" and not looks_like_id(name) then
		return name
	end
	return nil
end

local function weapon_obj(shit, draftsman)
	local wid = shit and shit.weapon_id
	if not wid or wid == 0 or not level or not level.object_by_id then
		return nil
	end
	local ok, obj = pcall(function()
		return level.object_by_id(wid)
	end)
	if not (ok and obj) then
		return nil
	end
	if is_actor(obj) then
		return nil
	end
	if draftsman then
		local ok_id, did = pcall(function()
			return draftsman:id()
		end)
		local ok_oid, oid = pcall(function()
			return obj:id()
		end)
		if ok_id and ok_oid and did == oid then
			return nil
		end
	end
	return obj
end

local function weapon_label(obj)
	if not obj then
		return nil
	end
	return section_nice_name(object_section(obj), false)
end

local function ammo_list_for(obj)
	if not obj then
		return nil
	end
	if utils_item and utils_item.get_ammo then
		local ok, list = pcall(function()
			return utils_item.get_ammo(nil, obj:id())
		end)
		if ok and list and list[1] then
			return list
		end
	end
	local sec = object_section(obj)
	if not (sec and ini_sys and ini_sys.r_string_ex) then
		return nil
	end
	local s = ini_sys:r_string_ex(sec, "ammo_class")
	if not s or s == "" then
		return nil
	end
	local list = {}
	for part in string.gmatch(s, "([^,]+)") do
		local t = part:match("^%s*(.-)%s*$")
		if t and t ~= "" then
			list[#list + 1] = t
		end
	end
	if not list[1] then
		return nil
	end
	return list
end

local function ammo_label(obj)
	if not obj then
		return nil
	end
	if IsMelee and IsMelee(obj) then
		return nil
	end
	if not obj.get_ammo_type then
		return nil
	end
	local list = ammo_list_for(obj)
	if not list then
		return nil
	end
	local ok, idx = pcall(function()
		return obj:get_ammo_type()
	end)
	if not (ok and idx ~= nil) then
		return nil
	end
	local sec = list[idx + 1]
	if not sec then
		return nil
	end
	return section_nice_name(sec, true)
end

local function mutant_weapon(type_key)
	local info = type_info(type_key)
	if info and info.label and info.label ~= "Gun" then
		return info.label
	end
	return "Melee"
end

local function world_source(type_key)
	if type_key == "impact" then
		return "Fall", "impact"
	end
	if type_key == "tear" then
		return "Bleed", "bleed"
	end
	local info = type_info(type_key)
	return info.label, type_key
end

local function source_from_draftsman(draftsman, type_key)
	if not draftsman or is_actor(draftsman) then
		local name, tkey = world_source(type_key)
		return { name = name, kind = "world", type_key = tkey }
	end

	local ok_stalker, is_stalker = pcall(function()
		return IsStalker and IsStalker(draftsman)
	end)
	if ok_stalker and is_stalker then
		local name = object_char_name(draftsman)
		local comm, comm_label
		local ok_c, c = pcall(function()
			return draftsman:character_community()
		end)
		if ok_c then
			comm = c
			comm_label = community_label(c)
		end
		if not name then
			name = comm_label
		end
		if not name then
			local sec = object_section(draftsman)
			name = section_nice_name(sec, true) or "Stalker"
		end
		return { name = name, faction = comm_label, comm = comm, kind = "stalker" }
	end

	local ok_mon, is_mon = pcall(function()
		return IsMonster and IsMonster(draftsman)
	end)
	if ok_mon and is_mon then
		local name = object_char_name(draftsman) or section_nice_name(object_section(draftsman), true)
		return { name = name or "Mutant", kind = "monster" }
	end

	local ok_an, is_an = pcall(function()
		return IsAnomaly and IsAnomaly(draftsman)
	end)
	if ok_an and is_an then
		return {
			name = section_nice_name(object_section(draftsman), true) or "Anomaly",
			kind = "world",
		}
	end

	local name = object_char_name(draftsman) or section_nice_name(object_section(draftsman), true)
	if name then
		return { name = name, kind = "world" }
	end
	local wname, tkey = world_source(type_key)
	return { name = wname, kind = "world", type_key = tkey }
end

local function prune_hits(now)
	now = now or time_global()
	local kept = {}
	for i = 1, #hits do
		local e = hits[i]
		if e and (now - e.t) <= HIT_WINDOW_MS then
			kept[#kept + 1] = e
			if #kept >= hit_cap() then
				break
			end
		end
	end
	hits = kept
end

local function hp_rgb(pct)
	if pct <= 0 then
		return {180, 48, 48}
	end
	if pct <= 25 then
		return {255, 80, 80}
	end
	if pct <= 50 then
		return {255, 160, 48}
	end
	if pct <= 75 then
		return {255, 214, 96}
	end
	return {110, 200, 130}
end

local function body_after_and_dmg(e)
	local before = e.hp_before
	local after = e.hp_after
	local dmg = e.damage or 0
	if before and after and before > after + 0.0005 then
		return after, before - after
	end
	if before then
		return math.max(0, before - dmg), dmg
	end
	return nil, dmg
end

local function format_hit_line(e)
	local hp_after, body_dmg = body_after_and_dmg(e)
	local hp_pct = pct_num(hp_after)
	local body_pct = pct_num(body_dmg)
	local limb = LIMB_DISPLAY[e.limb] or "Body"
	local limb_dmg = e.limb_dmg_pct or 0

	local fac_rgb
	if e.kind == "stalker" then
		fac_rgb = comm_rgb(e.comm)
	else
		fac_rgb = KIND_RGB[e.kind] or KIND_RGB.world
	end
	local fac = rgb_code(fac_rgb)

	local parts = {
		COL.white .. tostring(hp_pct) .. "%",
		COL.red .. "(" .. dmg_txt(body_pct) .. ")",
		COL.white .. limb,
		COL.orange .. "(" .. dmg_txt(limb_dmg) .. ")",
		fac .. (e.name or "?"),
	}
	if e.faction and e.faction ~= "" then
		parts[#parts + 1] = fac .. "(" .. e.faction .. ")"
	end
	if e.weapon and e.weapon ~= "" then
		parts[#parts + 1] = COL.muted .. e.weapon
	end
	if e.ammo and e.ammo ~= "" then
		parts[#parts + 1] = COL.muted .. e.ammo
	end
	return table.concat(parts, " ")
end

local function apply_limb_hit(limb, amount)
	if not (limb == "head" or limb == "torso"
		or limb == "leftarm" or limb == "rightarm"
		or limb == "leftleg" or limb == "rightleg")
	then
		return 0, 0
	end
	local maxp = limb_max_pts[limb] or 11
	if limb_pts[limb] == nil then
		limb_pts[limb] = maxp
	end
	local before = limb_pts[limb]
	local pts = bhs_limb_points(amount or 0, limb)
	local after = before - pts
	if after < 0 then
		after = 0
	end
	limb_pts[limb] = after
	local before_pct = pts_pct(before, maxp)
	local after_pct = pts_pct(after, maxp)
	local dmg_pct = before_pct - after_pct
	if dmg_pct < 0 then
		dmg_pct = 0
	end
	return after_pct, dmg_pct
end

local function push_hit(entry)
	prune_hits(entry.t)
	table.insert(hits, 1, entry)
	while #hits > hit_cap() do
		table.remove(hits)
	end
end

local function actor_already_dead()
	if death_armed then
		return true
	end
	local a = db and db.actor
	if not a then
		return true
	end
	if a.alive and not a:alive() then
		return true
	end
	local hp = tonumber(a.health)
	return hp ~= nil and hp <= 0
end

local function record_hit(shit, bone_id, damage, mitigated_frac)
	if actor_already_dead() then
		return
	end
	if not shit or not damage or damage <= 0 then
		return
	end
	local hit_type = shit.type
	local tkey = type_key_of(hit_type)
	local src = source_from_draftsman(shit.draftsman, tkey)
	if src.kind == "world" and tkey == "tear" then
		tkey = "bleed"
	end
	if src.type_key then
		tkey = src.type_key
	end

	local hp_now = actor_hp()
	local prev = hits[1]
	if prev and prev.hp_before and prev.hp_after == nil then
		prev.hp_after = hp_now
	end

	local limb = limb_key(bone_id)
	local limb_after_pct, limb_dmg_pct = apply_limb_hit(limb, damage)

	local wpn = weapon_obj(shit, shit.draftsman)
	local wpn_name = weapon_label(wpn)
	local ammo = ammo_label(wpn)
	if not wpn_name then
		if src.kind == "monster" then
			wpn_name = mutant_weapon(tkey)
		elseif src.kind == "stalker" and tkey ~= "bullet" then
			if tkey == "tear" or tkey == "impact" then
				wpn_name = "Melee"
			else
				wpn_name = mutant_weapon(tkey)
			end
		end
	end

	push_hit({
		t = time_global(),
		name = src.name,
		faction = src.faction,
		comm = src.comm,
		kind = src.kind,
		limb = limb,
		damage = damage,
		mitigated = math.max(0, math.min(1, mitigated_frac or 0)),
		type_key = tkey,
		weapon = wpn_name,
		ammo = ammo,
		hp_before = hp_now,
		limb_after_pct = limb_after_pct,
		limb_dmg_pct = limb_dmg_pct,
	})
end

-- Match ADB shit_booster printf numbers from the same inputs.
local function estimate_adb_damage(shit, bone_id, k_ap)
	local power = shit.power or 0
	local player_protection = 0
	local premitigation = 0

	local adb = rawget(_G, "grok_actor_damage_balancer")
	if adb and type(adb.get_protection) == "function" then
		local ok, pp, _lim, _ap, _hp, _abv, _hbv, pre = pcall(function()
			return adb.get_protection(shit, bone_id, k_ap or 0)
		end)
		if ok then
			player_protection = tonumber(pp) or 0
			premitigation = tonumber(pre) or 0
		end
	end

	if not (hit and shit.type == hit.fire_wound) then
		premitigation = 0
	end

	if hit and shit.type == hit.fire_wound then
		power = power * 0.8
	elseif hit and shit.type == hit.wound then
		power = power * 0.65
	end

	local key = limb_key_for_mult(bone_id)
	power = power * (HITBOX_MULT[key] or 1.0)

	local remain = (1 - premitigation) * (1 - player_protection)
	local damage = power * remain
	local mitigated = 1 - remain
	return damage, mitigated
end

local function wrap_adb_shit_booster()
	local adb = rawget(_G, "grok_actor_damage_balancer")
	if not (adb and type(adb.shit_booster) == "function") then
		return false
	end
	if adb.__dogma_death_report then
		adb_wrapped = true
		return true
	end

	local orig = adb.shit_booster
	adb.shit_booster = function(shit, bone_id, k_ap)
		if CONFIG.loaded.enabled and shit and (shit.power or 0) > 0 then
			local damage, mitigated = estimate_adb_damage(shit, bone_id, k_ap)
			record_hit(shit, bone_id, damage, mitigated)
		end
		return orig(shit, bone_id, k_ap)
	end
	adb.__dogma_death_report = true
	adb_wrapped = true
	log("wrapped grok_actor_damage_balancer.shit_booster")
	return true
end

local function hud_wnd(name, create)
	local hud = get_hud and get_hud()
	if not hud then
		return nil
	end
	local cs = hud:GetCustomStatic(name)
	if not cs and create then
		hud:AddCustomStatic(name, true)
		cs = hud:GetCustomStatic(name)
	end
	if not cs then
		return nil
	end
	return cs:wnd()
end

local function remove_static(name)
	local hud = get_hud and get_hud()
	if not hud then
		return
	end
	if hud:GetCustomStatic(name) then
		hud:RemoveCustomStatic(name)
	end
end

local function clear_report_ui()
	remove_static(HIT_STATIC)
	remove_static(PANEL_STATIC)
end

local function clear_death_ui()
	clear_report_ui()
	remove_static(TAB_STATIC)
end

local function set_text(name, text, x, y, w, h)
	local wnd = hud_wnd(name, true)
	if not wnd then
		return
	end
	wnd:SetWndPos(vector2():set(x, y))
	if w and h then
		pcall(function()
			wnd:SetWndSize(vector2():set(w, h))
		end)
	end
	pcall(function()
		wnd:SetTextComplexMode(true)
	end)
	local font = GetFontLetterica16Russian and GetFontLetterica16Russian()
	if font then
		pcall(function()
			wnd:SetFont(font)
		end)
	end
	local tc = wnd:TextControl()
	if tc then
		pcall(function()
			tc:SetTextComplexMode(true)
		end)
		if font then
			pcall(function()
				tc:SetFont(font)
			end)
		end
		tc:SetText(text or "")
	end
end

local function show_panel(x, y, w, h)
	local wnd = hud_wnd(PANEL_STATIC, true)
	if not wnd then
		return
	end
	wnd:SetWndPos(vector2():set(x, y))
	wnd:SetWndSize(vector2():set(w, h))
	pcall(function()
		wnd:InitTexture(PANEL_TEX)
	end)
	pcall(function()
		wnd:SetStretchTexture(true)
	end)
	pcall(function()
		wnd:SetTextureColor(GetARGB(175, 8, 8, 10))
	end)
end

local function show_hit_summary()
	if not frozen then
		clear_report_ui()
		return
	end

	local hit_n = frozen.lines and #frozen.lines or 0
	local extra = frozen.footer and 2 or 0
	local n = TITLE_LINES + math.max(hit_n, 1) + extra

	local text_h = n * LINE_H
	local panel_h = text_h + PANEL_PAD * 2
	local panel_w = panel_width()
	local panel_x = 0
	local panel_y = panel_top()
	if panel_y + panel_h > UI_H then
		panel_y = UI_H - panel_h
	end
	if panel_y < 0 then
		panel_y = 0
	end
	local text_x = PANEL_PAD
	local text_y = panel_y + PANEL_PAD
	local text_w = panel_w - PANEL_PAD * 2

	show_panel(panel_x, panel_y, panel_w, panel_h)

	local chunks = {
		COL.title .. "DEATH REPORT",
		"",
	}
	if hit_n == 0 then
		chunks[#chunks + 1] = COL.muted .. "No hits in the last 30 seconds."
	else
		for i = 1, hit_n do
			chunks[#chunks + 1] = frozen.lines[i].text
		end
	end
	if frozen.footer then
		chunks[#chunks + 1] = ""
		chunks[#chunks + 1] = frozen.footer
	end

	set_text(HIT_STATIC, table.concat(chunks, "\\n"), text_x, text_y, text_w, text_h)
end

local function hide_hit_summary()
	clear_report_ui()
end

local function show_tab_prompt()
	local msg
	if report_visible then
		msg = tr("ui_dogma_game_death_report_hide") or "TAB to close death report"
	else
		msg = tr("ui_dogma_game_death_report_prompt") or "TAB to open death report"
	end
	set_text(TAB_STATIC, COL.title .. msg, PANEL_PAD, TAB_PROMPT_Y, UI_W - PANEL_PAD * 2, 28)
end

local function apply_report_visibility()
	if report_visible then
		show_hit_summary()
	else
		hide_hit_summary()
	end
	show_tab_prompt()
end

local function arm_death_ui()
	if not CONFIG.loaded.enabled then
		return
	end
	death_armed = true
	report_visible = false
	show_tab_prompt()
	hide_hit_summary()
	log("death UI armed (report off)")
end

local function tab_dik()
	return (DIK_keys and DIK_keys.DIK_TAB) or 15
end

local function try_toggle_report(dik)
	if not CONFIG.loaded.enabled or not death_armed then
		return false
	end
	if dik ~= tab_dik() then
		return false
	end
	-- Both before_key_press and key_press can fire; debounce so Tab doesn't flip twice.
	local now = time_global()
	if (now - last_toggle_ms) < 200 then
		return true
	end
	last_toggle_ms = now
	report_visible = not report_visible
	apply_report_visibility()
	log(report_visible and "death report shown" or "death report hidden")
	return true
end

-- Limb HP is BHS points — only cur/maxhp is valid.
local function limb_pct_of(cur, maxv)
	cur = tonumber(cur)
	maxv = tonumber(maxv)
	if not cur or not maxv or maxv <= 0 then
		return 0
	end
	local pct = math.floor((cur / maxv) * 100 + 0.5)
	if pct < 0 then
		return 0
	end
	if pct > 100 then
		return 100
	end
	return pct
end

local function tables_are_bhs(health, timedhp, maxhp)
	return type(health) == "table"
		and type(timedhp) == "table"
		and type(maxhp) == "table"
		and health.head ~= nil
		and timedhp.head ~= nil
		and maxhp.head ~= nil
		and tonumber(maxhp.head) ~= nil
end

local function dig_bhs_from_fn(fn, depth)
	if depth > 5 or type(fn) ~= "function" then
		return nil
	end
	if debug.getfenv then
		local env = debug.getfenv(fn)
		if tables_are_bhs(env.health, env.timedhp, env.maxhp) then
			return env.health, env.timedhp, env.maxhp
		end
	end
	local i = 1
	while true do
		local name, val = debug.getupvalue(fn, i)
		if not name then
			break
		end
		if type(val) == "function" then
			local h, t, m = dig_bhs_from_fn(val, depth + 1)
			if h then
				return h, t, m
			end
		elseif name == "health" and type(val) == "table" and val.head ~= nil then
			local timedhp, maxhp
			local j = 1
			while true do
				local n2, v2 = debug.getupvalue(fn, j)
				if not n2 then
					break
				end
				if n2 == "timedhp" then
					timedhp = v2
				elseif n2 == "maxhp" then
					maxhp = v2
				end
				j = j + 1
			end
			if tables_are_bhs(val, timedhp, maxhp) then
				return val, timedhp, maxhp
			end
		end
		i = i + 1
	end
	return nil
end

local function resolve_bhs_tables()
	if tables_are_bhs(bhs_health, bhs_timedhp, bhs_maxhp) then
		return bhs_health, bhs_timedhp, bhs_maxhp
	end

	local mod = rawget(_G, "zzz_player_injuries")
	if type(mod) == "table" then
		if tables_are_bhs(mod.health, mod.timedhp, mod.maxhp) then
			bhs_health, bhs_timedhp, bhs_maxhp = mod.health, mod.timedhp, mod.maxhp
			return bhs_health, bhs_timedhp, bhs_maxhp
		end
		if type(mod.actor_on_update) == "function" then
			local h, t, m = dig_bhs_from_fn(mod.actor_on_update, 0)
			if h then
				bhs_health, bhs_timedhp, bhs_maxhp = h, t, m
				mod.health = h
				mod.timedhp = t
				mod.maxhp = m
				return h, t, m
			end
		end
	end
	return nil
end

-- Permanent `health` can stay at max while `timedhp` is current (HUD).
local function bhs_limb_current(health, timedhp, maxhp, key)
	local hp = tonumber(health and health[key])
	local maxv = tonumber(maxhp and maxhp[key])
	local temp = tonumber(timedhp and timedhp[key])
	if not (hp and maxv and maxv > 0) then
		return nil, maxv
	end
	if hp >= maxv and temp and temp > 0 and temp < maxv then
		return temp, maxv
	end
	return hp, maxv
end

local function init_limb_state()
	local health, timedhp, maxhp = resolve_bhs_tables()
	for i = 1, #DIED_LIMBS do
		local k = DIED_LIMBS[i].key
		local maxv = 11
		local cur = limb_pts[k]
		if maxhp then
			maxv = tonumber(maxhp[k]) or 11
		end
		limb_max_pts[k] = maxv
		if cur == nil then
			local live = bhs_limb_current(health, timedhp, maxhp, k)
			limb_pts[k] = live or maxv
		end
	end
end

local function wrap_bhs_recieved_damage()
	local bhs = rawget(_G, "zzz_player_injuries")
	if not (bhs and type(bhs.recieved_damage) == "function") then
		return false
	end
	if bhs.__dogma_death_report_rd then
		bhs_rd_wrapped = true
		return true
	end
	local orig = bhs.recieved_damage
	bhs.recieved_damage = function(amount, bone_id)
		local result = orig(amount, bone_id)
		local health, timedhp, maxhp = resolve_bhs_tables()
		if health and maxhp then
			for i = 1, #DIED_LIMBS do
				local k = DIED_LIMBS[i].key
				local cur, maxv = bhs_limb_current(health, timedhp, maxhp, k)
				if maxv then
					limb_max_pts[k] = maxv
				end
				-- Trust BHS when it actually dropped; ignore stale 100% at death.
				if cur and maxv and cur < maxv then
					limb_pts[k] = cur
				elseif cur and limb_pts[k] == nil then
					limb_pts[k] = cur
				end
			end
		end
		return result
	end
	bhs.__dogma_death_report_rd = true
	bhs_rd_wrapped = true
	log("wrapped zzz_player_injuries.recieved_damage")
	return true
end

local function format_condition_line()
	init_limb_state()
	local health, timedhp, maxhp = resolve_bhs_tables()

	local parts = { COL.muted .. "Condition  " }
	local any = false
	for i = 1, #DIED_LIMBS do
		local spec = DIED_LIMBS[i]
		local k = spec.key
		local track = pts_pct(limb_pts[k], limb_max_pts[k] or 11)
		local bhs_pct
		if health and maxhp then
			local cur, maxv = bhs_limb_current(health, timedhp, maxhp, k)
			if cur and maxv then
				bhs_pct = limb_pct_of(cur, maxv)
			end
		end
		local pct = track
		if bhs_pct and bhs_pct < 100 and bhs_pct < track then
			pct = bhs_pct
		end
		if i > 1 then
			parts[#parts + 1] = COL.dim .. "   "
		end
		parts[#parts + 1] = rgb_code(hp_rgb(pct or 0)) .. string.format("%s %d%%", spec.label, pct or 0)
		any = true
	end
	if not any then
		return nil
	end
	return table.concat(parts)
end

local function freeze_hit_lines()
	prune_hits()
	local hp_now = actor_hp()
	if hits[1] and hits[1].hp_before and hits[1].hp_after == nil then
		hits[1].hp_after = hp_now
	end
	local lines = {}
	for i = 1, #hits do
		lines[#lines + 1] = { text = format_hit_line(hits[i]) }
	end
	frozen = {
		lines = lines,
		footer = format_condition_line(),
	}
end

local function reset_state()
	hits = {}
	death_armed = false
	report_visible = false
	last_toggle_ms = 0
	frozen = nil
	limb_pts = {}
	limb_max_pts = {}
	clear_death_ui()
end

local function on_option_change()
	CONFIG.loaded.enabled = dogma.mcm.bool(CONFIG.MOD_ID, "enabled")
	CONFIG.loaded.panel_width = dogma.mcm.uint(CONFIG.MOD_ID, "panel_width", 410)
	CONFIG.loaded.panel_top = dogma.mcm.uint(CONFIG.MOD_ID, "panel_top", 270)
	CONFIG.loaded.hit_cap = dogma.mcm.uint(CONFIG.MOD_ID, "hit_cap", 10)
	CONFIG.loaded.debug_log = dogma.dbg.logging()
	if not death_armed then
		prune_hits()
	end
	if not CONFIG.loaded.enabled then
		clear_death_ui()
		death_armed = false
		report_visible = false
	elseif death_armed then
		apply_report_visibility()
	end
end

local function actor_on_before_hit(shit, bone_id, flags)
	if not CONFIG.loaded.enabled then
		return
	end
	if not shit or (shit.power or 0) <= 0 then
		return
	end

	-- When ADB is wrapped, physical hits are recorded in shit_booster.
	-- Still record radiation / other paths that skip shit_booster.
	if adb_wrapped then
		if hit and shit.type == hit.radiation then
			record_hit(shit, bone_id, shit.power, 0)
		end
		return
	end

	record_hit(shit, bone_id, shit.power, 0)
end

local function actor_on_before_death(whoID, flags)
	if not CONFIG.loaded.enabled then
		return
	end

	freeze_hit_lines()
	arm_death_ui()
	log(string.format("before_death hits=%d", frozen and frozen.lines and #frozen.lines or 0))
end

local function GUI_on_show(gui, str2)
	if not CONFIG.loaded.enabled or not death_armed then
		return
	end
	local name = tostring(gui or "") .. " " .. tostring(str2 or "")
	if name:find("game_over", 1, true) or name:find("GameOver", 1, true) then
		apply_report_visibility()
	end
end

local function on_before_key_press(dik, bind, dis, flags)
	if try_toggle_report(dik) then
		if flags then
			flags.ret_value = false
		end
	end
end

local function on_key_press(dik)
	try_toggle_report(dik)
end

local function wrap_hooks()
	wrap_adb_shit_booster()
	wrap_bhs_recieved_damage()
end

local function on_game_load()
	reset_state()
	wrap_hooks()
end

local function actor_on_first_update()
	wrap_hooks()
	init_limb_state()
	on_option_change()
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	init_type_keys()
	wrap_hooks()
	on_option_change()

	RegisterScriptCallback("actor_on_before_hit", actor_on_before_hit)
	RegisterScriptCallback("actor_on_before_death", actor_on_before_death)
	RegisterScriptCallback("on_before_key_press", on_before_key_press)
	RegisterScriptCallback("on_key_press", on_key_press)
	RegisterScriptCallback("GUI_on_show", GUI_on_show)
	RegisterScriptCallback("on_game_load", on_game_load)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("on_option_change", on_option_change)
	log("loaded")
end
