		id = "fix_double_mutant_hits",
		sh = true,
		text = "ui_mcm_menu_dogma_fixes_fix_double_mutant_hits",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_fixes_fix_double_mutant_hits_page_description",
			},
		}),
	})
end
