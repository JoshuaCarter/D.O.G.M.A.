--[[
	DOGMA gameplay/stealth — MCM cache, bush coverage probes, bottom-center visibility gem.
]]

local CONFIG = _G.dogma_gameplay_stealth_conf
local DOGMA

local TINT_MAX = 245
local gem

-- Short horizontal probes: need foliage around the torso, not a glancing brush.
local RQT_STATIC = 2
local BUSH_PROBE_RANGE = 0.50
local BUSH_PROBE_HEIGHT = 0.95
local BUSH_PROBE_INTERVAL_MS = 200
local BUSH_DIRS = {
	{ 1, 0 },
	{ 0.707, 0.707 },
	{ 0, 1 },
	{ -0.707, 0.707 },
	{ -1, 0 },
	{ -0.707, -0.707 },
	{ 0, -1 },
	{ 0.707, -0.707 },
}

local last_bush_probe = 0

local function clamp01(x)
	if x < 0 then
		return 0
	end
	if x > 1 then
		return 1
	end
	return x
end

local function clamp_slider(n, fallback)
	n = tonumber(n)
	if n == nil then
		return fallback
	end
	if n < 0 then
		return 0
	end
	if n > 1 then
		return 1
	end
	return n
end

local function refresh_settings()
	local d = CONFIG.DEFAULTS
	local L = CONFIG.loaded
	if DOGMA and DOGMA.mcm then
		local mid = CONFIG.MOD_ID
		L.scale = clamp_slider(DOGMA.mcm.number(mid, "scale", d.scale), d.scale)
		L.bush_bonus = clamp_slider(DOGMA.mcm.number(mid, "bush_bonus", d.bush_bonus), d.bush_bonus)
		L.cutoff_stand = clamp_slider(DOGMA.mcm.number(mid, "cutoff_stand", d.cutoff_stand), d.cutoff_stand)
		L.cutoff_crouch = clamp_slider(DOGMA.mcm.number(mid, "cutoff_crouch", d.cutoff_crouch), d.cutoff_crouch)
		L.cutoff_prone = clamp_slider(DOGMA.mcm.number(mid, "cutoff_prone", d.cutoff_prone), d.cutoff_prone)
		L.smooth = DOGMA.mcm.bool(mid, "smooth", d.smooth)
		L.icon = DOGMA.mcm.bool(mid, "icon", d.icon)
		L.debug = DOGMA.mcm.bool(mid, "debug", d.debug)
	else
		L.scale = d.scale
		L.bush_bonus = d.bush_bonus
		L.cutoff_stand = d.cutoff_stand
		L.cutoff_crouch = d.cutoff_crouch
		L.cutoff_prone = d.cutoff_prone
		L.smooth = d.smooth
		L.icon = d.icon
		L.debug = d.debug
	end
end

local function on_option_change()
	refresh_settings()
end

local function is_bush_material(name)
	if type(name) ~= "string" then
		return false
	end
	return name:find("bush", 1, true) ~= nil
end

-- Fresh ray each probe — avoids sticky ignore lists / bad leftover state.
-- rqtStatic only: engine material fill on object hits is unsafe on some builds.
local function probe_hits_bush(ox, oy, oz, dx, dz, ignore)
	if not ray_pick then
		return false
	end
	local ok, hit = pcall(function()
		local ray = ray_pick()
		ray:set_flags(RQT_STATIC)
		ray:set_range(BUSH_PROBE_RANGE)
		local pos = vector()
		pos:set(ox, oy, oz)
		local dir = vector()
		dir:set(dx, 0, dz)
		ray:set_position(pos)
		ray:set_direction(dir)
		if ignore then
			ray:set_ignore_object(ignore)
		end
		if not ray:query() then
			return false
		end
		if ray:get_object() then
			return false
		end
		local result = ray:get_result()
		if not result then
			return false
		end
		return is_bush_material(result.material_name)
	end)
	return ok and hit == true
end

local function sample_bush_coverage()
	local actor = db and db.actor
	if not actor then
		return 0
	end
	local ok, pos = pcall(function()
		return actor:position()
	end)
	if not (ok and pos) then
		return 0
	end

	local ox, oy, oz = pos.x, pos.y + BUSH_PROBE_HEIGHT, pos.z
	local hits = 0
	for i = 1, #BUSH_DIRS do
		local d = BUSH_DIRS[i]
		if probe_hits_bush(ox, oy, oz, d[1], d[2], actor) then
			hits = hits + 1
		end
	end
	return hits / #BUSH_DIRS
end

local function update_bush_coverage()
	local now = time_global()
	if now - last_bush_probe < BUSH_PROBE_INTERVAL_MS then
		return
	end
	last_bush_probe = now

	local coverage = 0
	local ok, result = pcall(sample_bush_coverage)
	if ok and type(result) == "number" then
		coverage = result
	end
	if visual_memory_manager and visual_memory_manager.set_bush_coverage then
		visual_memory_manager.set_bush_coverage(coverage)
	end
end

local function ensure_gem()
	local hud = get_hud()
	if not hud then
		return
	end
	local cs = hud:GetCustomStatic("mp_warm_up")
	if cs == nil then
		hud:AddCustomStatic("mp_warm_up", true)
		local xml = CScriptXmlInit()
		xml:ParseFile("ui_dogma_stealth_gem.xml")
		cs = hud:GetCustomStatic("mp_warm_up")
		local w = cs:wnd()
		local pos = w:GetWndPos()
		if pos.x ~= 0 or pos.y ~= 0 then
			pos.x = 0
			pos.y = 0
			w:SetWndPos(pos)
		end
		gem = xml:InitStatic("gem", w)
	elseif not gem then
		-- Custom static already existed (another mod); try to bind our gem once.
		local xml = CScriptXmlInit()
		xml:ParseFile("ui_dogma_stealth_gem.xml")
		gem = xml:InitStatic("gem", cs:wnd())
	end
end

local function update_gem()
	if not (db and db.actor) then
		return
	end
	if not CONFIG.loaded.icon then
		if gem then
			gem:Show(false)
		end
		return
	end

	ensure_gem()
	if not gem then
		return
	end

	gem:Show(true)
	local vis = 0
	if visual_memory_manager and visual_memory_manager.icon_vis then
		vis = visual_memory_manager.icon_vis() or 0
	end
	vis = clamp01(vis)
	local val = TINT_MAX - clamp(TINT_MAX * vis, 0, TINT_MAX)
	gem:SetTextureColor(GetARGB(255, 255 - val, 255 - val, 255 - val))

	if CONFIG.loaded.debug and actor_menu and actor_menu.set_msg then
		local cutoff = visual_memory_manager.icon_cutoff and visual_memory_manager.icon_cutoff() or 0
		local out = visual_memory_manager.icon_out and visual_memory_manager.icon_out() or 0
		local bush = visual_memory_manager.icon_bush and visual_memory_manager.icon_bush() or 0
		actor_menu.set_msg(
			1,
			string.format("Stealth vis=%.2f bush=%.2f cutoff=%.2f out=%.2f", vis, bush, cutoff, out),
			0
		)
	end
end

local function on_actor_update()
	if not DOGMA.sys.ready(CONFIG.MOD_ID, db, on_option_change) then
		return
	end
	update_bush_coverage()
	update_gem()
end

function on_game_start()
	DOGMA = dogma_common.load(CONFIG.MOD_ID)
	refresh_settings()
	RegisterScriptCallback("actor_on_update", on_actor_update)
	RegisterScriptCallback("on_option_change", on_option_change)
end
