<string_table>
	<string id="ui_mcm_menu_dogma_zoom">
		<text>Zoom</text>
	</string>
	<string id="ui_mcm_menu_dogma_zoom_free_zoom">
		<text>Free Zoom</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_zoom_description">
		<text>Free zoom lets you zoom your view with the options below. No effect while ADS (ADS Zoom handles that). Cannot free zoom while sprinting or using items. Replaces GAMMA/Kute/SlowVibe Free Zoom (their MCM and zoom have no effect while this is installed  -  keep DOGMA below them in the load order).</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_ads_description">
		<text>ADS zoom by Irons / Sights / Scopes (FOV + HUD; caps 15 / 25 / 40; 0 = off). Magnified scopes keep their own world FOV; Scopes still sets HUD. Free zoom clears on ADS; ADS clears when you leave ADS (including reload). Replaces Adjustable Scope View and similar ADS FOV mods (their MCM and zoom have no effect while this is installed  -  keep DOGMA below them in the load order).</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_ads_enabled">
		<text>Enable ADS zoom</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_ads_enabled_desc">
		<text>Extra zoom while aiming, by Irons / Sights / Scopes.</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_enabled">
		<text>Enable free zoom</text>
	</string>
	<string id="ui_mcm_dogma_free_zoom_enabled_desc">
		<text>Zoom without aiming. Off while sprinting, using items, or ADS with a magnified scope.</text>
	</string>
