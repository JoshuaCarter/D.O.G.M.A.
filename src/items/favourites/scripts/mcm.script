--[[
	Favourites — MCM

	Injects Favourite / Junk keybinds into SortingPlus's own MCM page
	(stock hardcoded K / J). Keeps a short D.O.G.M.A. info page for persistence.
]]

local CONFIG = _G.dogma_items_favourites_conf

local function dik_or(fallback)
	return (DIK_keys and DIK_keys[fallback]) or -1
end

local function find_gr_child(gr, id)
	if not gr then
		return nil
	end
	for i = 1, #gr do
		if gr[i].id == id then
			return gr[i], i
		end
	end
	return nil
end

local function inject_keybinds(tree)
	if not tree or tree.id ~= "SortingPlus" or type(tree.gr) ~= "table" then
		return
	end
	if find_gr_child(tree.gr, "key_favorite") then
		return
	end

	-- After putallfavs (end of fav/junk block); else after iconfavs; else append.
	local _, at_i = find_gr_child(tree.gr, "putallfavs")
	if not at_i then
		_, at_i = find_gr_child(tree.gr, "iconfavs")
	end
	local at = at_i and (at_i + 1) or (#tree.gr + 1)

	table.insert(tree.gr, at, { id = "divider_dogma_fav_keys", type = "line" })
	table.insert(tree.gr, at + 1, {
		id = "key_favorite",
		type = "key_bind",
		val = 2,
		def = dik_or("DIK_K"),
	})
	table.insert(tree.gr, at + 2, {
		id = "key_junk",
		type = "key_bind",
		val = 2,
		def = dik_or("DIK_J"),
	})
end

local function inject_into_options(options)
	if not options then
		return
	end
	for i = 1, #options do
		if options[i].id == "SortingPlus" then
			inject_keybinds(options[i])
		end
	end
end

local function wrap_sortingplus_on_mcm_load()
	local sp = rawget(_G, "zzz_rax_sortingplus_mcm")
	if not (sp and type(sp.on_mcm_load) == "function") then
		return
	end
	if sp._dogma_fav_keys_mcm then
		return
	end
	local orig = sp.on_mcm_load
	sp.on_mcm_load = function(...)
		local tree, name = orig(...)
		if tree then
			inject_keybinds(tree)
		end
		return tree, name
	end
	sp._dogma_fav_keys_mcm = true
end

-- Top-level: all *mcm.script modules exist before any on_mcm_load runs.
wrap_sortingplus_on_mcm_load()

function on_mcm_load(options)
	wrap_sortingplus_on_mcm_load()
	inject_into_options(options)

	dogma_mcm.attach(options, "items", "ui_mcm_menu_dogma_items", {
		id = "favourites",
		sh = true,
		text = "ui_mcm_menu_dogma_items_favourites",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_items_favourites_page_description",
			},
		}),
	})
end
