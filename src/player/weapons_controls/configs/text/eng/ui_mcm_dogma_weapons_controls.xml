<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_player">
		<text>Player</text>
	</string>
	<string id="ui_mcm_menu_dogma_player_weapons_controls">
		<text>Weapons Controls</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_page_description">
		<text>Keys mirror Settings - Controls, except Pistol and RF Scanner. Melee draws a knife from melee or vision. Pistol draws a pistol from those slots. Binoculars swaps the two holsters. Detector / Geiger / RF put devices in the detector slot.</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_auto_bolt_on_detector">
		<text>Draw bolt with detector</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_auto_bolt_on_detector_desc">
		<text>Draws your bolt when you draw an artefact detector (not RF or Geiger).</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_primary_key">
		<text>Primary weapon</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_primary_key_desc">
		<text>Same as Weapon 3.</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_secondary_key">
		<text>Secondary weapon</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_secondary_key_desc">
		<text>Same as Weapon 2.</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_tertiary_key">
		<text>Draw pistol</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_tertiary_key_desc">
		<text>Always draws a pistol from melee or vision (swaps if needed).</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_melee_key">
		<text>Draw melee</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_melee_key_desc">
		<text>Always draws a knife from melee or vision (swaps if needed).</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_grenade_key">
		<text>Equip grenade</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_grenade_key_desc">
		<text>Same as Grenade.</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_grenade_throw_key">
		<text>Grenade quick throw</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_grenade_throw_key_desc">
		<text>Same as Grenade quick-throw.</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_vision_key">
		<text>Draw binoculars</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_vision_key_desc">
		<text>Swaps melee and vision, then draws melee.</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_bolt_key">
		<text>Equip bolt</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_bolt_key_desc">
		<text>Same as Bolt.</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_key_detector">
		<text>Equip detector</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_key_detector_desc">
		<text>Puts an artefact detector in the detector slot. Press again to put away.</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_key_geiger">
		<text>Equip geiger</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_key_geiger_desc">
		<text>Puts a geiger in the detector slot. Press again to put away.</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_key_radio">
		<text>Equip RF scanner</text>
	</string>
	<string id="ui_mcm_dogma_weapons_controls_key_radio_desc">
		<text>Puts an RF receiver in the detector slot. Press again to put away.</text>
	</string>
</string_table>
