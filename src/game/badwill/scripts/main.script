--[[
	Witnessed hits/kills: write personal goodwill on same-faction stalkers.
	ForceSet already subtracts faction/community, so 3000 Duty is not the block.
	First seen hit parks general_goodwill at -40 (no longer friend).
	2.0 lethals, 2 murders, or 5 witnessed hits slams -9000 (enemy / red).
	Hit count exists because armor flattens shit.power near 0; damage alone would
	never reach the slam threshold on armored targets even after many real hits.
	Red only: inject actor via xcombat.disclose_enemy AND bias selection via
	xcombat.set_hit_redirect (memory alone loses selection to anyone currently seen).
	must_see (default on): backshots with no lookers stay unseen.
	Park never downgrades an already-enemy NPC back to yellow.
	killer on npc_on_death_callback can be nil/wrong; a kill still counts if the
	actor hit that npc within the last ACTOR_HIT_WINDOW_MS.
	Hit power comes from on_before_hit_after_calcs (npc_on_before_hit has power=0).
	Steal (steal.script) slams through slam_npcs / track_agrod; sleep decays both.
]]

local CONFIG = _G.dogma_game_badwill_conf
local xcombat = dogma.xlibs.xcombat

local WITNESS_M = 40
local COMBAT_ALERT_M = 50
local PARK_GW = -40
local SLAM_GW = -9000
local DECAY_PERSONAL = 2000
local SAVE_KEY = "dogma_badwill"
local ACTOR_HIT_WINDOW_MS = 3000
local SLAM_HITS = 5
local HIT_REDIRECT_MAX = 1500
local HIT_REDIRECT_FALLOFF = 60

local SKIP_COMM = {
	zombied = true,
	arena_enemy = true,
	trader = true,
}

local faction_memory = {}
local last_actor_hit = {}

local function log(msg)
	if dogma.log.logging() then
		dogma.log.log(CONFIG.MOD_ID, tostring(msg))
	end
end

local function enabled()
	return dogma.mcm.bool(CONFIG.MOD_ID, "enabled", CONFIG.DEFAULTS.enabled)
end

local function steal_enabled()
	return dogma.mcm.bool(CONFIG.MOD_ID, "steal_enabled", CONFIG.DEFAULTS.steal_enabled)
end

local function must_see()
	return dogma.mcm.bool(CONFIG.MOD_ID, "must_see", CONFIG.DEFAULTS.must_see)
end

local try_is_player_side = function(obj)
	return obj:has_info("npcx_is_companion")
end

local function is_player_side(obj)
	if not obj then
		return false
	end
	if db.actor and obj:id() == db.actor:id() then
		return true
	end
	local ok, has = pcall(try_is_player_side, obj)
	return ok and has
end

local function is_story(npc)
	if not (npc and get_object_story_id) then
		return false
	end
	local ok, sid = pcall(get_object_story_id, npc:id())
	if not (ok and sid) then
		return false
	end
	if sid == 65535 or sid == 4294967295 or sid == -1 or sid == 0 or sid == "" then
		return false
	end
	return true
end

local function is_trader(npc)
	if not npc then
		return false
	end
	if clsid then
		local ok, c = pcall(npc.clsid, npc)
		if ok and (c == clsid.script_trader or c == clsid.trader) then
			return true
		end
	end
	return dogma.alife.community(npc) == "trader"
end

local function is_excluded(npc)
	if not (npc and IsStalker and IsStalker(npc)) then
		return true
	end
	local ok_alive, alive = pcall(npc.alive, npc)
	if not (ok_alive and alive) then
		return true
	end
	if is_player_side(npc) then
		return true
	end
	local comm = dogma.alife.community(npc)
	if comm and SKIP_COMM[comm] then
		return true
	end
	if is_trader(npc) or is_story(npc) then
		return true
	end
	return false
end

local function is_busy(npc)
	local ok, enemy = pcall(npc.best_enemy, npc)
	return ok and enemy ~= nil
end

local function entry(comm)
	local e = faction_memory[comm]
	if not e then
		e = { damage = 0, hits = 0, murders = 0, agrod_stalker_ids = {} }
		faction_memory[comm] = e
	end
	e.hits = e.hits or 0
	if not e.agrod_stalker_ids then
		e.agrod_stalker_ids = e.witness_ids or {}
		e.witness_ids = nil
	end
	return e
end

local function object_by_id(id)
	local st = db.storage and db.storage[id]
	return st and st.object
end

local function alife_exists(id)
	local sim = alife()
	if sim then
		return sim and sim:object(id) ~= nil
	end
end

local function prune_ids(ids)
	local keep = {}
	for id in pairs(ids or {}) do
		if object_by_id(id) or alife_exists(id) then
			keep[id] = true
		end
	end
	return keep
end

local function parse_id_set(src)
	local ids = {}
	if type(src) ~= "table" then
		return ids
	end
	for k, v in pairs(src) do
		local id = tonumber(k)
		if id and (v == true or v == 1) then
			ids[id] = true
		elseif type(v) == "number" then
			ids[v] = true
		end
	end
	return ids
end

local function track_agrod(comm, ids)
	if not comm or not ids then
		return
	end
	local e = entry(comm)
	if ids[1] ~= nil then
		for i = 1, #ids do
			local id = tonumber(ids[i])
			if id then
				e.agrod_stalker_ids[id] = true
			end
		end
		return
	end
	for k, v in pairs(ids) do
		local id = tonumber(k)
		if id and v then
			e.agrod_stalker_ids[id] = true
		elseif type(v) == "number" then
			e.agrod_stalker_ids[v] = true
		end
	end
end

local try_snap = function(npc)
	return npc:character_name()
end

local function snap(npc, actor)
	local tostr = tostring
	local name = "?"
	local _ok, _name = pcall(try_snap, npc)
	if _ok then name = _name end
	local pers, gen, rel = "?", "?", "?"
	local ok_p, p = pcall(npc.goodwill, npc, actor)
	if ok_p then
		pers = tostr(p)
	end
	local ok_g, g = pcall(npc.general_goodwill, npc, actor)
	if ok_g then
		gen = tostr(g)
	end
	local ok_r, r = pcall(npc.relation, npc, actor)
	if ok_r then
		rel = tostr(r)
	end
	return string.format(
		"%s#%s pers=%s gen=%s band=%s rel=%s",
		name,
		tostr(npc:id()),
		pers,
		gen,
		tostr(dogma.alife.npc_relation_band(npc, actor)),
		rel
	)
end

-- Combat-side state: does the engine actually see the actor / who is its selected
-- enemy / which brain operator is running. Separate from snap() (relation/goodwill)
-- because a red name with the wrong values here is what "stands there, does nothing"
-- looks like from the engine's side.
local function combat_snap(npc, actor)
	local tostr = tostring
	local ok_be, best = pcall(npc.best_enemy, npc)
	local best_id = ok_be and best and best:id()
	return string.format(
		"sees=%s best_enemy=%s op=%s",
		tostr(xcombat.sees and xcombat.sees(npc, actor)),
		tostr(best_id),
		tostr(xcombat.get_operator and xcombat.get_operator(npc))
	)
end

-- Attitude < -150 is enemy / red. enable_memory_object (what disclose_enemy calls) is a
-- pure no-op when the NPC has NO EXISTING visual-memory entry for the actor at all -
-- CVisualMemoryManager::enable() just does a find-and-toggle, it never inserts. disclose_enemy's
-- own fallback for that (make_enemy_visible) is not a real bind on this engine (verified against
-- xray-monolith src: zero occurrences) so its probe is permanently false here and the fallback
-- never runs. Net effect: an NPC who has never once had the actor in view stays permanently
-- unreachable through disclose_enemy alone - exactly "stands there, does not know where the
-- shots come from". make_object_visible_somewhen DOES exist and DOES insert a fresh (not
-- currently-visible) entry via a fictitious add_visible_object when none exists yet - call it
-- first so enable_memory_object has something to toggle. set_hit_redirect then still needs real
-- LOS to fire; this only gets the actor into the candidate pool at all.
local function agro_if_enemy(npc, actor)
	if not (npc and actor) then
		return false
	end
	if dogma.alife.npc_relation_band(npc, actor) ~= "enemy" then
		return false
	end
	if not (xcombat and xcombat.disclose_enemy) then
		log("  agro skip no disclose")
		return false
	end
	pcall(npc.make_object_visible_somewhen, npc, actor)
	xcombat.disclose_enemy(npc, actor)
	if xcombat.set_hit_redirect then
		xcombat.set_hit_redirect(npc, HIT_REDIRECT_MAX, HIT_REDIRECT_FALLOFF)
	end
	log("  agro state " .. combat_snap(npc, actor))
	return true
end

local function slam_npcs(npcs)
	local actor = db.actor
	if not (actor and npcs) then
		return
	end
	for i = 1, #npcs do
		local item = npcs[i]
		local npc = item
		local has_los = true
		if type(item) == "table" then
			npc = item.npc
			if item.has_los == false then
				has_los = false
			end
		end
		if npc and not is_excluded(npc) then
			log("  slam before " .. snap(npc, actor) .. " los=" .. tostring(has_los))
			pcall(npc.force_set_goodwill, npc, SLAM_GW, actor)
			local agro = agro_if_enemy(npc, actor)
			local comm = dogma.alife.community(npc)
			if comm then
				track_agrod(comm, { npc:id() })
			end
			log("  slam after  " .. snap(npc, actor) .. " agro=" .. tostring(agro))
		end
	end
end

-- One LOS/FOV pass. has_los = LOS to the player (no second ray later).
local function collect_witnesses(victim)
	local witnesses = {}
	local was_seen = false
	local pos = victim:position()
	local comm = dogma.alife.community(victim)
	local near = dogma.alife.get_stalkers_near_point(pos, WITNESS_M, comm)
	local actor = db.actor
	if not actor then
		return witnesses, false
	end
	local victim_id = victim:id()
	local count_victim = not must_see()
	for i = 1, #near do
		local npc = near[i]
		if not is_excluded(npc) then
			local is_victim = npc:id() == victim_id
			local saw_victim
			if is_victim and count_victim then
				saw_victim = true
			elseif dogma.alife.npc_is_in_combat(npc, COMBAT_ALERT_M) then
				saw_victim = dogma.alife.npc_has_los_to_stalker(npc, victim, true)
			else
				saw_victim = dogma.alife.npc_has_los_to_stalker(npc, victim, false)
			end
			if saw_victim then
				local has_los = dogma.alife.npc_has_los_to_stalker(npc, actor, false)
				witnesses[#witnesses + 1] = { npc = npc, id = npc:id(), has_los = has_los }
				if has_los or (is_victim and count_victim) then
					was_seen = true
				end
			end
		end
	end
	return witnesses, was_seen
end

local function remember(comm, damage, dead, witnesses)
	local e = entry(comm)
	e.damage = (tonumber(e.damage) or 0) + (tonumber(damage) or 0)
	if dead then
		e.murders = (tonumber(e.murders) or 0) + 1
	else
		e.hits = (tonumber(e.hits) or 0) + 1
	end
	local ids = {}
	for i = 1, #witnesses do
		ids[#ids + 1] = witnesses[i].id
	end
	track_agrod(comm, ids)
	return e
end

-- Armor eats most of shit.power, so a run of witnessed hits can stay under the damage
-- threshold for a long time. Slam on hit count too so "shoot them several times" works
-- against armored targets, not just raw damage.
local function is_slam(mem)
	return (mem.murders or 0) >= 2 or (mem.damage or 0) >= 2 or (mem.hits or 0) >= SLAM_HITS
end

local function apply_writes(mem, witnesses)
	local actor = db.actor
	if not actor then
		return
	end
	local slam = is_slam(mem)
	local park = (mem.murders or 0) >= 1 or (mem.damage or 0) > 0 or (mem.hits or 0) >= 1
	for i = 1, #witnesses do
		local w = witnesses[i]
		local npc = w.npc
		if not (npc and not is_excluded(npc)) then
			log("  skip gone " .. tostring(w.id))
		elseif is_busy(npc) then
			log("  skip busy " .. snap(npc, actor) .. " los=" .. tostring(w.has_los) .. " " .. combat_snap(npc, actor))
		elseif slam then
			slam_npcs({ { npc = npc, has_los = w.has_los } })
		elseif park then
			local ok_gen, gen = pcall(npc.general_goodwill, npc, actor)
			if ok_gen and type(gen) == "number" and gen <= PARK_GW then
				log("  park skip already-hostile " .. snap(npc, actor))
			else
				log("  park before " .. snap(npc, actor) .. " los=" .. tostring(w.has_los))
				pcall(npc.force_set_goodwill, npc, PARK_GW, actor)
				log("  park after  " .. snap(npc, actor))
			end
		end
	end
end

local function on_badwill(victim, damage, dead)
	local tostr = tostring
	if not (enabled() and victim and db.actor) then
		return
	end
	if not (IsStalker and IsStalker(victim)) then
		return
	end
	if is_player_side(victim) then
		return
	end
	local comm = dogma.alife.community(victim)
	if not comm or SKIP_COMM[comm] or is_trader(victim) or is_story(victim) then
		return
	end
	local witnesses, was_seen = collect_witnesses(victim)
	if not was_seen then
		log(string.format(
			"unseen %s dead=%s power=%.2f near=%d must_see=%s",
			tostr(comm),
			tostr(dead),
			tonumber(damage) or 0,
			#witnesses,
			tostr(must_see())
		))
		return
	end
	-- Armor can flatten a real bullet impact to ~0 power; still count it as a witnessed
	-- hit so park/slam track "got shot" and not just "got hurt" (see is_slam / SLAM_HITS).
	local add_dmg = dead and 0 or math.max(0, tonumber(damage) or 0)
	local mem = remember(comm, add_dmg, dead, witnesses)
	local slam = is_slam(mem)
	log(string.format(
		"%s dead=%s lethals=+%.2f murders=%s dmg=%.2f hits=%s witnesses=%d slam=%s must_see=%s",
		comm,
		tostr(dead),
		add_dmg,
		tostr(mem.murders),
		mem.damage,
		tostr(mem.hits),
		#witnesses,
		tostr(slam),
		tostr(must_see())
	))
	apply_writes(mem, witnesses)
end

-- Engine fills shit.power here. npc_on_before_hit is always 0 in this callback set.
local function on_before_hit_after_calcs(shit, target)
	if not (shit and target and shit.draftsman) then
		return
	end
	if not is_player_side(shit.draftsman) then
		return
	end
	local ok_id, id = pcall(target.id, target)
	if ok_id and id then
		last_actor_hit[id] = time_global()
	end
	local power = tonumber(shit.power) or 0
	log(string.format("after_calcs power=%.3f type=%s", power, tostring(shit.type)))
	on_badwill(target, power, false)
end

-- killer can be nil/misattributed on some death paths; fall back to "actor hit this npc
-- moments ago" so a real actor kill is never missed just because the engine drops killer.
local function killed_by_actor(victim, killer)
	if is_player_side(killer) then
		return true
	end
	local ok_id, id = pcall(victim.id, victim)
	if not (ok_id and id) then
		return false
	end
	local t = last_actor_hit[id]
	return t ~= nil and (time_global() - t) <= ACTOR_HIT_WINDOW_MS
end

local function npc_on_death_callback(victim, killer)
	if not victim then
		return
	end
	local ok_id, id = pcall(victim.id, victim)
	local by_actor = killed_by_actor(victim, killer)
	if ok_id and id then
		last_actor_hit[id] = nil
	end
	log(string.format("death id=%s by_actor=%s killer_ok=%s", tostring(ok_id and id), tostring(by_actor), tostring(is_player_side(killer))))
	if not by_actor then
		return
	end
	on_badwill(victim, 0, true)
end

local function has_agrod()
	for _, e in pairs(faction_memory) do
		if e.agrod_stalker_ids and next(e.agrod_stalker_ids) then
			return true
		end
	end
	return false
end

local function should_decay()
	return enabled() or steal_enabled() or has_agrod()
end

local function decay_entry(e)
	e.damage = math.max(0, (tonumber(e.damage) or 0) - 1)
	e.hits = math.max(0, (tonumber(e.hits) or 0) - 1)
	e.murders = math.max(0, (tonumber(e.murders) or 0) - 1)
	local actor = db.actor
	local keep = {}
	for id in pairs(e.agrod_stalker_ids or {}) do
		local npc = object_by_id(id)
		if npc then
			if actor then
				local ok, gw = pcall(npc.goodwill, npc, actor)
				if ok and type(gw) == "number" and gw < 0 then
					local next_gw = math.min(0, gw + DECAY_PERSONAL)
					pcall(npc.set_goodwill, npc, next_gw, actor)
				end
			end
			keep[id] = true
		elseif alife_exists(id) then
			keep[id] = true
		end
	end
	e.agrod_stalker_ids = keep
end

local function actor_on_sleep()
	if not should_decay() then
		return
	end
	for _, e in pairs(faction_memory) do
		decay_entry(e)
	end
	log("sleep decay")
end

local function on_save_state(m_data)
	local dump = {}
	for comm, e in pairs(faction_memory) do
		dump[comm] = {
			damage = tonumber(e.damage) or 0,
			hits = tonumber(e.hits) or 0,
			murders = tonumber(e.murders) or 0,
			agrod_stalker_ids = prune_ids(e.agrod_stalker_ids),
		}
	end
	m_data[SAVE_KEY] = dump
end

local function on_load_state(m_data)
	local type_ = type
	faction_memory = {}
	local dump = m_data and m_data[SAVE_KEY]
	if type_(dump) ~= "table" then
		return
	end
	for comm, e in pairs(dump) do
		if type_(e) == "table" then
			local ids = parse_id_set(e.agrod_stalker_ids)
			if not next(ids) then
				ids = parse_id_set(e.witness_ids)
			end
			faction_memory[comm] = {
				damage = tonumber(e.damage) or 0,
				hits = tonumber(e.hits) or 0,
				murders = tonumber(e.murders) or 0,
				agrod_stalker_ids = ids,
			}
		end
	end
end

CONFIG.is_excluded = is_excluded
CONFIG.is_player_side = is_player_side
CONFIG.is_story = is_story
CONFIG.track_agrod = track_agrod
CONFIG.slam_npcs = slam_npcs
CONFIG.SKIP_COMM = SKIP_COMM

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	RegisterScriptCallback("on_before_hit_after_calcs", on_before_hit_after_calcs)
	RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)
	RegisterScriptCallback("actor_on_sleep", actor_on_sleep)
	RegisterScriptCallback("save_state", on_save_state)
	RegisterScriptCallback("load_state", on_load_state)
	log("loaded")
end
