-- Tactical Compass -- layout constants and tuning.

TC_SCREEN_CENTER = 512
TC_SCREEN_WIDTH = 1024

-- Hardcoded S.T.A.L.K.E.R. 2 strip + vanilla PDA markers.
STYLE = {
	node = "compass_s2",
	compass_width = 360,
	compass_inset = 0,
	marker_offset = 8,
	deadbody_offset = 30,
}

MARKER_SET = {
	node = "markers_vanilla",
	highlight_pad = 6,
}

