function on_mcm_load(options)
	dogma_mcm.attach(options, "crafting", "ui_mcm_menu_dogma_crafting", {
		id = "ammo",
		sh = true,
		text = "ui_mcm_menu_dogma_crafting_ammo",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_crafting_ammo_page_description",
			},
		}),
	})
end
