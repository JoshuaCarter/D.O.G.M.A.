-- zzzz body: ensure GAMMA stats after MCM gather, and again when New Game opens
-- (UIInfoItem is built in Main_Controls — must see GAMMA tables first).
-- Never call ADV from dogma_tooltips_loadout_mcm (MCM gather / surge_manager).
-- Ownership: _G.dogma_ensure_gamma_stats from zzzz_dogma_tooltips_weapons_main.

local function apply_now(force)
	if _G.dogma_tooltips_loadout_apply then
		_G.dogma_tooltips_loadout_apply(force == true)
	elseif _G.dogma_ensure_gamma_stats then
		_G.dogma_ensure_gamma_stats(force == true)
	end
end

local function patch_new_game()
	local cls = ui_mm_faction_select and ui_mm_faction_select.UINewGame
	if not (cls and cls.Main_Controls) then
		return false
	end
	local STATE = _G.__dogma_tooltips_loadout or {}
	_G.__dogma_tooltips_loadout = STATE
	-- _G survives script reload; class methods do not.
	if STATE.wrap_controls and cls.Main_Controls == STATE.wrap_controls then
		return true
	end

	local base_controls = cls.Main_Controls
	local function wrap_controls(self, ...)
		-- Force GAMMA tables before stock builds self.item_info.
		apply_now(true)
		return base_controls(self, ...)
	end
	cls.Main_Controls = wrap_controls
	STATE.wrap_controls = wrap_controls
	return true
end

apply_now(true)
patch_new_game()

function on_game_start()
	apply_now(true)
	patch_new_game()
end
