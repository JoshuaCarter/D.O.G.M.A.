	<string id="ui_mcm_menu_dogma_game_safety_save">
		<text>Safety Save</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_page_description">
		<text>Auto-saves while out of combat after a set time, or after you open inventory, heal to 100%, or recover hunger, thirst, or sleep.</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_enabled">
		<text>Enabled</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_enabled_desc">
		<text>Off stops automatic safety saves.</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_always_min">
		<text>Always save after (min)</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_always_min_desc">
		<text>Save after this many minutes out of combat. 0 = off.</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_event_min">
		<text>Event cooldown (min)</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_event_min_desc">
		<text>Minimum minutes between event saves.</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_show_text">
		<text>Show save text</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_show_text_desc">
		<text>Show the same Game saved message as a quick save.</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_on_inventory">
