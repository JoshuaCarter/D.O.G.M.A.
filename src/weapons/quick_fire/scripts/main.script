--[[
	Quick Fire

	Lets fire / zoom / reload / firemode interrupt the draw animation once a
	fraction of it has played (draw_time_modifier on the weapon section).
]]

local CONFIG = _G.dogma_weapons_quick_fire_conf

local ALLOW = {
	[key_bindings.kWPN_FIRE] = true,
	[key_bindings.kWPN_ZOOM] = true,
	[key_bindings.kWPN_RELOAD] = true,
	[key_bindings.kWPN_FIREMODE_PREV] = true,
	[key_bindings.kWPN_FIREMODE_NEXT] = true,
	[key_bindings.kWPN_FUNC] = true,
	[key_bindings.kCUSTOM21] = true, -- grenade launcher toggle
}

local next_tick = _G.nextTick or function(f, n)
	n = floor(max(n or 1, 1))
	AddUniqueCall(function()
		if n == 1 then
			return f()
		end
		n = n - 1
		return false
	end)
end

local ready = false
local ready_id = nil

local function actor_on_hud_animation_play(anm_table, item)
	if not (item and IsWeapon(item)) then
		return
	end

	ready = false
	ready_id = nil

	local anm = anm_table and anm_table.anm_name
	if not (anm and starts_with(tostring(anm), "anm_show")) then
		return
	end

	local id = item:id()
	local sec = item:section()
	local hud = ini_sys:r_string_ex(sec, "hud")
	local state = item:get_state()
	local length = hud and game.get_motion_length(hud, anm, anm_table.anm_speed) or 500
	local mod = tonumber(ini_sys:r_string_ex(sec, "draw_time_modifier")) or 0.35

	if not (length and state == 1) then
		return
	end

	CreateTimeEvent(CONFIG.MOD_ID, "ready", length / 1000 * mod, function()
		local active = db.actor:active_item()
		if active and active:id() == id and active:get_state() == 1 then
			ready = true
			ready_id = id
		end
		return true
	end, id)

	CreateTimeEvent(CONFIG.MOD_ID, "expire", length / 1000, function()
		ready = false
		ready_id = nil
		return true
	end, id)
end

local function on_before_key_press(key, bind)
	if not (ALLOW[bind] and ready) then
		return
	end

	local active = db.actor:active_item()
	if not (active and IsWeapon(active) and not IsMelee(active)
		and active:id() == ready_id and active:get_state() == 1) then
		return
	end

	active:switch_state(0)
	ready = false
	ready_id = nil

	if bind == key_bindings.kWPN_ZOOM then
		local c = get_console and get_console()
		if c and c.get_bool and c:get_bool("wpn_aim_toggle") then
			level.press_action(key)
		else
			level.hold_action(key)
		end
	else
		next_tick(function()
			level.press_action(key)
			return true
		end)
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_hud_animation_play", actor_on_hud_animation_play)
	RegisterScriptCallback("on_before_key_press", on_before_key_press)
end
