-- Weapons Controls MCM
-- Mirrored binds use dogma_mcm.key_mirror.
-- Tertiary (pistol) and RF are MCM-only — Settings Detector is the artefact scanner.

local CONFIG = _G.dogma_player_weapons_controls_conf

function on_mcm_load(options)
	dogma_mcm.attach(options, "player", "ui_mcm_menu_dogma_player", {
		id = "weapons_controls",
		sh = true,
		text = "ui_mcm_menu_dogma_player_weapons_controls",
		gr = dogma_mcm.with_header({
			{
				id = "page_description",
				type = "desc",
				text = "ui_mcm_dogma_weapons_controls_page_description",
			},
			{
				id = "auto_bolt_on_detector",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["auto_bolt_on_detector"],
				hint = "dogma_weapons_controls_auto_bolt_on_detector",
			},
			{
				id = "lower_bolt_on_detector_unequip",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS["lower_bolt_on_detector_unequip"],
				hint = "dogma_weapons_controls_lower_bolt_on_detector_unequip",
			},
			dogma_mcm.key_mirror("wpn_1", function()
				return key_bindings and key_bindings.kWPN_1
			end):option("melee_key", "dogma_weapons_controls_melee_key"),
			dogma_mcm.key_mirror("wpn_3", function()
				return key_bindings and key_bindings.kWPN_3
			end):option("primary_key", "dogma_weapons_controls_primary_key"),
			dogma_mcm.key_mirror("wpn_2", function()
				return key_bindings and key_bindings.kWPN_2
			end):option("secondary_key", "dogma_weapons_controls_secondary_key"),
			{
				id = "tertiary_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["tertiary_key"],
				hint = "dogma_weapons_controls_tertiary_key",
			},
			dogma_mcm.key_mirror("wpn_4", function()
				return key_bindings and key_bindings.kWPN_4
			end):option("grenade_key", "dogma_weapons_controls_grenade_key"),
			dogma_mcm.key_mirror("custom19", function()
				return key_bindings and key_bindings.kCUSTOM19
			end):option("grenade_throw_key", "dogma_weapons_controls_grenade_throw_key"),
			dogma_mcm.key_mirror("wpn_6", function()
				return key_bindings and key_bindings.kWPN_6
			end):option("bolt_key", "dogma_weapons_controls_bolt_key"),
			dogma_mcm.key_mirror("wpn_5", function()
				return key_bindings and key_bindings.kWPN_5
			end):option("vision_key", "dogma_weapons_controls_vision_key"),
			dogma_mcm.key_mirror("show_detector", function()
				return key_bindings and key_bindings.kDETECTOR
			end):option("key_detector", "dogma_weapons_controls_key_detector"),
			dogma_mcm.key_mirror("custom14", function()
				return key_bindings and key_bindings.kCUSTOM14
			end):option("key_geiger", "dogma_weapons_controls_key_geiger"),
			{
				id = "key_radio",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS["key_radio"],
				hint = "dogma_weapons_controls_key_radio",
			},
		}),
	})
end
