<?xml version="1.0" encoding="windows-1251"?>
<string_table>
	<string id="ui_mcm_menu_dogma_game">
		<text>Game</text>
	</string>
	<string id="ui_mcm_menu_dogma_game_safety_save">
		<text>Safety Save</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_page_description">
		<text>Writes a named manual save (safety_save) while out of combat. Always after the max interval, or after the min cooldown when you open inventory, heal to 100%, eat, or drink. Timers are this load only.</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_always_min">
		<text>Always save after (min)</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_always_min_desc">
		<text>If this many minutes have passed since the last safety_save and you are not in combat, save anyway. 0 = off.</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_event_min">
		<text>Event cooldown (min)</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_event_min_desc">
		<text>Minimum minutes since the last safety_save before an enabled event can trigger a save.</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_show_text">
		<text>Show save text</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_show_text_desc">
		<text>Show the same on-screen "Game saved" message as a quick save.</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_on_inventory">
		<text>Save on inventory open</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_on_inventory_desc">
		<text>After the event cooldown, save when you open inventory.</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_on_heal">
		<text>Save on heal to 100%</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_on_heal_desc">
		<text>After the event cooldown, save when body HP reaches 100%.</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_on_eat">
		<text>Save on eat</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_on_eat_desc">
		<text>After the event cooldown, save when you eat.</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_on_drink">
		<text>Save on drink</text>
	</string>
	<string id="ui_mcm_dogma_game_safety_save_on_drink_desc">
		<text>After the event cooldown, save when you drink.</text>
	</string>
</string_table>
