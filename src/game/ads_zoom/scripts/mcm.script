-- game/ads_zoom conf

_G.dogma_game_ads_zoom_conf = {
	MOD_ID = "dogma/game/ads_zoom",
	DEFAULTS = {
		fov_zoom = 15,
		wads_irons = 15,
		wads_sight = 25,
		wads_scope = 35,
		wads_inc_key = -1,
		wads_dec_key = -1,
		wads_reset_key = -1,
		wads_key_modifier = 0,
		binoculars_zoomed_out = true,
	},
	loaded = {},
}

function on_mcm_load(options)
	local CONFIG = _G.dogma_game_ads_zoom_conf
	local kb_mod = (ui_mcm and ui_mcm.kb_mod_radio) or "radio_h"

	local function ads_track(id, max, hint)
		return {
			id = id,
			type = "track",
			val = 2,
			min = 0,
			max = max,
			step = 1,
			def = CONFIG.DEFAULTS[id],
			hint = hint,
		}
	end

	dogma_mcm.attach(options, "game", "ui_mcm_menu_dogma_game", {
		id = "ads_zoom",
		sh = true,
		text = "ui_mcm_menu_dogma_game_ads_zoom",
		gr = dogma_mcm.with_header({
			{
				id = "ads_description",
				type = "desc",
				text = "ui_mcm_dogma_game_ads_zoom_ads_description",
			},
			{
				id = "binoculars_zoomed_out",
				type = "check",
				val = 1,
				def = CONFIG.DEFAULTS.binoculars_zoomed_out,
				hint = "dogma_game_ads_zoom_binoculars_zoomed_out",
			},
			{
				id = "wads_defaults_header",
				type = "title",
				text = "ui_mcm_dogma_game_ads_zoom_wads_defaults_header",
			},
			ads_track("fov_zoom", 15, "dogma_game_ads_zoom_fov_zoom"),
			ads_track("wads_irons", 15, "dogma_game_ads_zoom_wads_irons"),
			ads_track("wads_sight", 25, "dogma_game_ads_zoom_wads_sight"),
			ads_track("wads_scope", 35, "dogma_game_ads_zoom_wads_scope"),
			{ id = "line_wads_keys", type = "line" },
			{
				id = "wads_keys_header",
				type = "title",
				text = "ui_mcm_dogma_game_ads_zoom_wads_keys_header",
			},
			{
				id = "wads_inc_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS.wads_inc_key,
				hint = "dogma_game_ads_zoom_wads_inc_key",
			},
			{
				id = "wads_dec_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS.wads_dec_key,
				hint = "dogma_game_ads_zoom_wads_dec_key",
			},
			{
				id = "wads_reset_key",
				type = "key_bind",
				val = 2,
				def = CONFIG.DEFAULTS.wads_reset_key,
				hint = "dogma_game_ads_zoom_wads_reset_key",
			},
			{
				id = "wads_key_modifier",
				type = kb_mod,
				val = 2,
				def = CONFIG.DEFAULTS.wads_key_modifier,
				hint = "mcm_kb_modifier",
				content = {
					{ 0, "mcm_kb_mod_none" },
					{ 1, "mcm_kb_mod_shift" },
					{ 2, "mcm_kb_mod_ctrl" },
					{ 3, "mcm_kb_mod_alt" },
				},
			},
		}),
	})
end
