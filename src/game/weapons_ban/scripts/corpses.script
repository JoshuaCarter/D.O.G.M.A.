--[[
    Weapons Ban — corpse ammo.

    Strip loose ammo, then one rank RU budget split across kept guns.
]]

local CONFIG = _G.dogma_game_weapons_ban_conf
local MOD_ID = CONFIG.MOD_ID

local Tiers
local original_try_spawn_ammo
local hooked_ammo = false
local PENDING_ROLLS_KEY = "dogma_wb_pending_rolls"
local pending_rolls = {}

local function log(msg, color)
    dogma.log.log(MOD_ID, tostring(msg), color)
end

local function roll_id(id)
    return tonumber(id) or id
end

local function queue_roll(id, msg, color)
    id = roll_id(id)
    if not id then
        return
    end
    local list = pending_rolls[id]
    if not list then
        list = {}
        pending_rolls[id] = list
    end
    list[#list + 1] = { tostring(msg), color }
end

local function flush_roll(id)
    id = roll_id(id)
    if not id then
        return
    end
    local list = pending_rolls[id] or pending_rolls[tostring(id)]
    if not list then
        return
    end
    pending_rolls[id] = nil
    pending_rolls[tostring(id)] = nil
    for i = 1, #list do
        local row = list[i]
        log(row[1], row[2])
    end
end

_G.dogma_wb_queue_roll = queue_roll
_G.dogma_wb_flush_roll = flush_roll

local function npc_label(npc)
    if not npc then
        return "?"
    end
    local name = npc.name and npc:name()
    if name and name ~= "" then
        return name
    end
    return (npc.section and npc:section()) or "?"
end

local function pick_ammo(ammo_list)
    if not ammo_list then
        return nil
    end
    local ok = {}
    for i = 1, #ammo_list do
        local s = ammo_list[i]
        if dogma.db.is_ammo(s) then
            ok[#ok + 1] = s
        end
    end
    if #ok > 0 then
        return ok[math.random(1, #ok)]
    end
    return nil
end

local function release_inventory_ids(ids)
    for i = 1, #ids do
        local id = ids[i]
        if id and alife_object(id) then
            alife_release_id(id)
        end
    end
end

local function strip_loose_ammo(npc)
    local to_release = {}
    npc:iterate_inventory(function(_temp, item)
        if not item then
            return
        end
        local sec = item:section()
        local id = item:id()
        if not (id and alife_object(id)) then
            return
        end
        if dogma.db.is_ammo(sec) then
            to_release[#to_release + 1] = id
        end
    end)
    release_inventory_ids(to_release)
end

local function npc_rank_name(npc)
    if not (npc and ranks and ranks.get_obj_rank_name) then
        return nil
    end
    local ok, name = pcall(ranks.get_obj_rank_name, npc)
    if ok and name and name ~= "" then
        return name
    end
    return nil
end

-- Ammo sections currently loose on the corpse (db boxes only).
local function collect_inventory_ammo_secs(npc)
    local found = {}
    if not (npc and npc.iterate_inventory) then
        return found
    end
    npc:iterate_inventory(function(_temp, item)
        if not item then
            return
        end
        local sec = item:section()
        if dogma.db.is_ammo(sec) then
            found[sec] = true
        end
    end)
    return found
end

-- Ammo types this gun should drop: loaded type + matching inventory ammo.
-- Falls back to a random db ammo_class entry if nothing matched.
local ammo_types_for_gun_anon_1 = function(wpn)
    return wpn:get_ammo_type()
end

local function ammo_types_for_gun(wpn, inv_ammo)
    if not wpn then
        return nil
    end
    local wpn_sec = wpn:section()
    local ammo_list
    if utils_item and utils_item.get_ammo then
        ammo_list = utils_item.get_ammo(wpn_sec, wpn:id())
    end
    if not (ammo_list and #ammo_list > 0) then
        ammo_list = parse_list(ini_sys, wpn_sec, "ammo_class")
    end
    if not (ammo_list and #ammo_list > 0) then
        return nil
    end

    local allowed = {}
    for i = 1, #ammo_list do
        local s = ammo_list[i]
        if dogma.db.is_ammo(s) then
            allowed[s] = true
        end
    end

    local matched = {}
    if wpn.get_ammo_type then
        local ok, idx = pcall(ammo_types_for_gun_anon_1, wpn)
        if ok and idx ~= nil then
            local loaded = ammo_list[idx + 1]
            if loaded and allowed[loaded] then
                matched[loaded] = true
            end
        end
    end
    if inv_ammo then
        for sec, _ in pairs(inv_ammo) do
            if allowed[sec] then
                matched[sec] = true
            end
        end
    end

    local list = {}
    for sec, _ in pairs(matched) do
        list[#list + 1] = sec
    end
    if #list == 0 then
        local fallback = pick_ammo(ammo_list)
        if fallback then
            list[1] = fallback
        end
    end
    if #list == 0 then
        return nil
    end
    return list
end

local function inject_corpse_ammo(npc, inv_ammo)
    local rank = npc_rank_name(npc)
    local gun_ammo = {}
    npc:iterate_inventory(function(_temp, itm)
        if not itm then
            return
        end
        if not dogma.db.is_weapon(itm:section()) then
            return
        end
        if npc.marked_dropped and npc:marked_dropped(itm) then
            return
        end
        if dogma.db.is_melee(itm:section()) then
            return
        end
        local types = ammo_types_for_gun(itm, inv_ammo)
        if types then
            gun_ammo[#gun_ammo + 1] = types
        end
    end)
    if #gun_ammo == 0 then
        return { skip = "no guns", rank = rank }
    end
    local total_ru = Tiers.roll_ru_for_rank(rank)
    if total_ru <= 0 then
        return { skip = "ru 0", rank = rank, guns = #gun_ammo }
    end
    local share = total_ru / #gun_ammo
    local pooled = {}
    for i = 1, #gun_ammo do
        local types = gun_ammo[i]
        local per = share / #types
        for j = 1, #types do
            local sec = types[j]
            pooled[sec] = (pooled[sec] or 0) + per
        end
    end
    local drops = {}
    for sec, ru in pairs(pooled) do
        local rounds = Tiers.rounds_for_ru(sec, ru)
        if rounds > 0 then
            alife_create_item(sec, npc, { ammo = rounds })
            drops[#drops + 1] = string.format("%s x%s (%.0f RU)", sec, rounds, ru)
        end
    end
    return { rank = rank, guns = #gun_ammo, ru = total_ru, drops = drops }
end

local function log_corpse_roll(npc, result)
    local id = npc.id and npc:id()
    local who = npc_label(npc)
    if result.skip then
        if result.skip == "no guns" and not result.rank then
            return
        end
        queue_roll(id, string.format(
            "corpse %s skip %s rank=%s guns=%s",
            who,
            result.skip,
            result.rank or "?",
            result.guns or 0
        ), "gray")
        return
    end
    queue_roll(id, string.format(
        "corpse %s rank=%s guns=%s ru=%s",
        who,
        result.rank or "?",
        result.guns,
        result.ru
    ), "green")
    if #result.drops == 0 then
        queue_roll(id, "  none", "gray")
        return
    end
    for i = 1, #result.drops do
        queue_roll(id, "  + " .. result.drops[i], "green")
    end
end

local patched_try_spawn_ammo_anon_1 = function() CONFIG:load_mcm() end

local function patched_try_spawn_ammo(npc)
    original_try_spawn_ammo(npc)
    if not dogma.sys.ready(MOD_ID, db, patched_try_spawn_ammo_anon_1) then
        return
    end
    if not npc then
        return
    end
    dogma.perf.start("weapons_ban", "try_spawn_ammo")
    -- Snapshot matching ammo before strip so we can reinject the same types.
    local inv_ammo = collect_inventory_ammo_secs(npc)
    strip_loose_ammo(npc)
    log_corpse_roll(npc, inject_corpse_ammo(npc, inv_ammo) or { skip = "no result" })
    if item_weapon and item_weapon.ammo_aggregation_full and CreateTimeEvent then
        CreateTimeEvent(npc:id(), "dogma_wb_ammo_agg", 0, item_weapon.ammo_aggregation_full, npc:id())
    end
    dogma.perf.stop()
end

local function try_hook_ammo()
    if hooked_ammo then
        return
    end
    if not (death_manager and death_manager.try_spawn_ammo) then
        return
    end
    original_try_spawn_ammo = death_manager.try_spawn_ammo
    death_manager.try_spawn_ammo = patched_try_spawn_ammo
    hooked_ammo = true
    log("hooked death_manager.try_spawn_ammo")
end

local function flush_open_loot()
    local gui = ui_inventory and ui_inventory.GUI
    if not (gui and gui.mode == "loot") then
        return
    end
    local partner = gui.GetPartner and gui:GetPartner()
    if partner and partner.id then
        flush_roll(partner:id())
    end
end

local function on_save_state(m_data)
    m_data[PENDING_ROLLS_KEY] = pending_rolls
end

local function on_load_state(m_data)
    pending_rolls = m_data[PENDING_ROLLS_KEY] or {}
end

local on_game_start_anon_1 = function(mode)
    if mode == "loot" then
        flush_open_loot()
    end
end

function on_game_start()
    Tiers = _G.dogma_game_weapons_ban_tiers
    CONFIG:ensure_dogma()
    RegisterScriptCallback("actor_on_first_update", try_hook_ammo)
    RegisterScriptCallback("ActorMenu_on_mode_changed", flush_open_loot)
    RegisterScriptCallback("ActorMenu_on_before_init_mode", on_game_start_anon_1)
    RegisterScriptCallback("save_state", on_save_state)
    RegisterScriptCallback("load_state", on_load_state)
    try_hook_ammo()
    log("corpse ammo: loaded")
end
