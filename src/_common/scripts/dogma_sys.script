--[[
	DOGMA runtime - gate feature logic until deps and config are ready.

	Wired by dogma_common via set_deps(mcm, dbg). Use DOGMA.sys from dogma_common.load().
]]

local _mcm = nil
local _dbg = nil
local loaded_configs = {}

function set_deps(mcm, dbg)
	_mcm = mcm
	_dbg = dbg
end

function ready(mod_id, db, load_fn)
	if not (_mcm and _dbg and db and db.actor) then
		return nil
	end
	if load_fn and not loaded_configs[mod_id] then
		load_fn()
		loaded_configs[mod_id] = true
	end
	return db.actor
end

function reset_mod(mod_id)
	if mod_id then
		loaded_configs[mod_id] = nil
	end
end
