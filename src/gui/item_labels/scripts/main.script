--[[
	Item Labels

	Auto-show hold-Use style item name labels for pickable world items within
	MCM range (0 = no labels, max 10 m). Vanilla hold-Use names stay off
	while enabled so ours do not stack and keep drawing without LoS.
]]

local CONFIG = _G.dogma_gui_item_labels_conf

local UI_XML = "ui_dogma_gui_item_labels.xml"
local LABEL_W = 256
local LABEL_H = 18
local LABEL_HALF_W = LABEL_W * 0.5
local LABEL_HALF_H = LABEL_H * 0.5
local MAX_LABELS = 32
local ALIGN_CENTER = 2 -- CGameFont::alCenter
local UPDATE_DELAY = 250

local HUD = nil
local POS_VEC = vector2()
local name_cache = {}
local can_take_cache = {}
local label_color = nil
local next_scan = 0
-- Cached pickups from last iterate_nearest; projected every frame while non-empty.
local tracked = {}
local tracking = false

-- vanilla PICKUP_INFO_COLOR 0xFFDDDDDD
local function pickup_color()
	if not label_color then
		label_color = GetARGB(255, 221, 221, 221)
	end
	return label_color
end

local function set_vanilla_names(on)
	if not exec_console_cmd then
		return
	end
	local want = on and true or false
	if get_console_cmd and get_console_cmd(1, "g_draw_pickup_item_names") == want then
		return
	end
	exec_console_cmd(on and "g_draw_pickup_item_names 1" or "g_draw_pickup_item_names 0")
end

local function on_option_change()
	CONFIG.loaded.enabled = dogma.mcm.bool(CONFIG.MOD_ID, "enabled")
	CONFIG.loaded.range = dogma.mcm.float(CONFIG.MOD_ID, "range")
	set_vanilla_names(not CONFIG.loaded.enabled)
end

local function pda_shown()
	if not (ActorMenu and ActorMenu.get_pda_menu) then
		return false
	end
	local pda = ActorMenu.get_pda_menu()
	return pda and pda.IsShown and pda:IsShown()
end

local function item_name(sec)
	local cached = name_cache[sec]
	if cached then
		return cached
	end
	local name = nil
	local row = dogma.db.get(sec)
	if row and row.name and row.name ~= "" then
		name = row.name
	end
	if (not name or name == "") and ui_item and ui_item.get_sec_name then
		name = ui_item.get_sec_name(sec)
	end
	if not name or name == "" then
		name = sec
	end
	name_cache[sec] = name
	return name
end

local function section_can_take(sec)
	local cached = can_take_cache[sec]
	if cached ~= nil then
		return cached
	end
	local ok = true
	if ini_sys and ini_sys.r_bool_ex and ini_sys:r_bool_ex(sec, "can_take", true) == false then
		ok = false
	end
	can_take_cache[sec] = ok
	return ok
end

local function can_pickup(obj)
	if not (obj and obj.is_inventory_item and obj:is_inventory_item()) then
		return false
	end
	if obj.parent and obj:parent() then
		return false
	end
	local sec = obj.section and obj:section()
	if not sec or sec == "" or not dogma.db.get(sec) then
		return false
	end
	return section_can_take(sec)
end

local function clear_tracked()
	for i = #tracked, 1, -1 do
		tracked[i] = nil
	end
	tracking = false
end

class "UIItemLabels" (CUIScriptWnd)

function UIItemLabels:__init() super()
	self.xml = CScriptXmlInit()
	self.xml:ParseFile(UI_XML)
	self.labels = {}
	self:EnsureLabels(1)
end

function UIItemLabels:__finalize()
end

function UIItemLabels:EnsureLabels(n)
	if n > MAX_LABELS then
		n = MAX_LABELS
	end
	while #self.labels < n do
		local st = self.xml:InitStatic("label", self)
		local tc = st:TextControl()
		pcall(function()
			tc:SetTextComplexMode(false)
			tc:SetTextAlignment(ALIGN_CENTER)
			tc:SetTextColor(pickup_color())
		end)
		st:Show(false)
		self.labels[#self.labels + 1] = st
	end
end

function UIItemLabels:HideAll()
	for i = 1, #self.labels do
		self.labels[i]:Show(false)
	end
end

function UIItemLabels:ShowAt(i, x, y, text)
	local st = self.labels[i]
	if not st then
		return
	end
	st:SetWndPos(POS_VEC:set(x - LABEL_HALF_W, y - LABEL_HALF_H))
	st:TextControl():SetText(text)
	st:Show(true)
end

local function activate_hud()
	if HUD == nil then
		HUD = UIItemLabels()
		get_hud():AddDialogToRender(HUD)
	end
end

local function deactivate_hud()
	if HUD ~= nil then
		get_hud():RemoveDialogToRender(HUD)
		HUD = nil
	end
	clear_tracked()
end

local function hide_labels()
	if HUD then
		HUD:HideAll()
	end
	clear_tracked()
end

-- Expensive: iterate_nearest + filters. Cadence = UPDATE_DELAY (idle and while tracking).
local function scan_nearby(actor, radius)
	dogma.perf.start("item_labels", "scan")
	clear_tracked()
	local n = 0
	level.iterate_nearest(actor:position(), radius, function(obj)
		if n >= MAX_LABELS then
			return true
		end
		if not can_pickup(obj) then
			return
		end
		n = n + 1
		tracked[n] = { id = obj:id(), sec = obj:section() }
	end)
	tracking = n > 0
	dogma.perf.stop()
	return tracking
end

-- Cheap: object_by_id + range + world2ui for cached ids (every frame while tracking).
local function project_labels(actor, radius)
	dogma.perf.start("item_labels", "draw")
	activate_hud()
	local apos = actor:position()
	local r2 = radius * radius
	local kept = 0
	local shown = 0
	for i = 1, #tracked do
		local e = tracked[i]
		local obj = level.object_by_id and level.object_by_id(e.id)
		if obj and not (obj.parent and obj:parent()) then
			local pos = obj:position()
			local dx = pos.x - apos.x
			local dy = pos.y - apos.y
			local dz = pos.z - apos.z
			if dx * dx + dy * dy + dz * dz <= r2 then
				kept = kept + 1
				tracked[kept] = e
				local ui = game.world2ui(pos)
				if ui and ui.x > -9990 then
					shown = shown + 1
					HUD:EnsureLabels(shown)
					HUD:ShowAt(shown, ui.x, ui.y, item_name(e.sec))
				end
			end
		end
	end
	for i = #tracked, kept + 1, -1 do
		tracked[i] = nil
	end
	for i = shown + 1, #HUD.labels do
		HUD.labels[i]:Show(false)
	end
	tracking = kept > 0
	dogma.perf.stop()
	return tracking
end

function actor_on_net_destroy()
	deactivate_hud()
end

function on_screen_resolution_changed()
	deactivate_hud()
end

local function on_actor_on_update()
	local actor = dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change)
	if not actor then
		return
	end

	local radius = CONFIG.loaded.range
	if not CONFIG.loaded.enabled or type(radius) ~= "number" or radius <= 0 then
		hide_labels()
		next_scan = 0
		return
	end
	if not actor:alive() or pda_shown() then
		hide_labels()
		next_scan = 0
		return
	end

	local tg = time_global()
	local due = tg >= next_scan
	if not tracking and not due then
		return
	end

	if due then
		next_scan = tg + UPDATE_DELAY
		if not scan_nearby(actor, radius) then
			if HUD then
				HUD:HideAll()
			end
			return
		end
	end

	if tracking then
		project_labels(actor, radius)
	end
end

function on_game_start()
	dogma.load(CONFIG.MOD_ID)
	RegisterScriptCallback("actor_on_update", on_actor_on_update)
	RegisterScriptCallback("actor_on_net_destroy", actor_on_net_destroy)
	RegisterScriptCallback("on_screen_resolution_changed", on_screen_resolution_changed)
	RegisterScriptCallback("on_option_change", on_option_change)
end
