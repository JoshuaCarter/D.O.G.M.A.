-- weapons/stripping conf — shared CONFIG for all strip scripts.

local defaults = {
	["dis_weap_attach/enabled"] = false,
	["block_companion_special_items"] = true,
	["disa_safe_equipped"] = true,
	["drop_safe_equipped"] = true,
	["intercept_disassemble"] = true,
	["keep_parts_with_weapon"] = true,
	["key"] = -1,
	["key_all"] = -1,
	["key_all_mode"] = 0,
	["key_all_modifier"] = 0,
	["key_disa"] = -1,
	["key_disa_all"] = -1,
	["key_disa_all_mode"] = 0,
	["key_disa_all_modifier"] = 0,
	["key_disa_mode"] = 0,
	["key_disa_modifier"] = 0,
	["key_drop"] = -1,
	["key_drop_all"] = -1,
	["key_drop_all_mode"] = 0,
	["key_drop_all_modifier"] = 0,
	["key_drop_mode"] = 0,
	["key_drop_modifier"] = 0,
	["key_mode"] = 0,
	["key_modifier"] = 0,
	["pda_stash_on_disassemble"] = true,
}

_G.dogma_weapons_stripping_conf = {
	MOD_ID = "dogma/weapons/stripping",
	defaults = defaults,
	CONFIG = {
		intercept_disassemble = defaults["intercept_disassemble"],
		keep_parts_with_weapon = defaults["keep_parts_with_weapon"],
		pda_stash_on_disassemble = defaults["pda_stash_on_disassemble"],
		drop_safe_equipped = defaults["drop_safe_equipped"],
		disa_safe_equipped = defaults["disa_safe_equipped"],
		attach_enabled = defaults["dis_weap_attach/enabled"],
		block_special_items = defaults["block_companion_special_items"],
	},
}

function _G.dogma_weapons_stripping_conf:ensure_dogma()
	if not self.DOGMA then
		self.DOGMA = dogma_common.load(self.MOD_ID)
	end
	return self.DOGMA
end
