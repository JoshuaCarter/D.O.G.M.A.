--[[
    Last Equip

    Remember the last two watched hand slots. After chosen events, draw
    last_x (PDA included if that slot is watched). After lowering PDA
    (toggle), empty hands restore the slot from before the PDA. Opening
    inventory / loot / trade / talk / craft also holsters the PDA: skip
    that restore and let the menu-close path draw last_x. Already
    holding the target: do not activate_slot (same-slot call holsters
    then draws). If the engine then empties hands, assert once.

    Detector is left-hand show_detector, not active_slot(). Empty RH +
    detector out still reports slot 0, so record SLOT_DEVICE. Restore
    holsters first (engine ToggleDevice otherwise Activate()s knife /
    bolt / pistol), then shows the detector once RH is empty.

    Inv / loot / trade / talk / craft: note open, note closing, restore
    only after closed. Do not touch detector or HUD hands while the
    bag open/close script anim owns them.
]]

local CONFIG = _G.dogma_input_last_equip_conf
local xcreature = dogma.xlibs.xcreature

local SLOT_MELEE = 1
local SLOT_SECONDARY = 2
local SLOT_PRIMARY = 3
local SLOT_GRENADE = 4
local SLOT_VISION = 5
local SLOT_BOLT = 6
local SLOT_PDA = 8
local SLOT_DEVICE = 9
local SLOT_PISTOL = 16
local WATCH_MS = 1000
local HUD_SHOWING = 1
local HUD_HIDING = 2
local HUD_HIDDEN = 3
-- ponytail: bag close length is weight/anim, not a constant. Wait for
-- hud busy to start then end. These are only start-grace and stuck cap.
local BAG_START_MS = 250
local HIDE_STUCK_MS = 8000
local HIDE_WAIT_MS = HIDE_STUCK_MS
local TELEPORT_DIST_SQR = 12 * 12
local SAVE_KEY = "dogma_input_last_equip_slot"
local SAVE_KEY_PREV = "dogma_input_last_equip_slot_prev"

local MODE_TO_KIND = {
    [1] = "inventory",
    [2] = "trade",
    [4] = "loot",
}

local SLOT_OPTS = {
    { id = "slot_primary", slot = SLOT_PRIMARY },
    { id = "slot_secondary", slot = SLOT_SECONDARY },
    { id = "slot_pistol", slot = SLOT_PISTOL },
    { id = "slot_melee", slot = SLOT_MELEE },
    { id = "slot_grenade", slot = SLOT_GRENADE },
    { id = "slot_vision", slot = SLOT_VISION },
    { id = "slot_device", slot = SLOT_DEVICE },
    { id = "slot_pda", slot = SLOT_PDA },
    { id = "slot_bolt", slot = SLOT_BOLT },
}

local SLOT_KB = {
    "kWPN_1",
    "kWPN_2",
    "kWPN_3",
    "kWPN_4",
    "kWPN_5",
    "kWPN_6",
    "kNEXT_SLOT",
    "kPREV_SLOT",
    "kACTIVE_JOBS",
    "kDETECTOR",
    "kCUSTOM25",
}

local EQ_KEY_IDS = { "key_bolt", "key_detector" }

local CRAFT_GUI = {
    UIWorkshop = true,
    UIFurnitureWorkshop = true,
    ui_hf_workshop = true,
}

local slot_watched = {}
local slot_diks = {}
local slot_diks_n = 0

local last_x = nil
local last_xx = nil
local last_seen_slot = nil
local watch_until = nil
local watch_slot = nil
local extra_used = false
local need_load_restore = false
local last_actor_pos = nil
local ui_open = false
local pda_lower_wait = false
local pending_site = nil
local pending_allow_pda = nil
local pending_until = nil
local pending_seen_busy = false
local pending_started = nil
local device_show_sent = false
local seq_t0 = nil

local try_item_in_slot = function(actor, slot)
    return actor:item_in_slot(slot)
end

local try_active_slot = function(actor)
    return actor:active_slot()
end

local try_activate_slot = function(actor, slot)
    actor:activate_slot(slot)
end

local try_active_item = function(actor)
    return actor:active_item()
end

local try_get_state = function(obj)
    return obj:get_state()
end

local try_active_detector = function(actor)
    return actor:active_detector()
end

-- false = anm_show (flap). true = anm_show_fast (stiff rotate).
local try_show_detector = function(actor)
    actor:show_detector(false)
end

local try_hud_motion_allowed = function()
    return game.hud_motion_allowed()
end

local try_position = function(actor)
    return actor:position()
end

local try_bind_to_dik = function(bind)
    return bind_to_dik(bind)
end

local try_scan_stalkers_before_pda = function(se)
    return se:community()
end

local try_scan_stalkers_before_pda_2 = function(IsStalker, npc)
    return IsStalker and IsStalker(npc)
end

local try_npc_name = function(npc)
    return npc:name()
end

local try_npc_sec = function(npc)
    return npc:section()
end

local function log(msg)
    if CONFIG.loaded.debug_log then
        dogma.log.log(CONFIG.MOD_ID, tostring(msg))
    end
end

local function mark_seq()
    seq_t0 = time_global()
end

local function log_ms(msg)
    local tostr = tostring
    if not CONFIG.loaded.debug_log then
        return
    end
    local t = time_global()
    if seq_t0 then
        dogma.log.log(CONFIG.MOD_ID, string.format("%s t=%s ms=%s", tostr(msg), tostr(t), tostr(t - seq_t0)))
        return
    end
    dogma.log.log(CONFIG.MOD_ID, string.format("%s t=%s", tostr(msg), tostr(t)))
end

local function clear_pending()
    pending_site = nil
    pending_allow_pda = nil
    pending_until = nil
    pending_seen_busy = false
    pending_started = nil
    device_show_sent = false
end

local function add_slot_dik(dik)
    if not (dik and dik > 0) then
        return
    end
    slot_diks_n = slot_diks_n + 1
    slot_diks[slot_diks_n] = dik
end

local function refresh_slot_diks()
    slot_diks_n = 0
    if not (key_bindings and bind_to_dik) then
        return
    end
    for i = 1, #SLOT_KB do
        local bind = key_bindings[SLOT_KB[i]]
        if bind then
            local ok, dik = pcall(try_bind_to_dik, bind)
            if ok then
                add_slot_dik(dik)
            end
        end
    end
    local eq = rawget(_G, "dogma_input_equipment_controls_conf")
    if eq and dogma.mcm and dogma.mcm.key then
        for i = 1, #EQ_KEY_IDS do
            add_slot_dik(dogma.mcm.key(eq.MOD_ID, EQ_KEY_IDS[i]))
        end
    end
end

local function on_option_change()
    local tostr = tostring
    local loaded = CONFIG.loaded
    loaded.enabled = dogma.mcm.bool(CONFIG.MOD_ID, "enabled")
    if not loaded.enabled then
        watch_until = nil
        watch_slot = nil
        pda_lower_wait = false
        ui_open = false
        seq_t0 = nil
        clear_pending()
    end
    for i = 1, #SLOT_OPTS do
        local opt = SLOT_OPTS[i]
        loaded[opt.id] = dogma.mcm.bool(CONFIG.MOD_ID, opt.id)
        slot_watched[opt.slot] = loaded[opt.id]
    end
    loaded.after_inventory = dogma.mcm.bool(CONFIG.MOD_ID, "after_inventory")
    loaded.after_loot = dogma.mcm.bool(CONFIG.MOD_ID, "after_loot")
    loaded.after_trade = dogma.mcm.bool(CONFIG.MOD_ID, "after_trade")
    loaded.after_dialogue = dogma.mcm.bool(CONFIG.MOD_ID, "after_dialogue")
    loaded.after_craft = dogma.mcm.bool(CONFIG.MOD_ID, "after_craft")
    loaded.after_teleport = dogma.mcm.bool(CONFIG.MOD_ID, "after_teleport")
    loaded.after_load = dogma.mcm.bool(CONFIG.MOD_ID, "after_load")
    loaded.after_pda = dogma.mcm.bool(CONFIG.MOD_ID, "after_pda")
    loaded.debug_log = dogma.log.logging()
    refresh_slot_diks()
    log(string.format(
        "config: enabled=%s melee=%s secondary=%s primary=%s grenade=%s vision=%s bolt=%s pda=%s device=%s pistol=%s inv=%s loot=%s trade=%s talk=%s craft=%s tp=%s load=%s pda_lower=%s",
        tostr(loaded.enabled), tostr(loaded.slot_melee), tostr(loaded.slot_secondary), tostr(loaded.slot_primary),
        tostr(loaded.slot_grenade), tostr(loaded.slot_vision), tostr(loaded.slot_bolt),
        tostr(loaded.slot_pda), tostr(loaded.slot_device),
        tostr(loaded.slot_pistol), tostr(loaded.after_inventory), tostr(loaded.after_loot),
        tostr(loaded.after_trade), tostr(loaded.after_dialogue), tostr(loaded.after_craft),
        tostr(loaded.after_teleport), tostr(loaded.after_load), tostr(loaded.after_pda)
    ))
end

local function current_slot()
    if not db.actor then
        return nil
    end
    local ok, slot = pcall(try_active_slot, db.actor)
    if ok then
        return slot
    end
end

local function detector_shown()
    if not db.actor then
        return false
    end
    local ok, det = pcall(try_active_detector, db.actor)
    return ok and det ~= nil
end

local function detector_item()
    if not db.actor then
        return nil
    end
    local ok, item = pcall(try_item_in_slot, db.actor, SLOT_DEVICE)
    if ok then
        return item
    end
end

local function detector_state()
    local item = detector_item()
    if not item then
        return nil
    end
    local ok, st = pcall(try_get_state, item)
    if ok then
        return st
    end
end

local function show_detector_flap(site)
    device_show_sent = true
    log_ms(string.format(
        "restore(%s): empty RH -> show_detector flap last_x=%s last_xx=%s",
        site, tostring(last_x), tostring(last_xx)
    ))
    pcall(try_show_detector, db.actor)
end

-- Detector out + empty RH is still slot 0. Treat it as last_x = device.
local function held_slot()
    local slot = current_slot()
    if (not slot or slot == 0) and slot_watched[SLOT_DEVICE] and detector_shown() then
        return SLOT_DEVICE
    end
    return slot
end

local function item_hud_busy(item)
    if not item then
        return false
    end
    local ok, st = pcall(try_get_state, item)
    return ok and (st == HUD_HIDING or st == HUD_SHOWING)
end

-- Inv backpack is game.play_hud_motion, not slot 13 get_state.
local function hud_is_busy()
    local actor = db.actor
    if not actor then
        return false
    end
    local ok, item = pcall(try_active_item, actor)
    if ok and item_hud_busy(item) then
        return true
    end
    local ok_pda, pda = pcall(try_item_in_slot, actor, SLOT_PDA)
    if ok_pda and item_hud_busy(pda) then
        return true
    end
    local ok_allow, allow = pcall(try_hud_motion_allowed)
    return ok_allow and allow == false
end

local function slot_has_item(slot)
    if not (db.actor and slot and slot ~= 0) then
        return false
    end
    local ok, item = pcall(try_item_in_slot, db.actor, slot)
    return ok and item ~= nil
end

local function slot_input_down()
    local input = dogma.input
    if not input then
        return false
    end
    for i = 1, slot_diks_n do
        local dik = slot_diks[i]
        if dik and (input.is_key_down(dik) or input.is_key_pressed(dik)) then
            return true
        end
    end
    return false
end

local function holster_hands(site)
    local slot = current_slot()
    if not (slot and slot ~= 0) then
        return false
    end
    log(string.format("holster(%s): active_slot=%s -> 0", site, tostring(slot)))
    pcall(try_activate_slot, db.actor, 0)
    return true
end

local function activate_target(target, site)
    local sformat = string.format
    local tostr = tostring
    if not db.actor then
        return false
    end
    if not slot_has_item(target) then
        log(sformat("skip(%s): empty target=%s", site, tostr(target)))
        return false
    end
    if target == SLOT_DEVICE then
        if holster_hands(site) then
            return true
        end
        local st = detector_state()
        if st and st ~= HUD_HIDDEN then
            log(sformat("skip(%s): detector already state=%s", site, tostr(st)))
            return true
        end
        show_detector_flap(site)
        return true
    end
    local slot = current_slot()
    if slot == target then
        log(sformat("skip(%s): already slot=%s", site, tostr(target)))
        return true
    end
    log_ms(sformat(
        "restore(%s): active_slot=%s -> activate_slot(%s) last_x=%s last_xx=%s",
        site, tostr(slot), tostr(target), tostr(last_x), tostr(last_xx)
    ))
    pcall(try_activate_slot, db.actor, target)
    return true
end

local function restore_target(allow_pda)
    if last_x and (allow_pda or last_x ~= SLOT_PDA) then
        return last_x
    end
    if last_xx and (allow_pda or last_xx ~= SLOT_PDA) then
        return last_xx
    end
end

local function queue_hide_wait(site, allow_pda)
    if not seq_t0 then
        mark_seq()
    end
    pending_site = site
    pending_allow_pda = allow_pda
    pending_started = time_global()
    pending_until = pending_started + HIDE_STUCK_MS
    pending_seen_busy = false
    log_ms("restore wait hide " .. site)
end

local function arm_watch(site, target)
    watch_until = time_global() + WATCH_MS
    watch_slot = target
    extra_used = false
    log("watch start " .. site)
end

local function start_restore(site, allow_pda, skip_hide)
    if not CONFIG.loaded.enabled then
        return
    end
    local target = restore_target(allow_pda)
    if not target then
        log("skip(" .. site .. "): no last_x")
        return
    end
    if watch_until then
        return
    end
    if not slot_has_item(target) then
        log(string.format("skip(%s): empty target=%s", site, tostring(target)))
        return
    end
    local slot = held_slot()
    if not skip_hide and hud_is_busy() then
        queue_hide_wait(site, allow_pda)
        return
    end
    if target ~= SLOT_DEVICE and slot == target then
        log(string.format("skip(%s): already slot=%s", site, tostring(target)))
        arm_watch(site, target)
        return
    end
    if not activate_target(target, site) then
        return
    end
    arm_watch(site, target)
end

local function tick_watch()
    if not watch_until then
        return
    end
    local slot = current_slot()
    if slot_input_down() and slot and slot ~= 0 then
        log("watch cancel: player slot key")
        watch_until = nil
        watch_slot = nil
        return
    end
    local want = watch_slot or restore_target(true)
    if want == SLOT_DEVICE then
        if slot and slot ~= 0 then
            if not extra_used then
                extra_used = true
                log(string.format("engine flip %s -> device, holster", tostring(slot)))
            end
            pcall(try_activate_slot, db.actor, 0)
        elseif not detector_shown() and not device_show_sent then
            activate_target(SLOT_DEVICE, "engine_flip")
        end
    elseif want and held_slot() ~= want and not extra_used then
        extra_used = true
        log(string.format("engine flip %s -> %s, extra assert", tostring(slot), tostring(want)))
        activate_target(want, "engine_flip")
    end
    if time_global() > watch_until then
        watch_until = nil
        watch_slot = nil
        log("watch end")
    end
end

local function maybe_record_slot(slot)
    if not (slot and slot ~= 0 and slot_watched[slot]) then
        return
    end
    if slot == last_x then
        return
    end
    last_xx = last_x
    last_x = slot
end

-- Always printf: empty community fatals PDA ranking (CCharacterInfo::GetById).
-- SE/xcreature only. Game-object character_community() can itself assert.
local function scan_stalkers_before_pda()
    local tostr = tostring
    if not (db and db.storage and db.actor) then
        return
    end
    dogma.perf.start("last_equip", "scan_stalkers")
    local actor_id = db.actor:id()
    local total = 0
    local bad = 0
    for id, st in pairs(db.storage) do
        local npc = st and st.object
        if npc and id ~= actor_id then
            local ok_st, is_st = pcall(try_scan_stalkers_before_pda_2, IsStalker, npc)
            if ok_st and is_st then
                total = total + 1
                local name, sec = "?", "?"
                local ok_n, n = pcall(try_npc_name, npc)
                if ok_n and n then
                    name = n
                end
                local ok_s, s = pcall(try_npc_sec, npc)
                if ok_s and s then
                    sec = s
                end
                local se = alife_object(id)
                local comm = nil
                if se and xcreature and xcreature.community then
                    local ok_c, c = pcall(xcreature.community, se)
                    if ok_c then
                        comm = c
                    end
                elseif se and se.community then
                    local ok_c, c = pcall(try_scan_stalkers_before_pda, se)
                    if ok_c then
                        comm = c
                    end
                end
                local empty = (type(comm) ~= "string") or (comm == "") or (comm == "none")
                if empty then
                    bad = bad + 1
                    printf(
                        "[dogma_input_last_equip] BAD STALKER id=%s name=%s sec=%s community=%s se=%s",
                        tostr(id),
                        tostr(name),
                        tostr(sec),
                        tostr(comm),
                        tostr(se ~= nil)
                    )
                end
            end
        end
    end
    printf(
        "[dogma_input_last_equip] pre-PDA stalker scan: total=%s bad_community=%s",
        tostr(total),
        tostr(bad)
    )
    dogma.perf.stop()
end

local function track_slot()
    local tostr = tostring
    local slot = held_slot()
    if slot == last_seen_slot then
        return
    end
    local prev = last_seen_slot
    last_seen_slot = slot
    log(string.format(
        "active_slot %s -> %s last_x=%s last_xx=%s watch=%s",
        tostr(prev), tostr(slot), tostr(last_x), tostr(last_xx), tostr(watch_until ~= nil)
    ))
    if slot == SLOT_PDA then
        scan_stalkers_before_pda()
    end
    if prev == SLOT_PDA and slot == 0 and CONFIG.loaded.after_pda then
        pda_lower_wait = true
        if not seq_t0 then
            mark_seq()
        end
        log_ms("pda_lower wait")
    end
    if ui_open then
        return
    end
    if watch_until and not slot_input_down() then
        return
    end
    maybe_record_slot(slot)
end

local function kind_enabled(kind)
    return kind and CONFIG.loaded["after_" .. kind]
end

local function restore_kind(kind, site)
    if not kind_enabled(kind) then
        return
    end
    pda_lower_wait = false
    if pending_site then
        return
    end
    if watch_until then
        return
    end
    mark_seq()
    log_ms("close " .. site)
    queue_hide_wait(site, true)
end

local function ui_blocks_pda_lower()
    if ui_open then
        return true
    end
    local status = dogma.status
    return status and status.is_inv_open and status.is_inv_open()
end

local function flush_pda_lower()
    if not pda_lower_wait then
        return
    end
    pda_lower_wait = false
    if ui_blocks_pda_lower() then
        log("skip(pda_lower): ui open last_x=" .. tostring(last_x))
        return
    end
    if not seq_t0 then
        mark_seq()
    end
    start_restore("pda_lower", false)
end

local function tick_pending_restore()
    if not pending_site then
        return
    end
    if slot_input_down() then
        log("restore wait cancel: player slot key")
        clear_pending()
        return
    end
    if pending_site == "pda_lower" and ui_blocks_pda_lower() then
        log("skip(pda_lower): ui open during hide wait last_x=" .. tostring(last_x))
        clear_pending()
        return
    end
    local now = time_global()
    local stuck = pending_until and now >= pending_until
    local busy = hud_is_busy()
    if busy then
        if not pending_seen_busy then
            pending_seen_busy = true
            log_ms("restore wait hide busy")
        end
        if not stuck then
            return
        end
    elseif not pending_seen_busy then
        if pending_started and now < pending_started + BAG_START_MS then
            return
        end
        log_ms("restore wait hide no bag")
    end
    local site = pending_site
    local allow = pending_allow_pda
    local det_st = detector_state()
    local saw_busy = pending_seen_busy
    clear_pending()
    if stuck then
        log_ms(string.format("restore wait hide timeout %s det=%s busy=%s", site, tostring(det_st), tostring(saw_busy)))
    else
        log_ms(string.format("restore wait hide done %s det=%s", site, tostring(det_st)))
    end
    start_restore(site, allow, true)
end

local function on_actor_menu_mode_changed(mode, last_mode)
    log(string.format("ActorMenu_on_mode_changed: mode=%s last_mode=%s", tostring(mode), tostring(last_mode)))
    ui_open = mode ~= 0
    if mode ~= 0 then
        watch_until = nil
        watch_slot = nil
        return
    end
    restore_kind(MODE_TO_KIND[last_mode], "mode_changed(close)")
end

local function on_actor_menu_before_init_mode(mode_str)
    ui_open = true
    log("ActorMenu_on_before_init_mode: " .. tostring(mode_str))
end

local patched = false
local orig_actor_menu = {}

local function patch_actor_menu()
    if patched or not actor_menu then
        return
    end
    patched = true

    orig_actor_menu.inventory_wnd_closed = actor_menu.inventory_wnd_closed
    orig_actor_menu.dead_body_search_wnd_closed = actor_menu.dead_body_search_wnd_closed
    orig_actor_menu.trade_wnd_closed = actor_menu.trade_wnd_closed

    function actor_menu.inventory_wnd_closed()
        log("actor_menu.inventory_wnd_closed")
        if orig_actor_menu.inventory_wnd_closed then
            orig_actor_menu.inventory_wnd_closed()
        end
        restore_kind("inventory", "wnd_closed")
    end

    function actor_menu.dead_body_search_wnd_closed()
        log("actor_menu.dead_body_search_wnd_closed")
        if orig_actor_menu.dead_body_search_wnd_closed then
            orig_actor_menu.dead_body_search_wnd_closed()
        end
        restore_kind("loot", "wnd_closed")
    end

    function actor_menu.trade_wnd_closed()
        log("actor_menu.trade_wnd_closed")
        if orig_actor_menu.trade_wnd_closed then
            orig_actor_menu.trade_wnd_closed()
        end
        restore_kind("trade", "wnd_closed")
    end
end

local function name_is_craft(name)
    if type(name) ~= "string" or name == "" then
        return false
    end
    if CRAFT_GUI[name] then
        return true
    end
    return name:lower():find("workshop", 1, true)
end

local function on_gui_show(gui, extra)
    log(string.format("GUI_on_show gui=%s extra=%s", tostring(gui), tostring(extra)))
    if gui == "Dialog" or name_is_craft(gui) or name_is_craft(extra) then
        ui_open = true
    end
end

local function on_gui_hide(gui, extra)
    log(string.format("GUI_on_hide gui=%s extra=%s", tostring(gui), tostring(extra)))
    if gui == "Dialog" then
        ui_open = false
        restore_kind("dialogue", "gui_hide")
        return
    end
    if name_is_craft(gui) or name_is_craft(extra) then
        ui_open = false
        restore_kind("craft", "gui_hide")
    end
end

local function on_before_fast_travel()
    if CONFIG.loaded.after_teleport then
        start_restore("fast_travel", true)
    end
end

local function tick_teleport()
    if not CONFIG.loaded.after_teleport or not db.actor then
        return
    end
    local ok, pos = pcall(try_position, db.actor)
    if not (ok and pos) then
        return
    end
    if last_actor_pos then
        local dx = pos.x - last_actor_pos.x
        local dy = pos.y - last_actor_pos.y
        local dz = pos.z - last_actor_pos.z
        if (dx * dx + dy * dy + dz * dz) >= TELEPORT_DIST_SQR then
            log("teleport jump")
            start_restore("teleport", true)
            local ok2, pos2 = pcall(try_position, db.actor)
            if ok2 then
                last_actor_pos = pos2
            end
            return
        end
    end
    last_actor_pos = pos
end

local function on_actor_on_update()
    if not dogma.sys.ready(CONFIG.MOD_ID, db, on_option_change) or not db.actor then
        return
    end
    patch_actor_menu()
    if not CONFIG.loaded.enabled then
        return
    end
    flush_pda_lower()
    track_slot()
    tick_pending_restore()
    tick_watch()
    tick_teleport()
end

local function on_actor_on_first_update()
    patch_actor_menu()
    if need_load_restore then
        need_load_restore = false
        start_restore("first_update", true)
    end
end

local function on_game_load()
    watch_until = nil
    watch_slot = nil
    extra_used = false
    last_seen_slot = nil
    last_actor_pos = nil
    ui_open = false
    pda_lower_wait = false
    seq_t0 = nil
    clear_pending()
    if CONFIG.loaded.after_load then
        need_load_restore = true
    end
end

local function on_level_changing()
    if CONFIG.loaded.after_load then
        need_load_restore = true
    end
end

local function on_save_state(m_data)
    m_data[SAVE_KEY] = last_x
    m_data[SAVE_KEY_PREV] = last_xx
end

local function on_load_state(m_data)
    local v = m_data and m_data[SAVE_KEY]
    if type(v) == "number" and v ~= 0 then
        last_x = v
    end
    local prev = m_data and m_data[SAVE_KEY_PREV]
    if type(prev) == "number" and prev ~= 0 then
        last_xx = prev
    end
end

function on_game_start()
    dogma.load(CONFIG.MOD_ID)
    dogma.log.log(CONFIG.MOD_ID, "on_game_start: mod loaded")
    on_option_change()
    patch_actor_menu()
    RegisterScriptCallback("ActorMenu_on_before_init_mode", on_actor_menu_before_init_mode)
    RegisterScriptCallback("ActorMenu_on_mode_changed", on_actor_menu_mode_changed)
    RegisterScriptCallback("GUI_on_show", on_gui_show)
    RegisterScriptCallback("GUI_on_hide", on_gui_hide)
    RegisterScriptCallback("on_option_change", on_option_change)
    RegisterScriptCallback("actor_on_update", on_actor_on_update)
    RegisterScriptCallback("actor_on_first_update", on_actor_on_first_update)
    RegisterScriptCallback("on_game_load", on_game_load)
    RegisterScriptCallback("on_level_changing", on_level_changing)
    RegisterScriptCallback("save_state", on_save_state)
    RegisterScriptCallback("load_state", on_load_state)
    if rawget(_G, "game_fast_travel") then
        RegisterScriptCallback("on_before_fast_travel", on_before_fast_travel)
    end
end
